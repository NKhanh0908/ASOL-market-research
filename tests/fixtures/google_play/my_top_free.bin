[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.Garawell.BridgeRace\\u0026rdid\\u003dcom.Garawell.BridgeRace\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.Garawell.BridgeRace\"]],[\"qgJnGmUIWUoTCNnT8bDHkJcDFTsytwAd800nJPoBDwoNCAASCQoFZW4tVVMQALoCOQodChdjb20uR2FyYXdlbGwuQnJpZGdlUmFjZRABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,\"7L0riMWzEKg\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:7L0riMWzEKg?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:7L0riMWzEKg\",null,null,null,null,\"AXH1ezkB3O48j1a5qj3vetK8y9Z79l-pDAzmmVV-k3_s5qA9YJSfUqzfH_fgI0UrjWM29CXL6bG06Xh0fYcNpu5A2hmg604rIbXVOkjUd2uy11sc5nbywWUTQx8nuY5FEg5Lm_EKbc395gbVC_m1W_hu9YL-miqbWWNMh4VF8fyOHpQzHQv4l3uqtwPCtZOpxXZUlZ--L83-ZCAY8J_v4p7V2BluWACWjL_XOXRB7LlebN6YJHSeXSJXNlzCeCYyKWCevXP_GC6KhanfsBkpIaKaEXeDyyIcvoK3xJzwwR2TLHzjag\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/7L0riMWzEKg/hqdefault.jpg\"]]]],[null,\"Bridge Race is a fun and colorful racing game where you collect blocks, build bridges, and compete against rivals to reach the finish first.\\u003cbr\\u003e\\u003cbr\\u003eRun through each level, pick up blocks of your own color, and use them to build bridges across platforms, gaps, and obstacles. Choose the best path, build smart shortcuts, and stay ahead of the competition.\\u003cbr\\u003e\\u003cbr\\u003eWatch out for other racers! Rivals can steal your blocks, slow you down, and turn the race around in seconds. Keep your stack safe, cross bridges faster, and push toward the final stage.\\u003cbr\\u003e\\u003cbr\\u003eExplore colorful levels filled with fun mechanics like sliders, trampolines, zip-lines, ladders, elevators, and more. Each race brings a new challenge as you stack blocks, cross bridges, and race for victory.\\u003cbr\\u003e\\u003cbr\\u003eIf you enjoy runner games, racing games, stacking games, and bridge-building challenges, Bridge Race is easy to play and hard to stop.\\u003cbr\\u003e\\u003cbr\\u003eCollect, build, race, and win!\"],\"Supersonic Studios LTD\",\"500,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/UzdbzpkI4eaRzg6gF_jKZu95zR5JEeSapVDg76AggG6DtzbBfbZLRarjgMQen9SmeOs5lKCESPbdE4goGNjn8Ts\"],null,[41,213,255,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.Garawell.BridgeRace\\u0026rdid\\u003dcom.Garawell.BridgeRace\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"RM 4.49 - RM 444.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.lionroar.babyjinidaycare\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IRAH_7A0fIa0ZNOU36BWKtKfW9VMXO7lYbziqXVCJ-KQ056KKWYx2m4poKMxSZTbxzftivhSM