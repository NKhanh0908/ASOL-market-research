ery Dumpling: Unbox ASMR\",[\"4.4\",4.3627453],\"Casual\",null,null,[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.mystery.dumplings.asmr.unboxing.squishy\\u0026rdid\\u003dcom.mystery.dumplings.asmr.unboxing.squishy\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.mystery.dumplings.asmr.unboxing.squishy\"]],[\"qgJ7GnkIA0oTCNnT8bDHkJcDFTsytwAd800nJPoBDwoNCAASCQoFZW4tVVMQALoCTQoxCitjb20ubXlzdGVyeS5kdW1wbGluZ3MuYXNtci51bmJveGluZy5zcXVpc2h5EAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],[[[null,null,\"7Cv0BS-YKKs\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:7Cv0BS-YKKs?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:7Cv0BS-YKKs\",null,null,null,null,\"AXH1ezlT5PFurl6KYYi5zt-mhRYF-LkhLVPB4yk2_2NkkIZ_QDgqaGzcTpXQaHtTx7nu5L5EwhAVcPJej6KxmFzHd3xxqBy9OrOavJzMJylQXQ_QwvHHNzB4qxqzDtQ0EvlEUfrOpDyy-S2RARFeRhWN3DdbAqhq-RAvjvblp4DwM5gTkyn1SEtV-lagU6jfmzYMKirQ95fMXwJVlvUxUVj0gv17e0CQ-2o9AHqwgWssW17Um67ttxqMvlNsTWzne-zSmsz7DPKYrIH22mBiMD3OKe5U6h1SOaW5SZ7jl-IO7KcYWw\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/7Cv0BS-YKKs/hqdefault.jpg\"]]]],[null,\"Welcome to Mystery Dumpling: Unbox ASMR!\\u003cbr\\u003e\\u003cbr\\u003ePeel the wrapper, open the bamboo steamer, and discover adorable Mystery Dumplings hidden inside every box.\\u003cbr\\u003e\\u003cbr\\u003eCollect cute dumplings of different rarities, from Common, Rare, Epic, and Legendary to the ultra-rare Rainbow Dumpling and Golden Dumpling.\\u003cbr\\u003e\\u003cbr\\u003eComplete each collection to unlock the exclusive Secret Dumpling and finish every mystery theme.\\u003cbr\\u003e\\u003cbr\\u003eFeatures\\u003cbr\\u003e\\u003cbr\\u003e🥟 Relaxing ASMR unboxing experience\\u003cbr\\u003e\\u003cbr\\u003e🎁 Open mystery dumpling boxes\\u003cbr\\u003e\\u003cbr\\u003e🌈 Discover Rainbow \\u0026amp; Golden Dumplings\\u003cbr\\u003e\\u003cbr\\u003e⭐ Collect Common, Rare, Epic \\u0026amp; Legendary characters\\u003cbr\\u003e\\u003cbr\\u003e🏆 Complete every collection and unlock Secret Dumplings\\u003cbr\\u003e\\u003cbr\\u003e✨ Cute animations and satisfying reveal effects\\u003cbr\\u003e\\u003cbr\\u003eStart your Mystery Dumpling collection today and see if you can find every rare surprise!\"],\"Brocker Bus Studio\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/hV3J-Dr_Cq0HEoe9Lb8OlWBf2AeltWebnYzrp64ygmqQLPK9CdNzUJzFHX8qytac-PVx-NAiOoHxaikqRnn1cw\"],null,[223,111,194,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,[null,\"Suitable for all age groups. Some violence in a comical or fantasy context is acceptable. Bad language is not permitted.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.mystery.dumplings.asmr.unboxing.squishy\\u0026rdid\\u003dcom.mystery.dumplings.asmr.unboxing.squishy\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"RM 21.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[