ogleusercontent.com/AtW2ayHTjlBaXQqQ1Np_qOdstfUNcUYqX5Tv22_J48nooJSNZPRGaCBasuMTZgyxuUAoK2pWrUBknPR7Ev7z3g\"]]],\"Glow Fashion Idol\",[\"4.9\",4.9153605],\"Casual\",null,null,[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.crazylabs.fashion.squad\\u0026rdid\\u003dcom.crazylabs.fashion.squad\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.crazylabs.fashion.squad\"]],[\"qgJrGmkIJ0oTCNnT8bDHkJcDFTsytwAd800nJPoBDwoNCAASCQoFZW4tVVMQALoCPQohChtjb20uY3JhenlsYWJzLmZhc2hpb24uc3F1YWQQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],[[[null,null,\"j8v9nIa9l2c\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:j8v9nIa9l2c?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:j8v9nIa9l2c\",null,[1280,720],null,null,\"AXH1eznf0uhJ4dJV8u9Lqzcoak34j0HHpXyRax3Vbk4TwKzDWYNjgZpx8yvRKu-VqwSpUrVI72GLpcTO1x1touHnUOkuBBvFdFv10dy02vYUTYmi8yhuXQ8kOr0nKVQ-CzJ2jPFVHiDpA8DgwuWaDbB0nNew8gFcdQOS_BsgalXd13WCIZZaYv3fR39ZOv4eSw9wIch764gFPUMIDpgE6gaBzwxdU97UNi4uc74mDm7uWinWO0LuxzyIfJKXcuH5ct_mdC0yV9dU7_DGjXnnKM0EoU3wZN4fIg__xnnPQIWQmXasvQ\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/j8v9nIa9l2c/hqdefault.jpg\"]]]],[null,\"Welcome to Glow Fashion Idol — a fashion makeover and dress-up game where every client has a moment to shine, every look creates a glow-up, and every style choice brings you closer to becoming a Fashion Idol.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eCreate Client Glow-Ups\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003eGet ready to embrace the glamorous world of Glow Fashion Idol! Step into the spotlight as a talented fashion stylist and create breathtaking outfits for clients in a dazzling dress up and makeover story. Showcase your makeover skills in the makeover studio and rise through the fashion industry.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eLive Your Fashion Story\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003eImmerse yourself in the captivating fashion story, where you\\u0026#39;ll encounter exciting challenges, inspiring fashion shows, and a chance to transform into a true fashion idol and super stylist. Express your creativity by putting together incredible glam outfits, each telling a mesmerizing makeover story.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eStyle, Customize \\u0026amp; Shine\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003eWith a wide variety of designer outfits and accessories at your fingertips, this dress up game will provide endless possibilities to style and customize your model. Show off your impeccable taste in fashion, dress up in stunning outfits, and let your creativity shine!\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eKey Features\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003e• Dress up your virtual models with an extensive wardrobe collection filled with glam outfits.\\u003cbr\\u003e\\u003cbr\\u003e• Unlock makeup styles and hairstyles to create a signature look in the makeup studio.\\u003cbr\\u003e\\u003cbr\\u003e• Add friends and join runway events together in the world of fashion.\\u003cbr\\u003e\\u003cbr\\u003e• Compete in the fashion battle to prove your fashion stylist expertise.\\u003cbr\\u003e\\u003cbr\\u003e• Enter an exciting fashion story filled with captivating challenges.\\u003cbr\\u003e\\u003cbr\\u003e• Participate in the fashion show to gain recognition as the Glow Fashion Idol.\\u003cbr\\u003e\\u003cbr\\u003e• Create stunning client glow-ups in the makeover studio.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eBecome the Glow Fashion Idol\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003eGlow Fashion Idol is not just a makeover story, but a journey into the glitzy and chic world of fashion. Are you ready to become the ultimate Glow Fashion Idol? Play now and start your fashion adventure!\\u003cbr\\u003e\\u003cbr\\u003e*In-App purchases may include random items.\\u003cbr\\u003e\\u003cbr\\u003eTo opt out of CrazyLabs sales of personal information as a California resident, please visit the settings page within this app. For more information visit our privacy policy: https://crazylabs.com/app\"],\"CrazyLabs LTD\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/OczMKxnbqRQbOQNjeDYlINHJr116G9drf5J3iWcmlgr5oszdm0tKCg0zNsehOWDrkudCasz1JJqBsNr4feUdN1g\"],null,[162,154,153,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.crazylabs.fashion.squad\\u0026rdid\\u003dcom.crazylabs.fashion.squad\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"RM 3.11 - RM 314.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.king.farmheroessaga\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/elgPfboPUOX-pohBY