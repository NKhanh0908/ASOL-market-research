ll,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.FishEatFish.FeedGrow\"]],[\"qgJoGmYIAkoTCNnT8bDHkJcDFTsytwAd800nJPoBDwoNCAASCQoFZW4tVVMQALoCOgoeChhjb20uRmlzaEVhdEZpc2guRmVlZEdyb3cQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],[[[null,null,\"Buy7adA4SW0\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:Buy7adA4SW0?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:Buy7adA4SW0\",null,null,null,null,\"AXH1eznXNIvllU7M4mR-oaeoGPMq6RzFUKNC4udNaY_9Ut2Hdv49SeZ6GXedq8m_wThZkkXFZB66egKQDtgUg1WeVUAvrLUvA4xkon7OsceYi1uTytv--AiF_4xPBfsDzr0U4b0ruVLy_uu8EmyUhZQf6QmIx85eLsgGybMOwO4juh-T7f_TBhbRwS1JGovUOffJKArgPqQEVDJ5vN4X_3KKrZ_mWgiocjgyZwcxt3WsbMa79rInYH088-S6d0CP6Z0enBA3z7rLeBvhFSVub6QHY_J7WdHtovhhRzYkKIgjJDhJww\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/Buy7adA4SW0/hqdefault.jpg\"]]]],[null,\"🎉 Classic \\u0026quot;Big Fish Eat Little Fish\\u0026quot; is back! 🎉\\u003cbr\\u003e\\u003cbr\\u003e🎮 Experience the traditional gameplay with a fresh twist. Dive into this oceanic adventure now! 🌊\\u003cbr\\u003e\\u003cbr\\u003e🐠 Start small as a tiny fish in the vast ocean. To survive, you must constantly feed and grow, unlocking incredible abilities to devour various marine creatures and rise to become the apex ocean predator! 🦈\\u003cbr\\u003e\\u003cbr\\u003e🐠 Each ocean is teeming with unique marine life. Every fish species comes with its own special skills, making every encounter exciting! 🐳 From fierce sharks and playful dolphins to chill sea turtles, stunning seahorses, and clever octopuses... Over 100 different species are available for you! 🐙\\u003cbr\\u003e\\u003cbr\\u003e🌀 Hidden within mysterious whirlpools, you’ll even find ancient creatures waiting to be discovered! 🦐\\u003cbr\\u003e\\u003cbr\\u003e🌟 Each ocean also features exclusive \\u0026quot;Great Hoard\\u0026quot; that grant your fish special powers, helping you dominate the sea world! Plus, with the Codex feature, you can collect and learn about the habits of every fish you encounter, diving deeper into the underwater world! 📚\\u003cbr\\u003e\\u003cbr\\u003e💥 Join this thrilling oceanic survival challenge and become the ultimate ruler of the seas! 🏆\\u003cbr\\u003e\\u003cbr\\u003e\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003dFollow Us\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003cbr\\u003e\\u003cbr\\u003e👉 Join our Facebook fan group to get the latest news and gifts for limited-time events! 🎁\\u003cbr\\u003e※Official fan group: https://www.facebook.com/profile.php?id\\u003d61570913290183\\u003cbr\\u003e※Official Discord Channel：https://discord.gg/mrGKhBFfVn\\u003cbr\\u003e※Official email: help@mobibrain.net\"],\"MOBIBRAIN TECHNOLOGY PTE. LTD.\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/KfsoMBM5lAsXU2hx6bM00Lm8slCtOcQsmyvJ7Bjm-tLACOz53sF_Lt1_p6oZ3X5YBhShijywjAt5wuJn313x6A\"],null,[44,123,195,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.FishEatFish.FeedGrow\\u0026rdid\\u003dcom.FishEatFish.FeedGrow\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],nul