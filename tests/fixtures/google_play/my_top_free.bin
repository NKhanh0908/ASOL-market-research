.googleusercontent.com/opfFBBsaP-Bw4sazJcYwMFJ6yRdWQKa05HP_V-DlLXqmxvkkJGl8YOk-3zNjQXyqJCC-klFPufBdoWGzIfrH\"]]],\"Beauty Foodie™: Sort \\u0026 Stories\",[\"4.9\",4.9],\"Casual\",null,null,[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.beauty.foodie.story.sort.skewer.grill.makeover.match.puzzle\\u0026rdid\\u003dcom.beauty.foodie.story.sort.skewer.grill.makeover.match.puzzle\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.beauty.foodie.story.sort.skewer.grill.makeover.match.puzzle\"]],[\"qgKQARqNAQhNShMI2dPxsMeQlwMVOzK3AB3zTSck+gEPCg0IABIJCgVlbi1VUxAAugJhCkUKP2NvbS5iZWF1dHkuZm9vZGllLnN0b3J5LnNvcnQuc2tld2VyLmdyaWxsLm1ha2VvdmVyLm1hdGNoLnB1enpsZRABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"❄️🤰 When a \\u003cfont color\\u003d\\\"#E85D75\\\"\\u003e\\u003cb\\u003epregnant mother and her 6-year-old daughter\\u003c/b\\u003e\\u003c/font\\u003e are abandoned on a freezing winter night, Ella must fight to survive, rebuild her life, and rediscover her passion for \\u003cfont color\\u003d\\\"#E67E22\\\"\\u003e\\u003cb\\u003ecooking\\u003c/b\\u003e\\u003c/font\\u003e!\\u003cbr\\u003e\\u003cbr\\u003eJoin \\u003cfont color\\u003d\\\"#E85D75\\\"\\u003e\\u003cb\\u003eElla\\u003c/b\\u003e\\u003c/font\\u003e on an emotional journey of \\u003cfont color\\u003d\\\"#E67E22\\\"\\u003e\\u003cb\\u003efood, family, and a fresh start\\u003c/b\\u003e\\u003c/font\\u003e.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cfont color\\u003d\\\"#E85D75\\\"\\u003e\\u003cb\\u003e❤️ Why You’ll Obsess Over This Game\\u003c/b\\u003e\\u003c/font\\u003e\\u003cbr\\u003e\\u003cbr\\u003e🎭 Drama That Hooks You\\u003cbr\\u003e\\u003cbr\\u003e• \\u003cb\\u003eA new beginning:\\u003c/b\\u003e Help Ella, her daughter Lily, and their cat Lucky find hope after losing everything.\\u003cbr\\u003e\\u003cbr\\u003e• \\u003cb\\u003eRebuild her dream:\\u003c/b\\u003e Restore the old food truck and bring Ella\\u0026#39;s \\u003cfont color\\u003d\\\"#E67E22\\\"\\u003e\\u003cb\\u003elegendary barbecue business\\u003c/b\\u003e\\u003c/font\\u003e back to life!\\u003cbr\\u003e\\u003cbr\\u003e• Experience \\u003cfont color\\u003d\\\"#E85D75\\\"\\u003e\\u003cb\\u003eemotional twists, heartfelt friendships, and inspiring moments\\u003c/b\\u003e\\u003c/font\\u003e as Ella creates a better future.\\u003cbr\\u003e\\u003cbr\\u003e🍢 Satisfying Food Sort Puzzle\\u003cbr\\u003e\\u003cbr\\u003e• Enjoy relaxing \\u003cfont color\\u003d\\\"#E67E22\\\"\\u003e\\u003cb\\u003efood sorting puzzles\\u003c/b\\u003e\\u003c/font\\u003e: Arrange delicious skewers and prepare orders for hungry customers.\\u003cbr\\u003e\\u003cbr\\u003e• Master intuitive \\u003cfont color\\u003d\\\"#E67E22\\\"\\u003e\\u003cb\\u003esorting mechanics\\u003c/b\\u003e\\u003c/font\\u003e with hundreds of satisfying levels.\\u003cbr\\u003e\\u003cbr\\u003e• Challenge your brain with fun puzzles while building your culinary empire!\\u003cbr\\u003e\\u003cbr\\u003e👗 Style \\u0026amp; Makeover\\u003cbr\\u003e\\u003cbr\\u003e• Give Ella \\u003cfont color\\u003d\\\"#7567D8\\\"\\u003e\\u003cb\\u003estunning makeovers\\u003c/b\\u003e\\u003c/font\\u003e and help her regain confidence.\\u003cbr\\u003e\\u003cbr\\u003e• \\u003cb\\u003eRenovate and redesign:\\u003c/b\\u003e Restore the food truck, transform beautiful spaces, and create your dream designs.\\u003cbr\\u003e\\u003cbr\\u003e• Express your creativity with endless fashion styles and inspiring makeovers.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cfont color\\u003d\\\"#E8506B\\\"\\u003e\\u003cb\\u003eDownload Now \\u0026amp; Start Your Journey!\\u003c/b\\u003e\\u003c/font\\u003e\\u003cbr\\u003e\\u003cbr\\u003eSort, Cook, and \\u003cfont color\\u003d\\\"#E8506B\\\"\\u003e\\u003cb\\u003eRewrite Ella’s Story!\\u003c/b\\u003e\\u003c/font\\u003e 🌹✨\\u003cbr\\u003e\\u003cbr\\u003eDon’t miss out! Your next favorite \\u003cfont color\\u003d\\\"#E67E22\\\"\\u003e\\u003cb\\u003efood sorting adventure\\u003c/b\\u003e\\u003c/font\\u003e is waiting for you! 🌟\"],\"Pexix Inc.\",\"100,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/Q1JVezWWp4B8L82DCz_jQbE9Gn9hIAcPKWpbkpYSfpvsOCNCNTznwP31GGsnJ_eMMlwmmwpYpze8sBuvCyi_Iw\"],null,[162,156,155,255]],null,[\"Rated for 16+\",[null,2,[366,512],[null,null,\"https://play-lh.googleusercontent.com/djaflVB_tFGRjZlfs-xrcdSPeI_CUG3TTewlYuSFjq1tsNXxb4aZqAq0uMFzUtiZI_R65RtDyr4Zt2vt\"]],[null,\"Strong Violence\"],null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/UAlGNLgnQRVs-XrK_mUGJw1h_nlO1Ykv0jZK-YoRrRYIGIWmRdE_CCPB7U34jAiz4xLWUAqQ5Me7Daq7N_8\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.beauty.foodie.story.sort.skewer.grill.makeover.match.puzzle\\u0026rdid\\u003dcom.beauty.foodie.story.sort.skewer.grill.makeover.match.puzzle\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"RM 4.49 - RM 444.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.tsyatsya.mechangelion\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/OazrpJ66zbgV24TnZrljayqOSYqBlOpmwfznG8QCKStC_25r2iltq