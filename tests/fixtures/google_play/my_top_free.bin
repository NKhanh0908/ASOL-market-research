]]],\"Mini Relaxing Game- pop it\",[\"4.0\",3.97],\"Casual\",null,null,[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.sh.fidget.toys.mini.relaxing.antistress.games\\u0026rdid\\u003dcom.sh.fidget.toys.mini.relaxing.antistress.games\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.sh.fidget.toys.mini.relaxing.antistress.games\"]],[\"qgKBARp/CAdKEwjZ0/Gwx5CXAxU7MrcAHfNNJyT6AQ8KDQgAEgkKBWVuLVVTEAC6AlMKNwoxY29tLnNoLmZpZGdldC50b3lzLm1pbmkucmVsYXhpbmcuYW50aXN0cmVzcy5nYW1lcxABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"Need to unwind after a long day? Step into a world of calm with antistress relaxing fidget toys. This popit game is designed to help you relax, focus, and find peace. Explore an array of soothing pop it toys and stress-relief games that stimulate the satisfying experience of puppet games and mindful exercises. Engage with various relaxation toys, each with unique interactions and calming sounds.\\u003cbr\\u003e\\u003cbr\\u003eThe ultimate ASMR fidget games are designed to relieve stress and soothe your mind. Explore a diverse collection of anti-stress toys, including stress balls, pop it toys, fidget spinners, and more. Each toy offers a unique sensory experience to help you relax and destress.\\u003cbr\\u003e\\u003cbr\\u003eWe\\u0026#39;ve compiled a list of over 50+ sensory fidget toys.\\u003cbr\\u003e\\u003cbr\\u003eSome Features of Our Game:\\u003cbr\\u003ePop it fidget toy\\u003cbr\\u003eFidget spinner\\u003cbr\\u003eBalloons popping\\u003cbr\\u003eCradle balance balls\\u003cbr\\u003ePetals plucking\\u003cbr\\u003eASMR cutting\\u003cbr\\u003ePottery - Play with the clay\\u003cbr\\u003eSlime games\\u003cbr\\u003eDalgona cookie cutting\\u003cbr\\u003eHydraulic press\\u003cbr\\u003eRelaxing fireworks\\u003cbr\\u003eMoney gun\\u003cbr\\u003eIron balls\\u003cbr\\u003eand many more...\\u003cbr\\u003e\\u003cbr\\u003eMini Relaxing Game is the perfect escape from the hustle and bustle of daily life.\\u003cbr\\u003e\\u003cbr\\u003eGet rid of stress!\"],\"Game District LLC\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/4xYlPEQUb41N8kLfVsy94g-BlBZLJeUcTfG-XeRAlWtpTefvR0HyN-g-9c82pNCS-6rQzexjf019r9vASFFiEUg\"],null,[88,43,8,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.sh.fidget.toys.mini.relaxing.antistress.games\\u0026rdid\\u003dcom.sh.fidget.toys.mini.relaxing.antistress.games\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"RM 43.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.outfit7.mytalkingtom2\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/haIV9mm4xqeGBwn3YXnvuEocCwV_8eMUZ