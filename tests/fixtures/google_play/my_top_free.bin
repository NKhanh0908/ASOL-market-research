ogleusercontent.com/ARVw5FgA6fUALS6oJZ6Rjl4ugqWGsAuVNBWUYmtnspweRtEmD0-AKmbqSUtgwidf_C9SaPuOAOoLMdcq6gpiAHw\"]]],\"Good Pizza, Great Pizza\",[\"4.7\",4.6829166],\"Casual\",null,null,[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.tapblaze.pizzabusiness\\u0026rdid\\u003dcom.tapblaze.pizzabusiness\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.tapblaze.pizzabusiness\"]],[\"qgJqGmgIYkoTCNnT8bDHkJcDFTsytwAd800nJPoBDwoNCAASCQoFZW4tVVMQALoCPAogChpjb20udGFwYmxhemUucGl6emFidXNpbmVzcxABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,\"DbKpTnv3US4\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:DbKpTnv3US4?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:DbKpTnv3US4\",null,null,null,null,\"AXH1eznLdLx76AUXQZrYVxD_B2McmUnYZNDHDuXRmt_dAxO_QSUgPjSizT1wr89PPpGK8reXtMmq8gk6mAYwihJtAcmjOO-cFif3YjFrPMdWS_de5GV4gUfRiYad9eW5VUgUyNKMO2VZ9KyR8kqGR3x_hTZ8rxpUsfvhC-PNWC_SF_3zqLH-wdmmQNhNJ5DmJpzwxt7dbVTEga1StXI3B_Jx8zbz9LpUKQBgFaPRXHqRgJGmMNrvQ5GoDgCKHS16zKnJxC3dUzMUGz_PfzofXaIUehiY5k0Kc7-XQ7p8v2TwHihx1w\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/DbKpTnv3US4/hqdefault.jpg\"]]]],[null,\"Ever wanted to know what it feels like to run your own Pizza shop? Now you can with TapBlaze’s newest cooking game, Good Pizza, Great Pizza! Do your best to fulfill pizza orders from customers while making enough money to keep your restuarant open. Upgrade your restaurant with new toppings, decor and kitchen equipment to compete against your pizza rival, Alicante!\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eGAME HIGHLIGHTS\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003e🍕 Featuring Pizza News Network (PNN), the first newscast about all things pizza.\\u003cbr\\u003e🍕 Over 100 customers with unique pizza orders and personalities.\\u003cbr\\u003e🍕 Pizza toppings including pepperoni, sausage, onions, and more.\\u003cbr\\u003e🍕 Equipment upgrades to help you become the master ovenist.\\u003cbr\\u003e🍕 Simple, fun and challenging cooking game.\\u003cbr\\u003e🍕 Created by pizza making professionals; the game designer worked in a pizza kitchen for four years!\\u003cbr\\u003e\\u003cbr\\u003eCan you become the master ovenist? Only time and your pizza skills will tell! \\u003cbr\\u003e\\u003cbr\\u003eDownload and start pizza making now!\\u003cbr\\u003e\\u003cbr\\u003ePrivacy Policy: \\u003cbr\\u003ehttp://www.tapblaze.com/about/privacy-policy/\\u003cbr\\u003e\\u003cbr\\u003eTerms of Service: \\u003cbr\\u003ehttp://www.tapblaze.com/about/terms-conditions/\"],\"TapBlaze\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/llonn-neeTpjUBjNlbpuCwXG4110wGd1CA0qNwf_ACpLNi_YCOcPXMdtRtIku8syz6Ds6W73v-IeYpIqR7RFfw\"],null,[178,94,94,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.tapblaze.pizzabusiness\\u0026rdid\\u003dcom.tapblaze.pizzabusiness\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true