,133,64,255],null,null,null,2],[[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/MAiEXvzgx6XBKiYJzw4-96XLDLts6JFbQ2TRQpqbfv2ujKXvlbJ-J6NvOD79a3ZE_U7i6b3JMOBqMZMbPVrmZw\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/bOugqib0hLGkeSo5qxuX61_NqiKENxuI9QDbbTnnGsUZU5eHqmr2j07H9M2jC0RUjb2mhVp3WZ0Rj4Y0P-KT\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/YEF8LRA6y7ZMB1T0m1FHxvymFzlIxIlYCt9VpS2IvYNHX5Lxn_cNvdbAAmM9ebyXUcnjkcgIQXBH2HRDGlAOfw\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/B34jh_sqqK3AoxoJ-yRhXXc3D_hx4nkgZHlS_0dfxnn_F4BkCJ8q9lAhUb99SFBkUBdhLY6D3dln9jaF3dPgxw\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/uIIBd8reravmhYxcWoPn4ZybRsb-yG09XTXWwT9GCsG9E2r7VzNlIt7cZ0CApdXaBmEbt41tVZBOirR0esT7HLQ\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/bdymG14d58_Y_zbkBeSJdjLBfnAQpdWFjpoFzJ8ah1mTyFZkUG1qoQ85ZdXtrTHSJLksxTPV96WucWliXfWG\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/0Sg1JlCEiwK96P_qrCs6Izo7MgRMaPq9dyoIQqvqLgBSumM-6g8eryHAswSLDmOvh0EQWIGRTRZ9MHqOAhoB\"]]],\"Sprunki All Phases Beat Maker\",[\"4.4\",4.4215684],\"Casual\",null,null,[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.sprunki.mod.horror.incredibox.monster.beats.music.phase\\u0026rdid\\u003dcom.sprunki.mod.horror.incredibox.monster.beats.music.phase\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.sprunki.mod.horror.incredibox.monster.beats.music.phase\"]],[\"qgKUARqRAQgZShMI2dPxsMeQlwMVOzK3AB3zTSck+gEXChUIprCm6ff304pDEgkKBWVuLVVTEAC6Al0KQQo7Y29tLnNwcnVua2kubW9kLmhvcnJvci5pbmNyZWRpYm94Lm1vbnN0ZXIuYmVhdHMubXVzaWMucGhhc2UQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],[[[null,null,\"QB41P0WqroE\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:QB41P0WqroE?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:QB41P0WqroE\",null,null,null,null,\"AXH1eznciBalyAf9SNI1Ue8KM0q4nbG6_mJLVB5fbalanJFPbHdoU8xAWm50O84K8b6VWaI2J4kY5MC9dwxX013sHPRYeEiVrnk_8k5pTFpOQXwJau_7j5sNi2a5qIeORIJQTn34rwls38QwI7aNYqkIPt1BVX1cuVp1Z85oiGJrSIkl7YaiYdbMIifigX2C2Q9YL-dCvqXjrtW_r1bcg2QXiXnLzFw8zjY9_igBO5aK9JDF0bZgR2q7Zy4Ym8Ks1hw-g2ryByxVIeNCURmOXHURf9qc4kfp5rXJwmagW6O3DRPrmw\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/QB41P0WqroE/hqdefault.jpg\"]]]],[null,\"Step into the electrifying world of the incredible music box: Sprunki All Phases Beat Maker, an interactive music mixer that blends cute and creepy beats with normal and horror sound effects. Mix fun and spooky melodies, unique vocals, and dynamic rhythms in a vibrant world full of surprises. Beyond Sprunki Original, a wide array of Sprunki-themed mods adds even more musical diversity and fun.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eUnleash your Creativity with Sprunki and Friends\\u003c/b\\u003e\\u003cbr\\u003eCraft beats and explore your musical genius with the iconic and quirky cast, including: Oren, Raddy, Clukr, Fun Bot, Vineria, Gray, Brud, Garnold, OWAKCX, Sky, Mr. Sun, Durple, Mr. Tree, Simon, Tunner, Mr. Fun Computer, Pinki, Jevin, and Wenda – each bringing unique sound personalities and styles to your track.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eHow to Play Sprunki All Phases Beat Maker?\\u003c/b\\u003e\\u003cbr\\u003e1. Listen and select your sounds. Pick the beats, effects, melodies and vocals you like. \\u003cbr\\u003e2. Drag and drop icons. Assign sounds to characters to create your own unique tunes. \\u003cbr\\u003e3. Mix and match incredible beats, stunning effects, and catchy melodies to build unique tracks in a vibrant, animated world.\\u003cbr\\u003e4. Unlock sprunki mods and all phases. Discover hidden sprunki sound combinations. For an exciting surprise, drag the black button onto a character to unleash the chilling Sprunki Horror theme!\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eSprunki Phase 3/ Sprunki Phase 4/ Sprunki Phase 5\\u003c/b\\u003e\\u003cbr\\u003eDive into the intense evolution of rhythm with the Sprunki Phase series! Each Phase brings new beats, characters, and dramatic visuals—pushing your music-mixing skills to the limit.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eSprunki OC Real/ Sprunki oc 2\\u003c/b\\u003e\\u003cbr\\u003eExperience OC2 Real—a fan-favorite mod with bold visuals and hard-hitting sounds. Packed with original characters and chilling audio, it\\u0026#39;s a must-play for true Sprunki fans.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eSprunki Mustard\\u003c/b\\u003e\\u003cbr\\u003eBright, bold, and unforgettable. Mustard delivers a punchy bright-yellow vibe with catchy loops and a fun twist on the classic Sprunki experience.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eSprunki Baby Phase 3\\u003c/b\\u003e\\u003cbr\\u003eCute but chaotic! Baby Phase 3 blends adorable character design with energetic beats for a surprising and fun rhythm challenge.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eSprunki Pyramixed\\u003c/b\\u003e\\u003cbr\\u003eEnter the pyramid. Pyramixed mixes ancient mystique with modern rhythm, offering a unique audio-visual journey full of layered sounds and stylish animation.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eWhy Choose Sprunki All Phases Beat Maker?\\u003c/b\\u003e\\u003cbr\\u003e🎶 Game + Music Studio Hybrid: Enjoy a seamless blend of engaging gameplay and powerful music creation tools.\\u003cbr\\u003e🎨 Interactive Audio-Visual Experience: Stunning animations and immersive graphics make every session a joy.\\u003cbr\\u003e🤖 Drag-and-Drop Simplicity: Effortlessly experiment with endless sound combinations to craft your own beats.\\u003cbr\\u003e🎁 Exciting Hidden Surprise: Drag the mysterious black button into your band and unlock a spooky horror mode! Get ready for ghostly melodies and thrilling chills. \\u003cbr\\u003e🔮 Mix \\u0026amp; Match Magical Box: Experiment with endless sounds and character combinations. With multiple diverse musical styles to explore, you can craft unique tunes of your own.\\u003cbr\\u003e\\u003cbr\\u003eUpcoming Features You’ll Love:\\u003cbr\\u003e🎵 Multiple incredible musical atmospheres to explore\\u003cbr\\u003e🌟 Regular updates and new character/mod drops\\u003cbr\\u003e\\u003cbr\\u003eStart your beatmaking journey in Sprunki All Phases Beat Maker, and become a true music legend in this thrilling, ever-evolving rhythm universe!\"],\"Gotstar Studio\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/2wPNI5mq44mcxxPxf3Zu8gZHlMESkTimiojFl1oGivW8RtrEtoPLhzO67sY6wJF-5dWSSNGdzYNZ1UAqwZUzKw\"],null,[60,167,254,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,[null,\"Suitable for all age groups. Some violence in a comical or fantasy context is acceptable. Bad language is not permitted.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.sprunki.mod.horror.incredibox.monster.beats.music.phase\\u0026rdid\\u003dcom.sprunki.mod.horror.incredibox.monster.beats.music.phase\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],nu