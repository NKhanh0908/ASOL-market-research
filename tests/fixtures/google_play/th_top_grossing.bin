,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/il5ClTN4hHAnCtya5wBZWLWh3Tn6g0tA5KxQsMCQM6FU9ZbnpbO-B2DoYhqnuGV2g7EYw0aNmA1pDeRIqfeDU0k\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/0GbAvUd1muWGPnpsDPGxjrz8TJKMZ3WBp0VdcKf15ZJUEQP9deV1ywP0riEa9i73sdkO_BhyfqsfTzoDoeQl\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/QiipmZSXv-BGu2JWOE_CCeiVtrW4VKQyoZAPRncJQePJbOAwka_xQD5XiDjGplV_4yPIQj6gglgycjyQLtWj\"]]],\"โลกสวนดอกไม้ของฉัน\",[\"4.7\",4.7215686],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.lovemoodstudio.hyth\\u0026rdid\\u003dcom.lovemoodstudio.hyth\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.lovemoodstudio.hyth\"]],[\"qgJkGmIIC0oTCMHPrLDHkJcDFZdanQkdEZckpfoBDAoKCAASBgoCdGgQALoCOQodChdjb20ubG92ZW1vb2RzdHVkaW8uaHl0aBABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,\"SzOZsF3Iaqo\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:SzOZsF3Iaqo?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:SzOZsF3Iaqo\",null,null,null,null,\"AXH1ezmhSV26bYim-EBriop3NpoJNkesGmlnAE8m60U8R9tIFy4miua-Nu1UCSxK_2I7PVu-AjYV5cx2OhPQVN0ingE-dHYDjZP_yzDiDXTSHzDrOzVpnY42LaCIdNNpsdpamJ23-SowsVyVvUmiRtxru5x9f5dp7Jnlrvena_t2rZ9xEi0sb88_wWqrq-fGWP0a86IBneO6LDhFHo0ofiDouAkQjMnBRtsag6P_r7i_kUrPb4XUF_jtFf-6OR9nyJS32XXY3rDi5frWJ9qsCYNk_kWT6NjQDjqnyqzLfYYkxZrtKg\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/SzOZsF3Iaqo/hqdefault.jpg\"]]]],[null,\"สิ่งที่คุณปลูกไม่ใช่แค่ดอกไม้ในเกม แต่คือความโรแมนติกที่ก้าวข้ามมิติ\\u003cbr\\u003eทุกครั้งที่ปลูกและเก็บเกี่ยว มีโอกาสได้รับการ์ดอวยพรดอกไม้ แลกรับเป็นช่อดอกไม้จริง ส่งตรงถึงมือคุณ!\\u003cbr\\u003eปลูกดอกไม้อย่างผ่อนคลาย พร้อมพบเพื่อนใหม่ในโลกแห่งดอกไม้\\u003cbr\\u003e\\u003cbr\\u003eโลกสวนดอกไม้ของฉันเป็นเกมจำลองสถานการณ์ที่ผ่อนคลายและเยียวยาจิตใจ ที่นี่คุณจะได้พบเพื่อนรักดอกไม้มากมาย และสร้างสังคมเพื่อนรักดอกไม้ของคุณเอง\\u003cbr\\u003eเกมนี้เล่นง่าย เริ่มต้นได้ทันที ทุกครั้งที่ปลูกดอกไม้ก็มีความตื่นเต้นเล็กๆ รอคุณอยู่ เราอยากมอบความโรแมนติกจากโลกเสมือนมาสู่มือคุณจริงๆ!\\u003cbr\\u003e\\u003cbr\\u003e〓 โชคดีมาแล้ว ‧ ดอกไม้สดส่งฟรีถึงบ้าน 〓\\u003cbr\\u003eความโรแมนติกสุดพิเศษสำหรับคุณ! เพียงปลูกดอกไม้ในเกม เมื่อเก็บเกี่ยวดอกไม้ที่โตเต็มที่ คุณมีโอกาสได้รับการ์ดอวยพรดอกไม้ และแลกเป็นช่อดอกไม้สดส่งตรงถึงบ้านฟรีเลย!\\u003cbr\\u003e\\u003cbr\\u003e〓 ปลูกดอกไม้สบายๆ ‧ สร้างสวนเฉพาะของคุณ 〓\\u003cbr\\u003eในสวนเฉพาะของคุณ ปลูกดูแลกล้วยไม้ ลีลาวดี ดอกมะลิ และดอกไม้มากมายด้วยมือคุณเอง เพลิดเพลินกับช่วงเวลาการปลูกที่ผ่อนคลายและบำบัดใจ ปล่อยวางความเครียดทีละนิด พร้อมสัมผัสความอบอุ่นจากเพื่อนดอกไม้ที่อยู่เคียงข้าง\\u003cbr\\u003e\\u003cbr\\u003e〓 สนุกกับเพื่อน ‧ คลายเครียดด้วยสังคมเกม 〓\\u003cbr\\u003eในสวนไม่มีคำว่าเหงา! ผูกมิตรกับเพื่อนซี้ เข้าร่วมกิลด์ เยี่ยมชมสวนเพื่อน หรือแม้แต่ \\u0026quot;แอบขโมย\\u0026quot; ดอกไม้จากเพื่อนได้ด้วย! สัมผัสประสบการณ์การเล่นที่สนุกสนานและผ่อนคลาย ทุกการพบเจอคือความประหลาดใจ\\u003cbr\\u003e\\u003cbr\\u003e〓 ศิลปะการจัดดอกไม้ ‧ สร้างสรรค์ชีวิตมีระดับ 〓\\u003cbr\\u003eดอกไม้ที่เก็บเกี่ยวไม่ได้มีไว้ชมเท่านั้น แต่ยังจัดแต่งได้อย่างอิสระ ผสมผสานแจกันและดอกไม้หลากหลายชนิด สร้างสรรค์ผลงานจัดดอกไม้ของคุณเอง ตั้งแต่เลือกสีสันไปจนถึงสไตล์ ออกแบบสุนทรียภาพที่เป็นเอกลักษณ์เฉพาะตัว\\u003cbr\\u003e\\u003cbr\\u003e〓 บริหารร้านดอกไม้ ‧ สัมผัสชีวิตเจ้าของร้าน 〓\\u003cbr\\u003eรับออเดอร์ จัดทำ ขาย ขยายร้านดอกไม้ของคุณทีละขั้นตอน สร้างร้านดอกไม้ยอดนิยมของคุณอย่างค่อยเป็นค่อยไป ใช้กลยุทธ์การบริหารเพื่อเพิ่มรายได้ ให้สวนและร้านค้าเติบโตไปพร้อมกัน\\u003cbr\\u003e\\u003cbr\\u003e〓 สัตว์เลี้ยงแสนน่ารัก ‧ เยียวยาใจเป็นสองเท่า 〓\\u003cbr\\u003eดูแลน้องแมวน่ารักในบ้านแมว ให้อาหาร ลูบไล้ ตกแต่งพื้นที่ส่วนตัว เพลิดเพลินกับช่วงเวลาแห่งความอบอุ่นที่มีเพื่อนซี้สี่ขาอยู่เคียงข้าง!\"],\"LOVE MOOD STUDIO\",\"100,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/RJnwa2dbNz9slPIIdtM8Z-5r3-NgSLWFw-3xnDBjHCIPjAYGoKBjgRkk-kSBWFHTyiDZgcJhp7LYsqI9M_hW61k\"],null,[239,184,131,255]],null,[\"ประเภท 12+\",[null,2,[366,512],[null,null,\"https://play-lh.googleusercontent.com/yQChfa9XKlaXMIYTk8w8QwChjT8_SH-_2d2SS-kesw0TLQK1nxtw54bDcoZ09freZJgKrtg4f__is-31Vg\"]],[null,\"ความรุนแรงปานกลาง\"],[null,\"การโต้ตอบกับผู้ใช้\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/YrkR-GP7OKghBTATCoO_jJrchSVrh-NSUBb5DnbRZC1DbLK_cgV9FC2e_iI4GzLsKXuZjuFZajnGCiA8qA\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.lovemoodstudio.hyth\\u0026rdid\\u003dcom.lovemoodstudio.hyth\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"ติดตั้ง\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"฿5.00 - ฿3,700.00 ต่อรายการ\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"เล่นฆ่าเวลา\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.whalejoy.horrorstory.gp\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/bj-jc9ay6gZVvpMYA8cBVvY2Gt9056AAJrJORsfNz8zWRFOzUGU-_NuP3Z9MMHhe5xElvV3l1afYpq7VSnAsW2s\"],null,[58,48,46,255],null,null,null,2],[[null,2,[2796,1290],[null,null,\"https://play-lh.googleusercontent.com/zspPiI3j_ofRmvaH0Sr4o5NnD2lPUfRm_7mmlSDv4qSEwrK1j1J1qE9eRo9j-aSkRYDnq0GZ_KYDkpNdH92864A\"]],[null,2,[2796,1290],[null,null,\"https://play-lh.googleusercontent.com/hVgRKxx9B-4RACZkIhbmubKiERfHAqUnNgdmr5Vy_PZC1LrzVLxmex0v7gx1mSfQCU6SL5Ng0KjCTOYROQYjSg\"]],[null,2,[2796,1290],[null,null,\"https://play-lh.googleusercontent.com/g4N8n9FYV1Ig350otoFCo2uQqS61dEy7ub6jWPB6510K0ytqZEYyPyzzE4BR6ES2YYbBUF3Kb8FVSEUR5hzUalc\"]],[null,2,[2796,1290],[null,null,\"https://play-lh.googleusercontent.com/2UyaANnFKNoOHZ_gvZIC9JJ4wgGg6ERATCuRG570-9pqnwKRPCwNcCz4HwdFQvYKs33Sk-KgnWy2rpT0RE0-\"]],[null,2,[2796,1290],[null,null,\"https://play-lh.googleusercontent.com/QDxDJnbYazKt5LL8ko3QVmD7AuoPpHy3zWLYNxixyIFP08ydVcM5vj2BTLna_y4fV4OcZ4Bh0p0koks3BvZJGw\"]],[null,2,[2796,1290],[null,null,\"https://play-lh.googleusercontent.com/Xys1j1-gyKoFrmMeq73tk07jZ24ywsnlYJX33e7kga57ADIXUcrXYAv9uL1yxlvwmLUwudt7a37E0YwIjY8P0A\"]],[null,2,[2796,1290],[null,null,\"https://play-lh.googleusercontent.com/Ko8JCekef28I1QGrEO1CYYi7CGYb9pWLk-rm4w86El3NhHjWw4wO3AxoAaK32qqcXP1nlplSne6ymNaEJPy8\"]],[null,2,[2796,1290],[null,null,\"https://play-lh.googleusercontent.com/BmwiV_VGD4CysyZxpBgzQBf6dTbYIxqIAWnDfOub3WqAA-fklSP6VAk4Cr1hRRUc3zdmLdIHi2LaUQto5Ai8OA\"]]],\"Haunted Merge: Horror Story\",[\"4.8\",4.7534246],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.whalejoy.horrorstory.gp\\u0026rdid\\u003dcom.whalejoy.horrorstory.gp\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.whalejoy.horrorstory.gp\"]],[\"qgJoGmYIDEoTCMHPrLDHkJcDFZdanQkdEZckpfoBDAoKCAASBgoCdGgQALoCPQohChtjb20ud2hhbGVqb3kuaG9ycm9yc3RvcnkuZ3AQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],[[[null,null,\"IgTaB-tShew\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:IgTaB-tShew?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:IgTaB-tShew\",null,null,null,null,\"AXH1ezneFkEUaVDjFw14XVzTU2FxPqovUAdhSrTUaeom-KxhLpY2MWYYRWG3IN3726t5sJDRZbmdhlCX9QdirBBgPohps6A8NOfm56YeKshp4gwnKX7rAxbPuPxZelquruQ2WXGq7aeRTfgDOmgr5bwyhcIVr_nV7gOKd-0WUIBh17e9GpwDrqGjIPyCWBTmebvveb4xfP9Fup2Pm32su2Id_L9zD81gFjRQW54iPWiujsGRHok5rUuWrK9WZ2e7uZKUCKfFdsMt1kqpXpRKEFLtjsP_8ZQH_6Shtou2jsH6RGji2g\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/IgTaB-tShew/hqdefault.jpg\"]]]],[null,\"คุณมองไม่เห็นพวกเขา... แต่พวกเขามองเห็นคุณ\\u003cbr\\u003e\\u003cbr\\u003eคุณเป็นเด็กกำพร้าคนหนึ่งซึ่งได้รับการเลี้ยงดูโดยซินแสดูฮวงจุ้ยที่ออกเดินทางไปทั่วและพบคุณใกล้สุสาน ก่อนที่เขาจะตาย เขาได้มอบกล่องที่ล็อกไว้ให้คุณ ซึ่งเป็นเบาะแสเดียวที่จะเผยความจริงเกี่ยวกับอดีตของคุณ หลังจากที่ฝังศพเขาเรียบร้อยแล้ว คุณก็เริ่มต้นออกเดินทางเพื่อค้นหาความจริง\\u003cbr\\u003eเบาะแสแรกนำคุณมายังอาคารอพาร์ตเมนต์เก่าๆ คุณเช่าห้องและย้ายเข้าไปอยู่ที่นั่น แต่มีเหตุการณ์บางอย่างที่ผิดปกติเป็นอย่างยิ่ง\\u003cbr\\u003e- ลิฟต์เปิดเองที่ชั้นที่ไม่มีใครกด\\u003cbr\\u003e- ห้องว่างเปล่าที่ก้องไปด้วยเสียงกระซิบที่ไม่มีอยู่จริง\\u003cbr\\u003e- ไซต์ก่อสร้างต้องคำสาปคอยคร่าชีวิตผู้คนอยู่เรื่อยๆ...\\u003cbr\\u003eเรื่องราวที่ในตอนเริ่มต้นเหมือนจะเป็นเรื่องผีนั้นกลับกลายเป็นเรื่องราวที่น่าสะเทือนใจกว่ามาก\\u003cbr\\u003eเพราะในบางครั้งสิ่งที่น่ากลัวจริงๆ ไม่ใช่ผี แต่กลับเป็นคนนี่เอง\\u003cbr\\u003e\\u003cbr\\u003eฟีเจอร์ในเกม:\\u003cbr\\u003eเผชิญหน้ากับความกลัวและเปิดเผยความลับที่ถูกฝังกลบไว้มาอย่างยาวนาน\\u003cbr\\u003eรวมเบาะแสเพื่อเปิดเผยความจริงที่ซ่อนอยู่\\u003cbr\\u003eมองให้ละเอียด เพราะทุกรายละเอียดอาจช่วยให้ไขคดีได้\\u003cbr\\u003eแก้ปริศนาและผ่อนคลายผ่านการสัมผัสประสบการณ์ชวนขนลุกที่หาไม่ได้จากที่อื่น\\u003cbr\\u003e\\u003cbr\\u003eคุณกล้าที่จะสืบให้ลึกลงไปหรือเปล่า?\\u003cbr\\u003eพ่อแม่ของคุณตายไปแล้วแท้ๆ แต่ทำไมถึงเกิดเรื่องแบบนี้ได้?\\u003cbr\\u003eมันเป็นคำสาป... หรือการปิดบังกันแน่?\\u003cbr\\u003eคุณบอกได้มั้ยว่าอะไรเป็นเรื่องจริงและอะไรเป็นแค่การจัดฉาก?\\u003cbr\\u003eผู้คนยังถูกพรากชีวิตอยู่เรื่อยๆ จะเป็นเพราะอุบัติเหตุหรือสิ่งที่เลวร้ายกว่านั้นกันแน่?\\u003cbr\\u003e\\u003cbr\\u003eเกมนี้เหมาะสำหรับผู้เล่นที่ชื่นชอบสิ่งต่างๆ ต่อไปนี้\\u003cbr\\u003eชอบนิทานพื้นบ้านที่น่าขนลุกและปริศนาสุดหลอน\\u003cbr\\u003eสนุกกับกลไกการรวมไอเทมที่แปลกใหม่\\u003cbr\\u003eสนใจเรื่องราวเกี่ยวกับด้านมืดในจิตใจของมนุษย์\\u003cbr\\u003eนี่คือทางออกเดียวของคุณ\\u003cbr\\u003e\\u003cbr\\u003eดาวน์โหลด Haunted Merge: Horror Story\\u003cbr\\u003eรวบรวมหลักฐาน เปิดเผยความจริง\\u003cbr\\u003eเปิดโปงความลับอันน่าสะพรึงกลัวที่ถูกฝังกลบไว้เบื้องหลังทุกเรื่องราวที่พวกเขาพยายามลบเลือนให้หายไป\\u003cbr\\u003e\\u003cbr\\u003eFacebook:\\u003cbr\\u003ehttps://www.facebook.com/HauntedMergeGames\"],\"WhaleJoy Game Limited\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/0J-mq5H4QCThfEQvEoKHXaxMMob0O6a0FxJfT5WvqXTbBLOtZwwhmy3eewvCOJkmznnuykYnYu424DPKBYUq5w\"],null,[18,20,18,255]],null,[\"ประเภท 12+\",[null,2,[366,512],[null,null,\"https://play-lh.googleusercontent.com/yQChfa9XKlaXMIYTk8w8QwChjT8_SH-_2d2SS-kesw0TLQK1nxtw54bDcoZ09freZJgKrtg4f__is-31Vg\"]],[null,\"สยองขวัญ\"],null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/YrkR-GP7OKghBTATCoO_jJrchSVrh-NSUBb5DnbRZC1DbLK_cgV9FC2e_iI4GzLsKXuZjuFZajnGCiA8qA\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.whalejoy.horrorstory.gp\\u0026rdid\\u003dcom.whalejoy.horrorstory.gp\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"ติดตั้ง\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"฿20.00 - ฿3,450.00 ต่อรายการ\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"เล่นฆ่าเวลา\"]]]],null,null,null,[],null,null,null,[]],[[[