XtuZdKOfuVVB53ZtkiImx6MKe4qJpffs-IVY4BlAHve_9aAD1ujFUaf69PkmA\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/dceMaKBpIZucRJIMIllQlIGsq307h3xQ-jAb4bcNXsa6jq1jnm3Yi-tZx5VOAxn8ZLSHa57sCrdEXVf66fMU2A\"]]],\"Quack Quack Attack\",[\"4.8\",4.760274],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.haoplay.game.gp.duck\\u0026rdid\\u003dcom.haoplay.game.gp.duck\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.haoplay.game.gp.duck\"]],[\"qgJlGmMIOUoTCMHPrLDHkJcDFZdanQkdEZckpfoBDAoKCAASBgoCdGgQALoCOgoeChhjb20uaGFvcGxheS5nYW1lLmdwLmR1Y2sQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],[[[null,null,\"RKK0gyt__3g\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:RKK0gyt__3g?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:RKK0gyt__3g\",null,[1920,1080],null,null,\"AXH1ezly-s9FI_byaYG-QlV2LamvuA4Ui2Ni-EIu3hQr72pSXYGfa2lDZjDkyjN4Cmlcb2P472uOCjmL2KJdHRWciPQviUk0t_O_86TFWuhiWOwHErIjKZlDfgMu72R9rdQLe-aB_EutsoESl_2rJPlqyWdsOwvj_R4Eyub_CT-JJWiAkhqYS5B2GyonCfQFBI1EHq4CIXVABeQ_y8INqRI7B-aEfVUoI0Dvb1-KUO-C1xY7nXf0_rO3x1JRM2LTtHLXobvDohJdGy24UljMAjDjy2PnK2wYARAuruDgnYGaRGy9LQ\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/RKK0gyt__3g/hqdefault.jpg\"]]]],[null,\"บนท้องทะเลสีครามไม่สิ้นสุด เป็ดตัวหนึ่งค่อย ๆ ตื่นขึ้นมาบนดาดฟ้าแห่งโนอาห์อันลึกลับ คุณที่สูญเสียความทรงจำ จะได้สวมบทบาทเป็น “กัปตันเป็ด” ควบคุมเรือมหัศจรรย์นี้ แล่นไปยังเกาะแฟนตาซีที่เต็มไปด้วยอันตราย! \\u003cbr\\u003e\\u003cbr\\u003eระหว่างการผจญภัย  คุณจะได้พบและช่วยเหลือเหล่าฮีโร่นกพลังพิเศษ เช่น ไก่จอมเวทผู้ควบคุมสายฟ้า นักสู้ฝีมือเยี่ยม และอีกมากมาย เผชิญหน้ากับฝูงมอนสเตอร์และกับดักสุดโหดมากมาย นำกองทัพฮีโร่นกสุดน่ารักของคุณ ปาไข่เด้งสนุกสุดมันส์ ทำลายศัตรูและอุปสรรคให้หมด! นอกจากนี้ยังสามารถเก็บทรัพยากร เปิดไข่ลึกลับ ปรับแต่งชุดฮีโร่  และจัดตกแต่งเรือ พร้อมออกตามหาความลับสุดยอดของท้องทะเลแห่งนี้!\\u003cbr\\u003e\\u003cbr\\u003eจุดเด่นของเกม\\u003cbr\\u003e\\u003cbr\\u003eเล่นง่ายมือเดียว ยิงมันส์ล้างจอเด้งไม่จำกัด\\u003cbr\\u003eเล่นได้ทุกที่ทุกเวลา เริ่มเกมได้ทันที ใช้แค่มือเดียวก็เอาอยู่! ลากเล็งแล้วปล่อย! ใช้แรงเด้งตามหลักฟิสิกส์ ยิงกลางฝูงมอนสเตอร์แบบเด้งไม่จำกัด ล้างจอในพริบตา สะใจสุด ๆ\\u003cbr\\u003e\\u003cbr\\u003eฮีโร่นก 50+ ตัว จัดทีมในสไตล์ของคุณ\\u003cbr\\u003eรวบรวมฮีโร่นกมากกว่า 50 ตัว จัดทีมได้อิสระในสไตล์คุณตามด่านที่ออกแบบมาหลากหลาย ใช้จังหวะ “ชน + คอมโบ” ปล่อยดาเมจแบบต่อเนื่องจนศัตรูตั้งตัวไม่ทัน!\\u003cbr\\u003e\\u003cbr\\u003eสายไฟ สายฟ้า จัดบิ้วได้อิสระ\\u003cbr\\u003eสร้างสไตล์การเล่นได้หลากหลาย ไม่จำเจ จะทีมไฟระเบิดเดือด หรือทีมสายฟ้าล้างจอ ก็จัดได้ตามใจ ระบบธาตุเพิ่มมิติกลยุทธ์ทุกการต่อสู้ ปลดล็อกสกินสุดเท่ เพิ่มทั้งลุคเท่ ๆ และค่าสเตตัสแบบจัดเต็ม!\\u003cbr\\u003e\\u003cbr\\u003e▼  ระบบอัปเกรดจัดเต็ม พร้อมสัตว์วิเศษช่วยสู้\\u003cbr\\u003eอัปพลังได้รอบด้าน ทั้งอุปกรณ์ การ์ด อัญมณี ครบทุกสายฟาร์ม! ท้าทายดันเจี้ยนหลากหลาย เช่น \\u0026quot;หอคอยนรก\\u0026quot; ปลุกพลัง \\u0026quot;สัตว์วิเศษ\\u0026quot; มาช่วยต่อสู้ ลุยโหมด \\u0026quot;ไม่สิ้นสุด\\u0026quot; หรือพักชิลที่ \\u0026quot;ตกปลา\\u0026quot; ก็ได้\\u003cbr\\u003e\\u003cbr\\u003eเล่นสบาย ของแจกเพียบ เปิดไข่สุดฟิน\\u003cbr\\u003eรับทรัพยากรง่าย ของแจกเพียบ สนุกกับการ “เปิดไข่” ลุ้นไอเทมหายาก ล็อกอินรับสิทธิพิเศษมากมาย ลุ้นรับฮีโร่ระดับ S ฟรี! แม้ออฟไลน์ ลูกเรือก็ยังช่วยเก็บของให้อัตโนมัติ ฟาร์มต่อเนื่องแบบไม่ต้องเหนื่อย\\u003cbr\\u003e\\u003cbr\\u003eโลกกำลังจะล่มสลาย! เครื่องยนต์เรือเริ่มทำงานแล้ว!\\u003cbr\\u003eกัปตัน รีบขึ้นเรือ ดาวน์โหลดเกม แล้วนำกองทัพนก ลุยฝ่าวันสิ้นโลกด้วยสไตล์สุดมันส์กันเลย!\\u003cbr\\u003e\\u003cbr\\u003eติดตามเราได้ที่:\\u003cbr\\u003eDiscord: https://discord.com/invite/quackquackattack\\u003cbr\\u003eFacebook:\\u003cbr\\u003ehttps://www.facebook.com/playquackquackattack\\u003cbr\\u003eX：https://x.com/QuackAttackEN\\u003cbr\\u003eyoutube: https://www.youtub