ercontent.com/IpcD-bzRWDp3kiNfHO4AS7P8V5E981cl3Mqk1ctO0RV8q0gb-bFV5RreJkY6r73IUB0Z2A26qJM9pXhRtD_HBcI\"]],[null,2,[1536,2048],[null,null,\"https://play-lh.googleusercontent.com/WsNWrX_nUiX_YZlegj8-3DEC5eFJcxbgU95zJKFbJ5zCAvEHE4QE31QO1U6jBcF8CniXy52LEEBbagAMRAyrog\"]],[null,2,[1536,2048],[null,null,\"https://play-lh.googleusercontent.com/cXwoG28-iRz4UuhP1w48QXj8ezpAnMMpl1S-mv4s_liZmZIXcatN39oyy0-gWlaaxy-MHNy3gaFOKGGt_dtiCw\"]],[null,2,[1536,2048],[null,null,\"https://play-lh.googleusercontent.com/foIJzHR4tL-tjSHFatPbLdqgsfo5jJzX59GQC3qURddd3-7pubCXuop_CxZvkmOiQjGg9I2lYunNgQMDrDBMYQ\"]],[null,2,[1536,2048],[null,null,\"https://play-lh.googleusercontent.com/7-VuTLhmKUT6bCLu0Z7Q91ePSDQWPxj0OMdTyYJQlmuQBwwUTNUkezo-tTCs4UXQCw9jeRGyIPVvgI9FbErBEg\"]],[null,2,[1536,2048],[null,null,\"https://play-lh.googleusercontent.com/WIj2Grb8ZCbXteY70uAaeJvJ2UxZCXKOQzBIqvy_cdZcV9C1aXbHx__UKDadjM2FcdpOclWkmWqo2MECUFPO\"]],[null,2,[1536,2048],[null,null,\"https://play-lh.googleusercontent.com/yHW7c4Qdja5lVLbRtocP17rjOl9NOJg30oksQw8hNSRpHZuTKnCs2ntjtYeLQGMkt0SfEVS5Mua-xZdSkWBKcw\"]]],\"Family Island™ — เกมฟาร์ม\",[\"4.6\",4.5918183],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.MelsoftGames.FamilyIslandFarm\\u0026rdid\\u003dcom.MelsoftGames.FamilyIslandFarm\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.MelsoftGames.FamilyIslandFarm\"]],[\"qgJuGmwIB0oTCMHPrLDHkJcDFZdanQkdEZckpfoBDAoKCAASBgoCdGgQALoCQwonCiFjb20uTWVsc29mdEdhbWVzLkZhbWlseUlzbGFuZEZhcm0QARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],null,[null,\"ชีวิตคุณจะเป็นเช่นไร หากปราศจากเทคโนโลยีสมัยใหม่บนเกาะร้าง? ดำดิ่งลงสู่ความเรียบง่ายของโลกดั้งเดิมกับครอบครัว ยุคหิน ที่ทันสมัยในเกมการผจญภัยอันแสนจะน่าตื่นเต้นนี้ เตร็ดเตร่ไปบนเกาะอันห่างไกล ครอบครัวที่มีสมาชิกสี่คน- บรูซ อีวา และลูก ๆ ของพวกเขา - จำเป็นต้องได้คำแนะนำของคุณ และช่วยสร้างอาคารของครอบครัวหลังใหม่ตั้งแต่เริ่มต้น แล้วนำทางผ่านสถานการณ์ของครอบครัวต่าง ๆ ไปด้วยอารมณ์ขัน\\u003cbr\\u003e\\u003cbr\\u003eหลังจากที่เมืองเดิมของพวกเขาถูกทำลายลงด้วยการระเบิดของภูเขาไฟ มาช่วยครอบครัวนี้สร้างเมืองให้เจริญรุ่งเรือง ในขณะที่หาทางเชื่อมโยงกับครอบครัวและหมู่บ้านอันเป็นที่รักของพวกเขาที่สูญหายไป ในเกมฟาร์มเกมนี้ โลกของพวกเขาอาจดูเหมือนโบราณและผิดแผกไปจากเทคโนโลยีสมัยใหม่ แต่กระนั้นชีวิตประจำวันของครอบครัวและความสัมพันธ์นั้น ก็ให้ความรู้สึกที่คุ้นเคยอย่างยิ่งในโลกปัจจุบัน\\u003cbr\\u003e\\u003cbr\\u003eFamily Island™ เป็นเกมฟาร์มที่เต็มไปด้วยการหักมุมที่ไม่คาดคิด และการผจญภัยที่มีเสน่ห์!\\u003cbr\\u003e\\u003cbr\\u003eคุณสมบัติ:\\u003cbr\\u003e\\u003cbr\\u003e★ เพลิดเพลินกับการผจญภัยของคุณไปยัง ยุคหิน! ใช้ความคิดสร้างสรรค์แล้วเริ่มการทำฟาร์มใช้เทคโนโลยีโบราณสุดเจ๋ง\\u003cbr\\u003e★ ในเกมฟาร์มเกมนี้ คุณสามารถปลดปล่อยความเป็นนักสำรวจในตัวคุณ แล้วออกไปสู่การผจญภัยอันน่าตื่นเต้นไปยังเกาะแห่งใหม่\\u003cbr\\u003e★ เริ่มการทำฟาร์มจำลองของครอบครัวคุณเองบนเกาะร้าง! เพาะปลูกพืชผลและสร้างสินค้าที่เป็นประโยชน์ เพื่อซื้อขายกับตัวละครอื่น ๆ\\u003cbr\\u003e★ ปรับแต่งฟาร์มของคุณด้วยของตกแต่งอันสวยงาม\\u003cbr\\u003e★ ทำความรู้จักกับครอบครัวให้ดียิ่งขึ้น แล้วนำทางพวกเขาผ่านการผจญภัยอันน่าตื่นเต้นและเรื่องราวชีวิตในเกมเกาะแห่งนี้\\u003cbr\\u003e\\u003cbr\\u003e____________\\u003cbr\\u003e\\u003cbr\\u003eติดตาม Family Island ใน Facebook และ Instagram สำหรับข้อเสนอและโบนัสสุดพิเศษ!\\u003cbr\\u003eFacebook: facebook.com/familyislandgame/\\u003cbr\\u003eInstagram: instagram.com/familyislandgame/\\u003cbr\\u003eข้อกำหนดการให้บริการ: https://static.moonactive.net/legal/terms.html?lang\\u003den\\u003cbr\\u003eประกาศนโยบายความเป็นส่วนตัว: https://static.moonactive.net/legal/privacy.html?lang\\u003den\\u003cbr\\u003eมีคำถามเกี่ยวกับเกมใช่ไหม? ติดต่อเราในเกมได้โดยการคลิกที่ เมนู \\u0026gt; การตั้งค่า \\u0026gt; สนับสนุน\\u003cbr\\u003eฝ่ายสนับสนุนของเราเตรียมพร้อมรออยู่ที่นี่เช่นกัน: https://melsoft-games.helpshift.com/hc/en/11-family-island/\"],\"Melsoft Games Ltd\",\"50,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/yW-Q0E-ntIf0KbcaTfIZn6WYIwLvkqa2gwaVWRPIbyy3zrHodlRSd9d_hSHwhqGwY74xBoQQn55pdL-BlPm4fw\"],null,[140,212,167,255]],null,[\"ประเภท 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"การโต้ตอบกับผู้ใช้และการซื้อในเกม (รวมถึงรายการสุ่ม)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.MelsoftGames.FamilyIslandFarm\\u0026rdid\\u003dcom.MelsoftGames.FamilyIslandFarm\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"ติดตั้ง\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"฿35.00 - ฿5,300.00 ต่อรายการ\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"เล่นฆ่าเวลา\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.farlightgames.pgame.gp\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/nIjO9pFz1R7G_wct00QMBKVqAmLHs2TqiaCmSUJfnKPw7yG_VzSmp26TRGCmm98v-Mye0MtsW_xz8CHNdIFD1A\"],null,[146,43,245,255],null,null,null,2],[[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/HOPzX_eaut8xz3mrGFJDo