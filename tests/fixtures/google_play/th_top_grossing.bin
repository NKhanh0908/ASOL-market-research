2732,2048],[null,null,\"https://play-lh.googleusercontent.com/xbBfPfnanWMPfnGvJi0aZTCfRloHoM5yn5ToR-vlST-l2y45iqoilOphQRyOJYgqVHROokgckWdCIxqQEVGvDQ\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/JnRE2no9GkPzdKFTtNGa63cZkBa9-tj5FEkHE7ACp24SESSFxTdJYZWP9ivBjPFsruya4WCzbnFK2JqSgTF6\"]]],\"Hotel Legacy: Merge Game\",[\"4.6\",4.5576925],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.fatr.global\\u0026rdid\\u003dcom.fatr.global\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.fatr.global\"]],[\"qgJcGloIEkoTCMHPrLDHkJcDFZdanQkdEZckpfoBDAoKCAASBgoCdGgQAboCMQoVCg9jb20uZmF0ci5nbG9iYWwQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],null,[null,\"Alyssa suddenly inherited a mysterious legacy from her grandmother—a Hotel Manor! She teams up with some interesting friends and desires to build her Hotel Empire! Join us as we merge and discover how she achieves her goals!\\u003cbr\\u003e\\u003cbr\\u003eMerge Fancy Items\\u003cbr\\u003eServe guests with cozy service, fine cuisines, amazing drinks, and colorful souvenirs. The more you play, the more items you will be able to create! Let\\u0026#39;s merge together and become top-class hotel managers!\\u003cbr\\u003e\\u003cbr\\u003eRenovate Theme Hotels \\u003cbr\\u003eBuy new land, renovate old buildings, and turn them into wonderful hotels. Experience a totally different hotel style all over the world and throughout the ages!\\u003cbr\\u003e\\u003cbr\\u003eBuild Relationships\\u003cbr\\u003eMeet guests from around the world. Listen to their stories and exchange fun life experiences. Guess who might find their true love during the journey?\\u003cbr\\u003e\\u003cbr\\u003eThere are hidden surprises waiting for you to discover! Join us on the journey of expanding Hotel Empires!\"],\"Century Games Innovation Pte. Ltd.\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/KDL2eRDsgjpaZP8B0DfHudGf6zWE_4rz8jMk924St4qSZHhULB-RIGixLGGmtc-t_pcgHMSRtetE1VEESDrs\"],null,[163,38,35,255]],null,[\"ประเภท 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,[null,\"เหมาะสมสำหรับทุกกลุ่มอายุ มีความรุนแรงได้เล็กน้อยในบริบทที่ตลกขบขันหรือแฟนตาซี ห้ามไม่ให้มีภาษาที่หยาบคาย\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.fatr.global\\u0026rdid\\u003dcom.fatr.global\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"ติดตั้ง\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"฿35.00 - ฿3,700.00 ต่อรายการ\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"เล่นฆ่าเวลา\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.overseasgp.kljt\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/1Nh1rfxG3FAzr0g_3VY8piqJ_uEHKreR1mHdCmp9TZvIQber0QlwJE1xLBETfMHCK4hYahQm1jnP4SUkRudV6LQ\"],null,[255,159,0,255],null,null,null,2],[[null,2,[2868,1320],[null,null,\"https://play-lh.googleusercontent.com/