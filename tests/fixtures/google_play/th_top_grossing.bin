],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/wrk3C87d99QxYiyir1jeMQH0Qa_o5JJIMTO33zu-etz-Gt-KcrIByNQmBJ-6hRCW3W69wKQeTR4iv4FcWzpBm90\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/tDNVUxLS9jXOO3ntNeejCHwmT358JPrXLThMOhyMySUTmL7bv0gxUsbyID3n7jxeLNhuet0-R7JO2gxzcDBU\"]]],\"Clash of Critters\",[\"4.7\",4.704955],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.farlightgames.pgame.gp\\u0026rdid\\u003dcom.farlightgames.pgame.gp\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.farlightgames.pgame.gp\"]],[\"qgJnGmUICEoTCMHPrLDHkJcDFZdanQkdEZckpfoBDAoKCAASBgoCdGgQALoCPAogChpjb20uZmFybGlnaHRnYW1lcy5wZ2FtZS5ncBABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"สะสมทาทาริสุดพิเศษที่มีความเฉพาะตัวกว่า 100 แบบ!\\u003cbr\\u003eลืมดีไซน์จำเจแบบเดิมๆ ไปได้เลย โดยสะสมได้ตั้งแต่อ๊บแก้วมังกรสุดต๊อง ไปจนถึงแพร์สุริยะหน้าบึ้ง ตัวน้อยสุดน่ารักเหล่านี้ทั้งหมดเป็นของคุณได้ภายในแค่เดือนเดียว!\\u003cbr\\u003e\\u003cbr\\u003eวิวัฒนาการเพื่อเสริมพลังได้เลย!\\u003cbr\\u003eบรรลุพัฒนาการระดับ 4 อันน่าสะพรึงกลัวและปลดล็อกร่างแวววาวสุดหายาก! คุณจะมีทาทาริได้ถึงกี่ตัวกันนะ\\u003cbr\\u003e\\u003cbr\\u003eการรบเชิงกลยุทธ์\\u003cbr\\u003eผสมผสานจัดทีมแบบต่างๆ เพื่อค้นพบคอมโบที่ทรงพลัง และบดขยี้โซโบ้ระลอกแล้วระลอกเล่าโดยใช้ความเป็นอัจฉริยะด้านการวางกลยุทธ์ของคุณเอง!\\u003cbr\\u003e\\u003cbr\\u003eเนรมิตสรวงสวรรค์ทาทาริของคุณเอง\\u003cbr\\u003eสร้างบ้านแสนสบายและโต้ตอบกับเหล่าสัตว์เลี้ยงของคุณ จะเกิดอะไรขึ้นกันนะถ้าคุณแอบหย่อนเจ้าตูบหิมะลงในสระน้ำ\"],\"FARLIGHT\",\"5,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/Pk_R4JRVwxGpuf1bxjYWm_SgFFAXdgOhBJCBF9W7-oVNEqZvP08h5FRLNWTP9MHX4VKIaSO6zK7vN3L6rYIwQw\"],null,[124,204,253,255