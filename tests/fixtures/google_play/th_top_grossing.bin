3dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.domozoo.elf\"]],[\"qgJcGloIPkoTCMHPrLDHkJcDFZdanQkdEZckpfoBDAoKCAASBgoCdGgQALoCMQoVCg9jb20uZG9tb3pvby5lbGYQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],[[[null,null,\"Ho8Y3y10cEo\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:Ho8Y3y10cEo?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:Ho8Y3y10cEo\",null,null,null,null,\"AXH1ezmPUhcPBVSku0H58nQ5nbyGs1v5K5UQOGiG1PsLdaG6bWJeaB3JdouGf1DMPA57kBg-iUvfZLSK3b6egRURYRI6F41X_xvkvGt6E7G4NSwZAz2OQF7KuZkwwYy3QSYYcNEn9Ewrnchdr_KMzxFyZosN406tclXvfJdmZc1tKGkwZIMlqqAZNbqPq8iMIqHXF2ySmgvHs--oMvmCyvNo9Xz7c4mKCQt5kVDQTca8kjR3VBvYA430dhofWSWxZDWBW1pL-G6vWPmcUjBQq_UwoJoQL5_qewmqi7gpRSf8EXyaSA\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/Ho8Y3y10cEo/hqdefault.jpg\"]]]],[null,\"ยินดีต้อนรับสู่ Tap Troop! เกมวางแผนกลยุทธ์แบบสบายๆ ที่สนุกและเล่นง่าย ควบคุมได้ด้วยนิ้วเดียวเท่านั้น แต่ละแมตช์ใช้เวลาเพียง 3 นาที – เล่นได้ทุกที่ทุกเวลา! สะสมฮีโร่สุดน่ารักและสร้างกองทัพของคุณเอง คุณสามารถบุกตะลุยเข้าสู่สนามรบหรือเล่นแบบวางแผนอย่างรอบคอบก็ได้ สนุกไปกับการต่อสู้เชิงกลยุทธ์ที่เร้าใจและความสนุกไม่รู้จบ!\\u003cbr\\u003e\\u003cbr\\u003eการต่อสู้ที่รวดเร็ว\\u003cbr\\u003eเล่นได้ง่ายๆ เพียงแค่แตะมือ! แมตช์ที่รวดเร็วและสั้น สนุกกับการต่อสู้แบบรวดเร็วระหว่างเดินทาง ระหว่างรอคิว หรือระหว่างพักกลางวัน เป็นตัวเลือกที่สมบูรณ์แบบสำหรับเวลาว่างของคุณ!\\u003cbr\\u003e\\u003cbr\\u003eกลยุทธ์การต่อสู้\\u003cbr\\u003eชัยชนะมาจากการคิดวางแผน ไม่ใช่โชค! ปรับฮีโร่และรูปแบบการจัดทัพของคุณตามสถานการณ์ในสนามรบ เลือกได้ระหว่างการโจมตีที่ดุเดือดหรือการป้องกันที่แข็งแกร่ง ทุกการเคลื่อนไหวส่งผลต่อผลลัพธ์ของการต่อสู้ – เอาชนะคู่ต่อสู้ของคุณและกลายเป็นนักวางแผนกลยุทธ์ระดับปรมาจารย์!\\u003cbr\\u003e\\u003cbr\\u003eทีมฮีโร่\\u003cbr\\u003eสะสมฮีโร่สุดน่ารักมากมายที่มีรูปลักษณ์และทักษะเฉพาะตัว ผสมผสานและจับคู่พวกเขาได้อย่างอิสระเพื่อสร้างทีมที่ดีที่สุดของคุณ คุณจะต้องชอบเกมนี้!\\u003cbr\\u003e\\u003cbr\\u003eรับรางวัลมากมาย\\u003cbr\\u003eเอาชีวิตรอดจนจบและคว้า \\u0026quot;ชัยชนะ\\u0026quot; (Chicken Dinner)! คุณสามารถเลือกที่จะโจมตีหรือป้องกัน และทุกชัยชนะจะได้รับรางวัลมากมาย สะสมฮีโร่สุดพิเศษและไอเทมหายากเพื่อเพิ่มอันดับของคุณ!\\u003cbr\\u003e\\u003cbr\\u003eความท้าทายแบบทีม เบื่อกับการเล่นคนเดียวแล้วใช่ไหม? งั้นมาร่วมทีมกับเพื่อน ๆ เพื่อท้าทายบอสโลกสุดแกร่ง! ทำงานร่วมกัน ใช้กลยุทธ์แบบทีม และเอาชนะศัตรูที่น่าเกรงขาม!\"],\"DOMO ZOO\",\"100,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/whhZ8Ru6akn47uHOUuWp6tl8E7kYSdzo8K9o7pYZYcKBS0cQNQxYscS59A_4zHJHiYOSSSRezIB05N26vRp5ow\"],null,[39,44,100,255]],null,[\"ประเภท 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"การโต้ตอบกับผู้ใช้\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.domozoo.elf\\u0026rdid\\u003dcom.domozoo.elf\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"ติดตั้ง\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"฿34.00 - ฿3,450.00 ต่อรายการ\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"เล่นฆ่าเวลา\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null