,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.feelingtouch.rush\\u0026rdid\\u003dcom.feelingtouch.rush\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.feelingtouch.rush\"]],[\"qgJiGmAIMEoTCMHPrLDHkJcDFZdanQkdEZckpfoBDAoKCAASBgoCdGgQALoCNwobChVjb20uZmVlbGluZ3RvdWNoLnJ1c2gQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],[[[null,null,null,[null,null,\"https://www.youtube.com/watch?v\\u003duRSO2Ylv8EQ\"]],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/uRSO2Ylv8EQ/hqdefault.jpg\"]]]],[null,\"แนะนำเกม:\\u200b\\u200b\\u003cbr\\u003e『Zombie World War: Storm』เกมมือถือแนวยิงแนวตั้งแบบ Roguelike คุณภาพสูง! ระบบฝึกฮีโร่และอัปเกรดปืนที่อิสระสุดๆ ให้คุณทุ่มความคิดสร้างสรรค์ออกแบบสไตล์การเล่นสุดแกร่งด้วยตัวเอง ดินแดนแปลกตา+มอนสเตอร์ลึกลับ, สกิลฮีโร่อลังการ, ปืนใหญ่ยานเกราะสุดคูล, ระบบป้องกันด่านหนาแน่น, บุกสังหารหมู่ซอมบี้ในจังหวะดนตรีเร้าใจ - ทุกอย่างรวมเป็นประสบการณ์รุนแรงจนเสียวสีน!\\u003cbr\\u003e\\u003cbr\\u003e\\u200b\\u200bเรื่องราวฉากหลัง:\\u200b\\u200b\\u003cbr\\u003eหายนะจากต่างมิติถาโถม! ระลอกซอมบี้คลั่งกลืนกินทุกสิ่งมีชีวิต!\\u003cbr\\u003eทรัพยากรเหือดแห้ง อารยธรรมล่มสลาย มนุษยชาติถอยร่นจนมุม แม้ฮีโร่ผู้กล้าจะผุดขึ้นแต่พวกเขาก็ยังถูกบีบให้ยัดเยียดในพื้นที่ลี้ภัยหดแคบลงทุกวัน...\\u003cbr\\u003eเมื่อความหวังมอดลง \\u200b\\u200bคุณ\\u200b\\u200b ก็ปรากฏตัว! ในฐานะผู้บัญชาการสมบูรณ์แบบ จงบัญชาการปืนใหญ่ร่วมกับเหล่าฮีโร่ ปกป้องพื้นที่อยู่อาศัยสุดท้ายของมนุษย์ และเตรียมล้างบางความมืดไปตลอดกาล!\\u003cbr\\u003e\\u003cbr\\u003e\\u200b\\u200bจุดเด่นของเกม:\\u200b\\u200b\\u003cbr\\u003e① \\u200b\\u200bฟันฝ่าอสูรกายสะใจลั่น:\\u200b\\u200b\\u003cbr\\u003eแรงยิงถล่มโลกกวาดล้างซอมบี้เป็นแพ็ค พลังทะลุจอ+ปลดปล่อยความเครียดสุดวิ้ง!\\u003cbr\\u003e② \\u200b\\u200bโลกล่มสลาย × Roguelike:\\u200b\\u200b\\u003cbr\\u003eคอมโบฮีโร่ในเกมสุ่มสมบูรณ์ วัดทั้งฝีมือและโชคแบบลุ้นระทึก!\\u003cbr\\u003e③ \\u200b\\u200bระบบอัปเกรดสายฟรี:\\u200b\\u200b\\u003cbr\\u003eไม่ใช่แค่เพิ่มค่าสถานะ! ค้นพบสไตล์เฉพาะตัว สร้างกลยุทธ์เจาะจงศัตรู\\u003cbr\\u003e④ \\u200b\\u200bคอมโบประสานพลังขั้นเทพ:\\u200b\\u200b\\u003cbr\\u003eเอฟเฟกต์สายสัมพันธ์ระหว่างผู้บัญชาการ-ฮีโร่ ปลดล็อกปะทุพลิ้วเพี้ยนเปลี่ยนเกมการรบ\\u003cbr\\u003e⑤ \\u200b\\u200bโคออปโหมดดับหายนะ:\\u200b\\u200b\\u003cbr\\u003eเชื่อมต่อเรียลไทม์กับเพื่อน ร่วมสกัดคลื่นซอมบี้รุนแรง!\"],\"FT Games\",\"100,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/5CD50DGY7xZU2n07ArXGXf2nbl6RsenssSCowZCbeic_Dbvqk_6WgP4q7dveuujP0k9ABF905DEdEDEZMQ9a\"],null,[133,149,245,255]],null,[\"ประเภท 12+\",[null,2,[366,512],[null,null,\"https://play-lh.googleusercontent.com/yQChfa9XKlaXMIYTk8w8QwChjT8_SH-_2d2SS-kesw0TLQK1nxtw54bDcoZ09freZJgKrtg4f__is-31Vg\"]],[null,\"ความรุนแรงปานกลาง\"],[null,\"การโต้ตอบกับผู้ใช้\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/YrkR-GP7OKghBTATCoO_jJrchSVrh-NSUBb5DnbRZC1DbLK_cgV9FC2e_iI4GzLsKXuZjuFZajnGCiA8qA\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.feelingtouch.rush\\u0026rdid\\u003dcom.feelingtouch.rush\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"ติดตั้ง\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"฿34.00 - ฿3,450.00 ต่อรายการ\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"เล่นฆ่าเวลา\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[