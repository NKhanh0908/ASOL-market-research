h.googleusercontent.com/jhrUBqHhCKQmJjbA8guicmli6z2rHQtMne27QxsnAYHH_zazldYS2FSwYDosgUHl4hmIG6rnbH1rshOhvv8PWw\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/kglHsg7TON4XyqpRkaJXb7nyTX9jS-hPcvGy7nr6kzuCBkKCWqYSt0CJmk--oBeLb5TXyIGEK0yqUdX3ycltpA\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/Ce2iD-WlbLqkoN_jTaIrj0w0cjYbVGo39MfTA-pLmOCYaIYEgIlA47UGBmiPUJfOFmq-RBeIea4FmPOrH3RYHA\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/Kg5Ij20ArA2ouoCVhE0qNUcrqvB07qbFexqYlKnFluyqjHDRPKWDOrqlvUFPPBsGrlzEJ7kXfxqr8F7AIZ5g\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/9F6dTKgpot7Wmnwz8K94GC0ySVmfwM1aHidYzWu8ZMWE0Cg3k-cMQ9zq8ioDAsT9MVAdLktY0IQJzQFKr9IqNX8\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/ZHC4R30Qsn_rfyWhQYLd5mQoynGTujnsh-ij76pOa2nqZe7kzW7iVi5Mgj2wwrcj44RIlaPKEF3Mzfs9SkdZ\"]]],\"Plants vs Zombies™ 2\",[\"4.0\",3.9727423],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.ea.game.pvz2_row\\u0026rdid\\u003dcom.ea.game.pvz2_row\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.ea.game.pvz2_row\"]],[\"qgJhGl8IMkoTCMHPrLDHkJcDFZdanQkdEZckpfoBDAoKCAASBgoCdGgQAboCNgoaChRjb20uZWEuZ2FtZS5wdnoyX3JvdxABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,\"0c_iMGs3ehY\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:0c_iMGs3ehY?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:0c_iMGs3ehY\",null,null,null,null,\"AXH1ezlS6LCjP8e4pzdnCjK8tYnqX1DyvNUQ_551qc3wDP2ecToQKJsCULzqpaYRHOS3ci8oXXVLbXvmsYJvZgvqq9Lbbgnnrmqgxf5Msrw2slG7IsbJP_24g09RBoRDz04ybKz84xCoR1Q1gmIH5itAWrqguuKyyUPYs3TftLwqT7Iwzzo3RVXZ-5Cbrp0cxLSGmK-QgpC2Aya3-UutwSo4djWecH06zTp4j8dXlCE3ANtmVdMfdVmtOtYUov6KheGSTi0btW5caAkgvwufRTxErKVeeK0kwt0MjnEDuO-MGjfmuA\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/0c_iMGs3ehY/hqdefault.jpg\"]]]],[null,\"This game includes optional in-game purchases of virtual currency that can be used to acquire virtual in-game items, including a random selection of virtual in-game items.\\u003cbr\\u003e\\u003cbr\\u003ePlay the hit action-strategy adventure where you meet, greet, and defeat legions of hilarious zombies from the dawn of time, to the end of days. Amass an army of amazing plants, supercharge them with Plant Food, and devise the ultimate plan to protect your brain.\\u003cbr\\u003e\\u003cbr\\u003eDISCOVER HUNDREDS OF PLANTS AND ZOMBIES\\u003cbr\\u003eCollect your favorite lawn legends, like Sunflower and Peashooter, along with hundreds of other horticultural hotshots, including creative bloomers like Lava Guava and Laser Bean. Go toe-to-missing-toe with a massive array of zombies at every turn, like Jetpack Zombie and Mermaid Imp – you’ll even have to protect your brain from rampant Zombie Chickens!\\u003cbr\\u003e\\u003cbr\\u003eGROW POWERFUL PLANTS\\u003cbr\\u003eEarn Seed Packets as you play and use them to fuel your potent plants. Power up attacks, double-down defenses, speed up planting time, and even gain entirely new abilities. Boost your plants to ensure those zombies are lawn-gone!\\u003cbr\\u003e\\u003cbr\\u003eCOMPETE AGAINST OTHERS IN ARENA \\u003cbr\\u003eThink your zombie-bashing strategy is the best? Put your planting skills to the test when you face other players in Arena. Enter Arena and compete against other players to get the highest score on unique levels. Earn coins, piñatas, and more to top the leaderboards, level up through Leagues, and become the ultimate garden guardian.\\u003cbr\\u003e\\u003cbr\\u003eJOURNEY THROUGH SPACE AND TIME\\u003cbr\\u003eBattle across 11 crazy worlds, from Ancient Egypt to the Far Future, and beyond. With more than 300 levels, ultra-challenging endless zones, fun mini-games, and daily Piñata Party events, there’s always a new challenge to complete. Plus, ready your best defenses – Dr. Zomboss is waiting to take you on at the end of every world!\\u003cbr\\u003e\\u003cbr\\u003eRequires acceptance of EA’s Privacy \\u0026amp; Cookie Policy and User Agreement.\\u003cbr\\u003eUser Agreement: https://tos.ea.com/legalapp/WEBTERMS/US/en/PC/\\u003cbr\\u003ePrivacy and Cookie Policy: https://tos.ea.com/legalapp/WEBPRIVACY/US/en/PC/\\u003cbr\\u003eVisit https://help.ea.com/en/ for assistance or inquiries.\"],\"ELECTRONIC ARTS\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/6e4K3WZm9uSjnUkkAK6ozTex-91BXZc6bkjf-1PDinqaPLSDCmvclhvmxa6y930O46SO_z3nJhQcdLiPQvVg\"],null,[243,241,241,255]],null,[\"ประเภท 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"การซื้อในเกม (รวมถึงรายการสุ่ม)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.ea.game.pvz2_row\\u0026rdid\\u003dcom.ea.game.pvz2_row\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"ติดตั้ง\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"฿15.00 - ฿2,500.00 ต่อรายการ\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"เล่นฆ่าเวลา\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"bus.sand.fall.jam.loop.traffic.flow\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/-TcLefDSecp5lo9jZbNF1LcnFVef7kv0pUNUGEBoX-Q22Ipc8wSWk8Z9cv-dHE4s7c4_hy8j4x8h1H_IFzO-kH0\"],null,[42,176,248,255],null,null,null,2],[[null,2,[2450,1080],[null,null,\"https://play-lh.googleusercontent.com/ySlhs5k7eGnLsQ7el-aNZbf813Q5JHAJnIGgclYfwE8xLuMjVrChpvvF34qKERQTSor1soxee80dwvhyTLeSeQ8\"]],[null,2,[2450,1080],[null,null,\"https://play-lh.googleusercontent.com/NGMrXO2-QgCuSw7yVM9zUWL0C2MYDOJsPnOZ4_7fHaZ5XqzpipxvoCyLfC8KM3_xLKyWk_ddxnWc7IxJLhixZQ\"]],[null,2,[2450,1080],[null,null,\"https://play-lh.googleusercontent.com/m9cYdb_iKFZQKb-5AWOEXXKwohrtcaEl7Z0nFC31bsyQdVBo2gGrbgNNb3uto_ftCp_qgIkyUrc1PChYwQ75DQ\"]],[null,2,[2450,1080],[null,null,\"https://play-lh.googleusercontent.com/iqtW_S36gKUb4kaavFnzHWEwAtpU-2pn8_xW9CGDfoGEngSRodgkf2Y2KSMZk09AeShJ7LeY9MPrD_kucjdO\"]],[null,2,[2450,1080],[null,null,\"https://play-lh.googleusercontent.com/pbzdMukfEOIJ9Dckm4uaTyzp4NGWqvtav0qlshcF-jMAS-O_XJMKwQzqHfvc4g4BTQlf001-i1RXPCe9DqOX\"]]],\"Jam Bus:Sandfall\",[\"4.9\",4.9041095],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dbus.sand.fall.jam.loop.traffic.flow\\u0026rdid\\u003dbus.sand.fall.jam.loop.traffic.flow\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dbus.sand.fall.jam.loop.traffic.flow\"]],[\"qgJwGm4IM0oTCMHPrLDHkJcDFZdanQkdEZckpfoBDAoKCAASBgoCdGgQAboCRQopCiNidXMuc2FuZC5mYWxsLmphbS5sb29wLnRyYWZmaWMuZmxvdxABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"Jam Bus: Sandfall brings a fresh twist to bus jam, color puzzle, and traffic escape gameplay.\\u003cbr\\u003eColorful sand is stacked in layers, and every bus has its own color and direction. Tap the right bus, collect the matching sand, and clear the board step by step. Sounds simple at first, but every move can change the whole puzzle.\\u003cbr\\u003ePlan carefully before you tap. Some buses may block each other. Some paths may cross. Some sand colors can only be cleared after the lower layers are gone. To win, you need to observe the board, choose the right order, and keep every bus moving without a crash.\\u003cbr\\u003eHow to play\\u003cbr\\u003e• Tap a bus to move it along its route\\u003cbr\\u003e • Match each bus with the same color sand\\u003cbr\\u003e • Clear lower sand layers to unlock the ones above\\u003cbr\\u003e • Avoid traffic crashes when paths cross\\u003cbr\\u003e • Solve each level with smart sequencing\\u003cbr\\u003eWhy you’ll enjoy Jam Bus: Sandfall\\u003cbr\\u003e• Easy tap controls\\u003cbr\\u003e • Relaxing color-matching gameplay\\u003cbr\\u003e • Clever bus parking jam puzzles\\u003cbr\\u003e • Satisfying sand-clearing effects\\u003cbr\\u003e • Increasingly tricky routes and layers\\u003cbr\\u003e • Clean visuals and smooth puzzle flow\\u003cbr\\u003e • Great for quick breaks and brain training\\u003cbr\\u003eEvery level is a small logic challenge. A bus may look ready to move, but its route might block another vehicle. A color may be visible, but the sand below it must be cleared first. Think ahead, follow the arrows, and find the perfect order to clear the whole sandfall.\\u003cbr\\u003eIf you enjoy bus games, parking jam puzzles, color sort games, traffic escape challenges, or relaxing logic games, Jam Bus: Sandfall gives you a colorful new puzzle to solve.\\u003cbr\\u003eStart with one bus, clear one color, and let the sand fall into place.\"],\"Nova Games Technology Limited\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/Xxtz7lOU2yqCxGMmNiyNb3e-OEhEoW_TeIylWnJOAaXHSDGGAQhJSs12d5B4L6TFUPOV3-3f00S0dPXRunndNQ\"],null,[117,111,117,255]],null,[\"ประเภท 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"การโต้ตอบกับผู้ใช้\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dbus.sand.fall.jam.loop.traffic.flow\\u0026rdid\\u003dbus.sand.fall.jam.loop.traffic.flow\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"ติดตั้ง\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"฿35.00 - ฿3,500.00 ต่อรายการ\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"เล่นฆ่าเวลา\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.jellybtn.cashkingmobile\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/FL2Ki9XtDxFDCZdlpC4z_VWRL3iHZMl44Og63j1581ulJV2KNxeO4rBkYHaYvCleMqUxWpF0u57Eqeg_ozix\"],null,[241,47,63,255],null,null,null,2],[[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/e9kxuPYE_3nv0S3bxLYYpPb3s_nb45eO-jtMvajMgndhR_vi6GMcSax8Qu425tHqzmRqiEGFJ7_hRyniN8XadQ\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/s9XVvbolAD6vmLFmoHbmFCwEHnDa6e4q5OOQKM8lzJ9x6mSsx334i3ejiBNqeKFI4jkkRYY5ADOVG4ZPCXMi\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/_zCnKvhJDadvnhMzQnzzGDTLINPZkVyqll4rYyOFzxWjMwDSGk2pPEZ9YORemg2Niftpqz9hGvScRKzJ6G08pQ\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/zDirnHUo4t2zxacD21hmwFmnFBGw21C2Fl_az7nNIZDTp_y6q1nhSXsiDLK3pCmjoAtLTs_iEpHfDAJPTjvh\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/TSZ0XLzhZchs-rZ3pEEQL9lv1GpO68rUk6m2h1Mti4LH5ZctV4kVWmOoYkUtyDjEnNUrcIarpms9a7TVtW1qyw\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/zGUP2Z8USZ0R47H3GScRJRXRlLsKWOvd37aewVnybiyKtvgQHLQI063gY7ee76WH4EPxsKu0iOunyNk8OwLT\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/iT7hpGEoOm8mrGFpq_og8Q62TgiY_lUUMnbAvXBuRnB8ZhHe5quJWHWgGt2bGGul0z9I54bYB7PeUbgUbS-1sw\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/e9kxuPYE_3nv0S3bxLYYpPb3s_nb45eO-jtMvajMgndhR_vi6GMcSax8Qu425tHqzmRqiEGFJ7_hRyniN8XadQ\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/s9XVvbolAD6vmLFmoHbmFCwEHnDa6e4q5OOQKM8lzJ9x6mSsx334i3ejiBNqeKFI4jkkRYY5ADOVG4ZPCXMi\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/_zCnKvhJDadvnhMzQnzzGDTLINPZkVyqll4rYyOFzxWjMwDSGk2pPEZ9YORemg2Niftpqz9hGvScRKzJ6G08pQ\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/zDirnHUo4t2zxacD21hmwFmnFBGw21C2Fl_az7nNIZDTp_y6q1nhSXsiDLK3pCmjoAtLTs_iEpHfDAJPTjvh\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/TSZ0XLzhZchs-rZ3pEEQL9lv1GpO68rUk6m2h1Mti4LH5ZctV4kVWmOoYkUtyDjEnNUrcIarpms9a7TVtW1qyw\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/zGUP2Z8USZ0R47H3GScRJRXRlLsKWOvd37aewVnybiyKtvgQHLQI063gY7ee76WH4EPxsKu0iOunyNk8OwLT\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/iT7hpGEoOm8mrGFpq_og8Q62TgiY_lUUMnbAvXBuRnB8ZhHe5quJWHWgGt2bGGul0z9I54bYB7PeUbgUbS-1sw\"]],[null,2,[2688,1242],[null,null,\"https://play-lh.googleusercontent.com/sRODy_uO36p0tN4aRP82qBqH1yB7QbOMqQqmav3-8pdlJG2uNDQm4SlQYJlZQjHV4eW2bzV1bWtPrde8lEGNAA\"]],[null,2,[2688,1242],[null,null,\"https://play-lh.googleusercontent.com/c6l9uTsLdUmd-ZaL5STyBJPu-djxbzEceC1wdAAxosAN0-LksCEFt6r8le231xuXKQGEmHDwUifIWMJeuIVSSw\"]],[null,2,[2688,1242],[null,null,\"https://play-lh.googleusercontent.com/Mls-K355BB5QOxn8g5-tgNVXAH_kOn1QshuZyuFuBCT_KxVhSpWkfBUjjuE_o4Md4iNUtCtK5Wg3zPCKzp7u8No\"]],[null,2,[2688,1242],[null,null,\"https://play-lh.googleusercontent.com/RMN1AmOOLej-B-VHzXj39rwg4jZTb0ikXBYmjAyoxU-ZorEbL2_XYQ8cXzN9ls7riMjmoTgXXug8tZXGT_Bn\"]],[null,2,[2688,1242],[null,null,\"https://play-lh.googleusercontent.com/rhBNrimYzpnVi8BHR9mO85ECfq-WTM7wrhCFQyzKfop2KxDzTU9TbypM-oDVKLSxDruCcGz0bF1aYEsQFNYviQ\"]],[null,2,[2688,1242],[null,null,\"https://play-lh.googleusercontent.com/sxsWv4uUEGtp1xONkN7dZ4s78czrxvNzVNj_pk9vHuYYJVKCnDdMrVujApk93WChmfaWaLmSpbIW-lXuPe4BjQ\"]],[null,2,[2688,1242],[null,null,\"https://play-lh.googleusercontent.com/dygVkyu8Oy5wiXAiWdl6R-zekyUsuNpa5IDJrvtgH1UHMP0NmOEcu8-aCYmspewBVKgoG0fYRHRJBfGCiAGq\"]]],\"Pirate Kings™️ - ไพเรท คิง\",[\"4.2\",4.2484183],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.jellybtn.cashkingmobile\\u0026rdid\\u003dcom.jellybtn.cashkingmobile\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.jellybtn.cashkingmobile\"]],[\"qgJoGmYINEoTCMHPrLDHkJcDFZdanQkdEZckpfoBDAoKCAASBgoCdGgQALoCPQohChtjb20uamVsbHlidG4uY2FzaGtpbmdtb2JpbGUQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],[[[null,null,\"paDGCKHF89s\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:paDGCKHF89s?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:paDGCKHF89s\",null,null,null,null,\"AXH1ezkCjl9k4irzH0p4USogHomAPzG8zSgiN33XkMoyUVU_TIlG9X4mP8tN2MoUd7zM158-RBHoU7HD7_UANGbwgu8puUPxoT5w_kVpGG0k1fIb0OVbjjwGrXlNcJSKknXjmSrmlB8BIkia-tFPJK2nh-BxU9AybRdGQOMEmZkLWUqgwNtRQKAYwJqVKY_zvz9PpVyA7Qhbc8nDw9WngS7XVzOTr8wzCZpuswRC0MZbmKFjFdP0OoUJcqkN0BcUGdonDBaLiSoiJuaXPweSMnsvKiBGOkJXfp6bFcuT9-RyupQ7jw\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/paDGCKHF89s/hqdefault.jpg\"]]]],[null,\"🏴\\u200d☠️\\u003cb\\u003eโจมตี ขโมย และป้องกัน! – นี่คือการผจญภัยของราชันโจรสลัดและผองเพื่อน!\\u003c/b\\u003e 🏴\\u200d☠️\\u003cbr\\u003e\\u003cbr\\u003e☠️สวัสดีเพื่อนยาก! ออกเดินเรือในเกมโจรสลัดสุดมันส์ไปกับผองเพื่อน!\\u003cbr\\u003e☠️รวบรวมเหรียญและของรางวัลมากมายเพื่อสร้างเกาะของคุณ  ฝังขุมทรัพย์เท่ากองภูเขาก่อนโจรสลัดตัวอื่น!\\u003cbr\\u003e☠️ปล้นทรัพย์สินของเพื่อนคุณในเกมผจญภัยบนเกาะเกมนี้! \\u003cbr\\u003e☠️กลายเป็นกัปตันเรืองอำนาจและปล้นโบนัสและรางวัลจากโจรสลัดตัวอื่น!\\u003cbr\\u003e☠️โย-โฮ! จะกลายเป็นราชันโจรสลัดที่ร่ำรวยที่สุดหรือไม่?\\u003cbr\\u003e\\u003cbr\\u003e⚔️ \\u003cb\\u003e ต่อสู้กับเพื่อน ๆ เพื่อแย่งชิงทองคำและความยิ่งใหญ่เพื่อกลายเป็นราชันโจรสลัด! \\u003c/b\\u003e⚔️\\u003cbr\\u003e🔥 โย-โฮ! เชิญเพื่อน ๆ บนเฟซบุ๊กมาร่วมสนุกไปด้วยกัน! \\u003cbr\\u003e🔥 หมุนวงล้อเสี่ยงโชคและปล้นสิ่งของของโจรสลัด! \\u003cbr\\u003e🔥โจมตีเกาะของเพื่อนโจรสลัดคุณ! ปล้นของดี ๆ (และ) เหรียญของพวกเขา! – มันคือวิถีของโจรสลัดอยู่แล้ว! \\u003cbr\\u003e🔥 ป้องกันเกาะของคุณจากการตอบโต้ของโจรสลัดตัวอื่น! กลายเป็นราชันโจรสลัดให้ได้!\\u003cbr\\u003e🔥 ให้เหรียญของขวัญและขุมทรัพย์กับเพื่อนโจรสลัดของคุณ – โจรสลัดก็นิสัยดีเป็นนะ \\u003cbr\\u003e🔥อะไรก็เกิดขึ้นได้ในเกมโจรสลัดสร้างเกาะประเภทเล่นได้หลายคน! \\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003e มีโบนัสและของให้ปล้นมากมายในเกมผจญภัยบนเกาะครั้งยิ่งใหญ่! \\u003c/b\\u003e\\u003cbr\\u003e💰หมุนวงล้อเสี่ยงโชคทุกชั่วโมงเพื่อรับโบนัส  \\u003ci\\u003e ประจำวัน \\u003c/i\\u003e! รับเหรียญและอัปเกรดเกาะของคุณ\\u003cbr\\u003e💰ลุ้นรับโอกาสโจมตีและอีกมากมายในเกมโจรสลัดฟาดฟันเกมนี้!\\u003cbr\\u003e💰 ปล้นสะดมเกาะของเพื่อนคุณ: ในเกมหมุนวงล้อ คุณมีสิทธิ์ลุ้นรับเหรียญมากถึง 1 แสนเหรียญในการหมุนแต่ละครั้ง! ใช้เหรียญของคุณเพื่อป้องกันเกาะ อัปเกรดเรือโจรสลัด และหานกแก้วโจรสลัดเพิ่ม! อ๊าก!\\u003cbr\\u003e💰 อัปเกรดเกาะทั้งเกาะของคุณให้ใหญ่ขึ้นและเจ๋งกว่าเดิม และป้องกันกันเกาะของคุณ (จากการตอบโต้ของเพื่อน ๆ) \\u003cbr\\u003e💰ปฏิบัติภารกิจโจรสลัดให้สำเร็จ! โจมตีเกาะของเพื่อนคุณให้เสียหาย ปล้นของของพวกเขา แล้วอัปเกรดไอเทมของคุณเพื่อรับของที่อลังการณ์ยิ่งขึ้น! \\u003cbr\\u003e💰ลุ้นรับรางวัลใหญ่ไปกับอัลบัมเรื่องราวโจรสลัดบนเกาะ! แต่ะละอัลบัมใหม่จะเล่าเรื่องเกมการผจญภัยบนเกาะโจรสลัดที่ให้คุณสะสมการ์ดเมื่อสำเร็จภารกิจเพื่อรับรางวัลสร้างเกมเพิ่มเติม! \\u003cbr\\u003e\\u003cbr\\u003eชอบเกมโจรสลัดไหม? ชอบเกมโจรสลัดที่ให้คุณเล่น \\u003ci\\u003eกับเพื่อน ๆ ไหม\\u003c/i\\u003e? เล่น Pirate Kings เลย! \\u003cbr\\u003e\\u003cbr\\u003e🤼\\u003cb\\u003eกลายเป็นกัปตันโจรสลัดที่ยิ่งใหญ่ที่สุดในหมู่ผองเพื่อน!\\u003c/b\\u003e 🤼\\u003cbr\\u003e🤼เกมจะสนุกยิ่งกว่าเดิมหากคุณเล่นกับเพื่อน และปล้นของ ๆ พวกเขา! \\u003cbr\\u003e🤼นี่คือเกม Pirate Kings – เกมประเภทเล่นได้หลายคนที่ให้คุณโจมตีเกาะของเพื่อนคุณ!\\u003cbr\\u003e🤼หมุนวงล้อเพื่อเล่นเกมกับเพื่อนและ...\\u003cbr\\u003e🤼โจมตีศัตรูของคุณ (หรือเพื่อนราชันโจรสลัดของคุณ!) - ยิงปืนใหญ่และปล้นให้หนำใจ! \\u003cbr\\u003e🤼ปล้นเหรียญจากราชันเงินสด! หาที่หลบซ่อนของราชันเงินสดและปล้นเงินล่ารางวัลของเขา! \\u003cbr\\u003e🤼ปล้นเหรียญจากผู้เล่นคนอื่นก็ได้! ปล้นให้จนหนำใจ! เพลิดเพลินไปกับเกมสร้างเกาะอย่างที่ไม่เคยเล่นมาก่อนใน Pirate Kings เกมเก็บเหรียญที่เท่ที่สุดในมหาสมุทร!\\u003cbr\\u003e🤼สวมวิญญาณนักผจญภัย - ปล้น ขโมย และโจมตี! ไม่มีเกมเก็บเหรียญและเกมผจญภัยผู้เล่นหลายคนเกมไหนจะสนุกเท่าเกมนี้อีกแล้ว!\\u003cbr\\u003e\\u003cbr\\u003eBrought to you by Jelly Button, a Playtika studio.\\u003cbr\\u003e\\u003cbr\\u003ePirate Kings มีเจตนาไว้ให้บุคคลที่มีอายุตั้งแต่ 18 ขึ้นไป Pirate Kings  ไม่ต้องเสียค่าใช้จ่ายเพื่อดาวน์โหลดและเล่นเกม แต่ก็อนุญาตให้คุณซื้อไอเท็มเสมือนจริงได้โดยใช้เงินจริงภายในเกม คุณสามารถปิดฟังก์ชันการซื้อภายในแอปในส่วนตั้งค่าของอุปกรณ์คุณ Pirate Kings อาจจะมีโฆษณา คุณอาจจะต้องเชื่อมต่ออินเทอร์เน็ต จึงจะสามารถเล่น Pirate Kings และเข้าถึงฟีเจอร์บนโซเชียลมีเดียของเกมได้ นอกจากนี้ คุณยังสามารถอ่านข้อมูลเกี่ยวกับประโยชน์ ความเข้ากันได้และความสามารถในการทำงานร่วมกันของ Pirate Kings ได้ในคำอธิบายข้างต้นและข้อมูลเพิ่มเติมเกี่ยวกับ App Store \\u003cbr\\u003eคุณไม่ต้องจ่ายเงิน เพื่อดาวน์โหลดและเล่น Pirate Kings เลย แถมคุณยังสามารถใช้เงินจริงเพื่อซื้อไอเท็มเสมือนในเกม รวมถึงไอเท็มแบบสุ่มต่างๆ ได้ด้วย\\u003cbr\\u003e\\u003cbr\\u003eหากคุณดาวน์โหลดเกมนี้ คุณก็ตกลงที่จะรับการอัปเดตเกมในอนาคต ตามที่ปล่อยผ่านทาง App Store หรือเครือข่ายโซเชียลมีเดีย คุณสามารถเลือกที่จะอัปเดตเกมนี้ได้ แต่หากคุณไม่อัปเดต ประสบการณ์และประโยชน์ต่างๆ จากการเล่นเกมก็อาจจะลดลง\\u003cbr\\u003e\\u003cbr\\u003eข้อกำหนดด้านการให้บริการ: https://www.playtika.com/terms-service/\\u003cbr\\u003eประกาศความเป็นส่วนตัว https://www.playtika.com/privacy-notice/\"],\"Playtika\",\"50,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/qH5vDKp5xpY8zsvk_WovZJ2lLekGa4d7VYNgupy1LamCBQo_GWTht2RbRCY-fjgg7gDzqY1UZGmRbHicrfodew\"],null,[222,249,206,255]],null,[\"ประเภท 18+\",[null,2,[366,512],[null,null,\"https://play-lh.googleusercontent.com/QNpsl4k43vdbfwUAlVLZul2W5O5MUGOToystzghc97mljVHbUwtc639tahcuDsAVHdaGMyZA40AmMVcB_ws\"]],[null,\"ภาพการพนันอย่างชัดแจ้ง\"],[null,\"การซื้อในเกม (รวมถึงรายการสุ่ม)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/stIOCymv1bYIi3UU_owFeyNt30CkUXbNlDj81ZWtjW9NBIMJxI47i_psYIr0Ho430Rm6mByCGNLORloB\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.jellybtn.cashkingmobile\\u0026rdid\\u003dcom.jellybtn.cashkingmobile\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[