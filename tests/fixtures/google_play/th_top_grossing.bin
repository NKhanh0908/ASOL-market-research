rcontent.com/mk0RNvLRC3FURsmAj7vr9WtIGDeWRT6YjUVUw79zXTZHjSRe884pJcX_L6MtFpLKay2oI3Tjv01_6LtGixPV\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/DD09DdRkDVcMiVbrr6Udcoh0WrmdlqRelkS3L7uHp0K3jFby-76kjPAai3le5crmAnGWdi57fGj3bhjPmvlA\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/ZC97nx5PoZRRceZixchLTQIx4kSl8QeJPO2dttBgSNTTh74G1Uz6lUF_z-AM7IRWyOqNoZo7HBDkwdN8m3_S\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/iRVmObV08R1PSy5zrSjiR0DAFfEVjaluz_KoHqi3qxyTY8VgfNy8MIKzRe48oKYq_bjKb2q57vKsh-bFqfPklw\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/UGV8T1B9W2jFclDayWaGTBWyBWLN7Iskpdk_3yCewFyqyQbC-1W-GcrTag8Rgw7827dr01AjhRhgpKXO3OrkYw\"]]],\"Merge Hotel Empire－เกมออกแบบ\",[\"4.7\",4.668693],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dpuzzle.merge.hotel.empire\\u0026rdid\\u003dpuzzle.merge.hotel.empire\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dpuzzle.merge.hotel.empire\"]],[\"qgJmGmQINkoTCMHPrLDHkJcDFZdanQkdEZckpfoBDAoKCAASBgoCdGgQALoCOwofChlwdXp6bGUubWVyZ2UuaG90ZWwuZW1waXJlEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],[[[null,null,\"7GcAGVzgBRc\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:7GcAGVzgBRc?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:7GcAGVzgBRc\",null,null,null,null,\"AXH1ezmu2Puhqh8xeZN956ivXvQcK9NRuBK4yOloKiJGsrX8VYVD_aryOO5VzPEdum4aVzinCk9-TuSmiPDtEk68y8lPjqKF--tqf9q_Q6JCCTvtEhP09T_78AWv3pzhYQMetl4WX_K_Z7PW1u7_RIV79IwL08ivcVaayTXCwZNTPtdBfXgGyFxB5-zjYjwYKiJ1OMynXZLFbLacls5Z1g4a_9BmBUtfcXx-qQfzmJCaRPGRJz74OmDzQspJ_6qmlCFKNJ0JX5_JmZCRK6zPU9rgfLFG1scAHenkD9ZooJU8onshXg\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/7GcAGVzgBRc/hqdefault.jpg\"]]]],[null,\"ยินดีต้อนรับสู่โลกของการออกแบบ ตกแต่ง และผสานสิ่งของ! ในเกม Merge 2 คุณจะได้ช่วยเอลซ่าสานฝันด้วยการออกแบบรีสอร์ตระดับโลก หากคุณรักการตกแต่งและสนุกกับ Merge 2 เกมนี้คือคำตอบ ดำดิ่งสู่สุดยอดประสบการณ์ออกแบบ และโชว์ฝีมือตกแต่งคฤหาสน์\\u003cbr\\u003e\\u003cbr\\u003eเอลซ่าซื้อบ้านในฝัน สภาพมันย่ำแย่มากและต้องการปรับปรุงครั้งใหญ่ เธอต้องการคู่หูที่รักการออกแบบมาช่วยกอบกู้สถานการณ์ ท่ามกลางคู่แข่งที่พยายามปิดกิจการ และ \\u0026quot;\\u0026quot;คำสาป\\u0026quot;\\u0026quot; ลึกลับ เอลซ่ามีงานหนักรออยู่\\u003cbr\\u003e\\u003cbr\\u003eฟีเจอร์เกมน่าตื่นเต้น:\\u003cbr\\u003e\\u003cbr\\u003eMerge 2 รูปแบบการเล่นไม่เหมือนใคร: จับคู่ผสมไอเท็ม สร้างเครื่องมือทรงพลังเพื่อพัฒนาการปรับปรุงบ้าน\\u003cbr\\u003e\\u003cbr\\u003eงานออกแบบและตกแต่งสุดสร้างสรรค์: ควบคุมการออกแบบภายในอย่างเต็มที่ เปลี่ยนคฤหาสน์ฝุ่นเขรอะสู่โรงแรมหรู\\u003cbr\\u003e\\u003cbr\\u003eเนื้อเรื่องที่เข้มข้น: ไขปริศนา \\u0026quot;\\u0026quot;คำสาปแห่งเจ้าของโรงแรม\\u0026quot;\\u0026quot; และชิงไหวชิงพริบกับคู่แข่ง\\u003cbr\\u003e\\u003cbr\\u003eการแปลงโฉมห้อง: ปลดล็อกและตกแต่งห้องหลากหลาย ตั้งแต่ห้องนอนถึงล็อบบี้สุดอลังการ\\u003cbr\\u003e\\u003cbr\\u003eพัซเซิลแสนผ่อนคลาย: สนุกกับประสบการณ์ผ่อนคลาย ผสานสิ่งของ และเฝ้าดูโรงแรมค่อยๆ เปลี่ยนแปลง\\u003cbr\\u003e\\u003cbr\\u003eเอลซ่าคิดว่า \\u0026quot;\\u0026quot;บ้านของฉันต้องการช่วยเหลือ!\\u0026quot;\\u0026quot; ร่วมมือกับเธอจับคู่ผสมสิ่งของสร้างเครื่องมือมีค่า Merge 2 ให้คุณผ่อนคลาย ดำดิ่งสู่โลกบริการ หากรักความท้าทายออกแบบตกแต่งบ้าน คุณจะหลงรักเรื่องราวที่รอคุณอยู่ที่นี่ พลิกผันเรื่องราว ชิงไหวชิงพริบกับคู่แข่ง ตกแต่งห้อง ผลงานออกแบบคุณมีความหมาย!\\u003cbr\\u003e\\u003cbr\\u003eข้อกำหนดในการให้บริการ: https://static.moonactive.net/legal/terms.html?lang\\u003dth\\u003cbr\\u003e\\u003cbr\\u003eประกาศความเป็นส่วนตัว: https://static.moonactive.net/legal/privacy.html?lang\\u003dth\\u003cbr\\u003e\\u003cbr\\u003eมีคำถาม? ฝ่ายสนับสนุนพร้อมให้บริการที่: https://support.mergehotelempiregames.com/hc/en-us\"],\"Moon Active\",\"10,000,000+\",null,\"\",null,null,null,null,[nu