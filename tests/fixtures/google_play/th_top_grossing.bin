ontent.com/wmCZYjyaEzT3VEXupJuUSqGbnfBFTRsUzvzPC-dhurgFFuB7SW09dxRQZMyoAl2ByylRldGJ_W4xkqsv0ZBgIhQ\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/AqygzrKcKppMoE8sD8um4LzjotGrMhG9vBsaDhCq809KVHjYix9usA48t_I57aktE8d9CNDrHBjw9P_zqgce3Bo\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/Yb_JX_KSuHOqCLs62ZrNh5jVrtGxOrUQDqwSXF-3cMJ8J_vsggyaj4Fs2gqDRlpOQggX6wAoqAGpQZIQag9L4w\"]]],\"Hay Day\",[\"4.7\",4.656098],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.supercell.hayday\\u0026rdid\\u003dcom.supercell.hayday\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.supercell.hayday\"]],[\"qgJhGl8IAkoTCMHPrLDHkJcDFZdanQkdEZckpfoBDAoKCAASBgoCdGgQALoCNgoaChRjb20uc3VwZXJjZWxsLmhheWRheRABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,\"DsUe5JRcdfI\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:DsUe5JRcdfI?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:DsUe5JRcdfI\",null,null,null,null,\"AXH1ezneB75-sdPz-MsH9WGIq7-MHOf9hZ7efw5IE7tKWBQOOEKA9OnYlQU2afoXU4AGoIIP8fqcjHkmKW04YKypEfI_xdb8tWOMHfs9mSgVvkqs1lyNGL5d61pc79j_RZYLeKu7PXXT1-48Vk_XembSDLX-8sSCZIZ1xwk-T_24WGl59ifzAhqehuQlTgED55mytzWUasFRbs6cMDE7HvjbtXScXtHY0mr1ypZuUNWBjYYkpARdDIR0LmpEwtHHNVDIGZaPNJ8jJj6k0lQlERzLUSgr53_y8fOe-tmaz5AuvnrSXg\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/DsUe5JRcdfI/hqdefault.jpg\"]]]],[null,\"\\u003cb\\u003eยินดีต้อนรับสู่ Hay Day สร้างฟาร์ม ตกปลา เลี้ยงสัตว์ และสำรวจหุบเขา มาทำฟาร์ม ออกแบบ และปรับแต่งสวรรค์บ้านไร่ในแบบของคุณเอง\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003eการทำฟาร์มไม่เคยง่ายหรือสนุกแบบนี้มาก่อน! พืชผลอย่างข้าวสาลีและข้าวโพดพร้อมจะเติบใหญ่ และถึงแม้ที่นี่จะไม่มีฝน พืชผลเหล่านี้ก็ไม่เคยแห้งเหี่ยวตาย ปลูกพืชผลและหว่านเมล็ดอีกครั้งเพื่อเพิ่มปริมาณ จากนั้นก็ทำผลิตภัณฑ์ขาย ต้อนรับสัตว์ต่างๆ ทั้งไก่ หมู และวัวในฟาร์มเมื่อคุณขยายบ้านไร่ให้เติบใหญ่! ให้อาหารสัตว์เลี้ยงเพื่อผลิตไข่ เบคอน ผลิตภัณฑ์จากนม และอีกมากมายเพื่อแลกเปลี่ยนกับเพื่อนบ้าน หรือทำตามสั่งซื้อทางรถกระบะส่งของเพื่อรับเหรียญ\\u003cbr\\u003e\\u003cbr\\u003eสร้างฟาร์มและขยายให้เต็มความสามารถ จากบ้านไร่ในเมืองเล็กๆ สู่การทำธุรกิจเต็มตัว สิ่งก่อสร้างการผลิตอย่างเตาอบ เตาบาร์บีคิว หรือเครื่องคั้นอ้อยจะช่วยขยายธุรกิจของคุณให้ขายผลิตภัณฑ์ได้มากขึ้นกว่าเดิม สร้างจักรเย็บผ้าและหูกทอผ้าเพื่อเย็บเสื้อผ้าน่ารักๆ หรือสร้างเตาอบเค้กเพื่ออบเค้กอร่อยๆ โอกาสในการสร้างสรรค์ไม่มีสิ้นสุดที่ฟาร์มในฝันของคุณ!\\u003cbr\\u003e\\u003cbr\\u003eปรับแต่งฟาร์มของคุณและตกแต่งด้วยไอเทมที่มีหลากหลาย พัฒนาบ้านไร่ โรงนา รถกระบะ และร้านริมทางด้วยระบบการปรับแต่ง สร้างฟาร์มเพื่อโชว์สไตล์ของคุณและสร้างแรงบันดาลใจให้กับเพื่อนๆ!\\u003cbr\\u003e\\u003cbr\\u003eแลกเปลี่ยนและขายผลิตภัณฑ์ในเกมทำฟาร์มนี้ผ่านทางรถกระบะหรือเรือ แลกเปลี่ยนพืชผล ผลิตภัณฑ์สดใหม่ และทรัพยากรกับตัวละครในเกม อัพเลเวลเพื่อปลดล็อคร้านริมทางที่คุณจะสามารถขายผลิตภัณฑ์และพืชผลได้มากขึ้น\\u003cbr\\u003e\\u003cbr\\u003eขยายประสบการณ์การทำฟาร์มของคุณและเล่นกับเพื่อนในหุบเขา เข้าร่วมหรือสร้างละแวกบ้านของคุณเอง และเล่นกับผู้เล่นคนอื่นได้มากถึง 30 คน แลกเปลี่ยนเคล็ดลับและช่วยกันสร้างฟาร์มที่ยอดเยี่ยม!\\u003cbr\\u003e\\u003cbr\\u003eHay Day เป็นเกมที่ดาวน์โหลดและเล่นได้ฟรี แต่ไอเทมในเกมบางอย่างสามารถซื้อได้ด้วยเงินจริง (รวมไปถึงไอเทมแบบสุ่ม) หากคุณไม่ต้องการซื้อไอเทมในเกมด้วยเงินจริง กรุณาปิดการซื้อในแอปที่อยู่ในการตั้งค่าของอุปกรณ์ของคุณ และต้องมีการเชื่อมต่อกับเครือข่ายอินเทอร์เน็ต\\u003cbr\\u003e\\u003cbr\\u003eดาวน์โหลดวันนี้และสร้าง “ฟาร์ม” ที่ดีที่สุด!\\u003cbr\\u003e\\u003cbr\\u003eฟีเจอร์ของ Hay Day:\\u003cbr\\u003e\\u003cbr\\u003eสร้างฟาร์ม:\\u003cbr\\u003e- การทำฟาร์มสุดง่ายดาย สร้างแปลง ปลูกพืชผล เก็บเกี่ยว แล้วก็ทำซ้ำ!\\u003cbr\\u003e- ปรับแต่งบ้านไร่ให้กลายเป็นสวรรค์ในแบบของคุณเอง\\u003cbr\\u003e- พัฒนาฟาร์มของคุณด้วยสิ่งก่อสร้างการผลิต เช่น เตาอบ เครื่องบดอาหารสัตว์ และเครื่องคั้นอ้อย\\u003cbr\\u003e\\u003cbr\\u003eพืชผลสำหรับการปลูกและเก็บเกี่ยว:\\u003cbr\\u003e- พืชผลอย่างข้าวสาลีและข้าวโพดไม่เคยแห้งเหี่ยวตาย\\u003cbr\\u003e- เก็บเกี่ยวเมล็ดพันธุ์และปลูกซ้ำใหม่ หรือนำพืชผลอย่างข้าวสาลีไปทำเป็นขนมปัง \\u003cbr\\u003e\\u003cbr\\u003eสัตว์:\\u003cbr\\u003e- ไก่ ม้า วัว และอีกมากมายที่รอเข้าไปอยู่ในฟาร์มของคุณ\\u003cbr\\u003e- สัตว์เลี้ยงอย่างลูกสุนัข ลูกแมว และกระต่ายก็สามารถอยู่ในฟาร์มของคุณ \\u003cbr\\u003e\\u003cbr\\u003eสถานที่ให้แวะไปเยี่ยมเยือน:\\u003cbr\\u003e- ทะเลสาบหาปลา: ซ่อมท่าเรือและเหวี่ยงเบ็ดจับปลาในสายน้ำ\\u003cbr\\u003e- เมือง: ซ่อมสถานีรถไฟและไปที่เมืองเพื่อทำตามคำสั่งซื้อของผู้มาเยือนเมือง\\u003cbr\\u003e- หุบเขา: เล่นกับเพื่อนๆ ในฤดูกาลและอีเวนท์ที่แตกต่างกันไป\\u003cbr\\u003e\\u003cbr\\u003eเล่นกับเพื่อนและเพื่อนบ้าน:\\u003cbr\\u003e- สร้างละแวกบ้านของคุณและต้อนรับผู้มาเยือน!\\u003cbr\\u003e- แลกเปลี่ยนพืชผลและผลิตภัณฑ์สดใหม่กับเพื่อนบ้านในเกม\\u003cbr\\u003e- ทำอีเวนท์การแข่งม้าประจำสัปดาห์กับเพื่อนบ้านให้เสร็จและรับรางวัล!\\u003cbr\\u003e\\u003cbr\\u003eเพื่อนบ้าน คุณมีปัญหาหรือเปล่า? \\u003cbr\\u003eไปที่ https://supercell.helpshift.com/a/hay-day/?l\\u003den หรือติดต่อเราในเกมได้โดยการไปที่ การตั้งค่า \\u0026gt; ความช่วยเหลือและการสนับสนุน \\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003eนโยบายความเป็นส่วนตัว:\\u003cbr\\u003ehttp://www.supercell.net/privacy-policy/ \\u003cbr\\u003e\\u003cbr\\u003eเงื่อนไขการให้บริการ: \\u003cbr\\u003ehttp://www.supercell.net/terms-of-service/ \\u003cbr\\u003e\\u003cbr\\u003eคำแนะนำผู้ปกครอง: \\u003cbr\\u003ehttp://www.supercell.net/parents/\"],\"Supercell\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/fTLqW6lHE8JVOr9MSldgEbYqEx0zw3fK-PcsU7vSlXil3gpVevVVMPdeb7-Ag8wmCrw0kIRQNZ3CmVP0XsxM\"],null,[234,238,240,255]],null,[\"ประเภท 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"ก