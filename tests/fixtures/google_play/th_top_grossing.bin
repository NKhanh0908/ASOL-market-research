ชน, แตร, และอื่นๆ อีกมากมาย!\\u003cbr\\u003e\\u003cbr\\u003eรวมเหล่ารถบรรทุกในฝัน ที่คุณใฝ่หามาเสมอ\\u003cbr\\u003e\\u003cbr\\u003eและเตรียมพบกับการอัปเดตเป็นประจำ ที่จะมาพร้อมกับฟีเจอร์ใหม่ๆ ในอนาคต!\"],\"Century Games PTE. LTD.\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/w6WBCpODsoe7CsLdORRb6tW0VAQ2PwFbh58iZ9PfazCPT-o6f_wujI7S_Id7ferjzTMjfDtkYUFKfaIxW0CuYQ\"],null,[95,157,220,255]],null,[\"ประเภท 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"การซื้อในเกม\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.vm3.global\\u0026rdid\\u003dcom.vm3.global\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"ติดตั้ง\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"฿35.00 - ฿4,325.00 ต่อรายการ\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"เล่นฆ่าเวลา\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.aladinfun.islandking.android\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/wThq5uiR7tfW-WU38cy92FCUd15GFLi8-37di01YnCahbL0ivKzyZcDt_1p3kERsvoQGovOnuZAD7Fs6IuC_GQ\"],null,[236,199,73