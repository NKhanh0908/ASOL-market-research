ay-lh.googleusercontent.com/1aqCsrdGH-HZqQqkFgrW0PxlRxo_J4prG3vCRx3E6SFFAeuGmQiPUdFR-2FRXN-Bquob274bzYDDqI-A0enqJw\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/nBrnD_fNq-x5EqFS-4Q3_Mp_Ie3FYi4zFtZmBPWjrrnxONRigQ4J7wN07_ynsjW9Wkt1rFraxgy-UqfjTTWOQU0\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/wHQERiWQWIzbI6axj7fGPzVkM1v_qZhVC8jMuNqpD7_69yt50omFCMq6PKKxtZeVefGi1oxmYoWA6iu1h_Bhk-4\"]]],\"DDTank Origin\",[\"4.6\",4.601695],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dvng.game.boomz.origin.th\\u0026rdid\\u003dvng.game.boomz.origin.th\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dvng.game.boomz.origin.th\"]],[\"qgJlGmMIQUoTCMHPrLDHkJcDFZdanQkdEZckpfoBDAoKCAASBgoCdGgQALoCOgoeChh2bmcuZ2FtZS5ib29tei5vcmlnaW4udGgQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],[[[null,null,\"-ru5QDwQCNM\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:-ru5QDwQCNM?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:-ru5QDwQCNM\",null,null,null,null,\"AXH1eznoWpWb5NE9DjkCPiUFCOpeRZHUIlr4hgJlznxl45IxcLNZz4u9a835t_3Br03pwBLnlS4yFC2JRiidquzXmCUyWRRCTtQhnblCGJbMTWft0PKZeuQaEH1aWBUwz4fv4xiOr48wZLaCJE1c0UoTujdISVajWj_mj5gkThEPOCyAqNcJbnx2QAFf7I04WgnWuJWKEmazLhQAR9pO98xlwKEDqqYvNNt1t0LQRJ4Ld3UTQyd3Qgf5jmrNbsW5HS4zfu8gkGH5vyeRUXe67oTAUMjM1_wSIITJ3ENND43qooCHdw\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/-ru5QDwQCNM/hqdefault.jpg\"]]]],[null,\"พลิกโฉมใหม่ !! DDTank Origin - วิวัฒนาการความมันส์ขั้นกว่า ชื่อใหม่ แต่หัวใจ Shooting เดียวกัน พร้อมกับอัปเดตใหม่ กราฟฟิกทันสมัยมากยิ่งขึ้น ยกระดับความมันส์ แต่ความคลาสสิกยังอยู่\\u003cbr\\u003eเกมยิงคำนวณวิถีโค้งสุดคลาสสิก ลิขสิทธิ์แท้พัฒนาโดย 7Road ผู้พัฒนาตั้งแต่เวอร์ชั่นดั้งเดิม\\u003cbr\\u003eDDTank เกมดังยุค 2000 ที่ใครๆก็รู้จักด้วยรูปแบบการเล่นที่ง่าย ระบบยิงที่คลาสสิก เพียง คิด วิเคราะห์ แล้วยิง \\u003cbr\\u003eDDTank Origin เป็นเกมที่มีความท้าทายหลากหลาย ความมันส์หลายรูปแบบ หรือถ้าคุณอยากจะเล่นแบบขั้นเทพก็จะต้องคำนวณทิศทางลมและแรงลม องศาของวิถีกระสุน หรือ จะเป็นการวิเคราะห์การใช้ไอเทมสกิลต่างๆ เพื่อที่จะยิงให้แม่นแล้วเอาชนะคู่ต่อสู้ให้ราบคาบ\\u003cbr\\u003e\\u003cbr\\u003e[ อัปเกรดเกมและกราฟฟิกใหม่ ]\\u003cbr\\u003eอัปเกรดกราฟฟิกใหม่ให้ทันสมัยมากยิ่งขึ้น ยกระดับความสนุก เพิ่มความมันส์มากยื่งขึ้น สร้างประสบการณ์ในการเล่นใหม่ ถูกใจชาว Shooter อย่างแน่นอน\\u003cbr\\u003e\\u003cbr\\u003e[ โหมดใหม่ กิลด์วอร์ข้ามเซิร์ฟเวอร์ ]\\u003cbr\\u003eการเริ่มต้นของสงครามมันส์ ความสนุกขั้นกว่า ต่อสู้โชว์ฝีมือความแม่นให้ทั้งเกมเห็นว่ากิลด์เรานั้นเก๋าขนาดไหน เรียกเหล่า Shooter ในกิลด์ของคุณ เข้าร่วมต่อสู้กิลด์วอร์ข้ามเซิร์ฟเวอร์ เพื่อชิงชัยเป็นกิลด์อันดับหนึ่งของ DDTank Origin\\u003cbr\\u003e\\u003cbr\\u003e[ World Boss ระบบ PVE ใหม่ ]\\u003cbr\\u003eระบบ PVE ใหม่บอสโลก เข้าร่วมต่อสู้บอสทุกวัน โชว์ดาเมจตึงๆ ล่าบอสโลก ช่วงชิงของรางวัลหายาก อัปเกรดพลังให้แข็งแกร่ง ของรางวัลดรอปจากบอสมากมาย\\u003cbr\\u003e\\u003cbr\\u003e[ เกมยิงคำนวณวิถีโค้งสุดคลาสสิก ]\\u003cbr\\u003eDDTank Origin พัฒนามาจากเกมยิงสุดคลาสสิกที่ได้ปรับปรุงและพัฒนาจากทีมผู้พัฒนาเดิมอย่าง 7Road โดยเกมยังคงความเล่นง่าย คงความมันส์ ยิงเพลิน ขุดกระจาย ไว้ครบถ้วน\\u003cbr\\u003e\\u003cbr\\u003e[ โชว์กลยุทธ์เทคนิคเฉพาะตัว ]\\u003cbr\\u003eโชว์ความเก๋า งัดเทคนิคกลยุทธ์การต่อสู้ในแบบของคุณมาถล่มคู่ต่อสู้ให้ราบคาบ ไม่ว่าจะเป็นการแช่แข็งคู่ต่อสู้ หายตัว หรือ เรามันแกร่ง ไม่ใช่สกิลแต่กดไอเทมยิง x2 x3 ยิงถล่มให้ราบคาบไปเลย\\u003cbr\\u003e\\u003cbr\\u003e[ คลาสสิกสกิลเพลย์ ]\\u003cbr\\u003eDDTank Origin ยังคงรูปแบบการเล่นแบบเดิมไว้ ไม่ว่าจะเป็น การคำนวณลม ทิศทางของลม แรงลม, ความแรงในการยิง หรือจะเป็นองศาการยิงที่ผู้เล่นจะต้องคิด วิเคราะห์ ก่อนยิง \\u003cbr\\u003e\\u003cbr\\u003e[ สนุกสนานไปกับชาวแก๊ง ศูนย์รวมคอมมูนิตี้ที่มีสีสัน ]\\u003cbr\\u003eแท็กทีมกับเพื่อนตั้งทีมถล่มคู่ต่อสู้ให้ราบคาบ สนุกสนานกับการต่อสู้ในโหมด PvP หรือ ลงดันเจี้ยนหาไอเทมร่วมกับเพื่อน พร้อมพบปะเพื่อนใหม่ที่บ่อออนเซ็น พูดคุย ทำกิจกรรมร่วมกัน \\u003cbr\\u003e\\u003cbr\\u003e[ เคลียร์ดันเจี้ยน ตะลุยด่าน ต่อสู้บอส ]\\u003cbr\\u003eลุยเดี่ยวหรือแท็กทีมต่อสู้บอส ตะลุยด่าน เคลียร์ดันเจี้ยน รับไอเทม, อุปกรณ์และอาวุธหายาก \\u003cbr\\u003e\\u003cbr\\u003e[ โชว์ความแม่นในโหมด PVP ]\\u003cbr\\u003eใครยิงแม่นก็โชว์ฝีมือกันไปเลยในโหมด PVP ไม่ว่าจะเป็นสาย 1 vs 1, 2 vs 2, 3 vs 3 หรือ 4 vs 4 ก็มีให้เลือกหลากหลาย หากคุณแม่นพอก็ไต่แรงค์ขึ้นสู่มือปืนอันดับ 1 ของซีซั่นให้ได้\\u003cbr\\u003e\\u003cbr\\u003e[ ตัวละครคลาสสิกสุดจ๊าบ สร้างสรรค์สไตล์ที่ไม่เหมือนใคร ]\\u003cbr\\u003eตัวละครน่ารักคลาสสิกสุดจ๊าบที่คุณสามารถแต่งตัวได้ตามสไตล์  มีแฟชั่นหลายหลากให้ได้เลือกสรร ไม่ว่าจะเป็นปีก หน้าตา ชุดแฟชั่น หมวก หรือ แว่นตาก็มีพร้อม เข้าเกมไปโชว์สไตล์ของคุณกันได้เลย\\u003cbr\\u003e\\u003cbr\\u003eทุกแมทช์การแข่งขันต้องลุกเป็นไฟ เพราะ DDTank Origin ยิงมันส์มาก!!\"],\"VNG SINGAPORE PTE. LTD.\",\"500,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/jNIJixwd9JhyUCLUm1yk0UCcrl-rtU8S0CSVp3yrD8TereuZphhJds2fXBcGIFiIP5XGSBkJhSOZRuHmTliMmw\"],null,[168,142,254,255]],null,[\"ประเภท 12+\",[null,2,[366,512],[null,null,\"https://play-lh.googleusercontent.com/yQChfa9XKlaXMIYTk8w8QwChjT8_SH-_2d2SS-kesw0TLQK1nxtw54bDcoZ09freZJgKrtg4f__is-31Vg\"]],[null,\"ความรุนแรงปานกลาง\"],[null,\"การโต้ตอบกับผู้ใช้และการซื้อในเกม\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/YrkR-GP7OKghBTATCoO_jJrchSVrh-NSUBb5DnbRZC1DbLK_cgV9FC2e_iI4GzLsKXuZjuFZajnGCiA8qA\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dvng.game.boomz.origin.th\\u0026rdid\\