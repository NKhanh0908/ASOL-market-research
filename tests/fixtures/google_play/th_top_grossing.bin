ull,\"https://play-lh.googleusercontent.com/CFsnZ7nhuo_i38adf6EKLrg3lttN5olPW1sF-8r8YSPg4u4j7aPC2q88VlvPI8_rNfkcZmFLzXN8O8XBABFiMw\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/imvs9_9ewBhwYelu5Zz0_RATmX074AFRsKqh7E_oSynBQDebEAWCmbOWCiPhDpdS_lArobwOJmBiKQtiVotb0MU\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/8f1nnpxun-uJNVH2lezEmZsH2jwUQw-pe4-w4iC0vkwrB0XIfDr0egGMrifqfPtcz3EfXOs9m5FeoKbE_iVYiA\"]]],\"Seven Knights Idle Adventure\",[\"4.6\",4.62895],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.netmarble.skiagb\\u0026rdid\\u003dcom.netmarble.skiagb\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.netmarble.skiagb\"]],[\"qgJhGl8IQ0oTCMHPrLDHkJcDFZdanQkdEZckpfoBDAoKCAASBgoCdGgQALoCNgoaChRjb20ubmV0bWFyYmxlLnNraWFnYhABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,\"gMKrJx3NlZE\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:gMKrJx3NlZE?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:gMKrJx3NlZE\",null,null,null,null,\"AXH1ezk5kAMuO5xM6Sdv4y8xoa1994XeWcW_1x6xR00TGD_7WaOy8NsdyNcjHkmphq0LG0l3nBV8c-lq5M5imsssZWsJy16pzl6zNpPhH5heD7BrarkpmF8LFbNEDGbYUqtYlAnBsXbwHxdBpGtFaqTrOQ6ZofqsuDcIWXdePqbLQHaP_Oq0MDxD1YvVgj-_hEuOd_qgLhCjFthn3AhhicrM5KwTfV6KOBoIqipJAUfNS4oRT48yDuLldW3CaE-ymXcKYfWxkO4hOVeHm0h5DgGL3Go2ofgOI_iSX6-oVpT0gP_M8w\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/gMKrJx3NlZE/hqdefault.jpg\"]]]],[null,\"เรื่องราวอีกหนึ่งบทของเซเว่นไนท์ การปฏิวัติอันแสนสนุกของเหล่าตัวละครใหม่!\\u003cbr\\u003e เรื่องราวการผจญภัยสุดแสนอลหม่านที่มาพร้อมกับตัวเอกคนใหม่ และเหล่าอัศวินเซเว่นไนท์!\\u003cbr\\u003e \\u003cbr\\u003e ▶ เซเว่นไนท์ในแบบฉบับเฉพาะตัวที่แม้จะปล่อยทิ้งไว้ก็สามารถพัฒนาได้\\u003cbr\\u003e ง่ายและรวดเร็วทั้งการต่อสู้และการพัฒนา!\\u003cbr\\u003e ต่อสู้ได้ง่ายๆ ด้วยการล่าแบบอัตโนมัติ และสามารถรับ EXP และทองได้โดยไม่ต้องเชื่อมต่อเกม\\u003cbr\\u003e \\u003cbr\\u003e ▶ ฟอร์มทีมอัศวินที่ไม่เหมือนใคร\\u003cbr\\u003e การปรากฏตัวของเซเว่นไนท์สุดน่ารักและมีเสน่ห์\\u003cbr\\u003e ฟอร์มทีมที่ไม่เหมือนใครด้วยอัศวินที่มีเอกลักษณ์เฉพาะตัว\\u003cbr\\u003e \\u003cbr\\u003e ▶ การต่อสู้เชิงกลยุทธ์ 10 vs 10!\\u003cbr\\u003e การต่อสู้สุดอลังการที่รองรับอัศวินได้สูงสุด 10 คน\\u003cbr\\u003e โชว์เหล่าอัศวินพราวเสน่ห์ที่ไม่เหมือนใครในฟิลด์ ดันเจี้ยน และอารีน่า\\u003cbr\\u003e \\u003cbr\\u003e ▶ เพิ่มความอลังการมากยิ่งขึ้นด้วยคอสตูม และสัตว์เลี้ยง!\\u003cbr\\u003e สร้างอัศวินที่ไม่เหมือนใครด้วยสัตว์เลี้ยงแสนน่ารักและคอสตูมที่มีเอกลักษณ์เฉพาะตัว\\u003cbr\\u003e \\u003cbr\\u003e ▶ กิจกรรมเชื่อมต่อสุดยิ่งใหญ่! แจกรูบี้มากมาย!\\u003cbr\\u003e ซัพพอร์ตการพัฒนาที่รวดเร็ว!\\u003cbr\\u003e พัฒนาเหล่าอัศวินได้อย่างรวดเร็วด้วยรางวัลเชื่อมต่อมากมายที่มอบให้ในทุกๆ วัน \\u003cbr\\u003e\\u003cbr\\u003e\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003d\\u003cbr\\u003e\\u003cbr\\u003e※ แอปพลิเคชั่นนี้มีการจัดเก็บการชำระเงินภายในเกม\\u003cbr\\u003eฟังก์ชั่นนี้สามารถปิดการใช้งานได้ผ่านการตั้งค่าอุปกรณ์\\u003cbr\\u003e※ ในการดาวน์โหลดเกมนี้ ท่านตกลงยอมรับเงื่อนไขการใช้งานและนโยบายจัดการความเป็นส่วนตัวของเรา\\u003cbr\\u003e\\u003cbr\\u003e- เงื่อนไขการใช้งาน: https://help.netmarble.com/terms/terms_of_service_en\\u003cbr\\u003e- นโยบายจัดการความเป็นส่วนตัว: https://help.netmarble.com/privacy_policy/skiagb\"],\"Netmarble\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/i0YXaUGL6zAcWg8iLwhq7C7ozmH