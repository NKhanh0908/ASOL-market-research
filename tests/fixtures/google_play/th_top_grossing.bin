"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/hD00PDqwoOEpWVm_4nwDUd1hIJI-0ZgKPaiv3cUpHMvWXTYHlMLMeKb5OeNc6m8BZ0NfGOLoCwAfQNkUZpE5Ons\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/KhHEDitNMOL0wHJLJndpcJgbdHTpnKiO41sHoGW340BvXdfRWXjt_IQ1iV_k_Tpy4VrzEEF3oSYI1-O4PzVpWw\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/TLGLXNUFfXfZSrIwkT_zpkDvz7SQ9Xu7R3eWB2HK1yeFQkzxK4590jGPf2RkLxkpxWJSDiUdW6qktRyj8Ba6eg\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/KhHEDitNMOL0wHJLJndpcJgbdHTpnKiO41sHoGW340BvXdfRWXjt_IQ1iV_k_Tpy4VrzEEF3oSYI1-O4PzVpWw\"]]],\"Cook Mix\",[\"4.2\",4.16],\"เล่นฆ่าเวลา\",null,null,[null,[[6000000,\"THB\",\"฿6.00\"]],null,[null,\"ซื้อ\"],null,2,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003did.manja.cookmix\\u0026rdid\\u003did.manja.cookmix\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003did.manja.cookmix\"]],[\"qgJrGmkIT0oTCMHPrLDHkJcDFZdanQkdEZckpfoBDAoKCAASBgoCdGgQAYgCBLoCOAoWChBpZC5tYW5qYS5jb29rbWl4EAEYAxIeCgQIARABCgQIAxABCgQIBBABCgQIBhABCgQICxABygICCAQ\\u003d\"],null,[null,\"Is a casual cozy cooking game about traditional brewer, where you will satisfy weird request from every customers.  Just relax... Take your time... No rush...\\u003cbr\\u003e\\u003cbr\\u003eBrew Nature 🌿 \\u003cbr\\u003eServe your customers of what they whining about! because they know you made it with your heart... \\u003cbr\\u003eJust make any combination... Brew it... See what you made...\\u003cbr\\u003e\\u003cbr\\u003eVarious Recipe Collection 🌿 \\u003cbr\\u003eDrag any ingredients to the pot, cook it, serve it to customers, repeat...\\u003cbr\\u003e\\u003cbr\\u003eFeatures\\u003cbr\\u003e1. Mix Ingredients. Combine a variety of ingredients to create unique and refreshing drinks.\\u003cbr\\u003e2. Unlock Recipe Collection. Discover and unlock special recipes as you experiment and progress.\\u003cbr\\u003e3. Collect Money and Get Rich. Sell your creations, earn money, and grow your drink business.\\u003cbr\\u003e4. Cozy Radio. Enjoy relaxing in-game radio music to set the perfect mood while mixing.\"],\"Manja Studio\",\"50,000+\",null,\"ทุกวัย\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/QufVAqJwQYBduRzqE81PjZ9EuZeQAOd-e0gdNqJHrFBb6F3uDpEh0xhXiiDxRyp6awMKAElnhBxwvX3MHr4NcQ\"],null,[149,119,88,255]],null,[\"ประเภท 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,[null,\"เหมาะสมสำหรับทุกกลุ่มอายุ มีความรุนแรงได้เล็กน้อยในบริบทที่ตลกขบขันหรือแฟนตาซี ห้ามไม่ให้มีภาษาที่หยาบคาย\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[6000000,\"THB\",\"฿6.00\"]],null,[null,\"ซื้อ\"],null,2,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003did.manja.cookmix\\u0026rdid\\u003did.manja.cookmix\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"ซื้อในราคา ฿6.00\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"เล่นฆ่าเวลา\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]],[null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0]]]]],null,[],true,[\"qgIMCgoKBl