U1Q35W-QPrUgqCg\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/N6YQDlqP0UdySkSstWH60-YJyjDuILmuS27PpIYFM6p1H8xvKR0J2lr6n4sObUvAuyW-7_hVP-2gNGk7ge8_rg\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/PsWtFcJFiKubQmPz2owUgUyZ4m3mNM-ajN0O25JGBku3uCgWSSasutbe5mx7sYW4dseC9HDRYVA-dVLNu2ujoQ\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/sn4ZVqAUZKyN2YADFpJW90ixFKbN-xcmschAFdduUpfFwg6MSo4mCBo2TH7k9J1pZJtSmP_WY4EqntsZhjVo\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/oqJotZ-FGnp0_hgYDZ9N3ih2PuGlxY5AWiuK1BrwC_R93p3E3APF9FFxflVGQjQGYwwHHdRdEi-NCPfPUT8AwA\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/ayNt53Q-4I7esLjST37LvSuUh4Y5VNrDoeGEJgerXoanvjYtCHwmnieg4-c_nU3xKs6XlDzU1Q35W-QPrUgqCg\"]]],\"Plato: เกมหลายผู้เล่นสุดมันส์\",[\"4.4\",4.413213],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.plato.android\\u0026rdid\\u003dcom.plato.android\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.plato.android\"]],[\"qgJeGlwIRUoTCMHPrLDHkJcDFZdanQkdEZckpfoBDAoKCAASBgoCdGgQALoCMwoXChFjb20ucGxhdG8uYW5kcm9pZBABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,\"aEOekbS-pYU\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:aEOekbS-pYU?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:aEOekbS-pYU\",null,null,null,null,\"AXH1ezmintDTKF6oLI2qDrmlyTgTQ6qSLRpJQ89Qvuwfaa9mL8ZVsZhTZgzuB4G6x_oM_bXo_1Qam9sMssQu2P5uOHzH0SoVOYu1io3zRqZskPaUulldJSvQsFhxPKtLOkl7_a3KGmoCHNEnsMtpEOXk29w5m5-WQRuynIGIfeJAtytzuiXlutayfZdscHPyVnZotkDMS3rVI5te1SOQSaNPd5WLqug96INbjt_2WkgX3Cmy3xb6krOSPujct5BLI0qa_R777JXqbd6ZFBveUocp0v631px1ly5ZfxIyduvM9dT9-w\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/aEOekbS-pYU/hqdefault.jpg\"]]]],[null,\"ยินดีต้อนรับสู่ Plato ที่ที่การเล่นเกมมาพบกับการแชทในรูปแบบที่ไม่ซ้ำใคร ดำดิ่งไปกับเกมหลายผู้เล่นที่น่าตื่นตาตื่นใจกมากกว่า 50 เกมที่ไม่น่าเบื่อและผสานผสานกับการแชทอย่างล้ำลึก เพื่อให้คุณเล่นและเชื่อมต่อกับเพื่อนเก่าและใหม่ได้\\u003cbr\\u003e\\u003cbr\\u003eทำไมคุณจะหลงรัก Plato:\\u003cbr\\u003e• มีเกมให้เลือกมากมาย: มีเกมหลายผู้เล่นชั้นนำกว่า 50 เกม เช่น Ocho (Crazy Eights) 8️⃣, Pool 🎱, และ Table Soccer ⚽ ให้คุณสนุกไปกับเกมได้เสมอ ไม่ว่าคุณจะชอบเกมแนววางแผน กีฬา หรือเกมกระดานคลาสสิก เราก็มีเกมให้คุณเล่นมากมาย\\u003cbr\\u003e• ความสนุกที่ไร้โฆษณา: บอกลาโฆษณาที่น่ารำคาญ และการจ่ายเพื่อชนะ พร้อมเกมที่เล่นฟรี Plato เป็นเกมที่ให้ความสนุกสนานอย่างแท้จริงและต่อเนื่อง\\u003cbr\\u003e• เราให้ความสำคัญกับความเป็นส่วนตัว: เราไม่เก็บข้อมูลที่ไม่จำเป็น คุณจึงเล่นเกมและแชทได้อย่างสบายใจ\\u003cbr\\u003e• สวรรค์ของการปรับแต่ง: ปรับแต่งโปรไฟล์ ธีมการสนทนาแบบกลุ่ม และประสบการณ์การเล่นเกมของคุณเพื่อให้ Plato เป็นของคุณอย่างแท้จริง\\u003cbr\\u003e• เล่นกับเพื่อนๆ: เล่นเกมกับเพื่อนที่อยู่ในการสนทนาแบบกลุ่มกับ Plato ซึ่งเป็นโปรแกรมส่งข้อความที่สมบูรณ์แบบ เข้าร่วมการสนทนาแบบกลุ่ม ห้องแชท และแม้แต่แชทด้วยเสียง เพื่อประสบการณ์การเข้าสังคมดีที่สุด\\u003cbr\\u003e • เข้าร่วมการแข่งขัน: ไม่ว่าจะเป็นเกมแข่งขันแบบจัดอันดับ หรือทัวร์นาเมนต์รายสัปดาห์ มีโอกาสที่จะพิสูจน์ว่าคุณคือที่สุด ไต่อันดับบนกระดานผู้นำและเป็นหนึ่งเหนือเพื่อนๆ ของคุณ\\u003cbr\\u003e\\u003cbr\\u003eเกมที่คุณไม่ควรพลาด:\\u003cbr\\u003e• เกมคลาสสิก: หมากฮอส 🏁, หมากรุก ♟️, คริบเบจ, แบ็กแกมมอน ⚪, ปาร์ตี้ลูกเต๋า 🎲, โดมิโน ◻️, โฟร์อินอะโรว์ ⭕\\u003cbr\\u003e• เกมไพ่: บาลูท, โฮลเด็มโป๊กเกอร์ ♣️, โพดำ, ยูเคร, จินรัมมี่♦️, หัวใจ ♥️, โกฟิช 🎣\\u003cbr\\u003e• เกมกระดานและปาร์ตี้: ลูโด 🟠, บิงโก 🅱️, จุดและกล่อง ☑️, แบงก์โรล, มนุษย์หมาป่า (มาเฟีย)🐺\\u003cbr\\u003e• กีฬาและแอ็กชัน: ยิงธนู 🏹, บาวน์เด้ง, บาสเก็ตบอล 🏀, โบว์ลิ่ง 🎳, คัพปอง, ลูกดอก 🎯, มินิกอล์ฟ ⛳️, \\u003cbr\\u003eฟุตบอลโต๊ะ ⚽\\u003cbr\\u003e• ปริศนาและกลยุทธ์: ไมน์สวีปเปอร์ 💣, Wordbox, Go ☯️, Literati, Mancala\\u003cbr\\u003e• เกมที่มีเฉพาะที่ Plato: Match Monsters 💎, Brawlbots, Plox 👾, Blitz League\\u003cbr\\u003e\\u003cbr\\u003eเข้าร่วมกับผู้เล่นนับล้านคนทั่วโลกที่ทำให้ Plato เป็นแอปสำหรับเล่นเกมและแชท ดาวน์โหลด Plato วันนี้ แล้วมาสัมผัสกับประสบการณ์ที่ผสมผสานความสนุกและมิตรภาพในเกมออนไลน์!\\u003cbr\\u003e\\u003cbr\\u003eหากมีข้อสงสัยหรือคำถามเพิ่มเติม ส่งอีเมลมาหาเราได้ที่ hello@platoapp.com เราอยากฟังความคิดเห็นของคุณ\"],\"Plato Team Inc.\",\"50,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/FdjCEMYNwyY1BFfgSronuhGTmXdrXBIzW0RrzUok0boQvimoVeWnSK-CwMrB7XlFrKlU4RLvK3RqrmlVWaM7Gw\"],null,[37,36,98,255]],null,[\"ประเภท 18+\",[null,2,[366,512],[null,null,\"https://play-lh.googleusercontent.com/QNpsl4k43vdbfwUAlVLZul2W5O5MUGOToystzghc97mljVHbUwtc639tahcuDsAVHdaGMyZA40AmMVcB_ws\"]],[null,\"การพนันจำลอง\"],[null,\"การโต้ตอบกับผู้ใช้และการซื้อในแอป\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/stIOCymv1bYIi3UU_owFeyNt30CkUXbNlDj81ZWtjW9NBIMJxI47i_psYIr0Ho430Rm6mByCGNLORloB\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.plato.android\\u0026rdid\\u003dcom.plato.android\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"ติดตั้ง\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"฿34.00 - ฿6,950.00 ต่อรายการ\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"เล่นฆ่าเวลา\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],nu