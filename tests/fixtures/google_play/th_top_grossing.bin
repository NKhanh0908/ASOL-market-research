/U8NwjNCeHcdB9FRm54y_MBrsVkYdAKaANZgzUwxTN9IG06XBWO7FVKkfElA_rXybI47PAoSAxHeg49bXpA0EHQ\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/_JHWpYbQ9hgaBYfjoHKx8RbKUoUaUCWIBEyXCmKDEttdNekdGhGiJsnhu7ZAIwEaoSi16fNsOQpYkLq3Rwpz-ng\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/ZrEUGvEpEmC9-gL9QLc3h1CE6h9GbvsgmGGW1kK1KEH2wx-KzFQawH5B1Sq7uPB70DaPbWj5AoLULdr90Tk\"]]],\"Slack Off Survivor-Collab\",[\"4.4\",4.4313293],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.pgfight.an.tw\\u0026rdid\\u003dcom.pgfight.an.tw\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.pgfight.an.tw\"]],[\"qgJeGlwIIEoTCMHPrLDHkJcDFZdanQkdEZckpfoBDAoKCAASBgoCdGgQALoCMwoXChFjb20ucGdmaWdodC5hbi50dxABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"Slack Off Survivor × Journey to the West คอลแลบมาแล้ว!\\u003cbr\\u003eฮีโร่ใหม่ พุทธพิชิตชัย มาถึงแล้ว! ปลดปล่อยพลังสุดแกร่ง บดขยี้ศัตรู และออกเดินทางสู่ตำนานบทใหม่!\\u003cbr\\u003e\\u003cbr\\u003e[สกินระดับเทพนิยายลิมิเต็ด]\\u003cbr\\u003eสกินฮีโร่ระดับเทพนิยายลิมิเต็ดใหม่ล่าสุด! ปลดล็อกลุคสุดพิเศษ พร้อมปลดปล่อยพลังที่เหนือกว่า!\\u003cbr\\u003e\\u003cbr\\u003e[ Idle Roguelike สุดมันส์]\\u003cbr\\u003eโหมดเดี่ยวพร้อมด่าน Roguelike แบบไร้ที่สิ้นสุด! วางกลยุทธ์ ฝ่าด่าน จัดตำแหน่งให้เหมาะสม แล้วคว้าชัยชนะได้ง่าย ๆ!\\u003cbr\\u003e\\u003cbr\\u003e[ผสานและเลื่อนขั้น]\\u003cbr\\u003eอัญเชิญ ผสาน และเพิ่มพลังให้ฮีโร่! ทุกการเล่นมาพร้อมการจัดทีมรูปแบบใหม่ ความประหลาดใจ และความเป็นไปได้ที่ไม่สิ้นสุด\\u003cbr\\u003e\\u003cbr\\u003e[สกินลอร์ดใหม่]\\u003cbr\\u003eสกินลอร์ดใหม่ล่าสุดมาแล้ว! แปลงร่างเป็นฮีโร่ในตำนานจากไซอิ๋ว ปลดล็อกลุคสุดพิเศษ และออกผจญภัยครั้งใหม่!\\u003cbr\\u003e\\u003cbr\\u003e[เส้นทางอัปเกรดหลากหลาย]\\u003cbr\\u003eพบกับเส้นทางการผสานและอัปเกรดที่หลากหลาย เลือกเส้นทางการพัฒนาของคุณเอง และสร้างทีมที่แข็งแกร่งที่สุด!\"],\"MOREFUN（H.K.) LIMITED\",\"500,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/759dop4hgd5rwU0WZWb3H4BiCpMJm4PBiXUUL0q-Cb7HuOLPvvE_e_jVyWBLB4DvegfFmQ90-YvszDzdvTerOg\"],null,[247,229,162,255]],null,[\"ประเภท 12+\",[null,2,[366,512],[null,null,\"https://play-lh.googleusercontent.com/yQChfa9XKlaXMIYTk8w8QwChjT8_SH-_2d2SS-kesw0TLQK1nxtw54bDcoZ09freZJgKrtg4f__is-31Vg\"]],[null,\"ความรุนแรงปานกลาง\"],[null,\"การโต้ตอบกับผู้ใช้\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/YrkR-GP7OKghBTATCoO_jJrchSVrh-NSUBb5DnbRZC1DbLK_cgV9FC2e_iI4GzLsKXuZjuFZajnGCiA8qA\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.pgfight.an.tw\\u0026rdid\\u003dcom.pgfight.an.tw\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"ติดตั้ง\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"฿39.00 - ฿3,690.00 ต่อรายการ\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"เล่นฆ่าเวลา\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"kr.co.alohacorp.ipmerge\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/tSKUD4U0YiQwITArnL37bXsd_t840Z2qzZSJour1a-kwQw68zA2YoTMl7kqZrpZOaxLlgIA9DSFlYpmNOoCwTw\"],null,[159,205,84,255],null,null,null,2],[[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/j5