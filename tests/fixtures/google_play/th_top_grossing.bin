\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/nn5byF0OlphdDSvW0KlpWRGrf4NBYLt64fF-MX8fgDttqg0--BBN1wiA9jdc01qlxaCjYAh-sYCF61xYZq71KA\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/lFm4itO49wm9BG31D5BLHo1YxuSgR0xGII6Su8fXcJUfvO5cN7D8QdQZOaz-8Q_3o6spW332quckzi34ED6Wjg\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/Nl2f0WpFVM6S_p0o_Z7cTgtDmUUSdUpCgE3_drjU893bja7XkJfjQwQy0T5PtVIUoAQZIbV_Yd6_k_fOU6xI7pU\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/yRLCgWM73hXTtOHygFC8vrp4CARdrSBRTAD6vNyh9qJHG6zVSJxANKzs_7-hoPbMx2eb9KCGPr31QDUh2baUyL4\"]]],\"Haunted Room: Sleep Survivor\",[\"4.9\",4.901899],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.ygjszsea.google\\u0026rdid\\u003dcom.ygjszsea.google\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.ygjszsea.google\"]],[\"qgJgGl4IKEoTCMHPrLDHkJcDFZdanQkdEZckpfoBDAoKCAASBgoCdGgQALoCNQoZChNjb20ueWdqc3pzZWEuZ29vZ2xlEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"\\u003cb\\u003e\\u003cfont color\\u003d\\\"red\\\"\\u003e[รางวัลพิเศษ] 500 สุ่ม, สกินโครงกระดูก, ฮีโร่ส้มสุ่ม และของตกแต่งลิมิเต็ด!\\u003c/font\\u003e\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003eเมื่อเมืองที่คุ้นเคยกลายเป็นลานล่าเหยื่อของเหล่าภูตผี... \\u0026quot;ก๊อก ก๊อก ก๊อก\\u0026quot; เสียงเคาะประตูอันลึกลับกำลังดังขึ้น...\\u003cbr\\u003e\\u003cbr\\u003e\\u0026quot;ชู่ว... อย่าส่งเสียง อย่าเปิดประตูเด็ดขาด\\u0026quot;\\u003cbr\\u003e\\u003cbr\\u003eเมื่อเหล่าภูตผีในตำนานหลุดจากมิติและกำลังจะพังประตูเข้ามา คุณต้องปิดประตูให้สนิท แล้วผนึกกำลังกับเหล่าฮีโร่เพื่อเปิดศึกป้องกัน \\u0026quot;ประตู\\u0026quot; ที่อาจไม่สยองขวัญจนขนหัวลุก แต่จะทำให้หัวใจเต้นรัวแน่นอน\\u003cbr\\u003e\\u003cbr\\u003eทั้งโรงเรียน, โรงพยาบาล, โรงแรม, ถนน หรือแม้แต่ในออฟฟิศ ทุกที่รอบตัวจะกลายเป็นด่านป้องกันฐานสุดระทึก ให้ได้สัมผัสความมันส์ทั้งงานภาพและการคอนโทรล จบไวใน 5 นาที!\\u003cbr\\u003e\\u003cbr\\u003e[5 ฟีเจอร์หลัก นิยามใหม่ของเกมป้องกันฐานสายสยองขวัญ]\\u200b\\u003cbr\\u003e※ เลือกห้อง, ปิดประตู, นอน แล้วอัปเกรด!\\u003cbr\\u003eผีมาแล้วทำไงดี? หนีไม่พ้นใช่ไหม? งั้นก็นอนมันซะเลย\\u003cbr\\u003eเลือก \\u0026quot;ห้อง\\u0026quot; ที่ใช่ ปิด \\u0026quot;ประตู\\u0026quot; ให้สนิท นอนแล้วอัปเลเวลต่อในฝัน พร้อมซัมมอนฮีโร่เพื่อสร้างแนวป้องกัน จะรอดพ้นจากเสียงเคาะประตูยามวิกาลได้หรือไม่ ขึ้นอยู่กับการวางหมากของคุณ\\u003cbr\\u003e\\u003cbr\\u003e※ พลิกแพลงกลยุทธ์ ชิงไหวชิงพริบ\\u200b\\u200b\\u003cbr\\u003eไม่ต้อง \\u0026quot;เดิมพันด้วยชีวิต\\u0026quot; และไม่ใช่แค่การหลบซ่อน เพราะเตียงก็อัปเกรดได้ ประตูก็อัปเกรดได้ ฮีโร่ก็อัปเกรดได้ ใช้ห้องของคุณเป็นแนวป้องกัน จัดทีมและวางกลยุทธ์ให้เหมาะกับสถานการณ์ ทุกครั้งที่ป้องกันสำเร็จ ฟีลความสะใจมาเต็ม\\u003cbr\\u003e\\u003cbr\\u003e※ สัมผัสประสบการณ์ภาพเหนือจินตนาการ\\u003cbr\\u003eโดดเด่นด้วยงานภาพสไตล์โกธิคจิบิที่ให้คุณดื่มด่ำกับบรรยากาศสยองขวัญ สิ่งที่อยู่ในแก้วของแวมไพร์คือเลือดหรือไวน์แดง? แล้วทำไมฆาตกรเลื่อยไฟฟ้าถึงใส่หน้ากากกระต่ายสุดคิ้วท์? พบกับดีไซน์ฮีโร่และภูตผีนับร้อยแบบที่สยองนิดๆ แต่น่ารักหน่อยๆ\\u003cbr\\u003e\\u003cbr\\u003e※ สวมบทบาทตัวหลักหลากหลาย ท้าทายดันเจี้ยนไม่ซ้ำ\\u003cbr\\u003eแปลงร่างเป็น \\u0026quot;แก๊งคนกล้า\\u0026quot; ออกสำรวจสถานที่ลี้ลับ ทั้งรถไฟผีสิง หอพักเสียงเพลงสยอง หรือถ้ำลึกลับใต้ดิน ผู้เล่นสามารถเลือกสวมบทบาทเป็นตัวละครที่หลากหลาย วันนี้คุณจะเลือกใช้ใบหน้าอันไหนเพื่อเข้าสู่เกมแบตเทิลรอยัลครั้งนี้?\\u003cbr\\u003e\\u003cbr\\u003e※ การต่อสู้ป้องกันฐานที่รวดเร็ว แต่เร้าใจ\\u003cbr\\u003eเกมจบไวใน 5 นาที ไร้ความกดดัน สนุกได้ในเวลาว่างหรือช่วงเวลาพักสั้นๆ สัมผัสความมันส์ของเกมป้องกันฐานคุณภาพสูงด้วยวิธีการเล่นที่ง่ายสุดๆ\"],\"Joy Nice Games\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/Y9y98V3BoPK5H_-zOmpgLI3IbRP60Zilpr_6MW28WEZ2Ox4yMafKDeoK7YeG-nPfES-4