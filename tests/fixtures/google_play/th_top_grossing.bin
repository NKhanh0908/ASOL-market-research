ull,2,[1280,720],[null,null,\"https://play-lh.googleusercontent.com/WVJsiS6RwLpTddkVWt1eoYkO48dzd84jtwDoBXnx_hlrJ-7lGFw1jbTHXJSti1brttRLrvKGXR_fCdjZfJTvyA\"]],[null,2,[1280,720],[null,null,\"https://play-lh.googleusercontent.com/0Lfj1ZdhTZnWVQGcDDlc96abZRohg2IBk4xYL8P4njTjHUbZp_ytccNLtnBqk6nud3Br5AT982gORTJPgUOiKw\"]],[null,2,[1280,720],[null,null,\"https://play-lh.googleusercontent.com/LAG9DqMmKF-SZFDyxZGejrxsDl4BGU5DPX0fOs09esE3yb5up5uQbSkXZWmvUia3SQh2UmxFFcZaizkenxIvzg\"]],[null,2,[1280,720],[null,null,\"https://play-lh.googleusercontent.com/kF_JIlj5WuQ2WV-DZ4a2E0mszdhcr_dulEsjp69R_XHWppMWbOyXa0V9sCCOI3d4XFQxoDHDd5B583_e2jd1QA\"]],[null,2,[1280,720],[null,null,\"https://play-lh.googleusercontent.com/gelxIEY34Adbmwls5QIchwSn3XqK70C1-4Qpf0r5NbyeTVt1wO4RMGImEokCXUAdiM8v8sZIrBhTVPdZfPYIwQ\"]],[null,2,[1280,720],[null,null,\"https://play-lh.googleusercontent.com/WVJsiS6RwLpTddkVWt1eoYkO48dzd84jtwDoBXnx_hlrJ-7lGFw1jbTHXJSti1brttRLrvKGXR_fCdjZfJTvyA\"]],[null,2,[1280,720],[null,null,\"https://play-lh.googleusercontent.com/0Lfj1ZdhTZnWVQGcDDlc96abZRohg2IBk4xYL8P4njTjHUbZp_ytccNLtnBqk6nud3Br5AT982gORTJPgUOiKw\"]],[null,2,[1280,720],[null,null,\"https://play-lh.googleusercontent.com/LAG9DqMmKF-SZFDyxZGejrxsDl4BGU5DPX0fOs09esE3yb5up5uQbSkXZWmvUia3SQh2UmxFFcZaizkenxIvzg\"]]],\"Hero Clash\",[\"4.3\",4.2528977],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.xgame.newasia.sea.gp\\u0026rdid\\u003dcom.xgame.newasia.sea.gp\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.xgame.newasia.sea.gp\"]],[\"qgJlGmMIKUoTCMHPrLDHkJcDFZdanQkdEZckpfoBDAoKCAASBgoCdGgQALoCOgoeChhjb20ueGdhbWUubmV3YXNpYS5zZWEuZ3AQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],null,[null,\"พร้อมตะลุยดันเจี้ยนสุดหลากหลาย ปะทะกับวายร้ายสุดโหด กอบกู้แผ่นดินที่ถูกทำลายล้าง ออกสำรวจโลกลึกลับที่เต็มไปด้วยอันตราย!\\u003cbr\\u003e\\u003cbr\\u003eเพื่อที่จะกอบกู้แผ่นดินนี้ คุณต้องเผชิญกับความท้าทายด้านความอดทนและปัญญา!\\u003cbr\\u003eเคล็ดลับ: วิธีที่ง่ายที่สุดในการพิชิตความท้าทายคือ คว้าจังหวะที่เหมาะสมด้วยสติปัญญาของคุณ และที่สำคัญที่สุดคือการปฏิบัติที่ถูกต้องแม่นยำ\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003eจุดเด่น:\\u003cbr\\u003e- ดันเจี้ยนใหม่จัดเต็ม เลือกตะลุยได้ตามใจคุณ\\u003cbr\\u003e- เล่นเกมด้วยมือข้างเดียว สยบฟ้าพิชิตปฐพี!\\u003cbr\\u003e- คลี่คลายปมปริศนา สัมผัสเกมกลยุทธ์ต่างๆ\\u003cbr\\u003e- รวบรวมและจับคู่เพื่อไขปริศนาแห่งโลกสุญญตา\\u003cbr\\u003e- สริมความแข็งแกร่งของคุณ ร่วมมือกับสหายแล้วเผจญภัยไปด้วยกัน!\\u003cbr\\u003e\\u003cbr\\u003eติดต่อเรา - Facebook: https://www.facebook.com/HeroClashHKTWMO?mibextid\\u003dLQQJ4d\\u003cbr\\u003e\\u003cbr\\u003e※ เกมนี้ฟรี แต่ภายในเกมจะให้บริการแบบชำระเงิน เช่น การซื้อเงินในเกม ไอเทม ฯลฯ โปรดใช้จ่ายตามความชื่นชอบและความสามารถของคุณเอง\\u003cbr\\u003e※ โปรดควบคุมเวลาในการเล่นเกม อย่าหมกมุ่นอยู่กับการเล่นเกมหรือเล่นเกมเป็นเวลานาน ขอแนะนำให้พักผ่อนและออกกำลังกายอย่างเหมาะสม\"],\"Glaciers Game\",\"5,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/jDscY65gc1MenAivFW6Yibw_Vmwgvm2McnzlNEp4mNGddJ0E_drlyPN7N__s_1HErX7tNFvKZV5vHmLZnv2HZw\"],null,[146,55,26,255]],null,[\"ประเภท 7+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/1SrNtAwg9PFOhgMJPXehacRTeQNhHhG12Pj1zACHNVmfRfEZA3_oOEmLvRNsmYGeGHpas7sCwyR3y8OT\"]],[null,\"ความรุนแรงน้อย\"],[null,\"การโต้ตอบกับผู้ใช้และการซื้อในเกม (รวมถึงรายการสุ่ม)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/JTT-ImEkrbWzIL7w0fP8fQhVmpexdfh7u0P59PJtyJywmQBVolJjunMal6B5dUM6uiFiKnmtHtBbVvcWBMU\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]