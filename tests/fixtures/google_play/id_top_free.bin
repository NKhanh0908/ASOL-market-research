dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.hp.keyboard.obby.asmr.speed.run\"]],[\"qgJwGm4IHEoTCKPKxrDHkJcDFSkItwAdcYkOKPoBDAoKCAASBgoCaWQQAboCRQopCiNjb20uaHAua2V5Ym9hcmQub2JieS5hc21yLnNwZWVkLnJ1bhABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"Welcome to Keyboard Obby: ASMR Speed Run, where you can experience the thrill ofthe ultimate 3D typing parkour game.\\u003cbr\\u003e\\u003cbr\\u003eJump, run, and flip your way through challenging obstacle runs inspired by mechanical keyboards. Test your typing speed and reflexes in fast-paced, action-packed levels with satisfying ASMR sounds!\\u003cbr\\u003e\\u003cbr\\u003e🔥 Game Features:\\u003cbr\\u003e\\u003cbr\\u003eFun keyboard parkour challenges with smooth controls\\u003cbr\\u003e\\u003cbr\\u003eCreative obstacle courses made of keys and switches\\u003cbr\\u003e\\u003cbr\\u003eColorful 3D environments \\u0026amp; satisfying ASMR sound effects\\u003cbr\\u003e\\u003cbr\\u003eEasy to play, hard to master – perfect for all levels\\u003cbr\\u003e\\u003cbr\\u003eIf you love parkour games, running challenges, or satisfying ASMR adventures, this is for you.\"],\"HIGAME GLOBAL\",\"1.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/hqg15eV9NlUInBz4yXz25VJkDTEByZpnC94GFexHCo1AV39TlwIe9x5Ch-1oLd60gUADHPs5Xhmdy-zYaGVnug\"],null,[73,199,244,255]],null,[\"Rating 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003ePelajari lebih lanjut\\u003c/a\\u003e\"],true,[null,\"Cocok untuk semua kelompok usia. Beberapa kekerasan dalam konteks komikal atau fantasi dapat diterima. Bahasa kasar tidak diizinkan.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.hp.keyboard.obby.asmr.speed.run\\u0026rdid\\u003dcom.hp.keyboard.obby.asmr.speed.run\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Instal\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Kasual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.omndev.mqgame.globeblast\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/ZzT3H3pEBTtXR0xaOPzZQwEBKS62Vx_n-sBwbksPArsBdPOLHd__GKoKmcKoi9qJQAYoXnKs09i4wC_2KTKwl0Q\"],null,[8,160,248,255],null,null,null,2],[[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/RuqTpDHso7BRikrQCiasmWAjQVa0Iph1OkUvla5LNZV0ld-ogLI90hu_Jera2hpCfqR0cqged-ak8y6TxhZstA\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/REH_llO-SAIMqUxL9VV74arusarMQSBYDb8WKEOMllQ9oe5JlCHt2fppdn623zdC_Kxkp-Lmn6nC6sEaKWkYKA\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/jSxMxf9O9gFI11IsF_DxN26nXhdcuBh3ckwF9H95mhCGQhb2h499sBly6BcXUV36-dZnGWzjSzjO64CzyfjS\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/hTzvAUc0Z5xiOsWnnuNV-_B-BLCkiyRH83NB2kuKafz1FMkN6YUHQougF_JiItng2-tn6OuVqebfbXdRR7ii\"]]],\"Orb Quest\",[\"4,8\",4.768411],\"Kasual\",null,null,[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.omndev.mqgame.globeblast\\u0026rdid\\u003dcom.omndev.mqgame.globeblast\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.omndev.mqgame.globeblast\"]],[\"qgJpGmcIHUoTCKPKxrDHkJcDFSkItwAdcYkOKPoBDAoKCAASBgoCaWQQALoCPgoiChxjb20ub21uZGV2Lm1xZ2FtZS5nbG9iZWJsYXN0EAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"Mari tenggelam dalam dunia yang memikat dari Orb Quest, di mana gameplay yang menegangkan dan visual menawan menantimu. Game ini terkenal dengan desain uniknya yang diciptakan untuk membangkitkan sukacita di antara semua pemain dan memberikan pengalaman bermain game yang personal.\\u003cbr\\u003e\\u003cbr\\u003eDengan mekanisme sederhana dan instruksi yang jelas, Orb Quest memungkinkan Anda mengarungi pola-pola yang sama, mendapatkan poin, dan membuka hadiah saat Anda maju. Nikmati grafis yang hidup dan musik yang menenangkan yang menyertai permainan Anda, menciptakan lingkungan bermain game yang tenang dan mendalam.\\u003cbr\\u003e\\u003cbr\\u003eOrb Quest bertujuan untuk memberikan pengalaman bermain game yang mulus dan menyenangkan, dengan menawarkan berbagai gaya permainan, efek visual yang memukau, dan dukungan multi bahasa yang cocok untuk pemain dari segala usia. Untuk bermain, cukup ketuk untuk menghilangkan ikon-ikon yang berdekatan dan tingkatkan skor Anda dengan menghilangkan pola-pola multipel secara bersamaan.\\u003cbr\\u003e\\u003cbr\\u003eLangkahkan kaki Anda dalam petualangan yang memikat ini penuh dengan sukacita yang tak terbatas dan tantangan yang mendebarkan. Biarkan Orb Quest membawa Anda ke dunia hiburan, merangkul daya tarik tak terbatas dari kegembiraan bermain game.\"],\"el-fatha studio\",\"1.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/jFUgZ0ZwT7ZsH_4f8rO9Ib_r_kQvL8TmQ6yQLjlj-68pCftY_AnFyYBR39Mego9yydKVLjCiODCuTC90p_haWw\"],null,[216,219,254,255]],null,[\"Rating 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003ePelajari lebih lanjut\\u003c/a\\u003e\"],true,[null,\"Cocok untuk semua kelompok usia. Beberapa kekerasan dalam konteks komikal atau fantasi dapat diterima. Bahasa kasar tidak diizinkan.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.omndev.mqgame.globeblast\\u0026rdid\\u003dcom.omndev.mqgame.globeblast\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Instal\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Kasual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.infiniplay.merge.fashion.romance.story\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/RBJQHS4LrfB2YsanJQcGbFkV1O4kdt_6x3yFZHf8o_UnSM20e5siDSc7tVc3uvE7_A_9JA0RbZiPfHwor02Ut44\"],null,[229,115,255,255],null,null,null,2],[[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/sqLwP7qygS7zLgQVGuELTaTDCtjs8gkT6n6KfVpAOlZIb86sCtQSgCfPqnQPu96i3Y96wJan_lzLZ_jvvx_cFEc\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/7hZeezBaTxsR6ukOFdStLJvVGsx6AwpdYt-bWykBYdd8czY0vMj_pSPjO0qioHtP5bb