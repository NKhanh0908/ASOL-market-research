[null,null,\"https://play-lh.googleusercontent.com/BB9DlRVmcsuz9RLjWCVEa-qHt_bYQRf__67KU6T7Dr_LqAraMlQB_iVKBz7LuhQw0fG65I7RgJVYAn_ptyC6l7k\"]],[null,2,[2688,1242],[null,null,\"https://play-lh.googleusercontent.com/RCIVceWmNXBOHY5dUKN9YgZb31L4OW1AUHWeXfj-bf-TH-Cb_RQJRAk4VVZtsrlIIW3Kph8PgaTpg_hRqu30Jg\"]],[null,2,[2688,1242],[null,null,\"https://play-lh.googleusercontent.com/RKAKHEMAZ_R2T41fMuaIT8V8hwTmR_d4YBI47GGRsmOo0YoyF0tAnf8nFrNTqEqCuo6m_aVn02Vd9G8FxJ7Ag4M\"]],[null,2,[2688,1242],[null,null,\"https://play-lh.googleusercontent.com/nHbm0qYTUyNvAGOuNikCDHIPazPT5qLyMM9gcyVE9k38D3_MbBcMXa850xB2OQYApF4dNcLTCDyEafRwEQNFL44\"]],[null,2,[2688,1242],[null,null,\"https://play-lh.googleusercontent.com/39u5I5NI4PJFiAPAOeHPftlN80A7zTMzRom3rfiWP4dhNr7Jtb_8pGh-FNbkTWYncb6kzB_lPLOKhrp47ubYQA\"]],[null,2,[2688,1242],[null,null,\"https://play-lh.googleusercontent.com/BB9DlRVmcsuz9RLjWCVEa-qHt_bYQRf__67KU6T7Dr_LqAraMlQB_iVKBz7LuhQw0fG65I7RgJVYAn_ptyC6l7k\"]],[null,2,[2688,1242],[null,null,\"https://play-lh.googleusercontent.com/RCIVceWmNXBOHY5dUKN9YgZb31L4OW1AUHWeXfj-bf-TH-Cb_RQJRAk4VVZtsrlIIW3Kph8PgaTpg_hRqu30Jg\"]],[null,2,[2688,1242],[null,null,\"https://play-lh.googleusercontent.com/RKAKHEMAZ_R2T41fMuaIT8V8hwTmR_d4YBI47GGRsmOo0YoyF0tAnf8nFrNTqEqCuo6m_aVn02Vd9G8FxJ7Ag4M\"]],[null,2,[2688,1242],[null,null,\"https://play-lh.googleusercontent.com/nHbm0qYTUyNvAGOuNikCDHIPazPT5qLyMM9gcyVE9k38D3_MbBcMXa850xB2OQYApF4dNcLTCDyEafRwEQNFL44\"]],[null,2,[2688,1242],[null,null,\"https://play-lh.googleusercontent.com/39u5I5NI4PJFiAPAOeHPftlN80A7zTMzRom3rfiWP4dhNr7Jtb_8pGh-FNbkTWYncb6kzB_lPLOKhrp47ubYQA\"]]],\"Game Mini Offline-SeaGame\",[\"4,3\",4.3069305],\"Kasual\",null,null,[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dai.seagames.app\\u0026rdid\\u003dai.seagames.app\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dai.seagames.app\"]],[\"qgJcGloIM0oTCKPKxrDHkJcDFSkItwAdcYkOKPoBDAoKCAASBgoCaWQQALoCMQoVCg9haS5zZWFnYW1lcy5hcHAQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],null,[null,\"SeaGame adalah aplikasi game mini kasual untuk hiburan cepat kapan saja dan di mana saja. Nikmati berbagai game offline dan game tanpa Wi-Fi dalam satu aplikasi sederhana, termasuk puzzle, game kartu, balapan, runner, game otak, game blok, game menyortir, tantangan arcade, dan masih banyak lagi.\\u003cbr\\u003e\\u003cbr\\u003eTanpa Wi-Fi? Tidak masalah\\u003cbr\\u003e\\u003cbr\\u003eNikmati game mini tanpa Wi-Fi atau data seluler. SeaGame cocok untuk saat-saat ketika kamu ingin bermain secara offline, baik saat bepergian, dalam perjalanan, menunggu, bersantai di rumah, atau sekadar mencari hiburan singkat.\\u003cbr\\u003e\\u003cbr\\u003eBanyak Game Mini dalam Satu Aplikasi\\u003cbr\\u003e\\u003cbr\\u003eTemukan berbagai jenis game di satu tempat. Mulai dari puzzle dan game otak hingga game kartu, balapan, runner, blok, menyortir, dan arcade kasual. SeaGame memberi kamu lebih banyak pilihan bermain tanpa perlu memasang banyak aplikasi terpisah.\\u003cbr\\u003e\\u003cbr\\u003eMudah Dimulai\\u003cbr\\u003e\\u003cbr\\u003eSeaGame sederhana dan cepat. Buka aplikasi, pilih game, lalu mulai bermain dalam hitungan detik. Kontrolnya mudah dipahami, sehingga cocok untuk mengisi waktu istirahat, bersantai setiap hari, dan menikmati hiburan kasual.\\u003cbr\\u003e\\u003cbr\\u003ePuzzle, Game Otak, Kartu, dan Arcade\\u003cbr\\u003e\\u003cbr\\u003eLatih otak dengan puzzle dan game logika, bersantai dengan game menyortir dan blok, nikmati tantangan bergaya game kartu klasik, atau mainkan game mini yang cepat saat ingin aksi singkat. SeaGame menyatukan berbagai gaya bermain dalam satu aplikasi.\\u003cbr\\u003e\\u003cbr\\u003eRingan dan Praktis\\u003cbr\\u003e\\u003cbr\\u003eSeaGame dibuat untuk pengalaman bermain kasual yang lancar, dengan navigasi sederhana dan koleksi game yang rapi. Game mudah ditemukan, mudah dimainkan, dan siap menemani waktu santaimu kapan saja.\\u003cbr\\u003e\\u003cbr\\u003eMengapa Memilih SeaGame?\\u003cbr\\u003e\\u003cbr\\u003e• Game tanpa Wi-Fi dan game mini offline\\u003cbr\\u003e• Puzzle, kartu, balapan, runner, game otak, blok, dan arcade\\u003cbr\\u003e• Permainan cepat untuk waktu istirahat singkat\\u003cbr\\u003e• Kontrol sederhana untuk pemain kasual\\u003cbr\\u003e• Satu aplikasi dengan banyak pilihan bermain\\u003cbr\\u003e• Cocok untuk bepergian, perjalanan, menunggu, dan bersantai\\u003cbr\\u003e\\u003cbr\\u003eSeaGame memberi kamu cara sederhana untuk menikmati game mini kapan saja. Tidak perlu Wi-Fi. Buka aplikasi, pilih game, lalu mulai bermain.\"],\"Seaart ai\",\"1.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/a392lPKsXs-i8FhHtU2ZWNQqm5jdqtzmeQjNpdeGgop5GwKfuolqRzMESi8QojdswV-6LK1vqsKOvL_BTK9-qQ\"],null,[6,3,92,255]],null,[\"Rating 7+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/1SrNtAwg9PFOhgMJPXehacRTeQNhHhG12Pj1zACHNVmfRfEZA3_oOEmLvRNsmYGeGHpas7sCwyR3y8OT\"]],[null,\"Kekerasan Tersirat\"],null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003ePelajari lebih lanjut\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/JTT-ImEkrbWzIL7w0fP8fQhVmpexdfh7u0P59PJtyJywmQBVolJjunMal6B5dUM6uiFiKnmtHtBbVvcWBMU\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dai.seagames.app\\u0026rdid\\u003dai.seagames.app\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Instal\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,