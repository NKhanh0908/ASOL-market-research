PW7QQQ8xKXrnP1-TM5pGX1G7u9GuOtQUge_gaaM53NzkZ7OxVY9X\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/uI8qMjik7-PfqhN93fkG8fb1kd9yIp9MNBHuD0uQfkyMylQ51BJFqr69m6wgRfx2j0kuADvBQrNXjruH5EflyjU\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/U5COMo5RWknI4rVCvuTKZJHk5OIfAZnpRDlweGQjV5-CKfpnBbW1KL0mlNMCodfMHJCoFNvovuV7xJ19YGp1\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/SKCfNfxAsG-wEr3mnGBNGEdt77HOnGZpU60v2HSpZHaRO8GnhM_rAzx6ar2IxN-4C_sz8j8lPC2-nINPhaz6NQ\"]]],\"Doll Dress Up: Fashion Star\",[\"4,5\",4.513889],\"Kasual\",null,null,[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.fashion.dress.up\\u0026rdid\\u003dcom.fashion.dress.up\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.fashion.dress.up\"]],[\"qgJhGl8IBkoTCKPKxrDHkJcDFSkItwAdcYkOKPoBDAoKCAASBgoCaWQQAboCNgoaChRjb20uZmFzaGlvbi5kcmVzcy51cBABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"Welcome to Doll Dress Up: Fashion Star, the ultimate fashion playground where your creativity knows no bounds! Design, collect, and battle with your dream dolls in a world of endless style possibilities.\\u003cbr\\u003e\\u003cbr\\u003e✨ UNLIMITED DRESS UP\\u003cbr\\u003eNo limits, just pure fashion! Customize your dolls from scratch. Select different genders, diverse skin tones, glamorous makeup, and hundreds of clothing concepts. Style without boundaries and build a magnificent collection of unique dolls.\\u003cbr\\u003e\\u003cbr\\u003e🎯 CHOOSE LEFT OR RIGHT: THE STYLE DUEL!\\u003cbr\\u003ePut your style instincts to the test in our signature fashion battle! Go head-to-head against other players, let the system score your look, and see who claims the title of Style Queen or King!\\u003cbr\\u003e\\u003cbr\\u003e🚀Features:\\u003cbr\\u003e• No limits: Total freedom over gender, skin, and makeup 💄\\u003cbr\\u003e• Fun Left or Right decision-making gameplay 💖\\u003cbr\\u003e• A vast collection of styles to unlock and master 👗\\u003cbr\\u003e• Exciting automated scoring system to crown the winner 🏆\\u003cbr\\u003e\\u003cbr\\u003eDownload now and win the duel!\"],\"CozyTap Studio\",\"10.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/VIHqAFmPoTSePQe9WorqXrvh81sfN9-C8pVeyTREqDV2Tk9hjAGkUBQN0tB50L6lh0cYIb8_FfUpO9C9QmnE\"],null,[247,179,235,255]],null,[\"Rating 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003ePelajari lebih lanjut\\u003c/a\\u003e\"],true,[null,\"Cocok untuk semua kelompok usia. Beberapa kekerasan dalam konteks komikal atau fantasi dapat diterima. Bahasa kasar tidak diizinkan.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.fashion.dress.up\\u0026rdid\\u003dcom.fashion.dress.up\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Instal\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Kasual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]