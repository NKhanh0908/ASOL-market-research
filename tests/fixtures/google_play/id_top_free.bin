242],[null,null,\"https://play-lh.googleusercontent.com/FsB39z4ryEPZRT7GagZ-WFQz0I0vfC-hiLrkvuDFpKxNCQSBPeFV8F6xNIZdIL-IP1vdeUy8uItH5JnOi2Ala8o\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/u8jM7fBz6BLhVwV-IV0jQkrqiGGbJEMsTh4xmX6rKB5aIRfhkgvJTkXU7Rccl-TnFOks2Pnue7w_XL1Fu1J_bA\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/TXlD_FKSNwEW4iQQC1k6Fod_j-VIWfVhRfeLeg1YJO9MSdnRLHOahzDvYnkyoFuzxynSF8Kw8-Z7L18wTmO5\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/flokQ1tuz_oTfS-kVDfZMb8tkIqu5cuZDcB05aGavqkljjhXGqfFPfzE-kanRWGS5YfPJJEdrkweojKjf5-JDg\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/o8t3sxQguVVHQsZgwjI8DmdYRBw6SilfegkLi8rxjX0Q9-nemI85YC0i9KEKNT-Eyy9YAtf5SnGZQC_rodFJIjQ\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/M5QBeWWReBgcdiM1HPSZyKCmW51Fyi4OVBLJYvmfsHufHeKTg2pBtA2mbNJ4x4JGmri_iOaFoBDwOUr2gr9G6w\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/LhfGb60Qtr64GhSs8FYWZiIcStEyZyUoy6WXqqpMNduI1yKWrpP4ZUJRQx2IHlllCuYIBxB3FMScv_NnaIEU2w\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/-Skb0sViYX4AMEY33kSdK2nRw2vAaSAtaYQRm1FT8uFPwOV9Ks4ZOGPpi-xSjeR1llbFJSCmne-PTkFeRhuZ\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/FsB39z4ryEPZRT7GagZ-WFQz0I0vfC-hiLrkvuDFpKxNCQSBPeFV8F6xNIZdIL-IP1vdeUy8uItH5JnOi2Ala8o\"]]],\"My Talking Angela 2\",[\"4,5\",4.5282564],\"Kasual\",null,null,[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.outfit7.mytalkingangela2\\u0026rdid\\u003dcom.outfit7.mytalkingangela2\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.outfit7.mytalkingangela2\"]],[\"qgJpGmcIFEoTCKPKxrDHkJcDFSkItwAdcYkOKPoBDAoKCAASBgoCaWQQAboCPgoiChxjb20ub3V0Zml0Ny5teXRhbGtpbmdhbmdlbGEyEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"My Talking Angela 2 is the ultimate virtual pet game that brings fun, fashion, and creativity to your everyday life. Step into the big city with the stylish Angela and embark on a journey filled with exciting activities and endless entertainment in the Talking Tom \\u0026amp; Friends universe!\\u003cbr\\u003e\\u003cbr\\u003eKey Features:\\u003cbr\\u003e\\u003cbr\\u003e- Stylish Hair, Makeup, and Fashion Choices: Transform Angela with various hairstyles, makeup options, and fashionable outfits. Dress her up for fashion shows and personalize her look to make her shine like a star.\\u003cbr\\u003e\\u003cbr\\u003e- Exciting Activities: Engage in a variety of fun activities, including dancing, baking, martial arts, trampoline jumping, jewelry making, and planting flowers on the balcony.\\u003cbr\\u003e\\u003cbr\\u003e- Delicious Food and Snacks: Bake and cook delicious treats for Angela. From cakes to cookies, satisfy her sweet tooth with your culinary skills.\\u003cbr\\u003e\\u003cbr\\u003e- Travel Adventures: Take Angela on jet-setting travel adventures to explore new destinations and cultures. And to shop until she drops!\\u003cbr\\u003e\\u003cbr\\u003e- Mini-Games and Puzzles: Challenge your skills with fun mini-games and puzzles that test your reflexes and strategic thinking.\\u003cbr\\u003e\\u003cbr\\u003e- Sticker Collections: Collect and complete sticker albums to unlock special rewards and new content. \\u003cbr\\u003e\\u003cbr\\u003eExpress Your Creativity: Angela inspires you to be creative, bold, and expressive. Design her outfits, experiment with makeup, and decorate her home to reflect your unique style.\\u003cbr\\u003e\\u003cbr\\u003eFrom Outfit7, creators of the hit games My Talking Tom, My Talking Tom 2 and My Talking Tom Friends.\\u003cbr\\u003e\\u003cbr\\u003eThis app contains:\\u003cbr\\u003e- Promotion of Outfit7\\u0026#39;s products and advertising;\\u003cbr\\u003e- Links that direct customers to Outfit7’s websites and other apps;\\u003cbr\\u003e- Personalization of content to encourage users to play the app again;\\u003cbr\\u003e- The option to make in-app purchases;\\u003cbr\\u003e- Subscriptions, which are auto-renewable, unless cancelled before the end of the current subscription period. You can manage and cancel a subscription in your Google Play Account settings after purchase.\\u003cbr\\u003e- Some features may be subject to different pricing and availability.\\u003cbr\\u003e- Items to purchase (available in different prices) using virtual currency, depending on the player’s progress;\\u003cbr\\u003e- Alternative options to access all functionalities of the app without making any in-app purchases using real money.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003eTerms of use: https://talkingtomandfriends.com/eula/en/\\u003cbr\\u003eCustomer support: support@outfit7.com\\u003cbr\\u003ePrivacy policy: https://talkingtomandfriends.com/privacy-policy-games/en\"],\"Outfit7 Limited\",\"500.000.000+\",null,null,null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/uRSAhuxCcQyMRnbbYAUyApTUKAw-E793Nt65rhsxxykaK2xMMTSlK0ta4umPik-8RDqojHmZmh97G0hU1OBTUQ\"],null,[149,99,180,255]],null,[\"Rating 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Pembelian Dalam Game\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003ePelajari lebih lanjut\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.outfit7.mytalkingangela2\\u0026rdid\\u003dcom.outfit7.mytalkingangela2\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Instal\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"Rp 16.000 - Rp 1.602.071 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Kasual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.terraform.popodyssey\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/hiIJXRInGWwJBTpz0aCWGQl_JwObxX2Kqg5zxJHumH3k2TcMzUuXJs_rxnDRrUOC1F7ABWLpRDa7al4VAzTgkg\"],null,[241,240,243,255],null,null,null,2],[[null,2,[3840,2160],[null,null,\"https://play-lh.googleusercontent.com/ElV7ZDDpZYG6sE04FlrYbuYziLiBsctSXiEWPdUFQjyBD1bo8R74YLoUI9WxjO0hgHYw3_d_n3HLfvz-V23x\"]],[null,2,[3840,2160],[null,null,\"https://play-lh.googleusercontent.com/yM1WjwLjwfI1fhjmec1tCkL3a0CjF_ckMpEpcdDJmQDSlOUsgVGYu6PUEUobEhBYU7wKCpOaz6EruqMrHohd23E\"]],[null,2,[3840,2160],[null,null,\"https://play-lh.googleusercontent.com/1fkCpzo0-f7MfUMZqWPywIOwo0PcWZslUjD2T5y_uzlo9NDq3F5e9U8ifgATPzFxXeSRZND6hgHEy_HGXu7_HQ\"]]],\"Pop Odyssey\",[\"4,8\",4.8439307],\"Kasual\",null,null,[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.terraform.popodyssey\\u0026rdid\\u003dcom.terraform.popodyssey\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.terraform.popodyssey\"]],[\"qgJlGmMIFUoTCKPKxrDHkJcDFSkItwAdcYkOKPoBDAoKCAASBgoCaWQQALoCOgoeChhjb20udGVycmFmb3JtLnBvcG9keXNzZXkQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],null,[null,\"Mulailah perjalanan puzzle penuh warna di Pop Odysse!\\u003cbr\\u003e\\u003cbr\\u003eKetuk kelompok balok dengan warna yang sama, selesaikan target setiap level, dan bersihkan papan sebelum langkahmu habis. Setiap level menghadirkan susunan baru, rintangan berbeda, serta kombinasi ledakan seru untuk ditemukan.\\u003cbr\\u003e\\u003cbr\\u003eCiptakan booster kuat dengan menghancurkan kelompok balok yang lebih besar. Luncurkan roket, ledakkan bom, dan gabungkan elemen khusus untuk menghasilkan reaksi berantai yang spektakuler. Saat level terasa sulit, gunakan booster dan alat bantu untuk mengatasi rintangan dan melanjutkan petualanganmu.\\u003cbr\\u003e\\u003cbr\\u003eFITUR\\u003cbr\\u003e\\u003cbr\\u003e• Gameplay menghancurkan balok yang sederhana dan memuaskan\\u003cbr\\u003e• Level penuh warna dengan beragam target dan rintangan\\u003cbr\\u003e• Roket, bom, dan kombinasi khusus yang kuat\\u003cbr\\u003e• Booster dan alat bantu yang berguna saat menghadapi tantangan\\u003cbr\\u003e• Reaksi berantai yang memuaskan dan efek visual yang hidup\\u003cbr\\u003e• Mudah dipelajari, dengan puzzle yang semakin membutuhkan strategi\\u003cbr\\u003e• Jelajahi koleksi level yang terus bertambah dan dirancang secara khusus\\u003cbr\\u003e• Bermain dengan santai kapan pun kamu mau\\u003cbr\\u003e\\u003cbr\\u003eBerpikirlah dengan cermat, pilih balok yang tepat, dan manfaatkan setiap langkah sebaik mungkin. Ledakan yang direncanakan dengan baik dapat menghancurkan rintangan, mengaktifkan booster, dan mengubah papan yang sulit menjadi kemenangan spektakuler.\\u003cbr\\u003e\\u003cbr\\u003eBaik untuk mengisi waktu dengan puzzle singkat maupun menikmati sesi menghancurkan balok yang lebih lama, Pop Odysse menawarkan pengalaman yang santai dan memuaskan bagi para penggemar puzzle.\\u003cbr\\u003e\\u003cbr\\u003eMulailah petualangan penuh warnamu dan lihat berapa banyak level yang bisa kamu selesaikan!\"],\"Bigiku.com\",\"100.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/TQmjXtPUq8qhEucx9D6571O5WWUxLWu2QmpgYY253EV7C4i6L_s1u-tWhEsXwj9J9pcAGWF-Bt_JLEebdkMOn0A\"],null,[122,152,246,255]],null,[\"Rating 18+\",[null,2,[366,512],[null,null,\"https://play-lh.googleusercontent.com/QNpsl4k43vdbfwUAlVLZul2W5O5MUGOToystzghc97mljVHbUwtc639tahcuDsAVHdaGMyZA40AmMVcB_ws\"]],[null,\"Reward Uang Tunai\"],null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003ePelajari lebih lanjut\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/stIOCymv1bYIi3UU_owFeyNt30CkUXbNlDj81ZWtjW9NBIMJxI47i_psYIr0Ho430Rm6mByCGNLORloB\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.terraform.popodyssey\\u0026rdid\\u003dcom.terraform.popodyssey\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Instal\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Kasual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.tvf.anti.stress.relaxing.mini.games\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/4KWBPssWM4-LSzSPcF04LMho2fPCQY1Z20Wzvmi6jF9JlApKfw8Td1GNUdaEax8wEP8sTI0WvcsnxGVBK9Xhuw\"],null,[159,103,61,255],null,null,null,2],[[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/sBKL14ZgAx6L3JGgnYbFlmeUJCwsfa0-QC8vDWjMoVPSpDugAv3T5lhnhQwXA2dFFTndgJtVXHP-H-Ry8Ex0\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/JIwhBphwEVoKkb0VUXWo547GUXyhBRlP8dq3ZrzpQXjvZ2Dm18T4VI__6gs_mDmiqQPiEx