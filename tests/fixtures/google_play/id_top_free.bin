iH5gjlBiHfbjvKQTJ1v02cI1BlpV8mVhfUOQgICykRjnRCA6eJsA8ic8qPw\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/NldFfMrP-IELE3p3SC_eIZphhGhl-C0ADXle7gGks4bw02ksimmIim3RywKxAmbpn2Qf2rX_8hIxpbKn9Ue2\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/OtuQxaendmORpsNCahiZK_CS8NxHGVVIQWz5l-zmIh0rhXW9FJJjFQi3bkHkLR7QWetaltWKbsR3WTHDYjMN\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/YKG7FxKxgzPDuZ3a5DhFp83YPCZey3DzP3JJHIDuU06EMOCfjjyE9VPJrxvkDNU09BCjN6H3DcCyd-FOxAHl\"]]],\"Stylish Room: Home Decor\",[\"4,8\",4.824786],\"Kasual\",null,null,[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003droom.house.design.home.organize.decor\\u0026rdid\\u003droom.house.design.home.organize.decor\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003droom.house.design.home.organize.decor\"]],[\"qgJyGnAIY0oTCKPKxrDHkJcDFSkItwAdcYkOKPoBDAoKCAASBgoCaWQQALoCRworCiVyb29tLmhvdXNlLmRlc2lnbi5ob21lLm9yZ2FuaXplLmRlY29yEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"Masuki Stylish Room: Petualangan Santai menghias rumah Menantimu! 🏠🎉\\u003cbr\\u003eSelamat datang di Stylish Room, permainan kasual untuk pencinta design home dan kegiatan mendekor rumah. Ubah kekacauan jadi ruang teratur melalui pengalaman design home yang kreatif dan relaks. Sangat pas bagi penikmat mendekor rumah santai, game ini menawarkan kesenangan peran sebagai house designer langsung di genggamanmu. 🌟\\u003cbr\\u003e\\u003cbr\\u003eCara Main design home:\\u003cbr\\u003e- Atur Barang 📦: Masuk ke dunia kekacauan seru saat unpacking, penuh benda yang butuh keterampilan menghias rumah dari Anda. Tempatkan tiap benda di spot ideal untuk menciptakan harmoni layaknya house designer sejati di sesi unpacking decor ini.\\u003cbr\\u003e- Seret \\u0026amp; Taruh 🎯: Interface drag-drop sederhana memudahkan Anda mengatur barang dalam setiap level unpacking decor. Fokuslah membuat tata letak design home yang menarik saat asyik bermain unpacking.\\u003cbr\\u003e- Buka Cerita 📜: Saat melakukan unpacking, temukan kisah memikat dalam perjalanan Anda sebagai house designer. Tiap level hadirkan cerita baru terkait menghias rumah dan serunya unpacking decor.\\u003cbr\\u003e\\u003cbr\\u003eFitur Permainan mendekor rumah:\\u003cbr\\u003e- Relaksasi Bebas Stres 🎈: Gameplay santai untuk melepas penat. Nikmati ritme memoles ruang dalam dunia design home saat menyortir dan unpacking. Keseruan unpacking decor ini sungguh menenangkan hati.\\u003cbr\\u003e- Detil Maksimal ✨: Setiap detail saat menghias rumah akan mempercantik ruang Anda. Pelatihan insting seorang house designer menyoroti kesenangan presisi dalam mendekor rumah.\\u003cbr\\u003e- Ekspresi Kreatif 🎨: Eksplor elemen baru di unpacking decor sambil maju, buka pintu kreativitas tak terbatas layaknya house designer profesional. Personalisasi tiap ruang dengan gaya menghias rumah unikmu sendiri.\\u003cbr\\u003e\\u003cbr\\u003eStylish Room hadirkan sentuhan menyenangkan untuk design home, memadukan relaksasi dengan keseruan santai. Baik Anda house designer berpengalaman atau sekadar suka mendekor rumah di waktu luang, tak ada tekanan—hanya ada kesenangan.\\u003cbr\\u003eBergabunglah dengan komunitas Stylish Room! Unduh sekarang untuk merasakan dunia ajaib design home dan rasakan kegiatan unpacking decor yang memikat. Ubah sudut berantakan jadi karya pribadi yang memukau melalui asyiknya unpacking! 🖼️🌻\"],\"Gloryway Puzzle\",\"1.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/rGMvoMOIz3rJVcJrp9bUfboDXw-mo3laDx8SE7jRIcKKvIFWLLLaRuXHm1DFoDvHYc4zHLDv21Q4y4efySnekA\"],null,[254,226,153,255]],null,[\"Rating 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm