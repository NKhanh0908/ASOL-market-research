003eClear the stage once you help all dragons escape the puzzle area.\\u003cbr\\u003eAs you progress through levels, layouts grow more complex, paths become tighter, and the dragons’ routes will overlap with one another.\"],\"arlon studio\",\"1.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/DltQyIkDM2un3rTiliy-uu7fIag2jxzQxb_NUygvnIVL9tQA3Ehvq_-gc3UPiquk9uZRekea-mrx3F0RxLhUng\"],null,[254,250,226,255]],null,[\"Rating 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003ePelajari lebih lanjut\\u003c/a\\u003e\"],true,[null,\"Cocok untuk semua kelompok usia. Beberapa kekerasan dalam konteks komikal atau fantasi dapat diterima. Bahasa kasar tidak diizinkan.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.arlonstudio.dragon\\u0026rdid\\u003dcom.arlonstudio.dragon\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Instal\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Kasual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.qrgame.puzzlefarm\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/y8kTP1MlKEMRgjGP6ocfx