cX6JIEZiH77yXRtscJzfevG2KokrEjmyr_fibY_fgpzb1d3qIeQUJpYN3FUY9E\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/Q2CKyauYnEdqyoHqpLJd7XS0cZeu1e-1N06aqltWYhfqGtsIPnihkUqd9Z9VbyQZRS0WOUCiXupdSAiA45vkvg\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/NjFciZsBXsptVMzlpmHT1e1WzqidBBQJWhoLS2nuKRav6JmhMZbrI8g7ZoQ2QZOmJoEOH4-Xo8s0WMMNKT8z\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/1D-K6d4hNoR1x9DY96geF91UIJ4dy_UcNfMf6c6li_RwHYe92mExgDaXr5YyyIMUVpCjoFxYu4Uikotph2E-WA\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/OxcG_zvnmHnkMJe2atEhxNcWneL4jqSMqlsSqq1JtK24UL7Ont3aQ1zhPBabNRQj_bM-Uy0GqDlhs2sr2boD\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/cQdCjs4CawuNvYvu9u7-W0-9Pj8LHIIBwsSjZc_hx7H5iMo8BbZNQtzj7m8op9Po6Ekm3MXntTzbu3YDsUqleQ\"]]],\"Idle Cat Gunner: Shooter RPG\",[\"4,7\",4.7058825],\"Kasual\",null,null,[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.Chodun.CatGunner\\u0026rdid\\u003dcom.Chodun.CatGunner\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.Chodun.CatGunner\"]],[\"qgJhGl8IUUoTCKPKxrDHkJcDFSkItwAdcYkOKPoBDAoKCAASBgoCaWQQALoCNgoaChRjb20uQ2hvZHVuLkNhdEd1bm5lchABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,null,[null,null,\"https://www.youtube.com/watch?v\\u003dom7pvunb_1I\"]],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/om7pvunb_1I/hqdefault.jpg\"]]]],[null,\"\\u0026quot;🐱 Cakar kecil, senjata besar?! RPG shooter idle paling imut telah tiba!\\u003cbr\\u003e\\u003cbr\\u003eBagaimana jika kucing lucu dan berbulu bertualang dengan senjata raksasa?\\u003cbr\\u003eLedakan kelucuan + daya tembak yang mendebarkan + game menembak yang adiktif!\\u003cbr\\u003eBuat pasukan kucingmu sendiri sekarang juga!\\u003cbr\\u003e\\u003cbr\\u003ePertempuran otomatis yang berburu bahkan saat kamu tidak ada!\\u003cbr\\u003eDalam perjalanan ke tempat kerja, di kafe, atau saat istirahat sejenak, kucing kita terus menjadi lebih kuat~\\u003cbr\\u003e\\u003cbr\\u003e■ Fitur Game\\u003cbr\\u003e\\u003cbr\\u003e▶ Koleksi lebih dari 25 kucing yang menawan\\u003cbr\\u003eKucing penembak jitu, kucing senapan, kucing minigun... Karakter dengan pesonanya masing-masing!\\u003cbr\\u003eKelucuan + kemampuan + kepribadian dalam game idle sejati!\\u003cbr\\u003eBuat pasukan pamungkasmu!\\u003cbr\\u003e\\u003cbr\\u003e▶ Koleksi lebih dari 35 senjata spektakuler - sensasi menembak yang sesungguhnya\\u003cbr\\u003ePistol, senapan, senapan gantung, senapan mesin! RPG penembak dengan berbagai senjata.\\u003cbr\\u003eDor! Dor! Katarsis pertempuran otomatis dengan suara tembakan yang mendebarkan!\\u003cbr\\u003eKontras antara penampilan imut dan daya tembak yang luar biasa!\\u003cbr\\u003e\\u003cbr\\u003e▶ Sistem sintesis senjata - inti kesenangan dari game idle\\u003cbr\\u003eGabungkan senjata yang sama untuk meningkatkannya menjadi senjata yang lebih kuat!\\u003cbr\\u003eSensasi pada saat sintesis... Ini adalah kesenangan sejati dari RPG idle!\\u003cbr\\u003eKamu tidak bisa berhenti pada daya tembak yang semakin kuat!\\u003cbr\\u003e\\u003cbr\\u003e▶ Sistem kelahiran kembali - standar pertumbuhan tak terbatas\\u003cbr\\u003eCapai tahap tertentu dan dapatkan kemampuan yang lebih kuat melalui kelahiran kembali!\\u003cbr\\u003eSistem yang sangat adiktif yang menjadi lebih kuat secara eksplosif dengan setiap kelahiran kembali!\\u003cbr\\u003eDengan hadiah offline, kucing tumbuh dengan rajin bahkan saat kamu tidur~\\u003cbr\\u003e\\u003cbr\\u003e▶ Eksplorasi berbagai peta - petualangan tanpa akhir\\u003cbr\\u003eHutan, gurun, padang salju... Petualangan seru di berbagai lingkungan!\\u003cbr\\u003eSemakin jauh kamu melangkah, tantangan yang lebih besar dan hadiah yang lebih kaya menantimu!\\u003cbr\\u003e\\u003cbr\\u003e■ Orang-orang ini pasti harus mengunduhnya!\\u003cbr\\u003e\\u003cbr\\u003e✔ Semua pecinta kucing yang menyukai kucing lucu\\u003cbr\\u003e✔ Mereka yang menikmati game idle dan game pengembangan\\u003cbr\\u003e✔ Mereka yang menginginkan sensasi mendebarkan dari game menembak\\u003cbr\\u003e✔ Mereka yang mencari game kasual untuk perjalanan atau waktu luang\\u003cbr\\u003e✔ Mereka yang menginginkan game seluler yang dapat dimainkan dengan nyaman dengan satu tangan\\u003cbr\\u003e✔ Mereka yang menyukai RPG idle dengan pertempuran otomatis dan hadiah offline\\u003cbr\\u003e✔ Mereka yang rasa ingin tahunya meledak dengan kombinasi \\u0026quot;\\u0026quot;Kucing + Senjata\\u0026quot;\\u0026quot;\\u003cbr\\u003e\\u003cbr\\u003eKucing lucu dengan senjata menunggumu!\\u003cbr\\u003eUnduh sekarang juga dan masuki dunia baru RPG penembak! 🎮🐱🔫\\u003cbr\\u003e\\u003cbr\\u003e-----\\u003cbr\\u003e📩 Dukungan: support@neptunecompany.kr\\u003cbr\\u003e📄 Syarat Layanan: https://neptunecompany.kr/gameterms\\u003cbr\\u003e🔒 Kebijakan Privasi: https://neptunecompany.kr/gameprivacy\\u003cbr\\u003e🔒 Indonesia Games Rating System (IGRS) Rating: 3+\\u0026quot;\"],\"NEPTUNE(TREEPLLA)\",\"1.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/1jFVH1ucrVd2ljIga96EmrnmuMiNHdGRJ2f03kj47KTtRdXVICiHZqz5bvCqsQCgRqsk5Mq4bGb6LuQqUloR\"],null,[109,129,63,255]],null,[\"Rating 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003ePelajari lebih lanjut\\u003c/a\\u003e\"],true,[null,\"Cocok untuk semua kelompok usia. Beberapa kekerasan dalam konteks komikal atau fantasi dapat diterima. Bahasa kasar tidak diizinkan.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6