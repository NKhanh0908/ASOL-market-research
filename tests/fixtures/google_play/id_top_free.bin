eusercontent.com/VTWnWjxs-bnL-9NQAyFUSCNHssnGTKhCnxlWjiFn68arroRq_yPIihQdGHwDp5oYDjaGBJZMetuphs4-AzZz\"]]],\"Hole.io\",[\"3,5\",3.4924994],\"Kasual\",null,null,[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dio.voodoo.holeio\\u0026rdid\\u003dio.voodoo.holeio\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dio.voodoo.holeio\"]],[\"qgJdGlsICkoTCKPKxrDHkJcDFSkItwAdcYkOKPoBDAoKCAASBgoCaWQQALoCMgoWChBpby52b29kb28uaG9sZWlvEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],[[[null,null,\"3pu8nD2q5IE\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:3pu8nD2q5IE?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:3pu8nD2q5IE\",null,null,null,null,\"AXH1ezkYTSbqYTlPHwUyDyVfCP1cOS4uPhn8SrPkmztrpe5PR7iKGvF4tZci7k3RG8hOmmD5amWi0V-5SaLASkDyUNvPaLrglbV81rE2RBGUlViDxlWS63omgJcCvLvJ1V9B_BxIkfd5fkPowjTW0Euy4U4gg54Gu4cfDFmVXEohVzfxz8xP5LqzbJgsPwSVnuQ9RD9cdQuQtopFMe0F4q31xaiSa8lnhDEHy6lBO5cFW7zlWM_k0ipEvOTmlmBmJQr_iezKiYCmZzZnEaxQLkhYAojmk7qERNOcYyDyL07YXiglug\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/3pu8nD2q5IE/hqdefault.jpg\"]]]],[null,\"Selamat datang di Hole.io, game melahap dunia yang sangat memuaskan dan dimainkan oleh jutaan orang! Masuklah ke New York yang sibuk, teluk bajak laut yang mencekam, atau metropolis fiksi ilmiah yang bersinar - dan telan semuanya bulat-bulat. Mobil, tiang lampu, hot dog, bahkan gedung pencakar langit raksasa! 🏙️🏴\\u200d☠️🚀\\u003cbr\\u003e\\u003cbr\\u003eBaik Anda punya waktu lima menit saat menonton acara favorit atau satu jam untuk bersantai sebelum tidur, hanya ketuk, geser, dan saksikan kota runtuh ke dalam lubang hitam. Tanpa tekanan, tanpa stres - hanya kesenangan murni yang menenangkan saat melahap semua yang terlihat. 😌\\u003cbr\\u003e\\u003cbr\\u003e🍔 MAKAN SEMUANYA\\u003cbr\\u003eMulai dari ukuran kecil, hampir tidak cukup besar untuk menelan tempat sampah. Tumbuh menjadi raksasa, cukup besar untuk melahap gedung pencakar langit dalam sekali gigit. Semakin besar ukuran Anda, semakin keras suara hancurnya. Kepuasan murni. 🌆\\u003cbr\\u003e\\u003cbr\\u003e😌 ISTIRAHAT YANG SEMPURNA\\u003cbr\\u003eMudah dipelajari, langsung memuaskan. Mainkan di sela-sela waktu luang: kopi pagi ☕, istirahat makan siang 🥪, waktu bersantai di malam hari 🌙. Game santai yang menenangkan untuk pemain kasual.\\u003cbr\\u003e\\u003cbr\\u003e✨ MENGAPA ANDA AKAN MENYUKAINYA\\u003cbr\\u003e• Kontrol yang sangat mudah - hanya geser dan meluncur.\\u003cbr\\u003e• Gameplay yang sangat memuaskan - telan, hancurkan, dan bersih peta.\\u003cbr\\u003e• Dunia 3D yang indah, dinamis, dan penuh detail.\\u003cbr\\u003e• Gratis dimainkan, gampang disukai.\\u003cbr\\u003e\\u003cbr\\u003e🕳️ Siap menelan dunia? Unduh Hole.io sekarang dan cari tahu mengapa jutaan pemain tidak bisa berhenti memainkannya. Waktunya memberi makan lubang hitam. 😋\"],\"VOODOO\",\"100.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/cGXxPboiwvp6F7LPPGQxDyUbrUL2_PbSAZnj3erVs9QpdRCpqWYz-LZBbBoBb2Tbg8Yh0R6Z7Ujr84BaJXHC\"],null,[239,182,132,255]],null,[\"Rating 7+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/1SrNtAwg9PFOhgMJPXehacRTeQNhHhG12Pj1zACHNVmfRfEZA3_oOEmLvRNsmYGeGHpas7sCwyR3y8OT\"]],[null,\"Kekerasan Tersirat\"],[null,\"Pembelian Dalam Game\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003ePelajari lebih lanjut\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/JTT-ImEkrbWzIL7w0fP8fQhVmpexdfh7u0P59PJtyJywmQBVolJjunMal6B5dUM6uiFiKnmtHtBbVvcWBMU\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,n