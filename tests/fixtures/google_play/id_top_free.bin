y-lh.googleusercontent.com/UybpQGMELA4IzELj8K-W-dtRy7hzegLrSPNONetFWpzijemjcwJOo8BzwF0qubNT-TGxwEZZYfuPDMG8wTnl7w\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/42jsymEjdKhKuMZEcpvEvKaLObiv367C4HDFBPF_ItGEIfHv1Hlht9fTM0QiA2T7mEu2Ky4V0qK_bJtNjt2R6Eg\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/IQfLbS5pkS8NScjr0NYdRB4LMnLXll7gqTKBQY5eLNl1IsY6GYw4GZtXXJnAkxnLtkg7a5A0NtltFe4pba2RGUI\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/bV2cAC305V3P9grWuwBbM22h5IgYzs_6LJuD5C4urjafHxi6TPq4l5YIL0z2mHhSrK6UrAbgLsyhlOpnXAytRw\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/VeDRI9xLsoj-ga618pbmg5NlJ36C312RMH55Ul3VlZ0SNtV_ezIkKBCpzQk1m3LQ_LAItL3ZXQiI1k-fQEXt\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/UybpQGMELA4IzELj8K-W-dtRy7hzegLrSPNONetFWpzijemjcwJOo8BzwF0qubNT-TGxwEZZYfuPDMG8wTnl7w\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/42jsymEjdKhKuMZEcpvEvKaLObiv367C4HDFBPF_ItGEIfHv1Hlht9fTM0QiA2T7mEu2Ky4V0qK_bJtNjt2R6Eg\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/IQfLbS5pkS8NScjr0NYdRB4LMnLXll7gqTKBQY5eLNl1IsY6GYw4GZtXXJnAkxnLtkg7a5A0NtltFe4pba2RGUI\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/bV2cAC305V3P9grWuwBbM22h5IgYzs_6LJuD5C4urjafHxi6TPq4l5YIL0z2mHhSrK6UrAbgLsyhlOpnXAytRw\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/VeDRI9xLsoj-ga618pbmg5NlJ36C312RMH55Ul3VlZ0SNtV_ezIkKBCpzQk1m3LQ_LAItL3ZXQiI1k-fQEXt\"]]],\"Mini Block Craft\",[\"4,2\",4.1666064],\"Kasual\",null,null,[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dmini.block.craft.free.mc\\u0026rdid\\u003dmini.block.craft.free.mc\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dmini.block.craft.free.mc\"]],[\"qgJlGmMIXUoTCKPKxrDHkJcDFSkItwAdcYkOKPoBDAoKCAASBgoCaWQQAboCOgoeChhtaW5pLmJsb2NrLmNyYWZ0LmZyZWUubWMQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],null,[null,\"Mini Block Craft. Creative and Survival in sandbox block world! \\u003cbr\\u003e\\u003cbr\\u003eIn this pixel style sandbox openworld block game. You can create whatever you want!\\u003cbr\\u003eTurn blocks into building materials and create your dream house, or go explore the map and fight dangerous monsters and zombies. Craft, build and explore an amazing living world! \\u003cbr\\u003e\\u003cbr\\u003eExplore territories, accumulate and use resources for the development of your possessions.\\u003cbr\\u003eMini Block Craft game: best simulator is not an official Mojang application. This game is not associated or connected with Minecraft Pocket Edition. Minecraft is a trademark of Mojang and it is not endorsed by or affiliated with this game\\u0026#39;s creator or its licensors.\\u003cbr\\u003e\\u003cbr\\u003e## What\\u0026#39;s New (90.5.121.mc)\\u003cbr\\u003eNEW: Cherry Blossom Trees - plant pink petals, cherry wood, and matching planks to create your own kawaii world.\\u003cbr\\u003e\\u003cbr\\u003eNEW: Glowing Blocks - light up your nights with luminous crystals, glowstone, and 7-color glow glass (transparent and opaque) for cyberpunk builds.\\u003cbr\\u003e\\u003cbr\\u003eNEW: Built-in Skin Editor - design your own character pixel by pixel, share your designs as images right from the game.\\u003cbr\\u003e\\u003cbr\\u003eMULTIPLAYER IS HERE! The #1 requested feature - play with friends on Wi-Fi, up to 4 players. No accounts, no servers.\\u003cbr\\u003e\\u003cbr\\u003eNEW: AI Building Assistant - chat to build anything, from castles to circuits.\\u003cbr\\u003e          The smartest building companion on any mobile block game.\\u003cbr\\u003e          - Chat with an AI that understands your world\\u003cbr\\u003e          - Say \\u0026quot;build me a castle\\u0026quot; and watch it appear block by block\\u003cbr\\u003e          - AI places blocks, wires circuits, spawns entities, and more\\u003cbr\\u003e          - Works with Claude, Ollama, or any OpenAI-compatible model\\u003cbr\\u003e          - Hands-free building, the future of sandbox games\\u003cbr\\u003e\\u003cbr\\u003eNEW: HD Replay Export - record your builds and share them on TikTok, YouTube Shorts, Instagram Reels.\\u003cbr\\u003e\\u003cbr\\u003eNEW: Circuit System 2.0 - new electric components, smarter wiring.\\u003cbr\\u003e\\u003cbr\\u003eNEW: MAP MARKET - SHARE AND DISCOVER\\u003cbr\\u003e           - Upload your best worlds for everyone to play\\u003cbr\\u003e           - Browse and download community and official maps\\u003cbr\\u003e           - Rate, review, and comment on shared creations\\u003cbr\\u003e           - Import worlds from other sandbox building games\\u003cbr\\u003e\\u003cbr\\u003eNEW: Performance and stability improvements across the board.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003e**Real World Maps**\\u003cbr\\u003eTurn the real world into your playground! Generate playable worlds from real-world map data and explore real cities, landmarks, and neighborhoods — then build, mine, and reshape them however you like.\\u003cbr\\u003e\\u003cbr\\u003e**Better Multiplayer**\\u003cbr\\u003eWe\\u0026#39;ve rebuilt key parts of our multiplayer system for speed and reliability. Enjoy faster connections, smoother gameplay, and rock-solid stability when playing with friends online.\\u003cbr\\u003e\\u003cbr\\u003e**Smoother on Every Device**\\u003cbr\\u003eDeep performance optimizations have dramatically reduced memory usage. The game now loads faster, runs smoother, and stays stable even on older phones and devices with limited RAM.\"],\"Build Block Studio - XingTang Software\",\"100.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/kawLR-xNvIcRdPf1ywKtwq-6KgLXDKTyp5Au71n503VSi6SX1NiCJdBvgHl6G7gQiwnTH2lCSN-I7t9Rm2GAQw\"],null,[173,194,215,255]],null,[\"Rating 12+\",[null,2,[366,512],[null,null,\"https://play-lh.googleusercontent.com/yQChfa9XKlaXMIYTk8w8QwChjT8_SH-_2d2SS-kesw0TLQK1nxtw54bDcoZ09freZJgKrtg4f__is-31Vg\"]],[null,\"Sindiran Seksual\"],null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003ePelajari lebih lanjut\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/YrkR-GP7OKghBTATCoO_jJrchSVrh-NSUBb5DnbRZC1DbLK_cgV9FC2e_iI4GzLsKXuZjuFZajnGCiA8qA\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dmini.block.craft.free.mc\\u0026rdid\\u003dmini.block.craft.free.mc\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Instal\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"Rp 17.000 - Rp 87.000 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Kasual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.playrix.gardenscapes\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/Vu_BoGFdNORUCsqu8yyDPg7Re53M06VMyeBRq9a0tuRNLJWFV3glfdoI08mJuVLvwA_tokJqK3elHiK0yBFNGjo\"],null,[4,188,0,255],null,null,null,2],[[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/35B0ljIOTAB3oBRgQYMwhlBp4MBR1T2YsIzxdXWIZVCOQv5OyQkQFxDJGK9wVOabMG9bL8SDMt4iCFvLk4iQGnY\"]],[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/uHoccSaatOMEv2DhLPnu1uEUd44BmZrsffPt-On_rCxb5kF8sulFv76jdD29AzByYaKPMnqqQprzDgvMIb1m0A\"]],[null,2,[2560,1440],[null,null,\