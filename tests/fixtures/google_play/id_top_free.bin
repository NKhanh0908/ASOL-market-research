/play-lh.googleusercontent.com/uBQeVq5-xSeZvjo0CBwjrqn51GaGH02Cn3_vyhkuIclqMPkVrrUNXC-H-BSfluSz-4mLGP4A8zSd1uBBNImX6g\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/HNWmH9rfSfOQFpq6UWNQulYO8tjU8cmnhodiI6fC2hSRjk5aNz3jPvOfZFbaRE7A_8-WluQgGMjQiFDYFCPiXg\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/RfTNE6k-CXeH1TXhP7Joz3ssL6Zlr6S21tiCjBQbh83y5qADymFxnZ5yhBRES0dpOnjK3KXhGKDB8pyg9p3-vDQ\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/3TWNnePK_9PCLIdECmE_2ilTmXPpEXZUf42QldW1BZ0yAP0k3u5TdnrAavyxnkYA_l00mMGdYJ9HmuayLN3C\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/zRyNVmXUsl2P9VLxl3gYfwBdnjiz8tzLJjFhAiM13p-u8GbtxeSioRvXcoLCPDeJvaCjFPTjEZKKxqZLDCQz\"]]],\"Hair Salon Makeover Studio\",[\"3,7\",3.6875],\"Kasual\",null,null,[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.mrxvip.hair.salon\\u0026rdid\\u003dcom.mrxvip.hair.salon\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.mrxvip.hair.salon\"]],[\"qgJiGmAIX0oTCKPKxrDHkJcDFSkItwAdcYkOKPoBDAoKCAASBgoCaWQQAboCNwobChVjb20ubXJ4dmlwLmhhaXIuc2Fsb24QARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],null,[null,\"Step into a creative beauty studio and design stunning new looks from start to finish.\\u003cbr\\u003eIn Hair Salon Makeover Studio, you can wash, cut, curl, straighten, dry, and color hair using a full set of salon tools. Try bold colors, soft tones, trendy shapes, and polished styles as you transform each model into a fresh fashion icon.\\u003cbr\\u003eComplete every makeover with makeup, outfits, and accessories. Mix different styles, experiment with color combinations, and capture the final look in your personal photo album.\\u003cbr\\u003eFeatures:\\u003cbr\\u003e- Creative hair salon gameplay\\u003cbr\\u003e- Wash, cut, curl, straighten, dry, and color hair\\u003cbr\\u003e- Many hairstyles, shades, and styling options\\u003cbr\\u003e- Makeup, outfits, and fashion accessories\\u003cbr\\u003e- Photo album for finished looks\\u003cbr\\u003e- Relaxing offline gameplay\\u003cbr\\u003e-  Easy controls and smooth salon interactions\\u003cbr\\u003eBuild your own beauty routine, create unique makeovers, and show your styling talent in Hair Salon Makeover Studio.\"],\"MR. PROXY CORE\",\"1.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/a6PWjLZ-TL07r6CDKkNVJaCwuyyT8VJBR-074vu15I5rqxDbKIaeK8z1fi6NZQbsJfIYVQdGfUmuk32rDNAFaQ\"],null,[243,184,227,255]],null,[\"Rating 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003ePelajari lebih lanjut\\u003c/a\\u003e\"],true,[null,\"Cocok untuk semua kelompok usia. Beberapa kekerasan dalam konteks komikal atau fantasi dapat diterima. Bahasa kasar tidak diizinkan.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.mrxvip.hair.salon\\u0026rdid\\u003dcom.mrxvip.hair.salon\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Instal\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Kasual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.ragdoll.physics.destroypuppet\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/wDpWLW8LzdfTzdGMecWMkKY6ouB5sYyQ-WjgQCQXMfdVPtHG9KPGzzl98W3dCjo_t1B51uydTWTutURipawlnw\"],null,[133,164,164,255],null,null,null,2],[[null,2,[999,562],[null,null,\"https://play-lh.googleusercontent.com/zam_ClhG1E76XTh-BLT3lKrZJC73Fwu9SXNXpgbVZJgfJR35J0rh92KbYab-dUWG3QhZGTPsUWH8chHexxs-YQ\"]],[null,2,[999,562],[null,null,\"https://play-lh.googleusercontent.com/wCEYYocbjXY00DVrw-ddtjkj5FAWSt3JN074JRkfjAx9v7ytXg6-LIrEQLMeiwNPEt-7zoNigX4csPn_kayKDQ\"]],[null,2,[999,562],[null,null,\"https://play-lh.googleusercontent.com/ynJbexNoE0ufq1aWaram9_tjnPuwIqNxEUikSWrkxKfEiHLfc8cjTJMM6oWQpLc_1XFzWboo1VCdOOW-WfyAhA\"]],[null,2,[1000,562],[null,null,\"https://play-lh.googleusercontent.com/Z-HHRxUGFR1pxmghJOpLZCqVzW3AWgCa2Y9cf2AYYGOz2CyT2L8c4V4GIoZDlAQAlVw02FIWc8bTYF2XPL3FKcI\"]]],\"Destroy Puppet -Ragdoll Launch\",[\"3,6\",3.6181817],\"Kasual\",null,null,[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.ragdoll.physics.destroypuppet\\u0026rdid\\u003dcom.ragdoll.physics.destroypuppet\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.ragdoll.physics.destroypuppet\"]],[\"qgJ5GncIYEoTCKPKxrDHkJcDFSkItwAdcYkOKPoBFwoVCLnbnuWfnfeLQxIJCgVlbi1VUxAAugJDCicKIWNvbS5yYWdkb2xsLnBoeXNpY3MuZGVzdHJveXB1cHBldBABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"Ready to release some steam? Welcome to Destroy Puppet, the ultimate stress-relief game where you are the boss! 🐸💥\\u003cbr\\u003e\\u003cbr\\u003eFeeling stressed or just looking for some chaotic fun? Meet your new best friend—a funny, bouncy puppet that’s ready for some serious smashing! Whether you’ve had a long day at work or just want to see amazing physics in action, this game is built for instant satisfaction.\\u003cbr\\u003e🚀 NEW FEATURE: Quick Launcher Integration!\\u003cbr\\u003eInstant Action: Launch straight into the game directly from your home screen with our brand-new built-in Launcher!\\u003cbr\\u003e\\u003cbr\\u003eOne-Tap Stress Relief: No menus, no waiting—access your favorite weapons and start smashing in seconds whenever you need a quick break.\\u003cbr\\u003e\\u003cbr\\u003eSMASH, BANG, DESTROY! 👊🔥\\u003cbr\\u003eUnleash your creativity and experiment with a massive arsenal of powerful and wacky weapons. From classic tools to high-tech gear, there are no limits to how you can interact with the puppet!\\u003cbr\\u003e\\u003cbr\\u003eWhat’s in your arsenal? ⚔️🚀\\u003cbr\\u003eClassic Melee: Smash with heavy Hammers, frying pans, and spiked maces! 🔨🍳\\u003cbr\\u003eSharp Blades: Slice and dice with buzzsaws, knives, and swords! 🪚🔪\\u003cbr\\u003eExplosive Fun: Launch rockets, set off TNT, and watch the puppet fly! 💣🚀\\u003cbr\\u003eSci-Fi Tech: Zap away with futuristic laser guns and experimental weapons! 🔫⚡️\\u003cbr\\u003e\\u003cbr\\u003eWhy you’ll love Destroy Puppet:\\u003cbr\\u003e🤪 Hilarious Ragdoll Physics: Watch the puppet react in the funniest ways to every hit!\\u003cbr\\u003e✨ Vibrant Visual Effects: Every explosion and strike comes with colorful, satisfying effects!\\u003cbr\\u003e💰 Unlock \\u0026amp; Upgrade: Collect coins to unlock even more powerful weapons and crazy gear!\\u003cbr\\u003e🌈 Instant Satisfaction: Beat the clock! Simple rules and fast-paced action—just pure, unadulterated fun!\\u003cbr\\u003e🎮 Smooth Gameplay: Simple controls that anyone can pick up and play immediately.\\u003cbr\\u003e\\u003cbr\\u003eMore Chaos, More Fun! 🎊\\u003cbr\\u003eCollect rewards, upgrade your tools, and see how much damage you can do. The puppet can take it—can you unlock all the weapons?\\u003cbr\\u003e\\u003cbr\\u003eDownload Destroy Puppet now and start your smashing adventure today! 📥🐸🔥\"],\"Hiumai Arola\",\"1.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/HIkEii_u-OLH5kzDA-t0rmrzgTUiWAuUeLxzStbZh7ge6MQBkmuPqFXfwJ1_36x2Jb9L2KSLPXW-uMvJQ9OEVg\"],null,[37,53,71,255]],null,[\"Rating 7+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/1SrNtAwg9PFOhgMJPXehacRTeQNhHhG12Pj1zACHNVmfRfEZA3_oOEmLvRNsmYGeGHpas7sCwyR3y8OT\"]],[null,\"Kekerasan Ringan\"],null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003ePelajari lebih lanjut\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/JTT-ImEkrbWzIL7w0fP8fQhVmpexdfh7u0P59PJtyJywmQBVolJjunMal6B5dUM6uiFiKnmtHtBbVvcWBMU\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.ragdoll.physics.destroypuppet\\u0026rdid\\u003dcom.ragdoll.physics.destroypuppet\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Instal\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Kasual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.eqeetrtertr.drawfish\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/ymMgMA4eYc_gzIoJuBqwrleR7l0BHIFZ01b4JEvHcF3X4HuRM8TjVVBa77FUvTmtyoactco1hprjHXE3tuxh\"],null,[225,193,133,255],null,null,null,2],[[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/Yl30kV5uImk5QrCGuNHL6GiNyupazf0tY0n8Z0M4c82T