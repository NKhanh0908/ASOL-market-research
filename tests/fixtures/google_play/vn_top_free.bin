ll,\"https://play-lh.googleusercontent.com/NjFciZsBXsptVMzlpmHT1e1WzqidBBQJWhoLS2nuKRav6JmhMZbrI8g7ZoQ2QZOmJoEOH4-Xo8s0WMMNKT8z\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/1D-K6d4hNoR1x9DY96geF91UIJ4dy_UcNfMf6c6li_RwHYe92mExgDaXr5YyyIMUVpCjoFxYu4Uikotph2E-WA\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/OxcG_zvnmHnkMJe2atEhxNcWneL4jqSMqlsSqq1JtK24UL7Ont3aQ1zhPBabNRQj_bM-Uy0GqDlhs2sr2boD\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/cQdCjs4CawuNvYvu9u7-W0-9Pj8LHIIBwsSjZc_hx7H5iMo8BbZNQtzj7m8op9Po6Ekm3MXntTzbu3YDsUqleQ\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/Xp3eL8PfClRDR89YDmefDVO09HQe24q0cMB16JByxoLCGzfqj34qS3ZH2J2Yv21R5UINMKaeJrFjkh-0A8lR5w\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/mwyUGjmkVXdBzgrp4PVxKuRBMGQlUn-UDDeOjeEOn4-6tAXPkLHwWdjaoKegJfmwfQnCFOlVtZ8oX9Twrgol\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/Vt5AorfrBqbuCJYDyW13WOiy5cX6JIEZiH77yXRtscJzfevG2KokrEjmyr_fibY_fgpzb1d3qIeQUJpYN3FUY9E\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/Q2CKyauYnEdqyoHqpLJd7XS0cZeu1e-1N06aqltWYhfqGtsIPnihkUqd9Z9VbyQZRS0WOUCiXupdSAiA45vkvg\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/NjFciZsBXsptVMzlpmHT1e1WzqidBBQJWhoLS2nuKRav6JmhMZbrI8g7ZoQ2QZOmJoEOH4-Xo8s0WMMNKT8z\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/1D-K6d4hNoR1x9DY96geF91UIJ4dy_UcNfMf6c6li_RwHYe92mExgDaXr5YyyIMUVpCjoFxYu4Uikotph2E-WA\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/OxcG_zvnmHnkMJe2atEhxNcWneL4jqSMqlsSqq1JtK24UL7Ont3aQ1zhPBabNRQj_bM-Uy0GqDlhs2sr2boD\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/cQdCjs4CawuNvYvu9u7-W0-9Pj8LHIIBwsSjZc_hx7H5iMo8BbZNQtzj7m8op9Po6Ekm3MXntTzbu3YDsUqleQ\"]]],\"Idle Cat Gunner: Shooter RPG\",[\"4,8\",4.798479],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.Chodun.CatGunner\\u0026rdid\\u003dcom.Chodun.CatGunner\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.Chodun.CatGunner\"]],[\"qgJhGl8IA0oTCMTt16/HkJcDFQyjbAkdgcgbYPoBDAoKCAASBgoCdmkQALoCNgoaChRjb20uQ2hvZHVuLkNhdEd1bm5lchABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,null,[null,null,\"https://www.youtube.com/watch?v\\u003dom7pvunb_1I\"]],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/om7pvunb_1I/hqdefault.jpg\"]]]],[null,\"\\u0026quot;🐱 Bàn chân nhỏ, khẩu súng to?! Game RPG bắn súng nhàn rỗi đáng yêu nhất!\\u003cbr\\u003e\\u003cbr\\u003eSẽ ra sao nếu những chú mèo dễ thương và lông lá mang theo những khẩu súng khổng lồ đi phiêu lưu?\\u003cbr\\u003eSự bùng nổ của sự dễ thương + hỏa lực thú vị + game bắn súng gây nghiện!\\u003cbr\\u003eHãy tạo đội quân mèo của riêng bạn ngay bây giờ!\\u003cbr\\u003e\\u003cbr\\u003eTrận chiến tự động săn lùng ngay cả khi bạn vắng mặt!\\u003cbr\\u003eTrên đường đi làm, ở quán cà phê, hay trong giờ nghỉ giải lao ngắn, những chú mèo của chúng ta vẫn tiếp tục mạnh lên~\\u003cbr\\u003e\\u003cbr\\u003e■ Tính năng trò chơi\\u003cbr\\u003e\\u003cbr\\u003e▶ Bộ sưu tập hơn 25 chú mèo quyến rũ\\u003cbr\\u003eMèo bắn tỉa, mèo bắn súng ngắn, mèo súng máy... Các nhân vật có sức hấp dẫn riêng!\\u003cbr\\u003eSự dễ thương + khả năng + cá tính trong một trò chơi nhàn rỗi thực sự!\\u003cbr\\u003eTạo đội quân tối thượng của bạn!\\u003cbr\\u003e\\u003cbr\\u003e▶ Bộ sưu tập hơn 35 loại súng ngoạn mục - cảm giác bắn súng chân thực\\u003cbr\\u003eSúng lục, súng trường, súng ngắn, súng máy! Một game nhập vai bắn súng với nhiều loại vũ khí khác nhau.\\u003cbr\\u003ePằng! Pằng! Sự thanh tẩy của trận chiến tự động với âm thanh bắn súng thú vị!\\u003cbr\\u003eSự tương phản giữa vẻ ngoài dễ thương và hỏa lực áp đảo!\\u003cbr\\u003e\\u003cbr\\u003e▶ Hệ thống tổng hợp vũ khí - niềm vui cốt lõi của trò chơi nhàn rỗi\\u003cbr\\u003eKết hợp các loại súng giống nhau để nâng cấp chúng thành vũ khí mạnh hơn!\\u003cbr\\u003eSự hồi hộp tại thời điểm tổng hợp... Đây là niềm vui thực sự của game nhập vai nhàn rỗi!\\u003cbr\\u003eBạn không thể dừng lại trước hỏa lực ngày càng mạnh mẽ!\\u003cbr\\u003e\\u003cbr\\u003e▶ Hệ thống tái sinh - tiêu chuẩn của sự phát triển vô hạn\\u003cbr\\u003eĐạt đến một giai đoạn nhất định và nhận được những khả năng mạnh mẽ hơn thông qua sự tái sinh!\\u003cbr\\u003eMột hệ thống cực kỳ gây nghiện trở nên mạnh mẽ bùng nổ sau mỗi lần tái sinh!\\u003cbr\\u003eVới phần thưởng ngoại tuyến, những chú mèo chăm chỉ phát triển ngay cả khi bạn đang ngủ~\\u003cbr\\u003e\\u003cbr\\u003e▶ Khám phá nhiều bản đồ khác nhau - cuộc phiêu lưu bất tận\\u003cbr\\u003eRừng, sa mạc, cánh đồng tuyết... Một cuộc phiêu lưu thú vị trong nhiều môi trường khác nhau!\\u003cbr\\u003eCàng tiến xa, những thử thách lớn hơn và phần thưởng phong phú hơn đang chờ đón bạn!\\u003cbr\\u003e\\u003cbr\\u003e■ Những người này chắc chắn nên tải xuống!\\u003cbr\\u003e\\u003cbr\\u003e✔ Tất cả những người yêu mèo thích những chú mèo dễ thương\\u003cbr\\u003e✔ Những người thích trò chơi nhàn rỗi và trò chơi phát triển\\u003cbr\\u003e✔ Những người muốn cảm giác hồi hộp của một trò chơi bắn súng\\u003cbr\\u003e✔ Những người đang tìm kiếm một trò chơi thông thường để đi lại hoặc thời gian rảnh rỗi\\u003cbr\\u003e✔ Những người muốn một trò chơi di động có thể chơi thoải mái bằng một tay\\u003cbr\\u003e✔ Những người thích game nhập vai nhàn rỗi với các trận chiến tự động và phần thưởng ngoại tuyến\\u003cbr\\u003e✔ Những người có trí tò mò bùng nổ trước sự kết hợp \\u0026quot;\\u0026quot;Mèo + Súng\\u0026quot;\\u0026quot;\\u003cbr\\u003e\\u003cbr\\u003eNhững chú mèo dễ thương với những khẩu súng đang chờ bạn!\\u003cbr\\u003eTải xuống ngay bây giờ và bước vào một thế giới mới của game nhập vai bắn súng! 🎮🐱🔫\\u003cbr\\u003e\\u003cbr\\u003e-----\\u003cbr\\u003e📩 Hỗ trợ: support@neptunecompany.kr\\u003cbr\\u003e📄 Điều khoản dịch vụ: https://neptunecompany.kr/gameterms\\u003cbr\\u003e🔒 Chính sách quyền riêng tư: https://neptunecompany.kr/gameprivacy\\u0026quot;\"],\"NEPTUNE(TREEPLLA)\",\"1.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/1jFVH1ucrVd2ljIga96EmrnmuMiNHdGRJ2f03kj47KTtRdXVICiHZqz5bvCqsQCgRqsk5Mq4bGb6LuQqUloR\"],null,[109,129,63,255]],null,[\"3 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,[null,\"Phù hợp với tất cả các nhóm tuổi. Một số nội dung bạo lực trong ngữ cảnh hài hước hoặc tưởng tượng có thể được chấp nhận. Không cho phép ngôn từ thô tục.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.Chodun.CatGunner\\u0026rdid\\u003dcom.Chodun.CatGunner\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đặt\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"26.000 ₫ - 1.300.000 ₫ mỗi mặt hàng\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Phổ thông\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,n