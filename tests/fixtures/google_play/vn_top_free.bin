lh.googleusercontent.com/Gv8nPirH6EHAKggthVqA2m7s1Drl8lwIG7qArCi7gOm1EIkk5GyuuLiLf9TtFUYnkKbxKqsxEkrrLCyCxVS24iI\"]],[null,2,[3840,2160],[null,null,\"https://play-lh.googleusercontent.com/XezqL-0XURWvR-tOcL0hDUak2vv8-XLn89qkrUVpG5Ly3nMBAk3htufbdXHY14tDkaWQRUWbGOBsHTYAdtpq\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/1KWxhVnbj6D5hplNLXMQ5DRyG9jXygvCPZxUixnf5RPwKXfv8XweCffT87jmNKuIFBK-mtfzD_ozmQIf2JbAdg\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/Z-mVq7cLZdFdrgXjbPoY1Rs79LyRqc1CNrs_jOTPVeGJHxS0-O-AP2omV9mJHPDvaZefiWXlrpzIPaJ-M4Y5AA\"]]],\"Hank Biết Nói Của Tôi: Đảo Nhỏ\",[\"4,4\",4.444484],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.outfit7.mytalkinghank\\u0026rdid\\u003dcom.outfit7.mytalkinghank\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.outfit7.mytalkinghank\"]],[\"qgJmGmQIR0oTCMTt16/HkJcDFQyjbAkdgcgbYPoBDAoKCAASBgoCdmkQALoCOwofChljb20ub3V0Zml0Ny5teXRhbGtpbmdoYW5rEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],[[[null,null,\"Y8kTSNRNbVM\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:Y8kTSNRNbVM?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:Y8kTSNRNbVM\",null,null,null,null,\"AXH1eznhPxXFwZFcCsOOLlTesPernI3o8j9nRwYlfHbNvT7qN3fOgt3HMPTbxXOIEYnefZOIGnh841wQ1bGRMmYDI0rHHS8x2AAL89hapGi8kQTZiSv9QxOE5TifSetKeHX4qweXl_tSVTOahas49aW7QeipGWOJU3CwET02v-T_ycnEadkACq4ih2QAZYUB5_RvQuKU8-O0w3boF_Tm-2i5LksODujd-LRtiFwrl2VU_NOZjE5C5cvhgGWfilkECQZsUBlU7AteyQcoiMqE0DdWelrxBvvaH9Mi-M0ts0fPl1FczA\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/Y8kTSNRNbVM/hqdefault.jpg\"]]]],[null,\"Gặp gỡ Hank trong cuộc phiêu lưu trên đảo với thật nhiều nơi để khám phá, tìm hiểu các loài vật và rinh phần thưởng về nhà. Dạo quanh các khu vực trên hòn đảo rực rỡ, phát hiện những lối đi bí mật, thu thập nhãn dán và trở lại nhà cây của Hank để trang trí, sửa sang và chuẩn bị cho chuyến đi tiếp theo.\\u003cbr\\u003e\\u003cbr\\u003eKHÁM PHÁ HÒN ĐẢO CỦA HANK\\u003cbr\\u003eGhé thăm thế giới trên hòn đảo rực rỡ với nhiều nơi để khám phá. Dạo quanh bãi biển, thám hiểm khu rừng, khu vực băng giá và những lối đi bí mật trong hành trình tìm kiếm những hoạt động, phần thưởng và bất ngờ mới. Đu dây cáp, chèo thuyền, bơi giữa sông suối miền nhiệt đớt và phiêu lưu trên hòn đảo cùng Hank.\\u003cbr\\u003e\\u003cbr\\u003eKHÁM PHÁ CÁC LOÀI VẬT TRÊN ĐẢO\\u003cbr\\u003eGặp gỡ động vật hoang dã trên hòn đảo để xem điều gì khiến chúng thật đặc biệt. Tìm chú sư tử thân thiện, rùa biển và những sinh vật khác trên đảo trong hành trình khám phá. Thu thập nhãn dán và chơi các minigame về động vật, từ tạo kiểu bờm cho sư tử tới ngắm sao qua kính viễn vọng ngoài trời.\\u003cbr\\u003e\\u003cbr\\u003eTÌM, THU THẬP VÀ MỞ KHÓA\\u003cbr\\u003eMỗi chuyến đi trên đảo đều mang lại cho Hank thứ gì đó để mang về nhà:\\u003cbr\\u003e- Khám phá bãi biển, khu rừng, khu vực băng giá và lối đi bí mật\\u003cbr\\u003e- Tìm hiểu cuộc sống hoang dã và làm quen với các loài động vật trên đảo\\u003cbr\\u003e- Thu thập nhãn dán cho album của Hank\\u003cbr\\u003e- Mở khóa trang phục nhà thám hiểm và vật phẩm nhà cây\\u003cbr\\u003e- Chơi đu dây cáp, chèo thuyền và bơi giữa sông suối miền nhiệt đới\\u003cbr\\u003e- Trở lại nhà cây của Hank giữa các cuộc phiêu lưu\\u003cbr\\u003e- Chơi offline, ở bất kỳ đâu\\u003cbr\\u003e\\u003cbr\\u003eNÂNG CẤP NHÀ CÂY CỦA HANK\\u003cbr\\u003eMang phần thưởng về từ các chuyến phiêu lưu trên đảo và dùng chúng để nâng cấp nhà cây của Hank. Trang trí nhà, mở khóa vật phẩm mới và tạo một ngôi nhà ấm cúng cho chuyến khám phá đảo tiếp theo.\\u003cbr\\u003e\\u003cbr\\u003eCHƠI CÁC MINIGAME TRÊN ĐẢO\\u003cbr\\u003eTham gia các hoạt động nhẹ mang chủ đề động vật trên đảo. Thử tạo kiểu bờm cho sư tử, ngắm sao với kính viễn vọng, chơi ném tuyết cùng chim cánh cụt và khám phá nhiều thử thách vui nhộn khác.\\u003cbr\\u003e\\u003cbr\\u003eTIẾP SỨC CHO CUỘC PHIÊU LƯU TIẾP THEO\\u003cbr\\u003eHank là chú chó kiêm người bạn đồng hành trong cuộc phiêu lưu của bạn. Sau một ngày khám phá, hãy tiếp sức cho cậu ta bằng những khoảnh khắc chăm sóc nhanh để cậu ta sẵn sàng cho chuyến thám hiểm miền nhiệt đới mới.\\u003cbr\\u003e\\u003cbr\\u003eTẠI SAO NÊN CHƠI GAME NÀY?\\u003cbr\\u003eKhám phá các khu vực trên đảo, các loài động vật, thu thập nhãn dán, chơi minigame, mở khóa trang phục nhà thám hiểm và nâng cấp nhà cây của Hank. Bắt đầu thám hiểm hòn đảo ngay hôm nay.\\u003cbr\\u003eĐến từ Outfit7, nhà sáng tạo của Angela Biết Nói Của Tôi 2, Tom Biết Nói Của Tôi 2 và Tom Biết Nói Của Tôi: Bạn Bè.\\u003cbr\\u003eỨng dụng này có chứa:\\u003cbr\\u003e- Quảng bá sản phẩm và quảng cáo của Outfit7;\\u003cbr\\u003e- Liên kết hướng khách hàng đến các trang web của Outfit7 và các ứng dụng khác;\\u003cbr\\u003e- Cá nhân hóa nội dung để khuyến khích người dùng không ngừng chơi ứng dụng;\\u003cbr\\u003e- Tích hợp YouTube để cho phép người dùng xem video về các nhân vật hoạt hình của Outfit7;\\u003cbr\\u003e- Tùy chọn để mua hàng trong ứng dụng\\u003cbr\\u003e- Các vật phẩm để mua (có sẵn ở các mức giá khác nhau) bằng tiền ảo, tùy thuộc vào tiến trình của người chơi;\\u003cbr\\u003e- Các tùy chọn thay thế để truy cập tất cả các chức năng của ứng dụng mà không cần thực hiện bất kỳ giao dịch mua hàng trong ứng dụng nào bằng tiền thật.\\u003cbr\\u003e\\u003cbr\\u003eĐiều khoản sử dụng: https://talkingtomandfriends.com/eula/en/\\u003cbr\\u003eChính sách quyền riêng tư dành cho trò chơi: https://talkingtomandfriends.com/privacy-policy-games/en\\u003cbr\\u003eHỗ trợ khách hàng: support@outfit7.com\"],\"Outfit7 Limited\",\"100.000.000+\",null,null,null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/VasJgODT8b29t79TTQ7UXWbrI-Owf8xcMQa2cyaSGPsfHw6pSB6OQKjkWq6ApCNOMzDcNrpM0i6UYUBGSUAK59E\"],null,[21,160,248,255]],null,[\"3 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Mua hàng trong trò chơi\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.outfit7.mytalkinghank\\u0026rdid\\u003dcom.outfit7.mytalkinghank\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đặt\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"50.060 ₫ - 250.700 ₫ mỗi mặt hàng\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Phổ thông\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.ragdoll.physics.destroypuppet\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/wDpWLW8LzdfTzdGMecWMkKY6ouB5sYyQ-WjgQCQXMfdVPtHG9KPGzzl98W3dCjo_t1B51uydTWTutURipawlnw\"],null,[133,164,164,255],null,null,null,2],[[null,2,[999,562],[null,null,\"https://play-lh.googleusercontent.com/zam_ClhG1E76XTh-BLT3lKrZJC73Fwu9SXNXpgbVZJgfJR35J0rh92KbYab-dUWG3QhZGTPsUWH8chHexxs-YQ\"]],[null,2,[999,562],[null,null,\"https://play-lh.googleusercontent.com/wCEYYocbjXY00DVrw-ddtjkj5FAWSt3JN074JRkfjAx9v7ytXg6-LIrEQLMeiwNPEt-7zoNigX4csPn_kayKDQ\"]],[null,2,[999,562],[null,null,\"https://play-lh.googleusercontent.com/ynJbexNoE0ufq1aWaram9_tjnPuwIqNxEUikSWrkxKfEiHLfc8cjTJMM6oWQpLc_1XFzWboo1VCdOOW-WfyAhA\"]],[null,2,[1000,562],[null,null,\"https://play-lh.googleusercontent.com/Z-HHRxUGFR1pxmghJOpLZCqVzW3AWgCa2Y9cf2AYYGOz2CyT2L8c4V4GIoZDlAQAlVw02FIWc8bTYF2XPL3FKcI\"]]],\"Destroy Puppet -Ragdoll Launch\",[\"4,0\",4.009346],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.ragdoll.physics.destroypuppet\\u0026rdid\\u003dcom.ragdoll.physics.destroypuppet\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.ragdoll.physics.destroypuppet\"]],[\"qgJ5GncISEoTCMTt16/HkJcDFQyjbAkdgcgbYPoBFwoVCLnbnuWfnfeLQxIJCgVlbi1VUxAAugJDCicKIWNvbS5yYWdkb2xsLnBoeXNpY3MuZGVzdHJveXB1cHBldBABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"Ready to release some steam? Welcome to Destroy Puppet, the ultimate stress-relief game where you are the boss! 🐸💥\\u003cbr\\u003e\\u003cbr\\u003eFeeling stressed or just looking for some chaotic fun? Meet your new best friend—a funny, bouncy puppet that’s ready for some serious smashing! Whether you’ve had a long day at work or just want to see amazing physics in action, this game is built for instant satisfaction.\\u003cbr\\u003e🚀 NEW FEATURE: Quick Launcher Integration!\\u003cbr\\u003eInstant Action: Launch straight into the game directly from your home screen with our brand-new built-in Launcher!\\u003cbr\\u003e\\u003cbr\\u003eOne-Tap Stress Relief: No menus, no waiting—access your favorite weapons and start smashing in seconds whenever you need a quick break.\\u003cbr\\u003e\\u003cbr\\u003eSMASH, BANG, DESTROY! 👊🔥\\u003cbr\\u003eUnleash your creativity and experiment with a massive arsenal of powerful and wacky weapons. From classic tools to high-tech gear, there are no limits to how you can interact with the puppet!\\u003cbr\\u003e\\u003cbr\\u003eWhat’s in your arsenal? ⚔️🚀\\u003cbr\\u003eClassic Melee: Smash with heavy Hammers, frying pans, and spiked maces! 🔨🍳\\u003cbr\\u003eSharp Blades: Slice and dice with buzzsaws, knives, and swords! 🪚🔪\\u003cbr\\u003eExplosive Fun: Launch rockets, set off TNT, and watch the puppet fly! 💣🚀\\u003cbr\\u003eSci-Fi Tech: Zap away with futuristic laser guns and experimental weapons! 🔫⚡️\\u003cbr\\u003e\\u003cbr\\u003eWhy you’ll love Destroy Puppet:\\u003cbr\\u003e🤪 Hilarious Ragdoll Physics: Watch the puppet react in the funniest ways to every hit!\\u003cbr\\u003e✨ Vibrant Visual Effects: Every explosion and strike comes with colorful, satisfying effects!\\u003cbr\\u003e💰 Unlock \\u0026amp; Upgrade: Collect coins to unlock even more powerful weapons and crazy gear!\\u003cbr\\u003e🌈 Instant Satisfaction: Beat the clock! Simple rules and fast-paced action—just pure, unadulterated fun!\\u003cbr\\u003e🎮 Smooth Gameplay: Simple controls that anyone can pick up and play immediately.\\u003cbr\\u003e\\u003cbr\\u003eMore Chaos, More Fun! 🎊\\u003cbr\\u003eCollect rewards, upgrade your tools, and see how much damage you can do. The puppet can take it—can you unlock all the weapons?\\u003cbr\\u003e\\u003cbr\\u003eDownload Destroy Puppet now and start your smashing adventure today! 📥🐸🔥\"],\"Hiumai Arola\",\"1.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/HIkEii_u-OLH5kzDA-t0rmrzgTUiWAuUeLxzStbZh7ge6MQBkmuPqFXfwJ1_36x2Jb9L2KSLPXW-uMvJQ9OEVg\"],null,[37,53,71,255]],null,[\"7 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/1SrNtAwg9PFOhgMJPXehacRTeQNhHhG12Pj1zACHNVmfRfEZA3_oOEmLvRNsmYGeGHpas7sCwyR3y8OT\"]],[null,\"Bạo lực nhẹ nhàng\"],null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.google