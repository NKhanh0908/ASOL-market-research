HkJcDFQyjbAkdgcgbYPoBDAoKCAASBgoCdmkQAboCNAoeChhzaXRlLnF3cWQua2pidmYua2FtaWVtaWUQARgDEhIKBAgBEAEKBAgEEAEKBAgLEAE\\u003d\"],null,[null,\"tn88Mahjong Lucky Table is a tile-matching table.\\u003cbr\\u003e\\u003cbr\\u003eTwo tiles clear only when they show the same face and a line can join them. The line may bend twice. It can cross empty spaces, and it stops if another tile sits on that path.\\u003cbr\\u003e\\u003cbr\\u003eA new table places the tiles again. If no line is left, the remaining faces are shuffled where they sit.\\u003cbr\\u003e\\u003cbr\\u003eNothing in the game is cash, a prize, or a real-world reward.\"],\"DAMAN GENERAL STORE\",\"0+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/wWoXTa_vSp2LDhYLJpb_buXZVJclQfL84-Fxs8S-WsP3nHl35rgvaY7bgf41-1YjQgyG32ZL401H1LO1QsR2oQ\"],null,[229,107,112,255]],null,[\"3 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,[null,\"Phù hợp với tất cả các nhóm tuổi. Một số nội dung bạo lực trong ngữ cảnh hài hước hoặc tưởng tượng có thể được chấp nhận. Không cho phép ngôn từ thô tục.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dsite.qwqd.kjbvf.kamiemie\\u0026rdid\\u003dsite.qwqd.kjbvf.kamiemie\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đặt\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2]