[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.Speed.Keyboard.Parkour.Escape\\u0026rdid\\u003dcom.Speed.Keyboard.Parkour.Escape\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.Speed.Keyboard.Parkour.Escape\"]],[\"qgJuGmwIJUoTCMTt16/HkJcDFQyjbAkdgcgbYPoBDAoKCAASBgoCdmkQAboCQwonCiFjb20uU3BlZWQuS2V5Ym9hcmQuUGFya291ci5Fc2NhcGUQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],null,[null,\"Welcome to Keyboard Escape: Speed Parkour, a fast-paced obby adventure where quick reflexes and perfect timing are the key to survival!\\u003cbr\\u003e\\u003cbr\\u003eRun across giant keyboard platforms, jump over tricky obstacles, and escape challenging parkour courses. Every level brings new surprises that will test your speed and precision.\\u003cbr\\u003e\\u003cbr\\u003e🎮 Game Features 🎮\\u003cbr\\u003e⌨️ Exciting keyboard-themed parkour gameplay\\u003cbr\\u003e🎧 Enjoy satisfying ASMR keyboard typing sounds with every move\\u003cbr\\u003e⚡ Fast-paced challenges and smooth controls\\u003cbr\\u003e🏃 Dodge traps, jump obstacles, and keep running\\u003cbr\\u003e\\u003cbr\\u003eCan you escape the keyboard world and become the ultimate speed runner?\\u003cbr\\u003ePlay Keyboard Escape: Speed Parkour now and put your reflexes to the test!\"],\"H2T GLOBAL PTE. LTD.\",\"1.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/tGi77ym3c-zkDBE1feS7hg9wn8-2MDNUOgEs5ZR3UHJtOo6vCeQm7CB1cfWFZPpaubAGyKWluNwz_wh-X2oHng\"],null,[80,37,26,255]],null,[\"3 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u