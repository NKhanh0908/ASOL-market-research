1920,1080],[null,null,\"https://play-lh.googleusercontent.com/K5DBNXpnd14J5sRlSbUD3RI8xNHgmot1jx6FFt-2P47LhKLUHh6q_z2TsBr9yO3OalpzL8NZdUx5zEdpnWryhiY\"]]],\"Satisfying Coloring\",[\"4,1\",4.12549],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.gps.draw.flag.coloring.games\\u0026rdid\\u003dcom.gps.draw.flag.coloring.games\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.gps.draw.flag.coloring.games\"]],[\"qgJtGmsIHUoTCMTt16/HkJcDFQyjbAkdgcgbYPoBDAoKCAASBgoCdmkQAboCQgomCiBjb20uZ3BzLmRyYXcuZmxhZy5jb2xvcmluZy5nYW1lcxABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"Introducing a new world of coloring ASMR, a relaxing and fun place where you can enjoy coloring. If you\\u0026#39;re looking for satisfying games, where every stroke makes your drawing pretty, then this ASMR coloring game is the complete coloring experience to relax and unwind while having fun. Each stroke slowly turns your sketch into a masterpiece.\\u003cbr\\u003e\\u003cbr\\u003eEvery pencil color gives you the thrill of coloring fun, where relaxation meets creativity. Enjoy peaceful ASMR sounds and soothing visuals while you\\u0026#39;re coloring. Show your creativity on a simple page and draw fun, colorful things, and enjoy the art of coloring.\\u003cbr\\u003e\\u003cbr\\u003eUnlock VIP levels, explore unique drawings, and color with your marker. Play surprise levels to make your creative journey more stylish. In some levels, an erase tool is available that will help you while drawing. Enhance your artwork with spray to create a neater, more stylish drawing.\\u003cbr\\u003e\\u003cbr\\u003eSatisfying Coloring Quality Features:\\u003cbr\\u003e\\u003cbr\\u003eSmooth and easy controls, just tap to fill.\\u003cbr\\u003eRelaxing ASMR sounds with every stroke.\\u003cbr\\u003eMultiple coloring pages to show your creativity.\\u003cbr\\u003eJust tap, color, and relax, no extra skills needed.\"],\"Mad1 Games\",\"50.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/Jg-ImHUhfuxpJXbtudKWw7W_F4ODqnTrJzTw1oLYpJtBuzSRCQUeW2EXhDiJXYY29Xq74BOMDxwXrEtFkzK11g\"],null,[250,250,251,255]],null,[\"3 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,[null,\"Phù hợp với tất cả các nhóm tuổi. Một số nội dung bạo lực trong ngữ cảnh hài hước hoặc tưởng tượng có thể được chấp nhận. Không cho phép ngôn từ thô tục.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.gps.draw.flag.coloring.games\\u0026rdid\\u003dcom.gps.draw.flag.coloring.games\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đặt\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"126.000 ₫ mỗi mặt hàng\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Phổ thông\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"boom.boom.tictactoe\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/u2HseRwqbBY4_mws_m_