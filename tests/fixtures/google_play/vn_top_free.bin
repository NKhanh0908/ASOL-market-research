play-lh.googleusercontent.com/-REA7vLjh55ZjRMwxba_quQQZKAeis7wAVbykSN2aoU3hel2KCy65muLtpHblwBIsza5BKFYARPPFPmfQMSV\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/cT98YjAKcmLe5ub0M5aYakThBPgGOChDHObU03M6TgvcjYKFClJDyKLGqfFmjSoF_71QUQBqdrskGrHsgjbaKw\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/u-rj2K_BePkWwHQPX_a9MFXLNPTn9CdELnMbkZdopTDMx1xtTt4xEL2aDqiQSJKdLucsdSmjkxou6Uz-xzEV2A\"]]],\"Block Puzzle Classic\",[\"4,2\",4.22],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.blockpuzzle.games.classic\\u0026rdid\\u003dcom.blockpuzzle.games.classic\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.blockpuzzle.games.classic\"]],[\"qgJqGmgIGkoTCMTt16/HkJcDFQyjbAkdgcgbYPoBDAoKCAASBgoCdmkQAboCPwojCh1jb20uYmxvY2twdXp6bGUuZ2FtZXMuY2xhc3NpYxABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,\"NUW4VtfktC0\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:NUW4VtfktC0?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:NUW4VtfktC0\",null,[960,540],null,null,\"AXH1ezn9WYJSob2GoCQJrud1QDnKDwGXt-1SM6fRvkjqm95XHjwcdX_SxlZDD2FsgtLROyW9lJ-BPncKdEyf4ruwAHDQpE3kq092dkr8LahQv3wz9LTpE9K11B3dpkWpz8wnQZ1UToWHfZ3vfgyhPTNB9kf0TiogVgvIWDKdEUFNYbSWqDXlb_4fiSiXyReqoXQcOA_Rt1VNycKifSx2EgUzFsik1R3FD6t3UbndqEKvpNodf_oWUDjdfyDXG-lJxvPEo0iyrjvOZh-WVpYmUC0wVjmR19oAFvH5hUOnQZJGHQtJ-Q\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/NUW4VtfktC0/hqdefault.jpg\"]]]],[null,\"Block Puzzle Classic: Level Up Your Puzzle Game! \\u003cbr\\u003eImmerse yourself in a world of strategic block-clearing excitement! \\u0026quot;Block Puzzle Classic\\u0026quot; features a seamless 10x10 grid that challenges your logic and rewards your progression with each level you conquer. Play anytime, anywhere, enhancing your problem-solving skills as you advance through increasingly challenging stages.\\u003cbr\\u003e\\u003cbr\\u003eGame Highlights:\\u003cbr\\u003e•\\tLevel-Up Mechanics: Each cleared line not only scores points but also helps you advance to the next level, increasing the challenge and excitement.\\u003cbr\\u003e•\\tOffline Gameplay: Perfect for focusing on your puzzle-solving strategies without distractions.\\u003cbr\\u003e•\\tBrain Training on the Go: Boost your IQ and improve your problem-solving abilities in a fun and engaging way.\\u003cbr\\u003e•\\tGlobal Leaderboards: Compete with players around the world and see how you rank in mastering block puzzles.\\u003cbr\\u003e•\\tColorful Blocks: Enjoy vibrant, colorful gameplay that makes each level a visual delight.\\u003cbr\\u003e•\\tCombo Mastery: Unlock and master chain reactions to maximize your score and efficiency.\\u003cbr\\u003e•\\tFree to Play: Start playing immediately without any fees and access all features fully free of charge.\\u003cbr\\u003e\\u003cbr\\u003eHow to Play?\\u003cbr\\u003e•\\tDrag and place blocks to complete and clear full rows or columns.\\u003cbr\\u003e•\\tEach completed line contributes to your progression, helping you level up.\\u003cbr\\u003e•\\tAdapt your strategy to tackle increasingly complex shapes and scenarios.\\u003cbr\\u003e•\\tAim for high scores and ascend the global leaderboards to showcase your puzzle prowess.\\u003cbr\\u003eContact Us: Need assistance or want to give feedback? Reach out to us at cs2_sofishgame@outlook.com.\\u003cbr\\u003e\\u003cbr\\u003eDownload \\u0026quot;Block Puzzle Classic\\u0026quot; now and dive into endless strategic puzzles. Keep advancing and keep the excitement alive! 🎮\"],\"SOFISH GAMES\",\"5.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/Khzdbp1rjIXfhbJxksW4k8U0cswt3qd1W9PSeT_LlgAUK6-rV53c-5c6C4NtzQilWxMsknsRH8K1ARSciXImo6I\"]