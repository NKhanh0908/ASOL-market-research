l,null,null,null,[null,null,\"/store/apps/details?id\\u003dio.voodoo.holeio\"]],[\"qgJdGlsICEoTCMTt16/HkJcDFQyjbAkdgcgbYPoBDAoKCAASBgoCdmkQAboCMgoWChBpby52b29kb28uaG9sZWlvEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],[[[null,null,\"3pu8nD2q5IE\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:3pu8nD2q5IE?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:3pu8nD2q5IE\",null,null,null,null,\"AXH1ezkRdXsmYSw6qEuGrTcVz4kpZzBqwijsfN9YU2PG_2kfciwyt67zX7BlcSqfCVjML2PAOMpX1BFuhhm6YDdZdh3cVDLy5ZxfWvwRJ9RECdzO5YN_WnlUQOfg922dNZaTr8EDxuU4Frq5mHCdP6zM-d0udg2P2UQfIcbUk3036rN0qCylYrWKBjClwvmB5UVkgLIVbku5SZEnR04_hu5Ts_IcZFo6A7PxKe9dnnZhyydgbXUCyBde5h16LHZb1eBwmZCKt7D4ajpAiX1s6nvM0V-RQFReW6vANQlW-Rg-4QmGNw\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/3pu8nD2q5IE/hqdefault.jpg\"]]]],[null,\"Welcome to Hole.io, the wildly satisfying eat-the-world game played by millions! Drop into busy New York, a creaky pirate cove, or a glowing sci-fi metropolis - and swallow it whole. Cars, lampposts, hot dogs and even giant skyscrapers! 🏙️🏴\\u200d☠️🚀\\u003cbr\\u003e\\u003cbr\\u003eWhether you\\u0026#39;ve got five minutes while watching your favorite show or an hour to unwind before bed, just tap, glide, and watch the city crumble into a black hole. No pressure, no stress - just the pure, oddly relaxing joy of eating everything in sight. 😌\\u003cbr\\u003e\\u003cbr\\u003e🍔 EAT EVERYTHING\\u003cbr\\u003eStart tiny, barely big enough to swallow a trash can. Grow huge, big enough to gulp down skyscrapers in one bite. The bigger you get, the louder the crunch. Pure satisfaction. 🌆\\u003cbr\\u003e\\u003cbr\\u003e😌 THE PERFECT BREAK \\u003cbr\\u003eEasy to learn, instantly satisfying. Play in short bursts: morning coffee ☕, lunch break 🥪, evening unwind🌙. A relaxing, oddly soothing game for casual players.\\u003cbr\\u003e\\u003cbr\\u003e✨ WHY YOU\\u0026#39;LL LOVE IT \\u003cbr\\u003e- Wonderfully simple controls - just swipe and glide.\\u003cbr\\u003e- Insanely satisfying gameplay - swallow, smash, and clear the map.\\u003cbr\\u003e- Beautiful, vibrant 3D worlds packed with detail.\\u003cbr\\u003e- Free to play, easy to love.\\u003cbr\\u003e\\u003cbr\\u003e🕳️ Ready to swallow the world? Download Hole.io now and find out why millions of players can\\u0026#39;t put it down. Time to feed the black hole. 😋\"],\"VOODOO\",\"100.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/cGXxPboiwvp6F7LPPGQxDyUbrUL2_PbSAZnj3erVs9QpdRCpqWYz-LZBbBoBb2Tbg8Yh0R6Z7Ujr84BaJXHC\"],null,[239,182,132,255]],null,[\"7 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/1SrNtAwg9PFOhgMJPXehacRTeQNhHhG12Pj1zACHNVmfRfEZA3_oOEmLvRNsmYGeGHpas7sCwyR3y8OT\"]],[null,\"Bạo lực ngụ ý\"],[null,\"Mua hàng trong trò chơi\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/JTT-ImEkrbWzIL7w0fP8fQhVmpexdfh7u0P59PJtyJywmQBVolJjunMal6B5dUM6uiFiKnmtHtBbVvcWBMU\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dio.voodoo.holeio\\u0026rdid\\u003dio.voodoo.holeio\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đặt\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"20.000 ₫ - 2.200.000 ₫ mỗi mặt hàng\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Phổ thông\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.outfit7.mytalkingtom2\",7],[n