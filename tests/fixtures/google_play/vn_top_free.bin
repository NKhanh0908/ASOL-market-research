PcZwod2LoDZGYm3HILwlPcnQf0O9Mow\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/fNRkiqDWsll1zlKwkDZqd0ug2sHdImLR0D3jgzsvqRt4uoZKSmx50sipYWeNB7h0l_Ggc8hANrsBw7fG1cv1Fmg\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/tj-7X0ZvjYqLf249UnDyymczPFYqPLisOekTisYMC3Mn_DCm212H5DvV9Pc5K3Ctz3g9NqcBPJzQE1zWDf7POag\"]]],\"Run Challenge3D: Parkour Game\",[\"3,7\",3.66],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.happygo.runcollection\\u0026rdid\\u003dcom.happygo.runcollection\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.happygo.runcollection\"]],[\"qgJmGmQIUkoTCMTt16/HkJcDFQyjbAkdgcgbYPoBDAoKCAASBgoCdmkQALoCOwofChljb20uaGFwcHlnby5ydW5jb2xsZWN0aW9uEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],[[[null,null,\"A7onrAp_-zE\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:A7onrAp_-zE?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:A7onrAp_-zE\",null,null,null,null,\"AXH1eznyQDzrBgouU25NlIChSiW1F7JHDwCd79Stl-oabCorLTQMvv5eFXQfXELUjVuNg4uwi8MWXYjkYxlh5i9dFYqZlcnVAl4kXQ070AqXnmwR-MkCQxoGogCiYUHlnGygUplUL5F4S_BdhwLSL92A-oXmV-cw3iN_XGIAycFvZF33sAtb7WYNDaDHMB2z_sE-VCWcgFqo0ovsWkqVumzCwiZY5Na5bomkaf5e6GtiXhTkvIdUzRS562xncQGMbMbvwrqnLYH6q5rWH9DQRfzRxst4NHnNKpDeS0x--DAbSUdlBA\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/A7onrAp_-zE/hqdefault.jpg\"]]]],[null,\"Chào mừng bạn đến với Run Challenge3D:Parkour Game, nơi mục tiêu duy nhất là sinh tồn. Lấy cảm hứng từ bản hit p\\u003cbr\\u003eArkour, trò chơi đội hình này kiểm tra trí thông minh, chiến lược và sức bền của bạn. Hòa mình vào thế giới của trò chơi Parkour, bạn sẽ phải đối mặt với một loạt thử thách chết người, mỗi thử thách đều khốc liệt hơn lần trước, sau đó bạn phải chạy và sống sót để trở thành người chơi mạnh nhất trong số người chơi. Bạn có thể sống sót trong Run Challenge3D:Parkour Game và trở thành người chiến thắng cuối cùng không?\\u003cbr\\u003e\\u003cbr\\u003eTrong Run Challenge3D:Parkour Game, mục tiêu của bạn là sống sót qua một loạt trò chơi chết người. Mỗi cấp độ đều có những thử thách riêng và bạn sẽ cần phải đánh bại tất cả để giành chiến thắng.\\u003cbr\\u003e\\u003cbr\\u003eCác tính năng:\\u003cbr\\u003e\\u003cbr\\u003e🎥 Đồ họa 3D chất lượng cao: Trải nghiệm hình ảnh sống động mang đến cho bạn cảm giác chân thực, tò mò, hồi hộp và phấn khích qua từng cấp độ.\\u003cbr\\u003e\\u003cbr\\u003e🎮 Dễ chơi: Cơ chế điều khiển dễ học giúp bạn tập trung vào việc sinh tồn. Mỗi cấp độ sẽ có phần hướng dẫn ngay từ đầu để giúp bạn nhanh chóng hòa mình vào trò chơi parkour.\\u003cbr\\u003e\\u003cbr\\u003e⭐ Cập nhật thường xuyên: Các cấp độ và thử thách mới được bổ sung thường xuyên để nâng cao trải nghiệm của người tham gia.\\u003cbr\\u003e\\u003cbr\\u003e.Mục tiêu của bạn rất đơn giản: sống sót. Với mỗi cấp độ, độ khó sẽ tăng lên và số tiền đặt cược sẽ cao hơn. Sử dụng chiến lược, phản xạ nhanh và đôi khi là một chút may mắn để về đích. Bạn có thể đánh bại những người khác và giành chiến thắng trong Run Challenge không?\\u003cbr\\u003e\\u003cbr\\u003eĐắm chìm trong thế giới trò chơi mang tên Run Challenge3D:Parkour Game. Đây không chỉ là một trò chơi chạy, mà là một trận chiến sinh tồn. Tải xuống ngay và bắt đầu hành trình của bạn. Chỉ có kẻ mạnh nhất mới sống sót.\"],\"Happy Go Game\",\"10.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/QYTD-SbdbSPlb6e0h_YFeBKRWh7tfrE8xe5qdfZrSizT8zhWePwyL8BqD1YCsue0EWjEkWHsmue8toXM1VFKOzE\"],null,[40,159,249,255]],null,[\"3 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https:/