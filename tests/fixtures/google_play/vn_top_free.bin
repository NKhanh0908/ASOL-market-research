jf_ScS9tYni-Sm5HN6-UX_2sI-mVTMMhqaNYoJ79csuwofJDOArA\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/4a01ADOnlIkoaWfLjBgoMortqgjaJ0DWJ73r93biYZYERtPIfkbfrhBdQUE6Non_jMO18QdB330a1bNw-n1tqA\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/Hl7vh-A3YA7ySFtzdqDikWxX-pxzk_V2Zbk7wjZtbbr4qZndxEclRHOmgtAmCMn-OVIBICO2BalBz-e8MDdL\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/bpMhTeBDtRvbCAeYNsvWFAwQ2GXMfVyYdQFm9eNiC-Eg9bqFWKcvjXEsCTNVYz1Ss5w2DaIjQjrh7g36n4R0rg\"]]],\"Mini World:CREATA VN\",[\"3,5\",3.460901],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.miniworldgame.creata.vn\\u0026rdid\\u003dcom.miniworldgame.creata.vn\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.miniworldgame.creata.vn\"]],[\"qgJoGmYIEUoTCMTt16/HkJcDFQyjbAkdgcgbYPoBDAoKCAASBgoCdmkQALoCPQohChtjb20ubWluaXdvcmxkZ2FtZS5jcmVhdGEudm4QARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],[[[null,null,\"Je-CVAmZTlA\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:Je-CVAmZTlA?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:Je-CVAmZTlA\",null,null,null,null,\"AXH1ezmQth3dVXfIXrkDJtV5xz0tsrRt9XNhbW1Nb-KIbOsoSC0C5xROxF68_SvaU0pAL3F2SSQWX0NFAQHXUMrgQ87XgT8A_qTo3oMcLnXslgqaSuMF83aBQ_4pczmHXUhrYB5smC2o00k2annfbLF0Y7hI0N7WWQ_d_oBEMwoLCE1naO9RXLJEU_WEARbA6iEgXh-2cpwwUHnz3-lm1IxYeHA1S5OlEfuedvRia6PbQET698uqkR153ltGI5ylGb7m9Bg7wI_CexpOpfBZt9_BDx1_pjixoaO9hobQeox5W9A4vw\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/Je-CVAmZTlA/hqdefault.jpg\"]]]],[null,\"[Mini World] Phiên bản độc quyền Việt Nam lên sóng. Tối ưu và thêm nhiều nội dung bản địa hóa, quà tặng độc quyền cũng nhiều hơn, nhanh đến trải nghiệm ngay vẻ đẹp Việt Nam nào!\\u003cbr\\u003e\\u003cbr\\u003e[Mini World] là một game Sandbox 3D đẹp mắt với tính tự do sáng tạo cao.\\u003cbr\\u003eKhông có quy tắc giới hạn, không có lối chơi chỉ định, bạn có thể sáng tạo, phá hủy, sinh tồn hoặc mạo hiểm. Vườn, Thư Viện, Sảnh Liên Thông...và nhiều tính năng khác đang chờ bạn khám phá.\\u003cbr\\u003e\\u003cbr\\u003e[Sân Chơi Mở Tự Do Thoải Mái]\\u003cbr\\u003eBạn thoải mái sáng tạo: có thể xây dựng công trình, thành phố lý tưởng của bạn, mở bất kỳ bản đồ nào đó để trồng trọt, mua bán các loại cây trồng, mô phỏng kinh doanh buôn bán, các lựa chọn vô cùng đa dạng và phong phú.\\u003cbr\\u003eBạn cũng có thể tự do phá hủy: có thể phá bỏ các tòa nhà mà bạn không thích, san bằng rừng núi và thảo nguyên, xây núi lửa và tạo lũ lụt... làm đảo lộn thế giới!\\u003cbr\\u003eBạn có thể chọn sinh tồn mạo hiểm: chọn bối cảnh phù hợp, cần thận đối phó với những quái vật ẩn nấp, nâng cấp vũ khí của bản thân và chiến đấu với lũ quái vật, cũng có thể trực tiếp đối đầu với biệt đội cảm tử vô cùng dũng cảm.\\u003cbr\\u003eHãy chọn sân chơi Mini World để có thêm nhiều các lựa chọn hơn: Xây dựng các Mini Game trong Mini World, sáng tạo âm nhạc, quay phim hoạt hình...\\u003cbr\\u003e\\u003cbr\\u003e[Cùng Bạn Bè Liên Thông, Niềm Vui Nhân Đôi]\\u003cbr\\u003eCó thể kết bạn năm châu bốn biển, cùng chơi các trò chơi ở sảnh liên thông, cùng chiến đấu với quái vật, tám chuyện, đi bộ cùng nhau, xây dựng Vườn, trải nghiệm thế giới mới, khám phá các map chưa biết đến.\\u003cbr\\u003e\\u003cbr\\u003e[Sự Kiện Phong Phú, Thưởng Hấp Dẫn]\\u003cbr\\u003eSự kiện Kho Báu chính thức bắt đầu, loạt skin vũ khí mới ra mắt.\\u003cbr\\u003eNhiều sự kiện hơn trong các dịp lễ: Quà tặng ngày lễ, sự kiện đặc biệt cho kỳ nghĩ Hè, nghĩ Tết, sự kiện cuối tuần, giờ vàng, hợp tác cùng các IP lớn nổi tiếng, skin cực ngầu, vũ khí và các sự kiện bí ẩn bất ngờ khác cũng đang trong quá trình chuẩn bị.\\u003cbr\\u003e\\u003cbr\\u003e[Liên Hệ Chúng Tôi]\\u003cbr\\u003eFacebook: https://www.facebook.com/groups/miniworldVN\\u003cbr\\u003eDiscord: https://discord.gg/miniworldcreatavn                                 \\u003cbr\\u003eCS Email：miniworldcustomerservice@gmail.com\"],\"MINI WORLD COMPANY LIMITED\",\"10.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/A7bpPuzlZTtdn7zAltMmEqHL5kSjO2yY4OFkxsoKB9CNskbPtBnTM5TZzPKMJYTWr_19jY9GMgtvNz0XVbZ7JA\"],null,[9,16,41,255]],null,[\"3 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Người dùng tương tác, Giao dịch mua trong trò chơi (bao gồm vật phẩm ngẫu nhiên)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.miniworldgame.creata.vn\\u0026rdid\\u003dcom.miniworldgame.creata.vn\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đặt\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"5.500 ₫ - 2.350.000 ₫ mỗi mặt hàng\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Phổ thông\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.asmr.mukbang.livestream.party\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/r7HGGyLtPBWIOWRNdXsYZ-lYnxoNN4VUNuoOSt29OkYCJl53W0E