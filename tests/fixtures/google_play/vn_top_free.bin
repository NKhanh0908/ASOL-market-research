sG9E2r7VzNlIt7cZ0CApdXaBmEbt41tVZBOirR0esT7HLQ\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/bdymG14d58_Y_zbkBeSJdjLBfnAQpdWFjpoFzJ8ah1mTyFZkUG1qoQ85ZdXtrTHSJLksxTPV96WucWliXfWG\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/0Sg1JlCEiwK96P_qrCs6Izo7MgRMaPq9dyoIQqvqLgBSumM-6g8eryHAswSLDmOvh0EQWIGRTRZ9MHqOAhoB\"]]],\"Sprunki All Phases Beat Maker\",[\"4,5\",4.5],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.sprunki.mod.horror.incredibox.monster.beats.music.phase\\u0026rdid\\u003dcom.sprunki.mod.horror.incredibox.monster.beats.music.phase\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.sprunki.mod.horror.incredibox.monster.beats.music.phase\"]],[\"qgKRARqOAQg3ShMIxO3Xr8eQlwMVDKNsCR2ByBtg+gEUChIIprCm6ff304pDEgYKAnZpEAC6Al0KQQo7Y29tLnNwcnVua2kubW9kLmhvcnJvci5pbmNyZWRpYm94Lm1vbnN0ZXIuYmVhdHMubXVzaWMucGhhc2UQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],[[[null,null,\"QB41P0WqroE\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:QB41P0WqroE?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:QB41P0WqroE\",null,null,null,null,\"AXH1ezmnxYPDMnlMr2KF8sFFHvkTw9vY46lMFpTRa4AoT6p-MCxV5t_zlgjuVi8sKIbqQ_ZPm_pMnPX5xyecb9W0bHVR_BL6iGkF3WvR0KLCP_cMalKyusB2FeVA6FtAQnVpdBiJr287pJIqrHFy7XPrcajAtWVNud7-LxX76Rmm7ICga0cQL93Z5jEky4lMdAjt7aM72Fx_p7IWcj8EoM_NfCR_RlcUQmdR5poVqAHnNaR_OfbbmJCmuMD8LPcQ2WMrStvCWmbGSk3tjU9GgGyZWkUTRMKDauySTspcsE9q2ZNwhw\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/QB41P0WqroE/hqdefault.jpg\"]]]],[null,\"Bước vào thế giới âm nhạc sôi động của Sprunki All Phases Beat Maker – một trình phối nhạc tương tác độc đáo, nơi những giai điệu dễ thương hòa quyện với âm thanh rùng rợn, hiệu ứng kinh dị và nhịp điệu sôi nổi. Hòa trộn giai điệu vui nhộn lẫn ma quái, giọng hát lạ tai và tiết tấu độc đáo trong một thế giới đầy màu sắc và bất ngờ. Bên cạnh phiên bản Sprunki gốc, hàng loạt bản mod theo chủ đề Sprunki sẽ mang đến sự đa dạng và thú vị về mặt âm nhạc.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eThỏa sức sáng tạo cùng Sprunki và những người bạn\\u003c/b\\u003e\\u003cbr\\u003eTạo nên những bản phối của riêng bạn cùng dàn nhân vật mang cá tính âm thanh riêng biệt như: Oren, Raddy, Clukr, Fun Bot, Vineria, Gray, Brud, Garnold, OWAKCX, Sky, Mr. Sun, Durple, Mr. Tree, Simon, Tunner, Mr. Fun Computer, Pinki, Jevin và Wenda – mỗi nhân vật đều sở hữu phong cách và âm thanh riêng biệt giúp bạn tạo ra bản nhạc độc đáo.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eCách chơi Sprunki All Phases Beat Maker\\u003c/b\\u003e\\u003cbr\\u003e1. Lắng nghe và chọn âm thanh yêu thích – từ nhịp trống, hiệu ứng, giai điệu đến giọng hát.  \\u003cbr\\u003e2. Kéo và thả biểu tượng – gán âm thanh cho từng nhân vật để tạo nên bản phối riêng.  \\u003cbr\\u003e3. Pha trộn nhịp điệu tuyệt vời, hiệu ứng độc đáo và giai điệu cuốn hút để tạo nên bản nhạc ấn tượng trong một thế giới hoạt họa sinh động.  \\u003cbr\\u003e4. Mở khóa các mod và các \\u0026quot;phase\\u0026quot; của Sprunki – khám phá các tổ hợp âm thanh ẩn. Để bất ngờ hơn, thử kéo nút đen lên một nhân vật để kích hoạt chủ đề kinh dị rùng rợn của Sprunki!\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eSprunki Phase 3 / Sprunki Phase 4 / Sprunki Phase 5\\u003c/b\\u003e\\u003cbr\\u003eKhám phá sự tiến hóa đầy cảm xúc của nhịp điệu qua chuỗi Sprunki Phase! Mỗi Phase mang đến những nhịp điệu mới, nhân vật mới và hiệu ứng hình ảnh đặc sắc – thách thức khả năng phối nhạc của bạn lên một tầm cao mới.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eSprunki OC Real / Sprunki OC 2\\u003c/b\\u003e\\u003cbr\\u003eTrải nghiệm OC2 Real – một bản mod được yêu thích với hình ảnh táo bạo và âm thanh mạnh mẽ. Với dàn nhân vật gốc và âm thanh rùng rợn, đây là trải nghiệm không thể bỏ qua đối với người hâm mộ Sprunki.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eSprunki Mustard\\u003c/b\\u003e\\u003cbr\\u003eSáng chói, sống động và khó quên. Mustard mang đến sắc vàng rực rỡ cùng các vòng lặp bắt tai và một cách tiếp cận vui nhộn với trải nghiệm Sprunki cổ điển.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eSprunki Baby Phase 3\\u003c/b\\u003e\\u003cbr\\u003eDễ thương nhưng hỗn loạn! Baby Phase 3 kết hợp thiết kế nhân vật đáng yêu cùng nhịp điệu sôi động, tạo nên một thử thách âm nhạc thú vị và bất ngờ.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eSprunki Pyramixed\\u003c/b\\u003e\\u003cbr\\u003eBước vào kim tự tháp. Pyramixed kết hợp sự huyền bí cổ đại với nhịp điệu hiện đại, mang đến hành trình âm thanh – hình ảnh độc đáo với nhiều lớp âm thanh và hoạt họa phong cách.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eVì sao nên chọn Sprunki All Phases Beat Maker?\\u003c/b\\u003e\\u003cbr\\u003e🎶 Trò chơi + Studio âm nhạc: Kết hợp mượt mà giữa gameplay hấp dẫn và công cụ tạo nhạc mạnh mẽ.  \\u003cbr\\u003e🎨 Trải nghiệm âm thanh – hình ảnh tương tác: Hoạt họa đẹp mắt và đồ họa sống động khiến mỗi lần chơi đều trở nên thú vị.  \\u003cbr\\u003e🤖 Kéo – Thả dễ dàng: Tự do thử nghiệm với vô số tổ hợp âm thanh để tạo ra giai điệu riêng.  \\u003cbr\\u003e🎁 Bất ngờ ẩn thú vị: Kéo nút đen bí ẩn vào ban nhạc để mở chế độ kinh dị đầy ma quái! Chuẩn bị sẵn sàng cho giai điệu ma mị và rùng mình đầy phấn khích.  \\u003cbr\\u003e🔮 Hộp nhạc pha trộn kỳ diệu: Thỏa sức khám phá vô số âm thanh và kết hợp nhân vật. Với nhiều phong cách âm nhạc đa dạng, bạn có thể tạo nên bản nhạc mang dấu ấn riêng của mình.\\u003cbr\\u003e\\u003cbr\\u003eTính năng sắp ra mắt mà bạn sẽ yêu thích:\\u003cbr\\u003e🎵 Nhiều không gian âm nhạc hấp dẫn để khám phá  \\u003cbr\\u003e🌟 Cập nhật định kỳ và bổ sung nhân vật/mod mới\\u003cbr\\u003e\\u003cbr\\u003eHãy bắt đầu hành trình tạo nhạc của bạn cùng Sprunki All Phases Beat Maker và trở thành huyền thoại âm nhạc trong vũ trụ nhịp điệu đầy màu sắc, liên tục đổi mới này!\"],\"Gotstar Studio\",\"10.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/2wPNI5mq44mcxxPxf3Zu8gZHlMESkTimiojFl1oGivW8RtrEtoPLhzO67sY6wJF-5dWSSNGdzYNZ1UAqwZUzKw\"],null,[60,167,254,255]],null,[\"3 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,[null,\"Phù hợp với tất cả các nhóm tuổi. Một số nội dung bạo lực trong ngữ cảnh hài hước hoặc tưởng tượng có thể được chấp nhận. Không cho phép ngôn từ thô tục.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.sprunki.mod.horror.incredibox.monster.beats.music.phase\\u0026rdid\\u003dcom.sprunki.mod.horror.incredibox.monster.beats.music.phase\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đặt\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"103.000 ₫ mỗi mặt hàng\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Phổ thông\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.spindreams.game\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/R5JDego4a71Sobv_gOufrFHh0UiO98pv4JcprdK-LCGA8xYei3PwkY_CWPf