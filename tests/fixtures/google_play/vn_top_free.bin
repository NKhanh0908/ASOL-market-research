ll,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.escape.tsunami.obby.running\\u0026rdid\\u003dcom.escape.tsunami.obby.running\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.escape.tsunami.obby.running\"]],[\"qgJ0GnIIXkoTCMTt16/HkJcDFQyjbAkdgcgbYPoBFAoSCIjC0cj+8Z2PQxIGCgJ2aRAAugJBCiUKH2NvbS5lc2NhcGUudHN1bmFtaS5vYmJ5LnJ1bm5pbmcQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],null,[null,\"Welcome to Obby Escape Keyboard Parkour, a fast-paced obby adventure where quick reflexes and perfect timing are the keys to survival!\\u003cbr\\u003e\\u003cbr\\u003eRun across giant keyboard platforms, jump over tricky obstacles, and move quickly before the keys disappear. Find the safe key, avoid falling, and enjoy satisfying ASMR keyboard sounds with every step.\\u003cbr\\u003e\\u003cbr\\u003eEach challenge brings a new test of your speed, timing, and parkour skills. Keep running, react quickly, and see how far you can go!\\u003cbr\\u003e\\u003cbr\\u003eBut the adventure doesn’t stop at the keyboard!\\u003cbr\\u003e\\u003cbr\\u003e🌊 Race through challenging obstacle courses and climb to safety before a giant tsunami catches you.\\u003cbr\\u003e\\u003cbr\\u003e⚽️ Train your strength, kick Lucky Blocks toward the goal, and unlock exciting surprises and rewards.\\u003cbr\\u003e\\u003cbr\\u003e🎮 Game Features 🎮\\u003cbr\\u003e\\u003cbr\\u003e⌨️ Exciting keyboard-themed parkour gameplay\\u003cbr\\u003e🎧 Satisfying ASMR keyboard typing sounds\\u003cbr\\u003e⚡️ Fast-paced challenges and smooth controls\\u003cbr\\u003e🏃 Run, jump, and dodge tricky obstacles\\u003cbr\\u003e🌊 Escape massive tsunami waves\\u003cbr\\u003e⚽️ Train and kick powerful Lucky Blocks\\u003cbr\\u003e🎁 Unlock fun characters, upgrades, and rewards\\u003cbr\\u003e\\u003cbr\\u003eCan you master the keyboard, escape the tsunami, and become the ultimate obby runner?\\u003cbr\\u003e\\u003cbr\\u003e👉 Play Obby Escape Keyboard Parkour now and put your reflexes to the test!\"],\"Null Talisman Studios\",\"500.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/ytlWSk5YofD2nLb02Kpwl7xvmJyB8iQHxrPTr-f0sPakkEnieuKOHvTUCvi8AUnt3P1amkRVcDl1QcrKTQB3\"],null,[246,144,239,255]],null,[\"3 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,[null,\"Phù hợp với tất cả các nhóm tuổi. Một số nội dung bạo lực trong ngữ cảnh hài hước hoặc tưởng tượng có thể được chấp nhận. Không cho phép ngôn từ thô tục.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.escape.tsunami.obby.running\\u0026rdid\\u003dcom.escape.tsunami.obby.running\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đặt\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Phổ thông\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.jgame.relaxgames\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/Tvk5XZ6BU1JTeNmGbmZk5prPef-2M1tH-U9BoIrSidGjsK3vLtMTShWB0bgPKolbAtwxe3x6S6s6wfR7Z9n2Iw\