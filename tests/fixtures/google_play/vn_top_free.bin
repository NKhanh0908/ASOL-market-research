,[2048,2732],[null,null,\"https://play-lh.googleusercontent.com/fNL3w0GogNmRnxoBDtAoMD7urb2fUsDsG65vDKhC7gmLKfwPCr9d5E-p7sBzTL1q6hbX15qtBVDjRFQmLcwa7w\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/tYVBgmMhYBe7S2HPXWVtvIcEngGPT0-TvbntYDDTrAji2ZLQtcDkTsM0xCTVjJYaNT8X2EwP9saA_pUB0rHByg\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/oVkCnvhc7RhuITM5IK3Twb9bJIt-m3o1CbO0tZtQGzzfZYE22sxJumR0qFffxMMiVnqO1TFu7c5cEKpoAcempA\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/pYGa6MfNaZAzPd1xMtx4pSKUqQH09E0eup1-H2GLlYgjAe6eR1eX7qcGq_6tPEEA74eMXDHGeK-OxZd8g5IGQg\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/t9LF6fRE0bnd_YoM43ENDQCoLvoZB1hk6rZdlNrpsymihLMlegl7zuXr1_d6FcSsAmqSiYZDJpcMzeAtmW_8\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/raY2OlrSKb31hZ-oagQLiwbWyEUf3tUzPy8vIRXQwaBQrMfLIOloC_69xReWFsgToUmvCkoduf5thNoIDT-tKg\"]]],\"Satisfying Toys : Calm Games\",[\"4,4\",4.423077],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.kkz.antistress.satisfying.relax.toys.games\\u0026rdid\\u003dcom.kkz.antistress.satisfying.relax.toys.games\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.kkz.antistress.satisfying.relax.toys.games\"]],[\"qgJ7GnkIO0oTCMTt16/HkJcDFQyjbAkdgcgbYPoBDAoKCAASBgoCdmkQAboCUAo0Ci5jb20ua2t6LmFudGlzdHJlc3Muc2F0aXNmeWluZy5yZWxheC50b3lzLmdhbWVzEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],[[[null,null,\"c__wo02Yefc\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:c__wo02Yefc?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:c__wo02Yefc\",null,null,null,null,\"AXH1ezmpftCOJUFY3_rfuqLsb75l8UOjIDDGCR4BzNj6geR6GwR11dlxJ5nJXA2HTZl3wa_m-Qu_Ha2yoZ5Fk3nYHcO9qkjGjTSW2wWLBalKuK89ckFGmYaIRyjBQDQ7HW2ufyr5m5S0kFM50qU1AN4DuZ3O3y3MX7CGOfRpg4g3IklD9pfc5LSYY_WBqPFRv0P8PU07S_O86BuItQU9hVlRBGL2UM7XMhhYVeqwSXpl6aNdfXHr8HVJsb-w8cJlg4hP4epaEM6fmwszFrMrrtIQU_plg9gTdzvw9Vp4qfBUJsOl_A\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/c__wo02Yefc/hqdefault.jpg\"]]]],[null,\"Take a break and dive into Satisfying Toys : Calm Games designed for anxiety relief and fun for all!\\u003cbr\\u003e\\u003cbr\\u003eEnjoy a wide variety of stress relief games where you can tap, pop, and fidget your way through trending mini games that are as soothing as they are satisfying. This collection brings you relaxing gameplay paired with ASMR sounds, challenging brain puzzles, and smooth visuals making it super easy to zone out and reset anytime, anywhere with our satisfying toys.\\u003cbr\\u003e\\u003cbr\\u003eWhether you\\u0026#39;re craving a pop it game, addictive ASMR, or some cleaning, repairing and cutting games to unwind, this antistress mini games collection brings you all-in-one sensory fun. These calming, antistress challenges are perfect for all ages looking for a little peace, a little focus, and a lot of calm.\\u003cbr\\u003e\\u003cbr\\u003eStep into your cozy corner of calm and begin your journey to relief with the antistress mini games.\\u003cbr\\u003e\\u003cbr\\u003eHere are just a few of the oddly satisfying games waiting for you:\\u003cbr\\u003e\\u003cbr\\u003e- Blob Opera: Drag the blob and feel the bass roar louder!\\u003cbr\\u003e- Say the word on beat challenge: Speak the right word on beat and stay     perfectly timed!\\u003cbr\\u003e- Stretch the boy: Stretch faces to the max \\u0026amp; watch them squish into funny shapes.\\u003cbr\\u003e- Keyboard: Smash the keys and enjoy the clicky, satisfying keyboard sounds.\\u003cbr\\u003e- Fireworks flare: Launch fireworks and watch them sparkle with blasts.\\u003cbr\\u003e- Slime squeezer: Squish and play with slime anytime, anywhere.\\u003cbr\\u003e- Ping pong hop: Quick reflex fun to refresh your brain.\\u003cbr\\u003e- Bubble blister: Drag your finger across the screen to pop every bubble.\\u003cbr\\u003e- Arrow games: Aim and land the perfect shot every time.\\u003cbr\\u003e- Dalgona cutter: Carve the dalgona candy carefully, so satisfying when done right.\\u003cbr\\u003e- Cooking Games: Chop, cook and create delicious dishes.\\u003cbr\\u003e- Spinner challenge: Spin your stress away with a fidget spinner.\\u003cbr\\u003e- Nail grooming: Apply stunning nails with one smooth tap.\\u003cbr\\u003e- Hair makeover games: Give hair a fresh cleaning and satisfying makeover.\\u003cbr\\u003e\\u003cbr\\u003eDownload now and discover more crazy mini games! Release your stress anytime with our satisfying virtual toys collection!\"],\"Koko Zone\",\"10.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/G7bQxY0_uX-L0aUtsxf0yA2ed0PID4R16HWkU8EHwN4iuAZImqPY9aI8eFs0rxXt13xaaW6xxGHgwmb02nTl_o4\"],null,[241,243,243,255]],null,[\"3 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Mua hàng trong trò chơi\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.kkz.antistress.satisfying.relax.toys.games\\u0026rdid\\u003dcom.kkz.antistress.satisfying.relax.toys.games\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đ