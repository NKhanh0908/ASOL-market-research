00],[null,null,\"https://play-lh.googleusercontent.com/3RDYh2rDVN34g-LaYtKcfIyEwcVg_0lcampEQ9mLEopvI47NtDAAFiMl5MQQtZiRJ68M6wj2dhdpgZFNIU92Rw\"]],[null,2,[2880,1800],[null,null,\"https://play-lh.googleusercontent.com/PtXJlHsF3rYSiZHE36Fa2U9PU7aqCgr7dNhWnMBls38ZgHll6vULfNnbap2aRNMfymTDdpLUWHhTaCBic8HLe1s\"]],[null,2,[2880,1800],[null,null,\"https://play-lh.googleusercontent.com/6gLOPJNCO0bb8Svam5W3sRrpFxE_6fDIg6M3_6SBGr_Z6d9sHpjn0y8Gq2zQy9uVo0fAoUsksQIFNg_cchuP\"]],[null,2,[2880,1800],[null,null,\"https://play-lh.googleusercontent.com/reV9OdAjdcIwWDEC_l_4QAvttBp-Jwpc7R7zsX3j8Ojgfu11tpcZSnbVfW1k2TDGs684dtPZLHYDriM83HzDog\"]],[null,2,[2880,1800],[null,null,\"https://play-lh.googleusercontent.com/HnEsnjOhRwL7E90h8t788DINNiD-jSGyaxbzoyBosIvUXCUoXDmvKJYNJbMvpeHrC6WGz4QSB0RMQ-sr7NWK\"]],[null,2,[2880,1800],[null,null,\"https://play-lh.googleusercontent.com/OMuHJXym7b8UPzmwoBoc0f1RCIZYBYKf9SBAnFdJzy-_r29QFSD9T3JCWdslHA3nPtQjC8sY_hNs0dpmZb456AQ\"]],[null,2,[2880,1800],[null,null,\"https://play-lh.googleusercontent.com/6sz3HSbMwRwIfrkLvTYqm6XEn8JJ1XsxZ2EItJpouw2n01vMAcEerMgyvIarAbfQy0gxotOrxiYu1J1ZlPbKYg\"]],[null,2,[2880,1800],[null,null,\"https://play-lh.googleusercontent.com/3RDYh2rDVN34g-LaYtKcfIyEwcVg_0lcampEQ9mLEopvI47NtDAAFiMl5MQQtZiRJ68M6wj2dhdpgZFNIU92Rw\"]],[null,2,[2880,1800],[null,null,\"https://play-lh.googleusercontent.com/PtXJlHsF3rYSiZHE36Fa2U9PU7aqCgr7dNhWnMBls38ZgHll6vULfNnbap2aRNMfymTDdpLUWHhTaCBic8HLe1s\"]]],\"Tom Biết Nói Của Tôi\",[\"4,3\",4.3301206],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.outfit7.mytalkingtomfree\\u0026rdid\\u003dcom.outfit7.mytalkingtomfree\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.outfit7.mytalkingtomfree\"]],[\"qgJpGmcIF0oTCMTt16/HkJcDFQyjbAkdgcgbYPoBDAoKCAASBgoCdmkQALoCPgoiChxjb20ub3V0Zml0Ny5teXRhbGtpbmd0b21mcmVlEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"Tom Biết Nói Của Tôi (My Talking Tom) là trò chơi mà sẽ biến mỗi ngày thành một cuộc phiêu lưu thú vị.\\u003cbr\\u003e\\u003cbr\\u003eNgười chơi nhận nuôi thú cưng ảo này, giúp Tom luôn vui vẻ và giúp Tom khám phá thế giới của mình.\\u003cbr\\u003e\\u003cbr\\u003e- Tom Biết Nói là chú mèo thực sự biết nói chuyện\\u003cbr\\u003e- Thu thập các vật phẩm thời trang và nội thất\\u003cbr\\u003e- Mini game củng cố thêm nhiều hành động, chuyến phiêu lưu và niềm vui\\u003cbr\\u003e- Những địa điểm du lịch đang chờ đợi được khám phá\\u003cbr\\u003e- Album ảnh với biết bao kỉ niệm\\u003cbr\\u003e- Và hơn thế nữa\\u003cbr\\u003e\\u003cbr\\u003eTừ Outfit7, công ty sáng tạo ra My Talking Tom 2, My Talking Tom Friends, My Talking Angela 2 và My Talking Angela.\\u003cbr\\u003e\\u003cbr\\u003eỨng dụng này có chứa:\\u003cbr\\u003e- Quảng bá sản phẩm và quảng cáo của Outfit7;\\u003cbr\\u003e- Liên kết hướng khách hàng đến các trang web của Outfit7 và các ứng dụng khác;\\u003cbr\\u003e- Cá nhân hóa nội dung để khuyến khích người dùng không ngừng chơi ứng dụng;\\u003cbr\\u003e- Tích hợp YouTube để cho phép người dùng xem video về các nhân vật hoạt hình của Outfit7;\\u003cbr\\u003e- Tùy chọn để mua hàng trong ứng dụng\\u003cbr\\u003e- Gói đăng ký tự động gia hạn khi kết thúc thời gian gói đăng ký trừ khi bị hủy. Bạn có thể quản lý và hủy gói đăng ký của mình bất kỳ lúc nào thông qua mục Cài đặt trong tài khoản Google Play của mình;\\u003cbr\\u003e- Các vật phẩm để mua (có sẵn ở các mức giá khác nhau) bằng tiền ảo, tùy thuộc vào tiến trình của người chơi;\\u003cbr\\u003e- Các tùy chọn thay thế để truy cập tất cả các chức năng của ứng dụng mà không cần thực hiện bất kỳ giao dịch mua hàng trong ứng dụng nào bằng tiền thật.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003eĐiều khoản sử dụng: https://talkingtomandfriends.com/eula/en/\\u003cbr\\u003eChính sách quyền riêng tư dành cho trò chơi: https://talkingtomandfriends.com/privacy-policy-games/en\\u003cbr\\u003eHỗ trợ khách hàng: support@outfit7.com\\u003cbr\\u003eGiấy xác nhận số 162/GXN-PTTTH\\u0026amp;TTĐT cấp bởi Cục Phát thanh, Truyền hình và Thông tin điện tử ngày 20/09/2023\"],\"Outfit7 Limited\",\"1.000.000.000+\",null,null,null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/Uj6LsxlFPOs32u69TW5dPRgxeHCyv9xbIe3PPHEMTv92D5KHoYIYCJfsh-Xd1cWBS-iw9JQtneI69mgqtsJp\"],null,[118,208,229,255]],null,[\"7 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/1SrNtAwg9PFOhgMJPXehacRTeQNhHhG12Pj1zACHNVmfRfEZA3_oOEmLvRNsmYGeGHpas7sCwyR3y8OT\"]],[null,\"Bạo lực nhẹ nhàng\"],[null,\"Mua hàng trong trò chơi\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/JTT-ImEkrbWzIL7w0fP8fQhVmpexdfh7u0P59PJtyJywmQBVolJjunMal6B5dUM6uiFiKnmtHtBbVvcWBMU\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.outfit7.mytalkingtomfree\\u0026rdid\\u003dcom.outfit7.mytalkingtomfree\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đặt\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"25.818 ₫ - 2.607.639 ₫ mỗi mặt hàng\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Phổ thông\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.amb.fashion.fit.leftright\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/ccB19TaUK3DvFqX1bYVSUtJvDHkPuA-lohTd8eVT-e8Gkgi5VIi5ba-8ruTQODjtQo7HVqVbLiSsv_q3gTY5uw\"],null,[48,47,53,255],null,null,null,2],[[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/O9E35qGJUfesi7UeIA367M2PEGEIN2lHfXMtUD5vZxHxBKqVzbb34beP8tJDv7kUNgL8nhEk8Zr0TPe25gbK\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/xu5JUT-GYjmLx1DqLnlzepZC04zwgg9Shfn1iyBHYMmju-oLz-1uLVHzyN_wkK2lQdcoJ0ryrH4fTV1rkplNcQ\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/d9fA4e4E3JE7Rz0agj2P1Tk6pgG-0_QDI88qfFdrUNpp6_-56prq2E3GQgMRDfwZmLhtSoT4ajt-1xS-IdQ\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/pQpohXRMF-CqhFaZ7pmGjMrlWxS8Cx28iPnOuNvQokAE7b06crDYzTo1H3G79taAtO5zzr5faH5ZdV3M2IDWbw\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/fmoe_gCEkRThH1wYBCFKT8O13TB7pUsQa1csfsJldxw0NGjFhySAtUA6rHTX7ih2Yq6_ORydABJSe088C6oVXyM\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/3BhqijYqn7Oo-IbnL5ANI29nrqt4D0M24yQsCfV-6d5NKxVT1t7E__JIKUFSc2kzshZe8sqJT3t453jqzvqq\"]]],\"Left or Right: Dress up Show\",[\"3,3\",3.34],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.amb.fashion.fit.leftright\\u0026rdid\\u003dcom.amb.fashion.fit.leftright\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.amb.fashion.fit.leftright\"]],[\"qgJqGmgIGEoTCMTt16/HkJcDFQyjbAkdgcgbYPoBDAoKCAASBgoCdmkQAboCPwojCh1jb20uYW1iLmZhc2hpb24uZml0LmxlZnRyaWdodBABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"Dive into the vibrant world of fashion with 🎀Left or Right: Dress Up Show🎀, a game designed for trendsetters and style enthusiasts.\\u003cbr\\u003e\\u003cbr\\u003eAre you ready to become the ultimate fashion stylist and showcase your style prowess? In Left or Right: Dress Up Show, you will experience an exciting dress-up adventure. Unlike traditional dress-up games, this game offers a unique gameplay mechanic where you choose between two options - left or right - to style your character. Each choice you make will determine the look of your character, from head to toe. Once you\\u0026#39;re done, it\\u0026#39;s time to enter the Dress-up Show and compete against other stylists to see whose outfit is more fashion!\\u003cbr\\u003e\\u003cbr\\u003e👗 Key Features:\\u003cbr\\u003e- Fashion Gameplay: Choose between left or right options to style your character.\\u003cbr\\u003e- Style Battles: After dressing up your character, compete in exciting fashion battles. Show off your fashion styling skills.\\u003cbr\\u003e-  Explore a vast collection of clothing, accessories, hairstyles, and more. With countless combinations, you can create unique and stunning looks.\\u003cbr\\u003e- Regular Updates: Stay ahead of fashion trends with new outfits and accessories. Whether you prefer casual, party, beach, or wedding styles, this game offers endless possibilities for creative expression.\\u003cbr\\u003e\\u003cbr\\u003e👠How to Play:\\u003cbr\\u003e- Choose Your Style: Select from various fashion items by picking left or right.\\u003cbr\\u003e- Fashion Showdown: Once you\\u0026#39;ve dressed up your character, enter into fashion battles where you compete. The best-dressed character wins!\\u003cbr\\u003e\\u003cbr\\u003eAre you ready to make fashion choices that will captivate the world? Download  🎀Left or Right: Dress Up Show 🎀 today and unleash your inner stylist. Don\\u0026#39;t miss out on the fashion fun – join the style showdown now!\"],\"OAK Adventures Studio\",\"5.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/izFWdqOjEFAyB-lymAoxlrbDL6SmWcHiiTTxg_cT6RtpPv20Fjk--A-zkbgPVzAAslqE7jd6tnZ5nWSGvcCFZQ\"],null,[247,173,228,255]],null,[\"3 tuổi trở lên\",[null,2,[