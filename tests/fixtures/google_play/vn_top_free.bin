ull,null,\"https://play-lh.googleusercontent.com/UmQeoxdoQ-yudvxLo2HaeLaDSFXbQcbnY-9peny3bMg5bklQT3clEs1rzT5qsG5gFByNdtCG4CvHQjFEB63wWQ\"]],[null,2,[2400,1080],[null,null,\"https://play-lh.googleusercontent.com/ToO9-CZ4vrCC7a09Bst2SY5mv5T1eRFDBIzWPLdgG0Wsurkf7ep8nsBvQVdX8y246RHbHrwphIspUxrJSzaBZw\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/TKsHdS5EFkVcGRof5b5iPmjv5gL7cEcqJbPP-e2N9356bfWvSTXqXpVa4oHPGgipkD7wgQ5Fw1KAvNLmJK_I\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/f-8cu_r4pcMMXGIKFPqJvO0CQWk7RzDgy4EBv52tL7mKuCBePQlF6-SBvxSU3t56_fOjlB1chmWFbI5kV7dQ\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/JXYDfHDPul4ZvJoLpeMRAC_vie233GgVQBcdgWoVdWyvDQVLvXsgaHKDNjHv7x1U76Fqqjv0npXij1mD5cGHBA\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/0kWs_UdG5UeeWDKNoSTF3m6NQyVmSezVmFLZu7CclHoGdalPHV5EXNrKQQooa2Gu6cFw1Di6DoePCTg7KpXi86I\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/4wZcT4Tp3DHDwxJ7YBxqOIgdM33hCJ--3163ULqx2IotXv01jcMtXjr628IZ0kw35CAnpbc18fehe9QIpE18jwE\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/UmQeoxdoQ-yudvxLo2HaeLaDSFXbQcbnY-9peny3bMg5bklQT3clEs1rzT5qsG5gFByNdtCG4CvHQjFEB63wWQ\"]]],\"Little Corner Tea House\",[\"3,5\",3.5405405],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.loongcheer.unicon.littlecornerteahouse\\u0026rdid\\u003dcom.loongcheer.unicon.littlecornerteahouse\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.loongcheer.unicon.littlecornerteahouse\"]],[\"qgJ3GnUIK0oTCMTt16/HkJcDFQyjbAkdgcgbYPoBDAoKCAASBgoCdmkQALoCTAowCipjb20ubG9vbmdjaGVlci51bmljb24ubGl0dGxlY29ybmVydGVhaG91c2UQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],[[[null,null,\"NMrvrGRD42g\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:NMrvrGRD42g?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:NMrvrGRD42g\",null,null,null,null,\"AXH1eznJphBakcK6lOHQQWKAdhGfdk21FppxilD8KcufKqpXNyxnxjnohAfrpvoquo6Epj9WU72GRZMRLmizdnZyk8jim2_yIvEk4LBxR71_67x62EEo9R2eyCYdrDAyCv5C8HQSghD7Pn7QJPLeFBb6LAmRxkDLy5SmPHVDklU_EP1-kE6nIicm3YOHWAy7mSoOuXgJpf_Wh_ZES4SbuCId1qTWvy5zpOavpd-RfJNtwNpCQ64W2eSQOBDjwbSIEjLTBDHSRPG9RsaMv5mJX5q9aDhWPKdBK9XjbY12yhecUKgvwg\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/NMrvrGRD42g/hqdefault.jpg\"]]]],[null,\"Chào mừng đến với quán trà nhỏ xinh! Hãy phục vụ trà, cà phê và nhiều thức uống khác để mang đến cho mọi người một không gian yên bình để thư giãn.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cfont color\\u003d\\\"blue\\\"\\u003e\\u003cb\\u003eGiới thiệu trò chơi\\u003c/b\\u003e\\u003c/font\\u003e\\u003cbr\\u003e\\u003cbr\\u003eLittle Corner Tea House là một game mô phỏng nhẹ nhàng, nơi bạn có thể tự tay pha chế những món đồ uống yêu thích và trò chuyện cùng nhiều khách hàng khác nhau để tìm thấy sự thư thái.\\u003cbr\\u003e\\u003cbr\\u003e■\\u003cfont\\u003e\\u003cb\\u003eCốt truyện\\u003c/b\\u003e\\u003c/font\\u003e\\u003cbr\\u003eNhân vật chính của chúng ta, Hana, đang làm thêm và tự mình quản lý một quán trà nhỏ ở góc phố. Bạn sẽ giúp Hana pha chế đủ loại đồ uống, trồng trọt nguyên liệu, tự tay làm những con búp bê độc đáo, trang trí quán... Bên cạnh việc giải trí, bạn còn được lắng nghe những câu chuyện thú vị từ các vị khách. Liệu những câu chuyện ấm áp và tuyệt vời nào sẽ diễn ra tại ngôi nhà nhỏ đầy sức sống này? Hãy cùng BẮT ĐẦU và khám phá nhé!\\u003cbr\\u003e\\u003cbr\\u003e\\u003cfont color\\u003d\\\"blue\\\"\\u003e\\u003cb\\u003eTính năng nổi bật\\u003c/b\\u003e\\u003c/font\\u003e\\u003cbr\\u003e\\u003cbr\\u003e■\\u003cfont\\u003e\\u003cb\\u003eTrải nghiệm trồng trọt và mô phỏng chân thực\\u003c/b\\u003e\\u003c/font\\u003e\\u003cbr\\u003eTRẢI NGHIỆM quy trình trồng trọt thực tế: Gieo hạt! Hái lá! Sấy khô! Rang! Thu hoạch! Bạn sẽ được theo dõi sát sao từng giai đoạn phát triển của cây trà.\\u003cbr\\u003eQuản lý quán trà của bạn để trở thành bậc thầy trong thế giới game mô phỏng nấu ăn. Sử dụng nguyên liệu thu hoạch để pha chế đa dạng thức uống, làm hài lòng mọi khách hàng. Đừng quên ghi nhớ sở thích của họ nhé, đó là yếu tố quan trọng giúp việc kinh doanh của bạn phát triển đấy!\\u003cbr\\u003e\\u003cbr\\u003e■\\u003cfont\\u003e\\u003cb\\u003eChế độ gọi món độc đáo\\u003c/b\\u003e\\u003c/font\\u003e\\u003cbr\\u003eTHỬ TÀI đoán ý khách hàng qua những câu đố vui. Nếu có khách nói \\u0026quot;Mây vui vẻ\\u0026quot;, bạn nghĩ đó là đồ uống gì? Có phải là bất kỳ loại đồ uống nào có kem không? Mỗi khách hàng sẽ đưa ra những câu đố về đồ uống khác nhau~ Nhiệm vụ của bạn là đoán đúng món họ muốn và pha chế cho họ.\\u003cbr\\u003e\\u003cbr\\u003e■\\u003cfont\\u003e\\u003cb\\u003eMở khóa đa dạng thức uống\\u003c/b\\u003e\\u003c/font\\u003e\\u003cbr\\u003eTỰ TAY PHA CHẾ hàng trăm loại đồ uống được yêu thích từ khắp nơi trên thế giới! Có hơn 200 công thức đồ uống như trà gia vị, trà ô long, trà mứt, và cả nhiều loại cà phê hấp dẫn. Hãy sáng tạo ra những món đồ uống mang đậm dấu ấn của riêng bạn!\\u003cbr\\u003e\\u003cbr\\u003e■\\u003cfont\\u003e\\u003cb\\u003eTrải nghiệm game thư giãn tuyệt đối\\u003c/b\\u003e\\u003c/font\\u003e\\u003cbr\\u003eBạn có thể hoàn toàn THƯ GIÃN tại đây! Thưởng thức âm nhạc nhẹ nhàng, lắng nghe những câu chuyện đời thường từ khách hàng và đắm chìm trong những câu chuyện minh họa đẹp mắt. Hãy để tâm hồn bạn được tĩnh lặng trong thế giới game này!\\u003cbr\\u003e\\u003cbr\\u003e■\\u003cfont\\u003e\\u003cb\\u003eSự kiện theo mùa phong phú\\u003c/b\\u003e\\u003c/font\\u003e\\u003cbr\\u003eTHU THẬP vô vàn tài nguyên giá trị qua các sự kiện theo mùa. Đừng bỏ lỡ bất kỳ sự kiện đáng yêu nào: Công viên giải trí, Thành phố Steampunk, Thần thoại Hy Lạp La Mã, Thời kỳ Phục hưng lãng mạn và hơn 70 sự kiện theo chủ đề mùa khác đang chờ bạn khám phá.\\u003cbr\\u003e\\u003cbr\\u003e■\\u003cfont\\u003e\\u003cb\\u003eTự tay làm búp bê và trang trí quán\\u003c/b\\u003e\\u003c/font\\u003e\\u003cbr\\u003eSự sáng tạo của bạn là không giới hạn trong game. TỰ DO THIẾT KẾ những con búp bê đáng yêu và trang trí quán theo phong cách bạn yêu thích. Hãy biến quán trà của bạn trở nên thật đặc biệt và độc đáo.\\u003cbr\\u003e\\u003cbr\\u003e■\\u003cfont\\u003e\\u003cb\\u003eNhững cuộc phiêu lưu theo chủ đề hấp dẫn\\u003c/b\\u003e\\u003c/font\\u003e\\u003cbr\\u003eGame sẽ không bao giờ nhàm chán. Bắt đầu hành trình độc đáo cùng búp bê của bạn để thu thập tài nguyên phong phú từ các cuộc phiêu lưu. Có rất nhiều cuộc phiêu lưu theo chủ đề để bạn lựa chọn, như Cuộc phiêu lưu trên đảo nắng(Mùa xuân), Cuộc phiêu lưu nhật ký của Hana(Mùa hè) và Cuộc phiêu lưu trong vườn ký ức(Mùa thu), v.v.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cfont color\\u003d\\\"blue\\\"\\u003e\\u003cb\\u003eCộng đồng\\u003c/b\\u003e\\u003c/font\\u003e\\u003cbr\\u003eFacebook: https://www.facebook.com/TeaHouseCosy\"],\"Loongcheer Game\",\"1.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/gzm6AyMmSCL_WBqBP5Jb1f6CB_J5xHMbThVUFrD7URu7Hf7FTFGhqVis5lXIzkGipFG4r0IeGYN_c0Loz-IbCw\"],null,[246,247,224,255]],null,[\"3 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Mua hàng trong trò chơi\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.loongcheer.unicon.littlecornerteahouse\\u0026rdid\\u003dcom.loongcheer.unicon.littlecornerteahouse\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đặt\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"26.000 ₫ - 1.800.000 ₫ mỗi mặt hàng\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Phổ thông\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.rc29.sandbox.spronky.horror.monster\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/HBHCRNpW_P0sevL2Yzi_eejsNEkW6OdnfJj_mfvPK_aSL2-mf5uPbAG-YXgnLWSubAjs4PtoCQkCf2EN0Y3xww\"],null,[253,253,253,255],null,null,null,2],[[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/QN8S116auaXDUXza5kMVTjfaYO38CaCkMN8msdLEAGpfJRy_o4J475bEl_mQLgPsa6LiTyWISQtsfwhKnYYc\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/7dL3PFyvYY3IN4jG6-K4hpTuP7xD5wcycmTdFP00Iab42yyB_IE79o04-0uAE_-x6fODSBoOz-3IgDtgzo9KtYY\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/QaQxGOfo5_tblCNtiATZuC96FfUGukVam0_7y6bTdjKK4vQHdzwMYCFHuIAMR4tVc8ehmvTY6yIiMyOKkqlo\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/uqoiZa6P_t-0_MbR50ptK8RIpt56jf99KEHQCldlZrn_dUqS4jx4_5v3zuPrsZd_s99c_EtePjIXJh4rKZKCsg\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/jAaQH684kj0Br5CZKvNRKZo2M-7oWprm3dIosUHfquB43f3eldql_yEVWDHhJ2vdyujKgUk0GEDmWWnxQzB4no0\"]]],\"Horror Multiverse: Sandbox\",[\"3,6\",3.58],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.rc29.sandbox.spronky.horror.monster\\u0026rdid\\u003dcom.rc29.sandbox.spronky.horror.monster\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.rc29.sandbox.spronky.horror.monster\"]],[\"qgJ0GnIILEoTCMTt16/HkJcDFQyjbAkdgcgbYPoBDAoKCAASBgoCdmkQAboCSQotCidjb20ucmMyOS5zYW5kYm94LnNwcm9ua3kuaG9ycm9yLm1vbnN0ZXIQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],null,[null,\"Horror Multivers: Sandbox\\u003cbr\\u003e\\u003cbr\\u003eUnleash your inner mad scientist in Horror Multivers: Sandbox, the ultimate ragdoll playground where chaos reigns supreme! This physics-based sandbox experience puts you in control of a vast arsenal of weapons, tools, and contraptions, all designed for maximum Ragdoll torment. \\u003cbr\\u003e\\u003cbr\\u003eDive into a dynamic sandbox environment where you can experiment with everything from melee weapons like swords and axes to powerful firearms, explosives, and even bizarre machinery. Watch as the Sprank ragdolls react realistically to every impact, creating hilarious and often outrageous scenarios.\\u003cbr\\u003e\\u003cbr\\u003eHorror Multivers: Sandbox offers endless possibilities for creative destruction. Build intricate traps, launch Sprank into the stratosphere, or simply enjoy the satisfying crunch of a well-placed explosion. With no objectives or limitations, the only limit is your imagination.\\u003cbr\\u003e\\u003cbr\\u003eKey Features: \\u003cbr\\u003e\\u003cbr\\u003e    Ragdoll Physics: Experience realistic and hilarious ragdoll physics as you interact with the Sprank characters.\\u003cbr\\u003e    Sandbox Playground: Explore a vast and open sandbox environment, perfect for experimentation and mayhem.\\u003cbr\\u003e    Extensive Arsenal: Choose from a wide variety of weapons, tools, and machinery to inflict maximum damage.\\u003cbr\\u003e    Endless Possibilities: Create your own unique scenarios and unleash your creativity in this chaotic playground.\\u003cbr\\u003e    Sprank Characters: Interact with the lovable yet unfortunate Sprank ragdolls.\\u003cbr\\u003e\\u003cbr\\u003eHorror Multivers: Sandbox is the perfect game for those who enjoy physics-based sandbox games and the satisfying chaos of ragdoll destruction. Download now and let the Sprank torment begin!\"],\"Isandares\",\"5.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/yOxmJYhQEfJu6KTg0iyPjJ_btBUJ6JsjfOJlFF-UCdD89XyLF8aw0zY-OKQO1rPygg3ivPaHMt7qR5dLdC5P4g\"],null,[48,46,53,255]],null,[\"7 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/1SrNtAwg9PFOhgMJPXehacRTeQNhHhG12Pj1zACHNVmfRfEZA3_oOEmLvRNsmYGeGHpas7sCwyR3y8OT\"]],[null,\"Bạo lực nhẹ nhàng\"],null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/JTT-ImEkrbWzIL7w0fP8fQhVmpexdfh7u0P59PJtyJywmQBVolJjunMal6B5dUM6uiFiKnmtHtBbVvcWBMU\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.rc29.sandbox.spronky.horror.monster\\u0026rdid\\u003dcom.rc29.sandbox.spronky.horror.monster\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đặt\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"25.000 ₫ - 754.000 ₫ mỗi mặt hàng\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Phổ thông\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.hub2.fishingbattle\",7],[null,2