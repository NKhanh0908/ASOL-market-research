,\"https://play-lh.googleusercontent.com/2_4p-i9rNUlizrKSgf5f_V8loByA7elt3ExX2X5aAvQbJ34d2_HjH5VYSlgSR7TIj5HVhWOUwAmLUy8QUOddbJM\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/MbsiP_MbTGUfdiHGYde-xWgH0v1dL2fERl3CqN-lV0B0b9C1shzLUaMEWeFFmt2lQ4jilVpFiEwkbWutH73M\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/-jwY-u35ifaqvCkGhfzgFZ81gRuMrX7VuRKYTjSe5qncFpErj80SVokBfn5K0wEbSrYKE2CbJcGRXHUCQfr-\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/pVq0Se2ZgE96nom4Z80NsDTlDp3XyWJCpRozll-bk213zy1YCtIA5xZxqfkr-GVi0ZHOwByr0Px4O2SdrSqceg\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/F-g2ixoW8rhS2ew2ed3LKO79Ukfciznw3bPF59hRgPsJJApDLHGLfgAuqFwI6z6ilKaLLK-EfZ7Qb2X0gEJNCw\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/P6BZvlIsV-SN5LwHhe6qyXx7EI028PKtPvzSGRewh4FkJzd2oeLrzsAZZsirULZI0AAwk9dsSTkK22ViVZTBvA\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/90nRLjw4Sl4WqiXKO3vSPoL60ysOiJ7ltSiS_534cvfrM8p0SoglDxSS9BhhtP1T5NHCKryUq5gXIeINvqg_\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/zCL2AtaQLE5bxn077PJgpF1bY9lPU2rQRpVrTvdGu_JwLiTa4SR1whSwmO247b6X_ut8LQzxX8Y7xR2TFJG11Q\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/2_4p-i9rNUlizrKSgf5f_V8loByA7elt3ExX2X5aAvQbJ34d2_HjH5VYSlgSR7TIj5HVhWOUwAmLUy8QUOddbJM\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/MbsiP_MbTGUfdiHGYde-xWgH0v1dL2fERl3CqN-lV0B0b9C1shzLUaMEWeFFmt2lQ4jilVpFiEwkbWutH73M\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/-jwY-u35ifaqvCkGhfzgFZ81gRuMrX7VuRKYTjSe5qncFpErj80SVokBfn5K0wEbSrYKE2CbJcGRXHUCQfr-\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/pVq0Se2ZgE96nom4Z80NsDTlDp3XyWJCpRozll-bk213zy1YCtIA5xZxqfkr-GVi0ZHOwByr0Px4O2SdrSqceg\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/F-g2ixoW8rhS2ew2ed3LKO79Ukfciznw3bPF59hRgPsJJApDLHGLfgAuqFwI6z6ilKaLLK-EfZ7Qb2X0gEJNCw\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/P6BZvlIsV-SN5LwHhe6qyXx7EI028PKtPvzSGRewh4FkJzd2oeLrzsAZZsirULZI0AAwk9dsSTkK22ViVZTBvA\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/90nRLjw4Sl4WqiXKO3vSPoL60ysOiJ7ltSiS_534cvfrM8p0SoglDxSS9BhhtP1T5NHCKryUq5gXIeINvqg_\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/zCL2AtaQLE5bxn077PJgpF1bY9lPU2rQRpVrTvdGu_JwLiTa4SR1whSwmO247b6X_ut8LQzxX8Y7xR2TFJG11Q\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/2_4p-i9rNUlizrKSgf5f_V8loByA7elt3ExX2X5aAvQbJ34d2_HjH5VYSlgSR7TIj5HVhWOUwAmLUy8QUOddbJM\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/MbsiP_MbTGUfdiHGYde-xWgH0v1dL2fERl3CqN-lV0B0b9C1shzLUaMEWeFFmt2lQ4jilVpFiEwkbWutH73M\"]]],\"Capybara Jump: Cake Tower\",[\"4,5\",4.5427217],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.caketower.building.jump.capybara\\u0026rdid\\u003dcom.caketower.building.jump.capybara\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.caketower.building.jump.capybara\"]],[\"qgJxGm8IIEoTCMTt16/HkJcDFQyjbAkdgcgbYPoBDAoKCAASBgoCdmkQAboCRgoqCiRjb20uY2FrZXRvd2VyLmJ1aWxkaW5nLmp1bXAuY2FweWJhcmEQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],null,[null,\"How much higher can you build on...cake tower??\\u003cbr\\u003e\\u003cbr\\u003e🐹 Let\\u0026#39;s build your own cake tower! Cute Capybara will jump in the middle of each cake for extra acrobatic jumps. Many gifts, bonuses in game that are waiting for you to unlock. Help the Capybara on the top floor of the pudding tower and get out of the universe!\\u003cbr\\u003e\\u003cbr\\u003e[Game Features]\\u003cbr\\u003e✨ Very fun and enjoyable game\\u003cbr\\u003eTap to jump. Help cute Capybara to climb the tower of deliciously bouncy pudding trampolines.\\u003cbr\\u003e✨ Addictive gameplay\\u003cbr\\u003eChallenge your balance ability. Relax in the cheerful music and immerse yourself in the endless loop of pudding jumping! Try perfecting each jump to unleash the acrobatic genius hidden inside your!\\u003cbr\\u003e✨ No need an internet connection\\u003cbr\\u003eYou can play wherever, whenever you want.\\u003cbr\\u003e✨ Unlock lots of cute skins!\\u003cbr\\u003eFancy new clothes for your Capybara? Collect as much gold as you can by making perfect jumps!\\u003cbr\\u003e\\u003cbr\\u003e【How to Play】\\u003cbr\\u003e1. Tap to jump, land in the middle of cake for perfect jumps.\\u003cbr\\u003e2. Perfect jump gives a higher score and gold reward.\\u003cbr\\u003e3. Use your gold to unlock more skins.\\u003cbr\\u003e\\u003cbr\\u003e🌈 Download Capybara Jump: Cake Tower now and enjoy moments of entertainment with your friends!\"],\"CAT Studio\",\"1.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/YdV0o8Wcn8bgaWsarWeWWH9l8Yj2MEkLVftgm7spaP16VmVHEgNYMT_s2SUFtn2pcJi_-toYPKEVUsLx0XvIYQ\"],null,[175,230,253,255]],null,[\"3 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Mua hàng trong trò chơi\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.co