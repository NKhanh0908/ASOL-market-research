,1242],[null,null,\"https://play-lh.googleusercontent.com/flokQ1tuz_oTfS-kVDfZMb8tkIqu5cuZDcB05aGavqkljjhXGqfFPfzE-kanRWGS5YfPJJEdrkweojKjf5-JDg\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/o8t3sxQguVVHQsZgwjI8DmdYRBw6SilfegkLi8rxjX0Q9-nemI85YC0i9KEKNT-Eyy9YAtf5SnGZQC_rodFJIjQ\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/M5QBeWWReBgcdiM1HPSZyKCmW51Fyi4OVBLJYvmfsHufHeKTg2pBtA2mbNJ4x4JGmri_iOaFoBDwOUr2gr9G6w\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/LhfGb60Qtr64GhSs8FYWZiIcStEyZyUoy6WXqqpMNduI1yKWrpP4ZUJRQx2IHlllCuYIBxB3FMScv_NnaIEU2w\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/-Skb0sViYX4AMEY33kSdK2nRw2vAaSAtaYQRm1FT8uFPwOV9Ks4ZOGPpi-xSjeR1llbFJSCmne-PTkFeRhuZ\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/FsB39z4ryEPZRT7GagZ-WFQz0I0vfC-hiLrkvuDFpKxNCQSBPeFV8F6xNIZdIL-IP1vdeUy8uItH5JnOi2Ala8o\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/u8jM7fBz6BLhVwV-IV0jQkrqiGGbJEMsTh4xmX6rKB5aIRfhkgvJTkXU7Rccl-TnFOks2Pnue7w_XL1Fu1J_bA\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/TXlD_FKSNwEW4iQQC1k6Fod_j-VIWfVhRfeLeg1YJO9MSdnRLHOahzDvYnkyoFuzxynSF8Kw8-Z7L18wTmO5\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/flokQ1tuz_oTfS-kVDfZMb8tkIqu5cuZDcB05aGavqkljjhXGqfFPfzE-kanRWGS5YfPJJEdrkweojKjf5-JDg\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/o8t3sxQguVVHQsZgwjI8DmdYRBw6SilfegkLi8rxjX0Q9-nemI85YC0i9KEKNT-Eyy9YAtf5SnGZQC_rodFJIjQ\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/M5QBeWWReBgcdiM1HPSZyKCmW51Fyi4OVBLJYvmfsHufHeKTg2pBtA2mbNJ4x4JGmri_iOaFoBDwOUr2gr9G6w\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/LhfGb60Qtr64GhSs8FYWZiIcStEyZyUoy6WXqqpMNduI1yKWrpP4ZUJRQx2IHlllCuYIBxB3FMScv_NnaIEU2w\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/-Skb0sViYX4AMEY33kSdK2nRw2vAaSAtaYQRm1FT8uFPwOV9Ks4ZOGPpi-xSjeR1llbFJSCmne-PTkFeRhuZ\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/FsB39z4ryEPZRT7GagZ-WFQz0I0vfC-hiLrkvuDFpKxNCQSBPeFV8F6xNIZdIL-IP1vdeUy8uItH5JnOi2Ala8o\"]]],\"Angela Biết Nói Của Tôi 2\",[\"4,5\",4.5490904],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.outfit7.mytalkingangela2\\u0026rdid\\u003dcom.outfit7.mytalkingangela2\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.outfit7.mytalkingangela2\"]],[\"qgJpGmcIFEoTCMTt16/HkJcDFQyjbAkdgcgbYPoBDAoKCAASBgoCdmkQALoCPgoiChxjb20ub3V0Zml0Ny5teXRhbGtpbmdhbmdlbGEyEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"Angela Biết Nói Của Tôi 2 là trò chơi thú cưng ảo đỉnh cao, mang đến niềm vui, thời trang và hoạt động sáng tạo cho bạn mỗi ngày. Bước vào thành phố lớn với Angela thời trang và tham gia hành trình đầy những hoạt động thú vị và niềm vui bất tận trong vũ trụ Tom Biết Nói và bạn bè!\\u003cbr\\u003e\\u003cbr\\u003eTính năng chính:\\u003cbr\\u003e\\u003cbr\\u003e- Tạo kiểu tóc, trang điểm và lựa chọn thời trang: Biến đổi Angela với những kiểu tóc, kiểu trang điểm và trang phục thời trang khác nhau. Lên đồ cho cô nàng dự show thời trang và cá nhân hóa diện mạo để nàng tỏa sáng như một ngôi sao.\\u003cbr\\u003e\\u003cbr\\u003e- Hoạt động thú vị: Tham gia vào các hoạt động vui nhộn khác nhau, gồm khiêu vũ, nướng bánh, võ thuật, nhảy tấm bạt lò xo, làm trang sức và trồng hoa trên ban công.\\u003cbr\\u003e\\u003cbr\\u003e- Món ăn ngon và đồ ăn nhẹ: Nướng bánh và nấu những món ngon cho Angela. Từ bánh ngọt tới bánh quy, hãy thỏa mãn cơn thèm của ngọt của nàng ta bằng kỹ năng nấu nướng của bạn.\\u003cbr\\u003e\\u003cbr\\u003e- Hành trình phiêu lưu: Đưa Angela vào những cuộc phiêu lưu bằng máy bay để khám phá những điểm đến và nền văn hóa mới. Và mua sắm tới khi hết tiền!\\u003cbr\\u003e\\u003cbr\\u003e- Minigame và trò chơi xếp hình: Thử thách kỹ năng của bạn với các minigame và trò chơi xếp hình giúp kiểm tra khả năng phản xạ và tư duy chiến thuật của bạn.\\u003cbr\\u003e\\u003cbr\\u003e- Bộ sưu tập nhãn dán: Thu thập và hoàn thành album nhãn dán để mở khóa phần thưởng đặc biệt và nội dung mới.\\u003cbr\\u003e\\u003cbr\\u003eThể hiện khả năng sáng tạo: Angela truyền cảm hứng giúp bạn trở nên sáng tạo, táo bạo và biểu cảm. Hãy thiết kế trang phục cho cô nàng, thử nghiệm trang điểm và trang trí nhà cửa để thể hiện phong cách độc đáo của bạn.\\u003cbr\\u003e\\u003cbr\\u003eBởi Outfit7, nhà sáng tạo của Tom Biết Nói Của Tôi, Angela Biết Nói Của Tôi 2 và Tom Biết Nói Của Tôi: Bạn Bè.\\u003cbr\\u003e\\u003cbr\\u003eỨng dụng này có chứa:\\u003cbr\\u003e- Quảng bá sản phẩm và quảng cáo của Outfit7;\\u003cbr\\u003e- Liên kết hướng khách hàng đến các trang web của Outfit7 và các ứng dụng khác;\\u003cbr\\u003e- Cá nhân hóa nội dung để khuyến khích người dùng không ngừng chơi ứng dụng;\\u003cbr\\u003e- Tùy chọn để mua hàng trong ứng dụng;\\u003cbr\\u003e- Các gói đăng ký tự động gia hạn, trừ khi được hủy trước khi kết thúc kỳ đăng ký hiện tại. Bạn có thể quản lý và hủy gói đăng ký trong phần cài đặt Tài khoản Google Play của mình sau khi mua.\\u003cbr\\u003e- Một số tính năng có thể chịu mức giá và phạm vi cung cấp khác.\\u003cbr\\u003e- Các vật phẩm để mua (có sẵn ở các mức giá khác nhau) bằng tiền ảo, tùy thuộc vào tiến trình của người chơi;\\u003cbr\\u003e- Các tùy chọn thay thế để truy cập tất cả các chức năng của ứng dụng mà không cần thực hiện bất kỳ giao dịch mua hàng trong ứng dụng nào bằng tiền thật.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003eĐiều khoản sử dụng: https://talkingtomandfriends.com/eula/en/\\u003cbr\\u003eHỗ trợ khách hàng: support@outfit7.com\\u003cbr\\u003eChính sách quyền riêng tư: https://talkingtomandfriends.com/privacy-policy-games/en\\u003cbr\\u003eGiấy xác nhận số 28/GXN-PTTTH\\u0026amp;TTĐT do Cục Phát thanh, Truyền hình và Thông tin điện tử cấp ngày 6/2/2024\"],\"Outfit7 Limited\",\"500.000.000+\",null,null,null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/uRSAhuxCcQyMRnbbYAUyApTUKAw-E793Nt65rhsxxykaK2xMMTSlK0ta4umPik-8RDqojHmZmh97G0hU1OBTUQ\"],null,[149,99,180,255]],null,[\"3 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Mua hàng trong trò chơi\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.outfit7.mytalkingangela2\\u0026rdid\\u003dcom.outfit7.mytalkingangela2\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đặt\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"25.000 ₫ - 2.550.000 ₫ mỗi mặt hàng\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Phổ thông\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.twincorp.bancaonline\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/8RhE88x3xS9_hTCXPZMZu1kAlsJmIFKf3BoveBsfWo5w8qmvGm9ZaX2kXEGXqh4ds33nIau33hgA0Rtm1tVMaA\"],null,[211,236,25,255],null,n