EWvUkRonV-DWZuAeUuWN1a8US0zqYhFQDdPVquf0RM4SvgK3AGw\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/2D_myjJ0zG3IQdV54q-qyW9RZQX7kvBNfTdIBC11XGivlcWEFq5pbXHBJd_PGMNVrFVPEK1uaojwVDBYpytC\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/etCDJHYYx4qmGqh66El2OcyGB11yx_yJjYRNRsEN_kZFnx1JrIS94DxnRBVhBUu2jr-ASTzjEQS9ALAxqx8B\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/JEKjOhOFguOxK7mKBuQ6ha7GyzLhHcP8UVT3jMVVcrTfvRr8eIw1MtLiJ3mi-jCaspaTknwHdqWPxoMrW2Q8\"]]],\"Party Legends: 234 Mini Battle\",[\"4,2\",4.232814],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.party.legends.multiplayer.game\\u0026rdid\\u003dcom.party.legends.multiplayer.game\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.party.legends.multiplayer.game\"]],[\"qgJvGm0IB0oTCMTt16/HkJcDFQyjbAkdgcgbYPoBDAoKCAASBgoCdmkQALoCRAooCiJjb20ucGFydHkubGVnZW5kcy5tdWx0aXBsYXllci5nYW1lEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"Bạn đang tìm kiếm trò chơi vui nhộn tuyệt đỉnh để chơi cùng bạn bè hoặc gia đình? Party Legends: 234 Mini Battle là bộ sưu tập trò chơi mini nhiều người chơi vui nhộn dành cho 2–4 người chơi trên một thiết bị. Cho dù bạn đang thư giãn ở nhà, tụ tập ở trường hay tổ chức đêm chơi game, trò chơi này có tất cả những điều thú vị bạn cần – ngoại tuyến và sẵn sàng chơi ở mọi lúc, mọi nơi!\\u003cbr\\u003e\\u003cbr\\u003e🎮 Trò chơi mini cổ điển và thú vị mà bạn sẽ thích:\\u003cbr\\u003e\\u003cbr\\u003eBóng bàn – Chơi các trận bóng bàn nhiều người chơi với bạn bè và thể hiện kỹ năng của mình!\\u003cbr\\u003e\\u003cbr\\u003eTic Tac Toe – Trò chơi nhiều người chơi cổ điển! Xếp các quân X và O của bạn thành một hàng và đánh bại đối thủ!\\u003cbr\\u003e\\u003cbr\\u003eTanks – Thách đấu bạn bè của bạn trong một trận chiến xe tăng hoành tráng và chứng minh ai là người chơi giỏi nhất!\\u003cbr\\u003e\\u003cbr\\u003eLudo – Lăn xúc xắc, đua quân cờ của bạn và tận hưởng trò chơi cờ bàn nhiều người chơi vượt thời gian này!\\u003cbr\\u003e\\u003cbr\\u003eRacing Cars – Hãy sẵn sàng cho hành động đua xe! Tăng tốc động cơ và đua với bạn bè của bạn đến đích!\\u003cbr\\u003e\\u003cbr\\u003eSắp có thêm nhiều trò chơi mini khác, với các bản cập nhật thú vị và thử thách mới để tiếp tục niềm vui!\\u003cbr\\u003e\\u003cbr\\u003e🕹️ Tại sao bạn sẽ thích Party Legends: 234 Mini Battle:\\u003cbr\\u003e\\u003cbr\\u003eNhiều người chơi ngoại tuyến – Chơi với 2–4 người chơi trên một thiết bị, không cần Wi-Fi.\\u003cbr\\u003e\\u003cbr\\u003eSiêu vui và dễ chơi – Niềm vui nhiều người chơi với các điều khiển đơn giản cho mọi người!\\u003cbr\\u003e\\u003cbr\\u003eVòng chơi nhanh – Thưởng thức các trò chơi nhỏ nhanh hoàn hảo cho các phiên chơi game ngắn hoặc các cuộc chơi marathon dài!\\u003cbr\\u003e\\u003cbr\\u003eĐồ họa đầy màu sắc \\u0026amp; Hiệu ứng âm thanh vui nhộn – Thưởng thức niềm vui với hình ảnh và âm thanh tuyệt vời!\\u003cbr\\u003e\\u003cbr\\u003e📱 Party Legends: 234 Mini Battle hoàn hảo cho:\\u003cbr\\u003e\\u003cbr\\u003eNiềm vui tiệc tùng nhiều người chơi với gia đình và bạn bè\\u003cbr\\u003e\\u003cbr\\u003eChơi khi đang di chuyển, không cần kết nối internet\\u003cbr\\u003e\\u003cbr\\u003eThử thách đua xe, trận chiến xe tăng dữ dội, trò chơi Ludo cổ điển và trò chơi ô ăn quan chiến lược!\\u003cbr\\u003e\\u003cbr\\u003eSẵn sàng vui chơi chưa? Hãy rủ bạn bè, chọn trò chơi nhỏ yêu thích của bạn và cùng đua, chơi và tận hưởng niềm vui với Party Legends: 234 Mini Battle! Tải xuống ngay và bắt đầu niềm vui nhiều người chơi ngay hôm nay!\"],\"Eclipse Inner\",\"5.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/t9lkM_JkgOv1i8uHH4jF6tksU-zw5SKFykn3_KfvclDjWZPq5eGaDLkATUpc0jvqdss_VYt5WCkW24h9jvCtLg\"