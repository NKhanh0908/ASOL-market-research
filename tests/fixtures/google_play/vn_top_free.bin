920],[null,null,\"https://play-lh.googleusercontent.com/n3d6Ny1wm3drrsnq4C0fuv6o_Axg3zMuFdEzrh2jjGMWSwGZ28ndg1MR0Reb4o7wADBAFoPCSpytZTBYAum6Bg\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/1bD-fK0bZtz4MmL_iNDT1bKGlEqs6Losp_zV4dq9B9a17-9qPVmAmraXSYPaaxb7G8pshL8USieaLjavKxl9ag\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/tfe_ekcQdVw65dfIex3POSS0knklbqJtaUfKmXP-yLjzTFTaMolSP9WB1Bn6Gp7IYnbDthF3ehyKmd69Lfzx0U4\"]]],\"Mini relax games-No wifi\",[\"4,0\",3.960396],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.jgame.relaxgames\\u0026rdid\\u003dcom.jgame.relaxgames\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.jgame.relaxgames\"]],[\"qgJsGmoIX0oTCMTt16/HkJcDFQyjbAkdgcgbYPoBFwoVCKTV+/7aud6OQxIJCgVlbi1VUxAAugI2ChoKFGNvbS5qZ2FtZS5yZWxheGdhbWVzEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"\\u0026quot;🎮 Vui nhộn. Nhanh gọn. Cực kỳ gây nghiện!\\u003cbr\\u003e\\u003cbr\\u003eDù bạn muốn xả stress, giết thời gian hay chỉ đơn giản là cười thật sảng khoái, bộ sưu tập này mang những game được yêu thích trên mạng vào một ứng dụng vừa hỗn loạn vừa hài hước.\\u003cbr\\u003e \\u003cbr\\u003e🌟 Tính năng nổi bật:\\u003cbr\\u003eHàng loạt mini game viral và cực đã\\u003cbr\\u003eHoàn hảo cho những lượt chơi nhanh và ngắn\\u003cbr\\u003eCơ chế chơi hài hước, bất ngờ\\u003cbr\\u003eKhông cần Wi-Fi — chơi ở bất cứ đâu!\\u003cbr\\u003e\\u003cbr\\u003eMỗi lần chạm là một bất ngờ, sự ngẫu nhiên và tiếng cười.\\u003cbr\\u003e\\u003cbr\\u003e🧠 Có gì trong game?\\u003cbr\\u003e💥 Giải tỏa căng thẳng tức thì\\u003cbr\\u003eĐập, cắt, xoay và thư giãn với những game cực đã như:\\u003cbr\\u003eNổ Bóng\\u003cbr\\u003eTháo Ốc Vít\\u003cbr\\u003eCắt Xà Phòng\\u003cbr\\u003eMỗi lần chạm giúp tâm trí thư thái và mang lại cảm giác “aah” thật sảng khoái.\\u003cbr\\u003e🚽 Tìm Nhà Vệ Sinh?!\\u003cbr\\u003eThời gian đang cạn dần — nhu cầu tự nhiên đang réo gọi! Giúp các nhân vật vượt qua những chướng ngại vật hài hước để đến nhà vệ sinh kịp lúc. Kỳ quặc, điên rồ và cực kỳ gây nghiện.\\u003cbr\\u003e✍️ Vẽ Đường, Giải Cứu Ngày Mới\\u003cbr\\u003eDùng ngón tay vẽ đường để giải đố! Từ Cứu Chó đến Đổ Đầy Nước Cho Cốc, nét vẽ của bạn sẽ quyết định diễn biến của từng màn.\\u003cbr\\u003e🍉 Đại Tiệc Câu Đố Trái Cây\\u003cbr\\u003eGhép trái cây trong thử thách Dưa Hấu Khổng Lồ đang viral hoặc vuốt qua những câu đố ô màu rực rỡ. Tất cả là chiến thuật… và một chút hỗn loạn ngọt ngào!\\u003cbr\\u003e🌀 Những Món Đồ Cực Kỳ Đã\\u003cbr\\u003eXoay Fidget Spinner, nhấn Nút Giảm Căng Thẳng hoặc xem các vật thể phản ứng theo những cách kỳ lạ và hài hước. Những game ngắn, lặp lại hoàn hảo cho giờ nghỉ giải lao.\\u003cbr\\u003e✅ Vì sao bạn sẽ yêu thích\\u003cbr\\u003eDễ chơi, khó dừng lại\\u003cbr\\u003eTrẻ em, người lớn và ai cũng chơi được\\u003cbr\\u003eĐầy cá tính, meme và sự hỗn loạn\\u003cbr\\u003eTuyệt vời khi buồn chán, đang chờ đợi hoặc muốn trốn tránh trách nhiệm\\u003cbr\\u003e\\u003cbr\\u003e👉 Tải ngay và bước vào bộ sưu tập mini game khó đoán nhất từ trước đến nay.\\u003cbr\\u003eDù bạn đang vẽ, đập, ghép hay chạy vội vào nhà vệ sinh — mỗi lần chạm đều là một niềm vui!\\u0026quot;\"],\"JMGame\",\"5.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/f4j_YyDqQ2kcG-lnGv-cY5a5JkOg23KjQmEiEpeCblAF9nQgkLZXs5MDcJxq9gYBH--CZYl1ev7vMy9fFF5VJA\"],null,[39,4,77,255]],null,[\"3 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,[null,\"Phù hợp với tất cả c