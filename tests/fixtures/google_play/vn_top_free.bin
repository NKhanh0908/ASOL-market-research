,[\"4,4\",4.360656],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.asmr.mukbang.livestream.party\\u0026rdid\\u003dcom.asmr.mukbang.livestream.party\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.asmr.mukbang.livestream.party\"]],[\"qgJuGmwIEkoTCMTt16/HkJcDFQyjbAkdgcgbYPoBDAoKCAASBgoCdmkQALoCQwonCiFjb20uYXNtci5tdWtiYW5nLmxpdmVzdHJlYW0ucGFydHkQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],[[[null,null,\"huMtbdh7dLw\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:huMtbdh7dLw?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:huMtbdh7dLw\",null,null,null,null,\"AXH1ezljf4Yhp5eeLgFRbI0somXVp9VrWLkIZUyIHFDG3RJZKKdItnsR8Dg0p3ilMfK2juLa2BFAoC2vTGY-_ihoBYHh0hn0PwaC4EpakTujFi8mRBnukGivqkvrN62Y-QFIgGBZ1ERFejjsdliTZOCrTfr6ZIUcPabvndSUtv4qjolhBekcLatxx0TodhbQoOt9vuninYVggZAaMKK5YVJPh2qJfOWrYRAQLLZq_oWrMRrGDLywAp78Csxftlt-DcJB8PBbfI0dYHz6DcTpiqutzKlAD8w7Eef8d5b5UjAi_M5_xA\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/huMtbdh7dLw/hqdefault.jpg\"]]]],[null,\"🎀 Hi bạn yêu ơi!\\u003cbr\\u003eBạn chính là đầu bếp dễ thương nhất thành phố đó 🍳\\u003cbr\\u003eVà từ hôm nay, bạn sẽ hoá thân thành cô nàng mukbang ASMR siêu nổi trên mạng 👩\\u200d🍳💖\\u003cbr\\u003eCùng bước vào Mukbang ASMR Livestream Party – một trò chơi vừa vui vừa chill, nơi bạn trổ tài nấu vô vàn món ngon, lên sóng trực tiếp và khiến người xem, fan của bạn mê mẩn bởi âm thanh ăn uống giòn rụm, nghe đã tai 🥰\\u003cbr\\u003e\\u003cbr\\u003e🔥 NẤU MÓN NGON NÈ~\\u003cbr\\u003e🍜 Nấu mì cay nghi ngút khói cùng trứng, thịt, phô mai béo béo\\u003cbr\\u003e🍗 Chiên gà vàng giòn, bên trong mọng nước, chấm cùng sốt siêu cuốn\\u003cbr\\u003e🥤 Pha nước ngọt đầy màu sắc với trái cây, thạch, siro và thật nhiều đá\\u003cbr\\u003e✨ Trổ tài nấu nướng của bạn trong trải nghiệm trò chơi ASMR cực vui, cực bắt mắt!\\u003cbr\\u003e\\u003cbr\\u003e🎥 ĐẾN GIỜ LIVESTREAM RỒI!\\u003cbr\\u003e- Mặc đồ thật xinh cho cô nàng mukbang của chúng ta \\u0026amp; trang trí phòng cho lung linh.\\u003cbr\\u003e- Nhấn nút lên sóng, bắt đầu tiếng húp húp – xèo xèo – nhai rôm rốp nghe là ghiền.\\u003cbr\\u003e- Càng livestream càng nhiều lượt thích, fan và quà tặng nha!\\u003cbr\\u003e\\u003cbr\\u003e🛒 ĐI SIÊU THỊ MUKBANG THÔI NÀO~\\u003cbr\\u003eTha hồ mua đủ món ngon bạn nghĩ ra được: đồ ăn vặt, bít tết, kẹo hồ lô, phở, khoai chiên, kẹo ngọt… món nào cũng có hết!\\u003cbr\\u003eTham gia trò chơi mukbang dành cho mọi tín đồ ăn uống và mê livestream!\\u003cbr\\u003e\\u003cbr\\u003e📦 TÚI ĐỒ ĂN BÍ ẨN – HỒI HỘP GHÊ!\\u003cbr\\u003eDing dong! Ai đã đặt đơn đồ ăn bí ẩn vậy ta? 😋\\u003cbr\\u003eXé túi sít rịt là có thể trúng món ngon xịn xò… hoặc combo “lạ lắm à nha” 🤯\\u003cbr\\u003eCó thể là bít tết mọng nước — hoặc pizza thạch trộn kem đánh răng?!\\u003cbr\\u003eNgon hay “toang” thì mở ra mới biết~ 🎁\\u003cbr\\u003eBạn dám mở hết không nè? 😆\\u003cbr\\u003e\\u003cbr\\u003e🎮 MINI GAME NHỎ XÍU MÀ VUI LẮM NHA\\u003cbr\\u003e- Thử thách đoán món ăn\\u003cbr\\u003e- Phục vụ fan đang đói bụng meo meo\\u003cbr\\u003e- Kiếm xu để mở khoá trang phục xinh xắn mới, nguyên liệu nấu ăn và đồ trang trí nè!\\u003cbr\\u003e\\u003cbr\\u003eNếu bạn thích âm thanh ASMR nghe vui tai, ăn uống đã miệng, đồ xinh xắn và livestream chill chill thì đây đúng là game dành cho bạn rồi đó 💗\\u003cbr\\u003e👑 Bạn đã sẵn sàng trở thành nữ hoàng mukbang chưa?\\u003cbr\\u003eNấu món ngon nè, lên sóng nè, thu hút vô vàn fan và rồi gom thật nhiều lượt thích luôn nha~\\u003cbr\\u003e\\u003cbr\\u003e👉 Tải ngay trò chơi Mukbang ASMR Livestream Party và giúp cô nàng mukbang siêu đáng yêu trở thành siêu sao livestream ẩm thực số một trên mạng xã hội nhé! 🏆\"],\"CAT Studio\",\"10.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/ES1aFiyXwnL_pRz68p1V5Q_BEF2aweq6He9xvz9RbQGel0pU1xKuErcmuTTTBol7VytdVcjOaOmQD366kiWe4EY\"],null,[250,240,241,255]],null,[\"3 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,[null,\"Phù hợp với tất cả các nhóm tuổi. Một số nội dung bạo lực trong ngữ cảnh hài hước hoặc tưởng tượng có thể được chấp nhận. Không cho phép ngôn từ thô tục.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.asmr.mukbang.livestream.party\\u0026rdid\\u003dcom.asmr.mukbang.livestream.party\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đặt\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"46.000 ₫ - 99.000 ₫ mỗi mặt hàng\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Phổ thông\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.u1.relax.minigame3\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/SRGo62quQnh1UP7KCu66g8TNs4PwXUzu50vv32v5VGLc3ip47gytimn9kA9Q8FnwA9KDUJOEsJM4U8HEfOVJ\"],null,[253,172,4,255],null,null,null,2],[[null,2,[1024,600],[null,null,\"https://play-lh.googleusercontent.com/-R6jgYb5Q4OGikPmQ5azb_MbT_Ky-TkSFvq0b0WHo5NmOgMsHVKbw9_JAb