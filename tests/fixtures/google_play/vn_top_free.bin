/play-lh.googleusercontent.com/h49VYgk4ED60-rVsZA4LwbNoZ7_cTw8cyHPO-UdAAAY5GzfEPQHABTusDehdMyat65wkNZTUgnerC_93c709Cw\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/qukuKqkvf7yZ_wlJFPo-Z4AtDr55bFu5IReGhETrAhryYfyQQmqJBB77Y8KW7nGU17BgZrZLuJhZT3MCrzvn\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/KotqBCVwUFXNQ6WDBkQ_hwhKijoitCuigqFpE9At_7rhqJkpVqyOISkKAooaYSYZVJdxzh1w8Y6Qlp7uVKtOxw\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/fUB21-72HEAZkJRIHwGhkUU-gfT3WSF29ZISXmJgZo2z_0_4e0qq7VyVYvvT3oUFCt8yI7LWM_SJp3O13LZhsg\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/c5OCuJy-XuJqefYfoO4KiveMHCIOs7jGe2riEOFdOOCYOnB-06c1wS88lKisMw2R9tp_Uj76T8zXmHi_OV9mfA\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/J7gQnGkIkeCP9Hmt1LA635zxzjB0-I_IBilWuSQB4vOc4xLN-XsjlCDiMexXgbvoWm40JfxPiVvvrJZMrLD8mw\"]]],\"Lật chai 3D — Chạm và nhảy\",[\"4,1\",4.108654],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dpampam.ibf2\\u0026rdid\\u003dpampam.ibf2\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dpampam.ibf2\"]],[\"qgJmGmQIP0oTCMTt16/HkJcDFQyjbAkdgcgbYPoBFAoSCM6o58WWwoONQxIGCgJ2aRAAugIzChEKC3BhbXBhbS5pYmYyEAEYAxIeCgQIARABCgQIAxABCgQIBBABCgQIBhABCgQICxAB\"],[[[null,null,\"atwg-I3TkfM\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:atwg-I3TkfM?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:atwg-I3TkfM\",null,null,null,null,\"AXH1ezn3wLyiNWENPeJh3eiYoVsSDN757VueTIca5QUqJ7kufboRUQTl8P00ieFapc580LC4qo5DN3f9zPYXYXGflAnSm3ai5wshCb9z0Pk9uT_LFiF-4ylEPR38Ij4NfbRZVJ5PDlifmKF3v4x6ux9QX8NK5w36hgXGzS0f7ToekJq2j4b8nViR9DrxHaahHMRehgtR9GNuV_cWGtVvXM9t1FqjtJAe85mQdoaeGpLHt19gf71E1Gq4GT4rn9DPuCXebQSepe-5EOyBASfJpgQtZtyGUlVwsqiTkMrfKK4UNxlxCA\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/atwg-I3TkfM/hqdefault.jpg\"]]]],[null,\"Bottle Flip 3D là một game arcade gây nghiện giúp kiểm tra kỹ năng của bạn. Mục tiêu của bạn là lật một chai nhựa và làm cho nó rơi xuống nhiều vật thể khác nhau mà không bị rơi. Nghe có vẻ dễ dàng phải không? Vâng, hãy suy nghĩ lại!\\u003cbr\\u003e\\u003cbr\\u003eBạn sẽ cần chạm vào màn hình vào đúng thời điểm để làm cho cái chai nhảy, lật và nảy qua một loạt căn phòng chứa đầy chướng ngại vật. Kệ, bàn, ghế, ghế sofa và thậm chí cả loa siêu trầm - bạn sẽ phải sử dụng mọi thứ làm bệ đỡ cho chai rượu của mình. Nhưng hãy cẩn thận; một số đồ vật phức tạp hơn những đồ vật khác!\\u003cbr\\u003e\\u003cbr\\u003eTrò chơi này không chỉ thú vị mà còn là một cách tuyệt vời để rèn luyện sự nhanh nhẹn và phối hợp của bạn. Chìa khóa thành công là tính toán khoảng cách nhảy một cách chính xác. Chỉ khi đó bạn mới về đích và giành chiến thắng!\\u003cbr\\u003e\\u003cbr\\u003eĐặc trưng:\\u003cbr\\u003e- Bottle Flip 3D là một game arcade siêu thông thường đầy thử thách và thú vị, sẽ khiến bạn say mê hàng giờ!\\u003cbr\\u003e- Lật nhiều chai khác nhau và khám phá các phòng khác nhau với chủ đề và thiết kế độc đáo.\\u003cbr\\u003e- Chạm vào màn hình vào đúng thời điểm và xem chai của bạn bay, quay và đáp xuống nhiều vật thể khác nhau.\\u003cbr\\u003e- Kiểm tra kỹ năng của bạn và xem liệu bạn có thể lật chai như dân chuyên nghiệp không!\\u003cbr\\u003e- Thưởng thức đồ họa tuyệt đẹp, vật lý chân thực và hiệu ứng âm thanh hấp dẫn.\\u003cbr\\u003e- Trải nghiệm cảm giác hồi hộp khi hoàn thành từng cấp độ và mở khóa cấp độ mới.\\u003cbr\\u003e\\u003cbr\\u003eVới Bottle Flip 3D, bạn sẽ không bao giờ chán! Luôn có một thử thách mới, một trở ngại khác và một cơ hội để bạn thể hiện những cú lộn nhào tuyệt vời của mình. Thưởng thức các trò chơi!\"],\"Azur Interactive Games Limited\",\"100.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/uNTTNJ2FaH8Txz1yQJU4phPFlwDEx3dEWQZh61zGkZszKJc47Sm_5n84b0G37-UdiXa254Wm7Mm65R-v4mx6SVs\"],null,[210,188,168,255]],null,[\"3 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,[null,\"Phù hợp với tất cả các nhóm tuổi. Một số nội dung bạo lực trong ngữ cảnh hài hước hoặc tưởng tượng có thể được chấp nhận. Không cho phép ngôn từ thô tục.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dpampam.ibf2\\u0026rdid\\u003dpampam.ibf2\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đặt\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"24.000 ₫ - 229.000 ₫ mỗi mặt hàng\",[false]],null,null,null,[[[[\"playpass_family\",39]]],[null,null,null,null,[null,null,\"/store/pass\"]]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Phổ thông\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]],[null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.tapblaze.pizzabusiness\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/aZN-hLvbt5WUHi7GBbbpi0DyB024bCNvCMO1g9f_NLziXZCIbEL3GBCOD4m04FyEiHuNWs0ROWBqNKyEh9Ra9g\"],null,[179,115,81,255],null,null,null,2],[[null,2,[1242,2208],[