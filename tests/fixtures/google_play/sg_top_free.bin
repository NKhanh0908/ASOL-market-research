wojSKL7zCzpIw\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/nNXDJNVZvsPgh1CQtXlLGj9IkpImwG3qJCXykH8QbzL08psJqkEoDrR8EsDLH_7nKV7wcctGHvXnrVpAO3phhA\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/NaqDfm9fBVuSRpJUzQ0yajUFbjSyNfwjge6gNubGGNSMMQhjAdJhjqbRF1pQwlcIligxOHDUp1gRKJmOSIL3FQ\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/gmuDuRAuyVuCdnwJ4ZR0folxD7WujucGaZNovxXKDtWCAFgrJ2nrKeoJhZcTfEcqWIm3TS2B-I6WI824mCyU\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/GeMM51o780Zmt7iir1xnzZ3ouHUn4KkNWcsDhTPxkgGAud0h-vroIa_fKCyHL_KvcqhyPs3KvwojSKL7zCzpIw\"]]],\"Find Hidden Cats- Spot it!\",[\"4.5\",4.548387],\"Casual\",null,null,[null,[[0,\"SGD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dspot.hidden.cat.find.hidden.objects\\u0026rdid\\u003dspot.hidden.cat.find.hidden.objects\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dspot.hidden.cat.find.hidden.objects\"]],[\"qgJtGmsIUEoTCIOmxrHHkJcDFQo9VAkdb+UGyvoBDwoNCAASCQoFZW4tVVMQALoCPwopCiNzcG90LmhpZGRlbi5jYXQuZmluZC5oaWRkZW4ub2JqZWN0cxABGAMSEgoECAEQAQoECAMQAQoECAQQAQ\\u003d\\u003d\"],null,[null,\"\\u003cb\\u003eFind Hidden Cats - Spot it!\\u003c/b\\u003e is a charming hidden-object adventure where clever kitties await your discovery! \\u003cbr\\u003eUnwind with beautifully crafted seek-and-find puzzles! Discover cleverly hidden cats in nostalgic hand-drawn scenes – no timers, no pressure, just pure observation joy. Perfect for mindful moments! Explore thousands of perfect hiding spots in cozy villages, sunlit porches, and overgrown gardens. Engage your inner detective while soothing your mind — perfect for relaxation and gentle mental exercise!\\u003cbr\\u003e\\u003cbr\\u003e🐱 HOW TO PLAY\\u003cbr\\u003e\\u003cb\\u003eSwipe \\u0026amp; Scan: Explore vibrant scenes to find hidden cats.\\u003cbr\\u003e\\u003cb\\u003eTap to Reveal: Gently tap spotted cats— they’ll meow and purr!\\u003cbr\\u003e\\u003cb\\u003ePinch \\u0026amp; Peek: Zoom in for a closer look. \\u003cbr\\u003e\\u003cb\\u003eGet Stuck? Friendly Prop is here to help when you need a nudge.\\u003cbr\\u003e\\u003cbr\\u003e🌟 HIGHLIGHT FEATURES\\u003cbr\\u003e🖼️ \\u003cb\\u003e1,000+ Hand-Drawn Illustrations\\u003c/b\\u003e\\u003cbr\\u003e– Unlock charming chapters: Vintage Diner 🍔, Starry Library 📚, Secret Garden 🌷\\u003cbr\\u003e⏳ \\u003cb\\u003ePlay at Your Pace\\u003c/b\\u003e\\u003cbr\\u003e– No timers! No rush, just pure observation joy\\u003cbr\\u003e👐 \\u003cb\\u003eEffortless Touch Control\\u003c/b\\u003e\\u003cbr\\u003e– Tap to find, swipe to explore – it just feels right!\\u003cbr\\u003e🧠 \\u003cb\\u003eBrain-Boosting Puzzles\\u003c/b\\u003e\\u003cbr\\u003e– Mindful Spotting – sharpen focus \\u0026amp; coordination!\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eDownload Now \\u0026amp; Experience:\\u003c/b\\u003e\\u003cbr\\u003e→ The joy of reuniting with hidden friends\\u003cbr\\u003e→ Art that rewards your curiosity\\u003cbr\\u003e→ A peaceful escape crafted for users\\u003cbr\\u003e\\u003cbr\\u003e📮 CONTACT US\\u003cbr\\u003eWe’d love to hear from you!\\u003cbr\\u003ePlease contact us if you have any questions or suggestions. \\u003cbr\\u003eEmail: playfulbytes.CustomerService@outlook.com\\u003cbr\\u003eTel: +12134684503\\u003cbr\\u003eTerms of Use: https://sites.google.com/view/eulaofplayfulbytes/home\\u003cbr\\u003ePrivacy Policy: https://sites.google.com/view/playful-bytes-pp/home\\u003c/b\\u003e\\u003c/b\\u003e\\u003c/b\\u003e\\u003c/b\\u003e\"],\"Playful Bytes\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/fIzfTxM0GdN-OD43mRlkYQIQGXrdDEXyQerMPhwjjoI-1tn_waYWcxg8lxz-AJNKmhllVo90OZnI0ckuesPI1w\"],null,[240,240,240,255]],null,[\"Rated for 3+\",[n