com.metax.find.it.spooky.morphs.incredibox\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.metax.find.it.spooky.morphs.incredibox\"]],[\"qgJuGmwIVkoTCIOmxrHHkJcDFQo9VAkdb+UGyvoBDwoNCAASCQoFZW4tVVMQALoCQAowCipjb20ubWV0YXguZmluZC5pdC5zcG9va3kubW9ycGhzLmluY3JlZGlib3gQARgDEgwKBAgBEAEKBAgEEAE\\u003d\"],null,[null,\"Explore mysterious worlds, discover hidden characters, and unlock them all in a fun sandbox adventure!\\u003cbr\\u003e\\u003cbr\\u003eEnter a colorful world filled with unique characters waiting to be discovered. Explore different areas, search every corner of the map, and uncover characters hidden throughout your journey.\\u003cbr\\u003e\\u003cbr\\u003e🗺 EXPLORE 4 UNIQUE MAPS\\u003cbr\\u003eTravel across 4 different maps, each with its own environment and collection of characters to discover. Look around carefully and explore every area to find them all.\\u003cbr\\u003e\\u003cbr\\u003e🔎 FIND HIDDEN CHARACTERS\\u003cbr\\u003eCharacters can be found throughout each map. Explore freely, search different locations, and keep your eyes open for characters hiding in unexpected places.\\u003cbr\\u003e\\u003cbr\\u003e🔓 UNLOCK \\u0026amp; COLLECT\\u003cbr\\u003eDiscover a character to add it to your collection. Keep exploring to unlock more characters and work toward completing your collection across all 4 maps.\\u003cbr\\u003e\\u003cbr\\u003e🎮 PLAY YOUR WAY\\u003cbr\\u003eEnjoy a simple sandbox experience where exploration is the main goal. Move around the map, investigate your surroundings, and discover new characters at your own pace.\\u003cbr\\u003e\\u003cbr\\u003e✨ COMPLETE YOUR COLLECTION\\u003cbr\\u003eHow many characters can you find? Explore every map and unlock as many unique characters as possible. Each discovery brings you one step closer to completing your collection.\\u003cbr\\u003e\\u003cbr\\u003e🌍 DISCOVER SOMETHING NEW\\u003cbr\\u003eWith multiple maps and plenty of characters to find, there is always another area to explore. Take your time, search carefully, and see what you can discover next.\\u003cbr\\u003e\\u003cbr\\u003eReady to start your collection?\\u003cbr\\u003e\\u003cbr\\u003eExplore all 4 maps, find hidden characters, and unlock them all!\"],\"Asyamnabil Studio\",\"100,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/QKn4wNMNjocnLN5NAIg0IptAET18MLhbzDJc3AOQPLCHT820hHPxKLGdjgDYc6mcM7UnFI4FsC_RZYYxlPII\"],null,[166,123,66,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,[null,\"Suitable for all age groups. Some violence in a comical or fantasy context is acceptable. Bad language is not permitted.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"SGD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.metax.find.it.spooky.morphs.incredibox\\u0026rdid\\u003dcom.metax.find.it.spooky.morphs.incredibox\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"ball.sort.puzzle.color.bubble.games.magic\",7],[null,2,[512,512],[null,nu