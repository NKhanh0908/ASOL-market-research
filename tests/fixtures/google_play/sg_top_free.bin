],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/uJ6Vm0DhTObV3-aPJfWOjcoF1QUGBV8BkudssNmNcxUFlqDYDcOUqny09NiKsNws0BBdnu8rQ-uSetUJ1eTc\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/syzuWZzrCwNt2WzDd3kCvZindElYUNGTIiWr-BpAvutke7ZucLlayHDKQ3M1UEpKWYdVMmtTo78GTSBNth0S\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/aaHrXiWSnTjwjrNyjOM0sJZz8DCo_wsqtZz4VJ0x0n1FVSSTluJLEfo0xrGpXQ0pGi2vjFz8W5fpBLS8q99IMro\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/w8-hp9I6wFwIGWODMnzeOR70efLN9NpluOSaavP1nshSD1WJ_WvPwCRebL1w0tJ20XJEHfjpJJF0tC0EDK-1yg\"]]],\"Rhythm Tiles: Pop Songs\",[\"4.4\",4.4411764],\"Casual\",null,null,[null,[[0,\"SGD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.piano.music.rhythm.tiles.games\\u0026rdid\\u003dcom.piano.music.rhythm.tiles.games\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.piano.music.rhythm.tiles.games\"]],[\"qgJsGmoIF0oTCIOmxrHHkJcDFQo9VAkdb+UGyvoBDwoNCAASCQoFZW4tVVMQALoCPgooCiJjb20ucGlhbm8ubXVzaWMucmh5dGhtLnRpbGVzLmdhbWVzEAEYAxISCgQIARABCgQIAxABCgQIBBAB\"],null,[null,\"🚀 Step into the neon future of Rhythm Games and enjoy  cyber music piano！\\u003cbr\\u003eAre you ready to test your reflexes and become a true piano master? Welcome to Rhythm Tiles, the most immersive and visually stunning cyber music experience on mobile! If you are a fan of piano games, rhythm games, and high-octane music games, you’ve just found your next obsession.\\u003cbr\\u003eThis isn\\u0026#39;t just another casual piano game; it’s a high-speed journey through a digital universe where every tap creates a symphony. Whether you\\u0026#39;re a fan of Kpop games, EDM, or classic pop, Rhythm Tiles brings the beat to your fingertips in a way you\\u0026#39;ve never felt before.\\u003cbr\\u003e\\u003cbr\\u003e---\\u003cbr\\u003e🕹️ How to Play: Tap, Slide, and Conquer the Beat!\\u003cbr\\u003eRhythm Tiles is designed to be intuitive for beginners but offers a legendary challenge for rhythm game pros.\\u003cbr\\u003e1. Watch the Screen: As the rhythm tiles fall from the top in a sleek cyber interface, get your fingers ready!\\u003cbr\\u003e2. Tap the Tiles: Tap the black or colored tiles exactly as they hit the rhythm line.\\u003cbr\\u003e3. Hold \\u0026amp; Slide: For long notes, press and hold to sustain the melody.\\u003cbr\\u003e4. Precision is Key: Don\\u0026#39;t miss a tile! Missing even one will break your combo and end your run.\\u003cbr\\u003e5. Boost Your Score: Collect glowing balls and golds on the track to trigger \\u0026quot;Fever Mode\\u0026quot; and double your points!\\u003cbr\\u003e\\u003cbr\\u003e---\\u003cbr\\u003e🔥 Why Rhythm Tiles is the Ultimate Music Game?\\u003cbr\\u003e🎶 A Massive, Ever-Growing Song Library\\u003cbr\\u003eFrom the latest chart-topping Kpop hits to pulse-pounding EDM and classic piano masterpieces, our song games library is updated weekly. No matter your taste, you’ll find the perfect beat to play along to.\\u003cbr\\u003e🌌 Stunning Cyberpunk Visuals\\u003cbr\\u003eEscape into a world of neon lights and futuristic aesthetics. Our cyber theme transforms every piano game session into a visual feast, with dynamic backgrounds that react to your performance.\\u003cbr\\u003e📶 No Wifi? No Problem! (Offline Games)\\u003cbr\\u003eSearching for no wifi games? We’ve got you covered. Enjoy the full rhythm game experience anywhere—on a plane, the subway, or in the middle of nowhere. Rhythm Tiles is one of the premier offline games for music lovers.\\u003cbr\\u003e🏆 Compete and Unlock\\u003cbr\\u003eUnlock unique skins for your tiles and even different \\u0026quot;sound fonts.\\u0026quot; Want your piano to sound like a digital synth or a classic grand? The choice is yours. Collect balls of light to unlock secret \\u0026quot;Hardcore\\u0026quot; versions of your favorite tracks.\\u003cbr\\u003e\\u003cbr\\u003e---\\u003cbr\\u003e⭐ Key Features ⭐\\u003cbr\\u003eFree Games Excellence: Download and play for free! Experience high-quality music games content without a price tag.\\u003cbr\\u003ePiano Games Perfection: Smooth, responsive tap mechanics that make you feel like a real piano master.\\u003cbr\\u003eKpop Games Mode: Dedicated playlists featuring the hottest Kpop music and idols.\\u003cbr\\u003eRhythm \\u0026amp; Beat Mastery: Test your hand-eye coordination with various difficulty levels, from \\u0026quot;Chill\\u0026quot; to \\u0026quot;Cyber Legend.\\u0026quot;\\u003cbr\\u003eFun Games for Everyone: A fun game that’s easy to pick up for kids, yet deep enough for adults and pro gamers.\\u003cbr\\u003eSmall Footprint: Optimized to run smoothly on all devices while maintaining high-fidelity audio.\\u003cbr\\u003eNo Wifi Games: Fully functional offline games support for on-the-go entertainment.\\u003cbr\\u003eInteractive Effects: Watch the balls and sparks fly with every perfect tap on the tiles.\\u003cbr\\u003e\\u003cbr\\u003e---\\u003cbr\\u003e👑 Become a Rhythm Legend\\u003cbr\\u003eStop just listening to music and start playing it! Rhythm Tiles combines the addictive nature of tile tapping with the soul of a professional piano game. Improve your timing, challenge your friends on the global leaderboards, and see if you have the speed to handle the fastest rhythm games on the market.\\u003cbr\\u003eReady to drop the beat?\\u003cbr\\u003e👉 Download Rhythm Tiles for FREE today and let your cyber journey begin!\"],\"Agile Lion Games\",\"5,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/WHhfYYRUWIlmCib6AQnIZWOxzp9bGoVfOJh5oZSjZIwSnJkI4OACdHnKyToInHHhtFdcVhhthbri7-e4nbsU-Fo\"],null,[245,242,246,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3