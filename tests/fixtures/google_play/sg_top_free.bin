null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.overseasgp.kljt\"]],[\"qgJdGlsIY0oTCIOmxrHHkJcDFQo9VAkdb+UGyvoBDwoNCAASCQoFZW4tVVMQALoCLwoZChNjb20ub3ZlcnNlYXNncC5rbGp0EAEYAxISCgQIARABCgQIAxABCgQIBBAB\"],[[[null,null,\"G8-8TnD0BNs\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:G8-8TnD0BNs?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:G8-8TnD0BNs\",null,null,null,null,\"AXH1eznNuH5AVCbgQGZIBxYGXFnkBtOVv_DKAdr3oU8EitAdCeMIXE3a7LZhG-ryeu-PyJWmXpI4n9OnyUN32EjhQbXMCjZrnMdFObG_vXr9614eVsbyylYIPKk_6xqFfgvjifp82vCeLdazvlOcfPvjivPPgDmxdiLzYCpoMM-MjjKl4N-t1DFqJ1TE7JF_d1k9ekM1w9ZXYqjJ5l5q3gKMQmo6DVN2a5JPqtjKIq9azBmklTV5TaM03TUpXC5GV6rgFu3Fx3jIIC-vAx5TAGyoAKnN2FTFYMyfVyiQESrmOmtaOQ\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/G8-8TnD0BNs/hqdefault.jpg\"]]]],[null,\"Pre-registration Rewards: Exclusive, limited-edition gifts for pre-registered players, including: the \\u0026quot;Undying Bones\\u0026quot; title *1 and the \\u0026quot;Fire of Joy\\u0026quot; avatar frame *1. Click to pre-register now!\\u003cbr\\u003e\\u003cbr\\u003eNecro Factory is an incredibly satisfying and stress-relieving idle RPG where you build your own massive skeleton army on a dangerous continent. Lead your heroes and legions to conquer land after land. Compete against other players to become the ultimate champion! Name the server after yourself, claim unparalleled glory, and make other players bow before your throne!\\u003cbr\\u003e\\u003cbr\\u003eCore Gameplay:\\u003cbr\\u003e【Heroic Summoning, Ultimate Guardian】 Extremely high drop rates ensure powerful heroes are summoned. Each hero possesses unique skill mechanics, allowing you to create your own exclusive lineup. Awaken your heroes to gain new forms and skills—all waiting for you to unlock! Locked!\\u003cbr\\u003e\\u003cbr\\u003e【Build Altars, Strengthen Mercenaries】 Skeletons are mobilized! Strengthen them through unique altars to gain different abilities and become new mercenaries, such as warriors, archers, bombers, mages, and many other unit types.\\u003cbr\\u003e\\u003cbr\\u003e【Diverse Gameplay, Full of Challenges】 Carefully designed levels and diverse maps, from forests to glaciers, are full of unknowns and challenges! There are also brand-new Creation Mountain and Illusion Trials, giving you an unprecedented sense of challenge and excitement.\\u003cbr\\u003e\\u003cbr\\u003e【Conquer the Continent, Achieve Supreme Glory】 Join your guild and other players to conquer the continent, seize territories, lead your brothers to conquer lands and cities, protect your throne, and make other players submit!\\u003cbr\\u003e\\u003cbr\\u003eIf you encounter any problems, please feel free to contact us\\u003cbr\\u003eFB:https://www.facebook.com/profile.php?id\\u003d61593887312264\\u003cbr\\u003eDC:https://discord.gg/xfq8pKf7m4\"],\"Electronic Soul\",\"100,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/P4qKFfgRStS23nG48MCueV9Ko-al_woQXhdY7vlNqZFVgbq_laJpJV2oxrsK0jYkKYSjpHOxgn3DhgtCV0c95w\"],null,[73,49,58,255]],null,[\"Rated for 12+\",[null,2,[366,512],[null,null,\"https://play-lh.googleusercontent.com/yQChfa9XKlaXMIYTk8w8QwChjT8_SH-_2d2SS-kesw0TLQK1nxtw54bDcoZ09freZJgKrtg4f__is-31Vg\"]],[null,\"Moderate Violence\"],[null,\"Users Interact, In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/YrkR-GP7OKghBTATCoO_jJrchSVrh-NSUBb5DnbRZC1DbLK_cgV9FC2e_iI4GzLsKXuZjuFZajnGCiA8qA\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"SGD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.overseasgp.kljt\\u0026rdid\\u003dcom.overseasgp.kl