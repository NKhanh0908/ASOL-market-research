,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.tripledot.angrysmash\\u0026rdid\\u003dcom.tripledot.angrysmash\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.tripledot.angrysmash\"]],[\"qgJiGmAIHUoTCIOmxrHHkJcDFQo9VAkdb+UGyvoBDwoNCAASCQoFZW4tVVMQALoCNAoeChhjb20udHJpcGxlZG90LmFuZ3J5c21hc2gQARgDEhIKBAgBEAEKBAgDEAEKBAgEEAE\\u003d\"],null,[null,\"Ahoy, adventurer! Get ready to blast your way through a colourful world of tropical islands, pirate hideouts and treasure-filled shores! Can you save the one you love from captivity?\\u003cbr\\u003e\\u003cbr\\u003eTake control of a powerful cannon and smash every object standing in your path. Aim carefully, choose the perfect angle and fire your cannonball to shatter crates, barrels, stone structures and other island obstacles. Use your brain and instincts to overcome the obstacles!\\u003cbr\\u003e\\u003cbr\\u003eEvery level brings a new smashing challenge. Use precision, timing and strategy to clear all the targets in front of you and continue your journey across the islands. Watch structures collapse, trigger satisfying chain reactions and discover the best way to destroy everything with as few shots as possible.\\u003cbr\\u003e\\u003cbr\\u003eEASY TO PLAY, SATISFYING TO MASTER\\u003cbr\\u003eAim your cannon, release to fire and enjoy the destruction. The controls are simple, but finding the perfect shot takes skill.\\u003cbr\\u003e\\u003cbr\\u003eEXPLORE A PIRATE ISLAND WORLD\\u003cbr\\u003eTravel through tropical beaches, mysterious ruins and dangerous pirate territories as you complete increasingly challenging levels.\\u003cbr\\u003e\\u003cbr\\u003eSMASH EVERYTHING IN YOUR PATH\\u003cbr\\u003eBreak barrels, destroy crates, crack stone defences and bring entire structures crashing down with powerful cannon shots.\\u003cbr\\u003e\\u003cbr\\u003ePLAN THE PERFECT SHOT\\u003cbr\\u003eAdjust your aim and use the environment to create spectacular chain reactions. One well-placed cannonball could clear the entire level!\\u003cbr\\u003e\\u003cbr\\u003eSATISFYING DESTRUCTION\\u003cbr\\u003eEnjoy explosive impacts, collapsing structures and rewarding smash effects with every successful shot.\\u003cbr\\u003e\\u003cbr\\u003eLoad the cannon, take aim and begin your island-smashing adventure. Can you destroy every target and conquer all the islands?\"],\"Tripledot Studios Limited\",\"500,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/Mbk-YJcjN8NFt8CZeyyo5MLTiKEEtdELJhQyBjJwf6TKSfVDkn4Os2mRCnEa5sEbZV5J2ahs6LX12-xdavng368\"],null,[84,204,248,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,[null,\"Suitable for all age groups. Some violence in a comical or fantasy context is acceptable. Bad language is not permitted.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"SGD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.tripledot.angrysmash\\u0026rdid\\u003dcom.tripledot.angrysmash\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$1.48 - $139.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null