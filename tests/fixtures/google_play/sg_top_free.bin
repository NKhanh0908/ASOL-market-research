2],[null,null,\"https://play-lh.googleusercontent.com/z-wW-CAqGkYPco8S9vo6ETYK-Sjvu5l164vQDWht5rSR099ZbEpf8SZE07i6EqZnbmTx7lGRMXjib06uduP3\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/jCC7ki4hI6zarSSyPh61NPWny9vb3ZxNHieegzZOC1xnms8SFV9fjFRp4RhHvT5rClplA5QfFMCmwhcHDgtfMwU\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/AtW2ayHTjlBaXQqQ1Np_qOdstfUNcUYqX5Tv22_J48nooJSNZPRGaCBasuMTZgyxuUAoK2pWrUBknPR7Ev7z3g\"]]],\"Glow Fashion Idol\",[\"4.8\",4.85],\"Casual\",null,null,[null,[[0,\"SGD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.crazylabs.fashion.squad\\u0026rdid\\u003dcom.crazylabs.fashion.squad\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.crazylabs.fashion.squad\"]],[\"qgJlGmMIEEoTCIOmxrHHkJcDFQo9VAkdb+UGyvoBDwoNCAASCQoFZW4tVVMQALoCNwohChtjb20uY3JhenlsYWJzLmZhc2hpb24uc3F1YWQQARgDEhIKBAgBEAEKBAgDEAEKBAgEEAE\\u003d\"],[[[null,null,\"j8v9nIa9l2c\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:j8v9nIa9l2c?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:j8v9nIa9l2c\",null,[1280,720],null,null,\"AXH1eznGAwYxQf_OVZFIB61nt5Jh7XVj1ido5jUu4IEDpuxlWu5tRXeXoBXvemMHfa1GaPD0IsYkqZ_mlFYzO9N28TM4CauInJIx-zfhesW5O3kvtJ0Ab0pxRV7A-lZ7AzVAsJrsfpWB8jmKEa3myKFFIjtMv5qWDNhOfMRgk5zkqM-1-tM0uaOSahjcf5MajEdwpJF-L8gVQ2c8UcgGZiAee2QKJ2r-7HOP8U5Dl9b07_w9PQDHX510oPWG2PbgcuGm-C313uBdzguUmGkdaDXRaq_tlWZs2-i4n1QeZRvLqPkBVQ\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/j8v9nIa9l2c/hqdefault.jpg\"]]]],[null,\"Welcome to Glow Fashion Idol — a fashion makeover and dress-up game where every client has a moment to shine, every look creates a glow-up, and every style choice brings you closer to becoming a Fashion Idol.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eCreate Client Glow-Ups\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003eGet ready to embrace the glamorous world of Glow Fashion Idol! Step into the spotlight as a talented fashion stylist and create breathtaking outfits for clients in a dazzling dress up and makeover story. Showcase your makeover skills in the makeover studio and rise through the fashion industry.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eLive Your Fashion Story\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003eImmerse yourself in the captivating fashion story, where you\\u0026#39;ll encounter exciting challenges, inspiring fashion shows, and a chance to transform into a true fashion idol and super stylist. Express your creativity by putting together incredible glam outfits, each telling a mesmerizing makeover story.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eStyle, Customize \\u0026amp; Shine\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003eWith a wide variety of designer outfits and accessories at your fingertips, this dress up game will provide endless possibilities to style and customize your model. Show off your impeccable taste in fashion, dress up in stunning outfits, and let your creativity shine!\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eKey Features\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003e• Dress up your virtual models with an extensive wardrobe collection filled with glam outfits.\\u003cbr\\u003e\\u003cbr\\u003e• Unlock makeup styles and hairstyles to create a signature look in the makeup studio.\\u003cbr\\u003e\\u003cbr\\u003e• Add friends and join runway events together in the world of fashion.\\u003cbr\\u003e\\u003cbr\\u003e• Compete in the fashion battle to prove your fashion stylist expertise.\\u003cbr\\u003e\\u003cbr\\u003e• Enter an exciting fashion story filled with captivating challenges.\\u003cbr\\u003e\\u003cbr\\u003e• Participate in the fashion show to gain recognition as the Glow Fashion Idol.\\u003cbr\\u003e\\u003cbr\\u003e• Create stunning client glow-ups in the makeover studio.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eBecome the Glow Fashion Idol\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003eGlow Fashion Idol is not just a makeover story, but a journey into the glitzy and chic world of fashion. Are you ready to become the ultimate Glow Fashion Idol? Play now and start your fashion adventure!\\u003cbr\\u003e\\u003cbr\\u003e*In-App purchases may include random items.\\u003cbr\\u003e\\u003cbr\\u003eTo opt out of CrazyLabs sales of personal information as a California resident, please visit the settings page within this app. For more information visit our privacy policy: https://crazylabs.com/app\"],\"CrazyLabs LTD\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/OczMKxnbqRQbOQNjeDYlINHJr116G9drf5J3iWcmlgr5oszdm0tKCg0zNsehOWDrkudCasz1JJqBsNr4feUdN1g\"],null,[162,154,153,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"SGD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.crazylabs.fashion.squad\\u0026rdid\\u003dcom.crazylabs.fashion.squad\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$1.48 - $139.98 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.aidiangames.garden.gp\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/OCY7_hg9tT5aKeodURwmFoBc48EVEkqnqcapWCcXz1AU92SK0qyZDKj0x5dbXd2nRmzcmz7mwT7w4UnoKcGY\"],null,[209,194,186,255],null,null,null,2],[[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/dkaqsQnHeZiqklinxraUOMV-f3ZB2oGUCxRwBDeOg_HvZoRlp84hUDXiR0vZuguWjzPT7kRIMEMvzTmm735DHA\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/NzhVHflVR8LaCeZwaRSvxc9hAsHMHbfVc0srCR-VSWGfj4Z2YsJ4y8x0WK_1N0BAH4INqEvHbzTyIxp2v5dXnb4\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/xxlt1fJNsC-wUPS5p00KKx1fS8Eq6RxBXxG7SSPRCT-Vy-04K5mFVRHZNJHfU88UqsfS8rPvQedK7ZxkB4fcMQ\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/XGVrjNilX55qNsLj2l7b_9kL2NxR4oK4cjQlfQqffTUDL8a-aA4FMrgPDtZ3yZfiAC-v3ie4avkK8GdzKSuoTw\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/scPOV7RZqM5C9sMH-zEKYSE7LNLbc2QSeSoqYMWqWOe-mVB5-d7t3M5fgBFpAiLGP0BKAtgXv6l1CCVsMuta3A\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/ucKWnkLB7o8EW8JrOaBhoRrzslAJpH0EYUIBS5C_zB1m5OvyhWAKFevtO27tbRf0e6eSTqd18z9vTqqv-MozKCM\"]]],\"Dreamscape Island: Farm \\u0026 Cook\",[\"4.7\",4.717647],\"Casual\",null,null,[null,[[0,\"SGD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.aidiangames.garden.gp\\u0026rdid\\u003dcom.aidiangames.garden.gp\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.aidiangames.garden.gp\"]],[\"qgJjGmEIEUoTCIOmxrHHkJcDFQo9VAkdb+UGyvoBDwoNCAASCQoFZW4tVVMQALoCNQofChljb20uYWlkaWFuZ2FtZXMuZ2FyZGVuLmdwEAEYAxISCgQIARABCgQIAxABCgQIBBAB\"],[[[null,null,\"km8cZc6Y7Mc\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:km8cZc6Y7Mc?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:km8cZc6Y7Mc\",null,null,null,null,\"AXH1eznTU_ODyC2ZVBtjzeIrQC12lw9pL_I0xXdn9a7nNHV3RHk7HUEM5KUIn4Fgu_mY7r2CeY_uGOmY5AEjLT1uUxqxYHlPCWrE4-lYBj8mmmZroveD-kyyQ3n4B_AdWgCenLG_McUMR7gmE0XeHkabxgzFfTIvhxPBy6e_ODwTuxdURb6kDO2CWE4qOvSKoV35F32FJ-n_y9foDsAgiuQLuvYdkpMpXxPPlLCgD03WTkPbhZjlsBx8qtaKsMCnN-DEBTyDlxCqXFepnTssy7l1C5Lw6aNTNvDhmmivCsv3ArBlww\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/km8cZc6Y7Mc/hqdefault.jpg\"]]]],[null,\"Welcome to Dreamscape Island, a cozy farming and life simulation game where good food and simple pleasures bring each day to life. Grow crops, make friends and shape your own island retreat at your own pace.\\u003cbr\\u003e\\u003cbr\\u003eFrom planting your first seed to serving a delicious feast, enjoy the quiet satisfaction of watching your garden grow and sharing the warmth of a home-cooked meal.\\u003cbr\\u003e\\u003cbr\\u003eFROM YOUR GARDEN TO YOUR TABLE\\u003cbr\\u003eGrow crops, raise chickens and other farm animals, and catch fresh seafood. Turn your harvest into delicious dishes, then choose how to plate and present them. With a little care, even a simple meal can become a feast.\\u003cbr\\u003e\\u003cbr\\u003eYOUR ISLAND RESTAURANT\\u003cbr\\u003eFill customer orders, expand your island and unlock new ingredients and recipes. Build your humble food stall into a restaurant known far and wide, one satisfying meal at a time.\\u003cbr\\u003e\\u003cbr\\u003eGAME FEATURES\\u003cbr\\u003e\\u003cbr\\u003e1. Settle into Island Life\\u003cbr\\u003eFarm, care for animals, go fishing and gather seafood along the shore. Slow down and enjoy the little things on your own peaceful island.\\u003cbr\\u003e\\u003cbr\\u003e2. Bring Delicious Recipes to Life\\u003cbr\\u003eUnlock recipes and explore different ingredients, proportions, serving dishes and plating styles. Enjoy every step of creating a meal, from choosing what goes in to adding the finishing touches.\\u003cbr\\u003e\\u003cbr\\u003e3. Visit Friends and Borrow Ingredients\\u003cbr\\u003eStop by your friends\\u0026#39; islands and borrow the ingredients you need without reducing their supplies. Help each other gather what you need and keep your kitchens cooking.\\u003cbr\\u003e\\u003cbr\\u003e4. Design an Island That Feels Like Home\\u003cbr\\u003ePlan your island\\u0026#39;s layout and decorate your farm, restaurant and more. Mix, match and arrange each space to create a style that\\u0026#39;s all your own.\\u003cbr\\u003e\\u003cbr\\u003e5. Follow Her Fresh Start\\u003cbr\\u003eFollow the heroine\\u0026#39;s journey from an office worker unsure of her path to a confident restaurant owner. Watch her find her feet as she builds a new life on the island.\\u003cbr\\u003e\\u003cbr\\u003ePlant a little, cook a little and make yourself at home on Dreamscape Island.\\u003cbr\\u003e\\u003cbr\\u003eTerms of Service:\\u003cbr\\u003ehttps://sites.google.com/view/dreamscapeisland-service\\u003cbr\\u003e\\u003cbr\\u003ePrivacy Policy:\\u003cbr\\u003ehttps://sites.google.com/view/dreamscapeisland-privacy\"],\"Aidian Network\",\"50,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/ZoJrApyBIOWe9I42oXFehlpj37iiIqz2Jy0_U_Vw1ZiF86HKYe2sC900IgKUbY9I2i29aZCXuyEPgr3cTYENNqM\"],null,[186,145,120,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Users Interact\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"SGD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.aidiangames.garden.gp\\u0026rdid\\u003dcom.aidiangames.garden.gp\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.48 - $899.98 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.hollywood.merge\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/5mzN7_uKeXNnloF-zlXGxiwKuepToEdRwbFUK_aQqk7ORLUGPsMwQK__J9IL9DBMWty-zuLvZ4FYHikK2xCttIw\"],null,[60,125,176,255],null,null,null,2],[[null,2,[3840,2160],[null,null,\"https://play-lh.googleusercontent.com/lvMIZQ6Yu3K0fadWIEB_eWt8_Hvz5KGZIHfkj3wGH1L0RvUH1UVlpkwAxvjamcgxkpSz0aaxluWyYA57CY6QgQ\"]],[null,2,[3840,2160],[null,null,\"https://play-lh.googleusercontent.com/3cQfX9IwEkYpyvfnGcvArLnT7rDIAdSi-nPurP665mBygjI0kkpgxmuiLtSWX1YO3kgbkiEjx1hWnY3ocGk2qA\"]],[null,2,[3840,2160],[null,null,\"https://play-lh.googleusercontent.com/JKa_P_LQnYXo3tiGeHvlPYpVw0UpeFPgVZWNZ0DPAh9VECfOlcxVT5Sr2Jptl-EDsFC0-Bu5yEWVkjWnNGmW\"]],[null,2,[3840,2160],[null,null,\"https://play-lh.googleusercontent.com/4A3Nn08iW9UKvPAKoEbhVIWrfzyMCkyspvct-h63tY-fYH-LQwy02hjO7sBhJoRGEaNh8bSK0KVYxEJGvvn9JhE\"]],[null,2,[3840,2160],[null,null,\"https://play-lh.googleusercontent.com/uCdT5ZL1J_58VLu47RIOz5MCPIbxUzYd-cma9D_-uEDj1EdKlEvZ5WHv6CO3c_BxtsnqA5WlBgiitMo_ufNBSg\"]],[null,2,[3840,2160],[null,null,\"https://play-lh.googleusercontent.com/lvMIZQ6Yu3K0fadWIEB_eWt8_Hvz5KGZIHfkj3wGH1L0RvUH1UVlpkwAxvjamcgxkpSz0aaxluWyYA57CY6QgQ\"]],[null,2,[3840,2160],[null,null,\"https://play-lh.googleusercontent.com/3cQfX9IwEkYpy