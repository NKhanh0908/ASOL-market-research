w4FMrx3AMHZUgnPvTza42uFgFaw5lOP5bqZ2Jl47xQ8Ic1YISeBG_trioTNYaIMG7m7W9VEqqySSXQ\"]],[null,2,[1920,1087],[null,null,\"https://play-lh.googleusercontent.com/g-Cp6Yb_rAUyBwOQstztYewvPX0nnEIP3aja0D-O6PK9vtbdhIdZgamt3D2aPtPF6ozrJh89-syVXv6MLgTL0g\"]],[null,2,[1920,1084],[null,null,\"https://play-lh.googleusercontent.com/k-6kJU9UqWXS_wiRHpUpvmvYRrj6z0q0YYTVncjqQsdG9Rg29MB2M1EK_tNZShw9912ZFbybW9l6GI4PEDZ0VA\"]]],\"House Makeover: ASMR Cleaning\",[\"3.9\",3.8846154],\"Casual\",null,null,[null,[[0,\"SGD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.gps.housemakeover.satisfying.clean\\u0026rdid\\u003dcom.gps.housemakeover.satisfying.clean\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.gps.housemakeover.satisfying.clean\"]],[\"qgJwGm4IJUoTCIOmxrHHkJcDFQo9VAkdb+UGyvoBDwoNCAASCQoFZW4tVVMQALoCQgosCiZjb20uZ3BzLmhvdXNlbWFrZW92ZXIuc2F0aXNmeWluZy5jbGVhbhABGAMSEgoECAEQAQoECAMQAQoECAQQAQ\\u003d\\u003d\"],null,[null,\"Welcome to house makeover, start your cleaning journey. Help a single mother to restore her messy house to its former beauty. Clean dirty rooms, scrub grimy objects, wash, wipe, and polish materials until they shine.\\u003cbr\\u003e\\u003cbr\\u003eEnjoy the calming ASMR sounds with every tap, swipe, and spray. From dusty furniture to stained walls, every task is interactive and satisfying. Watch each dirty material, transform as you tidy up, and redecorate it.\\u003cbr\\u003e\\u003cbr\\u003eA fun and calming way to relax, unwind, and enjoy while cleaning. Clean dusty furniture, dirty floors, and messy objects with cleaning tools. Enjoy decorating each room and turn the dirty house into a clean.\\u003cbr\\u003e\\u003cbr\\u003eHouse Makeover: ASMR Cleaning Quality Features:\\u003cbr\\u003e\\u003cbr\\u003eUse different tools to scrub, wipe, and wash various objects.\\u003cbr\\u003eUnlock new rooms and make a dirty home into a clean one.\\u003cbr\\u003eEnjoy relaxing ASMR sounds while you clean messy rooms and fix dirty furniture.\"],\"Mad1 Games\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/SIp7r5EMizNwE1SYOSS6MP7Ayj9HQkaet0_6V5WlT-7I-CoIVVjuwawHujmxAurnYAZFD9QSyajKy6TM22DDzkk\"],null,[46,96,83,255]],null,[\"Rated for 12+\",[null,2,[366,512],[null,null,\"https://play-lh.googleusercontent.com/yQChfa9XKlaXMIYTk8w8QwChjT8_SH-_2d2SS-kesw0TLQK1nxtw54bDcoZ09freZJgKrtg4f__is-31Vg\"]],[null,\"Moderate Violence\"],null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/YrkR-GP7OKghBTATCoO_jJrchSVrh-NSUBb5DnbRZC1DbLK_cgV9FC2e_iI4GzLsKXuZjuFZajnGCiA8qA\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"SGD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.gps.housemakeover.satisfying.clean\\u0026rdid\\u003dcom.gps.housemakeover.satisfying.clean\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$1.48 - $6.98 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.moonactive.cmboard\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/pFMYxxHpIsLKeaxO9wjVRpAsgMaLKbT1kPwofNQtGi69-6fF_eUyIViAMY66auDrvsJnw2h6S5rpF8XaZcrm\"],null,[224,19,0,255],null,null,null,2],[[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/arN