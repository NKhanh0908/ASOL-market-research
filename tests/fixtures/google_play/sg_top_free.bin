utfits, and fashion accessories\\u003cbr\\u003e- Photo album for finished looks\\u003cbr\\u003e- Relaxing offline gameplay\\u003cbr\\u003e-  Easy controls and smooth salon interactions\\u003cbr\\u003eBuild your own beauty routine, create unique makeovers, and show your styling talent in Hair Salon Makeover Studio.\"],\"MR. PROXY CORE\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/a6PWjLZ-TL07r6CDKkNVJaCwuyyT8VJBR-074vu15I5rqxDbKIaeK8z1fi6NZQbsJfIYVQdGfUmuk32rDNAFaQ\"],null,[243,184,227,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,[null,\"Suitable for all age groups. Some violence in a comical or fantasy context is acceptable. Bad language is not permitted.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"SGD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.mrxvip.hair.salon\\u0026rdid\\u003dcom.mrxvip.hair.salon\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.Garawell.BridgeRace\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/g6WCkctcM8t6rMUqRCW1gBTNjf