1242],[null,null,\"https://play-lh.googleusercontent.com/mJBw7o1c85N8dhAioRypEUa3-eZUXlPzJtaTF2xXK6b0s6HbRE2LuHMHyGTysaohUK9VgV6Wy90S_1kXUFuVz18\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/Tmt2nf9BLbFD0RUabd9pi4Om2pKVERghFxBB375fqA1f0vo4QTzXOjNx60tAMPgaktkr8qMrXp72Q52VNlWv-g\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/1mwlr4DGZaL42xyy_SvBkKlIzMK_W3DVklWl9jc2ynfH6hM0JMnOoxQ6ZqzMfjJ4x-WPExo06x_jOdJBUEbmTg\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/dbnTLy0o-oN9wiZL4oO5jl90EUc--wNwVHLY1m479SBDWltLk_0jq-fYLJsRcNKSb3zdW75EB2GoIEet6bbA2g\"]]],\"Pick Me Up 3D: Taxi Game\",[\"4.4\",4.38],\"Casual\",null,null,[null,[[0,\"SGD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.tp.pmu3d\\u0026rdid\\u003dcom.tp.pmu3d\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.tp.pmu3d\"]],[\"qgJWGlQIRkoTCIOmxrHHkJcDFQo9VAkdb+UGyvoBDwoNCAASCQoFZW4tVVMQALoCKAoSCgxjb20udHAucG11M2QQARgDEhIKBAgBEAEKBAgDEAEKBAgEEAE\\u003d\"],[[[null,null,\"RoSVZTzJgfQ\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:RoSVZTzJgfQ?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:RoSVZTzJgfQ\",null,null,null,null,\"AXH1ezlqCAKQmnTS64H-EmA1JV4jJyiKVbvGj5-c5lM1V1shIHqG2WLf7-RUocf6oRlha2-V6cToy8nYwQCcV1GJsTDTtLF7NFwUh3UfHOC1YL9GtbYJmTFXIHf430SSQ8ZFv77aUvlOUiVKyABde4IWrPiw_8j75E1JPXS8HnGGhUmZIPQMPzAKCDPLhbYBz38796wtx615hY0mVX1cYfb-lpdU1TiRcK9pGO_fmoIA5MhfhAbZHmdnZG6Wa-AjZ61vdqod5lk6VNRq2sF3NKfG7VNwgR71GFhzveBFUMYbfcXi3A\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/RoSVZTzJgfQ/hqdefault.jpg\"]]]],[null,\"Get ready for an exhilarating ride with Pick Me Up 3D, the ultimate car traffic game that\\u0026#39;s all the rage among fun car game enthusiasts! As a taxi game that combines elements of crazy taxi adventures and taxi driving games, this game is perfect for those seeking a thrilling road trip game experience.\\u003cbr\\u003e\\u003cbr\\u003eAs a talented chauffeur in this taxi simulator, you\\u0026#39;ll navigate through highway traffic and busy city streets, making it one of the most dynamic traffic games out there. The essence of Pick Me Up 3D lies in its simplicity and excitement, distinguishing it from other traffic-driving car simulators. It\\u0026#39;s not just about driving; it\\u0026#39;s about mastering the art of car run and traffic escape.\\u003cbr\\u003e\\u003cbr\\u003eThe game\\u0026#39;s core challenge is to pick up passengers and navigate through a maze of traffic jam scenarios, making it one of the most engaging taxi run games. Whether you\\u0026#39;re a teenager looking for a fun car game or an adult seeking to unwind with games traffic-based, Pick Me Up 3D offers an ideal blend of relaxation and excitement.\\u003cbr\\u003e\\u003cbr\\u003eThis game stands out in the realm of traffic driving games by offering a unique twist on the typical taxi game. Players must exhibit precision and timing, akin to playing in a traffic run scenario, making it a standout among taxi games.\\u003cbr\\u003e\\u003cbr\\u003eIn Pick Me Up 3D, every level is a new adventure, offering endless fun and challenges. Whether you\\u0026#39;re dodging through traffic jam puzzles or cruising in your taxi simulator, this game is sure to keep you engaged. And for those who love car traffic games, Pick Me Up 3D offers an immersive experience that\\u0026#39;s hard to beat.\\u003cbr\\u003e\\u003cbr\\u003eSo, if you\\u0026#39;re in search of a game that combines the thrill of highway traffic, the strategy of traffic escape, and the excitement of a road trip game, look no further than Pick Me Up 3D. Download it now and join the ranks of players who enjoy the rush of a good traffic run!\"],\"Azur Interactive Games Limited\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/nllpo_6cDe7VCVsSSK96h6VGppwrQJCfeO2NvEgxUMtAh-hp8o9XqbzBDKFwrPO-PjZtzsnKD7LxweArf6YL7g\"],null,[45,57,62,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"SGD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.tp.pmu3d\\u0026rdid\\u003dcom.tp.pmu3d\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$4.48 - $8.98 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.king.candycrushsodasaga\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/MVuszfqolfHgAa9rrC812oOPmdbdh8oULxR5Pbg2atQRja_OSGUOUVbgzmEUb1GzqkUnh1UO0LGhGp6Y8M5T\"],null,[252,245,223,255],null,null,null,2],[[null,2,[1280,768],[null,null,\"https://play-lh.googleusercontent.com/w3yUTG7r_3lIiVOgVRO2S6wgMui8niaUCzSt5Qu8IT9i6X06vqMPnpZCsZ6iruWlFvljdFYaO5roU29Fgo3P\"]],[null,2,[1280,768],[null,null,\"https://play-lh.googleusercontent.com/KpxH1ebuHDlcx5LNXtk-ZfSdXSyi2GBVtPXcYUNUMCfxaGLaMuu_uY42b6Y2r8VpSbzUhbtn_j-p6gl4krDuWQ\"]],[null,2,[1280,7