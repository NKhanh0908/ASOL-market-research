eusercontent.com/qP8X5FojEg_sEjW-fVZBv0Vvrtm64c3SiLTm14q9kTy7BcfrXI07J5JQ9r3GfYL5dZhUiTC3_SBcUkb2bVfqVLA\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/pQ6Ppm8cAG-z7O_HBpDBezH0nyB8LmNoJDPt2Z93awWw765mdzeB3ibSaVGA5Rb5d2u5a8eEFBb6XbxTC-Fv7CU\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/QLhn_ihi5qQOfyOgpjxED2wmrH5eIprO6Ij_5Kq86FB8jiAHqCsZHTej_6Uz9a0BhAQLjP88BvkusPyP7KqQfw\"]]],\"Antistress Relaxing Mini Games\",[\"4.4\",4.4150944],\"Casual\",null,null,[null,[[0,\"SGD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.minigames.antistress.relaxinggames.toys\\u0026rdid\\u003dcom.minigames.antistress.relaxinggames.toys\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.minigames.antistress.relaxinggames.toys\"]],[\"qgJ1GnMIQkoTCIOmxrHHkJcDFQo9VAkdb+UGyvoBDwoNCAASCQoFZW4tVVMQALoCRwoxCitjb20ubWluaWdhbWVzLmFudGlzdHJlc3MucmVsYXhpbmdnYW1lcy50b3lzEAEYAxISCgQIARABCgQIAxABCgQIBBAB\"],null,[null,\"🌿 Antistress Relaxing Mini Games gives you peaceful moments with calming toys, satisfying interactions and stress relief mini games. Whether you’re bored, anxious or simply need a short break, this game is a perfect choice.\\u003cbr\\u003e\\u003cbr\\u003e💆 Relieve stress through soothing interactions: pop bubbles, slice sand, play with slime, spin fidget toys and explore dozens of antistress mini games. Each game is designed to be simple, satisfying and calming - ideal for relaxing anytime, anywhere.\\u003cbr\\u003e\\u003cbr\\u003e⭐ Key Antistress Relaxing Mini Games\\u003cbr\\u003eExplore more than 15 satisfying and antistress game, including:\\u003cbr\\u003e- Pop it fidget\\u003cbr\\u003e- Bubble up\\u003cbr\\u003e- Fidget spinner\\u003cbr\\u003e- ASMR cutting\\u003cbr\\u003e- Slime \\u0026amp; Clay\\u003cbr\\u003e- On/off switch\\u003cbr\\u003e- Keyboard typing\\u003cbr\\u003e- Sand slice\\u003cbr\\u003e- Balloon popping\\u003cbr\\u003e- Potter making\\u003cbr\\u003e- Dalgona cookie \\u003cbr\\u003e- Tap tap shots\\u003cbr\\u003e… and many more relaxing puzzle games \\u0026amp; toys!\\u003cbr\\u003e\\u003cbr\\u003e🎮 Why You’ll Love This Game\\u003cbr\\u003e✔ Peaceful \\u0026amp; satisfying antistress gameplay\\u003cbr\\u003e✔ 15+ mini relaxing games \\u0026amp; fidget toys\\u003cbr\\u003e✔ Stress relief, anxiety calming \\u0026amp; focus boosting\\u003cbr\\u003e✔ Simple, easy to play, no pressure\\u003cbr\\u003e\\u003cbr\\u003eEnjoy the ultimate collection of antistress relaxing mini games and find your moment of calm.\\u003cbr\\u003e👉 Play now and Relax your mind!\"],\"CAT Studio\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/X2xrAfHugquPXPCM51gApgDIC98iFqh1FWy_CsiIPorpBzZAHYVHo7SLwN509mQ72KKwpyKecjpwOACyLyFy8A\"],null,[73,38,17,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,[null,\"Suitable for all age groups. Some violence in a comical or fantasy context is acceptable. Bad language is not permitted.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"SGD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.minigames.antistress.relaxinggames.toys\\u0026rdid\\u003dcom.minigames.antistress.relaxinggames.toys\\u0026feature\\u003dmd\\u0026o