 diamonds, stones, wood\\u003cbr\\u003e• Join the guild and lead it to the championship among all\\u003cbr\\u003e\\u003cbr\\u003eWhat are you waiting for? It\\u0026#39;s time to build your dream farm!\"],\"MTAG PUBLISHING LTD\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/wqC5Ig-6gWagSFeP3dKA2qRA9gD7QI-iXiUW0Xnhqn25j9WB2WTjugs3QzUtgmr0BAXQJ2c-aFhteQ6AaTESdD0\"],null,[15,176,236,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.evogames.slavsforvk\\u0026rdid\\u003dcom.evogames.slavsforvk\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.screw3d.match.nuts.bolts.pin.jam.away.puzzle\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/WLRF2CUFZ9qbetyqQdbBfW3TVJL1zGN0fJkPFC64mMIioE-e3sRRLjuxfMR3gPvPwvJ4blCEUnQKCxqY4p5V\"],null,[247,2