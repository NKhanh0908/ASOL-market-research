,\"https://play-lh.googleusercontent.com/VzJUzTti2CXzSNMPSb6AGXss4-fYbFdR2-6cz7GE2tIohe54oj86XgDGflzCd0q-b_tH6jkr0ove4cEgTPSMgg\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/fNjbNxpfTkXpn8n75PPFOY8fX4fvp_HO7I5r_iKaAuh70U3z8_rZG3WMRCZKRCTy2PVwHwMwQWBsC7fHSEfM\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/XiZLNnWhkuz2IH-6HndWX_Jb_RWgtRFd7pQr1AdJpdxJdKOZmZToZGbMmBJIi8NAXOTuWObOZiClK_IhRb2T1w\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/rFLZLHUolUZT1U0u95MqYg_YXCst0mI31G2dzsPfPBoRtznpIjZNB1YAgSSar4cNZQpox82yffCPBJ_BsGwu\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/L_H2lkOHdgpMflLecMd4Yog6CFS3bJKmkK3P3P6MzPsNZA1_3YtjnKz0lYew0UOdVitwd21El3DE7FSy-shjjpM\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/waJxlBq7eYxcrUN0iGSglAYl4h_XAE-rmRq4rsB5qhodwCZ2HKZkt1F_3R_mD_tdYT7Fzer7m-0VekAZWXLnep8\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/7tKsv-ZUlXMaEbsyisAYpGg3Ne6kjJoayRYsn_hP8qKHtdORAKtJBx2yd2APP4NdS_MFKhGura1Dm1-qtY3T1Q\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/VzJUzTti2CXzSNMPSb6AGXss4-fYbFdR2-6cz7GE2tIohe54oj86XgDGflzCd0q-b_tH6jkr0ove4cEgTPSMgg\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/fNjbNxpfTkXpn8n75PPFOY8fX4fvp_HO7I5r_iKaAuh70U3z8_rZG3WMRCZKRCTy2PVwHwMwQWBsC7fHSEfM\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/XiZLNnWhkuz2IH-6HndWX_Jb_RWgtRFd7pQr1AdJpdxJdKOZmZToZGbMmBJIi8NAXOTuWObOZiClK_IhRb2T1w\"]]],\"Babytopia: Match 3 Puzzle Game\",[],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.oceangames.popmatch3.gp\\u0026rdid\\u003dcom.oceangames.popmatch3.gp\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.oceangames.popmatch3.gp\"]],[\"qgJlGmMIPkoTCOi0hLLHkJcDFaoRgwMd/OULsPoBDwoNCAASCQoFZW4tVVMQALoCNwohChtjb20ub2NlYW5nYW1lcy5wb3BtYXRjaDMuZ3AQARgDEhIKBAgBEAEKBAgEEAEKBAgLEAE\\u003d\"],null,[null,\"Looking for a fun, free casual game with NO ADS? Welcome to Babytopia—the ultimate fashion styling, blind box collection, and match-3 puzzle adventure! \\u003cbr\\u003e\\u003cbr\\u003eHelp Rachel solve a dramatic family mystery while collecting thousands of exquisite outfits to create stunning looks! Open fashion blind boxes, design chic personal spaces, and enjoy an uninterrupted, ad-free puzzle experience.\\u003cbr\\u003e\\u003cbr\\u003eAfter a lethal mansion fire, Rachel has been arrested for a crime she didn’t commit. As her best friend, you must step in to investigate her disappearance, style characters in high-fashion looks, and protect the family legacy!\\u003cbr\\u003e\\u003cbr\\u003e🌟 GAME FEATURES 🌟\\u003cbr\\u003e\\u003cbr\\u003e🎁 Unbox Fashion Blind Boxes \\u0026amp; Outfit Collection\\u003cbr\\u003e- Express your style! Open exclusive Blind Boxes to unlock over 500+ designer outfits, chic accessories, and gorgeous hairstyles.\\u003cbr\\u003e- Collect diverse fashion styles, from casual chic to glamorous red-carpet gowns, and build your dream wardrobe!\\u003cbr\\u003e  \\u003cbr\\u003e👗 Creative Fashion Styling \\u0026amp; Makeover\\u003cbr\\u003e- Play the role of a top stylist! Create high-fashion makeovers and unique looks for the characters.\\u003cbr\\u003e- Match stunning outfits for different story events and show off your incredible fashion sense.\\u003cbr\\u003e  \\u003cbr\\u003e🚫 Play for Free \\u0026amp; NO ADS \\u003cbr\\u003e- Enjoy a smooth, uninterrupted gaming experience with no forced ads!\\u003cbr\\u003e- Play your favorite match-3 puzzles and collect gorgeous outfits anytime, anywhere, completely free.\\u003cbr\\u003e  \\u003cbr\\u003e🧩 Addictive Match-3 Puzzles \\u0026amp; Boosters\\u003cbr\\u003e- Solve hundreds of challenging match-3 puzzles with unique obstacles and thrilling levels.\\u003cbr\\u003e- Use powerful boosters and explosive combos to crush your way through puzzles and earn exclusive blind boxes!\\u003cbr\\u003e  \\u003cbr\\u003e🏡 Renovate the Manor \\u0026amp; Design Chic Spaces\\u003cbr\\u003e- Show off your interior design talents! Restore the fire-damaged mansion and customize cozy private suites and luxury walk-in closets.\\u003cbr\\u003e- Choose the perfect decor to showcase your vast fashion collection!\\u003cbr\\u003e  \\u003cbr\\u003e🕵️\\u200d♀️ Unravel a Dramatic Mystery Storyline\\u003cbr\\u003e- Investigate crime scenes, find hidden clues, and help Rachel clear her name.\\u003cbr\\u003e- Uncover deep family secrets while managing daily fashion challenges!\\u003cbr\\u003e  \\u003cbr\\u003eAre you ready to solve challenging match-3 puzzles, collect stunning outfits, and unravel the mystery? Download Babytopia today and start your fashion makeover journey!\\u003cbr\\u003e\\u003cbr\\u003e💬 NEED SUPPORT?\\u003cbr\\u003eContact Us: Within the game, go to Settings ⚙️ --\\u0026gt; Support.\\u003cbr\\u003e\\u003cbr\\u003eNote: Babytopia is a story-driven mystery and fashion styling game intended solely for players aged 13+ (primarily adults). It is NOT a children\\u0026#39;s toy or early-learning application.\"],\"Elementa Games\",\"500,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/Enq2gxVTSHhnoNuSdAniJci58saoU4ZtbXllXXIgjoYMWnMHhxu2b0nolQbNsPBzzRWKkvFZ1eSL4iFroh977g\"],null,[155,113,96,255]],null,[\"Rated for 7+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/1SrNtAwg9PFOhgMJPXehacRTeQNhHhG12Pj1zACHNVmfRfEZA3_oOEmLvRNsmYGeGHpas7sCwyR3y8OT\"]],[null,\"Fear\"],[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-l