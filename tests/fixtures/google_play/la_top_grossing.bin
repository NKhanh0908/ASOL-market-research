ll,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.moonjoy.cointale\"]],[\"qgJkGmIIO0oTCOi0hLLHkJcDFaoRgwMd/OULsPoBDwoNCAASCQoFZW4tVVMQALoCNgoaChRjb20ubW9vbmpveS5jb2ludGFsZRABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,\"Zk_NbUeU7bE\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:Zk_NbUeU7bE?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:Zk_NbUeU7bE\",null,null,null,null,\"AXH1ezn6VA2tpbbP4zs2hEHxnIMeMc1SlDAV3tC7WbXPR4SgJWA7iPbS1OASdLxN_Kz7DrytOqYNLA92X2FLLLqt-cYoufT8gkz9LDrgKgbCEA3Gsf2zR1nBFHq1sKkiV_GcC0ZEY0dDdwsDW-vlTqjoRcOk_xSKM5UArrArDvOQrIUyddNyUd8VqFi_5UwBAZTXcXSC9sS9gf8EdNewmJEQBtH6Re67EJoq8mVMuKTvADn4ZJUl_-CTJO4CcRk5w_Uox-mHVGrAECsF1i7EpYgBqiXEudS5bOczzxA4sj3w1EZWSQ\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/Zk_NbUeU7bE/hqdefault.jpg\"]]]],[null,\"🎉 Step into the immersive universe of Coin Tales, a thrilling, interactive mobile game that brings the excitement of the world to your fingertips. Embark on an adventure that will see you build, raid, and trade your way to legendary status in a land of enchanting whimsy and endless fun.\\u003cbr\\u003e\\u003cbr\\u003e🌍 EXPLORE A VAST WORLD: Traverse through magical realms and diverse landscapes in your quest to become the supreme Coin Tales champion. Each location you conquer is filled with unique coins, treasures, and characters waiting to be discovered.\\u003cbr\\u003e\\u003cbr\\u003e🏰 BUILD YOUR DREAM KINGDOM: Use your hard-earned loot to construct your empire. From simple cottages to imposing castles, the power is yours to create. Fortify your kingdom\\u0026#39;s defenses to ward off attacks from both friends and rivals.\\u003cbr\\u003e\\u003cbr\\u003e⚔️ RAID OTHER KINGDOMS: Connect with players from around the globe! Spin the wheel to snatch their coins or pillage their treasure. But stay alert – they can seek revenge! Launch daring raids to amass your fortune.\\u003cbr\\u003e\\u003cbr\\u003e🔄 TRADE TO THRIVE: Need to complete your card collection? Our trading feature allows you to swap cards with friends. The more collections you complete, the greater the rewards!\\u003cbr\\u003e\\u003cbr\\u003e🎁 DAILY REWARDS \\u0026amp; BONUSES: Sign in every day for enticing bonuses and spin the wheel for a chance to claim fantastic prizes. Participate in our weekly events for an added layer of thrill.\\u003cbr\\u003e\\u003cbr\\u003e🐷 PET COMPANIONS: You’re never alone on this journey. Unlock adorable pet companions that enhance your earnings and safeguard your kingdom. Level them up and watch your wealth multiply!\\u003cbr\\u003e\\u003cbr\\u003e👑 LEADERBOARDS \\u0026amp; COMPETITIONS: Compete with players from around the world and ascend the global leaderboard. The more you play, the more opportunities you have to claim victory!\\u003cbr\\u003e\\u003cbr\\u003eJoin millions of players worldwide as you spin, build, and battle your way to the top. Can you become the wealthiest and most revered in Coin Tales? There\\u0026#39;s only one way to find out...\\u003cbr\\u003e\\u003cbr\\u003eDownload Coin Tales today and commence your epic adventure! \\u003cbr\\u003e\\u003cbr\\u003eFollow Coin Tales on Facebook for daily free offers and bonuses!\\u003cbr\\u003eCoin Tales is a free game on all devices with in-app purchases.\\u003cbr\\u003e\\u003cbr\\u003eCoin Tales does not offer real money gambling. It is intended for an adult audience for entertainment purposes only.\\u003cbr\\u003e\\u003cbr\\u003eHave problems with our game?\\u003cbr\\u003ePlease contact us at cointalesVIP@rjoy.com\\u003cbr\\u003eFacebook: https://www.facebook.com/cointales\"],\"Moonjoy\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/EmZch8619jxK6kLmbo8aojdLLt6SJmxXeYB3Chb-ebutAAhMoX5gTfydKkm9B_bQa78IpgJaAkCa2BndZo6I9n8\"],null,[130,207,228,255]],null,[\"Rated for 18+\",[null,2,[366,512],[null,n