2],[null,null,\"https://play-lh.googleusercontent.com/RBJ5qz3IgOXUkI9NAEJz14MxsZ_HC4U3to0kCztb27M0u3D1PS1tHm3OGGMHkZxpF_ji5cLKVLNtaZHtpHnl\"]],[null,2,[2048,2732],[null,null,\"https://play-lh.googleusercontent.com/br_ELpRwRTgxbD6FcndC3t9UzCGwUBETmgzcS5uRjA6S_fUkzS3srI87Un-KnLYaf_pT16DpxdvHAF0aVfBm1s8\"]],[null,2,[1536,2048],[null,null,\"https://play-lh.googleusercontent.com/0I_e9acSeXqHJUC9D9NqU_jUoAblmlg5syScmJ9FLYNoehKBCd3kx68GenxHm2VTNt05yFjU-Pu6wNmD9Es8\"]],[null,2,[2048,2732],[null,null,\"https://play-lh.googleusercontent.com/RNXrLdalBQlnXIAwKmnMTkB8IOeOY2vKdDogtXuky3thljL8-O_zPpYhiyFmb5b7S0__SwEn6oS7y2b6Aax5\"]],[null,2,[2048,2732],[null,null,\"https://play-lh.googleusercontent.com/_lsRhEX7Ja5PyF0-hLaIoh6K-9FAnHBHDSnwudZIc8_jbq8_xpZy8xV4Ryz9hNMtbg2rprJujg8-PghS-7g2\"]],[null,2,[2048,2732],[null,null,\"https://play-lh.googleusercontent.com/HCPg1M9I38BgT69bEyYKjk7e0IsykJfpCuO8xdKez4s0O0xIHeJQaV9pO7ur6ymmuwMv2NM9dii_azxWqX5W2Q\"]],[null,2,[2048,2732],[null,null,\"https://play-lh.googleusercontent.com/dPUFrQqAFMQJwJkfHH2Y1cpUETCIUxtWqYsD4rT3p5qhxmlOHAS26Bhh37z2NqwoGD01mD1a0VLr99aRGTlp9Q\"]],[null,2,[2048,2732],[null,null,\"https://play-lh.googleusercontent.com/RtzgIrU9iHOdUYBYh53ZSxNhT_CTEf2XLTBUlY6UpDflbLfjFQBEMx0cSWNiqPBbO14f808y2_o1lc4-lmSaKQ\"]],[null,2,[2048,2732],[null,null,\"https://play-lh.googleusercontent.com/RBJ5qz3IgOXUkI9NAEJz14MxsZ_HC4U3to0kCztb27M0u3D1PS1tHm3OGGMHkZxpF_ji5cLKVLNtaZHtpHnl\"]],[null,2,[2048,2732],[null,null,\"https://play-lh.googleusercontent.com/br_ELpRwRTgxbD6FcndC3t9UzCGwUBETmgzcS5uRjA6S_fUkzS3srI87Un-KnLYaf_pT16DpxdvHAF0aVfBm1s8\"]]],\"My Cafe — Restaurant Game\",[\"4.2\",4.227642],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.melesta.coffeeshop\\u0026rdid\\u003dcom.melesta.coffeeshop\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.melesta.coffeeshop\"]],[\"qgJmGmQIRkoTCOi0hLLHkJcDFaoRgwMd/OULsPoBDwoNCAASCQoFZW4tVVMQALoCOAocChZjb20ubWVsZXN0YS5jb2ZmZWVzaG9wEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"Love coffee and fun? You’re in the right place. Step into My Cafe and embark on your very own restaurant story game. \\u003cbr\\u003e\\u003cbr\\u003eBuild your cafe from the ground up and transform it into a 5* restaurant that will be the talk of city. Expand your MyCafe empire and show the cooking game world what success really looks like. Ready? Let’s go!\\u003cbr\\u003e \\u003cbr\\u003eWhat’s inside this exciting cooking games adventure?\\u003cbr\\u003e \\u003cbr\\u003ePLAY A REALISTIC CAFE SIMULATOR\\u003cbr\\u003e• In this coffee game simulator, use your entrepreneurial skills to grow your cafe business. Fill the fridge with goodies, make coffee, expand the menu and level up your kitchen game.\\u003cbr\\u003e• Manage your restaurant and team to dominate the cooking simulator game universe. Pour delicious coffee, add new items, and cook unbelievable meals to satisfy your customers.\\u003cbr\\u003e• Become the cooking master, and turn a simple cafeteria into an award-winning restaurant with crazy-good cooking.\\u003cbr\\u003e• Waiter games are GO! In this cooking adventure, you’ll need to hire the professionals. From waiting staff to baristas to a cooking organizer, with a team like this, there’s no way you can’t win the restaurant games challenge.\\u003cbr\\u003e \\u003cbr\\u003eSTYLE YOUR CAFE WITH DECOR\\u003cbr\\u003e• Unlock your inner restaurant games designer and turn that cooking mama cafe into a chic cafe.\\u003cbr\\u003e• In this restaurant game, there are no limits to your creativity. Choose from tons of decor styles, position furniture, and make that humble little coffee shop your own. \\u003cbr\\u003e• Whether you’re leveling up your burger game or rocking your street food to restaurant adventure—there’s something for everyone here. \\u003cbr\\u003e\\u003cbr\\u003eDISCOVER INTERACTIVE CAFE GAME STORYLINES\\u003cbr\\u003e• It’s never boring in this cooking simulator adventure. From playing kitchen games to staying on top of big cooking trends to serving games and more, you’ll be rushed off your feet and have lots of fun, too!\\u003cbr\\u003e• Learn all about coffee town’s characters and your potential customers. Find out their favorite orders and level up your drinks and snacks menu with tasty treats and unique coffee recipes. Serve coffee and desserts to all members of the community, from the local librarian to a grade-school teacher and even a police officer. Get their orders right and you’ll have happy customers for life.\\u003cbr\\u003e• Drama? Romance? MyCafe has it all. In the cafe world, you’ll go on a cooking voyage like no other. Who knows, you might even meet your cooking crush.\\u003cbr\\u003e• The choice is yours. This is your cooking story. Choose your path through the My Cafe simulation game and unlock an unmissable diner games adventure.\\u003cbr\\u003e \\u003cbr\\u003eGO SOCIAL AND PLAY COFFEE GAMES WITH FRIENDS\\u003cbr\\u003e• Like to go it alone? That’s cool. But if you like your coffee social, this coffee shop game has something special for you. Play the My Cafe restaurant game with new friends and old ones to have even more fun. Compete against owners of other coffee shops in cooking mania challenges to take the prize of top barista in the food game planet. \\u003cbr\\u003e• Visit festivals, complete tasks, expand your coffee empire, and have fun together!\\u003cbr\\u003e\\u003cbr\\u003eCalling all coffee lovers! \\u003cbr\\u003eIt’s time to unlock your barista superpowers and create custom coffee in this cafe story adventure game. \\u003cbr\\u003eSo, go ahead and make yourself a cup of coffee and let’s play My Cafe together!\\u003cbr\\u003e\\u003cbr\\u003eFollow My Cafe on Facebook and Instagram for exclusive offers and bonuses!\\u003cbr\\u003eFacebook: https://www.facebook.com/MyCafeGame/\\u003cbr\\u003eInstagram: https://www.instagram.com/mycafe.games/\\u003cbr\\u003e\\u003cbr\\u003eTerms of Service: https://static.moonactive.net/legal/terms.html?lang\\u003den\\u003cbr\\u003ePrivacy Notice: https://static.moonactive.net/legal/privacy.html?lang\\u003den\\u003cbr\\u003e\\u003cbr\\u003eQuestions about the game? Our support is ready and waiting at: https://melsoft-games.helpshift.com/hc/en/3-my-cafe-recipes-stories---world-restaurant-game/contact-us/\"],\"Melsoft Games Ltd\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/irZQLa-CcouqngwafDXITO2xKl1kO2A-8YcXNfrhV2Oe5a_jl3RyVz0dYR3hjSiDhiHA4D9ug305mXJ1y66v\"],null,[235,232,233,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Users Interact, In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.melesta.coffeeshop\\u0026rdid\\u003dcom.melesta.coffeeshop\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]