peC5ob21lc2NhcGVzEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],[[[null,null,\"DsW6r-_gRdY\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:DsW6r-_gRdY?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:DsW6r-_gRdY\",null,null,null,null,\"AXH1ezkwpG-RbYKEyH2XOp7TFsHpEdCguc2KqDwOv5979TTKZtNNd6qU60a9pDXs0aPUmHcvoxs75-fBVszPZHuvHPdCxOKxf9WIczQbePFZYEriSav-e-nCgfV9HDI8QRYJWkcBfneEEozqgEbYR---X2wzGtrfu0vlN2NLUK_JLKmOqmvsM9nkHBa9u48JnJoQTXLDXxzTkRRjpjxy-mKxTC9ad4MyBuZ_dw95lW-KP1xYpe-UsDU1FJayXBJq0-4nZaD2SfWVikEr1H852OSGf1MB8J0oVJbYfT_n5YtG02VG1g\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/DsW6r-_gRdY/hqdefault.jpg\"]]]],[null,\"Welcome to Homescapes, a warm and cozy game from the famous Playrix Scapes™ series! Make match-3 combinations and turn every corner of your home into an inviting place to relax and have fun.\\u003cbr\\u003e\\u003cbr\\u003eSolve puzzles, restore the interior room by room, and meet new friends in every chapter of the exciting storyline. Austin the butler is ready to welcome you to a world of incredible adventures!\\u003cbr\\u003e\\u003cbr\\u003eGame features:\\u003cbr\\u003e● Original gameplay: make match-3 combinations and decorate your house while enjoying an exciting story!\\u003cbr\\u003e● Thousands of captivating levels with explosive power-ups, useful boosters, and cool elements.\\u003cbr\\u003e● Exciting events: embark on fascinating expeditions, compete against other players in different challenges, and win awesome prizes!\\u003cbr\\u003e● Unique rooms with original designs: from Austin\\u0026#39;s bedroom to a greenhouse.\\u003cbr\\u003e● Loads of fun characters: meet Austin\\u0026#39;s friends and your neighbors!\\u003cbr\\u003e● Adorable pets that will become your faithful companions!\\u003cbr\\u003e\\u003cbr\\u003ePlay with your Facebook friends, or make new friends in the game community!\\u003cbr\\u003e\\u003cbr\\u003eHomescapes is free to play, but some in-game elements (including randomized items) can be purchased for real money.\\u003cbr\\u003e\\u003cbr\\u003eA Wi-Fi or internet connection is not required to play.\\u003cbr\\u003e *An internet connection is required to access competitions and additional features.\\u003cbr\\u003e\\u003cbr\\u003eDo you like Homescapes? Follow us on social media!\\u003cbr\\u003ehttps://www.facebook.com/homescapes\\u003cbr\\u003ehttps://www.instagram.com/homescapes_mobile/\\u003cbr\\u003e\\u003cbr\\u003eNeed to report an issue or ask a question? Contact Player Support through the game by going to Settings \\u0026gt; Help and Support. If you can\\u0026#39;t access the game, use the web chat by clicking the chat icon in the lower right corner of our website: https://playrix.helpshift.com/hc/en/14-homescapes/\\u003cbr\\u003e\\u003cbr\\u003ePrivacy Policy: https://playrix.com/privacy/index.html\\u003cbr\\u003eTerms of Use: https://playrix.com/terms/index.html\"],\"Playrix\",\"500,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/U7-71AFKFm6f4Ak4Z0NxLZwebL-K2ZEvCn7mlgFn6LDP-yZe48jYk0hqnwNkoPQFLrpjfIRkkNrZmeocvVpI\"],null,[148,112,154,255]],null,[\"Rated for 7+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/1SrNtAwg9PFOhgMJPXehacRTeQNhHhG12Pj1zACHNVmfRfEZA3_oOEmLvRNsmYGeGHpas7sCwyR3y8OT\"]],[null,\"Fear\"],[null,\"Users Interact, In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/JTT-ImEkrbWzIL7w0fP8fQhVmpexdfh7u0P59PJtyJywmQBVolJjunMal6B5dUM6uiFiKnmtHtBbVvcWBMU\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.playrix.homescapes\\u0026rdid\\u003dcom.playrix.homescapes\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.superplaystudios.dicedreams\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/5MLgC2WWXcq1Pol8qRAXOKzIJY9qySkjF43DnWyd5F9fPj_heinHeIxvgIpPQwcaQ1w-mUzUmoP1Xeslf29irg\"],null,[53,201,254,255],null,null,null,2],[[null,2,[2688,1242],[null,null,\"https://play-lh.googleusercontent.com/nGxDBKERWswITWcGRAGuTgWVsdS6jyVZHHGfGaByaBc7cOz6zxA6QozgXrIGI2g8E3eP7zAgMLaYrLy5iR7pcew\"]],[null,2,[2688,1242],[null,null,\"https://play-lh.googleusercontent.com/Dtj5LnhXgzQdtfTYuztqm91VDvD6nxTyRXFSZ7h2A8_TqhHkLNqgJNQmnwOU6hpRxIOWR8vNCj_L3NyvrCI45A\"]],[null,2,[2688,1242],[null,null,\"https://play-lh.googleusercontent.com/HYH6yH0eov-_XA-QdQ0lEEdBBJqdmn6qMAAAT02dnCu0Sik28aY8TOY5ToAvdQsC5XR9hyCsTJB8toouimga8UU\"]],[null,2,[2688,1242],[null,null,\"https://play-lh.googleusercontent.com/0E7IokKbHs05SJuxWGhHjBEBa0pjFrQDG-FeThDp1lIvz6zk_NdRohMlsds-EiAu-wu682grL_Yo6x2uwsgDiDQ\"]],[null,2,[2688,1242],[null,null,\"https://play-lh.googleusercontent.com/sXV036fbJ1lwoV3Yf5DYpPLDU2fp-qp_T9eqb8br__J1BTVeuyuFmK5NGh6uyCvKTZ984R2kiasCeKPbQVpd\"]],[null,2,[2688,1242],[null,null,\"https://play-lh.googleusercontent.com/nI5m5Iccx_iAVliCLluImBGtle1vhwIfNUW515fFAVI42qTTW68Dps_uEG6L_0OYNdYh2X2Wg9EqJLQ1LOxNtg\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/3eOu-NmJzasmj0LSOqE6GkPObq4azEgPHDS1A04Ls9pxPfCHQF5OlhAuKvLZ9O3O8DggL3mRZONMoVGStLA26Q\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/Y2sZgxU5iyBTtALD9txBCkBOTHs77bf7LdVDLEKnZ2vFwvw6jxwmq7SjQM1MXViT6u_JihnZm4dI3ve-gBDMng\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/sT0nv9Bs2rHMI9-9C_r-6DbIF0XO3KCCwnKpSr8HtO6zEwvlRBN_X3HjbeqslLdSE6lMisdrAMjFYsq9hMEATA\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/EjGE5jhCtU-YBpuqYHCW_rlQXN_Vadpbf4w1FWt3ZPXbfGdXxwpTF1FKYSjU-5SKpQ058r2mzmHFUFDpYEPy8Q\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/9XBj46HtafdquuVyT1koZZDPZQk-S_y2HVnKgcKdYcoyKgCKvSLwuo5OUoSa7daL8F6bCjUTBx_CJBskhiSoxg\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/aplxORSLgjRhlYIWxKIXTjtWPXA0YKRA_HSUo-JgO58Kboi-Az_VnKUkMo5yjta02V4E6xmHSgQqeQdKOtcsv6Y\"]]],\"Dice Dreams™️\",[\"4.8\",4.77],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.superplaystudios.dicedreams\\u0026rdid\\u003dcom.superplaystudios.dicedreams\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.superplaystudios.dicedreams\"]],[\"qgJvGm0IBkoTCOi0hLLHkJcDFaoRgwMd/OULsPoBDwoNCAASCQoFZW4tVVMQALoCQQolCh9jb20uc3VwZXJwbGF5c3R1ZGlvcy5kaWNlZHJlYW1zEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],[[[null,null,\"_45D-nz0eT8\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:_45D-nz0eT8?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:_45D-nz0eT8\",null,null,null,null,\"AXH1ezni9eX3gB3Hbkh_yMA-sw2RxM2forLt2xMcuXAeHaQ5e8_kAQwERjz16hO8yPKYdQXSp-0hz2ke5pQTh-jesIC-uL3TQix1RhVlOKD0h5sIpJVOycS8paqFeNZ-FsDbw7NcYVGC2ldf14N3rbPHjDw7qvvcAR3pktVuZDejg_80sSj_0F0kxJZ96PzeP1UMGHjs3GUc24eTb0P4ZnxKJhBHZYLx2Gq8ounlbs9QU_kbH-iERNmQW9RHmvPOVNfFexfOUk-0-ssGFzlHucFyQ5Qh4QMnPCiBBsBU_nRDsNVczA\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/_45D-nz0eT8/hqdefault.jpg\"]]]],[null,\"\\u003cb\\u003e✨ Welcome to Dice Dreams – The Magical Board Game Adventure! 🎲👑\\u003c/b\\u003e\\u003cbr\\u003eJoin millions of players around the world in this dreamy dice adventure! Roll your dice, collect coins, and play your way to the top! Build your beautiful board, attack rivals, and steal their coins to grow your dice kingdom. 💖\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003e🎯 ROLL, ATTACK \\u0026amp; COLLECT COINS!\\u003c/b\\u003e\\u003cbr\\u003e Every dice roll is a chance to play, collect coins, and expand your board. 💥\\u003cbr\\u003e Use your slingshot to attack other boards and raid for their shiny coins!\\u003cbr\\u003e Got attacked? Get your revenge and show everyone who rules the dice game! 👑\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003e💞 PLAY WITH FRIENDS \\u0026amp; FAMILY\\u003c/b\\u003e\\u003cbr\\u003e It’s always more fun to play together! Connect with your Facebook friends and join the ultimate dice adventure. 🌈\\u003cbr\\u003e Share gifts, compete in tournaments, and laugh your way to victory in this exciting social dice board game.\\u003cbr\\u003e Build boards, collect coins, and celebrate every win with your favorite people! 🎉\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003e🌟 COLLECT STICKERS \\u0026amp; WIN BIG\\u003c/b\\u003e\\u003cbr\\u003e In Dice Dreams, every dice roll can reveal magical stickers full of surprises. ✨\\u003cbr\\u003e Complete your albums to unlock treasures and earn bonus coins to power up your dice game!\\u003cbr\\u003e The more you roll your dice, the more rewards you’ll discover. 💝\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003e🐾 FEED YOUR PET \\u0026amp; LEVEL UP\\u003c/b\\u003e\\u003cbr\\u003e Your adorable pet is waiting to join your dice journey! 🐶🍪\\u003cbr\\u003e Feed them cookies, watch them grow, and earn special game bonuses as they level up.\\u003cbr\\u003e Your cute little friend will bring you luck and joy in every dice board game adventure! 💕\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003e🎉 DAILY EVENTS, TOURNAMENTS \\u0026amp; CHALLENGES\\u003c/b\\u003e\\u003cbr\\u003e There’s always something fun to play! 🌟\\u003cbr\\u003e Join daily dice tournaments, win free rolls, and collect massive coin rewards.\\u003cbr\\u003e Each board brings fresh excitement and new adventures — every dice game feels magical!\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003e👑 BUILD YOUR DREAM KINGDOM\\u003c/b\\u003e\\u003cbr\\u003e Start small and play your way to a dazzling empire! ✨\\u003cbr\\u003e Roll your dice to collect coins and decorate your board with beautiful designs.\\u003cbr\\u003e Each dice board game world is filled with treasures, adorable characters, and endless joy!\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003e💌 CONNECT \\u0026amp; SHARE THE FUN\\u003c/b\\u003e\\u003cbr\\u003e Send gifts, share coins, and trade stickers with friends worldwide. 🌍\\u003cbr\\u003e Collaborate, compete, and make every game moment more magical together. 💖\\u003cbr\\u003e Whether you’re building your dream board or stealing coins from rivals — the fun never ends when you roll the dice!\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003e🎲 FEATURES YOU’LL LOVE:\\u003c/b\\u003e\\u003cbr\\u003e ✨ Roll dice and collect coins to build your perfect board\\u003cbr\\u003e 💞 Play with friends and join exciting dice tournaments\\u003cbr\\u003e 🐾 Feed adorable pets and unlock powerful bonuses\\u003cbr\\u003e 🌈 Discover magical dice board game worlds full of surprises\\u003cbr\\u003e 💰 Earn free rolls, stickers, and treasures every day!\\u003cbr\\u003e\\u003cbr\\u003eDice Dreams™ is free to play and full of joy! 🌸\\u003cbr\\u003e You can also purchase in-app items with real money to enhance your dice game experience.\\u003cbr\\u003e Requires an internet connection.\\u003cbr\\u003e💌 Need help? Contact us at support@superplay.co\\u003cbr\\u003e 🌟 Follow us on Facebook for exclusive bonuses: facebook.com/DiceDreams\\u003cbr\\u003e🎲 Roll the dice, collect coins, and make your dreams come true in Dice Dreams™ – the most magical dice board game adventure ever! 💖✨\"],\"SuperPlay.\",\"50,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/jZxrlBZlBckylCQbtdTF082laUuKjg0H9xzAtDgZG9vJeFx9KZHGZiS_VXkJ4SG9vxFxbeFw0m4RSgLbxXrW\"],null,[234,239,243,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.superplaystudios.dicedreams\\u0026rdid\\u003dcom.superplaystudios.dicedreams\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.supercell.hayday\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/JS_D56z98J--k7A4vnzdnLlyNyBPp3tEPDXn8bYZo_goQY5j7GS7bNAcgOIR_2aVBWNJvXoLLEMNxkugEIog2w\"],null,[239,234,237,255],null,null,null,2],[[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/P1O2T4v8SSdN7iJNrEJ0EzfSniEtm-boFCtB7HgQgKbvfIyB1YWqWCd7Y1LmMhbF5jzaLYnFXuv18ElO9GnAaQ\"]],[null,2,[1080,1920],[null,null,\