com/8RkPG9h5_AdrivlJx3orVcJkf4jU1_7ttXMMchKL3KuFv7CqQ3e2HZ5m7LdTvC6FWuVOS-jgaFLCLjaokOFh\"]],[null,2,[2028,1280],[null,null,\"https://play-lh.googleusercontent.com/UvCLmqOJzHWObx4uPxO16EpJKUOCj65OzD1m6phRp_mpJLZvhqeClyQvEtpXnLy9vLe_sqpu3--N7FFmVtMUS_w\"]],[null,2,[1280,2028],[null,null,\"https://play-lh.googleusercontent.com/i_20MzbSIQKMJtXd76z4E-Dr0bQ31MXIniUK5d1fC0uvP93QaZeGs2MS0Q_URIs1Ayzo4d7Wa5e7UfTe6U8TzA\"]],[null,2,[1280,2028],[null,null,\"https://play-lh.googleusercontent.com/74bQqYrMM9_D8xs9xYFLnZpGPZ7hEtABZouTRUsR9TzzeYBQSHUBtjfMx6SE-1LU32gAbs_xJpK0znRQE6RiIA\"]],[null,2,[1280,2028],[null,null,\"https://play-lh.googleusercontent.com/5Mxpl99TeHS2xauDZA8GAymE981JgVO_fg_G1dgtqKgD1g1YqYdROlcGLGFlPYeGppJ1p1b29OB6qgaJkJ1e9-E\"]]],\"Pet Rescue Saga\",[\"4.5\",4.46],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.king.petrescuesaga\\u0026rdid\\u003dcom.king.petrescuesaga\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.king.petrescuesaga\"]],[\"qgJmGmQIIkoTCOi0hLLHkJcDFaoRgwMd/OULsPoBDwoNCAASCQoFZW4tVVMQALoCOAocChZjb20ua2luZy5wZXRyZXNjdWVzYWdhEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],[[[null,null,\"5SaRg2Lefbs\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:5SaRg2Lefbs?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:5SaRg2Lefbs\",null,null,null,null,\"AXH1eznj17rtiSehQGRGCyg_0cfN_xRqw6MDT6-D05taSAf-XgNTFkLl3Kg0_drVFVK4RuNAfAZeo_wE4-yzkDfR5ohkn_tH8MO6R7gBAk4hh7UMKFZVLulbhp3gQ1kmbO5wKIQqSVsniy8LLnUJy5OKBRDZo3Vxg5V_9xyhVjLSss6nMtnObqiM8gslGg80Joq2XSvGgzy3zfRw7XRBOWiEjdG1jRWSzYUrOJuolEx_u2huTLn_oSjcPQZVQQTFckMjatoVXNFbBOBfIRa8sexKet6fkVuet6a3ah3Ze0RCDhyUfw\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/5SaRg2Lefbs/hqdefault.jpg\"]]]],[null,\"Puppies and kittens are stuck between the puzzle blocks in this Pet Rescue Saga adventure and need your help! Hurry and save them from the evil Pet Snatchers! \\u003cbr\\u003e\\u003cbr\\u003eMatch 2 or more blocks of the same color to clear the levels and save the pets. Matching moves are limited so plan carefully to blast as many blocks as possible, solve the puzzles, and save the pets. Your puzzle skills will be tested with hours of block busting fun!\\u003cbr\\u003e\\u003cbr\\u003eJoin the rescue mission and solve increasingly challenging match 3 puzzles! Match and blast blocks in a variety of events and puzzles to discover a whole new variety of pets waiting to be rescued! Not only do you save the puppies and kittens but you also build an animal shelter for them. Blast your way through the puzzle levels!\\u003cbr\\u003e\\u003cbr\\u003eLots of fun events\\u003cbr\\u003eBlast blocks and solve new matching puzzles to win boosters and bonus rewards! Discover fun time-limited games and play increasingly challenging levels, so blast the right blocks!\\u003cbr\\u003e\\u003cbr\\u003ePetopia: a whole city, but for pets!\\u003cbr\\u003eDon’t leave your animals out in the cold, send them off to Petopia City! Clear puzzles to build a city for your rescued pets and visit them in their new home.\\u003cbr\\u003e\\u003cbr\\u003eGrow your pet\\u003cbr\\u003eEvery 2 weeks, collect red blocks within the game levels to grow your pet by earning treats; the more red blocks, the more treats!\\u003cbr\\u003e\\u003cbr\\u003eWeekly match 3 quests\\u003cbr\\u003eComplete match 3 quests every week and gain rewards by solving new puzzles. Hop on to the next quest and start matching blocks!\\u003cbr\\u003e\\u003cbr\\u003eWith 5,600+ pet puzzles and more levels added every 2 weeks to the game, Pet Rescue Saga is a real match 3 blast! Are you ready for some pet-tastic fun?\\u003cbr\\u003e\\u003cbr\\u003ePet Rescue Saga from the makers of Candy Crush Saga, Farm Heroes Saga, and Bubble Witch 3 Saga is free to play but some in-game items such as extra moves or lives will require payment. You can turn off the payment feature by disabling in-app purchases in your device’s settings.\\u003cbr\\u003e\\u003cbr\\u003eBy downloading Pet Rescue Saga you agree to our terms of service which can be found at https://king.com/termsAndConditions\\u003cbr\\u003e\\u003cbr\\u003eDo not sell my data: King shares your personal information with advertising partners to personalize ads. Learn more at https://king.com/privacyPolicy. If you wish to exercise your Do Not Sell My Data rights, you can do so by contacting us via the in-game help center or by going to https://soporto.king.com/contact\"],\"King\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/rJt8xSup44h_RsGrmFcsgmoqxFWC4DwpEu3JGv1Mb8Mt5_BSYjA_-147JjaFyebJGNxl716LBPucvFYiSDD1daM\"],null,[178,221,57,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Users Interact, Shares Info, Digital Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.king.petrescuesaga\\u0026rdid\\u003dcom.king.petrescuesaga\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,