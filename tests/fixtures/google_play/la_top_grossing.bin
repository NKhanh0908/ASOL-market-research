,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/_j-MJ0WQ2t8rOjD1Us5JLQl2b1CwUYePQNL5r_uKOVAoAcD3_nx-ttiNOGuovKYGF8ttNG68Do2aOO6qtm5klJo\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/JpimNraE1hlWuhlXyMp060rjwHNHxBKzU8WaTzR1RmJVUqpzMpSGF_PLOZszi7Jp4x3e-4B6qzMc4-KpoqEiJg\"]]],\"Box Jam! - 3D puzzle\",[],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.playoneer.boxjam\\u0026rdid\\u003dcom.playoneer.boxjam\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.playoneer.boxjam\"]],[\"qgJeGlwIQEoTCOi0hLLHkJcDFaoRgwMd/OULsPoBDwoNCAASCQoFZW4tVVMQALoCMAoaChRjb20ucGxheW9uZWVyLmJveGphbRABGAMSEgoECAEQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,null,[null,null,\"https://www.youtube.com/watch?v\\u003dZnb62tAJ6ow\"]],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/Znb62tAJ6ow/hqdefault.jpg\"]]]],[null,\"Box Jam! - 3D Puzzle Game\\u003cbr\\u003ePlay a unique and satisfying 3D puzzle game where you sort and organize realistic objects into moving boxes. Box Jam is the perfect combination of sorting, logic, and visual satisfaction.\\u003cbr\\u003e\\u003cbr\\u003eBox Jam! - 3D Sorting Puzzle Game for Relaxing Brain Challenges\\u003cbr\\u003eBox Jam offers a fresh puzzle experience that stands out from typical match-three games. In this addictive sorting game, your task is to drag and place 3D items—like fruits, candy, tools, and toys—into their matching boxes before the conveyor moves on. The game is designed for fans of relaxing games, brain teasers, and sorting puzzles.\\u003cbr\\u003e\\u003cbr\\u003eWhat makes Box Jam a top 3D puzzle game?\\u003cbr\\u003e-Realistic 3D Sorting Gameplay: Sort hyper-realistic 3D objects by dragging and dropping them into the right box. Every level challenges your visual recognition and reaction speed.\\u003cbr\\u003e\\u003cbr\\u003e-Combo Mechanic for Extra Rewards: Complete quick, consecutive sorting actions to activate combos. Combos trigger lightning effects that clear items and unlock bonus coins, enhancing both score and satisfaction.\\u003cbr\\u003e\\u003cbr\\u003e-No Match-3 Required – Just Pure Sorting: Unlike traditional puzzle games that require matching threes, Box Jam focuses on organizing items into matching targets with no need for color chains or candy swaps.\\u003cbr\\u003e\\u003cbr\\u003e-Relaxing Yet Strategic Gameplay: The game combines calming sounds and smooth animations with increasingly challenging levels. It’s ideal for winding down or testing your puzzle-solving strategy.\\u003cbr\\u003e\\u003cbr\\u003e-Offline Sorting Game – No Wi-Fi Needed: Enjoy uninterrupted gameplay anywhere. Box Jam supports full offline play for travel, breaks, or screen-free time.\\u003cbr\\u003e\\u003cbr\\u003e-Designed for All Ages and Skill Levels: Whether you’re a puzzle game expert or casual player, Box Jam’s intuitive design, soft 3D visuals, and steady difficulty curve make it accessible and fun for everyone.\\u003cbr\\u003e\\u003cbr\\u003e-Polished 3D Graphics and Animations: Each item in the game—candy, screws, cakes, and more—is beautifully rendered in 3D, giving a tactile, satisfying feel to every move you make.\\u003cbr\\u003e\\u003cbr\\u003e-New Levels and Content Updates: Stay engaged with frequent content updates, including new sorting challenges, themes, items, and mechanics that keep the game fresh.\\u003cbr\\u003e\\u003cbr\\u003eStart your sorting journey now.\\u003cbr\\u003eDownload Box Jam! - 3D Puzzle Game for free and experience the most satisfying and strategic object sorting puzzle on mobile.\"],\"Playoneer Games, Ltd.\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/XmYomA715UUfdOJuNYXMG0jlnGwrwZIM2S6ldCFM9Jcm6WMRKvjUfawYGJASsVIXbwnJGX0TeL06U0Zl8sDs\"],null,[35,157,238,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Users Interact\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.playoneer.boxjam\\u0026rdid\\u003dcom.playoneer.boxjam\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.drg.woolpuzzle3d\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/RAfleP77cpj0P86YHiV_9yqeezwnl1yOlL2NefSbFz1W3wIn7__F9jGqeVmI6bOFQMfMPwnvtMY-pKVdoN9L1zg\"],null,[135,254,135,255],null,null,null,2],[[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/L-VBj76JG6BzIjg_ZxJXssM6gbkE0y3JYVkPAlhAf41RhoeTs1cjDZkZk5QFff1zKe_C2Cf9hCTYlBMy6gWALw\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/vWryjtI6V8CmpA1Jk_v7aRRTmbAEg8_IFi54rsK1tgSlNItwXaMGmlaGvIaiUT0hRdJr8cpMbM-sEJx295ly\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/u4wVJnnxSEUkce-pqDAo5eY1J-Qu_WuF7ZtKl0yAx3eMCFsS9z6-Zr8KevJ