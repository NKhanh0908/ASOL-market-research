l,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.bestplaygame.screwmatch\"]],[\"qgJrGmkIU0oTCOi0hLLHkJcDFaoRgwMd/OULsPoBDwoNCAASCQoFZW4tVVMQALoCPQohChtjb20uYmVzdHBsYXlnYW1lLnNjcmV3bWF0Y2gQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],null,[null,\"This is a casual brain-challenging strategy game. Unlock the screw puzzle and play the plot mini-game. Start challenging your brain now!\\u003cbr\\u003e\\u003cbr\\u003eHow to play?\\u003cbr\\u003eThe goal of the level is quite simple. You just need to put the screws into the toolbox of the corresponding color to complete the challenge. As the level increases, there will be various obstacles blocking you from passing the level. At this time, you need to show your unique strategy and use your brain to unlock the puzzle.\\u003cbr\\u003e\\u003cbr\\u003eThe levels of the game are special and interesting. Each level is carefully designed, and each level will not be repeated, so you will not feel bored. As the level increases, different ways of playing will appear, making the level full of fun!\\u003cbr\\u003e\\u003cbr\\u003eThere are thousands of levels here, and the game content is constantly updated. The rich game content and unique game activities are refreshing. There are also exquisite plot mini-games waiting for you to explore.\\u003cbr\\u003e\\u003cbr\\u003eDo you think the level is difficult? Don\\u0026#39;t worry, there are a variety of props for you to choose from to help you easily beat the level. Use props to smash obstacles, increase holes, and increase toolboxes. And there are a lot of activities in the game, you can get a lot of props from them, and it is not a dream to pass the level easily.\\u003cbr\\u003e\\u003cbr\\u003eThis is a game that perfectly combines plot mini-games and puzzle levels. Here you can experience unforgettable and interesting levels, and explore rich plots. Challenge the screw level puzzles and dig out more happiness!\"],\"AlphaPlay Games\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/oVjx0BW6HZSBRLMS411B93XaVvlBwjCXCC5q5htjMx91Gya7Ak-ZWeUCZnyY_6cOzak15PNRJLoP5CmcwsPaSt0\"],null,[239,183,166,255]],null,[\"Rated for 7+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/1SrNtAwg9PFOhgMJPXehacRTeQNhHhG12Pj1zACHNVmfRfEZA3_oOEmLvRNsmYGeGHpas7sCwyR3y8OT\"]],[null,\"Implied Violence\"],null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/JTT-ImEkrbWzIL7w0fP8fQhVmpexdfh7u0P59PJtyJywmQBVolJjunMal6B5dUM6uiFiKnmtHtBbVvcWBMU\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.bestplaygame.screwmatch\\u0026rdid\\u003dcom.bestplaygame.screwmatch\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.wannaplay.giantcrush\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/BHc7ukFLDjjt6dXWKTzTZl-Qe0yGWnPrlj_ss6rpKO0z16FOOtS8ekRlN6cEySS_LeGjCAG3Wu_lJgeMHvOe\"],null,[50,49,38,255],null,null,null,2],[[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/FeGr07YImp0wQCoYIJxJ_RroAErIf6Ob1d094nRCjj6uLb0ZN6sIlqmkMdbpVZH6NmEoSe2xu9zJPWdMcvrXdg\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/sA74v