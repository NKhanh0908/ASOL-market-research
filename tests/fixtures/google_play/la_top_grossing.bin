aEl7Z0nFC31bsyQdVBo2gGrbgNNb3uto_ftCp_qgIkyUrc1PChYwQ75DQ\"]],[null,2,[2450,1080],[null,null,\"https://play-lh.googleusercontent.com/iqtW_S36gKUb4kaavFnzHWEwAtpU-2pn8_xW9CGDfoGEngSRodgkf2Y2KSMZk09AeShJ7LeY9MPrD_kucjdO\"]],[null,2,[2450,1080],[null,null,\"https://play-lh.googleusercontent.com/pbzdMukfEOIJ9Dckm4uaTyzp4NGWqvtav0qlshcF-jMAS-O_XJMKwQzqHfvc4g4BTQlf001-i1RXPCe9DqOX\"]]],\"Jam Bus:Sandfall\",[],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dbus.sand.fall.jam.loop.traffic.flow\\u0026rdid\\u003dbus.sand.fall.jam.loop.traffic.flow\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dbus.sand.fall.jam.loop.traffic.flow\"]],[\"qgJtGmsIHkoTCOi0hLLHkJcDFaoRgwMd/OULsPoBDwoNCAASCQoFZW4tVVMQALoCPwopCiNidXMuc2FuZC5mYWxsLmphbS5sb29wLnRyYWZmaWMuZmxvdxABGAMSEgoECAEQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"Jam Bus: Sandfall brings a fresh twist to bus jam, color puzzle, and traffic escape gameplay.\\u003cbr\\u003eColorful sand is stacked in layers, and every bus has its own color and direction. Tap the right bus, collect the matching sand, and clear the board step by step. Sounds simple at first, but every move can change the whole puzzle.\\u003cbr\\u003ePlan carefully before you tap. Some buses may block each other. Some paths may cross. Some sand colors can only be cleared after the lower layers are gone. To win, you need to observe the board, choose the right order, and keep every bus moving without a crash.\\u003cbr\\u003eHow to play\\u003cbr\\u003e• Tap a bus to move it along its route\\u003cbr\\u003e • Match each bus with the same color sand\\u003cbr\\u003e • Clear lower sand layers to unlock the ones above\\u003cbr\\u003e • Avoid traffic crashes when paths cross\\u003cbr\\u003e • Solve each level with smart sequencing\\u003cbr\\u003eWhy you’ll enjoy Jam Bus: Sandfall\\u003cbr\\u003e• Easy tap controls\\u003cbr\\u003e • Relaxing color-matching gameplay\\u003cbr\\u003e • Clever bus parking jam puzzles\\u003cbr\\u003e • Satisfying sand-clearing effects\\u003cbr\\u003e • Increasingly tricky routes and layers\\u003cbr\\u003e • Clean visuals and smooth puzzle flow\\u003cbr\\u003e • Great for quick breaks and brain training\\u003cbr\\u003eEvery level is a small logic challenge. A bus may look ready to move, but its route might block another vehicle. A color may be visible, but the sand below it must be cleared first. Think ahead, follow the arrows, and find the perfect order to clear the whole sandfall.\\u003cbr\\u003eIf you enjoy bus games, parking jam puzzles, color sort games, traffic escape challenges, or relaxing logic games, Jam Bus: Sandfall gives you a colorful new puzzle to solve.\\u003cbr\\u003eStart with one bus, clear one color, and let the sand fall into place.\"],\"Nova Games Technology Limited\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/Xxtz7lOU2yqCxGMmNiyNb3e-OEhEoW_TeIylWnJOAaXHSDGGAQhJSs12d5B4L6TFUPOV3-3f00S0dPXRunndNQ\"],null,[117,111,117,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Users Interact\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dbus.sand.fall.jam.loop.traffic.flow\\u0026rdid\\u003dbus.sand.fall.jam.loop.traffic.flow\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.liteorange.hometopia\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/DNlTlOWp5zc9Xe77eizL8vU7aT72_SwVwSHcz0NtSlMz6Dmosk8BM_PDv3h2Zd661HVX9gK2klsySgKmaGoiUJk\"],null,[145,186,242,255],null,null,null,2],[[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/aWQarOpCPESeAsLj1xVfRsU7LZJh9ka-WQOCQo8CaJhfYz89nuGR1AUzHB17FnMTLw0WFf3siKhysVwPh3s6\"]],[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/lxB9LgGwwx8eJCeqimCIOHSAc_W5foOIoKgZolc1TSIbs0qp8vunjXkkoPytlUC-r9xcetIu6vjmXKyJTFHYuA\"]],[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/3pd4sXVRwJ5tK-wNGMWYivdgdYWbxL-9A7Sc0bQSmHEu3vis8jM0IK7RtfGrm5yxAoCdWXd8QbNkl8vAnRvM\"]],[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/MDKHx1Qj5PECJUvVlqU8L6kCTeFIKPIlxNFlImTQRn2z30JacNUs_zU5sz-WDJAwX8gV_kwia5jRvKdW8NPLHA\"]],[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/i5bxaH2Xfz1Vi9WuNDECSYTVIU-vPRhJ6KNH-AXzW__QEY2HCydPIZhkXsAqM_CFpnH0G8h6p_eINdp1JTbpbT4\"]],[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/gndFMzlL0YOXUFXhvORbdETmiuf44XI-W6YwcrSaTWaWXnpyM2GYsmjKuDg8NEa5zctGvDHxKwIazfaw0fis\"]],[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/rmuP3GK0b0mfdbK0Sit4CMqduRwSz6VUXKv3d0uXXD2mhP132Vyx7aPKBppIEKed5Q1GobU7CmgyFfeBSRHH2A\"]]],\"Frost Valley™: Merge \\u0026 Story\",[\"4.5\",4.5],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.liteorange.hometopia\\u0026rdid\\u003dcom.liteorange.hometopia\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.liteorange.hometopia\"]],[\"qgJoGmYIH0oTCOi0hLLHkJcDFaoRgwMd/OULsPoBDwoNCAASCQoFZW4tVVMQALoCOgoeChhjb20ubGl0ZW9yYW5nZS5ob21ldG9waWEQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],null,[null,\"Welcome to Frost Valley: Merge \\u0026amp; Story—a cozy place recovering from a long, chilly winter.\\u003cbr\\u003e\\u003cbr\\u003eThe frost may have slowed things down, but with a little help, warmth and color are ready to return.\\u003cbr\\u003e\\u003cbr\\u003eMerge items, follow story steps, and enjoy watching each frozen corner feel alive again.\\u003cbr\\u003e\\u003cbr\\u003eAlong the way, you’ll meet friends who are starting over and happy to have your help.\\u003cbr\\u003e\\u003cbr\\u003eMerge to Discover\\u003cbr\\u003eTap, drag, and merge to uncover bigger, better, and more exciting items.\\u003cbr\\u003eCollect merged items to advance chapters, unlock new scenes, and restore each space step by step.\\u003cbr\\u003e\\u003cbr\\u003eRestore to Revive\\u003cbr\\u003eFix up frosty homes and make each space feel warm and welcoming again.\\u003cbr\\u003eEach repair opens new rooms and scenes, gently showing the valley coming back to life.\\u003cbr\\u003e\\u003cbr\\u003ePlay to Reward\\u003cbr\\u003eJoin cozy in-game events with new characters, festive themes, and fun little stories.\\u003cbr\\u003eCollect special rewards that add fun surprises and new moments to enjoy.\\u003cbr\\u003e\\u003cbr\\u003eStart your journey today and help Frost Valley find its warmth again—one merge at a time.\\u003cbr\\u003e\\u003cbr\\u003ePrivacy Policy: https://www.liteorange.co/ps.html\\u003cbr\\u003eTerms of Service: https://www.liteorange.co/terms.htm