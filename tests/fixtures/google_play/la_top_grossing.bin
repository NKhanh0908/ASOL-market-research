],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/B5hw7uecJoI3way5ZvhCIcytIH9RpwIHYMKTmf9pMJ8NkYgKdxDMZItxuWtvUxmG0aUXw9T1r5U9i7fjheoP9Q\"]]],\"Aisle Secrets: Merge the Drama\",[],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.mybogames.mergetown\\u0026rdid\\u003dcom.mybogames.mergetown\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.mybogames.mergetown\"]],[\"qgJhGl8IJ0oTCOi0hLLHkJcDFaoRgwMd/OULsPoBDwoNCAASCQoFZW4tVVMQALoCMwodChdjb20ubXlib2dhbWVzLm1lcmdldG93bhABGAMSEgoECAEQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"After a messy divorce, Ellie thought her life couldn’t get worse—until she was unexpectedly dragged to a quiet town with more secrets than people. Now stuck in Lovelane, she’s handed the keys to a rundown pharmacy and told to make it work.\\u003cbr\\u003eWhat starts as survival becomes something more. As Ellie merges items, revives the store, and meets eccentric townsfolk, she begins to uncover the tangled web of secrets hidden in plain sight.\\u003cbr\\u003e🔍 Merge, Build, and Discover\\u003cbr\\u003e Combine everyday items to renovate and expand your pharmacy. From dusty shelves to modern wellness counters, it\\u0026#39;s up to you to transform this place into a thriving shop.\\u003cbr\\u003e💬 Story-Rich Drama\\u003cbr\\u003e Every customer has a story. Some are heartwarming, others heartbreaking—and a few are downright suspicious. Follow Ellie’s journey as she regains control of her life and untangles the truth behind her arrival.\\u003cbr\\u003e👗 Customize \\u0026amp; Create\\u003cbr\\u003e Upgrade the pharmacy, decorate the town square, and give Ellie a fresh new look as she grows from reluctant outsider to determined entrepreneur.\\u003cbr\\u003e❤️ Romance, Rivalries \\u0026amp; Secrets\\u003cbr\\u003e Loveland may look quiet, but beneath its charming surface are old flames, nosy neighbors, and hidden enemies. Who can Ellie trust—and what will she do when the past catches up?\\u003cbr\\u003ePlay Aisle Secrets: Merge the Drama today and start your journey of healing, discovery, and maybe a little revenge.\"],\"MYBO\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/WCTquyd1pxoT5SMsoq6bhnHCa5QEa3T1EbcnQfOolOT0Zmv0AEImtEF8tO9eHwZGReSKhzn3UlGuPBAkYDWdIg\"],null,[213,192,164,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,[null,\"Suitable for all age groups. Some violence in a comical or fantasy context is acceptable. Bad language is not permitted.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.mybogames.mergetown\\u0026rdid\\u003dcom.mybogames.mergetown\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.funplus.familyfarm\",7],[null,2,[512,51