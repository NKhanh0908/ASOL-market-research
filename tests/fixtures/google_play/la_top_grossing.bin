],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/A-VHNHt2ZHIBbY5YmQi41j1UjtGt24M34LUvsTFfeNtU9OflNl8eRPj79Rmf3Tq-r8GUNoHVrLspn_H4czkG\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/Q-Ek8LFLspochsbt7z9e4r0TpLkQJmrsvBUWTCrNKEuqfrtDTqTrZIjweqfdx2ikfJVhrP1RGsYe0G5RXSOqRkw\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/fcpEFqLClPF2jG7ZGrBL5z8opNx7iaRDDaO8YxBoA3nEhv8tGBTyiTO1jXXaElRxOCEhDuHQdSVJ6MD3DyavKQ\"]]],\"Dream Family - Match 3 Games\",[\"5.0\",4.9722223],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.cookie.match3.casual\\u0026rdid\\u003dcom.cookie.match3.casual\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.cookie.match3.casual\"]],[\"qgJoGmYILUoTCOi0hLLHkJcDFaoRgwMd/OULsPoBDwoNCAASCQoFZW4tVVMQALoCOgoeChhjb20uY29va2llLm1hdGNoMy5jYXN1YWwQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],null,[null,\"Join our match 3 game now and immerse yourself in the dreamy world of our sweet village! Experience endless joy and excitement as you decorate your family-inspired sanctuary. Help charming creatures crush desserts across hundreds of magical levels. Renovate the mansion with a touch of family warmth and save characters in need.\\u003cbr\\u003e\\u003cbr\\u003eKey features:\\u003cbr\\u003e· Thousands of well-designed levels featuring jams, cookies, and cute obstacles in this match 3 game.\\u003cbr\\u003e· Use unique magic boosters to help you level up!\\u003cbr\\u003e· Get daily rewards.\\u003cbr\\u003e· Collect stars by solving puzzles to unlock beautiful rooms in the match 3 game.\\u003cbr\\u003e· No Wi-Fi or internet connection is required. This game is an excellent way to pass the time.\\u003cbr\\u003e· Regular updates with new levels to keep your brain challenged.\\u003cbr\\u003e\\u003cbr\\u003eBuild a sweet town in match 3 games that your dream family will adore. Decorate your unique manors that tie into the story, reflecting the dreams of the characters and saving them in danger!\\u003cbr\\u003e\\u003cbr\\u003eCrush treats, biscuits, and jam in thousands of thrilling levels designed to fulfill your sweetest family dreams. Download this match 3 game to begin the journey in a world where every crush is a step closer to realizing your dream family village!\"],\"Playflux\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/OeKqfBJ7fT1kmLuf1MWBeo5fFTM8wjY3cbQ7MWoBMmt1AWUkvKs41Xto9tnFx5lsxG78OY6Rx_1s79pQ3p2rE4Y\"],null,[168,170,16,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Users Interact, In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.cookie.match3.casual\\u0026rdid\\u003dcom.cookie.match3.casual\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null