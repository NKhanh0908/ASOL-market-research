content.com/cqqY8jrxqQMlZl4uZ0r_NraueYm8ytL-zE7-mR6yBdjshIPQ_cNuu2J-cAEZz4-UrwGyIaIpHQfIhJriD1OtEWo\"]],[null,2,[1920,1200],[null,null,\"https://play-lh.googleusercontent.com/WSVsCnDaOZVvz4jm-caCJmRbyxQsq-Mx1iXxIUtaeY0PSGGzZmGAEbaAiYIbVoeh4y3J14VxyCCG0Gv9Y9juPA\"]],[null,2,[1920,1200],[null,null,\"https://play-lh.googleusercontent.com/PRzHDRR5I7cQnUztVhV8oUUAltenQBJuFJGbq4qnosvVJU3oNrXsQ6eUilb12KnGljHeJqPGPk9KzobuYu7hWQ\"]]],\"Merge Crime: Mystery \\u0026 Romance\",[],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.standegg.mergecrime\\u0026rdid\\u003dcom.standegg.mergecrime\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.standegg.mergecrime\"]],[\"qgJhGl8IY0oTCOi0hLLHkJcDFaoRgwMd/OULsPoBDwoNCAASCQoFZW4tVVMQALoCMwodChdjb20uc3RhbmRlZ2cubWVyZ2VjcmltZRABGAMSEgoECAEQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"\\u0026quot;You can’t escape me, Janey Hart.\\u0026quot;\\u003cbr\\u003eNew York is hit by a series of brutal crimes.\\u003cbr\\u003eJaney, a genius profiler, faces Gilbert, a vicious serial killer.\\u003cbr\\u003e\\u003cbr\\u003eHunter and hunted.\\u003cbr\\u003eHate and obsession collide in a deadly mind game.\\u003cbr\\u003eIt all starts with your choices.\\u003cbr\\u003e\\u003cbr\\u003e🔍 Solve the Case — merge clues in a mystery story\\u003cbr\\u003eMerge clues. Finish missions. Solve the case.\\u003cbr\\u003eThe truth is in your hands.\\u003cbr\\u003e\\u003cbr\\u003e💘 Charming Companions\\u003cbr\\u003eJaney leads. A brave detective. A secretive informant.\\u003cbr\\u003eWork together—feel the romance and the thrill.\\u003cbr\\u003e\\u003cbr\\u003e🗝️ Shocking Truths \\u0026amp; Hidden Pasts\\u003cbr\\u003eSome hide the truth. Others hide the past.\\u003cbr\\u003eAs clues add up, who will you trust?\\u003cbr\\u003e\\u003cbr\\u003e🎁 Tons of Content to Explore\\u003cbr\\u003eClear hundreds of fun quests and earn rewards.\\u003cbr\\u003eNew chapters and stories keep coming.\\u003cbr\\u003e\\u003cbr\\u003ePlay at your own pace—easier than most merge puzzle games!\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eFAQ\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003eQ. Can I play offline?\\u003cbr\\u003eA. Yes, except for some content.\\u003cbr\\u003e\\u003cbr\\u003eQ. Will my data transfer to a new device?\\u003cbr\\u003eA. Yes, when your account is linked.\\u003cbr\\u003e\\u003cbr\\u003eSupport: mergecrime@standegg.com\\u003cbr\\u003e\\u003cbr\\u003e[Customer Support]\\u003cbr\\u003esupport@standegg.com\\u003cbr\\u003e\\u003cbr\\u003e[Terms of Service]\\u003cbr\\u003ehttps://korstandegg.wixsite.com/policy/terms\\u003cbr\\u003e\\u003cbr\\u003e[Privacy Policy]\\u003cbr\\u003ehttps://korstandegg.wixsite.com/policy\\u003cbr\\u003e\\u003cbr\\u003eThis game offers in-app purchases. Purchasing paid items will incur costs, and the purchase amount includes VAT.\"],\"StandEgg Co., Ltd.\",\"100,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/9rEUDG1easKYFuU6M6GUka_VcfRKaKBuw92GBtawHYR9f5OgrOEG4Q78QrAG1wqpV4nqJ0cfNd4jAqsg1n-gyQ\"],null,[2,57,74,255]],null,[\"Rated for 7+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/1SrNtAwg9PFOhgMJPXehacRTeQNhHhG12Pj1zACHNVmfRfEZA3_oOEmLvRNsmYGeGHpas7sCwyR3y8OT\"]],[null,\"Implied Violence, Mild Violence\"],null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/JTT-ImEkrbWzIL7w0fP8fQhVmpexdfh7u0P59PJtyJywmQBVolJjunMal6B5dUM6uiFiKnmtHtBbVvcWBMU\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,