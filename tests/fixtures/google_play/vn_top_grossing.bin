t.com/dnPAwNqUg_G_IJQeODIUEhO8J4zh1AqkmKVZ6huH7SQKJLju28BgUyH10n2YM5lwlXV4cazYzYlu4rGGPTKA\"]],[null,2,[1920,1200],[null,null,\"https://play-lh.googleusercontent.com/z63Ojzu_xDPtzFmtRYPvvnbb2b2M8EVePx3eBAhrCqU_0AwpsC-0UN40sHuH-rXcT_PLFukoMl1CmMqiy8cAgg\"]],[null,2,[1920,1200],[null,null,\"https://play-lh.googleusercontent.com/nfy08lJoDnuckwKEprqpyy53OyN8phsyXMBCzED43G-7RZAEiyxzmKCXHVHKhR-sUNm7hAK1GxevcvRIrZIz\"]],[null,2,[1920,1200],[null,null,\"https://play-lh.googleusercontent.com/LLx2G7T-cqCkFY2XpQ3TfIagL-8vdFZvhlPKZPNJuX75l5DLvkq5aKWEurV-i7LoqQOzkp6JQNLdVqAGlXld\"]],[null,2,[1920,1200],[null,null,\"https://play-lh.googleusercontent.com/APaY7yrJ3FG10NaqORNZsG9dkn8HJ_88YLnrjmq__jwKhBC92X7wnAkpCj7Z9cbSXDxVdFL1MzM6RyIoW0Zx\"]],[null,2,[1920,1200],[null,null,\"https://play-lh.googleusercontent.com/FmOsWe-VJl14vD3swGgka3wnicCmvWmpxhE2gDZ1d81P4QyHilr9CUOTI5sVSbxEqLGOSmxiBkpOh-Xd869ctCM\"]],[null,2,[1920,1200],[null,null,\"https://play-lh.googleusercontent.com/VRPIyeW2ND4BtzuG3msAEaTtYsALBxb5rnQ_Ch-NIo_DIB1ZRk1_NsMEUSrt8W_KqkAdmskrG0q33easDo3cyw\"]],[null,2,[1920,1200],[null,null,\"https://play-lh.googleusercontent.com/dnPAwNqUg_G_IJQeODIUEhO8J4zh1AqkmKVZ6huH7SQKJLju28BgUyH10n2YM5lwlXV4cazYzYlu4rGGPTKA\"]],[null,2,[1920,1200],[null,null,\"https://play-lh.googleusercontent.com/z63Ojzu_xDPtzFmtRYPvvnbb2b2M8EVePx3eBAhrCqU_0AwpsC-0UN40sHuH-rXcT_PLFukoMl1CmMqiy8cAgg\"]]],\"ICÁ\",[\"3,9\",3.8818176],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.twincorp.bancaonline\\u0026rdid\\u003dcom.twincorp.bancaonline\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.twincorp.bancaonline\"]],[\"qgJlGmMIB0oTCIDagLDHkJcDFZbCcwEdfbAIjPoBDAoKCAASBgoCdmkQALoCOgoeChhjb20udHdpbmNvcnAuYmFuY2FvbmxpbmUQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],[[[null,null,\"aIplxrITOpc\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:aIplxrITOpc?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:aIplxrITOpc\",null,null,null,null,\"AXH1ezkUoODsZhzomwEaOYvACFRBnrCNGFgB8Y4OhQlgoaNCLmRjgo8VLWfYyAOzXZt9Fdj2riwyWZFFJZVY9Gel7geGxNDtdZXk_M3PcKGy_yJlC1u62hCkEUNs1onkhKfdWMj51a01Ufb_lqdDtvuqW0oE6da-lICQszPWzqjS1f6x2_sBMv7Jf1qImiwmcAm-8FbE-F4vn__rT3Dg_8GZvKw3TG5Oh7L6NlRYfahgHQ266rgypA6JUBfg6qbaRcPa3Ra6Mocpiy_Hvp6eGNoMA9wMarU7mg6aVvobWj_bywVjPw\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/aIplxrITOpc/hqdefault.jpg\"]]]],[null,\"\\u003cb\\u003e ICÁ ZINGPLAY - BẮN CÁ ONLINE THẬT ĐÃ TAY \\u003c/b\\u003e    \\u003cbr\\u003e\\u003cbr\\u003eiCá Zing Play là game bắn cá online giải trí miễn phí số 1 Việt Nam với gần 20 triệu lượt tải. \\u003cbr\\u003eiCa là cổng Game thuộc thể loại casual đơn giản dễ chơi, không có đổi thưởng và hoàn toàn free với hình ảnh chibi dễ thương dành cho mọi lứa tuổi. iCa zingplay mang tất cả các đặc trưng của bắn cá siêu thị, nhưng thú vị hơn với dàn Boss siêu khủng và cá tính, hàng loạt kỹ năng độc đáo mà các game bắn cá siêu thị không có. \\u003cbr\\u003e\\u003cbr\\u003eBạn không biết chơi ban ca hoặc chưa từng chơi bắn cá siêu thị? Đừng lo! i ca zingplay chơi rất đơn giản: \\u003cbr\\u003eBước 1: Chọn mục tiêu muốn bắt. Cá càng lớn càng đẹp thì càng ăn xu được nhiều \\u003cbr\\u003eBước 2: Nhấn hoặc giữ ngón tay trên màn hình để bắn liên tục (free fire)\\u003cbr\\u003eBước 3: Di chuyển theo mục tiêu đã định để tăng cơ hội bắt được cá lớn. \\u003cbr\\u003eGAME LÀ DỄ, TẢI NGAY THÔI \\u003cbr\\u003e\\u003cbr\\u003eKhác với những game bắn cá siêu thị, ban ca doi thuong hay ban ca an xu, i ca zing play là game ban ca giải trí online free to play và có hàng loạt tính năng nổi bật: \\u003cbr\\u003e🐟 Game miễn phí hoàn toàn, người chơi có thể nhận quà tặng khởi nghiệp, quà tặng miễn phí, quà tặng giftcode hàng ngày \\u003cbr\\u003e🐟 Quà tặng bao la, là Game online có nhiều mã quà nhất, với mã quà ngàn vàng mien phi mỗi ngày trên fanpage \\u003cbr\\u003e🐟 Bắn cá giải trí, săn boss đã tay với hàng loạt boss khủng. Trong thế giới i cá, bạn có dám thách thức thần long (ban ca rong), hay trải nghiệm hiệu ứng free fire lung linh từ boss Phượng hoàng lửa, hiệu ứng bắn 1 được 3 từ boss tam vĩ zingplay  \\u003cbr\\u003e🐟 Thử ngay combo free fire phượng hoàng lửa và bắn 1 được 3 để quét sạch cá trên bàn\\u003cbr\\u003e🐟 12 loại súng độc đáo được thiết kế với ý tưởng là các loài cá trong i ca zingplay: cá chim, cá mực, cá đuối, cá vàng\\u003cbr\\u003e🐟 Âm thanh, hiệu ứng ăn boss đẹp mắt \\u003cbr\\u003e🐟 Nếu bạn có thời gian rảnh, chần chừ gì mà không giải trí cùng iCa zing play! \\u003cbr\\u003e \\u003cbr\\u003eNgoài ra, icá zingplay còn có cổng game minigame và cổng game sự kiện online thú vị như:\\u003cbr\\u003e\\u003cbr\\u003e🐟 Lật Cá online: may mắn là ăn hết, cảm giác vui sướng chỉ trong 1 nốt nhạc \\u003cbr\\u003e🐟 Cao thủ Thách Đấu: thành bại tại kỹ năng\\u003cbr\\u003e🐟 Bảng xếp hạng hàng tuần:  thi đua để dành danh hiệu top 1 với hàng triệu người chơi khác được xếp vào nhiều nhóm thi đấu khác nhau\\u003cbr\\u003e🐟 Quà bao la với các siêu sự kiện: Sự kiện vòng quanh thế giới, sự kiện thử tài sút phạt 11m, Cạp bóng hóng quà \\u003cbr\\u003e\\u003cbr\\u003eCùng nóc khám phá ngay đại dương ica zingplay! \\u003cbr\\u003e\\u003cbr\\u003eiCa Zingplay thuộc cổng game ZingPlay - là cổng game giải trí đa nền tảng đầu tiên tại Việt Nam, được phát triển bởi Game Studio North trực thuộc VNG. Những năm gần đây, phiên bản trên mobile của ZingPlay đã được ra mắt với hệ thống các game hấp dẫn nhất thuộc nhiều thể loại phù hợp với mọi tầng lớp người dùng.\\u003cbr\\u003e\\u003cbr\\u003eChú ý:   \\u003cbr\\u003e- Icá Zingplay là game bắn cá giải trí, không phải ban ca doi thuong. Do đó, game không có tính năng doi thuong thành tien mat hay doi thuong doi the. \\u003cbr\\u003eIcá ban ca online là tựa game miễn phí không hỗ trợ các hoạt động doi thuong. Mọi hành vi lạm dụng iCá ban ca online vào việc doi thuong là nghiêm cấm. \\u003cbr\\u003e- Trò chơi được cấp phép phát hành theo quyết định phát hành trò chơi điện tử G1 trên mạng số: 230/QĐ-PTTH\\u0026amp;TTĐT do Cục Phát thanh, truyền hình và Thông tin điện tử cấp ngày 6/5/2026 (link: https://giayphep.abei.gov.vn/g1/132015)\\u003cbr\\u003e\\u003cbr\\u003eFacebook: https://www.facebook.com/Icazingplay \\u003cbr\\u003e---     \\u003cbr\\u003eLưu ý: Trò chơi yêu cầu truy cập 1 số quyền trên máy của bạn để trải nghiệm tính năng 1 cách  tốt nhất : GET_ACCOUNTS, READ_EXTERNAL_STORAGE, WRITE_EXTERNAL_STORAGE\"],\"ZINGPLAY VIETNAM\",\"10.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/jzGPaou-ufA62YNwj9Q9pTOSeTkV31eAnOq8Gb26hVFwUUXSQQNUqEgABrmkydEJ5DKi0g0CjhhmCvHxTnQDOvw\"],null,[190,235,240,255]],null,[\"3 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,[null,\"Phù hợp với tất cả các nhóm tuổi. Một số nội dung bạo lực trong ngữ cảnh hài hước hoặc tưởng tượng có thể được chấp nhận. Không cho phép ngôn từ thô tục.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.twincorp.bancaonline\\u0026rdid\\u003dcom.twincorp.bancaonline\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đặt\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[