Y61WHW9vpJT2RUqGA7XpkFZrm8BG2J1CI7lOZjNloJ9Q\"]],[null,2,[1536,2048],[null,null,\"https://play-lh.googleusercontent.com/VVUIq7_MxFDGVyxE0Kc9WEBP_zEAY-aZoGKPfQ_3AUtYMmUOq3CL6TryOpnoX0Gq7iKByExqz3jtMNXI347q4Q\"]],[null,2,[1536,2048],[null,null,\"https://play-lh.googleusercontent.com/AgOgKEYXorLZHdMgoP3On__Hp9lG34PCXm1l0gCGZbuiSYM56lxBz8eNsWgU9nleVr0q2gTjAJCp0-dU1snF\"]],[null,2,[1536,2048],[null,null,\"https://play-lh.googleusercontent.com/Cz6cr-tU1iVq7SLzoEHYqO51FUQIiDlYh-mxiMJBkQYUgj81l1CP5pm_ixPcxZXldH6flwgSC86EnP1pCu_3\"]],[null,2,[1536,2048],[null,null,\"https://play-lh.googleusercontent.com/J0JJLmfR7eEnWys9hEh_lN_0c-gvPGtAlhJj5ulEwGJmVfcdPYbzLBbbBKnFNpVLRp7-m78SykaJR9ASl8z1\"]]],\"Hòn đảo thần tiên - VTC Game\",[\"4,5\",4.4774356],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.MelsoftGames.FamilyIslandFarm\\u0026rdid\\u003dcom.MelsoftGames.FamilyIslandFarm\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.MelsoftGames.FamilyIslandFarm\"]],[\"qgJ2GnQIDUoTCIDagLDHkJcDFZbCcwEdfbAIjPoBFAoSCNO33Mq5oIiKQxIGCgJ2aRAAugJDCicKIWNvbS5NZWxzb2Z0R2FtZXMuRmFtaWx5SXNsYW5kRmFybRABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,\"Z67jH2ZvD70\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:Z67jH2ZvD70?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:Z67jH2ZvD70\",null,null,null,null,\"AXH1ezm6MxOllvOxWhoaL8todKA0Gn7gxEFUBr1mGOO_opM4S4UCFpKQQWBN-hpBjx6W7GwJp897MbvitBDTgtCDC8_yBqlKIWHtTzsp1j4lUFPikakrafie3po-HoQRI0JHadQulMlpqKrIei4He_AaJrDva1LLACfU-h3gZ2k0W4OpU8TFdgZn7mg9S92v2sYZnMDVC1tUFQJCIZMA6QoaDcfJijaSVk4QM_U6eQxmNJCWfHKq4B7QH4vEe_RXd8i3-2Q2-hH2qw8g-7qMyWEEztx7Pe0BYkMjFmxZdxsaUyMzWA\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/Z67jH2ZvD70/hqdefault.jpg\"]]]],[null,\"Quyết định phê duyệt nội dung kịch bản trên mạng số: 28/GXN-PTTH\\u0026amp;TTÐT do Bộ Thông tin và Truyền thông cấp ngày 05/04/2022\\u003cbr\\u003e\\u003cbr\\u003eĐắm chìm trong một thế giới phiêu lưu khó quên với một gia đình thời đồ đá hiện đại!\\u003cbr\\u003e\\u003cbr\\u003eHãy tưởng tượng cuộc sống của bạn sẽ ra sao nếu không có công nghệ hiện đại, bạn sẽ làm gì? Có lẽ bạn sẽ khám phá các vùng lãnh thổ, xây nhà hoặc thậm chí toàn bộ ngôi làng; làm nông, thu hoạch hoặc có thể bạn sẽ chinh phục những vùng đất mới.\\u003cbr\\u003e\\u003cbr\\u003eBạn có cơ hội đến một hòn đảo hoang tàn cùng với các anh hùng trong trò chơi Family Island và thử nghiệm bản thân trong các vai trò khác nhau: nông dân, đầu bếp, nhà thám hiểm, thương nhân và nhiều người khác\\u003cbr\\u003e\\u003cbr\\u003eThú vị? Dưới đây là một số tính năng khác của trò chơi của chúng tôi:\\u003cbr\\u003e★ Khám phá các vùng hoang dã, giải câu đố, tìm đồ vật bị giấu và bắt đầu cuộc phiêu lưu ly kỳ đến những hòn đảo mới.\\u003cbr\\u003e★ Xây dựng và cải thiện thành phố nhỏ của bạn ở giữa đại dương.\\u003cbr\\u003e★ Bắt đầu trang trại gia đình của riêng bạn! Thu hoạch, trồng trọt và chế tạo hàng hóa hữu ích để trao đổi với các nhân vật khác.\\u003cbr\\u003e★ Nấu món ăn ngon và tốt cho sức khỏe từ những nguyên liệu bạn có thể tìm thấy trên đảo.\\u003cbr\\u003e★ Tùy chỉnh ngôi làng của bạn với những đồ trang trí đẹp mắt! Chọn hoa và cây phù hợp với cảnh quan đặc biệt của ngôi làng của bạn.\\u003cbr\\u003e★ Gặp gỡ loài động vật khác thường: nhím đảo, dê hoang dã và thậm chí cả khủng long đang chờ đợi bạn!\\u003cbr\\u003e★ Giúp một gia đình sống sót trên đảo hoang.\\u003cbr\\u003e\\u003cbr\\u003eVà điều đó không phải tất cả! Family Island là một trò chơi nông trại đầy những tình tiết bất ngờ và cuộc phiêu lưu hấp dẫn!\\u003cbr\\u003e\\u003cbr\\u003eTheo dõi Family Island trên Facebook và Instagram để nhận các ưu đãi và tiền thưởng độc quyền!\\u003cbr\\u003eFacebook: facebook.com/familyislandgame/\\u003cbr\\u003eInstagram: instagram.com/familyislandgame/\\u003cbr\\u003e\\u003cbr\\u003eĐiều khoản dịch vụ: https://static.moonactive.net/legal/terms.html?lang\\u003den\\u003cbr\\u003eChính sách quyền riêng tư: https://static.moonactive.net/legal/privacy.html?lang\\u003den\\u003cbr\\u003e\\u003cbr\\u003eCó câu hỏi về trò chơi? Hỗ trợ của chúng tôi đã sẵn sàng tại: https://melsoft-games.helpshift.com/hc/en/11-family-island/\"],\"Melsoft Games Ltd\",\"50.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/yW-Q0E-ntIf0KbcaTfIZn6WYIwLvkqa2gwaVWRPIbyy3zrHodlRSd9d_hSHwhqGwY74xBoQQn55pdL-BlPm4fw\"],null,[140,212,167,255]],null,[\"3 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Người dùng tương tác, Giao dịch mua trong trò chơi (bao gồm vật phẩm ngẫu nhiên)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.MelsoftGames.FamilyIslandFarm\\u0026rdid\\u003dcom.MelsoftGames.FamilyIslandFarm\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đặt\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"26.000 ₫ - 4.100.000 ₫ mỗi mặt hàng\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Phổ thông\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,n