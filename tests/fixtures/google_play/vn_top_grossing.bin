1920,1080],[null,null,\"https://play-lh.googleusercontent.com/0AnygaTZAuBL1N4RwGcNAnysAwMQsoayauAAh1YCpALUdmPC5keDrOHzII6sNnoZdqXFkBTkvVlRf5HIQAW53jk\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/E_rcwCi4J7Q8Bq5gomwaeGqxVvgTNEbZCm35p9YcL8ZpQWiwak1Q2z0dhQFd0-Uv370Aa6AJ4mvpG_YsROpY\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/NIxQ4XOzF0Io1bxXbACsMueYwDB8x53WUWEaugof9N06LQjcuAXp5JaSd9gJLjXd-UEDNB3zuo7kllxatbbZeuA\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/ZQTpiIQm-xKCnuME_nlTpreylSCcdgPXnBTeSQmsSM500AUuF4eEIHThQsAppukODAARWbhSP2PGXfJugYKXBw\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/BiIZqoC-lIPlRvJ6tpUsKs0zICty83XLt4ICBH_kx5yZgr_pOdjhdVT1O3LnGq9gc-qCjBDetyOK2G00m0QxWQ\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/Q0pP5j-hobYUvyzrnUtQtiQ78eUQkiEPeDNmigEG2n8UgmTfa4Lal0mmQ4bT4-RgSQ4bqoJ7h9OqC_6RjYl3\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/0AnygaTZAuBL1N4RwGcNAnysAwMQsoayauAAh1YCpALUdmPC5keDrOHzII6sNnoZdqXFkBTkvVlRf5HIQAW53jk\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/E_rcwCi4J7Q8Bq5gomwaeGqxVvgTNEbZCm35p9YcL8ZpQWiwak1Q2z0dhQFd0-Uv370Aa6AJ4mvpG_YsROpY\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/NIxQ4XOzF0Io1bxXbACsMueYwDB8x53WUWEaugof9N06LQjcuAXp5JaSd9gJLjXd-UEDNB3zuo7kllxatbbZeuA\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/ZQTpiIQm-xKCnuME_nlTpreylSCcdgPXnBTeSQmsSM500AUuF4eEIHThQsAppukODAARWbhSP2PGXfJugYKXBw\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/BiIZqoC-lIPlRvJ6tpUsKs0zICty83XLt4ICBH_kx5yZgr_pOdjhdVT1O3LnGq9gc-qCjBDetyOK2G00m0QxWQ\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/Q0pP5j-hobYUvyzrnUtQtiQ78eUQkiEPeDNmigEG2n8UgmTfa4Lal0mmQ4bT4-RgSQ4bqoJ7h9OqC_6RjYl3\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/0AnygaTZAuBL1N4RwGcNAnysAwMQsoayauAAh1YCpALUdmPC5keDrOHzII6sNnoZdqXFkBTkvVlRf5HIQAW53jk\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/E_rcwCi4J7Q8Bq5gomwaeGqxVvgTNEbZCm35p9YcL8ZpQWiwak1Q2z0dhQFd0-Uv370Aa6AJ4mvpG_YsROpY\"]]],\"Rumble Beavers\",[\"5,0\",5],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.nep.tr.hybrid.cg.rock\\u0026rdid\\u003dcom.nep.tr.hybrid.cg.rock\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.nep.tr.hybrid.cg.rock\"]],[\"qgJmGmQILkoTCIDagLDHkJcDFZbCcwEdfbAIjPoBDAoKCAASBgoCdmkQALoCOwofChljb20ubmVwLnRyLmh5YnJpZC5jZy5yb2NrEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"🦫 Khoan đã, hải ly dễ thương mà lại cầm súng?!\\u003cbr\\u003eBảo vệ ngôi nhà của bạn khỏi những tảng đá rơi! 🔫\\u003cbr\\u003e\\u003cbr\\u003eBạn nghĩ đây chỉ là một trò chơi dễ thương, nhẹ nhàng ư? Bất ngờ chưa! Hãy sẵn sàng cho một tựa game RPG bắn súng idle hành động cực bùng nổ!\\u003cbr\\u003eNếu bạn đang tìm kiếm một tựa game bắn súng casual để xả stress, thì đây chính là chân ái! 👀\\u003cbr\\u003eBiệt đội Hải Ly đã nạp đầy đạn và sẵn sàng thể hiện sức hút hài hước không ngờ của mình!\\u003cbr\\u003e\\u003cbr\\u003e🛠️ Ghép (Merge), Nâng cấp và Phát triển!\\u003cbr\\u003eTừ súng lục đến minigun! Ghép hơn 60 loại vũ khí khác nhau chỉ bằng một cú vuốt đơn giản.\\u003cbr\\u003eKết hợp các vũ khí giống nhau, và BÙM! Xem chúng biến đổi thành vũ khí hạng nặng.\\u003cbr\\u003eNhờ hệ thống ghép cực dễ, ai cũng có thể làm quen ngay với tựa game indie casual này!\\u003cbr\\u003eBạn đã sẵn sàng nghiện việc ghép vũ khí để đạt hỏa lực tối thượng chưa?\\u003cbr\\u003e\\u003cbr\\u003e🔥 Cuốn phăng mọi stress! Chiến đấu bùng nổ\\u003cbr\\u003eHãy nhìn kỹ năng bắn súng không khoan nhượng của các xạ thủ lông xù của chúng ta!\\u003cbr\\u003eHiệu ứng rung màn hình và những cú bắn đã tay sẽ giúp bạn thư giãn ngay lập tức. Cảm giác nã những khẩu súng khổng lồ thật sự quá đã!\\u003cbr\\u003eĐây không chỉ là một game cute — đây là một game bắn súng thực thụ với hành động cực gắt!\\u003cbr\\u003eQuét sạch kẻ thù trong các trận chiến và tận hưởng tựa game giết thời gian hoàn hảo nhất.\\u003cbr\\u003eBạn đã từng thấy game RPG bắn súng idle nào đỉnh thế này chưa?!\\u003cbr\\u003e\\u003cbr\\u003e😎 Thu thập 40 Xạ thủ Hải Ly độc nhất\\u003cbr\\u003eSniper, shotgun, súng trường... Thu thập hơn 40 đặc vụ hải ly, mỗi đặc vụ có một tuyệt chiêu riêng!\\u003cbr\\u003eXây dựng biệt đội trong mơ của riêng bạn và lao vào những trận chiến hỗn loạn, vui nhộn.\\u003cbr\\u003eTận hưởng cảm giác thỏa mãn khi thu thập các thành viên hải ly yêu thích!\\u003cbr\\u003e\\u003cbr\\u003e😴 Tăng cấp nhanh ngay cả khi bạn đang ngủ (AFK)\\u003cbr\\u003eKhông cần thao tác tay mệt mỏi! Tận hưởng sự thoải mái của tính năng auto chiến đấu, hải ly sẽ tự động xả skill.\\u003cbr\\u003eViệc cày cuốc không bao giờ dừng lại, ngay cả khi bạn offline. Đây chính là game idle AFK chân ái!\\u003cbr\\u003eThức dậy với một núi phần thưởng offline và tăng cấp với tốc độ ánh sáng.\\u003cbr\\u003eGame giết thời gian 100% xả stress với hệ thống tự động cày ngay cả khi bạn bận rộn!\\u003cbr\\u003e\\u003cbr\\u003e🚀 Kẹt ải? Chuyển sinh và Tiếp tục phiêu lưu!\\u003cbr\\u003eĐừng buồn nếu boss đánh bại bạn! Đó là lúc hệ thống Chuyển Sinh (Prestige) tuyệt vời của chúng tôi phát huy tác dụng.\\u003cbr\\u003eChuyển sinh để reset và nhận các buff vĩnh viễn, giải phóng sức mạnh ở một đẳng cấp hoàn toàn mới!\\u003cbr\\u003eKhám phá các bản đồ đa dạng như khu rừng, sa mạc rực lửa và cánh đồng tuyết.\\u003cbr\\u003eBạn sẽ trở thành chỉ huy tối cao trong cuộc hành trình bất tận này chứ?\\u003cbr\\u003e\\u003cbr\\u003e💞 Cực kỳ phù hợp cho những ai:\\u003cbr\\u003e- Mê mẩn các nhân vật động vật dễ thương.\\u003cbr\\u003e- Muốn một tựa game idle phát triển nhanh phù hợp với lối sống bận rộn.\\u003cbr\\u003e- Thích xả stress bằng những màn xả súng đã tay.\\u003cbr\\u003e- Ghiền cơ chế ghép (merge) và nâng cấp vũ khí.\\u003cbr\\u003e- Nghĩ rằng \\u0026quot;hải ly mũm mĩm bắn súng máy\\u0026quot; là sự kết hợp tuyệt vời nhất.\\u003cbr\\u003e\\u003cbr\\u003eTải Rumble Beavers ngay bây giờ và trải nghiệm một thế giới tràn ngập sự dễ thương bùng nổ! 🎮🦫✨\\u003cbr\\u003e\\u003cbr\\u003e-----\\u003cbr\\u003e📩 Hỗ trợ: support@neptunecompany.kr\\u003cbr\\u003e📄 Điều khoản dịch vụ: https://neptunecompany.kr/gameterms\\u003cbr\\u003e🔒 Chính sách quyền riêng tư: https://neptunecompany.kr/gameprivacy\"],\"NEPTUNE(TREEPLLA)\",\"1.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/B4YpBzWaqLUIsc__9ef_DT5JQNvhxXkJHyAu7AvzXqd1SHWnaX3R_EkibAvghPrejZ9fkgrhPHbEQTuqf4S6\"],null,[123,121,123,255]],null,[\"3 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,[null,\"Phù hợp với tất cả các nhóm tuổi. Một số nội dung bạo lực trong ngữ cảnh hài hước hoặc tưởng tượng có thể được chấp nhận. Không cho phép ngôn từ thô tục.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.nep.tr.hybrid.cg.rock\\u0026rdid\\u003dcom.nep.tr.hybrid.cg.rock\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đặt\"],null,[\"