ll,\"https://play-lh.googleusercontent.com/7BJXWYspw-Wjr4ku7VfuTvMsYe-gw0GyhfvJZQP96yQwlQPzgFmk8WifpK63NvfqvTg5cW8ArnfzCtG1Ya69TA\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/4jMxVKHWwuBtJMCtwxUKtT1lvgbjrAN-5--XaqYkKSpslZD0ARm2DRuy_srSFsW8Eb2jXKxxb3l4JCe7TrkbBQ\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/V-n5JpZHFG8hdYIugQdpBJMGBCcew7E08EvA6QddKXIuJt_TGeSs3o8zs61JqAcMDWJdpc4w8HD38DGY3Pmm\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/t0Itb_-inQEK3wlMDg2TUxy0bOH9_nni4pSFmNmxr2NSR2Fd5nsNpwvN_AQ3VoRxQo4wUNAJE6AAtBQhSyrpT7o\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/PbYJn_yOZDiV6ypOEuHE9aaLhwPeDvxEkhaXuJUrqCxoP7IwLfOf_fuYGEBGai3qs6RBcjU8zHrkBbJce8Wo\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/72WfwjMLi4nJ9mqOS52aGkxJQ6k6qWjuh3vTjWEjBdxB8HOZ-fl-rEtoDh9QBGqkIjnEdEX0NXpgWFtcJAyMmA\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/bLFnlndy-trOjGH38oFQmniNojJkl4L79VjqinlPGF5KR_EL2Lp1xUzYp5e2tDhLqedk_xVu1L9nxjcaLV9KZQ\"]]],\"Last Z: Survival Shooter\",[\"4,7\",4.7238946],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.readygo.barrel.gphh\\u0026rdid\\u003dcom.readygo.barrel.gphh\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.readygo.barrel.gphh\"]],[\"qgJkGmIIBkoTCIDagLDHkJcDFZbCcwEdfbAIjPoBDAoKCAASBgoCdmkQALoCOQodChdjb20ucmVhZHlnby5iYXJyZWwuZ3BoaBABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"Trong một thế giới tận thế, nơi Zombie hoành hành, vận mệnh nhân loại treo lơ lửng trên bờ vực, không gian sống ngày càng thu hẹp. Liệu bạn có thể trở thành người anh hùng viết lại số phận loài người? Hành trình sinh tồn trong \\u0026quot;Last Z: Survival Shooter\\u0026quot; đã chính thức bắt đầu – số phận đang chờ bạn đến thay đổi!\\u003cbr\\u003e\\u003cbr\\u003eNé Tránh Và Xạ Kích\\u003cbr\\u003eGiữa trung tâm của thế giới hậu tận thế bị bao trùm bởi đàn Zombie khát máu, sinh tồn không chỉ đơn thuần là bản năng – mà là một cuộc thử thách nghẹt thở, nơi kỹ năng \\u0026quot;Né Tránh\\u0026quot; và \\u0026quot;Xạ Kích\\u0026quot; của bạn được đẩy đến cực hạn. Lượn mình qua từng đợt tấn công cuồng nộ, tránh né một cách tinh tế và hạ gục kẻ địch với độ chính xác từng viên đạn – mỗi giây sống sót là một dấu mốc tiến gần hơn đến chiến thắng cuối cùng. Trong cuộc chơi căng thẳng này, trí tuệ nhanh nhạy và phản xạ sắc bén chính là vũ khí tối thượng giúp bạn chạm tay tới chiến thắng.\\u003cbr\\u003e\\u003cbr\\u003eKhám Phá Và Mở Rộng\\u003cbr\\u003eHãy sẵn sàng cho một hành trình bùng nổ Adrenaline, vùng đất tận thế chính là sân chơi để bạn khám phá và chinh phục. Hãy phiêu lưu qua những vùng hoang tàn, truy tìm kho báu bị chôn vùi, trưởng thành sau từng trận chiến dữ dội và kết giao với những đồng đội đáng tin cậy, những người sẽ cùng bạn kề vai sát cánh. Từng bước đi sẽ đưa bạn đến gần hơn với mục tiêu xây dựng nên một Nơi Trú Ẩn kiên cố giữa thời loạn.\\u003cbr\\u003e\\u003cbr\\u003eSinh Tồn Và Phát Triển\\u003cbr\\u003eTrong Last Z: Survival Shooter, sống sót chỉ là bước khởi đầu. Giữa thời khắc tận diệt, bạn phải không ngừng phát triển – mở rộng lãnh thổ, nâng cấp công nghệ, củng cố quân lực và xây dựng nền kinh tế vững mạnh. Khi \\u0026quot;Nơi Trú Ẩn\\u0026quot; của bạn lớn mạnh, nó sẽ trở thành tia hy vọng cuối cùng cho tương lai loài người.\\u003cbr\\u003e\\u003cbr\\u003eHãy khám phá, phát triển và tái định nghĩa ý nghĩa của sự sinh tồn trong câu chuyện huyền thoại đầy kịch tính này. Tải ngay \\u0026quot;Last Z: Survival Shooter\\u0026quot; và bước vào thử thách sinh tồn tối thượng, nơi bạn sẽ thể hiện bản lĩnh chinh phục tận thế!\\u003cbr\\u003e\\u003cbr\\u003eGiấy phép số: 283/QĐ-PTTH\\u0026amp;TTĐT\\u003cbr\\u003eLink giấy phép: https://giayphep.abei.gov.vn/g1/132107\"],\"Funtap Games Joint Stock Company\",\"500.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/OpfSiJUDSSFMsrxie93ocb_a3l2juoQqdedY7nbCYu3oW4cpW4CUbqytO0NqsGn5w53ygyJloitjXHN6WJTi85I\"],null,[160,158,160,255]],null,[\"16 tuổi trở lên\",[null,2,[366,512],[null,null,\"https://play-lh.googleusercontent.com/djaflVB_tFGRjZlfs-xrcdSPeI_CUG3TTewlYuSFjq1tsNXxb4aZqAq0uMFzUtiZI_R65RtDyr4Zt2vt\"]],[null,\"Chất kích thích\"],[null,\"Người dùng tương tác, Giao dịch mua trong trò chơi (bao gồm vật phẩm ngẫu nhiên)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/UAlGNLgnQRVs-XrK_mUGJw1h_nlO1Ykv0jZK-YoRrRYIGIWmRdE_CCPB7U34jAiz4xLWUAqQ5Me7Daq7N_8\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.readygo.barrel.gphh\\u0026rdid\\u003dcom.readygo.barrel.gphh\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đặt\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"26.000 ₫ - 2.650.000 ₫ mỗi mặt hàng\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Phổ thông\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.twincorp.bancaonline\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/8RhE88x3xS9_hTCXPZMZu1kAlsJmIFKf3BoveBsfWo5w8qmvGm9ZaX2kXEGXqh4ds33nIau33hgA0Rtm1tVMaA\"],null,[211,236,25,255],null,null,null,2