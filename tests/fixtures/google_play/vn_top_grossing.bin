null,\"https://play-lh.googleusercontent.com/qwdDi9UtW-OPzhFhWbOlsoyinrkpCFgYQaImDd-fKw51yLVpKvP-wBAhXoesqsHL78a8EQFNzz8YyWfm4RyGOw\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/RAR_3e2BvjcfzXl0XPrSj96-E3ELjJEiAzxnPg6Lubgg43m7oBQKej91MXvWMGNcFWK9F83qH0nE-1WSbkSgpA\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/bmkYR54wCEcyXwFt_CFdxU9W98MfOiFV0YSqw0Lkj3Oh4xdExdEYtvHY5ww_gosHiIi5N5B44zJeOHa7LzxdBQ\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/cnroktjVvpWEr8lV6O4ntPNqDY7dKfX06vECkSbbft-YvIrdiuIAHTaSkBYe85kBx-8HheA0kr5DkEydp7bm9I0\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/B15dWGz6gSLfeHrtZS-37gyqrJIBFmCzEajHc8JxOowwC5e3KQccNi1ZqvjPaherh5ak9O9xtSNVZXq0Nq9s0XI\"]]],\"Chiến Thần MINI\",[\"4,1\",4.0872483],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.vnxxzs.gp\\u0026rdid\\u003dcom.vnxxzs.gp\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.vnxxzs.gp\"]],[\"qgJaGlgIFUoTCIDagLDHkJcDFZbCcwEdfbAIjPoBDAoKCAASBgoCdmkQALoCLwoTCg1jb20udm54eHpzLmdwEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"Quyết định phê duyệt nội dung kịch bản trò chơi điện tử G1 trên mạng số: 134/QĐ-PTTH\\u0026amp;TTĐT do BỘ VĂN HÓA, THỂ THAO VÀ DU LỊCH VÀ CỤC PHÁT THANH, TRUYỀN HÌNH VÀ THÔNG TIN ĐIỆN TỬ cấp ngày 22/04/2025.\\u003cbr\\u003ehttps://giayphep.abei.gov.vn/g1\\u003cbr\\u003e\\u003cbr\\u003eTác phẩm bom tấn cuối năm 2025 – Chiến Thần MINI chính thức ra mắt!\\u003cbr\\u003e Đăng nhập nhận ngay 1000 lượt triệu hồi miễn phí, 10 lượt triệu hồi Thần Thoại đầu tiên bảo đảm nhận tướng cấp S!\\u003cbr\\u003e*Triệu hồi tướng, chống lại đội quân vong linh\\u003cbr\\u003eHơn 15.000 cách kết hợp các vị tướng, mỗi trận chiến sẽ kích hoạt ngẫu nhiên các hiệu ứng Duyên Phận độc đáo.\\u003cbr\\u003e Mỗi bản đồ, mỗi làn quái đều thay đổi – buộc bạn phải điều chỉnh chiến thuật linh hoạt.\\u003cbr\\u003e Chỉ cần một lần triệu hồi đúng thời điểm, bạn có thể lật ngược cục diện ngay lập tức!\\u003cbr\\u003e*Liên minh tập kết, khởi xướng tấn công\\u003cbr\\u003eTham gia Liên Minh để hợp lực cùng bạn bè, tấn công các phe đối địch trong những trận chiến khốc liệt.\\u003cbr\\u003e Mỗi chiến thắng đều mang về rơi đồ hiếm và rương liên minh quý giá.\\u003cbr\\u003e Lên chiến lược, phản công kịp thời - phối hợp hoàn hảo sẽ quyết định vinh quang của cả đội!\\u003cbr\\u003e*Rèn trang bị, Lực Chiến bứt phá đua bảng xếp hạng\\u003cbr\\u003eThu thập tài nguyên từ chiến đấu và tự do rèn vũ khí, giáp trụ, phụ kiện theo phong cách riêng.\\u003cbr\\u003e Mỗi món trang bị đều có thuộc tính ngẫu nhiên và hiệu ứng đặc biệt, giúp sức mạnh tăng vọt chỉ trong vài phút.\\u003cbr\\u003e Chế tạo vũ khí huyền thoại và khắc tên bạn trên bảng xếp hạng toàn máy chủ!\\u003cbr\\u003e*Tùy chọn skin, tạo dấu ấn tướng riêng biệt\\u003cbr\\u003eLựa chọn giữa hàng trăm skin giới hạn, thể hiện hình tượng vị tướng theo cá tính của bạn.\\u003cbr\\u003e Phong cách Q-version kết hợp đồ họa chất lượng cao mang lại trải nghiệm chiến đấu sinh động.\\u003cbr\\u003e Tỏa sáng trên bảng xếp hạng không chỉ bằng sức mạnh - mà còn bằng phong cách riêng của bạn!\\u003cbr\\u003e*Tải ngay Chiến Thần MINI\\u003cbr\\u003eBắt đầu hành trình thủ thành chỉ trong 3 phút mỗi trận - triệu hồi, chiến lược, phát triển và hợp tác, tất cả đều trong tầm tay bạn.\"],\"Mobile Intelligences Saigon\",\"100.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/xZzvIEZs8YVdLZlWMOflT2v3JOF47bKw2HXT7Xm5haPGIYoR-VHaESch-evPSYcwgEVav0SbP2ifSA6ZtrwNOA\"],null,[4,58,50,255]],null,[\"12 tuổi trở lên\",[null,2,[366,512],[null,null,\"https://play-lh.googleusercontent.com/yQChfa9XKlaXMIYTk8w8QwChjT8_SH-_2d2SS-kesw0TLQK1nxtw54bDcoZ09freZJgKrtg4f__is-31Vg\"]],[null,\"Bạo lực vừa phải\"],[null,\"Người dùng tương tác\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/YrkR-GP7OKghBTATCoO_jJrchSVrh-NSUBb5DnbRZC1DbLK_cgV9FC2e_iI4GzLsKXuZjuFZajnGCiA8qA\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.vnxxzs.gp\\u0026rdid\\u003dcom.vnxxzs.gp\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đặt\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"20.000 ₫ - 2.099.000 ₫ mỗi mặt hàng\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Phổ thông\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.moonlight.dragoncity\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/Oqa6_symFrzGVzfZ0JGZwXYsP1b5ht6frT48Dvm9dNCHh9nC7814TNUkUYOdLzqyTJKtFOxd-TCvckvYXwPskA\"],null,[84,79,81,255],null,null,null,2],[[null,2,[2784,1536],[null,null,\"https://play-lh.googleusercontent.com/g3iqN0w4BnN_8B6CE460vyH404qMWkn-koA5BvdcA27J5twOqMVA34PfMi9iZ5I45nzeExsKwolPkT2RMJhGuA\"]],[null,2,[2784,1536],[null,null,\"https://play-lh.googleusercontent.com/CPTWVC2YlOvwXw8xxGwoJx_dQn-WjM0Fe2vmYcoKYxgMzynXzrs1NLNU4jrGIgT6M6R-QMBpuw5B0oFeBZFT\"]],[null,2,[2784,1536],[null,null,\"https://play-lh.googleusercontent.com/w-goLXy7r_ac9it1R2EoRWRkht1Y9QyhjrHUGiajlmJdITA_MkFONNMuoREnRG-QdIV6K6O1e1NF6xQGYOuN\"]],[null,2,[2784,1536],[null,null,\"https://play-lh.googleusercontent.com/YQfPWpm028itPiXlVlnYLu