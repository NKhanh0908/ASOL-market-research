ay-lh.googleusercontent.com/QAPdaH6mg4TjDWcyQRX-nO4IyQIjPKlAn1eu1VU2gK7qdjSxxaVGKYG6sYrElsjQ7ncvusxJjO6oEwtXRO8n\"]],[null,2,[1920,1200],[null,null,\"https://play-lh.googleusercontent.com/8EC-gtnayT1BT9PcqcJwNIWTe8fO91VFmhilm-qcKUkGsMLrVP-Ypl2VQhAFvlM-Hw4xjOkUSN9WF8njtaBX\"]]],\"BANG BANG ĐẠI CHIẾN\",[\"4,7\",4.651341],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.lastshelter.gpvi\\u0026rdid\\u003dcom.lastshelter.gpvi\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.lastshelter.gpvi\"]],[\"qgJhGl8IIEoTCIDagLDHkJcDFZbCcwEdfbAIjPoBDAoKCAASBgoCdmkQALoCNgoaChRjb20ubGFzdHNoZWx0ZXIuZ3B2aRABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,null,[null,null,\"https://www.youtube.com/watch?v\\u003dYFCo8VebIUk\"],null,null,[1920,1080]],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/YFCo8VebIUk/hqdefault.jpg\"]]]],[null,\"BANG BANG ĐẠI CHIẾN là game bắn súng Roguelike với đồ họa đẹp mắt, kết hợp hoàn hảo giữa chiến thuật thủ thành và lối chơi hành động đầy kịch tính. Trong bối cảnh tương lai khi thảm họa bùng nổ và zombie tràn ngập khắp thế giới, bạn sẽ vào vai Chỉ Huy Tiên Phong, dẫn dắt những người sống sót chiến đấu chống lại từng đợt zombie và giành lại hy vọng cho nhân loại.\\u003cbr\\u003e\\u003cbr\\u003eGame sở hữu nhiều bản đồ đa dạng, nhiều loại quái vật khác nhau cùng hệ thống kỹ năng hoàn toàn ngẫu nhiên. Sự kết hợp giữa phát triển sức mạnh nhân vật và cơ chế Roguelike mang đến những trận chiến luôn mới mẻ và đầy phấn khích.\\u003cbr\\u003e\\u003cbr\\u003eTính năng nổi bật\\u003cbr\\u003e● Chiến đấu kiểu “quét sạch”, hỏa lực mạnh mẽ tiêu diệt bầy zombie\\u003cbr\\u003e● Nhiều hướng phát triển vũ khí, tự do nâng cấp và cường hóa\\u003cbr\\u003e● Vũ khí công nghệ cao và hỏa lực hạng nặng hỗ trợ chiến đấu\\u003cbr\\u003e● Kỹ năng Roguelike ngẫu nhiên, mỗi trận là một thử thách mới\\u003cbr\\u003e● Đồ họa tận thế phong cách hoạt hình, nhẹ nhàng và giải trí\\u003cbr\\u003e\\u003cbr\\u003eTheo dõi chúng tôi\\u003cbr\\u003eYouTube: https://www.youtube.com/@BangBangZombies\\u003cbr\\u003eFacebook: https://www.facebook.com/BangBangZombiesEn\\u003cbr\\u003eDiscord: https://discord.gg/rZcN2NA3Bt\\u003cbr\\u003eEmail: LastShelter@zbjoy.com\\u003cbr\\u003e\\u003cbr\\u003eQuyết định phê duyệt nội dung kịch bản trò chơi điện tử G1 trên mạng số: 49/QĐ-PTTH\\u0026amp;TTĐT cấp ngày 05/02/2026\\u003cbr\\u003eLink giấy phép: https://giayphep.abei.gov.vn/g1/131821\"],\"Funtap Games Joint Stock Company\",\"10.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/YVJ4uoKM0YFuVmPfw6lkSLq_u-DrgE8_5p3uT_TvDQLhFqdEfarzhnoNR5L2T7OFr5qL0901slS4K873l4umzpk\"],null,[56,203,253,255]],null,[\"12 tuổi trở lên\",[null,2,[366,512],[null,null,\"https://play-lh.googleusercontent.com/yQChfa9XKlaXMIYTk8w8QwChjT8_SH-_2d2SS-kesw0TLQK1nxtw54bDcoZ09freZJgKrtg4f__is-31Vg\"]],[null,\"Bạo lực vừa phải\"],[null,\"Người dùng tương tác, Giao dịch mua trong trò chơi (bao gồm vật phẩm ngẫu nhiên)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/YrkR-GP7OKghBTATCoO_jJrchSVrh-NSUBb5DnbRZC1DbLK_cgV9FC2e_iI4GzLsKXuZjuFZajnGCiA8qA\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.lastshelter.gpvi\\u0026rdid\\u003dcom.lastshelter.gpvi\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đặt\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[