ll,2,[1440,2560],[null,null,\"https://play-lh.googleusercontent.com/kb5kB2GsmxtXBz-mjtEbpBWiEURyYAK2TxQAY93ZVQCLzEWivCVDF5ewvJzansjmhgWkpMfbMGZi3yUQuW1Oww\"]],[null,2,[1440,2560],[null,null,\"https://play-lh.googleusercontent.com/ZCGitVGhMC28k_wQyEPxQ8FsCweLXvOLQhzWH4LuuidUS48z-S_6jhkPgIptonmAMSpxnpm7GbpMMTKlz06VRw\"]],[null,2,[1440,2560],[null,null,\"https://play-lh.googleusercontent.com/yLAkGmgsDOZKIWV1ESVZ_0rgEkSthS_qyTo1S-dkMZyKI1uLw-S7l-QoP90Zzu6QgeGGYWQO0T03xm_vn5BgXfU\"]]],\"Farm City: Farming \\u0026 Building\",[\"4,3\",4.343368],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.citybay.farming.citybuilding\\u0026rdid\\u003dcom.citybay.farming.citybuilding\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.citybay.farming.citybuilding\"]],[\"qgJtGmsIKkoTCIDagLDHkJcDFZbCcwEdfbAIjPoBDAoKCAASBgoCdmkQALoCQgomCiBjb20uY2l0eWJheS5mYXJtaW5nLmNpdHlidWlsZGluZxABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,\"-BDxpP0fiLY\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:-BDxpP0fiLY?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:-BDxpP0fiLY\",null,null,null,null,\"AXH1ezlu0qUcvIXV3NWp-S7LyAAs6Ex1GLQ7NW1L1h6mPKoSCTpDDdURD1ZLfZSjEfBNNGbGLw7E_63Y5uMB1F-75byaudlI5wYeRta6LvRXufTdUuw9Y_hmF13rOKMGgRLjlCqjFK56H3ZUGTEtl1JzI5VEdDkn4hAHufrRx2atV3ViZIt48vUG_oeXVfp8BM2My6QMh9XmoAHy5mfUg3s0y-0Tf2JznMT6M6WiLZtiuRWMokVggqG7TNJXJ6KPKiSWfm0zgmKtgqCgpitNdm124FWnQ2xLMiHEX-F4B3YLvs15NA\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/-BDxpP0fiLY/hqdefault.jpg\"]]]],[null,\"Farm City is a new breath of fresh air into the world of city-building and farm games!\\u003cbr\\u003e\\u003cbr\\u003eBuild the city that you’ve always dreamed of! Grow your crops, feed your cattle, and trade the product to further enhance your farming games. Bring happiness and prosperity to your citizens with exotic restaurants, convenient community buildings, and breathtaking wonders. Take on an adventure and explore the mysterious tunnels of the Ancient City buried beneath your very own land.\\u003cbr\\u003e\\u003cbr\\u003eSo what are you waiting for? Get yourself READY to become the most successful mayor and build your dream city!\\u003cbr\\u003e\\u003cbr\\u003eFarm City features:\\u003cbr\\u003e• Adorable farm animals for you to take care of\\u003cbr\\u003e• Numerous types of vegetables and fruits to grow and process in your farming factories\\u003cbr\\u003e• Build and Customize the city your own way with advanced factories, dazzling landmarks, and glamorous decorations!\\u003cbr\\u003e• Invite, visit, and help your neighbors from Facebook to make new friends\\u003cbr\\u003e• Meet up with kind citizens and deliver their orders directly to their doors. Also helping them with their problem is a part of being a GREAT mayor\\u003cbr\\u003e• Collect rare minerals by exploring the underground Ancient City and forge new upgrade for your facilities at the Academy and Foundry\\u003cbr\\u003e• Try your luck at the Happy Balloon house and receive fascinating gifts\\u003cbr\\u003e• Get yourself some special exclusive prizes in our unique Events\\u003cbr\\u003e• Invest and earn cash in the City Bank to ensure a stable future for your city\\u003cbr\\u003e• Tons of great discount farming products and ingredients constantly offered on the Market stall\\u003cbr\\u003e• Smooth gameplay experience along with beautiful graphics\\u003cbr\\u003e• Offline playing mode allows you to enjoy the farmer game anywhere and anytime like traveling on the bus or walking down the street\\u003cbr\\u003e\\u003cbr\\u003eFarm City is a FREE TO PLAY farm game with options to purchase some in-game items to enhance your game experience with real currency.\\u003cbr\\u003e\\u003cbr\\u003e*Some features of the game will require internet connection in order to work properly such as Friends, Competitions, Save/Load data, and other features*\\u003cbr\\u003e\\u003cbr\\u003eLet us know what you think and learn more about Farm City at:\\u003cbr\\u003eFacebook: https://www.facebook.com/farmcityofficial\\u003cbr\\u003eTwitter: https://twitter.com/farmcity_mobile\\u003cbr\\u003eEmail: farmcity@zegostudio.com\"],\"iKame Games - Zego Studio\",\"50.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/10n_vRw7dh-2rgrd2cA3DgBWfeqiVEHxxAPbB_DR3U8KXwVL2vUYynjPgZrpyIjAzwVPlc_t5YIYuWVzzdUS4w\"],null,[94,204,252,255]],null,[\"3 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Mua hàng trong trò chơi\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.citybay.farming.citybuilding\\u0026rdid\\u003dcom.citybay.farming.citybuilding\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đặt\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"11.900 ₫ - 1.199.000 ₫ mỗi mặt hàng\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Phổ thông\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]]