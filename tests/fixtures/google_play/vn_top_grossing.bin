https://play-lh.googleusercontent.com/NjFciZsBXsptVMzlpmHT1e1WzqidBBQJWhoLS2nuKRav6JmhMZbrI8g7ZoQ2QZOmJoEOH4-Xo8s0WMMNKT8z\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/1D-K6d4hNoR1x9DY96geF91UIJ4dy_UcNfMf6c6li_RwHYe92mExgDaXr5YyyIMUVpCjoFxYu4Uikotph2E-WA\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/OxcG_zvnmHnkMJe2atEhxNcWneL4jqSMqlsSqq1JtK24UL7Ont3aQ1zhPBabNRQj_bM-Uy0GqDlhs2sr2boD\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/cQdCjs4CawuNvYvu9u7-W0-9Pj8LHIIBwsSjZc_hx7H5iMo8BbZNQtzj7m8op9Po6Ekm3MXntTzbu3YDsUqleQ\"]]],\"Idle Cat Gunner: Shooter RPG\",[\"4,8\",4.798479],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.Chodun.CatGunner\\u0026rdid\\u003dcom.Chodun.CatGunner\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.Chodun.CatGunner\"]],[\"qgJhGl8IEUoTCIDagLDHkJcDFZbCcwEdfbAIjPoBDAoKCAASBgoCdmkQALoCNgoaChRjb20uQ2hvZHVuLkNhdEd1bm5lchABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,null,[null,null,\"https://www.youtube.com/watch?v\\u003dom7pvunb_1I\"]],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/om7pvunb_1I/hqdefault.jpg\"]]]],[null,\"\\u0026quot;🐱 Bàn chân nhỏ, khẩu súng to?! Game RPG bắn súng nhàn rỗi đáng yêu nhất!\\u003cbr\\u003e\\u003cbr\\u003eSẽ ra sao nếu những chú mèo dễ thương và lông lá mang theo những khẩu súng khổng lồ đi phiêu lưu?\\u003cbr\\u003eSự bùng nổ của sự dễ thương + hỏa lực thú vị + game bắn súng gây nghiện!\\u003cbr\\u003eHãy tạo đội quân mèo của riêng bạn ngay bây giờ!\\u003cbr\\u003e\\u003cbr\\u003eTrận chiến tự động săn lùng ngay cả khi bạn vắng mặt!\\u003cbr\\u003eTrên đường đi làm, ở quán cà phê, hay trong giờ nghỉ giải lao ngắn, những chú mèo của chúng ta vẫn tiếp tục mạnh lên~\\u003cbr\\u003e\\u003cbr\\u003e■ Tính năng trò chơi\\u003cbr\\u003e\\u003cbr\\u003e▶ Bộ sưu tập hơn 25 chú mèo quyến rũ\\u003cbr\\u003eMèo bắn tỉa, mèo bắn súng ngắn, mèo súng máy... Các nhân vật có sức hấp dẫn riêng!\\u003cbr\\u003eSự dễ thương + khả năng + cá tính trong một trò chơi nhàn rỗi thực sự!\\u003cbr\\u003eTạo đội quân tối thượng của bạn!\\u003cbr\\u003e\\u003cbr\\u003e▶ Bộ sưu tập hơn 35 loại súng ngoạn mục - cảm giác bắn súng chân thực\\u003cbr\\u003eSúng lục, súng trường, súng ngắn, súng máy! Một game nhập vai bắn súng với nhiều loại vũ khí khác nhau.\\u003cbr\\u003ePằng! Pằng! Sự thanh tẩy của trận chiến tự động với âm thanh bắn súng thú vị!\\u003cbr\\u003eSự tương phản giữa vẻ ngoài dễ thương và hỏa lực áp đảo!\\u003cbr\\u003e\\u003cbr\\u003e▶ Hệ thống tổng hợp vũ khí - niềm vui cốt lõi của trò chơi nhàn rỗi\\u003cbr\\u003eKết hợp các loại súng giống nhau để nâng cấp chúng thành vũ khí mạnh hơn!\\u003cbr\\u003eSự hồi hộp tại thời điểm tổng hợp... Đây là niềm vui thực sự của game nhập vai nhàn rỗi!\\u003cbr\\u003eBạn không thể dừng lại trước hỏa lực ngày càng mạnh mẽ!\\u003cbr\\u003e\\u003cbr\\u003e▶ Hệ thống tái sinh - tiêu chuẩn của sự phát triển vô hạn\\u003cbr\\u003eĐạt đến một giai đoạn nhất định và nhận được những khả năng mạnh mẽ hơn thông qua sự tái sinh!\\u003cbr\\u003eMột hệ thống cực kỳ gây nghiện trở nên mạnh mẽ bùng nổ sau mỗi lần tái sinh!\\u003cbr\\u003eVới phần thưởng ngoại tuyến, những chú mèo chăm chỉ phát triển ngay cả khi bạn đang ngủ~\\u003cbr\\u003e\\u003cbr\\u003e▶ Khám phá nhiều bản đồ khác nhau - cuộc phiêu lưu bất tận\\u003cbr\\u003eRừng, sa mạc, cánh đồng tuyết... Một cuộc phiêu lưu thú vị trong nhiều môi trường khác nhau!\\u003cbr\\u003eCàng tiến xa, những thử thách lớn hơn và phần thưởng phong phú hơn đang chờ đón bạn!\\u003cbr\\u003e\\u003cbr\\u003e■ Những người này chắc chắn nên tải xuống!\\u003cbr\\u003e\\u003cbr\\u003e✔ Tất cả những người yêu mèo thích những chú mèo dễ thương\\u003cbr\\u003e✔ Những người thích trò chơi nhàn rỗi và trò chơi phát triển\\u003cbr\\u003e✔ Những người muốn cảm giác hồi hộp của một trò chơi bắn súng\\u003cbr\\u003e✔ Những người đang tìm kiếm một trò chơi thông thường để đi lại hoặc thời gian rảnh rỗi\\u003cbr\\u003e✔ Những người muốn một trò chơi di động có thể chơi thoải mái bằng một tay\\u003cbr\\u003e✔ Những người thích game nhập vai nhàn rỗi với các trận chiến tự động và phần thưởng ngoại tuyến\\u003cbr\\u003e✔ Những người có trí tò mò bùng nổ trước sự kết hợp \\u0026quot;\\u0026quot;Mèo + Súng\\u0026quot;\\u0026quot;\\u003cbr\\u003e\\u003cbr\\u003eNhững chú mèo dễ thương với những khẩu súng đang chờ bạn!\\u003cbr\\u003eTải xuống ngay bây giờ và bước vào một thế giới mới của game nhập vai bắn súng! 🎮🐱🔫\\u003cbr\\u003e\\u003cbr\\u003e-----\\u003cbr\\u003e📩 Hỗ trợ: support@neptunecompany.kr\\u003cbr\\u003e📄 Điều khoản dịch vụ: https://neptunecompany.kr/gameterms\\u003cbr\\u003e🔒 Chính sách quyền riêng tư: https://neptunecompany.kr/gameprivacy\\u0026quot;\"],\"NEPTUNE(TREEPLLA)\",\"1.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/1jFVH1ucrVd2ljIga96EmrnmuMiNHdGRJ2f03kj47KTtRdXVICiHZqz5bvCqsQCgRqsk5Mq4bGb6LuQqUloR\"],null,[109,129,63,255]],null,[\"3 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,[null,\"Phù hợp với tất cả các nhóm tuổi. Một số nội dung bạo lực trong ngữ cảnh hài hước hoặc tưởng tượng có thể được chấp nhận. Không cho phép ngôn từ thô tục.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.Chodun.CatGunner\\u0026rdid\\u003dcom.Chodun.CatGunner\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đặt\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"26.000 ₫ - 1.300.000 ₫ mỗi mặt hàng\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Phổ thông\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.vng.ngoisaothoitrang\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/Na4b--Iu8RLe--oGqR4HFaygBoPFCrw-KTSkPGS6lHqgX7r4hzFm4eWBXv3Xf42V6fOJgzlpQrAtAvuaxJMFSQ\"],null,[226,132,135,255],null,null,null,2],[[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/kWS5apDI2cHz5pW1jaOmh4RMhetODmJ8EoZphjKNSmVP0IkldhtSrIlQ1tAQio-cpi_zehKlSd1WD4JmCGpM\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/RAjG6n-DAAt3upIoIkIldwCL-boJfv4-RkteZvIU6MR0q9B3KkvEf8nqe-0JgtlHfT5zQk8oQCNn7c0itm3o\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/iwtfxHpGHlbMpWGyNLQ-oHq9fh-3jUAZwxnbUFhIgX1JdvxtZ_cg5N2B4TQ4B8STR9qRjVhgYVw7kA8Kf-j2\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/IlDZ03N3de8yCT1Yuu-cNck4G6p7henJif-kXQFm18eBL5l9HpYjmasiE4T88YwEz2QH2dQ9yIJj5NBdOnima8c\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/HPwEMH3CKxVnsgMDLxUgtVUADARS632zisvzh9y5hQV_8TGCgrLsmx4CBivBdmPVWJntsVcIj3IdqJ5Ka7hjFA\"]]],\"Ngôi Sao Thời Trang\",[\"3,2\",3.1773422],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.vng.ngoisaothoitrang\\u0026rdid\\u003dcom.vng.ngoisaothoitrang\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.vng.ngoisaothoitrang\"]],[\"qgJlGmMIEkoTCIDagLDHkJcDFZbCcwEdfbAIjPoBDAoKCAASBgoCdmkQAboCOgoeChhjb20udm5nLm5nb2lzYW90aG9pdHJhbmcQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],null,[null,\"Quyết định phê duyệt nội dung kịch bản trò chơi điện tử G1 trên mạng số: 10/QĐ-PTTH\\u0026amp;TTĐT do CỤC PHÁT THANH, TRUYỀN HÌNH VÀ THÔNG TIN ĐIỆN TỬ cấp ngày 10/01/2026. \\u003cbr\\u003ehttps://giayphep.abei.gov.vn/g1/131790 \\u003cbr\\u003e\\u003cbr\\u003eNgôi Sao Thời Trang VNG 360mobi – Ngoisaothoitrang - Sáng tạo để trở thành stylist tài năng \\u003cbr\\u003e\\u003cbr\\u003eNgôi Sao Thời Trang VNG 360mobi - Ngoisaothoitrang – là game thời trang 2D số 1 dành cho phái nữ, có thể giúp bạn thõa mãn đam mê sáng tạo với thời trang và trở thành một stylist Nikki tài năng theo chất riêng của mình trong thế giới mộng ảo. Game có chiều sâu tính năng, cốt truyện hấp dẫn và được cập nhật liên tục chờ đợi các bạn khám phá! \\u003cbr\\u003e\\u003cbr\\u003eGame Ngôi Sao Thời Trang VNG 360mobi - Ngoisaothoitrang – sở hữu bộ sưu tập thời trang - fashion đa dạng, hàng ngàn phong cách khác nhau cho các bạn gái Nikki tự do phối đồ, tạo nên những bộ đồ cực fashion độc nhất vô nhị và cho phép trang điểm khuôn mặt theo đúng phong cách của riêng bạn. \\u003cbr\\u003e\\u003cbr\\u003eBạn còn có thể hóa thân thành các nàng stylist Nikki xinh đẹp và quyền lực, tự do thi đấu tranh tài với các người chơi khác thông qua các bộ thời trang – fashion có sẵn hoặc thử sức chế đồ độc lạ, xây dựng phong cách mới độc nhất vô nhị \\u003cbr\\u003e\\u003cbr\\u003eKhi chơi game Ngôi Sao Thời Trang VNG 360mobi - Ngoisaothoitrang – các bạn còn có thể gia nhập những hội nhóm stylist thân thiết, kết bạn giao lưu cùng các chị em Nikki để thêm bạn thêm vui và chill cùng bạn bè, tận hưởng thế giới fashion muôn màu sắc \\u003cbr\\u003e\\u003cbr\\u003eNgoài những bộ thời trang - fashion khoác lên người, các bạn còn được thỏa sức thế kế không gian riêng cho bản thân với những căn nhà nhỏ cực kỳ xinh xắn theo những chủ đề sống động từ Á sang Âu, từ cổ điển cho đến hiện đại nữa đó nha. \\u003cbr\\u003e\\u003cbr\\u003eHóa thân thành stylist Nikki tài năng, khám phá thế giới thời trang tuyệt vời bằng cách trải nghiệm ngay game Ngôi Sao Thời Trang VNG 360Mobi – Ngoisaothoitrang thôi nào các bạn ơi!\"],\"VNG GROUP JSC\",\"5.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/BIUwB764p5VPOmdHmLx_XREsNFnjWT25pxJeT_SMea-5yoTT9lEh0ldWNgRicD9m0tsdjx51MKZqODFaZtDIVA\"],null,[237,232,229,255]],null,[\"3 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Người dùng tương tác, Mua hàng trong trò chơi\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.vng.ngoisaothoitrang\\u0026rdid\\u003dcom.vng.ngoisaothoitrang\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đặt\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"22.000 ₫ - 1.499.000 ₫ mỗi mặt hàng\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Phổ thông\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,nu