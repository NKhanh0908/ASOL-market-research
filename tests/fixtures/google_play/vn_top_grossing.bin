l,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.banca.chienbinhvanmenh\\u0026rdid\\u003dcom.banca.chienbinhvanmenh\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.banca.chienbinhvanmenh\"]],[\"qgJnGmUIHkoTCIDagLDHkJcDFZbCcwEdfbAIjPoBDAoKCAASBgoCdmkQALoCPAogChpjb20uYmFuY2EuY2hpZW5iaW5odmFubWVuaBABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"Quyết định phê duyệt nội dung kịch bản trò chơi điện tử G1 trên mạng số: 301 /QĐ-PTTH\\u0026amp;TTĐT do Cục PTTH\\u0026amp;TTĐT cấp ngày 30/06/2025\\u003cbr\\u003eLink : https://giayphep.abei.gov.vn/g1/131717\\u003cbr\\u003e\\u003cbr\\u003eBắn Cá Đã Tay – Chuyển Xoay Vận Mệnh\\u003cbr\\u003eHóa thân thành thợ săn cá đỉnh cao trong thế giới bắn cá hiện đại – nơi giải trí và hành động hòa làm một. Gameplay mượt, hiệu ứng đẹp, súng cực đã tay!\\u003cbr\\u003eĐây là một fish shooting game arcade hấp dẫn, nơi bạn có thể thỏa sức săn cá, đối đầu với boss khủng và khám phá nhiều thử thách bất ngờ\\u003cbr\\u003eNếu bạn là fan của dòng fish hunter hoặc đang tìm kiếm một game giải trí vừa vui vừa đã tay – thì đây chính là lựa chọn hoàn hảo\\u003cbr\\u003e\\u003cbr\\u003eTính năng nổi bật:\\u003cbr\\u003e\\u003cbr\\u003e– Gameplay cực dễ, chạm là bắn, bắn liên hoàn, toàn quà xịn\\u003cbr\\u003e– Đồ họa đẹp mắt, hiệu ứng sinh động, thao tác mượt mà\\u003cbr\\u003e– Kho súng đa dạng, nâng cấp dễ dàng, kết hợp ngoại trang cực chất\\u003cbr\\u003e– Boss siêu to, sức mạnh siêu khủng, hiệu ứng nổ toàn màn hình\\u003cbr\\u003e– Sự kiện hàng ngày, đăng nhập nhận thưởng liên tục\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003eTải ngay để khám phá thế giới đại dương sống động, chinh phục mọi thử thách và trở thành thợ săn bá đạo nhất!\\u003cbr\\u003e\\u003cbr\\u003e※Trò chơi dành cho người từ 18 tuổi trở lên và chỉ có mục đích giải trí.\\u003cbr\\u003e※Nghiện game trong thời gian dài sẽ gây hại cho sức khỏe của bạn\\u003cbr\\u003e※Trò chơi không cung cấp hoạt động \\u0026quot;\\u0026quot;đánh bạc bằng tiền thật\\u0026quot;\\u0026quot; hoặc cơ hội để giành chiến thắng tiền\\u003cbr\\u003ethật hoặc giải thưởng tiền mặt.\\u003cbr\\u003e※Trò chơi này bao gồm tính năng mua hàng trong ứng dụng.\\u003cbr\\u003e※ Việc tập luyện hoặc chiến thắng khi chơi trò chơi casino xã hội không đồng nghĩa với việc chiến\\u003cbr\\u003ethẳng trong tương lai khi chơi trò chơi và đánh bạc bằng tiền thật.\"],\"9PLAY JOINT STOCK COMPANY\",\"100.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/WpKo4uFu4y2YRm-23lGQfX_koQBq1CxcoM_najXPA9-Hm7kpGG12eokJ-J_C0YfRcnjX1l-5LA8IE-jTqyuvyQ\"],null,[39,163,214,255]],null,[\"18 tuổi trở lên\",[null,2,[366,512],[null,null,\"https://play-lh.googleusercontent.com/QNpsl4k43vdbfwUAlVLZul2W5O5MUGOToystzghc97mljVHbUwtc639tahcuDsAVHdaGMyZA40AmMVcB_ws\"]],[null,\"Phần thưởng bằng tiền mặt\"],[null,\"Giao dịch mua trong trò chơi (bao gồm vật phẩm ngẫu nhiên)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/stIOCymv1bYIi3UU_owFeyNt30CkUXbNlDj81ZWtjW9NBIMJxI47i_psYIr0Ho430Rm6mByCGNLORloB\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.banca.chienbinhvanmenh\\u0026rdid\\u003dcom.banca.chienbinhvanmenh\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đặt\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"26.500 ₫ - 2.650.000 ₫ mỗi mặt hàng\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Phổ