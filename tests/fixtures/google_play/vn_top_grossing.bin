r7lexfmM\"]],[null,2,[1920,1200],[null,null,\"https://play-lh.googleusercontent.com/CCwxxm5kpNlZE108fqbRvLyH7Hs9AfwlvfO2Fic6A0JSl217h5KyHF_AEgepdvUsliSJuiVWmo2q3q7o8lyv0lU\"]],[null,2,[1920,1200],[null,null,\"https://play-lh.googleusercontent.com/qxUh9hZQ9XKnnZlNOphHBXzgjZ-e6bih3NMUXEqoIP86Ao0KfCuMjBPtkdZTJdraIsUWMqjGm4abxbdDWMsMrA\"]],[null,2,[1920,1200],[null,null,\"https://play-lh.googleusercontent.com/z1PRA09LD3bwswV5PQ_uUJ1Z6Z7siiVs2ks-Djabhv2GPaiot3EUiu-d0VLV4Zth81Zww3s_0sfhBrzA1bNEnG0\"]],[null,2,[1920,1200],[null,null,\"https://play-lh.googleusercontent.com/PbRJhWt9X6cY9DEPn91fcw02TmEjZ97vPQThyBQS8Yui87JJmqE-NM0IxSs9c0jyYE5JdoQQBHTDemwPIZur6g\"]],[null,2,[1920,1200],[null,null,\"https://play-lh.googleusercontent.com/2iIjN4Jg7ChsinCy55_bzm4Qadv1Um4304aKbdbp90-dd_-R5i-yP9EPTlQ3zlEeMcBTX-TEATOkKJVcDQQiSA\"]],[null,2,[1920,1200],[null,null,\"https://play-lh.googleusercontent.com/ST3hFftH3P9bMmPGp4t65dw2ruG9wTcS1BbWhUnJiKYYWKtHj-SgalB4d8_o9lvZSPthyHhqPOycq2KHngR2u9k\"]]],\"Merge Crime: Bí ẩn \\u0026 Lãng mạn\",[\"4,4\",4.41],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.standegg.mergecrime\\u0026rdid\\u003dcom.standegg.mergecrime\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.standegg.mergecrime\"]],[\"qgJkGmIIKEoTCIDagLDHkJcDFZbCcwEdfbAIjPoBDAoKCAASBgoCdmkQALoCOQodChdjb20uc3RhbmRlZ2cubWVyZ2VjcmltZRABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"“Bạn không thể trốn thoát khỏi tôi, Janey Hart.”\\u003cbr\\u003e\\u003cbr\\u003eGiữa tâm điểm những vụ án kinh hoàng rung chuyển New York, hai số phận giao nhau.\\u003cbr\\u003e\\u003cbr\\u003eNữ chuyên gia phân tích tội phạm thiên tài Janey và tên sát nhân hàng loạt khét tiếng Gilbert.\\u003cbr\\u003eKẻ săn đuổi và con mồi.\\u003cbr\\u003eGiữa hận thù và ám ảnh, một cuộc chiến tâm lý chết người bắt đầu.\\u003cbr\\u003e\\u003cbr\\u003eTất cả bắt đầu ngay lúc này, trong tầm tay bạn.\\u003cbr\\u003e\\u003cbr\\u003e🔍 Điều tra không hồi kết — ghép manh mối trong câu chuyện trinh thám\\u003cbr\\u003eKết hợp manh mối bằng merge, hoàn thành nhiệm vụ và phá giải các vụ án phức tạp.\\u003cbr\\u003eTrong chuỗi tội ác liên tiếp, sự thật nằm trong tay bạn.\\u003cbr\\u003e\\u003cbr\\u003e💘 Đồng đội cá tính\\u003cbr\\u003eJaney – thủ lĩnh lạnh lùng và quyết đoán, một cảnh sát đầy chính nghĩa, cùng một kẻ cung cấp tin tức đầy bí ẩn.\\u003cbr\\u003eHợp tác cùng đội ngũ lôi cuốn, trải nghiệm điều tra pha trộn lãng mạn và hồi hộp.\\u003cbr\\u003e\\u003cbr\\u003e🗝️ Sự thật gây sốc và quá khứ bị che giấu\\u003cbr\\u003eCó người che giấu sự thật, có người chôn vùi quá khứ.\\u003cbr\\u003eKhi manh mối ngày càng nhiều, bạn thật sự có thể tin ai?\\u003cbr\\u003e\\u003cbr\\u003e🎁 Nội dung phong phú và hấp dẫn\\u003cbr\\u003eHoàn thành hàng trăm nhiệm vụ gây nghiện và nhận phần thưởng giá trị.\\u003cbr\\u003eChương mới và câu chuyện mới sẽ được cập nhật thường xuyên.\\u003cbr\\u003e\\u003cbr\\u003eGame có lối chơi thư giãn, dễ tiếp cận hơn các game merge puzzle thông thường.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eCâu hỏi thường gặp\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003eQ. Tôi có thể chơi offline không?\\u003cbr\\u003eA. Có, ngoại trừ một số nội dung.\\u003cbr\\u003e\\u003cbr\\u003eQ. Dữ liệu có được giữ khi đổi thiết bị không?\\u003cbr\\u003eA. Có, nếu bạn liên kết tài khoản.\\u003cbr\\u003e\\u003cbr\\u003eHỗ trợ: mergecrime@standegg.com\\u003cbr\\u003e\\u003cbr\\u003eSupport\\u003cbr\\u003esupport@standegg.com\\u003cbr\\u003e\\u003cbr\\u003eĐiều khoản sử dụng\\u003cbr\\u003ehttps://korstandegg.wixsite.com/policy/terms\\u003cbr\\u003e\\u003cbr\\u003eChính sách quyền riêng tư\\u003cbr\\u003ehttps://korstandegg.wixsite.com/policy\\u003cbr\\u003e\\u003cbr\\u003eTrò chơi có mua hàng trong ứng dụng. Có thể phát sinh chi phí và đã bao gồm VAT.\"],\"StandEgg Co., Ltd.\",\"100.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/9rEUDG1easKYFuU6M6GUka_VcfRKaKBuw92GBtawHYR9f5OgrOEG4Q78QrAG1wqpV4nqJ0cfNd4jAqsg1n-gyQ\"],null,[2,57,74,255]],null,[\"7 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/1SrNtAwg9PFOhgMJPXehacRTeQNhHhG12Pj1zACHNVmfRfEZA3_oOEmLvRNsmYGeGHpas7sCwyR3y8OT\"]],[null,\"Bạo lực ngụ ý, Bạo lực nhẹ nhàng\"],null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/JTT-ImEkrbWzIL7w0fP8fQhVmpexdfh7u0P59PJtyJywmQBVolJjunMal6B5dUM6uiFiKnmtHtBbVvcWBMU\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.standegg.mergecrime\\u0026rdid\\u003dcom.standegg.mergecrime\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đặt\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"26.000 ₫ - 2.650.000 ₫ mỗi mặt hàng\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Phổ thông\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"cat.mansion.merge.games\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/ZfuNR5h1NwX4ejA_riQhzyvITiyn3FrIFggABGAe3SYEuBAt2YtLD_nuFk6o3Cd_I0U3Ze-zHWvgNturjKlqdw\"],null,[193,230,223,255],null,null,null,2],[[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/Zpt7Z8AZ8kBKZFjvFhqSB3nrMSYj0OnEcL-fi9W8tCza-bSN9Al0w1zUZw6WvMYX6zr