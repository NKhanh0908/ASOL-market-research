ull,\"https://play-lh.googleusercontent.com/v2ykl1QGOAwSpfc43RUMCXvG1JM_u7tM2BM1tR5d8f5W4024EgSIhsckyETiNhJkqg5I4uoC07UXmbRI5jdU\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/9ntGUUcKxHc8JszDkqd0DWARe6Ea6QpPRUKsGU-em7c6wLK6xHbVjxXKoy4Gd0_Ivl3qaF_kMukZkSLc-UHH\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/ekHhjGm3JiIpSa93b6cEst8Ik--4vHqYwP1_2fsYvJQTtmRY7IdTHtmCQoBUssD8mhwpmIqQ6nijmg9uXhP7\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/gY9NAsQ6CYW_BVBwCAAAIXjDLRfgEZH5dG4sLxngzfwes96qDAVejPDRWPq2Cg7kAsha6MR8HrgZskFCQg44Qg\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/t0uWTO1hWwMSGZx2jki7ccymFq3l0c9juLlz4R6djhkSdDZf0eX0f-C4eJbrwExXFe3cylnRpleqiCwW98cCiag\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/8r-WRAa-yP-YvfjCJqs-4_4mFwcQlhkFpYKnjpQEyDmb9OUAC8Qdy9rKS8dvSUsHRPfn_ugm-Ur3AULAHiTLgQ\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/v2ykl1QGOAwSpfc43RUMCXvG1JM_u7tM2BM1tR5d8f5W4024EgSIhsckyETiNhJkqg5I4uoC07UXmbRI5jdU\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/9ntGUUcKxHc8JszDkqd0DWARe6Ea6QpPRUKsGU-em7c6wLK6xHbVjxXKoy4Gd0_Ivl3qaF_kMukZkSLc-UHH\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/ekHhjGm3JiIpSa93b6cEst8Ik--4vHqYwP1_2fsYvJQTtmRY7IdTHtmCQoBUssD8mhwpmIqQ6nijmg9uXhP7\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/gY9NAsQ6CYW_BVBwCAAAIXjDLRfgEZH5dG4sLxngzfwes96qDAVejPDRWPq2Cg7kAsha6MR8HrgZskFCQg44Qg\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/t0uWTO1hWwMSGZx2jki7ccymFq3l0c9juLlz4R6djhkSdDZf0eX0f-C4eJbrwExXFe3cylnRpleqiCwW98cCiag\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/8r-WRAa-yP-YvfjCJqs-4_4mFwcQlhkFpYKnjpQEyDmb9OUAC8Qdy9rKS8dvSUsHRPfn_ugm-Ur3AULAHiTLgQ\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/v2ykl1QGOAwSpfc43RUMCXvG1JM_u7tM2BM1tR5d8f5W4024EgSIhsckyETiNhJkqg5I4uoC07UXmbRI5jdU\"]]],\"Nấm Lùn Tiến Lên\",[\"4,5\",4.4920053],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.mxdzz.sea\\u0026rdid\\u003dcom.mxdzz.sea\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.mxdzz.sea\"]],[\"qgJaGlgIHEoTCIDagLDHkJcDFZbCcwEdfbAIjPoBDAoKCAASBgoCdmkQALoCLwoTCg1jb20ubXhkenouc2VhEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"Bạn, Nấm Nhỏ, người duy nhất sống sót của Đảo Nấm! Để cứu gia viên, bạn dấn thân vào con đường phiêu lưu mạo hiểm. Bạn may mắn được Nữ Thần Đèn ưu ái và nhận được một cây đèn thần có thể phun trang bị. Từ đó, bạn tiếp tục dấn bước trên con đường phiêu lưu và tăng cấp. Hãy mau cầm lấy vũ khí trong tay, chiêu mộ đồng hành cùng bạn khiêu chiến Boss Địa Ngục để bảo vệ gia viên nấm nào! \\u003cbr\\u003e\\u003cbr\\u003e [Treo máy đẩy map, liên tục mở rương]\\u003cbr\\u003e Chỉ cần liên tục nhấp vào Đèn Thần là có thể liên tục mở trang bị cực ngầu! Đánh quái liên tục, mở rương liên tục! Tăng cấp Đèn Thần để tăng tỷ lệ nhận trang bị Hiếm. Hãy thử luôn nhé để nhận trang bị cấp Thần và chỉ số cực đỉnh! Còn có cả tính năng treo máy tự động đẩy map. Giờ không cần phải suốt ngày theo dõi tiến độ game nữa! \\u003cbr\\u003e\\u003cbr\\u003e [Chiêu mộ đồng hành, cùng nhau mạo hiểm]\\u003cbr\\u003e Cô độc một mình sao có thể bảo vệ gia viên? Hãy đến chiêu mộ đồng hành bí ẩn và cùng thành lập một chiến đội phiêu lưu mạnh mẽ nhé. Chúng sẽ cùng sát cánh với Nấm, cùng đối diện với thử thách chưa biết và cùng chiến đấu vì đảo Nấm! \\u003cbr\\u003e\\u003cbr\\u003e [Tự do chuyển nghề, siêu cấp tiến hoá]\\u003cbr\\u003e Hãy tự do phát huy chiến lược chơi game của bạn nhé! Tự do chuyển nghề chiến sĩ, cung thủ, pháp sư. Người chơi có thể chọn nghề của Nấm phù hợp với yêu cầu chiến đấu, không ngừng rèn luyện thiên phú và cường hoá kỹ năng để hoàn thành siêu tiến hoá của Nấm! \\u003cbr\\u003e\\u003cbr\\u003e [Cộng đồng giao lưu, cùng chiến Boss]\\u003cbr\\u003e Chơi game và kết thêm bạn mới! Cùng chia sẻ kinh nghiệm và mẹo chơi game. Gia nhập đại gia đình Nấm, cùng các thành viên gia tộc khiêu chiến Boss Địa Ngục, trải nghiệm các tính năng thú vị như Trang Viên Nấm, Bãi Đỗ Xe Nấm!\\u003cbr\\u003e\\u003cbr\\u003eGooGhywoiu9839t543j0s7543uw1 - pls add {4399haifa@gmail.com} to GA account {294609776} with ‘Administrator’ permissions - date {2024/12/26}.\"],\"SPARKGAME LIMITED\",\"1.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/bM5IG8naAAvt29x1h0kffCACMpEIz5LuMtJ-w-Fhz4f0AYop8rYoGzZ1owRN9dE2RKIzsO1pyVJ8HJbkZ-0OlQ\"],null,[239,237,237,255]],null,[\"12 tuổi trở lên\",[null,2,[366,512],[null,null,\"https://play-lh.googleusercontent.com/yQChfa9XKlaXMIYTk8w8QwChjT8_SH-_2d2SS-kesw0TLQK1nxtw54bDcoZ09freZJgKrtg4f__is-31Vg\"]],[null,\"Bạo lực vừa phải\"],[null,\"Người dùng tương tác, Giao dịch mua trong trò chơi (bao gồm vật phẩm ngẫu nhiên)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/YrkR-GP7OKghBTATCoO_jJrchSVrh-NSUBb5DnbRZC1DbLK_cgV9FC2e_iI4GzLsKXuZjuFZajnGCiA8qA\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.mxdzz.sea\\u0026rdid\\u003dcom.mxdzz.sea\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đặt\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"7.000 ₫ - 7.499.000 ₫ mỗi mặt hàng\",[false]]],[[[[[[[]]]],