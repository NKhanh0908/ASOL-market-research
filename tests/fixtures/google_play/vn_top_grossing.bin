leusercontent.com/34ZmYGGVMbCM4d7kHqbstE2aKKfkZ1l1rXIfCQuHCIWYmDUEgvKy7Hxv-4zOli3Qm-yfMdJ6KMPS5wd8EgM0\"]],[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/L4v63FEGt32qtqFlFC10TQuVGAU5T1uA4rVzcCkg13cW2XZkotQkPFXSubmbvaSx-rfLKnHbWthX4K1QCJTXZA\"]],[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/oheMONyoK8A3D_iVtYepw39kCHAg2jO6Vw7_i9GMXHeCmoC09kcep6quLIkatmaUGw4IMFzaZTeU0na-Ilr2-6U\"]],[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/fBgtxdKPHx3ICgOZ7KaGwdYEP5UrDQXebPa_ZRNHUutDACXrlFLu-MejCDeO4FC17Sm8f1fv9pUw3BlDTgS-ng\"]],[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/zUf1LfdgA1gqF5xgW8LsUGcdSnb6E8B4fAgOJ8jKoW53cSWYVM4cRIFk1TmwSr4pJo9aWzEcMUIxPj9CxE7i\"]]],\"Home Scapes – Ngôi nhà mơ ước\",[\"4,6\",4.5825243],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.playrix.homescapes.vn\\u0026rdid\\u003dcom.playrix.homescapes.vn\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.playrix.homescapes.vn\"]],[\"qgJmGmQIC0oTCIDagLDHkJcDFZbCcwEdfbAIjPoBDAoKCAASBgoCdmkQALoCOwofChljb20ucGxheXJpeC5ob21lc2NhcGVzLnZuEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"Chào mừng bạn đến với Homescapes, một trò chơi thực sự ấm áp từ sê-ri Scapes™ của Playrix! Giải các câu đố ghép 3 để khôi phục một biệt thự tuyệt vời trên con phố xanh tươi. Những cuộc phiêu lưu thú vị bắt đầu ngay trước cửa!\\u003cbr\\u003e\\u003cbr\\u003eVượt qua các màn chơi ghép 3 đầy màu sắc để cải tạo và trang trí các căn phòng trong biệt thự, mở khóa thêm nhiều chương mới trong câu chuyện gia đình thú vị! Bạn còn chờ gì nữa? Cứ tự nhiên như ở nhà nhé!\\u003cbr\\u003e \\u003cbr\\u003eCác tính năng của trò chơi:\\u003cbr\\u003e\\u003cbr\\u003e●     Lối chơi độc đáo: giúp Austin cải tạo ngôi nhà bằng cách hoán đổi và ghép các mảnh!\\u003cbr\\u003e●     Thiết kế nội thất: bạn quyết định ngôi nhà sẽ trông như thế nào.\\u003cbr\\u003e●     Các màn chơi ghép 3 hấp dẫn: vô cùng vui nhộn với các vật phẩm hỗ trợ độc đáo và những combo bùng nổ!\\u003cbr\\u003e●     Một biệt thự rộng lớn, xinh đẹp: khám phá tất cả những bí mật mà nó ẩn chứa!\\u003cbr\\u003e●     Các nhân vật tuyệt vời: xem họ sống cuộc sống của mình và tương tác với nhau trên mạng xã hội trong trò chơi.\\u003cbr\\u003e●     Một thú cưng dễ thương: gặp gỡ một chú mèo tinh nghịch và lông xù.\\u003cbr\\u003e●     Mời bạn bè trên Facebook của bạn để giúp bạn tạo ra không khí ấm cúng của riêng mình trong nhà!\\u003cbr\\u003e \\u003cbr\\u003eHomescapes là trò chơi miễn phí nhưng một số vật phẩm trong trò chơi (bao gồm các vật phẩm ngẫu nhiên) có thể được mua bằng tiền thật. Nếu bạn không muốn sử dụng tùy chọn này, chỉ cần tắt nó trong menu Hạn chế của thiết bị.\\u003cbr\\u003e \\u003cbr\\u003eBạn thích Homescapes? Tìm hiểu thêm về trò chơi!\\u003cbr\\u003eFacebook: https://www.facebook.com/homescapes/\\u003cbr\\u003eInstagram: https://www.instagram.com/homescapes_mobile/\\u003cbr\\u003e \\u003cbr\\u003eBạn có câu hỏi? Hãy liên hệ với bộ phận Hỗ trợ Kỹ thuật của chúng tôi bằng cách gửi email đến support@playrix.com.\\u003cbr\\u003e\\u003cbr\\u003eChính sách Bảo mật: https://playrix.com/privacy/index.html\\u003cbr\\u003eĐiều khoản Sử dụng: https://playrix.com/terms/index.html\"],\"VTC GAme\",\"10.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/siGop-g2J2nl2htNX1xdSODPszVgNJQrfnL93QJG20lQAcy-ssP-HWraxxRBE7hYZVVninDN7Sr5ARMP90KhsA\"],null,[149,113,156,255]],null,[\"3 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Người dùng tương tác, Giao dịch mua trong trò chơi (bao gồm vật phẩm ngẫu nhiên)\"],[null,\"\\