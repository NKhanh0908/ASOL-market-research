20,1080],[null,null,\"https://play-lh.googleusercontent.com/ccdCL9203I_sRetEjl7fmdht0TxoS8Iz4fBAher_RZo2T7fkIxaOvmZUftV-VvIZxZHl0yTQzHnYt6U-YzFk\"]]],\"Merge Valley - Không Cần Mạng\",[\"4,8\",4.79],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.bigcool.puzzle.merge.valley\\u0026rdid\\u003dcom.bigcool.puzzle.merge.valley\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.bigcool.puzzle.merge.valley\"]],[\"qgJsGmoIJ0oTCIDagLDHkJcDFZbCcwEdfbAIjPoBDAoKCAASBgoCdmkQALoCQQolCh9jb20uYmlnY29vbC5wdXp6bGUubWVyZ2UudmFsbGV5EAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"\\u003cb\\u003eChào mừng bạn đến với Merge Valley - Không Cần Mạng — trò chơi giải đố hợp nhất và thiết kế nhà cực thư giãn mà bạn có thể chơi mọi lúc mọi nơi!\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003eBắt đầu hành trình đến một thị trấn bí ẩn, hợp nhất các vật phẩm và xây dựng thành phố trong mơ của bạn!\\u003cbr\\u003e\\u003cbr\\u003eMerge Valley kết hợp niềm vui của trò chơi hợp nhất (merge) với trang trí nhà cửa. Giúp người dân cải tạo thị trấn đổ nát của họ và biến nó thành một điểm đến du lịch tuyệt vời. Đây là lựa chọn hoàn hảo để xả stress, rèn luyện trí não và tận hưởng game không cần mạng.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003e✨ CÁC TÍNH NĂNG BẠN SẼ YÊU THÍCH\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003e🔨 Trò Chơi Giải Đố Hợp Nhất Gây Nghiện\\u003c/b\\u003e\\u003cbr\\u003e• Khám phá phiên bản mới của trò chơi hợp nhất cổ điển.\\u003cbr\\u003e• Kéo, ghép và hợp nhất các vật phẩm để tạo ra công cụ tốt hơn.\\u003cbr\\u003e• Khám phá hàng trăm vật phẩm độc đáo trong trò chơi giải đố thư giãn này.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003e🏠 Cải Tạo và Xây Dựng Thành Phố\\u003c/b\\u003e\\u003cbr\\u003e• Kiếm tiền ảo từ việc giải đố để cải tạo nhà cửa và các tòa nhà.\\u003cbr\\u003e• Mang lại sức sống mới cho thung lũng cũ theo phong cách cá nhân của bạn.\\u003cbr\\u003e• Thiết kế, trang trí và xây dựng thị trấn trong mơ của bạn từ con số không.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003e🗺️ Du Lịch, Cốt Truyện và Bí Mật\\u003c/b\\u003e\\u003cbr\\u003e• Theo dõi một câu chuyện thú vị khi bạn đi qua các khu vực khác nhau.\\u003cbr\\u003e• Khám phá những bí mật ẩn giấu và giải mã bí ẩn đằng sau lịch sử thị trấn.\\u003cbr\\u003e• Gặp gỡ những nhân vật thú vị và mở khóa các chương mới bằng tiếng Việt.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003e🧘 Thư Giãn và Rèn Luyện Trí Não\\u003c/b\\u003e\\u003cbr\\u003e• Lý tưởng để giảm căng thẳng với các phiên chơi ngắn hàng ngày.\\u003cbr\\u003e• Cách tốt nhất để thư giãn với các câu đố vui nhộn.\\u003cbr\\u003e• Dễ chơi nhưng khó giỏi: trải nghiệm game giải trí tuyệt vời nhất.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003e📶 Game Miễn Phí và Không Cần Wifi\\u003c/b\\u003e\\u003cbr\\u003e• Chơi mọi lúc mọi nơi: không cần wifi.\\u003cbr\\u003e• Dù bạn đang đi du lịch hay ở nhà, câu chuyện hợp nhất của bạn vẫn tiếp tục offline.\\u003cbr\\u003e• Niềm vui không bao giờ dừng lại, ngay cả khi chơi game không cần mạng.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003e🎮 CÁCH CHƠI\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003e• \\u003cb\\u003eHợp nhất:\\u003c/b\\u003e Kéo và kết hợp hai vật phẩm giống nhau để tạo ra một vật phẩm mới.\\u003cbr\\u003e• \\u003cb\\u003eĐơn hàng:\\u003c/b\\u003e Hoàn thành yêu cầu của người dân để nhận phần thưởng.\\u003cbr\\u003e• \\u003cb\\u003eThiết kế:\\u003c/b\\u003e Sử dụng tiền ảo để cải tạo, trang trí và mở rộng thị trấn của bạn.\\u003cbr\\u003e• \\u003cb\\u003eKhám phá:\\u003c/b\\u003e Mở khóa các khu vực mới và hé lộ cốt truyện!\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eVui vẻ, tập trung và thư giãn, tất cả trong một!\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003eTải xuống \\u003cb\\u003eMerge Valley - Không Cần Mạng\\u003c/b\\u003e ngay! Tận hưởng các câu đố hợp nhất thỏa mãn, cải tạo sáng tạo và thư giãn thực sự. Trò chơi giải đố hay nhất đang chờ bạn! Bắt đầu hành trình của bạn ngay hôm nay!\"],\"Bigcool Games\",\"100.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/tu-c0xAypNfNdy3R3P1qxS6AZ2ztpZDyUogn8NRrihECnGvr5hLCX5aeR4xb8yaXg1I10QeCcFbr6Rz24He88k0\"],null,[181,194,222,255]],null,[\"3 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Giao dịch mua trong trò chơi (bao gồm vật phẩm ngẫu nhiên)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.bigcool.puzzle.merge.valley\\u0026rdid\\u003dcom.bigcool.puzzle.merge.valley\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đặt\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"22.000 ₫ - 2.200.000 ₫ mỗi mặt hàng\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Phổ thông\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.standegg.mergecrime\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/3ww9mMROx24_bv9qQx90LAp-0m-R1Ey_cVTIXq8xbugTLYoMCRLm2iLzn