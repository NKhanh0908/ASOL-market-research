nt.com/blwjpdSt9kSbZ5f0F0aZbxBU1lEG21CfB5iTj3GyEpPQw5ufCPwsLk61h-VF-Yv7_nKAEmmlb2_H2CvMRhs1Zg\"]],[null,2,[2048,2732],[null,null,\"https://play-lh.googleusercontent.com/6ow4gTB5hzIWLsU8iEa9bc6FfFXI41JfPYXi1GuchXi-nQPQWwTPOSKQCef8eBcZDIVRUVr4-Bo575cCw7JJ0pE\"]],[null,2,[2048,2732],[null,null,\"https://play-lh.googleusercontent.com/-K5HYjLgfoUlLbF56KnE_vnLgHY6rVQtbQCAsWIMJKyc4IP_y8LVYd3sv4jY1CKnoAv1Hft9fSx-Z27OAPSifw\"]],[null,2,[2048,2732],[null,null,\"https://play-lh.googleusercontent.com/3sVvB-4IAzqP9GbpiOOEZalIBBkqqU82RqXKQNLAvUk2J-5IGfGIRTju_G1dl-f9PFkRXfDUT4lspjJLJ4Ck\"]],[null,2,[2048,2732],[null,null,\"https://play-lh.googleusercontent.com/S-3zwXa0DznjsNw7MjYoJhlVFgU70TxwUpgt6XFflnI06IR-0PlzBPAee-VUPDPYEQcrKlKRYzStTTniys_gjA\"]],[null,2,[2048,2732],[null,null,\"https://play-lh.googleusercontent.com/c8eI5xXBczSBXoTgMOCtAt8ftlQPUdOTM6YynRBiNb2HenDibMq00B87Wa365kBebIQf7ZNZkBW6xsoWA4uH\"]]],\"Khu Vườn Trên Mây - Trồng Cây\",[\"3,6\",3.6],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dsp.kvtm.zp\\u0026rdid\\u003dsp.kvtm.zp\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dsp.kvtm.zp\"]],[\"qgJXGlUILEoTCIDagLDHkJcDFZbCcwEdfbAIjPoBDAoKCAASBgoCdmkQALoCLAoQCgpzcC5rdnRtLnpwEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"🌼KVTM ZingPlay do VNG độc quyền phát triển là game xây dựng vườn nông trại online 🌼 \\u003cbr\\u003e\\u003cbr\\u003eGiữa cuộc sống hiện đại tấp nập, có bao giờ bạn muốn được thử cảm giác được sống chậm lại, trồng cây, thu hoạch và sản xuất nông sản? Muốn được thư giãn và tận hưởng những gì bình dị nhất? \\u003cbr\\u003e\\u003cbr\\u003eChào mừng bạn đến với nông trại trên mây KVTM ZingPlay! \\u003cbr\\u003e\\u003cbr\\u003e🍀⛅🍀⛅🍀⛅🍀⛅ \\u003cbr\\u003e\\u003cbr\\u003eTính năng game online KVTM ZingPlay: \\u003cbr\\u003e\\u003cbr\\u003e🍄KHÁM PHÁ VÔ TẬN \\u003cbr\\u003e\\u003cbr\\u003eHàng trăm cây và chậu xinh ở Vườn Mây đang chờ bạn khám phá. Bật mí: Mỗi chậu đều có buff hỗ trợ siêu xịn.   \\u003cbr\\u003e\\u003cbr\\u003e🌺BUÔN CÓ BẠN, BÁN CÓ PHƯỜNG \\u003cbr\\u003e\\u003cbr\\u003eTham gia trồng cây và buôn bán nông sản cùng bạn bè ở khắp nơi. Cùng nhau tranh tài ở các bảng xếp hạng, so xem vườn ai xinh hơn! \\u003cbr\\u003e\\u003cbr\\u003e🌞 SỰ KIỆN SIÊU HẤP DẪN \\u003cbr\\u003e\\u003cbr\\u003eMuôn vàn sự kiện hấp dẫn diễn ra quanh năm, luôn đổi mới làm bạn chẳng bao giờ chán được khi đã đặt chân đến vườn mây ZingPlay. \\u003cbr\\u003e\\u003cbr\\u003e🌼RẤT NHIỀU QUÀ TẶNG MIỄN PHÍ MỖI NGÀY \\u003cbr\\u003e\\u003cbr\\u003eThăm nông trại trên mây mỗi ngày để nhận thêm nhiều phần quà MIỄN PHÍ từ những người bạn cổ tích. Nói nhỏ: Bạn có thể sưu tầm rương quý để nhận chậu hiếm trồng cây và trang trí vườn. \\u003cbr\\u003e\\u003cbr\\u003eHình ảnh game tươi sáng phù hợp với mọi lứa tuổi. Giao diện được chăm chút nhằm tạo thuận tiện tối đa với người chơi. Ngoài ra, KVTM ZingPlay còn hỗ trợ thêm 3 cổng đăng nhập (Facebook, Google và Zing) tạo điều kiện thuận lợi cho người chơi tiếp cận với người chơi nhiều hơn. \\u003cbr\\u003e\\u003cbr\\u003eKhu vườn trên mây ZingPlay tái hiện thế giới thần tiên tương tự như game Hay Day , Township , Farmville 2 , Big Farm ,.. ngay trên tay bạn. Một nông trại trên mây yên bình và giản dị cùng các nhân vật cổ tích đáng yêu. \\u003cbr\\u003e \\u003cbr\\u003eKhu vườn trên mây ZingPlay - Thế giới thần tiên ngay trên tay bạn! \\u003cbr\\u003eVới nông trại KVTM ZingPlay, toàn bộ tính năng hoàn toàn miễn phí. \\u003cbr\\u003e\\u003cbr\\u003eNếu bạn cần hỗ trợ, hãy nhắn tin qua Fanpage KVTM ZingPlay nhé: https://www.facebook.com/khuvuontrenmayzingplay/\"],\"ZINGPLAY VIETNAM\",\"50.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/iHeWzONGSAyM0lkXJfUdxlKzOWPnfgOJYSp9NjB_Bi-p1oWWfCSdmeyto4Uh7uK-FVZIxpicTPlAKi6EgJqfsg8\"],null,[245,250,251,255]],null,[\"12 tuổi trở lên\",[null,2,[366,512],[null,null,\"https://play-lh.googleusercontent.com/yQChfa9XKlaXMIYTk8w8QwChjT8_SH-_2d2SS-kesw0TLQK1nxtw54bDcoZ09freZJgKrtg4f__is-31Vg\"]],[null,\"Cờ bạc được mô phỏng\"],null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/YrkR-GP7OKghBTATCoO_jJrchSVrh-NSUBb5DnbRZC1DbLK_cgV9FC2e_iI4GzLsKXuZjuFZajnGCiA8qA\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dsp.kvtm.zp\\u0026rdid\\u003dsp.kvtm.zp\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đặt\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"5.000 ₫ - 2.450.000 ₫ mỗi mặt hàng\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Phổ thông\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.crazylabs.fashion.squad\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/GyeRleljzAySYA4QOX1DGdbINgbINGoEjyk3_oUkLgrrRRXBc5rXphnL_eh6Q35IDXYUDZoe89A9ElUJOikZGw\"],null,[247,171,216,255],null,null,null,2],[[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/h_LCKOnb-nxwPnZojm_M3GU1i5hFVdlL6tYFRRQRVqQqG509_OIZHpwhsXP1s4O7XYbDIjQhaoUF29H4gs2z_A\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/xcScS-We4EC-pFak8V7Q7YvE21lYA90GNY7DDJfeg5BkfJE15hR8ZosDdrAW0fa1_U2s_Z0i3yes3UjakcKlFg\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/O5e