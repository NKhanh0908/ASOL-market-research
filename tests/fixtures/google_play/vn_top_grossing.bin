jQnPI5xHOLfFh3rc0hwACbEQAuUGkvQ-WjQjNDWHjS1wHpZ69-6EKONKUub\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/Q77EBCHOCKUDFpy_l_AT4nf4CKJSxsIGIkIsQ6XPjEs7iBxKRV69tR95HaoLgU2ekdTeOvS5pWGm9OXF1QWtaQ\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/5-QUUW0JBJDCJKDeQmRAp05VTjdLVKyj_XKpaaEPcMpIxa8rX2BIZDnLo2PNwVYjo79WspFJ-HyFN8V8RahcCSA\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/lWLCBOacKjAyKoFnhgRyQopXuJmfI0u0IuaTgyfovkOg8gZqDP493_nMKLOhaT8yyQcM8dLITANTrxikrOX2\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/EGYmPvqtE5NDL0-3JyoKy7_UkAtbsIW3Ssc0Ey0qbvCDNHngvoYtsVNXhU-REou-vtXo5sIg1pgv3n7QrvlbeQ\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/pogJKyFCG_rWjiXuP9_h7kQVPWBjerZ-3EyXEpDyOZtNN1Ie6SdiReXCsumqat5ly6igm2pQPAJzWAhMdqyJgw\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/m8aixjG3mmKPGnDVasGu0e9nfjQnPI5xHOLfFh3rc0hwACbEQAuUGkvQ-WjQjNDWHjS1wHpZ69-6EKONKUub\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/Q77EBCHOCKUDFpy_l_AT4nf4CKJSxsIGIkIsQ6XPjEs7iBxKRV69tR95HaoLgU2ekdTeOvS5pWGm9OXF1QWtaQ\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/5-QUUW0JBJDCJKDeQmRAp05VTjdLVKyj_XKpaaEPcMpIxa8rX2BIZDnLo2PNwVYjo79WspFJ-HyFN8V8RahcCSA\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/lWLCBOacKjAyKoFnhgRyQopXuJmfI0u0IuaTgyfovkOg8gZqDP493_nMKLOhaT8yyQcM8dLITANTrxikrOX2\"]]],\"Just Desserts: Revenge \\u0026 Merge\",[\"4,8\",4.7652173],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.justdesserts.global\\u0026rdid\\u003dcom.justdesserts.global\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.justdesserts.global\"]],[\"qgJkGmIICkoTCIDagLDHkJcDFZbCcwEdfbAIjPoBDAoKCAASBgoCdmkQAboCOQodChdjb20uanVzdGRlc3NlcnRzLmdsb2JhbBABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"Step into the enchanting town of Frostvale, where sweetness masks dark secrets! Join talented pastry chef Ella as she returns to her hometown to uncover the truth behind a mysterious fire. Merge desserts to restore your family’s beloved pastry shop and dig past the icing to reveal long-buried truths.\\u003cbr\\u003e\\u003cbr\\u003eMake Desserts\\u003cbr\\u003e\\u003cbr\\u003eMerge ingredients like powdered sugar and butter to whip up delicious cookies! Upgrade your recipes to unlock exquisite delights, including the elegant Swan Cake. The more you create, the more delectable treats you\\u0026#39;ll discover!\\u003cbr\\u003e\\u003cbr\\u003eRebuild the Pastry Shop\\u003cbr\\u003e\\u003cbr\\u003eTransform your family’s charred shop into a magnificent dream space! Choose vintage tiles, glowing neon signs, and exquisite furniture to design a shop that reflects your style. Each area you rebuild unveils new plot clues.\\u003cbr\\u003e\\u003cbr\\u003eReconnect with the Past\\u003cbr\\u003e\\u003cbr\\u003eReunite with Edward, your former lover. Is he your unexpected savior or an accomplice to the arson? As rivals appear, what schemes lie behind their charming smiles? Explore your mother’s mysterious recipe and the secrets of that fateful night!\\u003cbr\\u003e\\u003cbr\\u003eUncover the Truth\\u003cbr\\u003e\\u003cbr\\u003eGather clues from the night of the fire through decorating and merging! Piece together charred photographs, shattered ledgers, and cryptic notes. Can you unravel the family secret that someone is desperate to keep hidden?\\u003cbr\\u003e\\u003cbr\\u003eWarning: In this small town, the sweetest smiles often hide the deadliest lies.\"],\"Century Games Innovation Pte. Ltd.\",\"1.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/LrS9usanUwoVuvA4gHc-r2VRH5UWJfy7g0O2k6eTnnBKk-Ti5xHnzGZlwFUPNjYAXC-wFTuP1i1B3CYD7skCojg\"],null,[141,110,114,255]],null,[\"3 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,[null,\"Phù hợp với tất cả các nhóm tuổi. Một số nội dung bạo lực trong ngữ cảnh hài hước hoặc tưởng tượng có thể được chấp nhận. Không cho phép ngôn từ thô tục.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.justdesserts.global\\u0026rdid\\u003dcom.justdesserts.global\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đặt\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"29.000 ₫ - 2.999.000 ₫ mỗi mặt hàng\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Phổ thông\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.playrix.homescapes.vn\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/c1pC1Pa_a1rvOywBP6BKgStbGxT3-Af_m611s1lDZlIT1rDA1-Gk89jsbwrY6BI-8WTzWvP47pRXKUOyp6-28GU\"],null,[152,16,72,255],null,null,null,2],[[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/bcHBdSMqZ39UceXt7qdG5t1QjxGsx4ysJw7FUU-CcKYB8nsjLX63JiJHWKfxxMdo_pHIl09jauUYHtPDfu3-y