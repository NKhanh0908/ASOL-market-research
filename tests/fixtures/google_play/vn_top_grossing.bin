],[null,null,\"https://play-lh.googleusercontent.com/96GgcbiYaNNZL64XDtnKVNgBDxrTsXhq8msFiYbfQTKmRBN4ec2y3816Uh9QN-Len8HSD03-gnkgMPZ7bs3DEQ\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/8vfWJxlyhu_ZAGG3vybcCIRQT4RFRDtBydVLm_r1zZLv4qGh0FHk3i-pESWj8BLKPkk7gg5xVnFyP8e5yXueqIY\"]]],\"GunPow - Bắn Gà Teen PK\",[\"3,7\",3.6703396],\"Phổ thông\",null,null,[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.wyd.gunpow\\u0026rdid\\u003dcom.wyd.gunpow\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.wyd.gunpow\"]],[\"qgJbGlkIH0oTCIDagLDHkJcDFZbCcwEdfbAIjPoBDAoKCAASBgoCdmkQALoCMAoUCg5jb20ud3lkLmd1bnBvdxABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,\"Xqdoi16mGXI\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:Xqdoi16mGXI?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:Xqdoi16mGXI\",null,null,null,null,\"AXH1ezmkV9LdHJiv4uVaJ0jnRk1bbWGHvftHRPjLJmDjjcHJS__qi65xN-3eRhCHmHvJWV1fjZ_5XJbZBWeW8p3twz_s0SHqPNOppmY5_O9aOCy66ruQByDD8UVE1MKSvjCViBxqEnhbKGOJsSWLL2yVcvIe3NemlDdqigamwTZCWuwdCCl3S5mVvVH08emnZudIVPNhGFFdGFzAIAOenVVa9q7IB6C3fhMl5IbuOzDTxLudjQT_QjLwd3WjHiERT9EDAAky8TmXdZPhS6KjDwfWZigFcHgA5bfCIhjUHxIV-I0PUA\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/Xqdoi16mGXI/hqdefault.jpg\"]]]],[null,\"Quyết định phát hành trò chơi điện tử G1 trên mạng số 572/QĐ-PTTH\\u0026amp;TTĐT do Cục Phát thanh, truyền hình và thông tin điện tử cấp ngày 23/12/2025.\\u003cbr\\u003ehttps://giayphep.abei.gov.vn/g1/132144\\u003cbr\\u003e\\u003cbr\\u003eGunPow là game bắn súng tọa độ mobile thế hệ mới dành cho tuổi Teen, có thể chơi cùng bạn bè, đấu súng tọa độ “phi phai” kịch tính và liên quân đồng lòng đánh boss cự đã, mang đến lối chơi \\u0026quot;Kéo cực mê - Thả cực phê\\u0026quot; vô cùng vui nhộn và hấp dẫn. \\u003cbr\\u003e\\u003cbr\\u003eNếu các gunners từng mê trào lưu bắn gà Gunny huyền thoại, thì việc săn \\u0026quot;Gà\\u0026quot; trên GunPow sẽ mang đến cho bạn một trải nghiệm bắn súng hoàn toàn mới mẻ và chân thật nhất, với hệ thống hơn 100 loại súng, bôm, vũ khí độc lạ, đi kèm với các hiệu ứng tấn công đẹp mắt và sống động. Bên cạnh đó là hệ thống Thú cưỡi dễ thương cùng với dàn Pet siêu ngầu sẽ là trợ thủ đắc lực trong trò chơi bắn súng tọa độ mobile.\\u003cbr\\u003e\\u003cbr\\u003e💥HIỆU ỨNG KÉO - THẢ - BẮN ĐỘC LẠ TRÊN MOBILE\\u003cbr\\u003eVới thao tác chơi đơn giản nhưng đòi hỏi sự tinh tế, GunPow mang lại lối chơi bắn súng tọa độ mobile cực kỳ gây nghiện trong việc kéo và thả, gunners dễ dàng làm quen với lối chơi bắn gà Gunny huyền thoại và tận hưởng cảm giác trò chơi bắn súng chuẩn hero skill. Các trận đấu có thể hoàn thành nhanh chóng trong vài phút, tạo ra nhịp độ tốc chiến nhanh, kích thích và không nhàm chán. Đây chính là yếu tố tạo nên sự khác biệt của GunPow so với các game bắn súng sinh tồn khác trên thị trường.\\u003cbr\\u003e\\u003cbr\\u003e👗HỆ THỐNG THỜI TRANG, PET, VÀ THÚ CƯỠI CỰC CHIẾN\\u003cbr\\u003eGunPow sở hữu hệ thống skin thời trang phong cách, đa dạng không chỉ làm đẹp mà còn giúp tăng lực chiến và tốc độ khi chiến đấu. Thú cưỡi cực ngầu, Pet siêu cool là trợ thủ đắc lực giúp xạ thủ tăng tốc chiến trong mọi trận liên minh, liên quân PvP, PvE, tham gia đánh boss, và chiến phó bản mang đậm chất vng gaming.\\u003cbr\\u003e\\u003cbr\\u003e🎨ĐỒ HỌA MANGA CHIBI DỄ THƯƠNG CHO TUỔI TEEN\\u003cbr\\u003eVới đồ họa 2D sinh động phong cách Manga Chibi cực kỳ đáng yêu, kết hợp cùng âm thanh sống động, GunPow mang đến những trận bắn súng mãn nhãn với hiệu ứng ballistic combat chân thực. Trải nghiệm PK đã tay không thể bỏ qua trên nền tảng mobile.\\u003cbr\\u003e\\u003cbr\\u003e🔫 SỞ HỮU HƠN 100 VŨ KHÍ CỰC CHẤT - SKIN THỜI TRANG CỰC XỊN\\u003cbr\\u003eGunPow sở hữu hệ thống hơn 100 loại vũ khí trang bị, súng bôm, gậy như ý Tôn Ngộ Không… tốc chiến tốc thắng cực đã. Mỗi loại vũ khí đều có hiệu ứng tấn công độc đáo, kèm theo đó là các skin súng thời trang giúp tăng sức mạnh, lực chiến và tốc bắn cùng liên minh leo rank.\\u003cbr\\u003e\\u003cbr\\u003e💖TÍNH NĂNG KẾT HÔN LÃNG MẠN TRONG GAME\\u003cbr\\u003eKhông chỉ là game bắn súng, GunPow còn mang lại tính năng xã hội thú vị như kết hôn, tìm kiếm tình yêu phi phai. Người chơi có thể tham gia các sự kiện, kết bạn và tổ chức đám cưới trong game, tạo những khoảnh khắc phi phai, khó quên cùng với bạn bè và người chơi khác trong cộng đồng vng.\\u003cbr\\u003e\\u003cbr\\u003e⚔️ LIÊN MINH XẠ THỦ, VƯỢT PHÓ BẢN HẤP DẪN\\u003cbr\\u003eHệ thống phó bản phong phú giúp các gunners liên quân đồng đội tốc chiến chống lại các Boss khủng trong những trận tử chiến cam go, đem đến những thử thách mới, giúp bạn không ngừng hoàn thiện kỹ năng bắn súng và PK như một hero shooter đích thực.\\u003cbr\\u003e\\u003cbr\\u003e🎯 ĐA DẠNG CHẾ ĐỘ CHƠI\\u003cbr\\u003e📌Chế độ bắn súng chiến đấu với Boss, chiến phó bản với lối chơi siêu tốc nhanh chóng.\\u003cbr\\u003e📌Chế độ bắn súng, bắn gà Gunny đối kháng 1v1, 2v2, 3v3 giao tranh ở nhiều bản đồ (mini map), chế độ chơi (mini world) độc đáo mang lại trải nghiệm bắn súng tọa độ hấp dẫn, vui vẻ.\\u003cbr\\u003e📌Nhiều chế độ khác theo thời gian như tốc chiến.\\u003cbr\\u003e📌Chế độ xếp hạng cạnh tranh, công bằng và thể hiện trình độ kỹ năng xạ thủ.\\u003cbr\\u003e\\u003cbr\\u003e🤝 CÔNG HỘI VUI NHỘN\\u003cbr\\u003eTham gia công hội để giao lưu, kết bạn và cùng nhau trải qua những trận đại chiến liên server đầy thử thách cam go.\\u003cbr\\u003e\\u003cbr\\u003ePERMISSION\\u003cbr\\u003e• WRITE_EXTERNAL_STORAGE sử dụng tính năng đọc ghi file của tính năng social.\\u003cbr\\u003e• READ_EXTERNAL_STORAGE sử dụng tính năng đọc ghi file social.\\u003cbr\\u003e• READ_PHONE_STATE sử dụng Device ID để ghi log hệ thống VNG\\u003cbr\\u003e• RECORD_AUDIO sử dụng để tính năng chat voice trong game.\\u003cbr\\u003e• GET_ACCOUNTS sử dụng để gửi nội dung đến user.\"],\"VNG GROUP JSC\",\"5.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/2_6VphvU5MgGklrgTfcSivJ7MDEK9Apg8Wlh_JZKY6E9m9Ldzw7XzPus3TMRav3m9OC_qX6oirmp_ieshG4q\"],null,[217,224,217,255]],null,[\"3 tuổi trở lên\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Người dùng tương tác, Mua hàng kỹ thuật số\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eTìm hiểu thêm\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"VND\",\"\"]],null,[null,\"Mua\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.wyd.gunpow\\u0026rdid\\u003dcom.wyd.gunpow\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Cài đặt\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"9.000 ₫ - 1.499.000 ₫ mỗi mặt hàng\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Phổ thông\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.lastshelter.gpvi\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/MlndUowRZR-Ec_4doacfRb55fSPftYhMwjUyjSGY6RwWg5hUYdmZsHnDSS_v9JlqhSH-JNHsc9ZnduZ63ZmS\"],null,[186,184,232,255],null,null,null,2],[[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/B4lONLlOca0UGa8Nk0kWsw5ocdNUnwtzBJQItcG3a_ZveC9idettSdDuQ8bqvjIEO2g7j