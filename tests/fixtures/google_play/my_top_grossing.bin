Lifetime Sim game\",[\"4.0\",4.0485435],\"Casual\",null,null,[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.familygo.simgame\\u0026rdid\\u003dcom.familygo.simgame\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.familygo.simgame\"]],[\"qgJkGmIIJkoTCKLtirHHkJcDFf2nrAIdCDQci/oBDwoNCAASCQoFZW4tVVMQALoCNgoaChRjb20uZmFtaWx5Z28uc2ltZ2FtZRABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,\"OIzlGpNhBH8\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:OIzlGpNhBH8?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:OIzlGpNhBH8\",null,null,null,null,\"AXH1eznCswNegQoK5XikDOA2NOVKfglmb28VZ0yHFwdTe0CBKS1uO4QmxHBFut4O6xFZrg8q_7IKaDyq856Xz0kNBvCKsw_S1mr0tRVGcpK_F8GyG3-ulDWF4FYlqDRjh_9ignsBsZk82_Xq_574RmQXEEfCWLLx8IQ-vhL6rfh5C8wOb4EhexZT1AXJpLk1XFiiCEQRcZ7FNlSqkoaWs0XxBSipLCUJuKwTN_4jLAp-e_S0RMkkUtmehq-gXUfvUrWljbqhZ3zC8lE8A6YFRP5GBRkbdVpy-3DPjX6mxQHogyrYUg\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/OIzlGpNhBH8/hqdefault.jpg\"]]]],[null,\"📖 Build your family legacy across generations!\\u003cbr\\u003e\\u003cbr\\u003eWelcome to Family Go!, the ultimate life simulation adventure where every choice you make shapes the destiny of your family. Grow your family tree, watch new generations thrive, and build a town empire that will last a lifetime!\\u003cbr\\u003e\\u003cbr\\u003eIn Family Go!, you start with a single character and make life-changing decisions that influence your family\\u0026#39;s journey. Will you choose love, wealth, fame, or a peaceful rural life? As your family grows, each new generation brings fresh opportunities, challenges, and surprises.\\u003cbr\\u003e\\u003cbr\\u003e🏡 Family Simulation Adventure\\u003cbr\\u003eExperience the full cycle of life: marriage, children, career, retirement, and beyond. Build your home, raise your kids, and pass on your family\\u0026#39;s values to the next generation. Watch your family evolve into a flourishing legacy over time!\\u003cbr\\u003e\\u003cbr\\u003e🌳 Grow Your Family Tree\\u003cbr\\u003eExpand your family across decades! Track generations as they unfold, watching how your life choices impact your descendants. Each new family member brings unique traits, talents, and dreams, making every legacy completely different.\\u003cbr\\u003e\\u003cbr\\u003e🏙️ Build Your Town and Empire\\u003cbr\\u003eTransform a humble village into a thriving town empire! Invest in businesses, upgrade your home, open new shops, and build bustling streets filled with life. Your town will grow hand in hand with your family’s story.\\u003cbr\\u003e\\u003cbr\\u003e💬 Life Choices Matter\\u003cbr\\u003eEvery decision opens a new path. Who will you marry? How will you educate your children? Will you invest in your town\\u0026#39;s future, build a peaceful farm, or chase fame and fortune? Make the right choices and leave behind a story worth telling!\\u003cbr\\u003e\\u003cbr\\u003e🧬 DNA and Inheritance Simulation\\u003cbr\\u003eExperience true family simulation by passing traits, talents, and appearances from generation to generation. Watch your children inherit skills, looks, and unique quirks, creating a rich, evolving family tree shaped by your decisions.\\u003cbr\\u003e\\u003cbr\\u003e🏆 Achievements, Events, and Surprises\\u003cbr\\u003eLife is full of unexpected moments! Celebrate marriages, honor retirements, unlock secret talents, and conquer challenges through a wide range of dynamic events and achievements.\\u003cbr\\u003e\\u003cbr\\u003e🎯 Key Features:\\u003cbr\\u003e★ Build and grow your multigenerational family legacy\\u003cbr\\u003e★ Make life choices that influence future generations\\u003cbr\\u003e★ Design and expand homes, businesses, and entire towns\\u003cbr\\u003e★ Raise children and guide them toward unique destinies\\u003cbr\\u003e★ Experience DNA inheritance and evolving family traits\\u003cbr\\u003e★ Participate in exciting events and unlock rare rewards\\u003cbr\\u003e★ Enjoy a cozy, heartwarming simulation experience\\u003cbr\\u003e★ Create your own story that spans a lifetime and beyond\\u003cbr\\u003e\\u003cbr\\u003eWhether you dream of raising a legendary family, building a town empire, or simply enjoying the journey of life, Family Go! offers you the chance to create a unique legacy full of love, dreams, and adventure.\\u003cbr\\u003e\\u003cbr\\u003e🚀 Download Family Go! today — your family\\u0026#39;s journey begins now!\"],\"KIKO FUN INTERACTIVE ENTERTAINMENT CO., LIMITED\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/MlfQB-16S5kTj6Xjb1Oi_KOl2laHz0idYt6e8TElNHZ6iCPE3RAWJnavmakenrk0IoulE5mkByySn8x2M43sPfA\"],null,[221,224,255,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.familygo.simgame\\u0026rdid\\u003dcom.familygo.simgame\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"RM 4.99 - RM 494.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null