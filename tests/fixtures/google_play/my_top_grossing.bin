ll,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/9m6H6Tr4bXgM1B4FdhRthM_gUCKDuuYdTUk8yZNfS3PPnAqx6eUsQPHuLjeohAXWXA7n9vacXOWrLIDmXKBAwQ\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/6o78IkVh12fo84rPr6NMZHrayilEzJGqLl917QujgtAutf0Wiv46rKE20YRPlq-ct_liNF_cf3RQ48oFA_8IXRM\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/6qeaoMTqX4UClvXBPN1MqIf57ZtbP6NRTxGUrl8l6r-o-ffww4EFdF-vDD2o4sOxKqyygLhUWszkaEsAiwi3Nw\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/KqDcZE9vwjkonTXrcStt_ldZ9COGFNUFeJ1CNz41s_ssmZSyDd1YDc9QwzVgU2h7oRZ9ULQKfo20qNXYuKPq_g\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/R8_iIPglWokq5HgKgB30L93Kx2vvWUtq58vZo0Yf6Rmd3Q1mSSKrNlRYF4Mna5dKQXQjH89Ea9rbq56SO64Nsw\"]]],\"Screw Project: ASMR Home\",[\"4.6\",4.55],\"Casual\",null,null,[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.casualjoygames.screwproject\\u0026rdid\\u003dcom.casualjoygames.screwproject\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.casualjoygames.screwproject\"]],[\"qgJvGm0IRkoTCKLtirHHkJcDFf2nrAIdCDQci/oBDwoNCAASCQoFZW4tVVMQALoCQQolCh9jb20uY2FzdWFsam95Z2FtZXMuc2NyZXdwcm9qZWN0EAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"Screw Project is a challenging puzzle game. Enjoy the fun of playing the screw game and challenge awesome levels in Screw Project.\\u003cbr\\u003e\\u003cbr\\u003eHow to play the game?\\u003cbr\\u003eFirst, clarify the level goals. Observe the color of the box above and click on the screws of the corresponding color until all the screws are unscrewed and collected in the box;\\u003cbr\\u003eSecondly, the game requires a certain strategy and quick reaction. When unscrewing the screws on the glass, sometimes the screws will be blocked by the glass. The glass will automatically fall under the action of gravity. You need to predict the falling trajectory of the glass in advance and quickly click on the blocked screws, to avoid the glass not falling completely and blocking the screws again;\\u003cbr\\u003eIn addition, there are many kinds of screws in the game, including star-shaped screws and screws connected by ropes. Clicking on any of them will place them in the hole. If the screw hangs all over the hole, the level fails! Some levels may have fan screws, observe carefully!\\u003cbr\\u003eDon\\u0026#39;t worry, the level has no time limit, and props are supported to assist in winning levels. Be bold and participate!\\u003cbr\\u003e\\u003cbr\\u003eIn this addictive screw game, you will find these fun features:\\u003cbr\\u003e- Amazing boosters to help you along the way;\\u003cbr\\u003e- Beautifully designed levels;\\u003cbr\\u003e- Rich and interesting activities;\\u003cbr\\u003e- Simple and relaxing screw game.\\u003cbr\\u003e\\u003cbr\\u003eScrew Project has unique gameplay, each level designed delicately, providing an exciting gaming experience, start the game journey!\"],\"Casual Joy Games\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/E1q2qDCX_naksXgQA4m2pME5-xNJturwzR-SwDejRMbuxRj1yfdGAmzBakJ8cRVUgmzfOOvlUqF4gJDh08A3oA\"],null,[242,101,220,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,[null,\"Suitable for all age groups. Some violence in a comical or fantasy context is acceptable. Bad language is not permitted.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZP