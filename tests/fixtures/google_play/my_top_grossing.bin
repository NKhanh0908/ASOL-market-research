,null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dbus.sand.fall.jam.loop.traffic.flow\"]],[\"qgJzGnEIOEoTCKLtirHHkJcDFf2nrAIdCDQci/oBDwoNCAASCQoFZW4tVVMQALoCRQopCiNidXMuc2FuZC5mYWxsLmphbS5sb29wLnRyYWZmaWMuZmxvdxABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"Jam Bus: Sandfall brings a fresh twist to bus jam, color puzzle, and traffic escape gameplay.\\u003cbr\\u003eColorful sand is stacked in layers, and every bus has its own color and direction. Tap the right bus, collect the matching sand, and clear the board step by step. Sounds simple at first, but every move can change the whole puzzle.\\u003cbr\\u003ePlan carefully before you tap. Some buses may block each other. Some paths may cross. Some sand colors can only be cleared after the lower layers are gone. To win, you need to observe the board, choose the right order, and keep every bus moving without a crash.\\u003cbr\\u003eHow to play\\u003cbr\\u003e• Tap a bus to move it along its route\\u003cbr\\u003e • Match each bus with the same color sand\\u003cbr\\u003e • Clear lower sand layers to unlock the ones above\\u003cbr\\u003e • Avoid traffic crashes when paths cross\\u003cbr\\u003e • Solve each level with smart sequencing\\u003cbr\\u003eWhy you’ll enjoy Jam Bus: Sandfall\\u003cbr\\u003e• Easy tap controls\\u003cbr\\u003e • Relaxing color-matching gameplay\\u003cbr\\u003e • Clever bus parking jam puzzles\\u003cbr\\u003e • Satisfying sand-clearing effects\\u003cbr\\u003e • Increasingly tricky routes and layers\\u003cbr\\u003e • Clean visuals and smooth puzzle flow\\u003cbr\\u003e • Great for quick breaks and brain training\\u003cbr\\u003eEvery level is a small logic challenge. A bus may look ready to move, but its route might block another vehicle. A color may be visible, but the sand below it must be cleared first. Think ahead, follow the arrows, and find the perfect order to clear the whole sandfall.\\u003cbr\\u003eIf you enjoy bus games, parking jam puzzles, color sort games, traffic escape challenges, or relaxing logic games, Jam Bus: Sandfall gives you a colorful new puzzle to solve.\\u003cbr\\u003eStart with one bus, clear one color, and let the sand fall into place.\"],\"Nova Games Technology Limited\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/Xxtz7lOU2yqCxGMmNiyNb3e-OEhEoW_TeIylWnJOAaXHSDGGAQhJSs12d5B4L6TFUPOV3-3f00S0dPXRunndNQ\"],null,[117,111,117,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Users Interact\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dbus.sand.fall.jam.loop.traffic.flow\\u0026rdid\\u003dbus.sand.fall.jam.loop.traffic.flow\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"RM 4.49 - RM 444.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.ygjszsea.google\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/fGpA_BA0VDihOh-5JTn4F-s1yqa4CS2AD0XPC