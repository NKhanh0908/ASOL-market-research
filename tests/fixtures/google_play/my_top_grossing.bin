,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/DX-3F4D2HzmBozBvzinDvgV9EjLZCut4CBadoHgPWbSkYra_G9tN7mBVF51TTy1UhfRzkUyobOQL_2NQMx92yw\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/jep5skIqh1x6zWXWxEpGnHxsnwdbCgPKVLx2IM3fx0W9N1UGuN8MB9GNBu8y26C72L-ZWOZ4RF1c1Nzlj2dn9Q\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/JnlRwXpFu_K-DklPKtmgBnYl2dIQ3YEpmN0b6Jz1ndVLgVG7zxcj1UkwJKysbUoWWku4Po0gPH2orxwKgiUjLac\"]]],\"Eggy Party: Trendy Party Game\",[\"4.2\",4.234271],\"Casual\",null,null,[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.netease.partyglobal\\u0026rdid\\u003dcom.netease.partyglobal\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.netease.partyglobal\"]],[\"qgJnGmUIGEoTCKLtirHHkJcDFf2nrAIdCDQci/oBDwoNCAASCQoFZW4tVVMQALoCOQodChdjb20ubmV0ZWFzZS5wYXJ0eWdsb2JhbBABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,\"PnM0c0mfh1E\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:PnM0c0mfh1E?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:PnM0c0mfh1E\",null,null,null,null,\"AXH1ezkjshe4eSnHWPwLzJ2y2zM76KArkPszFfztjV2Iki9pDm4e7rAVddYQrxvSotZExZyVzpk2BBODYUpPztVbXsGZILYG4St0E3C5nD2Net3-YITCH9s03fQxbbD7lhstjmXEdX9gpoa-6tFUBt5kvshnzUsO1b3XJ2Icunq1zD31on2J5qiixqv4PNa4TSND6BQwUKoO40et2QFuuwS_ZScKsnhQvvklNdcqdVQ7Udg4hBmGBodMWDfgjIaKBXvE99dFL73lzNHrxDPdeZ-0sqEB0C811nZlJuE3v8TlECrZpw\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/PnM0c0mfh1E/hqdefault.jpg\"]]]],[null,\"Welcome to Eggy Party, the ultimate party royale game where the fun never stops! Run, jump, dash, roll, and whack your way through dozens of colorful obstacle courses and arenas, either solo or with friends! Face off against hundreds of whacky challenges and prove you\\u0026#39;re the top eggy in town!\\u003cbr\\u003e\\u003cbr\\u003eACTION-PACKED CHALLENGES BY THE DOZEN!\\u003cbr\\u003eEggy Party offers a variety of action-packed challenges for players to enjoy! Test your skills in a variety of mini-games, each with its own unique twist. From racing through obstacle courses to brawling in arenas, there\\u0026#39;s something for everyone to enjoy!\\u003cbr\\u003e\\u003cbr\\u003eSUPERCHARGE YOUR EGGY!\\u003cbr\\u003eUnlock new abilities and power-ups to supercharge your eggy! Transform into an explosive powerhouse, summon lightning to strike your opponents, shoot arrows to clear obstacles, and much more! With unlockable ultimates and pickable power-ups, the possibilities are endless!\\u003cbr\\u003e\\u003cbr\\u003eTEAM UP TO CRACK YOUR WAY TO THE TOP!\\u003cbr\\u003eEverything\\u0026#39;s better with friends by your side! Team up with your friends to crack your way to the top in Eggy Party! Whether you\\u0026#39;re competing in brawling arenas or racing through obstacle courses, teamwork is the key to victory!\\u003cbr\\u003e\\u003cbr\\u003eMESS AROUND EGGY ISLAND!\\u003cbr\\u003eExplore Eggy Town between matches and discover a variety of fun activities to enjoy with your friends! Connect with friends, express yourself with emotes, and enjoy various activities like soccer and concerts!\\u003cbr\\u003e\\u003cbr\\u003eCREATE YOUR OWN FUN \\u0026amp; FAME!\\u003cbr\\u003eUnleash your creativity and become the next famous creator in Eggy Party! Use our powerful course creator to design unique courses and arenas to share with players worldwide! With new experiences hatching daily, the Eggyverse is yours to explore and create!\\u003cbr\\u003e\\u003cbr\\u003eNEW EXPERIENCES HATCHED DAILY!\\u003cbr\\u003eWith hundreds of creators making new courses every day, there\\u0026#39;s always something new to discover in Eggy Party! Whether you\\u0026#39;re racing through obstacle courses or brawling in arenas, the Eggyverse is yours to explore and conquer! Join the party and experience endless fun in Eggy Party today! Let\\u0026#39;s hatch some unforgettable memories together!\\u003cbr\\u003e\\u003cbr\\u003eLet the adventure begin -- download Eggy Party now and join the party of a lifetime!\\u003cbr\\u003e\\u003cbr\\u003eTo learn more about Eggy Party, please visit:\\u003cbr\\u003e• Official Website: https://www.eggyparty.com/\\u003cbr\\u003e• Twitter: https://twitter.com/eggypartyglobal\\u003cbr\\u003e• YouTube: https://www.youtube.com/channel/UCK0y3Dls7q62xvKyiHLvUeA\\u003cbr\\u003e• Facebook: https://www.facebook.com/EggyPartyGlobal/\\u003cbr\\u003e• Instagram: https://www.instagram.com/eggypartyglobal/\\u003cbr\\u003e• TikTok: @eggypartyglobal, @eggypartysea2023\\u003cbr\\u003e• Discord: https://discord.gg/eggyparty\"],\"Exptional Global\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/U09H4AOtiJd47M4aTZwPr_61o88XGWLT2S2qA9EjBtkQWYBt0CMDkh7CzQO6gSNAxRKxdmNiP16uE5gJ_QuoVw\"],null,[89,195,238,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Users Interact, In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.netease.partyglobal\\u0026rdid\\u003dcom.netease.partyglobal\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null