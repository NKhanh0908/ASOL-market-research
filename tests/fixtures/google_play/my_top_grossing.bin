y-lh.googleusercontent.com/5-QUUW0JBJDCJKDeQmRAp05VTjdLVKyj_XKpaaEPcMpIxa8rX2BIZDnLo2PNwVYjo79WspFJ-HyFN8V8RahcCSA\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/lWLCBOacKjAyKoFnhgRyQopXuJmfI0u0IuaTgyfovkOg8gZqDP493_nMKLOhaT8yyQcM8dLITANTrxikrOX2\"]]],\"Just Desserts: Revenge \\u0026 Merge\",[\"4.8\",4.79],\"Casual\",null,null,[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.justdesserts.global\\u0026rdid\\u003dcom.justdesserts.global\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.justdesserts.global\"]],[\"qgJnGmUIFkoTCKLtirHHkJcDFf2nrAIdCDQci/oBDwoNCAASCQoFZW4tVVMQALoCOQodChdjb20uanVzdGRlc3NlcnRzLmdsb2JhbBABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"Step into the enchanting town of Frostvale, where sweetness masks dark secrets! Join talented pastry chef Ella as she returns to her hometown to uncover the truth behind a mysterious fire. Merge desserts to restore your family’s beloved pastry shop and dig past the icing to reveal long-buried truths.\\u003cbr\\u003e\\u003cbr\\u003eMake Desserts\\u003cbr\\u003e\\u003cbr\\u003eMerge ingredients like powdered sugar and butter to whip up delicious cookies! Upgrade your recipes to unlock exquisite delights, including the elegant Swan Cake. The more you create, the more delectable treats you\\u0026#39;ll discover!\\u003cbr\\u003e\\u003cbr\\u003eRebuild the Pastry Shop\\u003cbr\\u003e\\u003cbr\\u003eTransform your family’s charred shop into a magnificent dream space! Choose vintage tiles, glowing neon signs, and exquisite furniture to design a shop that reflects your style. Each area you rebuild unveils new plot clues.\\u003cbr\\u003e\\u003cbr\\u003eReconnect with the Past\\u003cbr\\u003e\\u003cbr\\u003eReunite with Edward, your former lover. Is he your unexpected savior or an accomplice to the arson? As rivals appear, what schemes lie behind their charming smiles? Explore your mother’s mysterious recipe and the secrets of that fateful night!\\u003cbr\\u003e\\u003cbr\\u003eUncover the Truth\\u003cbr\\u003e\\u003cbr\\u003eGather clues from the night of the fire through decorating and merging! Piece together charred photographs, shattered ledgers, and cryptic notes. Can you unravel the family secret that someone is desperate to keep hidden?\\u003cbr\\u003e\\u003cbr\\u003eWarning: In this small town, the sweetest smiles often hide the deadliest lies.\"],\"Century Games Innovation Pte. Ltd.\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/LrS9usanUwoVuvA4gHc-r2VRH5UWJfy7g0O2k6eTnnBKk-Ti5xHnzGZlwFUPNjYAXC-wFTuP1i1B3CYD7skCojg\"],null,[141,110,114,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,[null,\"Suitable for all age groups. Some violence in a comical or fantasy context is acceptable. Bad language is not permitted.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.justdesserts.global\\u0026rdid\\u003dcom.justdesserts.global\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"RM 4.90 - 