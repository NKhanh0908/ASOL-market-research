content.com/uJWsiM9NML_zyyZZPy16bAVGXu7U1_C6lk8ft5XNp9nYaqEivairGs62QJLqi1a1eF4ee-ZQySRrutj31gHfuKA\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/1Xa07VvPPTQnq-T4lOQSbTfvsEe4FS0hHZgYBvihs5so3kY2ASS0G-fHWTsUagup37MLV0A5YZ4qEapwY6lI\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/yIvKBpE291Ejv1Z3kZqtBy_fuNEpBYhbNp030jKtLDVyjsxwo3Dl8AvwdMG9TsU1B7zxTK2YQZCpjUrhMlhEXA\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/AJFo2ZH4a6owCB-1WRTPQNIGpC32sL_r7ymaQ_E7XDj89fAndxEeM3DBnmhhii7HiMWD0LC3SrkNg2LraeKYTLE\"]]],\"新武俠大明星-《牧神記》聯動\",[\"4.2\",4.2491803],\"Casual\",null,null,[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.wxdmxtw.android\\u0026rdid\\u003dcom.wxdmxtw.android\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.wxdmxtw.android\"]],[\"qgJjGmEICUoTCKLtirHHkJcDFf2nrAIdCDQci/oBDwoNCAASCQoFZW4tVVMQAboCNQoZChNjb20ud3hkbXh0dy5hbmRyb2lkEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"《新武俠大明星》×《牧神記》聯動正式開啟！\\u003cbr\\u003e秦牧等人氣角色破界而來，熟悉夥伴齊聚全新戰場！ \\u003cbr\\u003e聯動限定角色、專屬內容與驚喜福利同步登場，集結牧神群英、迎戰強敵，在一路冒險與成長中突破極限，開啟屬於你的全新牧神之旅！\\u003cbr\\u003e\\u003cbr\\u003e【牧神群英 破界登場】\\u003cbr\\u003e《牧神記》人氣角色跨界而來！秦牧等熟悉身影加入戰局，與你並肩迎敵，共赴全新征途！\\u003cbr\\u003e【肉鴿割草 武功退強敵】\\u003cbr\\u003e百種功法，無盡肉鴿，戰鬥中習得超強功法，越玩越爽！\\u003cbr\\u003e【割草放置 爽快升級】\\u003cbr\\u003e 放置戰鬥、無限割草！爽快割草依舊，無腦養成、輕鬆升星，無論新手老手都能暢快遊玩！\\u003cbr\\u003e【無腦養成 解放雙手】\\u003cbr\\u003e養成簡單，無需動腦！通關升星，強化省心！非酋也能獨步武林。\\u003cbr\\u003e【百變副本 戰略至上】\\u003cbr\\u003e百種副本，久爽不膩！新增全新文字塔防玩法！組合文字召出名將，靈活排兵佈陣，以巧破敵！\\u003cbr\\u003e【狂抽猛送 明星集结】\\u003cbr\\u003e猛送1045抽，欧皇当道！群英齊聚，驚喜不斷！组建最强明星阵容。\\u003cbr\\u003e\\u003cbr\\u003e※ 本軟體因涉及暴力，依遊戲軟體分級管理辦法分類為輔12級。\\u003cbr\\u003e※ 本遊戲為免費使用，遊戲內另提供購買虛擬遊戲幣、物品等付費服務。\\u003cbr\\u003e※ 長時間進行遊戲，請註意使用時間，避免沈迷於遊戲。\\u003cbr\\u003e代理商資訊：喬葳數位行銷有限公司\\u003cbr\\u003e\\u003cbr\\u003e如果您在遊戲中遇到任何問題，歡迎隨時與我們溝通：kungfustarservice@gmail.com\\u003cbr\\u003e新武俠大明星-Facebook:https://www.facebook.com/KungfuStarTW\"],\"CloudOceanStar\",\"100,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/BBKs46snBI5vtGa4OmdGxltN3FrAqOAcSLlfEVmZW3B4XaKsBUGsdXxZD4drlJw3PC-laHxS1dYQOnhlSn8eSA\"],null,[52,49,58,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Users Interact, In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.wxdmxtw.android\\u0026rdid\\u003dcom.wxdmxtw.android\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"RM 2.49 - RM 479.90 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.funtomic.matchmasters\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/UZhXVbf8ViUq04c7ncQuR3CPf7GC4Y6c6gBU0OuepjrK_QUDlY-oIL03nEBCQdEm_EbaDx8cL4xDxRqWR70rgA\"],null,[203,249,246,255],null,null,nul