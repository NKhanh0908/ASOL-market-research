2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/-87BgY4rBz7ChSl-744QWPZdC6dfee7mTTfZdgV2qH7zq0mhSJPBtp3cY4M2obOF0miwk-KzfqD15VAYNULLHg\"]],[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/XeBK5mhNgZr8N3L5-S8YHt8qr81-gkqU7DkqYaMuDlI3LoowK_RQPROz_BU-zHLj4V-GCVzPx3souBg17DCmM30\"]],[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/D6wv70sIklLR_9FvENX31e65R8tnjLpkGKeBlPIPGZ2baMewcGzGqLZukHNZnydP3ejHLang2eYx6-z2DBMHzak\"]]],\"Homescapes\",[\"4.8\",4.757196],\"Casual\",null,null,[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.playrix.homescapes\\u0026rdid\\u003dcom.playrix.homescapes\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.playrix.homescapes\"]],[\"qgJmGmQIBEoTCKLtirHHkJcDFf2nrAIdCDQci/oBDwoNCAASCQoFZW4tVVMQALoCOAocChZjb20ucGxheXJpeC5ob21lc2NhcGVzEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],[[[null,null,\"DsW6r-_gRdY\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:DsW6r-_gRdY?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:DsW6r-_gRdY\",null,null,null,null,\"AXH1ezlo1NWnlexRGfFwTUuPqjfcqHtmXlpGFHAuYdUJfne-BkD60JGsaVMumn-9bALbXKRKEqzW7PUJrQ9v2bw4f7cdX2Ji-yA6Yw6tNDAS25vFcfYoNhURs9WFkvTxqBFVFN0DPg-Ofy27dTYwNzEuUnysCebajPvdPZMR1yMrnbrn0_MxTCVADSZDzg9YBL-eb8FpRtwziYNaJWoqjMjMcfPI07m6aLLDl8OlNfUjXjSPxNj3wSstIw2__9JFwObszl4jaRZ3MNuJ6l1nCoYk2gFJmyuNy3WXsDlayITl1vyusw\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/DsW6r-_gRdY/hqdefault.jpg\"]]]],[null,\"Welcome to Homescapes, a warm and cozy game from the famous Playrix Scapes™ series! Make match-3 combinations and turn every corner of your home into an inviting place to relax and have fun.\\u003cbr\\u003e\\u003cbr\\u003eSolve puzzles, restore the interior room by room, and meet new friends in every chapter of the exciting storyline. Austin the butler is ready to welcome you to a world of incredible adventures!\\u003cbr\\u003e\\u003cbr\\u003eGame features:\\u003cbr\\u003e● Original gameplay: make match-3 combinations and decorate your house while enjoying an exciting story!\\u003cbr\\u003e● Thousands of captivating levels with explosive power-ups, useful boosters, and cool elements.\\u003cbr\\u003e● Exciting events: embark on fascinating expeditions, compete against other players in different challenges, and win awesome prizes!\\u003cbr\\u003e● Unique rooms with original designs: from Austin\\u0026#39;s bedroom to a greenhouse.\\u003cbr\\u003e● Loads of fun characters: meet Austin\\u0026#39;s friends and your neighbors!\\u003cbr\\u003e● Adorable pets that will become your faithful companions!\\u003cbr\\u003e\\u003cbr\\u003ePlay with your Facebook friends, or make new friends in the game community!\\u003cbr\\u003e\\u003cbr\\u003eHomescapes is free to play, but some in-game elements (including randomized items) can be purchased for real money.\\u003cbr\\u003e\\u003cbr\\u003eA Wi-Fi or internet connection is not required to play.\\u003cbr\\u003e *An internet connection is required to access competitions and additional features.\\u003cbr\\u003e\\u003cbr\\u003eDo you like Homescapes? Follow us on social media!\\u003cbr\\u003ehttps://www.facebook.com/homescapes\\u003cbr\\u003ehttps://www.instagram.com/homescapes_mobile/\\u003cbr\\u003e\\u003cbr\\u003eNeed to report an issue or ask a question? Contact Player Support through the game by going to Settings \\u0026gt; Help and Support. If you can\\u0026#39;t access the game, use the web chat by clicking the chat icon in the lower right corner of our website: https://playrix.helpshift.com/hc/en/14-homescapes/\\u003cbr\\u003e\\u003cbr\\u003ePrivacy Policy: https://playrix.com/privacy/index.html\\u003cbr\\u003eTerms of Use: https://playrix.com/terms/index.html\"],\"Playrix\",\"500,000,000+\",null,\"\",null,null,nul