GEjSPiHa52h1JJWktYtff-bVeAY9U-UF9o_GKywDsKphjNt10-Nxk1KOArzE4EZ0jEb\"]],[null,2,[2048,1280],[null,null,\"https://play-lh.googleusercontent.com/iwpuIZ6z4wu2zw-V3V5FwmQ3V_vFKXRv61EIDT69UxkYok7egS2cBDYW291bPu4AGusdaQVHchi8X7oL40ljsQ\"]],[null,2,[2048,1280],[null,null,\"https://play-lh.googleusercontent.com/3E-jtB-qnzn4Nw9QBa-rjXtXEEXkAoXTVg30xRyMhy7p-ntwaChNkQPsMU2ROTY41RAnALAR8C178JXy5md_dA\"]],[null,2,[2048,1280],[null,null,\"https://play-lh.googleusercontent.com/Vb2heLeYl_vd-Cu5NeIEl6zgf9huKpxm8nhSZZdomcZjv_uozv77e0jbgXJfNyCoYBG3ogIzk_CFxHJTQIdq8Sk\"]],[null,2,[2028,1280],[null,null,\"https://play-lh.googleusercontent.com/hFTwETm_2OLR-XyWgGeD390Wsf8IG49zfZ6zNrj8yaUHUWYroPPNobAxcJPAAnFDz_y3cuazi6JjppDR0pgA3Gs\"]],[null,2,[2028,1280],[null,null,\"https://play-lh.googleusercontent.com/yTWaLuVgHiXrwlQwVTm7tmSAoE7D1SlN_PrU_OD6eCgy-T2DtYjBcqzCPtKHq7FNtV5VsQRe7UXrSIDU3a8urW4\"]],[null,2,[2028,1280],[null,null,\"https://play-lh.googleusercontent.com/3AiUE7X64QX10VFpeGxbfrXQ4oaTD65jS_RRTj-ezzrx8L7hzhS6h8-upM2aNX9vMuVttFSLbEBJJR59wdZTaA\"]],[null,2,[2028,1280],[null,null,\"https://play-lh.googleusercontent.com/Utfwb6TG4L27cOZOptOcmI-0VoZ7o4h-P4C9MIaDFncarQT2jpGM9b5MgDevTXQ_a0QweYX9q488I1yY9PsGmw\"]]],\"Farm Heroes Saga\",[\"4.7\",4.6666665],\"Casual\",null,null,[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.king.farmheroessaga\\u0026rdid\\u003dcom.king.farmheroessaga\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.king.farmheroessaga\"]],[\"qgJnGmUIFUoTCKLtirHHkJcDFf2nrAIdCDQci/oBDwoNCAASCQoFZW4tVVMQALoCOQodChdjb20ua2luZy5mYXJtaGVyb2Vzc2FnYRABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,\"3YEUylysADQ\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:3YEUylysADQ?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:3YEUylysADQ\",null,null,null,null,\"AXH1ezlvQ8VhbakgrzZN7m3ILRwI9NlASOOeJBqOUyofAhLHdaa-rQYLN4_DMmVsWpb5OV3p2KFXWb6XJJRg4lzVB8jRePel53OwEA8PAWB1WpI-j1KkZXCuhqv3Z9pS843YdLVBdacHIuTQr_EWVojSzN2myVo3btK1UU6pFM0Ac65UjZ3riXvZaJ11AtxHibWBuCOYRHyArsP2AldDkEt0vd1dS-c1nGfs301_OxZCRHGxUIkpEfiq8IwJEQGGSLA75Q8duE01H6KtVLmmHtfDcxxJwuwCdAn62VxczdL1I5JwVA\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/3YEUylysADQ/hqdefault.jpg\"]]]],[null,\"Farm Heroes Saga, from the makers of Candy Crush Saga, Pet Rescue Saga, and Bubble Witch 3 Saga!\\u003cbr\\u003e\\u003cbr\\u003eFarming has never been so fun! Jump into a farmtastic adventure: match and collect the cute Cropsies across the farm to solve the match 3 puzzles! Go from puzzle to puzzle, matching fruit and plants, and level up to save the farm from Rancid the Raccoon. Join forces with the Farm Heroes to swap, match, and collect Cropsies. Ready to defend the Farm Lands?\\u003cbr\\u003e\\u003cbr\\u003eEnjoy the amazing farm and match 3 puzzle game from King! Match 3 or more Cropsies in a variety of game modes and puzzles. Unlock animals and blast boosters as you solve the different match 3 puzzles.\\u003cbr\\u003e\\u003cbr\\u003eExplore 1000’s of Levels\\u003cbr\\u003eAcres of luscious levels and puzzles await you! Every two weeks, discover new puzzles, for a match 3 game in constant evolution!\\u003cbr\\u003e\\u003cbr\\u003eHero Mode\\u003cbr\\u003eTime for a blast! Match as many Cropsies as you can before running out of moves. The higher the score, the more Magic Beans you gain to help you win the puzzle game.\\u003cbr\\u003e\\u003cbr\\u003eRancid Boss Battles\\u003cbr\\u003eDefend your farm! Solve challenging matching puzzles and, with the help of the farm animals, keep the thief away from your fruit and plants. \\u003cbr\\u003e\\u003cbr\\u003eJoin the Farm Club\\u003cbr\\u003eRecruit cute animals to help you solve puzzles! When matching is not enough anymore, call your animal friends to the rescue and blast powerful boosters to win the game.\\u003cbr\\u003e\\u003cbr\\u003ePlay with friends…\\u003cbr\\u003eTeam up with your friends to enhance your farming experience: chat, play with them and participate in events unique to Farm Teams. Who said the farming adventure had to be lonely?\\u003cbr\\u003e\\u003cbr\\u003e…or compete with friends!\\u003cbr\\u003eYou think your farm is the best? The game is on! Compete in the leaderboard or in the Tractor Dash event to prove you’re the best at match 3 puzzle games.\\u003cbr\\u003e\\u003cbr\\u003eStart matching and farming Cropsies today! But most importantly, have fun playing Farm Heroes Saga!\\u003cbr\\u003e\\u003cbr\\u003eVisit https://community.king.com/en or contact us in game by going to Settings \\u0026gt; Customer Care if you need help!\\u003cbr\\u003e\\u003cbr\\u003eFarm Heroes Saga is free to play but optional in-game items such as extra moves or lives require payment. You can turn off the payment feature by disabling in-app purchases in your device’s settings.\\u003cbr\\u003e\\u003cbr\\u003eBy downloading Farm Heroes Saga you agree to our terms of service which can be found at https://king.com/termsAndConditions\\u003cbr\\u003e\\u003cbr\\u003eDo not sell my data: King shares your personal information with advertising partners to personalize ads. Learn more at https://king.com/privacyPolicy. If you wish to exercise your Do Not Sell My Data rights, you can do so by contacting us via the in-game help center or by going to https://soporto.king.com/contact\"],\"King\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/j3czn91O4kwAk1Kto5AR3DhiwaZxEDhta3AeTz212FR44sBGFl57zYIoA2x-TVMLueE8mISALGq__AZ7EzyGQM0\"],null,[180,238,233,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Users Interact, Shares Info, Digital Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.king.farmheroessaga\\u0026rdid\\u003dcom.king.farmheroessaga\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"RM 3.90 - RM 1,149.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.justdesserts.global\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/q_KROSDAhT4UgCR7Y11CqDdIAg2A1m8GTJTo2sPJnobwDZuRyC_Gvyyx71nreHPaH5WrxM4PwZ3lTsCYhuw\"],null,[253,181,140,255],null,null,null,2],[[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/EGYmPvqtE5NDL0-3JyoKy7_UkAtbsIW3Ssc0Ey0qbvCDNHngvoYtsVNXhU-REou-vtXo5sIg1pgv3n7QrvlbeQ\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/pogJKyFCG_rWjiXuP9_h7kQVPWBjerZ-3EyXEpDyOZtNN1Ie6SdiReXCsumqat5ly6igm2pQPAJzWAhMdqyJgw\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/m8aixjG3mmKPGnDVasGu0e9nfjQnPI5xHOLfFh3rc0hwACbEQAuUGkvQ-WjQjNDWHjS1wHpZ69-6EKONKUub\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/Q77EBCHOCKUDFpy_l_AT4nf4CKJSxsIGIkIsQ6XPjEs7iBxKRV69tR95HaoLgU2ekdTeOvS5p