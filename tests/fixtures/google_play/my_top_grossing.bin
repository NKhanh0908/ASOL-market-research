lPMrHA\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/lnmto8QsxNOOtPxOPqVV3tqOP36DSfiEPwSxP6sBr_u0Gg5Uf37PD_o30_X9fHBFuuldDQAYcabwwTPkaO16bNs\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/ZfCPFjQKDfcaNWbkBElvwdGVY_EjNOC8TexERdxzb2LKKYY1q7gyc-DEiJW-PRJorpk2g-_t6c1H7Nn03PABDQ4\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/F9T2Xs6WXC78LtUFFVX7HCldAByHn89kvzuVJz4qi3Pqtv2SXB6KRtqmewaBD-TNEMdBa-pHXq37qramlG5h7Q\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/iMmmY9iZfbyQn6B_Lmcwr5xXIn2vU-LZuPkHht2x_PdsfWWcZHpVumyqxpXfZzvFt997sy5uC96r8FtpyU4V\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/PnslFqR-jW5MRxjIAoJ_sTfX2YdtYA-6omBbWr6YYSpvz0JJ_CbLNnFcIIv0G78cnwcqqqEPTEGl_SoolPMrHA\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/lnmto8QsxNOOtPxOPqVV3tqOP36DSfiEPwSxP6sBr_u0Gg5Uf37PD_o30_X9fHBFuuldDQAYcabwwTPkaO16bNs\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/ZfCPFjQKDfcaNWbkBElvwdGVY_EjNOC8TexERdxzb2LKKYY1q7gyc-DEiJW-PRJorpk2g-_t6c1H7Nn03PABDQ4\"]]],\"DDTank Origin\",[\"2.8\",2.8],\"Casual\",null,null,[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dvnggames.ddtank.origin.twhk.my\\u0026rdid\\u003dvnggames.ddtank.origin.twhk.my\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dvnggames.ddtank.origin.twhk.my\"]],[\"qgJuGmwIHEoTCKLtirHHkJcDFf2nrAIdCDQci/oBDwoNCAASCQoFZW4tVVMQALoCQAokCh52bmdnYW1lcy5kZHRhbmsub3JpZ2luLnR3aGsubXkQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],[[[null,null,\"Fu-4zIbklR8\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:Fu-4zIbklR8?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:Fu-4zIbklR8\",null,null,null,null,\"AXH1eznv0HBo-dWnLe8JgQyj4GIE2EJ8-IjUGg4u49qviZMGUpUS0lu2K3JuS8HHsW0p07DywJbSy-WAMX6tIUXPSiYRdAO881CbkoZsx-rycYIjaYAkLyEbffnkQ54FUNGnb0kaVS6Z_JH7rtZWkxdz_IthzqpDUzIACSqG0eVrJDCCvxkfXIB0Tnh3eDsIm1VpuLXX4a_tHcnRRg1YTHJTKCaiCrKSgeWi1gE45sTJf4fByJpXMXsVdZRqJCwWdM1bN17X_Uk9VeQA0b0z_VkR1gAEbaQvHl5h8nuMYhITggiWYg\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/Fu-4zIbklR8/hqdefault.jpg\"]]]],[null,\"DDTank Origin is remodified by the original top-rated and renowned game developer, 7 Road and published by VNG Games, based on the classic 13-year gameplay of the web version of DDTank.  \\u003cbr\\u003e\\u003cbr\\u003eWith the current mobile version, the game has been enhanced and optimized in all aspects to fit the mobile gaming experience. Not only adapting colorful and cute 2D graphics, it’s also featured with a series of new gameplays and protocols such as real-time competitions, PK battles as well as various categories of group instances. \\u003cbr\\u003e\\u003cbr\\u003eThe mobile gameplay version mainly emphasizes personal judgment on a ballistic physical trajectory, teamwork, and the display of eye-catching fashion Day by Day. The brisk combat rhythm and the lively screen create a friendly, casual, and competitive environment for users that is highly social-friendly, bringing a new level of personalized gaming experience.  \\u003cbr\\u003e\\u003cbr\\u003e***KEY FEATURES*** \\u003cbr\\u003e\\u003cbr\\u003e[Localized Elements] \\u003cbr\\u003eNew local elements such as Kuala Lumpur map, KL Tower map, Roti Canai weapon \\u0026amp; localized characters that give you brand-new, exclusive, adventurous, and delightful experience.  \\u003cbr\\u003e\\u003cbr\\u003e[Combination of joyful strategies] \\u003cbr\\u003ePersonalize your gameplay with a variety of weapons, multiple pets, props to battle against opponents strategically - giving them a shock of their life!  \\u003cbr\\u003e\\u003cbr\\u003e[Revival of the Classic Battle Strategy] \\u003cbr\\u003eFace the battlefield or flee? Determine your own strategy! Destroy the enemy and be ready for an onslaught. \\u003cbr\\u003e\\u003cbr\\u003e[Multiplayer Cross-World Contest] \\u003cbr\\u003eGang up with your friend and protect your crown in the ultimate battle cross-servers!  \\u003cbr\\u003e\\u003cbr\\u003e[Trending Fashion \\u0026amp; Personalized Accessories]  \\u003cbr\\u003eA variety of trendy styles awaits you. Mix and match your very own combination and be the uprising trendsetter! \\u003cbr\\u003e\\u003cbr\\u003e[Multi Social System] \\u003cbr\\u003eBattle side by side with your friends to clear the dungeons. Get married to your crush and fight against the world. Join or create a guild and build up your very own family! You will never be alone in this! \\u003cbr\\u003e\\u003cbr\\u003ePERMISSION \\u003cbr\\u003e- READ_EXTERNAL_STORAGE: Read Images  \\u003cbr\\u003e- WRITE_EXTERNAL_STORAGE: Save Images \\u003cbr\\u003e- CAMERA: Assist in taking images \\u003cbr\\u003e- RECORD_AUDIO: Assist in voice chat \\u003cbr\\u003e- MOUNT_UNMOUNT_FILESYSTEMS: uninstall and install file permissions\"],\"VNG SINGAPORE PTE. LTD.\",\"100,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/BJorxFarbT_MsMVG2vFryWUpkSYgizYP6kr024YCQNj8ePcVyEVPyyjTFjPQBhj2Sg8wljffedoxCsO6EaivEg\"],null,[234,232,226,255]],null,[\"Rated for 12+\",[null,2,[366,512],[null,null,\"https://play-lh.googleusercontent.com/yQChfa9XKlaXMIYTk8w8QwChjT8_SH-_2d2SS-kesw0TLQK1nxtw54bDcoZ09freZJgKrtg4f__is-31Vg\"]],[null,\"Moderate Violence\"],[null,\"Users Interact, In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/YrkR-GP7OKghBTATCoO_jJrchSVrh-NSUBb5DnbRZC1DbLK_cgV9FC2e_iI4GzLsKXuZjuFZajnGCiA8qA\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dapp