ll,\"https://play-lh.googleusercontent.com/woE-cJYV1etf7FOK1fJkODVIybWSJFhJZkcrHLU69QcRzE_E8QOXO6yad3zEltj1eDpGPYa-zgMajBBRi3wDQN0\"]],[null,2,[2048,2732],[null,null,\"https://play-lh.googleusercontent.com/QvgR8KDTCyDRxoPI_zLpzHk52lPlH28h_I3ifyZzmMcjxNLjW8zr253koWf6oywoLiB392ELpczDE-L17WWhvw\"]],[null,2,[2048,2732],[null,null,\"https://play-lh.googleusercontent.com/ohGbSzyft4UEPLLDZXR-ZVh1OdDuoa6HuKaau2sYpq86e-nXty_cZwu-Yfj52RIWx5Ncq74N7tjOaF0GjIymsGU\"]]],\"Happy Fish\",[\"4.6\",4.596685],\"Casual\",null,null,[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.happyelements.happyfishml\\u0026rdid\\u003dcom.happyelements.happyfishml\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.happyelements.happyfishml\"]],[\"qgJtGmsITEoTCKLtirHHkJcDFf2nrAIdCDQci/oBDwoNCAASCQoFZW4tVVMQALoCPwojCh1jb20uaGFwcHllbGVtZW50cy5oYXBweWZpc2htbBABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"《Happy Fish》 The most popular and loving fish game! It has been installed over 100 million times worldwide.\\u003cbr\\u003e【More than 3000 kinds of fishes】\\u003cbr\\u003eMore than 3000 kinds of fishes with remarkable personalities for you to choose. Cutie, Funky, Sweety, Geek, and so on..., no matter what their personalities are, you can have them all! \\u003cbr\\u003e【Easy and Relaxing】\\u003cbr\\u003eFeed the fish, play with them, and trigger unexpected motion effects with only one touch!  You can also get variety of treasures form your fish. Let the fish comfort you anytime and anywhere.\\u003cbr\\u003e【Beautiful Backgrounds】\\u003cbr\\u003eFarmland, desert, outerspace, ocean, four seasons...and so on... There are a variety of backgrounds for you to choose. What\\u0026#39;s even better is that each background has its own music!\\u003cbr\\u003e【Activities \\u0026amp; Suprises Every Day】\\u003cbr\\u003eRegularly updated with different activities and new fish. Experience loads of fun in  one game！\\u003cbr\\u003e【Exciting Mini games】\\u003cbr\\u003eDr. Octopus, Gold、Golden Dolphin、Big Crab、Sea Otter、Deep Sea... etc. Let the pets bring joy to your fish bowl.\\u003cbr\\u003e【Make Friends While Raising Fish】\\u003cbr\\u003eVisit your friends and maybe trick them a little bit, or you can feed their fish, pick up their fish\\u0026#39;s gems, and leave them messages...etc. Let\\u0026#39;s experience all the fun with your friends!\\u003cbr\\u003e【Copyright Notice】\\u003cbr\\u003eAll content in this game is the property of Happy Elements, and is protected by international copyright laws.\"],\"Eureka Creation Limited\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/CC0gNl6muofKdau-oYoOaPa9H8GhA5nb1jbVaa8cLwTzXseNYZI0VxXBlddn1LS7fGhsCvuNhH8fsD7uub6N\"],null,[25,123,196,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Users Interact, Digital Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.happyelements.happyfishml\\u0026rdid\\u003dcom.happyelements.happyfishml\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2]