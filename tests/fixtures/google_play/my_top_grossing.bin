,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.babystone.heroheroclicker\"]],[\"qgJtGmsIT0oTCKLtirHHkJcDFf2nrAIdCDQci/oBDwoNCAASCQoFZW4tVVMQALoCPwojCh1jb20uYmFieXN0b25lLmhlcm9oZXJvY2xpY2tlchABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,\"X2U3_rIpxlk\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:X2U3_rIpxlk?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:X2U3_rIpxlk\",null,null,null,null,\"AXH1ezlHAdu2D1HEFjUd646WURX8PBYM4ZIgldARBUL2GTiIZS1vF-7GCLMGFN3sCEfb4Oh2NBpvyc3bd_p7dXseKDsiupR21GFk9SBib9KTifSu9g4lGHoH7tHukLOT2HeOJgl-aPseQuUiTmoqranaGmkqJqsqnNi94v2uUzLv9-hKxAWMKK6cIwL0jucoLQc8RxhAk2ss75AjTIWIJK6Ha0Pv3F4IJKaxHA_sfAuv1ij8JOT9XpB0TEUp-QMfBdHo2lXmcocuNDk1x6B6JKFaixh22cOi-kKWw1RzVdYzJ1twbw\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/X2U3_rIpxlk/hqdefault.jpg\"]]]],[null,\"Gather lepers, madmen, and dwarves! Build your army of heroes to save the Kingdom and bring the elf to your home.\\u003cbr\\u003e\\u003cbr\\u003e■ BECOME A HERO\\u003cbr\\u003eTrain and evolve your own character to defeat Bosses. There are over 100 armors, weapons, and hairstyles to customize and unlock.\\u003cbr\\u003e\\u003cbr\\u003e■ MINE AND HUNT RUBIES\\u003cbr\\u003eExpand and evolve your production lines with sweaty dwarves, corrupt guards, and gambling-addicted drunks. Every bit of help counts.\\u003cbr\\u003e\\u003cbr\\u003e■ OVER 70 HEROES AND EVOLUTIONS\\u003cbr\\u003eOpen chests to summon heroes of various ranks: Normal, Rare, Super Rare, and Ultra Rare. If you\\u0026#39;re lucky, maybe a Legendary hero?\\u003cbr\\u003e\\u003cbr\\u003e■ 3000+ UPGRADES\\u003cbr\\u003eCollect more than 3000 upgrades, turning heroes from humble beginnings into living legends.\\u003cbr\\u003e\\u003cbr\\u003e■ BATTLE YOUR WAY TO THE TOP\\u003cbr\\u003eFight for glory and face off against the world\\u0026#39;s best players to be number one.\\u003cbr\\u003e\\u003cbr\\u003e■ SEASONAL EVENTS\\u003cbr\\u003eWitness the rise of new Gods, unlock exclusive items, relics and mounts.\\u003cbr\\u003e\\u003cbr\\u003e■ FANTASY WORLD\\u003cbr\\u003eA fantasy medieval world filled with diverse heroes and enemies. Featuring a unique artistic style and creations that go beyond imagination.\\u003cbr\\u003e\\u003cbr\\u003e■ EPIC STORY\\u003cbr\\u003eDive into an engaging storyline that unfolds as you progress. Each character and enemy has their own background, creating a rich narrative that adds depth to the adventure.\\u003cbr\\u003e\\u003cbr\\u003e■ PVP RANKING\\u003cbr\\u003eForge your legacy into epic duels against the most powerful adversaries to collect delicious pieces of meat. Get drunk and prove your worth to conquer a place of honor in the Hall of Fame.\\u003cbr\\u003e\\u003cbr\\u003e■ HERO TOURNAMENT\\u003cbr\\u003eOnly the best heroes can fight in the Hero Tournament. Survive the Qualifiers, advance through the Group Stage, and battle in live Knockout rounds for exclusive rewards and eternal glory.\\u003cbr\\u003e\\u003cbr\\u003e■ PUZZLES AND MYSTERIES\\u003cbr\\u003eThe Kingdom is filled with hidden secrets and mysterious riddles. Discover them to unlock legendary weapons, rare items, and powerful armors reserved for the most dedicated players.\\u003cbr\\u003e\\u003cbr\\u003e■ 7 TOWERS\\u003cbr\\u003eChallenge the 7 Towers of the Vast Lord, climb higher with every battle, and collect powerful equipment drops to strengthen your heroes. The higher you climb, the greater the rewards.\\u003cbr\\u003e\\u003cbr\\u003e■ MOUNTS\\u003cbr\\u003eRide a wide variety of mounts that help you advance faster through the Kingdom. From pigs and giant living stones to ancient flying dragons, each mount brings more speed, power, and style to your journey.\\u003cbr\\u003e\\u003cbr\\u003e■ SECRET EVOLUTIONS\\u003cbr\\u003eAlmost everything in the game can evolve. Upgrade buildings, evolve heroes, strengthen pets, and unlock surprising new forms. Every evolution brings a new discovery.\\u003cbr\\u003e\\u003cbr\\u003e■ 70+ PETS\\u003cbr\\u003eCollect over 70 pets with different rarities, from Common to Divine/Demoniac. Discover ultra-secret Primordial pets, and many others. Each pet has a unique secret ability.\\u003cbr\\u003e\\u003cbr\\u003e■ FORBIDDEN FRUITS\\u003cbr\\u003eAwaken hidden powers you never imagined you had. Unlock rare special abilities such as becoming a giant, using domain expansion, slicing enemies with rapid cuts, and much more. These powers are exclusive and extremely rare, making each player’s journey feel unique.\\u003cbr\\u003e\\u003cbr\\u003e■ STRATEGY AND BUILDS\\u003cbr\\u003eThis is not just a simple idle game. You need strategy to progress and defeat your enemies. Create different builds by combining pets, special abilities, pet skills, mounts, and equipment to become stronger in your own way.\\u003cbr\\u003e\\u003cbr\\u003e■ ANTI-CHEAT SYSTEM\\u003cbr\\u003eA robust anti-cheat system that bans malicious players and helps keep the game fair. Hero Hero Clicker is a competitive game, so security and fair play are top priorities.\\u003cbr\\u003e\\u003cbr\\u003e■ WORLD BOSS\\u003cbr\\u003eFight alongside your friends against weekly World Bosses and earn exclusive rewards. The greatest heroes will have their portraits displayed across the Kingdom, earning special privileges from the King and Queen.\\u003cbr\\u003e\\u003cbr\\u003e◈◈◈ Download this idle / incremental / rpg / clicker game now and become a legendary hero! ◈◈◈\\u003cbr\\u003e\\u003cbr\\u003eI have many plans for updates! Get in touch and let me know what you\\u0026#39;d like to see. Love you all heroes. Henrique Faitta (the developer)\\u003cbr\\u003e\\u003cbr\\u003eContact us:\\u003cbr\\u003ewww.babystonestudios.com\\u003cbr\\u003e\\u003cbr\\u003eSupported languages: English, Portuguese, Spanish, Korean, German, and Russian\"],\"Baby Stone Studios\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/ndjUeo6OqNmXPSBYfow46LCQz9s9J515mCZ_zPFnb2B-Gu623rZTg8Rc_qh3hIiJ1XxfHqGzcZJOyjOMukeOpQ\"],null,[80,127,141,255]],null,[\"Rated for 12+\",[null,2,[366,512],[null,null,\"https://play-lh.googleusercontent.com/yQChfa9XKlaXMIYTk8w8QwChjT8_SH-_2d2SS-kesw0TLQK1nxtw54bDcoZ09freZJgKrtg4f__is-31Vg\"]],[null,\"Sexual Innuendo\"],null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/YrkR-GP7OKghBTATCoO_jJrchSVrh-NSUBb5DnbRZC1DbLK_cgV9FC2e_iI4GzLsKXuZjuFZajnGCiA8qA\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.babystone.heroheroclicker\\u0026rdid\\u003dcom.babystone.heroheroclicker\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"RM 0.99 - RM 334.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.crowdstar.covetfashion\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/i2D9lPSfMUtwe_LSsevBpelo0twtty5ihw9KNUIDSKEkKyB1i7zgbLQpD3Rd4c4T5z5CrdpSYx_IQtR309tM0A\"],null,[119,77,57,255],null,null,null,2],[[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/AuoU5JspRnrIe783L4K1X_Gw4my2hWB0-s1g5V14jg6o6O3HJUAn4ROkCv6EYJOvShRJCo-w9aTdxOKQnHGO\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/PWR8du1ggYKJVLqOIAOL48cS2i9z0k4UzH9ot78iWpOe