,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/uDANb9sNwuFGn5fgk1Px2M8bETlf0HELSano0Mprui_pnDKzR2ymbz9kDSBugWX8tWM0JVqjFly90O3q6qzJgw\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/6mLgwmZuuvj4B8UER8_leNXxIL5wDZE-K1Z3fIAmS5cdV1DmXdIiqQwfLTA9e50Xi3flKuSkVfDrVOlGGf6hNO0\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/CUk0z2vfzGtRtBwsqTInRbz16phpwQ8Yf9Q2--w8qreBo9t-mDlbWPUTl_dK5kuY-h7doE3MaNLuH-P6NatFsg\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/HHtm7hskphTUBV9qvsEnTmH8zYddFsDmEEi8gRX1hHXgv0ZmxlzXDLMim5kOY6EFWNByd0qtPwUlSTRzMvBbNw\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/B2AnAA5RZyeQIw_t_N8o7EQMBtIfbMaPPKidiJdyzsiOpDMOXm4h0VtKbWpb3IZDDeqbCEKyqDv2Abkcuqa9Rg\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/uDANb9sNwuFGn5fgk1Px2M8bETlf0HELSano0Mprui_pnDKzR2ymbz9kDSBugWX8tWM0JVqjFly90O3q6qzJgw\"]]],\"Epic War\",[\"4.3\",4.326241],\"Casual\",null,null,[null,[[0,\"MYR\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.xxzhz.tlad.sea\\u0026rdid\\u003dcom.xxzhz.tlad.sea\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.xxzhz.tlad.sea\"]],[\"qgJiGmAIIUoTCKLtirHHkJcDFf2nrAIdCDQci/oBDwoNCAASCQoFZW4tVVMQALoCNAoYChJjb20ueHh6aHoudGxhZC5zZWEQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],null,[null,\"The kingdom is under siege and your home is at stake.\\u003cbr\\u003eCreatures of darkness are devouring every living soul in their path. This is a war that you can’t afford to lose.\\u003cbr\\u003eUnder your command, every unit counts. Lead your force to victory and glory, with meticulous planning and genius tactics! Are you prepared?\\u003cbr\\u003e\\u003cbr\\u003e1.Connect the same colored balls\\u003cbr\\u003eIn this super fun and relaxing puzzle game, you need to connect the same balls and ensure that the lines do not cross. You succeed when you can connect all the balls.\\u003cbr\\u003e\\u003cbr\\u003e2.Multiply the Forces\\u003cbr\\u003eCall your soldiers to disembark at the zombies. Do some simple maths from time to figure out what’s the best shot to be taking. You need to hit gates that multiply your forces and overwhelm your foes before they’ve got a chance to react!\\u003cbr\\u003e\\u003cbr\\u003e3. More is more\\u003cbr\\u003eDo you think troops of 50 or 100 units clashing against each other is impressive enough? Well, be re-impressed with a war on epic scale, 1,000 vs 1,000.\\u003cbr\\u003eThere are 11 unique types of units plus powerful heroes waiting for you. Feel the sheer power.\\u003cbr\\u003e\\u003cbr\\u003e4. Sandbox Strategy\\u003cbr\\u003eClaim the Dark Throne, revive the guardian dragon and brand this fantasy world with your name, as the king of kings!\\u003cbr\\u003e\\u003cbr\\u003eFacebook: https://www.facebook.com/EpicWarGlobal/\\u003cbr\\u003e\\u003cbr\\u003ePrivacy Policy: https://sites.google.com/view/ew-privacy-policy/\\u003cbr\\u003e\\u003cbr\\u003eTerms of Service: https://sites.google.com/view/ew-term-of-service/\"],\"K3GAMES\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/oDj4g_NAILRJdxflEuNDVW3xCUHx62M7XKdj18z_zReHHpJEhRU4BAr9EJfbVBu3HRa5khuV-rKjAD4w6FeEtg\"],null,[119,207,114,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,[null,\"Suitable for all age groups. Some violence in a comical or fantasy context is acceptable. Bad language is not permitted.\"],[null,2,[272,272],[null,null,\"https://play-lh.g