],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.game.friends.sea\"]],[\"qgJkGmIIDkoTCKLtirHHkJcDFf2nrAIdCDQci/oBDwoNCAASCQoFZW4tVVMQALoCNgoaChRjb20uZ2FtZS5mcmllbmRzLnNlYRABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"Welcome to TopTop, the ultimate social platform designed for gamers! At TopTop, gaming is no longer a solitary journey but an incredible opportunity to make new friends. We support matchmaking for the hottest mobile games on the market, whether you\\u0026#39;re looking for a gaming partner (CP) or seeking a skilled player to help you soar to victory. Say goodbye to those frustrating teammates - come join us at TopTop! Additionally, we offer exclusive casual mini-games seamlessly integrated with multiplayer online features, allowing you to engage in lively conversations and fully immerse yourself in the joy of socializing while gaming. Join TopTop today and say goodbye to solo gaming - explore the gaming world, make new friends, and team up with players from around the globe!\\u003cbr\\u003e\\u003cbr\\u003e🎮Mobile Game Team Up\\u003cbr\\u003eTired of playing solo? Fed up with getting stuck with terrible teammates? Looking for a gaming partner or a pro to team up with, but always getting ignored? Feeling like you\\u0026#39;re talking to bots because nobody ever uses voice chat in-game?Well, look no further! TopTop matches you with your perfect gaming partner in just 3 seconds. With low-latency voice chat, you\\u0026#39;ll achieve ultimate coordination and breeze through victories effortlessly!\\u003cbr\\u003e\\u003cbr\\u003e🎲 Plenty of Casual Games\\u003cbr\\u003eTopTop is the ultimate gaming app with lots of addictive games to keep you entertained for hours on end! Including:   Bubble🔴, Candy Boom🔥, 8 Ball🎱, Ninja Land🐱\\u200d👤, Who Is the Spy🕵️. The games are so much fun that you won\\u0026#39;t be able to stop playing. And the best part? We\\u0026#39;re constantly adding new games to our collection, so you\\u0026#39;ll always have something new and exciting to look forward to. Whether you\\u0026#39;re looking for a quick game to pass the time or want to challenge your friends to a competitive match, TopTop has everything you need\\u003cbr\\u003e\\u003cbr\\u003e🥳Hang Together in Groups\\u003cbr\\u003eBesides playing games,Within TopTop, you can join various voice rooms and chat with people from all around the world about topics that interest you. Whether you\\u0026#39;re a music lover, a gamer, a sports enthusiast, or simply looking for some good company, there\\u0026#39;s a room for everyone on TopTop.\\u003cbr\\u003eAnd the best part? You don\\u0026#39;t have to worry about showing your face or dressing up for the occasion. TopTop lets you be yourself and enjoy meaningful conversations with others who share your passion\\u003cbr\\u003e\\u003cbr\\u003e🎉Diverse Events, Great Rewards\\u003cbr\\u003eExperience Endless Rewards with Our Diverse Activities, Generous Game Prizes, and Exclusive Gift Bags!\\u003cbr\\u003e\\u003cbr\\u003e✉Contact Us\\u003cbr\\u003eFacebook：@toptopmalaysia\\u003cbr\\u003eTikTok：@toptop.my\"],\"Social Game Lab\",\"5,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/DpVj_nc5ateTli-uHrBWic1mTp81-mJs4EO5TDoSKus4Owkh25ZDS86ZXGUtYWpE3c5z8IyhFkH2Z9hEdKSnLQ\"],null,[26,254,223,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Users Interact, In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[nu