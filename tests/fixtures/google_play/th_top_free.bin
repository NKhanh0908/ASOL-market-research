,[null,2,[2028,1280],[null,null,\"https://play-lh.googleusercontent.com/5sv9fPcBi5CqEW3kMumYtyuo-ufBLgiC5hXUsGwtVeXpTHFPfOry_94cgq5SQOQHcI4zOzLNC1ZNKPm57BxvO3Y\"]],[null,2,[2028,1280],[null,null,\"https://play-lh.googleusercontent.com/M_q92UG1G6Kw7Z8yV9NUKvlisdJYJnv1HkyIifLpZAt-tyJnMDiSpnGU3_YnxidzE7sohs33Gz7jMgb8mqQv-A\"]],[null,2,[2028,1280],[null,null,\"https://play-lh.googleusercontent.com/CJEC8YesGhuDN_Ic9LAbb86gvDrT1x2CdbXAVBppluq1R3OmfNj9_geYb1_7ecntOt6yaJAXp9W00TvWoannAGw\"]],[null,2,[2028,1280],[null,null,\"https://play-lh.googleusercontent.com/DrnnPj0DEk4dSGx-nTiAVa48KrbBzJtOwgGUGxFcnSVDCm2sWSNJcjnmBJW4lWFO8eBTn7c2A7o5-elE7eeY67I\"]],[null,2,[2028,1280],[null,null,\"https://play-lh.googleusercontent.com/NJmR0QZYacITOFPDQD31--uVFj1vamSsZJ4KS-BFUZschZwId35nLb_4Nff_4drhLj3uSuXnQ_xv1rEGRZ9NZUg\"]],[null,2,[2028,1280],[null,null,\"https://play-lh.googleusercontent.com/Nx93Tg4YlGbZAZLKa20p7s-e7lld-qAhDmGoC1H6FY4z9V5jMJeALiluKMOQXfvDPG_XqoIdBFYFi_SItqQv_A\"]]],\"Candy Crush Soda Saga\",[\"4.6\",4.591905],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.king.candycrushsodasaga\\u0026rdid\\u003dcom.king.candycrushsodasaga\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.king.candycrushsodasaga\"]],[\"qgJwGm4IL0oTCMOWlLDHkJcDFZ3ncwEd2QAY9PoBFAoSCIfkqvbS2cePQxIGCgJ0aBAAugI9CiEKG2NvbS5raW5nLmNhbmR5Y3J1c2hzb2Rhc2FnYRABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,\"ex2ImFFg_Zg\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:ex2ImFFg_Zg?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:ex2ImFFg_Zg\",null,null,null,null,\"AXH1ezlQ0zmMjz4A8OdpIcmonj9uRaQy8fbDROqfyW1nx7b9AHKh5n6wmLt_rKK2U-t243cLMa6NBGDEH0ysEEiXhe9Pl3A_irAYGAYU_LRh2XpaA1ITdD-QHyeCn3WfPiWXi7Ar1zixPKwF5kqjb6m5z2hvZEuBCnq5I681aoQO_RQH-mCygu2Gzv5vAy4--V9b0i7DCWnvn8n5kfWyH_kXjbmc5nQdHO6EAgDcbY-ytNUpIJm1ZCpv-skQ1xz5hAVnmbAsNxaLH0FmG3rWtZa9aUvLXsuVm7tiePrCISxfjgOPSg\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/ex2ImFFg_Zg/hqdefault.jpg\"]]]],[null,\"ดาวน์โหลด Candy Crush Soda Saga เพื่อจับคู่ลูกกวาดแสนสนุกและเกมออฟไลน์แสนสนุก ความสนุกและการไขปริศนา!\\u003cbr\\u003e\\u003cbr\\u003eค้นพบ Candy Crush Soda Saga อีกหนึ่งเกมใหม่จากผู้สร้าง Candy Crush Saga ในตำนาน! คุณจะสนุกไปกับการจับคู่ลูกกวาดและสร้างชุดค่าผสมเพิ่มเติม รวมโหมดเกมที่ท้าทายพร้อมโซดาสีม่วงและความสนุกสุดมันส์!\\u003cbr\\u003e\\u003cbr\\u003eการผจญภัยในเกมไขปริศนาชวนน้ำลายสอนี้จะทำให้คุณเพลิดเพลิน ออกเดินทางไปกับ Kimmy เพื่อค้นหาเส้นทางของ Tiffy ที่เปิดมิติใหม่ของเกมจับคู่ที่สนุกสนาน ทั้งออนไลน์และออฟไลน์ เล่นคนเดียวในเทพนิยายแสนสนุกนี้หรือเล่นกับเพื่อน ๆ เพื่อดูว่าใครจะได้คะแนนสูงสุด!\\u003cbr\\u003e\\u003cbr\\u003eการอัปเดตฤดูกาลรายเดือนช่วยให้คุณสำรวจภารกิจที่ไม่ซ้ำใครและเกมเพลย์ยอดนิยมที่น่าตื่นเต้น! ทำภารกิจต่าง ๆ และบรรลุความสำเร็จเพื่อก้าวหน้าผ่าน Season Pass พร้อมรางวัลและบูสเตอร์ที่จะช่วยคุณในเทพนิยายนี้\\u003cbr\\u003e\\u003cbr\\u003eเผยตัวตนนักแข่งของคุณให้โลกได้รับรู้ผ่านการแข่งขันมากมาย! แข่งขันกับผู้เล่นคนอื่น ใครจะผ่านด่านได้เร็วที่สุดและก้าวต่อไปได้เร็วที่สุด? หรือเล่นเป็นทีมในโหมด 4 แถวที่ผู้เล่นทำงานร่วมกันเพื่อรับรางวัลแสนสนุก!\\u003cbr\\u003e\\u003cbr\\u003eคุณสมบัติของ Candy Crush Soda Saga:\\u003cbr\\u003e\\u003cbr\\u003e- มากกว่า 10,000 ด่านที่ตรงกัน รวมถึงการเล่นเกมแบบจับคู่ 3\\u003cbr\\u003e- กราฟิกที่สมจริงพร้อมตัวละคร 3 มิติและสภาพแวดล้อมที่เปลี่ยนแปลงตลอดเวลา\\u003cbr\\u003e- ฤดูกาลรายเดือนเพิ่มความสนุกสนานตลอดทั้งปีด้วยภารกิจที่ท้าทายและบัตรรางวัล\\u003cbr\\u003e- เพลิดเพลินกับการเล่นโหมดเกมต่างๆ ที่เต็มไปด้วยลูกกวาดแสนสนุกและมีเอกลักษณ์ เช่น โซดา น้ำแข็ง และรวงผึ้ง\\u003cbr\\u003e- การผสมผสานลูกกวาดใหม่ๆ ที่ยอดเยี่ยม เช่น จัดเรียงลูกกวาด 4 ลูกในสี่เหลี่ยมจัตุรัส หรือจับคู่ลูกกวาด 7 ลูกเพื่อสร้างลูกกวาดเปลี่ยนสีใหม่\\u003cbr\\u003e\\u003cbr\\u003e- สำรวจโลกและด่านต่างๆ ในเกมพัฒนาสมองที่ท้าทายนี้\\u003cbr\\u003e- พิชิตด่าน: ไปให้เร็วที่สุดเพื่อรับรางวัลอันแสนหวานในการแข่งขันตอนต่างๆ\\u003cbr\\u003e- สนุกกับการเล่นโดยจับคู่ลูกกวาดในเกมคลายเครียดแสนสนุกนี้\\u003cbr\\u003e- ผู้เล่นที่เชื่อมต่อกับ Facebook สามารถแข่งขันและท้าทายเพื่อนของพวกเขาได้\\u003cbr\\u003e- ซิงค์เกมระหว่างอุปกรณ์ได้อย่างง่ายดายเพื่อปลดล็อกคุณสมบัติเกมทั้งหมดเมื่อเชื่อมต่อกับอินเทอร์เน็ต\\u003cbr\\u003e\\u003cbr\\u003eCandy Crush Soda Saga เป็นเกมจับคู่ลูกกวาดที่น่าทึ่งพร้อมเกมออฟไลน์ เกมเพลย์และปริศนาที่สนุก เป็นสิ่งที่ต้องมี คุณสามารถดาวน์โหลดและเล่นเกมนี้ได้ฟรีโดยสมบูรณ์ หรือเลือกซื้อไอเทมเพิ่มเพื่อเพิ่มความสนุก!\\u003cbr\\u003e\\u003cbr\\u003eโดยการดาวน์โหลดเกมนี้ คุณจะต้องยอมรับข้อกำหนดในการให้บริการของเราตาม https://www.king.com/th/termsAndConditions\\u003cbr\\u003e\\u003cbr\\u003eติดตามเราบนโซเชียลมีเดีย:\\u003cbr\\u003e\\u003cbr\\u003e- เฟสบุ๊ค @CandyCrushSodaSaga\\u003cbr\\u003e- ทวิตเตอร์ @CandyCrushSoda\\u003cbr\\u003e- อินสตาแกรม @CandyCrushSaga\\u003cbr\\u003e- YouTube @CandyCrushOfficial\\u003cbr\\u003e\\u003cbr\\u003eถึงทุกคนที่เล่น Candy Crush Soda Saga อยู่แล้ว ขอขอบคุณ!\"],\"King\",\"500,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/vpgirv1Nj5YvwBM4UcfYqXHxxqxc_7OhghTwwMwgv8iwpgSLURGuAe2Pd9PAZiFsCVxsEp4ERn4rbYxckvGiLQ\"],null,[35,37,130,255]],null,[\"ประเภท 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"การโต้ตอบกับผู้ใช้ แชร์ตำแหน่ง และการซื้อในเกม\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"