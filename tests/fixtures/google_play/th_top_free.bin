W2Gi1Hv0cielFaGPq74JJxpdGu_HSB8RxqpR-P1mU7h843CkJZmC-VUoWtrvqBi68IrDrvJi1XE345vk2wg\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/L7jjl5V6Q_oHLHeOVVauhFIsvCXc0tKPiGqd6AniFDhiSDMKb1O9eJAMRKnxvQZQYWhY5WUu56hTLY6FBoXgrpI\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/J_fQpdj8E3dH08xmXmtan44vQKjMMksTwz9nXzz71B11p21qPQS0pyY2AF9VyUWb8Uu7jBuaZfnZfHcehbb5lEg\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/rupdDgx1xZTM08z-vJDoS_nI-1FDSuBUdwA73OtmYbbF66OxXW-la-nwXUpsDwinXJSNJ5b4XTyuH3vO1zef\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/frv3SDC7masJY4Dte-MfN-L_bOv1UvGV1yDR4OuNrrritU8BOH3Eem-GVo_fOWjU3elInZVNNccwhRshsY5KpA\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/M5pfeN37SCwJlpUOm67CqwakTYQLgxP--ApvS84Q3SkB9XoID7jzCJq53q17gCGW9ITcf6lGDbZyNihklM48g8I\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/9Gxv-DiRd2Xh0IEgAu4m8WCiWzB16HhR8GaSNJGvGb0jCA9D4LXwuwOkysCu4x8XttRFQxp9vQGAV4sHMJlhMHE\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/-YN297AYz7mAYmMHDFV4qNhrW3YHosnxt8A992CwjJYnnP5atT9J5qmTe0fWy2iRse5yyDuH6iBQidsxV2hJJd4\"]]],\"Mechangelion - เกมโรบอท\",[\"4.5\",4.4624505],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.tsyatsya.mechangelion\\u0026rdid\\u003dcom.tsyatsya.mechangelion\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.tsyatsya.mechangelion\"]],[\"qgJmGmQIW0oTCMOWlLDHkJcDFZ3ncwEd2QAY9PoBDAoKCAASBgoCdGgQALoCOwofChljb20udHN5YXRzeWEubWVjaGFuZ2VsaW9uEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"ชื่นชอบเกมการต่อสู้ของหุ่นยนต์ไหม อยากเข้าร่วมสงครามหุ่นยนต์ในเวทีเมคไหม เกมหุ่นยนต์สงครามนี้จะไม่ทำให้คุณผิดหวัง หุ่นยนต์ของคุณจะต้องพิชิตศัตรูเหล็กจริงในเวทีเมคให้ได้ ซึ่งยากที่จะรอดชีวิตไปได้ ยินดีต้อนรับสู่ Mechangelion - เกมโรบอท!\\u003cbr\\u003e\\u003cbr\\u003eอัปเกรดฮีโร่ของคุณเพื่อพิชิตหุ่นยนต์สงคราม ปลดปล่อยการโจมตีใส่หุ่นยนต์สงครามแบบตัวต่อในรูปแบบการเล่นที่เรียบง่าย ใช้แผงควบคุมเพื่อเคลื่อนไหว แย็บหมัด และต่อยราวกับอยู่ในเกมมวยจริง ก้าวขึ้นมาเป็นผู้สร้างหุ่นยนต์มากทักษะ ปรับปรุงหุ่นยนต์ของคุณด้วยอาวุธที่ทรงพลังเพื่ออัดบอสให้ราบคาบ และพิชิตด่าน \\u003cbr\\u003e\\u003cbr\\u003eเกมส์หุ่นยนต์ต่อสู้จะมอบชั่วโมงแห่งความสนุกมากมายให้กับผู้เล่นทุกวันได้อย่างแน่นอน คุณพร้อมจะเข้าสู่ยุคใหม่ของเกมส์ต่อสู้หรือยัง ใช้ทักษะและกลยุทธ์การต่อสู้ของคุณเพื่อสังหารเหล่าร้าย โลกแห่งหุ่นยนต์กำลังมองดูคุณเล่นอยู่!\\u003cbr\\u003e\\u003cbr\\u003eไฮไลท์หลัก\\u003cbr\\u003e\\u003cbr\\u003eเข้าประจันหน้าในการต่อสู้ของไดโนเสาร์\\u003cbr\\u003eในเกมส์หุ่นยนต์ต่อสู้นี้ นอกเหนือจากหุ่นยนต์สงครามแล้ว คุณยังจะได้เผชิญหน้ากับไดโนเสาร์ยักษ์อีกด้วย พิชิตพวกมัน และชิงชัยในการต่อสู้ของไดโนเสาร์ เกมนี้แตกต่างจากเกมไดโนเสาร์เกมอื่นๆ อย่างมาก ด้วยเหตุนี้เอง คุณจึงจำเป็นจะต้องใช้ทักษะของคุณเพื่อล้มหุ่นยนต์ศัตรู\\u003cbr\\u003e\\u003cbr\\u003eสร้างกลยุทธ์ของคุณเอง\\u003cbr\\u003eเตรียมตัวให้พร้อมสำหรับการโจมตีสุดเซอร์ไพรส์ การเคลื่อนไหวอย่างมีชั้นเชิง และเล่ห์เหลี่ยมของศัตรู เลือกแผนของคุณอย่างชาญฉลาด แล้วพิสูจน์ว่าคุณคู่ควรกับหุ่นยนต์สงครามอันทรงพลังในโลกเหล็กจริง \\u003cbr\\u003e\\u003cbr\\u003eอัปเกรดหุ่นยนต์ของคุณ\\u003cbr\\u003eปลดล็อกอาวุธใหม่เพื่อใช้ในการต่อสู้ และอัปเกรดการป้องกันให้กับหุ่นยนต์ของคุณ ในการพิชิตการต่อสู้ของไททันส์นั้น หุ่นยนต์สงครามของคุณจะต้องก้าวล้ำศัตรูไปหนึ่งก้าวเสมอ\\u003cbr\\u003e\\u003cbr\\u003eดาวน์โหลดMechangelion - เกมโรบอท แล้วขึ้นขับหุ่นยนต์สงครามเลยสิ พิชิตหุ่นยนต์เหล็กจริง และไดโนเสาร์จักรกล! ใช้ทักษะการต่อสู้ของคุณ รวมถึงอาวุธต่างๆ มากมาย คุณพร้อมจะชิงชัยในเวทีเมคหรือยัง\"],\"Moonee\",\"50,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/HVm6uURrTjhOzHfk92XEr1R2wVaUth6D83-hSt4yhOreoyDm63-GrAs7duGcc0_r4DJs7cTjOd7M61t2oIxzag\"