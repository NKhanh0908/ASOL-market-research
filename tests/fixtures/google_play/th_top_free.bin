d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.infiniplay.merge.fashion.romance.story\"]],[\"qgJ/Gn0IDkoTCMOWlLDHkJcDFZ3ncwEd2QAY9PoBFAoSCLWF4obUv9uIQxIGCgJ0aBAAugJMCjAKKmNvbS5pbmZpbmlwbGF5Lm1lcmdlLmZhc2hpb24ucm9tYW5jZS5zdG9yeRABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,\"ivBQcPKIRVM\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:ivBQcPKIRVM?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:ivBQcPKIRVM\",null,null,null,null,\"AXH1ezkl8QlMQ8kAxZwYyLHrToZqVzoEoYAM2w-TQyJqBCG0KOKKsSxQsS00sHLzGEKgaRxE_3Wsi3c6kyfFcKucfATM1m2JvN8j6xKKDwPHyqq1y0fjEPQNsHz8KRVVS6N3oiIxAokpc2dE7ePYkR8E6V2XBnFbGPsUcavKs3HOWsCmwmAaSjUrhEfqCdr91t8LNQ6u00G66w7t4d4A4xxl_J8j6yAGZLYVMqqBg6A2X_TCMAI7XLCp3d-eQCEsTIdZcDawGnLQpX9iCc-c286VVIYJ1wPTQDHpz9WVyNWtDXSevg\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/ivBQcPKIRVM/hqdefault.jpg\"]]]],[null,\"\\u0026quot;ยินดีต้อนรับสู่ Merge Fashion! 🎉\\u003cbr\\u003e\\u003cbr\\u003eหลังจากถูกแฟนหนุ่มทรยศอย่างโหดร้าย อลิซตัดสินใจอย่างแน่วแน่ที่จะเปลี่ยนแปลงตัวเองและควบคุมโชคชะตาของเธอ ด้วยความมั่นใจและสไตล์ใหม่ เธอได้ผ่านการเปลี่ยนแปลงที่น่าทึ่งและดึงดูดสายตาของ CEO ลึกลับคนหนึ่ง ในโรแมนซ์ที่รวดเร็ว เขาขอเธอแต่งงาน แต่เมื่ออลิซเริ่มต้นบทใหม่ที่น่าตื่นเต้นนี้ เธอต้องตั้งคำถามว่า นี่คือการเริ่มต้นใหม่ที่เธอหวังไว้หรือมันซ่อนความลับลึก ๆ ที่อาจเปลี่ยนชีวิตของเธอไปตลอดกาล ร่วมเดินทางไปกับอลิซในเส้นทางการค้นพบตัวเอง ความรัก และความลึกลับขณะที่เธอเผชิญกับความท้าทายต่าง ๆ ที่รออยู่ข้างหน้า\\u003cbr\\u003e\\u003cbr\\u003eMerge Fashion 💍\\u003cbr\\u003e\\u003cbr\\u003eเข้าสู่โลกที่เต็มไปด้วยสีสัน ที่เราจะมอบเครื่องสำอาง, เครื่องประดับ, เสื้อผ้า และไอเทมแฟชั่นมากมายให้คุณยิ่งรวมและผสมสิ่งของมากเท่าไหร่ คุณจะค้นพบชิ้นแฟชั่นที่ไม่เหมือนใครและน่าตื่นเต้นที่จะเพิ่มในคอลเลกชั่นของคุณ! ทดลองกับการผสมผสานต่าง ๆ เพื่อสร้างลุคใหม่ที่น่าทึ่ง และดูจักรวาลแฟชั่นของคุณเติบโตเมื่อคุณปลดล็อกไอเทมพิเศษและการอัปเกรดต่าง ๆ\\u003cbr\\u003e\\u003cbr\\u003eคุณสมบัติ:\\u003cbr\\u003e- ไอเทมแฟชั่นหลากหลาย: ตั้งแต่พาเลตต์เครื่องสำอางที่ทันสมัยไปจนถึงเครื่องประดับที่หรูหรา สำรวจไอเทมที่หลากหลายที่จะตอบโจทย์ทุกความต้องการของสาวแฟชั่น\\u003cbr\\u003e- ปลดล็อกคอลเลกชั่นพิเศษ เมื่อคุณ：เดินหน้าในเกม คุณจะค้นพบไอเทมรุ่นลิมิเต็ดและคอลเลกชั่นที่มีธีมที่จะยกระดับสไตล์ของคุณ\\u003cbr\\u003e\\u003cbr\\u003eเปิดเผยเรื่องราวโรแมนซ์ 📖\\u003cbr\\u003e\\u003cbr\\u003eดื่มด่ำไปกับเรื่องราวความรักที่เปลี่ยนแปลงตลอดเวลา เต็มไปด้วยความหลงใหล ขัดแย้ง และความปรารถนาที่ซ่อนอยู่ ติดตามการเดินทางของอลิซเมื่อเธอพบกับความหักมุมที่ไม่คาดคิดในชีวิตรักของเธอ ทุกบทจะเปิดเผยความลับที่น่าติดตามและช่วงเวลาอารมณ์ที่ทรงพลังที่จะทำให้คุณติดตามและรอคอยว่าอะไรจะเกิดขึ้นต่อไป\\u003cbr\\u003e\\u003cbr\\u003eไฮไลท์ของเรื่อง:\\u003cbr\\u003e- การพัฒนาเนื้อเรื่องที่มีพลิกผัน:มีส่วนร่วมในการเล่าเรื่องที่สามารถให้คุณมีอิทธิพลต่อการตัดสินใจและผลลัพธ์ในชีวิตรักของอลิซ\\u003cbr\\u003e- คลี่คลายปริศนา:แก้ปริศนาและหาคำตอบในการเข้าใจความสัมพันธ์รักของอลิซ\\u003cbr\\u003e- ความสัมพันธ์ทางอารมณ์: สร้างความสัมพันธ์กับตัวละครต่าง ๆ ที่แต่ละคนจะนำเรื่องราวและความท้าทายของตัวเองเข้ามาในชีวิตของอลิซ\\u003cbr\\u003e\\u003cbr\\u003eเครื่องสำอางและแต่งตัว 👗\\u003cbr\\u003e\\u003cbr\\u003eปลดปล่อยแฟชั่นนิสต้าภายในตัวคุณด้วยการทดลองสไตล์และเครื่องประดับหลากหลาย ตั้งแต่เครื่องประดับสุดหรูไปจนถึงกระเป๋าถือดีไซน์สุดชิค สร้างชุดฝันสำหรับทุกโอกาสและแสดงออกถึงรสนิยมที่ไม่เหมือนใคร ด้วยความเป็นไปได้ที่ไม่มีที่สิ้นสุด คุณสามารถเปลี่ยนรูปลักษณ์และชุดเสื้อผ้าเพื่อให้ทันแฟชั่นล่าสุด\\u003cbr\\u003e\\u003cbr\\u003eสิ่งที่คุณสามารถทำได้:\\u003cbr\\u003e- ผสมและจับคู่:ทดลองกับชุดเดรส กระโปรง และเสื้อเพื่อสร้างลุคที่น่าทึ่งที่เหมาะกับสไตล์ของคุณ\\u003cbr\\u003e- สำรวจสไตล์ที่หลากหลาย: ค้นพบตัวเลือกแฟชั่นมากมาย ตั้งแต่ชุดเดรสหรูหราสำหรับงานกลางคืน ไปจนถึงชุดสบาย ๆ ที่เหมาะกับการใส่ในวันธรรมดา\\u003cbr\\u003e- สร้างภาพที่น่าทึ่ง: จับภาพลุคที่สมบูรณ์แบบสำหรับตัวละครของคุณด้วยสีสันที่สดใส เครื่องประดับที่ทันสมัย และการผสมผสานที่สร้างสรรค์\\u003cbr\\u003e\\u003cbr\\u003eต้องการความช่วยเหลือ?  \\u003cbr\\u003eทีมงานของเราพร้อมที่จะให้บริการคุณในทุกขั้นตอน หากคุณมีคำถามหรือต้องการความช่วยเหลือ โปรดอย่าลังเลที่จะติดต่อเราโดยส่งอีเมลมาที่ feedback@infiniplay-game.com เราพร้อมช่วยเหลือคุณเสมอ!\\u003cbr\\u003e\\u003cbr\\u003eนโยบายความเป็นส่วนตัว: [ดูนโยบายความเป็นส่วนตัวของเรา](https://infiniplay-game.com/policy.html)  \\u003cbr\\u003eข้อกำหนดในการให้บริการ: [อ่านข้อกำหนดในการให้บริการของเรา](https://infiniplay-game.com/service.html)\\u003cbr\\u003e\\u003cbr\\u003eเข้าร่วมการเดินทางสุดตื่นเต้นใน Merge Fashion และค้นพบโลกแห่งแฟชั่น ความรัก และการค้นพบตัวเอง! ไม่ว่าคุณจะเป็นแฟชั่นนิสต้าหรือคนรักการเล่าเรื่อง มีสิ่งที่น่าหลงใหลสำหรับทุกคนในเกมนี้!\\u0026quot;\"],\"Infiniplay-Game\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/DJMQF1xCXfV3yeVkJH-aXYRMO9k0TrwUzOoJJGTykes8oAPikpteMJg3rP7bHPosJEtwnRyccExvuzNq4TpA\"],null,[240,227,202,255]],null,[\"ประเภท 12+\",[null,2,[366,512],[null,null,\"https://play-lh.googleusercontent.com/yQChfa9XKlaXMIYTk8w8QwChjT8_SH-_2d2SS-kesw0TLQK1nxtw54bDcoZ09freZJgKrtg4f__is-31Vg\"]],[null,\"การนำเสนอเรื่องทางเพศโดยนัย\"],null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/YrkR-GP7OKghBTATCoO_jJrchSVrh-NSUBb5DnbRZC1DbLK_cgV9FC2e_iI4GzLsKXuZjuFZajnGCiA8qA\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.infiniplay.merge.fashion.romance.story\\u0026rdid\\u003dcom.infiniplay.merge.fashion.romance.story\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"ติดตั้ง\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"฿10.00 - ฿4,65