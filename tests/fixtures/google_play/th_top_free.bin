4hk5DqUAHYAhNP8Bvk2uh-k0J0zFix5mFQOHKChbIYEE6TVrV\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/O292qS8n-KSuESSOxWLlwnuQG9AQC05IdcMe8lCOp7Iwey_VapiVh2MPn15pyo89NnI8u8aMrR04s0uMUu-S\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/esdkuZdPW1PMTXMfMdT7G2Iz57icIBnQvzeNa58SHYcNvYhI-a03qBv74lgJu8Oi0OgyU_-EUxRUeqYcDuBHQg\"]]],\"ซูเปอร์มาร์เก็ต\",[\"4.2\",4.219925],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.bubadu.supermarket\\u0026rdid\\u003dcom.bubadu.supermarket\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.bubadu.supermarket\"]],[\"qgJzGnEIMkoTCMOWlLDHkJcDFZ3ncwEd2QAY9PoBDAoKCAASBgoCdGgQAIgCAboCPgocChZjb20uYnViYWR1LnN1cGVybWFya2V0EAEYAxIeCgQIARABCgQIAxABCgQIBBABCgQIBhABCgQICxABygIECAEQAQ\\u003d\\u003d\"],[[[null,null,\"eFV9A9lsT6I\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:eFV9A9lsT6I?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:eFV9A9lsT6I\",null,null,null,null,\"AXH1ezn35gzPsKOqZnlIJbLY9ZtMt-rBZZM-jSi51KZYkYUdZ-6gypbq8rNXft6I89s1aaSEuAtYConniOxyDJawxwSXhmL0avdWYbDVktgM7qDp3yCCiH2zrC-SirEkUblXh1LaUbd31endmx-1RNuRsBl_m-21qezMCsZBrnwYt9GGpxwqx6Fcp5WEx89lKl3r2A5WM4Nrj_dfiLbZ-lju98Sz82HjVor1d7wy_ABAQWyOA9DHyM35ucQXOBI8BG43B_-VNqlRWJ9kbZslmJ2aa0qtpaLn44NjUoBPqsR_noHB3A\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/eFV9A9lsT6I/hqdefault.jpg\"]]]],[null,\"ขอต้อนรับสู่สวรรค์แห่งการช้อปปิ้ง! ซื้อของและเตรียมพร้อมสำหรับความสนุกบางประการ!\\u003cbr\\u003e \\u003cbr\\u003eซูเปอร์มาร์เก็ตแห่งนี้มีส่วนต่าง ๆ มากมาย: ส่วนคิดเงิน แผนกของกินของใช้ ชีสและซาลามี่ ผักและผลไม้ ของหวาน และของเล่น ส่วนรีไซเคิลและส่วนอื่น ๆ ทำภารกิจที่จำเป็นทั้งหมดและนำเสนอบริการซื้อของที่สุดยอดเพื่อให้ตรงตามความต้องการของลูกค้าของคุณ\\u003cbr\\u003e \\u003cbr\\u003e• ส่วนคิดเงิน: สนุกกับการสแกนรายการสินค้าและการออกใบเสร็จรับเงิน เรียนรู้เกี่ยวกับตัวเลขและตรวจสอบให้มั่นใจว่าได้รับจำนวนเงินที่ถูกต้อง เหมือนกับพนักงานคิดเงินจริง ๆ\\u003cbr\\u003e• แผนกของกินของใช้: จับตาดูเกมสนุก ๆ ที่มีของซ่อนไว้ซึ่งคุณจะต้องหาอาหารและเครื่องดื่มให้พบ เช่น เค้ก อมยิ้ม ช็อกโกแลต น้ำผลไม้ สปาเก็ตตี้ และอื่น ๆ อีกมากมาย ช่วยลูกค้าของคุณหาสิ่งที่พวกเขาต้องการ\\u003cbr\\u003e• ชีสและซาลามี่: แยกประเภทของซาลามี่และชีสที่ต่างกันจากสายพานลำเลียง ลากรายการของทุก ๆ รายการไปใส่ไว้ในกล่องของมันและเป็นคนจัดแยกประเภทที่เร็วที่สุดในร้านค้าของคุณ\\u003cbr\\u003e• ผักและผลไม้: เลือกผักและผลไม้ที่สดใหม่ โดยเลี่ยงชิ้นที่เน่าเสียแล้ว เก็บรวบรวมกล้วย สตรอว์เบอร์รีมะเขือเทศ แครอท และอาหารเพื่อสุขภาพอื่น ๆ\\u003cbr\\u003e• ขนมหวาน: ส่วนของหวานเป็นส่วนที่หวานที่สุดเสมอในซูเปอร์มาร์เก็ต ทำให้แม่นยำและเติมถ้วยที่ส่งผ่านมาด้วยของหวานที่หลากหลาย\\u003cbr\\u003e• ชั่งน้ำหนัก: บรรจุผลไม้และผักลงในถุง ใส่ให้ได้ปริมาณที่เหมาะสมบนตาชั่งแล้วชั่งน้ำหนักมัน ดูหน้าจอบนตาชั่งและเลี่ยงตัวเลขสีแดง\\u003cbr\\u003e• รีไซเคิล: ปกป้องโลกจากการเกิดมลพิษโดยการเรียนรู้วิธีการรีไซเคิลและแยกประเภทขยะของคุณ ใส่รายการของลงในถังขยะสำหรับรีไซเคิลที่ต่างกันได้อย่างถูกต้อง: กระดาษ พลาสติก แก้ว แบตเตอรี่ และขยะที่เป็นสารอินทรีย์\\u003cbr\\u003e• ตัวจับของเล่น: ใช้ปุ่มนำทางเพื่อเคลื่อนย้ายอุ้งมือจับและตีที่ปุ่มสีแดงเพื่อตักมันขึ้นมา สนุกกับการคว้าของเล่นในส่วนของเครื่องเล่นจับของเล่น\\u003cbr\\u003e• การนำส่งสินค้า: ขับรถส่งสินค้าบนถนนห้าเลนและนำส่งบรรจุภัณฑ์ ทดสอบทักษะการขับรถของคุณและรีบเร่งผ่านการจราจรสุดบ้าคลั่งให้เร็วที่สุด\\u003cbr\\u003e• จับขโมย: มาเป็นซุปเปอร์ฮีโร่และจับขโมยในซูเปอร์มาร์เก็ตกัน คุณจะต้องเร็ว!\\u003cbr\\u003e\\u003cbr\\u003eรักษาซูเปอร์มาร์เก็ตของคุณให้อยู่ภายใต้การควบคุมของคุณและเป็นเจ้าของร้านที่เก่งที่สุดในเกมช้อปปิ้ง!\\u003cbr\\u003e\\u003cbr\\u003eฟีเจอร์:\\u003cbr\\u003e• เล่นได้ง่ายและสนุก\\u003cbr\\u003e• แอนิเมชันและเสียงเอฟเฟกต์ที่น่าสนใจ\\u003cbr\\u003e• มินิเกมและส่วนสำหรับช้อปปิ้งที่ได้รับความนิยม 10 รายการ\\u003cbr\\u003e• การบรรลุผลความท้าทายด้วยเหรียญทองแดง เหรียญเงิน และเหรียญทอง\\u003cbr\\u003e\\u003cbr\\u003eเกมนี้สามารถเล่นได้ฟรี แต่อาจต้องทำการชำระเงินสำหรับฟีเจอร์หรือไอเทมบางรายการในเกม พร้อมทั้งบางรายการที่กล่าวถึงในคำอธิบายเกี่ยวกับเกม โดยชำระเงินผ่านการสั่งซื้อภายในแอปซึ่งจะมีค่าใช้จ่ายเป็นเงินจริง โปรดตรวจสอบการตั้งค่าอุปกรณ์ของคุณสำหรับรายละเอียดตัวเลือกเพิ่มเติมเกี่ยวกับการสั่งซื้อภายในแอป\\u003cbr\\u003eภายในเกมจะมีโฆษณาสินค้าของ Bubadu หรือสินค้าของบุคคลที่สามบางรายการซึ่งจะนำทางผู้ใช้ไปยังเว็บไซต์ แอปของเราหรือของบุคคลที่สาม\\u003cbr\\u003e\\u003cbr\\u003eนโยบายความเป็นส่วนตัว: https://bubadu.com/privacy-policy.shtml\\u003cbr\\u003eข้อตกลงการใช้บริการ: https://bubadu.com/tos.shtml\"],\"FM by Bubadu\",\"100,000,000+\",null,\"อายุ 6-8 ปี\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/gOQfeKslOJyvPBUtIcbPVfjLe89wHtjFiZVGXx4OpttRpifWll0LR9pkfjOFNpxUlr1qsHqEEzSddZZ8iDWSLkk\"],null,[240,131,5,255]],null,[\"ประเภท 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"การซื้อในเกม\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.bubadu.supermarket\\u0026rdid\\u003dcom.bubadu.supermarket\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"ติดตั้ง\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"฿37.00 - ฿150.00 ต่อรายการ\",[false]],null,null,null,[[