72Rc8nyPfc9DGWbeTMHBQ3E_w9Tk7ptqd\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/lOplhsRf4zksfM_ld6_kNeegS9krRTRyyxh8vF7yVR_AORVlgmlOb-ycXdoqbWVcSkhCtGjt9RzeDWiH2vy77A\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/JSpqOGAuI4kfwK4JcP7RFFDXNyrCLEzzZvCmJguJ3qUFgpyW9_IZl3UefC3-FzhJNFJibvMZhnrT55ZI08antg\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/yNl8Tg163Sk0oIO4jJoNDvwgXgtu0kTM5-7CS0_E_vX1vhdP1fIlJ1eeGFdsRjd09wXQf5o68R8TYH4QPCVe\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/s_vdjf_33AWmt9FsBR_RAfNV-1a40i5RxUFjIqUoJMOFIBg_KEdX-w0DU57X9DBBk08EfTo_ngWDqnjUKuE9QA\"]]],\"Bus Crowd - การจราจรติดขัด\",[\"4.7\",4.6666665],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dbusflow.traffic.puzzle\\u0026rdid\\u003dbusflow.traffic.puzzle\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dbusflow.traffic.puzzle\"]],[\"qgJjGmEIPUoTCMOWlLDHkJcDFZ3ncwEd2QAY9PoBDAoKCAASBgoCdGgQALoCOAocChZidXNmbG93LnRyYWZmaWMucHV6emxlEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"ยินดีต้อนรับสู่ Bus Crowd เกมปริศนารถบัสสีสันสดใสที่เน้นกลยุทธ์แก้รถติด การจับคู่ผู้โดยสาร และการเลือกที่จอดอย่างชาญฉลาด 🚌🚦\\u003cbr\\u003e\\u003cbr\\u003eสถานีที่แออัดเต็มไปด้วยผู้โดยสารที่รออยู่ และรถบัสหลากสีหลายความจุก็พร้อมออกเดินทาง สังเกตฝูงชน เลือกรถให้ถูกคัน แล้วเลื่อนไปยังช่องจอดว่างเพื่อรับผู้โดยสาร เติมที่นั่งให้ครบเพื่อเปิดช่องจอด หลีกเลี่ยงการติดขัดในลานจอด และควบคุมการไหลของรถบัสแต่ละคัน\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003e🎮 วิธีเล่น\\u003c/b\\u003e\\u003cbr\\u003e\\u003cb\\u003e- จับคู่สีและที่นั่ง:\\u003c/b\\u003e รถบัสว่างจะรับผู้โดยสารสีเดียวกัน รถแต่ละคันมีจำนวนที่นั่งต่างกัน\\u003cbr\\u003e\\u003cb\\u003e- ตามลูกศร:\\u003c/b\\u003e ย้ายรถจากสถานีไปยังช่องจอด รถแต่ละคันวิ่งได้ตามทิศลูกศรเท่านั้น\\u003cbr\\u003e\\u003cb\\u003e- เติมรถให้เต็มเพื่อเปิดช่อง:\\u003c/b\\u003e รถที่เต็มแล้วจะออกไปและเปิดพื้นที่สำหรับการเดินต่อไป\\u003cbr\\u003e\\u003cb\\u003e- แก้รถติดด้วยกลยุทธ์:\\u003c/b\\u003e ใช้ตรรกะจัดสี ลำดับรถบัส และแผนจอดรถเพื่อผ่านทุกปริศนา 🧩\\u003cbr\\u003e\\u003cb\\u003e- ใช้บูสเตอร์เมื่อไปต่อไม่ได้:\\u003c/b\\u003e ช่วยปรับรถ นำทางผู้โดยสาร หรือเปิดเส้นทาง 🚀\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003e🌟 จุดเด่น\\u003c/b\\u003e\\u003cbr\\u003e\\u003cb\\u003e- ความสนุกแบบ Bus Jam:\\u003c/b\\u003e รวมการจับคู่สี การรับผู้โดยสาร ช่องจอด และการแก้รถติดในด่านที่เล่นง่ายและน่าพอใจ\\u003cbr\\u003e\\u003cb\\u003e- ความท้าทาย Bus Out:\\u003c/b\\u003e ดูลูกศร ส่งรถที่ถูกต้องออก และสนุกกับจังหวะที่สถานีกลับมาไหลลื่น\\u003cbr\\u003e\\u003cb\\u003e- ช่วงเวลา Bus Escape:\\u003c/b\\u003e เติมรถ เปิดเลน และสร้างทางออกอย่าง clever 🚍\\u003cbr\\u003e\\u003cb\\u003e- ด่าน Traffic Escape:\\u003c/b\\u003e รับมือผังรถติด แรงกดดันจากที่จอด และชั่วโมงเร่งด่วนด้วยการสังเกต\\u003cbr\\u003e\\u003cb\\u003e- ด่านฝึกสมอง:\\u003c/b\\u003e นับที่นั่ง เทียบจำนวนผู้โดยสาร และใช้กลยุทธ์ 🧠\\u003cbr\\u003e\\u003cb\\u003e- การไหลของผู้โดยสาร:\\u003c/b\\u003e ดูผู้โดยสารจำนวนมากขึ้นรถบัสสีสด และเปลี่ยนความวุ่นวายให้ลื่นไหล\\u003cbr\\u003e\\u003cb\\u003e- บูสเตอร์หลากหลาย:\\u003c/b\\u003e เลือกเครื่องมือสำหรับรถและผู้โดยสารเมื่อสถานียากขึ้น ✨\\u003cbr\\u003e\\u003cb\\u003e- สถานี 3D สดใส:\\u003c/b\\u003e เพลิดเพลินกับรถบัสสีสวย ผู้โดยสารมีชีวิตชีวา และแอนิเมชันลื่นไหล\\u003cbr\\u003e\\u003cbr\\u003eBus Crowd เหมาะสำหรับผู้เล่นที่ชอบเกมรถบัส เกมจอดรถ bus mania ปริศนาจัดสี ปริศนารถติด และความท้าทายแบบ car jam จับคู่ผู้โดยสาร เติมรถ เปิดช่องจอด และควบคุมรถติดให้ได้ ดาวน์โหลด Bus Crowd วันนี้! 🚦\\u003cbr\\u003e\\u003cbr\\u003eติดต่อ: fingerrush.customerservice@outlook.com\\u003cbr\\u003eนโยบายความเป็นส่วนตัว：https://sites.google.com/view/fingerrushofpp/home\\u003cbr\\u003eข้อกำหนดการให้บริการ：https://sites.google.com/view/finger-rush-of-eula/home\\u003cbr\\u003eโทรศัพท์: +85259962997\"],\"Hyper Surfer Games\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/GGGcEmYEIhNPrVnbIX7aOo3Lku13mjNoWOzUJYZ4OkypKIWS_N8Z2sD2TPhYo2VTLz5fZ79eVutXhiDx_dpm\"],null,[172,140,148,255]],null,[\"ประเภท 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,[null,\"เหมาะสมสำหรับทุกกลุ่มอายุ มีความรุนแรงได้เล็กน้อยในบริบทที่ตลกขบขันหรือแฟนตาซี ห้ามไม่ให้มีภาษาที่หยาบคาย\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dbusflow.traffic.puzzle\\u0026rdid\\u003dbusflow.traffic.puzzle\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"ติดตั้ง\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"฿72.00 - ฿3,600.00 ต่อรายการ\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"เล่นฆ่าเวลา\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.idol.livestream.fashion.game\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/715ZhCYn4EAsdcL3xzB-DUx9sPOvZRznya_Y8GDwL2NjcqynNyz_cecoX4dm27zS8QOVPGOmFFEB9IoGFBW6cA\"],null,[213,170,255,255],null,null,null,2],[[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/WW9tJQAAaIELHhZPw3oSbbu2_J4gkXp_b7nzVAvGGbY3Q6W7pEupzS1DS1oCpOBOE1Otf6pWunt48LdxtwIk-g\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/UzBMQM8-DR7S-upYSPhASKhQuV-REnvM9Z4lpZr_RHZLd_lh6EFs-KLscBrwM8MDy8C7faWgjEjhZVcpBk94ZSI\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/RXgG13hbVtcxKvN7QsDLNUYNdV0DR2b_AXFLSP-u8jRUdVjNNj09K2T73umfNVBicz_uKxr46eMuHcxRMaHeNA\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/Gdb425WHsFVah8Bc4yRUz8oLuTN1kFD25BoADjZuvw69Pdxri7wyTAs3OQ67JDrUESMbTmA4q__oQLN_H534QA\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/OoUpm_1KQL-1RRyhgtcn352se0_TpKuzpWyhfUVFOd25fVv0MFUMBRL3CfGoYnj0RQvlegNJvpLXPzyMNjBZ\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/WW9tJQAAaIELHhZPw3oSbbu2_J4gkXp_b7nzVAvGGbY3Q6W7pEupzS1DS1oCpOBOE1Otf6pWunt48LdxtwIk-g\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/UzBMQM8-DR7S-upYSPhASKhQuV-REnvM9Z4lpZr_RHZLd_lh6EFs-KLscBrwM8MDy8C7faWgjEjhZVcpBk94ZSI\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/RXgG13hbVtcxKvN7QsDLNUYNdV0DR2b_AXFLSP-u8jRUdVjNNj09K2T73umfNVBicz_uKxr46eMuHcxRMaHeNA\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/Gdb425WHsFVah8Bc4yRUz8oLuTN1kFD25BoADjZuvw69Pdxri7wyTAs3OQ67JDrUESMbTmA4q__oQLN_H534QA\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/OoUpm_1KQL-1RRyhgtcn352se0_TpKuzpWyhfUVFOd25fVv0MFUMBRL3CfGoYnj0RQvlegNJvpLXPzyMNjBZ\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/WW9tJQAAaIELHhZPw3oSbbu2_J4gkXp_b7nzVAvGGbY3Q6W7pEupzS1DS1oCpOBOE1Otf6pWunt48LdxtwIk-g\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/UzBMQM8-DR7S-upYSPhASKhQuV-REnvM9Z4lpZr_RHZLd_lh6EFs-KLscBrwM8MDy8C7faWgjEjhZVcpBk94ZSI\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/RXgG13hbVtcxKvN7QsDLNUYNdV0DR2b_AXFLSP-u8jRUdVjNNj09K2T73umfNVBicz_uKxr46eMuHcxRMaHeNA\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/Gdb425WHsFVah8Bc4yRUz8oLuTN1kFD25BoADjZuvw69Pdxri7wyTAs3OQ67JDrUESMbTmA4q__oQLN_H534QA\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/OoUpm_1KQL-1RRyhgtcn352se0_TpKuzpWyhfUVFOd25fVv0MFUMBRL3CfGoYnj0RQvlegNJvpLXPzyMNjBZ\"]]],\"Idol Livestream: Fashion Game\",[\"4.5\",4.4752474],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.idol.livestream.fashion.game\\u0026rdid\\u003dcom.idol.livestream.fashion.game\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.idol.livestream.fashion.game\"]],[\"qgJtGmsIPkoTCMOWlLDHkJcDFZ3ncwEd2QAY9PoBDAoKCAASBgoCdGgQALoCQgomCiBjb20uaWRvbC5saXZlc3RyZWFtLmZhc2hpb24uZ2FtZRABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"👗 Idol Livestream: Fashion Game ให้คุณได้เป็นดีไซเนอร์แฟชั่นสำหรับตุ๊กตาของคุณเอง! ด้วยเสื้อผ้า, เครื่องประดับ, และตัวเลือกการแต่งหน้า ที่หลากหลาย คุณสามารถสร้างลุคที่สมบูรณ์แบบให้กับตุ๊กตาของคุณให้โดดเด่นได้ หลังจากแต่งตัวตุ๊กตาเสร็จแล้ว ให้ส่งไปเข้าร่วมการแข่งขันที่น่าตื่นเต้นหรือเข้าร่วมการแสดงแฟชั่นสด!\\u003cbr\\u003e\\u003cbr\\u003e👚 วิธีเล่น: เลือกจากเสื้อผ้าสุดเก๋, เครื่องประดับที่น่าทึ่ง, และทรงผมสวยๆ เพื่อแต่งตัวตุ๊กตาของคุณ เมื่อตุ๊กตาพร้อมแล้ว พวกเขาสามารถเข้าร่วมการแข่งขันแฟชั่นหรือไลฟ์สดในการแสดงแฟชั่นที่ตื่นเต้น ที่จะมีผู้ชมเข้ามาตอบสนองกับการออกแบบของคุณ การแต่งตัวที่ดีจะได้รับการตอบรับเชิงบวกมากขึ้น ดังนั้นให้สร้างสรรค์และสร้างความประทับใจให้กับผู้ชม!\\u003cbr\\u003e\\u003cbr\\u003e🌟 แสดงความคิดสร้างสรรค์ของคุณ: Idol Livestream: Fashion Game คือการแสดงออกถึงรสนิยมแฟชั่นของคุณและสนุกไปกับความตื่นเต้นจากการตอบรับแบบสดๆ ตุ๊กตาของคุณจะกลายเป็นดาวได้ไหม? หรือการออกแบบของคุณจะโดดเด่นในการแข่งขัน? ยิ่งคุณมีสไตล์และสร้างสรรค์มากเท่าไหร่ คุณก็จะได้รับคำชมจากผู้ชมมากขึ้น!\\u003cbr\\u003e\\u003cbr\\u003e✨ พร้อมที่จะเป็นดีไซเนอร์อันดับต้นๆ และไลฟ์สตรีมชุดที่น่าทึ่งของคุณแล้วหรือยัง? ดาวน์โหลด Idol Livestream: Fashion Game ตอนนี้และแสดงทักษะแฟชั่นของคุณให้โลกรู้!\"],\"kiwilab\",\"5,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/Ud_HCJ-GkH-ZLzesHQkMVWd0aBD_Vw-nGU3e85d0Tnlt1Vy6a4gQ_2PVfvdol1DmbxiCB0pfZypdwnNVs7Kf\"],null,[241,238,240,255]],null,[\"ประเภท 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,[null,\"เหมาะสมสำหรับทุกกลุ่มอายุ มีความรุนแรงได้เล็กน้อยในบริบทที่ตลกขบขันหรือแฟนตาซี ห้ามไม่ให้มีภาษาที่หยาบคาย\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.idol.livestream.fashion.game\\u0026rdid\\u003dcom.idol.livestream.fashion.game\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"ติดตั้ง\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"฿110.00 ต่อรายการ\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"เล่นฆ่าเวลา\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.terraform.popodyssey\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/hiIJXRInGWwJBTpz0aCWGQl_JwObxX2Kqg5zxJHumH3k2TcMzUuXJs_rxnDRrUOC1F7ABWLpRDa7al4VAzTgkg\"],null,[241,240,243,255],null,null,null,2],[[null,2,[3840,2160],[null,null,\"https://play-lh.googleusercontent.com/ElV7ZDDpZYG6sE04FlrYbuYziLiBsctSXiEWPdUFQjyBD1bo8R74YLoUI9WxjO0hgHYw3_d_n3HLfvz-V23x\"]],[null,2,[3840,2160],[null,null,\"https://play-lh.googleusercontent.com/yM1WjwLjwfI1fhjmec1tCkL3a0CjF_ckMpEpcdDJmQDSlOUsgVGYu6PUEUobEhBYU7wKCpOaz6EruqMrHohd23E\"]],[null,2,[3840,2160],[null,null,\"https://play-lh.googleusercontent.com/1fkCpzo0-f7MfUMZqWPywIOwo0PcWZslUjD2T5y_uzlo9NDq3F5e9U8ifgATPzFxXeSRZND6hgHEy_HGXu7_HQ\"]]],\"Pop Odyssey\",[\"4.8\",4.8421054],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.terraform.popodyssey\\u0026rdid\\u003dcom.terraform.popodyssey\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.terraform.popodyssey\"]],[\"qgJlGmMIP0oTCMOWlLDHkJcDFZ3ncwEd2QAY9PoBDAoKCAASBgoCdGgQALoCOgoeChhjb20udGVycmFmb3JtLnBvcG9keXNzZXkQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],null,[null,\"ออกเดินทางสู่โลกพัซเซิลสีสันสดใสใน Pop Odysse!\\u003cbr\\u003e\\u003cbr\\u003eแตะกลุ่มบล็อกสีเดียวกัน ทำเป้าหมายของแต่ละด่านให้สำเร็จ และเคลียร์กระดานก่อนจำนวนครั้งในการเล่นจะหมดลง ทุกด่านมาพร้อมความท้าทายใหม่ รูปแบบกระดานที่แตกต่าง อุปสรรคใหม่ๆ และคอมโบระเบิดสุดสะใจ\\u003cbr\\u003e\\u003cbr\\u003eสร้างบูสเตอร์ทรงพลังด้วยการทำลายบล็อกกลุ่มใหญ่ ยิงจรวด จุดระเบิด และผสมชิ้นส่วนพิเศษเพื่อสร้างปฏิกิริยาลูกโซ่สุดตระการตา เมื่อด่านยากขึ้น ใช้ไอเท็มพิเศษเพื่อฝ่าฟันอุปสรรคและเดินหน้าผจญภัยต่อไป\\u003cbr\\u003e\\u003cbr\\u003eฟีเจอร์เด่น\\u003cbr\\u003e\\u003cbr\\u003e• เกมระเบิดบล็อกที่เล่นง่ายและสนุกเพลิดเพลิน\\u003cbr\\u003e• ด่านสีสันสดใสพร้อมเป้าหมายและอุปสรรคหลากหลาย\\u003cbr\\u003e• จรวด ระเบิด และคอมโบพิเศษอันทรงพลัง\\u003cbr\\u003e• บูสเตอร์และไอเท็มช่วยเหลือสำหรับช่วงเวลาท้าทาย\\u003cbr\\u003e• ปฏิกิริยาลูกโซ่สุดสะใจพร้อมเอฟเฟกต์ภาพที่มีชีวิตชีวา\\u003cbr\\u003e• เรียนรู้ได้ง่าย พร้อมพัซเซิลที่ต้องใช้กลยุทธ์มากขึ้นเรื่อยๆ\\u003cbr\\u003e• สนุกกับคอลเลกชันด่านที่ออกแบบอย่างพิถีพิถันและเพิ่มขึ้นอย่างต่อเนื่อง\\u003cbr\\u003e• เล่นได้ตามจังหวะของคุณเองทุกเวลาที่ต้องการ\\u003cbr\\u003e\\u003cbr\\u003eคิดให้รอบคอบ เลือกบล็อกให้ถูกต้อง และใช้ทุกการเล่นให้คุ้มค่า การระเบิดที่วางแผนมาอย่างดีสามารถกำจัดอุปสรรค เปิดใช้งานบูสเตอร์ และเปลี่ยนกระดานที่ยากให้กลายเป็นชัยชนะสุดตระการตา\\u003cbr\\u003e\\u003cbr\\u003eไม่ว่าคุณจะอยากเล่นพัซเซิลสั้นๆ เพื่อพักสมอง หรือสนุกกับการระเบิดบล็อกเป็นเวลานาน Pop Odysse ก็มอบประสบการณ์ที่ผ่อนคลายและคุ้มค่าให้แก่แฟนเกมพัซเซิล\\u003cbr\\u003e\\u003cbr\\u003eเริ่มต้นการผจญภัยอันสดใสของคุณตอนนี้ แล้วมาดูกันว่าคุณจะผ่านได้กี่ด่าน!\"],\"Bigiku.com\",\"100,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/TQmjXtPUq8qhEucx9D6571O5WWUxLWu2QmpgYY253EV7C4i6L_s1u-tWhEsXwj9J9pcAGWF-Bt_JLEebdkMOn0A\"],null,[122,152,246,255]],null,[\"ประเภท 18+\",[null,2,[366,512],[null,null,\"https://play-lh.googleusercontent.com/QNpsl4k43vdbfwUAlVLZul2W5O5MUGOToystzghc97mljVHbUwtc639tahcuDsAVHdaGMyZA40AmMVcB_ws\"]],[null,\"รางวัลเงินสด\"],null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/stIOCymv1bYIi3UU_owFeyNt30CkUXbNlDj81ZWtjW9NBIMJxI47i_psYIr0Ho430Rm6mByCGNLORloB\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.terraform.popodyssey\\u0026rdid\\u003dcom.terraform.popodyssey\\u0026feature\\u003dmd\\u0