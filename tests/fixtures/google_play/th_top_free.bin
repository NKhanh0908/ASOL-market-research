,null,\"https://play-lh.googleusercontent.com/apxMULO6cVV-PDE_1p2KQra27FaYvUpW1OVdAoUx2UzAv6KxYWWz3umjbNm1ASyRw6x4LHVx9Nz9xDaKliKUPw\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/KLR5MXPmQ6wcQ3kYJ7j9EV5K8A0gal1XUkbiVRDWNxMRJumBQWCALOTXYt7JXSIJwLi71IEd0s8AAz_a0yPoHWg\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/5LKKyJLQOEBgT7jUVqLJbY6opFzeTUbatmO7o1a5WpfjT_JULQBX7N3zy99XdPgi4lY7yDbRPYR_mHyo61wLncc\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/op5km-TgpO3PVE2dmiRw5IYF9WFfiVgV20Aarz4eTbVAULuD3wWpdUmyK-6_5vzDa1LU__SJ2w4XBb164lWYUew\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/T_ljvMqlmYza7sku3t5UHPoPGp_SMXxKLWtc6Oyu3EHb7VLiZsLDZq_SvKmaA88ycFLkQLbkkQ22bhaicclk76k\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/oUIjWud991fkvi1R0mp-LeO7-Q08QjpS_anIPGXSpLszDh_MX3JK0iObOLY2nOTfAa7FteRvL2SO5_oziNC8kw\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/z-wW-CAqGkYPco8S9vo6ETYK-Sjvu5l164vQDWht5rSR099ZbEpf8SZE07i6EqZnbmTx7lGRMXjib06uduP3\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/jCC7ki4hI6zarSSyPh61NPWny9vb3ZxNHieegzZOC1xnms8SFV9fjFRp4RhHvT5rClplA5QfFMCmwhcHDgtfMwU\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/AtW2ayHTjlBaXQqQ1Np_qOdstfUNcUYqX5Tv22_J48nooJSNZPRGaCBasuMTZgyxuUAoK2pWrUBknPR7Ev7z3g\"]]],\"Glow Fashion Idol\",[\"4.9\",4.893151],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.crazylabs.fashion.squad\\u0026rdid\\u003dcom.crazylabs.fashion.squad\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.crazylabs.fashion.squad\"]],[\"qgJoGmYIKkoTCMOWlLDHkJcDFZ3ncwEd2QAY9PoBDAoKCAASBgoCdGgQAboCPQohChtjb20uY3JhenlsYWJzLmZhc2hpb24uc3F1YWQQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],[[[null,null,\"j8v9nIa9l2c\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:j8v9nIa9l2c?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:j8v9nIa9l2c\",null,[1280,720],null,null,\"AXH1ezn2UXwWaJ5Ce6-G-gbUJEvg-wWq-LWd_C7hV97U49jIA2yR_A-_Sv4L1zUjF2sGFxULIgo6nIuuzM8ZTifNlREg_f3klbTkoAvUlZicNOHHETvu2qNHkvgdsvmzjF2q0NvPW-bBuyBln6pBnQkEuBmgn0OSThofhbx_fXIjJx4yuAjm8RXN9t2ZST906lTbbusH8OFsW9YeokOdbkJlthTfxhY9GzlR-4TpV2D4ezRvIiFLJe9dqAF3RapYJ5XxQxpZNIhc_0vftxh3fAS66fwU_VVZOR5hBMNWw_5XzkclDQ\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/j8v9nIa9l2c/hqdefault.jpg\"]]]],[null,\"Welcome to Glow Fashion Idol — a fashion makeover and dress-up game where every client has a moment to shine, every look creates a glow-up, and every style choice brings you closer to becoming a Fashion Idol.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eCreate Client Glow-Ups\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003eGet ready to embrace the glamorous world of Glow Fashion Idol! Step into the spotlight as a talented fashion stylist and create breathtaking outfits for clients in a dazzling dress up and makeover story. Showcase your makeover skills in the makeover studio and rise through the fashion industry.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eLive Your Fashion Story\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003eImmerse yourself in the captivating fashion story, where you\\u0026#39;ll encounter exciting challenges, inspiring fashion shows, and a chance to transform into a true fashion idol and super stylist. Express your creativity by putting together incredible glam outfits, each telling a mesmerizing makeover story.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eStyle, Customize \\u0026amp; Shine\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003eWith a wide variety of designer outfits and accessories at your fingertips, this dress up game will provide endless possibilities to style and customize your model. Show off your impeccable taste in fashion, dress up in stunning outfits, and let your creativity shine!\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eKey Features\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003e• Dress up your virtual models with an extensive wardrobe collection filled with glam outfits.\\u003cbr\\u003e\\u003cbr\\u003e• Unlock makeup styles and hairstyles to create a signature look in the makeup studio.\\u003cbr\\u003e\\u003cbr\\u003e• Add friends and join runway events together in the world of fashion.\\u003cbr\\u003e\\u003cbr\\u003e• Compete in the fashion battle to prove your fashion stylist expertise.\\u003cbr\\u003e\\u003cbr\\u003e• Enter an exciting fashion story filled with captivating challenges.\\u003cbr\\u003e\\u003cbr\\u003e• Participate in the fashion show to gain recognition as the Glow Fashion Idol.\\u003cbr\\u003e\\u003cbr\\u003e• Create stunning client glow-ups in the makeover studio.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eBecome the Glow Fashion Idol\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003eGlow Fashion Idol is not just a makeover story, but a journey into the glitzy and chic world of fashion. Are you ready to become the ultimate Glow Fashion Idol? Play now and start your fashion adventure!\\u003cbr\\u003e\\u003cbr\\u003e*In-App purchases may include random items.\\u003cbr\\u003e\\u003cbr\\u003eTo opt out of CrazyLabs sales of personal information as a California resident, please visit the settings page within this app. For more information visit our privacy policy: https://crazylabs.com/app\"],\"CrazyLabs LTD\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/OczMKxnbqRQbOQNjeDYlINHJr116G9drf5J3iWcmlgr5oszdm0tKCg0zNsehOWDrkudCasz1JJqBsNr4feUdN1g\"],null,[162,154,153,255]],null,[\"ประเภท 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"การซื้อในเกม\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.crazylabs.fashion.squad\\u0026rdid\\u003dcom.crazylabs.fashion.squad\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"ติดตั้ง\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"฿10.35 - ฿1,025.00 ต่อรายการ\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"เล่นฆ่าเวลา\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"org.hongkong.bwbang.a\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/rYkedumM9L7C0biVYZ-4P8NPcMrdf8fs-jo7sbBLY6dNyyZlO1CVeS318R1hKItkKkSuDstfhJMI5O0u-zcxqD8\"],null,[109,71,80,255],null,null,null,2],[[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/vZ1f3Gw0P2dBdsrMCu9T9yE3BSNun4H-bBMqULvQba-95V5cyixOcHlCNGbwrk6AsvykkoAXJjEA6QatRw1DjQ\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/3xodrS6fUg-yftzL0ORZg82rflI5WQ3yi1BRGgeDJl9IKEP1ReYtEsrLYqWjTBgh2u40dkl-5VWQVKuv2JDIN2g\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/C1TLksyqDWfw0YoKvxBatZRSMpThJesw2OXavQ9fFUfYt1hKBhKsHKZMYx2HHvgMEfVGYOuUax-swRYF3ajF5Q\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com