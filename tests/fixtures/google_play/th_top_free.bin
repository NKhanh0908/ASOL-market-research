eusercontent.com/OLxK-NFVFqQTx14CV8rN36y7gLA0zZ73uvEqQNRgmbAMbd8KRYzzljmzkJsLWajbJDX5ywL89qUWSwtFWumZvQ\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/AGHo0azXNuzxJRjPmFfJPGwyjUjZR9lXHLNnL-ZTnzu0rTclWbxuLokkYo3v9_xWrij-jAbTGD1XzCrW72Oodw\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/Q5aJTWkP7deJcIo31YojbIXp_VtdVLoQe_oCvybJzoPDt9L3TzNzOBb7TjI7sKd5BHxxkxwRmotmjLEDTowj\"]]],\"Perfect Makeover Cleaning ASMR\",[\"4.6\",4.5686274],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.hmbl.perfect.makeover.cleaning.asmr\\u0026rdid\\u003dcom.hmbl.perfect.makeover.cleaning.asmr\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.hmbl.perfect.makeover.cleaning.asmr\"]],[\"qgJ0GnIILEoTCMOWlLDHkJcDFZ3ncwEd2QAY9PoBDAoKCAASBgoCdGgQAboCSQotCidjb20uaG1ibC5wZXJmZWN0Lm1ha2VvdmVyLmNsZWFuaW5nLmFzbXIQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],null,[null,\"Relax, clean, and transform messy objects with soothing ASMR satisfaction!\\u003cbr\\u003eStep into Perfect Makeover: Cleaning ASMR, the ultimate oddly satisfying game where your mission is simple — wash, wipe, and restore dirty objects to sparkling perfection. Enjoy calming ASMR sounds with every tap and swipe in this relaxing cleaning simulation.\\u003cbr\\u003e\\u003cbr\\u003eFrom rusty tools to dusty objects, every scrub brings instant joy. Watch grime fade away and objects shine again in one of the most satisfying cleaning games ever created.\\u003cbr\\u003e\\u003cbr\\u003e🧼 Satisfying Cleaning Gameplay\\u003cbr\\u003eWash, wipe, scrub, and polish messy objects.\\u003cbr\\u003eRestore old tools and decorative pieces to flawless perfection.\\u003cbr\\u003eRealistic cleaning effects for pure satisfaction.\\u003cbr\\u003eASMR sounds with every spray, swipe, and tap.\\u003cbr\\u003e🎧 Relax \\u0026amp; De-Stress\\u003cbr\\u003eSoothing water sprays, soft scrubbing, and polishing sounds.\\u003cbr\\u003eIdeal for stress relief, relaxation, and calming your mind after a busy day.\\u003cbr\\u003ePlay at your own pace.\\u003cbr\\u003eDownload Perfect Makeover Cleaning ASMR now turn mess into perfection with this ultimate satisfying cleaning game!\"],\"Game District LLC\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/KkcYlNfNeZzSO8RD5yC0SqXU7WweQ-A_tghI8GtdFcR7BZ54v4B7sZc2PcJ6BV_kpCjqJenJSvdoq1lNnE5bwg\"],null,[211,179,125,255]],null,[\"ประเภท 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,[null,\"เหมาะสมสำหรับทุกกลุ่มอายุ มีความรุนแรงได้เล็กน้อยในบริบทที่ตลกขบขันหรือแฟนตาซี ห้ามไม่ให้มีภาษาที่หยาบคาย\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.hmbl.perfect.makeover.cleaning.asmr\\u0026rdid\\u003dcom.hmbl.perfect.makeover.cleaning.asmr\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"ติดตั้ง\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"฿35.00 - ฿175.00 ต่อรายการ\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"เล่นฆ่าเวลา\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,nu