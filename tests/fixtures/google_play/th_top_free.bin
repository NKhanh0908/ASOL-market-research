2,[2688,1242],[null,null,\"https://play-lh.googleusercontent.com/RKAKHEMAZ_R2T41fMuaIT8V8hwTmR_d4YBI47GGRsmOo0YoyF0tAnf8nFrNTqEqCuo6m_aVn02Vd9G8FxJ7Ag4M\"]],[null,2,[2688,1242],[null,null,\"https://play-lh.googleusercontent.com/nHbm0qYTUyNvAGOuNikCDHIPazPT5qLyMM9gcyVE9k38D3_MbBcMXa850xB2OQYApF4dNcLTCDyEafRwEQNFL44\"]],[null,2,[2688,1242],[null,null,\"https://play-lh.googleusercontent.com/39u5I5NI4PJFiAPAOeHPftlN80A7zTMzRom3rfiWP4dhNr7Jtb_8pGh-FNbkTWYncb6kzB_lPLOKhrp47ubYQA\"]],[null,2,[2688,1242],[null,null,\"https://play-lh.googleusercontent.com/BB9DlRVmcsuz9RLjWCVEa-qHt_bYQRf__67KU6T7Dr_LqAraMlQB_iVKBz7LuhQw0fG65I7RgJVYAn_ptyC6l7k\"]],[null,2,[2688,1242],[null,null,\"https://play-lh.googleusercontent.com/RCIVceWmNXBOHY5dUKN9YgZb31L4OW1AUHWeXfj-bf-TH-Cb_RQJRAk4VVZtsrlIIW3Kph8PgaTpg_hRqu30Jg\"]],[null,2,[2688,1242],[null,null,\"https://play-lh.googleusercontent.com/RKAKHEMAZ_R2T41fMuaIT8V8hwTmR_d4YBI47GGRsmOo0YoyF0tAnf8nFrNTqEqCuo6m_aVn02Vd9G8FxJ7Ag4M\"]],[null,2,[2688,1242],[null,null,\"https://play-lh.googleusercontent.com/nHbm0qYTUyNvAGOuNikCDHIPazPT5qLyMM9gcyVE9k38D3_MbBcMXa850xB2OQYApF4dNcLTCDyEafRwEQNFL44\"]],[null,2,[2688,1242],[null,null,\"https://play-lh.googleusercontent.com/39u5I5NI4PJFiAPAOeHPftlN80A7zTMzRom3rfiWP4dhNr7Jtb_8pGh-FNbkTWYncb6kzB_lPLOKhrp47ubYQA\"]]],\"No WiFi Mini Games-SeaGame\",[\"4.3\",4.263158],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dai.seagames.app\\u0026rdid\\u003dai.seagames.app\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dai.seagames.app\"]],[\"qgJcGloIT0oTCMOWlLDHkJcDFZ3ncwEd2QAY9PoBDAoKCAASBgoCdGgQAboCMQoVCg9haS5zZWFnYW1lcy5hcHAQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],null,[null,\"SeaGame is a casual mini games app made for quick fun anytime, anywhere. Play a variety of offline games and no WiFi games in one simple app, including puzzles, cards, racing, runner games, brain games, blocks, sorting games, arcade challenges, and more.\\u003cbr\\u003e\\u003cbr\\u003eNo WiFi? No Problem\\u003cbr\\u003e\\u003cbr\\u003eEnjoy mini games without WiFi or mobile data. SeaGame is designed for moments when you want to play offline, whether you are traveling, commuting, waiting, relaxing at home, or simply looking for quick entertainment.\\u003cbr\\u003e\\u003cbr\\u003eMany Mini Games in One App\\u003cbr\\u003e\\u003cbr\\u003eDiscover different types of games in one place. From puzzle games and brain games to card games, racing games, runner games, block games, sorting games, and casual arcade games, SeaGame gives you more ways to play without installing many separate apps.\\u003cbr\\u003e\\u003cbr\\u003eEasy to Start\\u003cbr\\u003e\\u003cbr\\u003eSeaGame is simple and fast. Open the app, choose a game, and start playing in seconds. The controls are easy to understand, making it suitable for short breaks, daily relaxation, and casual fun.\\u003cbr\\u003e\\u003cbr\\u003ePuzzle, Brain, Cards \\u0026amp; Arcade Fun\\u003cbr\\u003e\\u003cbr\\u003eTrain your brain with puzzle and logic games, relax with sorting and block games, enjoy classic card-style challenges, or jump into fast mini games when you want quick action. SeaGame brings different play styles together in one lightweight experience.\\u003cbr\\u003e\\u003cbr\\u003eLightweight and Convenient\\u003cbr\\u003e\\u003cbr\\u003eSeaGame is built for smooth casual play with simple navigation and a clean game library. It is easy to browse, easy to play, and ready whenever you want a fun break.\\u003cbr\\u003e\\u003cbr\\u003eWhy Choose SeaGame?\\u003cbr\\u003e\\u003cbr\\u003e• No WiFi games and offline mini games\\u003cbr\\u003e• Puzzle, card, racing, runner, brain, block, and arcade games\\u003cbr\\u003e• Quick play for short breaks\\u003cbr\\u003e• Simple controls for casual players\\u003cbr\\u003e• One app with many ways to play\\u003cbr\\u003e• Great for travel, commuting, waiting, and relaxing\\u003cbr\\u003e\\u003cbr\\u003eSeaGame gives you a simple way to enjoy mini games anytime. No WiFi needed. Just open, pick a game, and play.\"],\"Seaart ai\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/a392lPKsXs-i8FhHtU2ZWNQqm5jdqtzmeQjNpdeGgop5GwKfuolqRzMESi8QojdswV-6LK1vqsKOvL_BTK9-qQ\"],null,[6,3,92,255]],null,[\"ประเภท 7+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/1SrNtAwg9PFOhgMJPXehacRTeQNhHhG12Pj1zACHNVmfRfEZA3_oOEmLvRNsmYGeGHpas7sCwyR3y8OT\"]],[null,\"ความรุนแรงโดยนัย\"],null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/JTT-ImEkrbWzIL7w0fP8fQhVmpexdfh7u0P59PJtyJywmQBVolJjunMal6B5dUM6uiFiKnmtHtBbVvcWBMU\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dai.seagames.app\\u0026rdid\\u003dai.seagames.app\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"ติดตั้ง\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"เล่นฆ่าเวลา\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.jgame.relaxgames\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/Tvk5XZ6BU1JTeNmGbmZk5prPef-2M1tH-U9BoIrSidGjsK3vLtMTShWB0bgPKolbAtwxe3x6S6s6wfR7Z9n2Iw\"],null,[249,249,250,255],null,null,null,2],[[nul