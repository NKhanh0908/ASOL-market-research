y-lh.googleusercontent.com/Xp3eL8PfClRDR89YDmefDVO09HQe24q0cMB16JByxoLCGzfqj34qS3ZH2J2Yv21R5UINMKaeJrFjkh-0A8lR5w\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/mwyUGjmkVXdBzgrp4PVxKuRBMGQlUn-UDDeOjeEOn4-6tAXPkLHwWdjaoKegJfmwfQnCFOlVtZ8oX9Twrgol\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/Vt5AorfrBqbuCJYDyW13WOiy5cX6JIEZiH77yXRtscJzfevG2KokrEjmyr_fibY_fgpzb1d3qIeQUJpYN3FUY9E\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/Q2CKyauYnEdqyoHqpLJd7XS0cZeu1e-1N06aqltWYhfqGtsIPnihkUqd9Z9VbyQZRS0WOUCiXupdSAiA45vkvg\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/NjFciZsBXsptVMzlpmHT1e1WzqidBBQJWhoLS2nuKRav6JmhMZbrI8g7ZoQ2QZOmJoEOH4-Xo8s0WMMNKT8z\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/1D-K6d4hNoR1x9DY96geF91UIJ4dy_UcNfMf6c6li_RwHYe92mExgDaXr5YyyIMUVpCjoFxYu4Uikotph2E-WA\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/OxcG_zvnmHnkMJe2atEhxNcWneL4jqSMqlsSqq1JtK24UL7Ont3aQ1zhPBabNRQj_bM-Uy0GqDlhs2sr2boD\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/cQdCjs4CawuNvYvu9u7-W0-9Pj8LHIIBwsSjZc_hx7H5iMo8BbZNQtzj7m8op9Po6Ekm3MXntTzbu3YDsUqleQ\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/Xp3eL8PfClRDR89YDmefDVO09HQe24q0cMB16JByxoLCGzfqj34qS3ZH2J2Yv21R5UINMKaeJrFjkh-0A8lR5w\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/mwyUGjmkVXdBzgrp4PVxKuRBMGQlUn-UDDeOjeEOn4-6tAXPkLHwWdjaoKegJfmwfQnCFOlVtZ8oX9Twrgol\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/Vt5AorfrBqbuCJYDyW13WOiy5cX6JIEZiH77yXRtscJzfevG2KokrEjmyr_fibY_fgpzb1d3qIeQUJpYN3FUY9E\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/Q2CKyauYnEdqyoHqpLJd7XS0cZeu1e-1N06aqltWYhfqGtsIPnihkUqd9Z9VbyQZRS0WOUCiXupdSAiA45vkvg\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/NjFciZsBXsptVMzlpmHT1e1WzqidBBQJWhoLS2nuKRav6JmhMZbrI8g7ZoQ2QZOmJoEOH4-Xo8s0WMMNKT8z\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/1D-K6d4hNoR1x9DY96geF91UIJ4dy_UcNfMf6c6li_RwHYe92mExgDaXr5YyyIMUVpCjoFxYu4Uikotph2E-WA\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/OxcG_zvnmHnkMJe2atEhxNcWneL4jqSMqlsSqq1JtK24UL7Ont3aQ1zhPBabNRQj_bM-Uy0GqDlhs2sr2boD\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/cQdCjs4CawuNvYvu9u7-W0-9Pj8LHIIBwsSjZc_hx7H5iMo8BbZNQtzj7m8op9Po6Ekm3MXntTzbu3YDsUqleQ\"]]],\"Idle Cat Gunner: Shooter RPG\",[\"4.8\",4.818182],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.Chodun.CatGunner\\u0026rdid\\u003dcom.Chodun.CatGunner\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.Chodun.CatGunner\"]],[\"qgJhGl8IEkoTCMOWlLDHkJcDFZ3ncwEd2QAY9PoBDAoKCAASBgoCdGgQALoCNgoaChRjb20uQ2hvZHVuLkNhdEd1bm5lchABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,null,[null,null,\"https://www.youtube.com/watch?v\\u003dom7pvunb_1I\"]],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/om7pvunb_1I/hqdefault.jpg\"]]]],[null,\"\\u0026quot;🐱 อุ้งเท้าเล็ก ปืนโต?! เกม RPG ยิงปืนสุดน่ารักมาแล้ว!\\u003cbr\\u003e\\u003cbr\\u003eจะเป็นอย่างไรหากแมวขนปุยแสนน่ารักออกผจญภัยพร้อมกับปืนยักษ์?\\u003cbr\\u003eความน่ารักที่ระเบิดออกมา + พลังยิงที่น่าตื่นเต้น + เกมยิงที่น่าติดตาม!\\u003cbr\\u003eสร้างกองทัพแมวของคุณเองได้เลยตอนนี้!\\u003cbr\\u003e\\u003cbr\\u003eการต่อสู้อัตโนมัติที่ออกล่าแม้ว่าคุณจะไม่อยู่!\\u003cbr\\u003eระหว่างเดินทางไปทำงาน ที่ร้านกาแฟ หรือช่วงพักสั้นๆ แมวของเราก็แข็งแกร่งขึ้นเรื่อยๆ~\\u003cbr\\u003e\\u003cbr\\u003e■ ฟีเจอร์ของเกม\\u003cbr\\u003e\\u003cbr\\u003e▶ คอลเลกชันแมวที่มีเสน่ห์มากกว่า 25 ตัว\\u003cbr\\u003eแมวสไนเปอร์ แมวลูกซอง แมวมินิกัน... ตัวละครที่มีเสน่ห์เฉพาะตัว!\\u003cbr\\u003eความน่ารัก + ความสามารถ + บุคลิกภาพในเกมแนว Idle อย่างแท้จริง!\\u003cbr\\u003eสร้างกองทัพที่แข็งแกร่งที่สุดของคุณ!\\u003cbr\\u003e\\u003cbr\\u003e▶ คอลเลกชันปืนสุดตระการตากว่า 35 แบบ - ความรู้สึกของการยิงที่แท้จริง\\u003cbr\\u003eปืนพก ปืนไรเฟิล ปืนลูกซอง ปืนกล! เกม RPG แนวชูตเตอร์ที่มีอาวุธหลากหลาย\\u003cbr\\u003eปัง! ปัง! การต่อสู้อัตโนมัติพร้อมเสียงยิงที่น่าตื่นเต้น!\\u003cbr\\u003eความแตกต่างระหว่างรูปลักษณ์ที่น่ารักและพลังยิงที่ท่วมท้น!\\u003cbr\\u003e\\u003cbr\\u003e▶ ระบบสังเคราะห์อาวุธ - ความสนุกหลักของเกมแนว Idle\\u003cbr\\u003eรวมปืนที่เหมือนกันเพื่ออัปเกรดเป็นอาวุธที่ทรงพลังยิ่งขึ้น!\\u003cbr\\u003eความตื่นเต้นในขณะที่สังเคราะห์... นี่คือความสนุกที่แท้จริงของ RPG แนว Idle!\\u003cbr\\u003eคุณไม่สามารถหยุดได้กับพลังยิงที่แข็งแกร่งขึ้นเรื่อยๆ!\\u003cbr\\u003e\\u003cbr\\u003e▶ ระบบจุติ - มาตรฐานของการเติบโตที่ไม่มีที่สิ้นสุด\\u003cbr\\u003eไปถึงด่านที่กำหนดและรับความสามารถที่แข็งแกร่งขึ้นผ่านการจุติ!\\u003cbr\\u003eระบบที่น่าติดตามสุดๆ ที่จะแข็งแกร่งขึ้นอย่างระเบิดระเบ้อทุกครั้งที่จุติ!\\u003cbr\\u003eด้วยรางวัลออฟไลน์ แมวต่างๆ จะเติบโตอย่างขยันขันแข็งแม้ในขณะที่คุณหลับ~\\u003cbr\\u003e\\u003cbr\\u003e▶ สำรวจแผนที่ต่างๆ - การผจญภัยที่ไม่มีที่สิ้นสุด\\u003cbr\\u003eป่า ทะเลทราย ทุ่งหิมะ... การผจญภัยที่น่าตื่นเต้นในสภาพแวดล้อมที่หลากหลาย!\\u003cbr\\u003eยิ่งคุณก้าวไปไกลเท่าไหร่ ความท้าทายที่ยิ่งใหญ่และรางวัลที่มากมายก็รอคุณอยู่!\\u003cbr\\u003e\\u003cbr\\u003e■ คนเหล่านี้ควรดาวน์โหลดอย่างแน่นอน!\\u003cbr\\u003e\\u003cbr\\u003e✔ คนรักแมวทุกคนที่ชอบแมวน่ารัก\\u003cbr\\u003e✔ ผู้ที่ชื่นชอบเกมแนว Idle และเกมพัฒนา\\u003cbr\\u003e✔ ผู้ที่ต้องการความรู้สึกตื่นเต้นของเกมยิง\\u003cbr\\u003e✔ ผู้ที่กำลังมองหาเกมสบายๆ สำหรับการเดินทางหรือเวลาว่าง\\u003cbr\\u003e✔ ผู้ที่ต้องการเกมมือถือที่สามารถเล่นได้อย่างสะดวกสบายด้วยมือเดียว\\u003cbr\\u003e✔ ผู้ที่ชื่นชอบเกม RPG แนว Idle ที่มีการต่อสู้อัตโนมัติและรางวัลออฟไลน์\\u003cbr\\u003e✔ ผู้ที่มีความอยากรู้อยากเห็นระเบิดออกมาด้วยการผสมผสาน \\u0026quot;\\u0026quot;แมว + ปืน\\u0026quot;\\u0026quot;\\u003cbr\\u003e\\u003cbr\\u003eแมวน่ารักพร้อมปืนกำลังรอคุณอยู่!\\u003cbr\\u003eดาวน์โหลดตอนนี้และเข้าสู่โลกใหม่ของเกม RPG แนวชูตเตอร์! 🎮🐱🔫\\u003cbr\\u003e\\u003cbr\\u003e-----\\u003cbr\\u003e📩 ติดต่อทีมซัพพอร์ต: support@neptunecompany.kr\\u003cbr\\u003e📄 ข้อกำหนดในการให้บริการ: https://neptunecompany.kr/gameterms\\u003cbr\\u003e🔒 นโยบายความเป็นส่วนตัว: https://neptunecompany.kr/gameprivacy\\u0026quot;\"],\"NEPTUNE(TREEPLLA)\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/1jFVH1ucrVd2ljIga96EmrnmuMiNHdGRJ2f03kj47KTtRdXVICiHZqz5bvCqsQCgRqsk5Mq4bGb6LuQqUloR\"],null,[109,129,63,255]],null,[\"ประเภท 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,[null,\"เหมาะสมสำหรับทุกกลุ่มอายุ มีความรุนแรงได้เล็กน้อยในบริบทที่ตลกขบขันหรือแฟนตาซี ห้ามไม่ให้มีภาษาที่หยาบคาย\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.Chodun.CatGunner\\u0026rdid\\u003dcom.Chodun.CatGunner\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"ติดตั้ง\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"฿35.00 - ฿1,725.00 ต่อรายการ\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"เล่นฆ่าเวลา\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,nul