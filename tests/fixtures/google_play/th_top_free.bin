ll,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/Gh0O9JFd0_QPY7zCkAaquYcYL_DtMW3b3NEGTrbWnnYpaMr0w3zj269oNCEN26D45cP_R1tls374omQdC1_sRA\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/a5fDLmFGpRqRMqeQPIn4M2bOlbU9XVZdiirR5ww0U8_p4HNh0xrHXnUcj-z5VtWFzKZTcnDyXUpCkOkCPWX92A\"]]],\"Fishing Travel\",[\"4.7\",4.6783113],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.arkgame.ft\\u0026rdid\\u003dcom.arkgame.ft\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.arkgame.ft\"]],[\"qgJbGlkIRkoTCMOWlLDHkJcDFZ3ncwEd2QAY9PoBDAoKCAASBgoCdGgQALoCMAoUCg5jb20uYXJrZ2FtZS5mdBABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,\"Q2tI-wc_BbU\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:Q2tI-wc_BbU?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:Q2tI-wc_BbU\",null,null,null,null,\"AXH1eznvxF_PBdVOyzHBfG8FamNzTIJQbSmRFaCLOsH0uxuldCSQL9Py0yqAoptDGaGlOZsbIlfry3s_QQfUT5Q6kbCWi910YVOENwtxn77VJqijjozUm87oEwRYz3ubT9gC0klKDvI3clTaRKKOq3amXn_xEMAxj5Hczvuxlys0nBKGBQY9xyTq2sWJKlwIrgz28VQW54xvY6t8p_ODpW6mGb6QKYqqiTsD2xlJBQR1foDxTi8GoqQeESS8GemOuC6ai_WmFeTgYtSn806MK9FTgsSewhjpP5vqGq2delN2BSVcGA\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/Q2tI-wc_BbU/hqdefault.jpg\"]]]],[null,\"Fishing Travel\\u0026quot; คือเกมตกปลาที่ผ่อนคลายและเต็มไปด้วยการสำรวจ ที่คุณสามารถเลือกได้อย่างอิสระจากหลากหลายสถานที่ ไม่ว่าจะเป็นทะเลสาบ แม่น้ำ หรือแม้แต่ท้องทะเลอันกว้างใหญ่ แต่ละที่ล้วนมีปลาชนิดพิเศษที่ต้องใช้ทั้งทักษะและความรู้ในการตกให้ได้\\u003cbr\\u003e\\u003cbr\\u003eหย่อนเบ็ดแล้วออกเดินทางไปกับประสบการณ์ตกปลาที่น่าจดจำ!\\u003cbr\\u003e\\u003cbr\\u003e***สำรวจ \\u0026amp; เพลิดเพลิน***\\u003cbr\\u003eFishing Travel มีจุดตกปลาสวยงามมากมายให้ค้นพบ จากทะเลสาบสงบเงียบไปจนถึงเมืองจอแจ ทุกคนสามารถดื่มด่ำกับวิวสวยๆ ขณะไล่ล่าปลาที่หายากจากที่อื่นในโลก\\u003cbr\\u003e\\u003cbr\\u003e***แผนการตกปลาแบบกลยุทธ์***\\u003cbr\\u003eยิ่งท้าทายมาก รางวัลก็ยิ่งใหญ่ แต่การจะได้ปลาชั้นยอดก็ยากขึ้นเช่นกัน! เรียนรู้วิธีปรับแต่งและอัปเกรดคันเบ็ดของคุณให้เหมาะกับแต่ละจุดตกปลา แล้วแข่งขันกับนักตกปลาจากทั่วโลกเพื่อชิงรางวัลอันน่าทึ่ง\\u003cbr\\u003e\\u003cbr\\u003e***สร้างสรรค์ \\u0026amp; สนุกสนาน***\\u003cbr\\u003eเมื่อก้าวหน้าในเกม ใช้รางวัลและโบนัสที่ได้มาสร้างสวรรค์ส่วนตัวของคุณ เริ่มจากของตกแต่งชิ้นเล็กๆ ไปจนถึงคฤหาสน์สุดหรู ค่อยๆ สร้างไปทีละขั้นแล้วดื่มด่ำกับความสงบ พร้อมหลีกหนีความวุ่นวายในชีวิตประจำวัน นอกจากนี้ยังมีกิจกรรมสนุกๆ อีกมากมายรอคุณอยู่ เพื่อมอบประสบการณ์ตกปลาในรูปแบบใหม่\\u003cbr\\u003e\\u003cbr\\u003eรออะไรอยู่? หย่อนเบ็ดแล้วเริ่มการผจญภัยตกปลาของคุณวันนี้เลย!\"],\"ARK GAME LIMITED\",\"5,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/pcI0s2KXK2lYngHYwVSTSnGoe3ZD9nZPgYq-q040wlbFcMCpRkTOAzqu8JP90J7JxNjvkPSFK-OlvWjK2s6d4VE\"],null,[33,90,106,255]],null,[\"ประเภท 12+\",[null,2,[366,512],[null,null,\"https://play-lh.googleusercontent.com/yQChfa9XKlaXMIYTk8w8QwChjT8_SH-_2d2SS-kesw0TLQK1nxtw54bDcoZ09freZJgKrtg4f__is-31Vg\"]],[null,\"สยองขวัญ\"],[null,\"การโต้ตอบกับผู้ใช้\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/YrkR-GP7OKghBTATCoO_jJrchSVrh-NSUBb5DnbRZC1DbLK_cgV9FC2e_iI4GzLsKXuZjuFZajnGCiA8qA\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.arkgame.ft\\u0026rdid\\u003dcom.arkgame.ft\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,