\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/aUcPdos5cACptAZLoIppJ9GxEC2lziZzrtSwUgg-wA4Rapk7nAIIVWZRIrl-_axwL_w0BA613Q72MWcF9LywUzM\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/ctAAekqbB-501H_WsRptioINw5cFErR8Dz9iTtvrpCDq1s3gHCkauBMSTRnkEzCgVsVcYCfcP_FOlMpY38zS\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/29zwLKUaq4GJiEhSE_T2sgceJ1t3Rpj_yu5W7HhUHsYvsfImpDCcAB_JLSBkdLbacThtQ_lfrjcQxAKEAaiaeg\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/eO37FaPyD0_jRxuqPgmejHyzdXjhs8C1LPZSqVqb-Yxe857Jd7U-xspgcNRZSNMuKmjoiJYrHSo3IUJfe3P8\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/z0z-FzDH_g_IszyTw8GQz5puGr9yctvWupiuQ1esRp1puAsNBjQrQLNWjAXRL0HqjrBg8uRUrXNGq89uRpmuXQ\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/yoi2gLYnKoSAd2Nx7-pzeRmequr6UwxumnWMFTDHzA40RdiNOzbmIXQLyfRFWKpG6MfYxW8UZY62O2bjYTZD8P4\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/NBAnmV2Nt6C3O-mJB5vEEVLboKuy0wZut7gvBpcSv9Nk2fY6R5RX4yEAdOL-rLrqsFHPEfA2MMTr_vB0maUWog\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/8MSr5L8hzQvY8lSpQ1-zG6BVXDsxQ45JDolm3kFBVn-9c1_sh1TOgX1RyF6ejVkACr7NyA4l-wCwawUsd5Gie2U\"]]],\"Tasty Travels: Merge Game\",[\"4.7\",4.656051],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.fatmerge.global\\u0026rdid\\u003dcom.fatmerge.global\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.fatmerge.global\"]],[\"qgJgGl4IDEoTCMOWlLDHkJcDFZ3ncwEd2QAY9PoBDAoKCAASBgoCdGgQALoCNQoZChNjb20uZmF0bWVyZ2UuZ2xvYmFsEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"\\u0026quot;เริ่มต้นการเดินทางด้านการทำอาหารใน Tasty Travels: Merge Game ที่ซึ่งความหลงใหลในการทำอาหารของคุณมาพบกับความตื่นเต้นของการสำรวจ! ผสานส่วนผสมเพื่อสร้างอาหารชวนน้ำลายสอ ในขณะที่คุณเดินทางไปทั่วโลก!\\u003cbr\\u003e\\u003cbr\\u003eปลดล็อกความลับของอาหารทั่วโลก เชี่ยวชาญอาหารประจำภูมิภาค และแบ่งปันเรื่องราวการทำอาหารของคุณกับเพื่อนๆ ทุกที่!\\u003cbr\\u003e\\u003cbr\\u003eติดตาม Food and Travel: Merge Game บน Facebook เพื่อรับข้อเสนอและการอัปเดตสุดพิเศษ!\\u003cbr\\u003eFacebook: https://www.facebook.com/profile.php?id\\u003d61551040873010\\u003cbr\\u003e\\u003cbr\\u003e🍲 ผสานส่วนผสม 🍲\\u003cbr\\u003e • ค้นพบและผสานส่วนผสมมากกว่า 500 รายการในหลากหลายเลเวล!\\u003cbr\\u003e • ลากและผสานส่วนผสมในครัวของคุณ เพื่อปรุงอาหารจานใหม่เลิศรส!\\u003cbr\\u003e • ทำภารกิจสำหรับนักท่องเที่ยวให้สำเร็จ เพื่อปลดล็อกสูตรอาหารและจุดหมายปลายทางใหม่ๆ ตั้งแต่เมืองหลวงแห่งอาหารอันโด่งดังไปจนถึงจัตุรัสกลางเมืองที่แปลกตา!\\u003cbr\\u003e\\u003cbr\\u003e🌍 เชื่อมต่อกับผู้เล่นคนอื่นๆ 🌍\\u003cbr\\u003e • เชื่อมต่อกับเพื่อนๆ ทั่วโลก แบ่งปันการผจญภัยด้านอาหารของคุณ และทำให้พวกเขาประทับใจ!\\u003cbr\\u003e • แบ่งปันสูตรอาหารเพื่อยกระดับการผจญภัยด้านอาหารของคุณ และจัดปาร์ตี้ทำอาหารเสมือนจริงแสนสนุก!\\u003cbr\\u003e\\u003cbr\\u003e✈️ปลดล็อกจุดหมายการท่องเที่ยว✈️\\u003cbr\\u003e • สะสมเหรียญเพื่อปลดล็อกจุดหมายการท่องเที่ยวใหม่อันน่าตื่นเต้น ตั้งแต่ตลาดในเมืองที่คึกคักไปจนถึงสวนสาธารณะอันเงียบสงบ!\\u003cbr\\u003e • เยี่ยมชมและลิ้มรสบรรยากาศของเมืองแห่งอาหารที่โด่งดังที่สุดในโลก ซึ่งแต่ละแห่งเต็มไปด้วยรสชาติและวัฒนธรรมอันเป็นเอกลักษณ์!\\u003cbr\\u003e • ดำดิ่งสู่ความท้าทายตามจุดหมายใหม่แต่ละแห่ง ไขปริศนาเกี่ยวกับการทำอาหารเพื่อความก้าวหน้า!\\u003cbr\\u003e • ค้นพบอัญมณีที่ซ่อนอยู่ในเมืองที่มีเสน่ห์ ที่ซึ่งเชฟท้องถิ่นท้าทายคุณด้วยสูตรอาหารต้นตำรับของพวกเขา\\u003cbr\\u003e\\u003cbr\\u003e📖 เรื่องราวที่น่าติดตาม 📖\\u003cbr\\u003e • ออกเดินทางในเรื่องราวอันน่าหลงใหลที่จะพาคุณไปยังเมืองต่างๆ ซึ่งแต่ละเมืองมีความลึกลับและสูตรอาหารเฉพาะตัวให้ค้นพบ!\\u003cbr\\u003e • ช่วยให้เด็กสาวไล่ตามความฝันในการเป็นบลอกเกอร์ สำรวจความลับของครอบครัวของเธอ ในระหว่างการเดินทางไปทั่วโลกกับเพื่อนๆ ของเธอ\\u0026quot;\"],\"Century Games PTE. LTD.\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/W6HK6kBNU5u3L-SCl64Zmnt2jM3Dd-_95DtfhSc0eMN8o-r54ZzVXzm6t8LRLXbjm5JXhr3vxRYTkmvdLYQmdRI\"],null,[61,131,97,255]],null,[\"ประเภท 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"การซื้อในเกม (รวมถึงรายการสุ่ม)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.fatmerge.global\\u0026rdid\\u003dcom.fatmerge.global\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"ติดตั้ง\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"฿35.00 - ฿3,700.00 ต่อรายการ\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"เล่นฆ่าเวลา\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.gps.draw.flag.coloring.games\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/ldlY5oBrcvvkG2egRGKpljeXnHS9DdQBioXtGP2jOd9gQQq2WYsfrWqyZM44Lc56X1MdkWvyYbQz81ZDYJU0NA\"],null,[254,253,251,255],null,null,null,2],[[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/pNR01_B9yxIqf3Gf7J1UWLxb_LLOWahtKvbaPkKZXKmrXmLuDm1JrP8ele0Ev