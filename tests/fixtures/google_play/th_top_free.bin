EYPPhub61VrkI9VKxoNcI_TunUiOE9fCZIDECTUq77KA\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/6WTkywGzu16eg17_W-sBh6TpUcr6KCshLZroTqU0PYK9IALNjjg1UL8hLJqRyzQo3_6UMYkUGAl9r5Ek-JNEMco\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/LruUXnWrkQosR4KXz4e07zwrMfbYJm-nw-vkSXdYnBJn6IYx0lFUcH6rQ5AE1uJKYBW-2R9XtaV0gstwLIBnz6M\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/hMZ8ZZqEl6vjLlENi4N4Yvx_4K1ptdcjB1fdJpCUUxPwHk-Lqbs-nkwbCEP1DG-wLceQUtGupBfk9kjfdTwWlA\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/owXBfgUmGh-2HswO0nLBbkCG41UnsSTzNyqCY08tBxYxUnJJ9H6a58G-KhjR8_PqnyR5405QSENbOPgcmWcOxQ\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/fswRVh-7sYz5LiGSyCy0DVcR3AtASzpw5ojfm02C1Y6dqE4F2mZUKKiOxU9KQlPEz1GMbocHCcsO2dF_Eg5rOg\"]]],\"Find the Alien\",[\"4.1\",4.126697],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dnet.wyvernware.whosthealien\\u0026rdid\\u003dnet.wyvernware.whosthealien\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dnet.wyvernware.whosthealien\"]],[\"qgJoGmYII0oTCMOWlLDHkJcDFZ3ncwEd2QAY9PoBDAoKCAASBgoCdGgQALoCPQohChtuZXQud3l2ZXJud2FyZS53aG9zdGhlYWxpZW4QARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],[[[null,null,\"eeUWWsxasm0\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:eeUWWsxasm0?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:eeUWWsxasm0\",null,null,null,null,\"AXH1ezkVAaujk6ZTYvO5hi9XcnLEtLXhqymY6ZxonJt8NLGcc7dZv4K6NMX5SsvhbUEEvubxcsTCSrhy-la1l5dx1RgQMyvZHroCrJNANy6qvELzAyrU_1dWnHWMfTfw7ywrT6FC1d45Z393E7S72mh8vp3DQNZcSu37OvKvGMSj1WK_SILkEO8Stacl1eufn6IrEqfIzFP94RcpT6X2IjXgBZJb01oe4oz0P4NcEwrXpceGl8uGosuRwbY7tt7OpJLysXY4k-K_CGK-M1rl3IOSeJ6iyHBjZQKy3fY-3moSMfJq0w\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/eeUWWsxasm0/hqdefault.jpg\"]]]],[null,\"กำลังมองหาเกมหาคนร้ายอยู่รึเปล่า ชื่นชอบเกมรุกรานแบบ 3 มิติไหม เกมตามหาเอเลี่ยนเป็นเกมแสนสนุกที่เล่นง่าย โดยคุณมีภารกิจที่จะต้องหยุดยั้งการรุกรานของเอเลี่ยน ตามหามนุษย์ต่างดาวที่ซ่อนตัวในหมู่พวกเรา แล้วสังหารเอเลี่ยนในเกมหาคนร้ายนี้ แถม\\u003cbr\\u003e\\u003cbr\\u003eเกมค้นหาเอเลี่ยนเกมนี้ยังเล่นง่ายมากอีกด้วย มนุษย์ต่างดาวได้ปลอมตัวเพื่อซ่อนตัวอยู่ท่ามกลางพวกเรา และพวกมันก็ดูเหมือนกับคนทั่วไป คุณมีเป้าหมายที่จะต้องสังหารเอเลี่ยนทั้งหมดในเกมจับเอเลี่ยนนี้ ผ่านชุดด่านทั้งหมดในทุกย่าน ปลดล็อกปืนบลาสเตอร์ใหม่ และสังหารเอเลี่ยนที่ซ่อนตัวอยู่ได้มากขึ้น\\u003cbr\\u003e\\u003cbr\\u003eแล้วจะหาตัวพวกมันได้อย่างไรงั้นเหรอ ใช้ปืนบลาสเตอร์ และเครื่องสแกน UFO เพื่อตามหาเอเลี่ยนในเกมจับเอเลี่ยนเกมนี้ ตัวปลอมจะเข้ามาแทนที่สมาชิกในครอบครัว เพื่อนบ้าน ตำรวจ และแม้กระทั่งป้ายบอกทาง สแกนห้องแล้วสังหารเอเลี่ยนที่ซ่อนตัวอยู่ท่ามกลางพวกเรา\\u003cbr\\u003e\\u003cbr\\u003eค้นหามนุษย์ต่างดาวทั้งหมดในย่านเมือง และพิชิตราชาเอเลี่ยน ไปที่ UFO สังหารเอเลี่ยน และปลดปล่อยชาวเมืองให้เป็นอิสระจากการถูกเอเลี่ยนคุมขังเพื่อพิชิตเกมยิงเอเลี่ยนเกมนี้ พร้อมกับหยุดยั่งการรุกรานของเอเลี่ยนในทุกย่าน\\u003cbr\\u003e\\u003cbr\\u003eไฮไลท์หลัก\\u003cbr\\u003e• \\u003cb\\u003e เลือกปืนบลาสเตอร์ \\u003c/b\\u003e ผ่านด่านแล้วรับปืนบลาสเตอร์กระบอกใหม่สำหรับสังหารเอเลี่ยนเป็นรางวัลเพื่อหยุดยั้งการรุกรานของพวกมัน\\u003cbr\\u003e• \\u003cb\\u003e ค้นหาเอเลี่ยนที่ซ่อนตัวอยู่ \\u003c/b\\u003e มีมนุษย์ต่างดาวในห้องหรือบนท้องถนนมากกว่าหนึ่งตัว มนุษย์ต่างดาวในเกมเอเลี่ยนนี้จะมีหน้าตาเหมือนผู้คน นก หรือสิ่งของอีกด้วย\\u003cbr\\u003e• \\u003cb\\u003e ช่วยเหลือชาวเมือง\\u003c/b\\u003e เข้าไปใน UFO แล้วสังหารเอเลี่ยนเพื่อกอบกู้โลก\\u003cbr\\u003e• \\u003cb\\u003e เปิดตำแหน่งที่ตั้งใหม่ \\u003c/b\\u003e ปลดล็อกย่านใหม่ในเกมหาเอเลี่ยนของเรา สังหารเอเลี่ยนที่ซ่อนตัวอยู่ท่ามกลางเราเพื่อจับชาวเมืองคุมขังเอาไว้\\u003cbr\\u003e• \\u003cb\\u003e ค้นพบกลยุทธ์ของเอเลี่ยน \\u003c/b\\u003e พวกเอเลี่ยนจะเจ้าเล่ห์ยิ่งขึ้น และการรุกรานของเอเลี่ยนในแต่ละด่านก็ยากที่จะคาดเดาได้\\u003cbr\\u003e• \\u003cb\\u003e ด่านที่มาพร้อมเรื่องราวต่างๆ \\u003c/b\\u003e แต่ละด่านล้วนมีเรื่องราวและตำแหน่งที่ตั้งของตัวเอง สังหารเอเลี่ยนเพื่อช่วยชาวเมืองจากการรุกรานของเอเลี่ยน\\u003cbr\\u003e\\u003cbr\\u003eดาวน์โหลดเกมตามหาเอเลี่ยน แล้วกอบกู้โลกในเกมค้นหาเอเลี่ยนเลยสิ\"],\"Moonee\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/aijtdwNPAf6bzE269NO-LCUsdSIRlKecufIP7kEHUlqsL2AOiJTag1qINgTtBUM9SFjRPeLrL5_rYtseXYuNXQ\"],null,[160,152,144,255]],null,[\"ประเภท 7+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/1SrNtAwg9PFOhgMJPXehacRTeQNhHhG12Pj1zACHNVmfRfEZA3_oOEmLvRNsmYGeGHpas7sCwyR3y8OT\"]],[null,\"ความรุนแรงน้อย\"],null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/JTT-ImEkrbWzIL7w0fP8fQhVmpexdfh7u0P59PJtyJywmQBVolJjunMal6B5dUM6uiFiKnmtHtBbVvcWBMU\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dnet.wyvernware.whosthealien\\u0026rdid\\u003dnet.wyvernware.whosthealien\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"ติดตั้ง\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"฿125.00 - ฿350.00 ต่อรายการ\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"เล่นฆ่าเวลา\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.charmcolor.sortpuzzle\",7],[null,2,[512,512],[null,null,\"https