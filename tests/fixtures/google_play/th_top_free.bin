48],[null,null,\"https://play-lh.googleusercontent.com/fYwm7eM-DrzdYoen1Q9rnC1OeOhbKCjFnhmlqlhcxUA_y3RpaEyF4F-T8HDd_bYfy_fUouL75hPkd5pQOUYHBA\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/gbmHiXhGkUGRBDfzVbSX2X8L81TKfnDqvSpLjCDVzYzw_TVKC67tA8WGo2BVvokDpm2-HtyLM6k829-kv_oE\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/-YyobtjkhlFX5YL9U51jCDo211qQdL7Zo0vqITLjG6JwUtHt60tfTKpncjDy7gVZO83wCiAweGusUgXoPZLW\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/OxYdsXL3ofXRPylBUE4QC0svYGjD6O1g7gKyCDicWD1j9kJlaeqdqsVbD6_yB0WSMIyD39hXE5fmMzl3JEsn\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/MLAQqmRJhcDythRe0fbaI0M1UjQe4_30jbpf7Eb25AMENcVW71a7QQltNOw0iKOLujCbgQKj3PR-mvY7exx9Wg\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/_CCHmXqsr40UX56CDUc2MCKxglhW5AtNJEviWqSgWD9fGLdMXQCNW4JGaHWPtUdLlWj4UPP7m195O2YhbH2inw\"]]],\"Mini Dress Up \\u0026 Beauty Games\",[\"4.6\",4.56],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.tt.mini.girly.games\\u0026rdid\\u003dcom.tt.mini.girly.games\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.tt.mini.girly.games\"]],[\"qgJkGmIIKEoTCMOWlLDHkJcDFZ3ncwEd2QAY9PoBDAoKCAASBgoCdGgQAboCOQodChdjb20udHQubWluaS5naXJseS5nYW1lcxABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"Collection of Fun and Relaxing Girly Games\\u003cbr\\u003e\\u003cbr\\u003eDive into a fun, creative, and relaxing world made just for you! This girly game is packed with awesome mini games perfect for anyone who loves fashion, beauty, and feel-good vibes. Whether you\\u0026#39;re styling cute characters, creating stunning nail designs, unwinding with soothing ASMR coloring, organizing adorable dolls, or whipping up sweet dessert merges, there\\u0026#39;s always something fresh and exciting to try.\\u003cbr\\u003e\\u003cbr\\u003eEvery mini game is super easy to jump into, totally relaxing, and bursting with creative fun! Whether you’re experimenting with bold makeup styles, designing cool lip art, or tackling fun prince \\u0026amp; princess line draw puzzles, this collection has tons of ways to let your personality shine and just chill out.\\u003cbr\\u003e\\u003cbr\\u003eWhat’s Awesome About the Game:\\u003cbr\\u003e\\u003cbr\\u003e- Dress Up: Have a blast styling characters with cute, trendy outfits and accessories!\\u003cbr\\u003e- Nail Art: Get creative painting and designing super stylish nail looks.\\u003cbr\\u003e- Makeup Studio: Play with fresh makeup styles and let your beauty creativity run wild.\\u003cbr\\u003e- Lip Art: Craft bold, colorful, and totally unique lip designs.\\u003cbr\\u003e- Color ASMR: Chill out with calming coloring and soothing visuals that feel oh-so-satisfying.\\u003cbr\\u003e- Doll Organizer: Sort and arrange adorable dolls for that perfectly satisfying organizing vibe.\\u003cbr\\u003e- Desserts Merge: Mix yummy treats to create delightful dessert surprises.\\u003cbr\\u003e- Prince \\u0026amp; Princess Line Draw: Solve a fun line drawing puzzle\\u003cbr\\u003e\\u003cbr\\u003eWhy You’ll Totally Love It:\\u003cbr\\u003e\\u003cbr\\u003e- All your favorite girly games packed into one super fun collection.\\u003cbr\\u003e- Perfect for anyone who’s into fashion, beauty, or solving cute puzzles.\\u003cbr\\u003e- Play at your own speed with chill, stress-free vibes that make every moment enjoyable.\\u003cbr\\u003e- Gorgeous visuals and smooth gameplay that feel oh-so-satisfying.\\u003cbr\\u003e- Exciting news: new mini games are coming soon to keep the fun going.\\u003cbr\\u003e\\u003cbr\\u003eWhether you’re styling fabulous outfits, creating stunning nail art, relaxing with calming colors, or diving into fun puzzles, this game has it all. It’s your go-to escape for a daily dose of beauty, fashion, and pure fun!\"],\"Toy Tap LLP\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/l7S-lqcWPBCmF4gzCZkOr_PjDR7a5AVdfJyFBB1b69hUnY93lckHuOK-C2_r4bXbEbbL7rmPmGul1FCS6dpxPg\"],null,[247,213,215,255]],null,[\"ประเภท 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,[null,\"เหมาะสมสำหรับทุกกลุ่มอายุ มีความรุนแรงได้เล็กน้อยในบริบทที่ตลกขบขันหรือแฟนตาซี ห้ามไม่ให้มีภาษาที่หยาบคาย\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.tt.mini.girly.games\\u0026rdid\\u003dcom.tt.mini.girly.games\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"ติดตั้ง\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"฿213.19 ต่อรายการ\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"เล่นฆ่าเวลา\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.farlightgames.pgame.gp\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/nIjO9pFz1R7G_wct00QMBKVqAmLHs2TqiaCmSUJfnKPw7yG_VzSmp26TRGCmm98v-Mye0MtsW_xz8CHNdIFD1A\"],null,[146,43,245,255],null,null,null,2],[[null,