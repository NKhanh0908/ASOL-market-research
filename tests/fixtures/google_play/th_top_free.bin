ll,null,\"https://play-lh.googleusercontent.com/9hHCrN_lNEnBfGbkXNiFIIm_r1iHmHeB56wdWiuGgvo4vkbpAil7wq9fQpxmDOUryse0WmMW9wPq9cBcYKyZKw\"]],[null,2,[1280,720],[null,null,\"https://play-lh.googleusercontent.com/1ZvtT0IUgnhtFdo7gDZkljCpik_jUl3ZVjFczcRdS7DxyB1DLwpaZMst5G1r1nZlHg4_0I5eVuKky0PP5CaVZjM\"]],[null,2,[1280,720],[null,null,\"https://play-lh.googleusercontent.com/ExDtPWBCJIXczcPkNlTAxfae0lnmO_AjfVI74mWRZV4gQLEvQ2Tn8xu0jPmqgLS33LEEr9i2dnFq7jUXq85v4Q\"]],[null,2,[1280,720],[null,null,\"https://play-lh.googleusercontent.com/eAEJvO8zxkcMeYm5LjCgNTGc4KG2VuyBZ5N697X870SpWCvVvjXNk4YVS2olS6W9hcLHRlahtrW_1RLTmCvg\"]],[null,2,[1280,720],[null,null,\"https://play-lh.googleusercontent.com/Mb8ETTeattQ_E3Lc3wwGM8wiygwKyOXgVBHh1zm58GqGtYQJsHvSCjTRn4ZQLrZnJRNdpWdzOIR8nOUBGZPlHQ\"]],[null,2,[1280,720],[null,null,\"https://play-lh.googleusercontent.com/9hHCrN_lNEnBfGbkXNiFIIm_r1iHmHeB56wdWiuGgvo4vkbpAil7wq9fQpxmDOUryse0WmMW9wPq9cBcYKyZKw\"]],[null,2,[1280,720],[null,null,\"https://play-lh.googleusercontent.com/1ZvtT0IUgnhtFdo7gDZkljCpik_jUl3ZVjFczcRdS7DxyB1DLwpaZMst5G1r1nZlHg4_0I5eVuKky0PP5CaVZjM\"]],[null,2,[1280,720],[null,null,\"https://play-lh.googleusercontent.com/ExDtPWBCJIXczcPkNlTAxfae0lnmO_AjfVI74mWRZV4gQLEvQ2Tn8xu0jPmqgLS33LEEr9i2dnFq7jUXq85v4Q\"]]],\"X-Clash\",[\"4.5\",4.456221],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.xman.sea.gp\\u0026rdid\\u003dcom.xman.sea.gp\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.xman.sea.gp\"]],[\"qgJcGloIEUoTCMOWlLDHkJcDFZ3ncwEd2QAY9PoBDAoKCAASBgoCdGgQAboCMQoVCg9jb20ueG1hbi5zZWEuZ3AQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],null,[null,\"The Evil Void tears the continent asunder, while the Undead Plague devours the last remnants of civilization! In this dual apocalypse, only the worthy shall rebuild the realm!\\u003cbr\\u003e\\u003cbr\\u003eTo survive this cataclysm, you must master both strategic command and survival instinct! \\u003cbr\\u003e\\u003cbr\\u003eHere\\u0026#39;s a tip for champions: True power lies not in brute strength, but in forging unbreakable bonds with your companions. Assemble your fellowship wisely - their lineage holds the key to victory.\\u003cbr\\u003e\\u003cbr\\u003eHighlighted Features:\\u003cbr\\u003e\\u003cbr\\u003e- Brand new level experience with multiple choices\\u003cbr\\u003e- Play One-Handed to dominate the continent!\\u003cbr\\u003e- Unveil the mysteries and experience various strategic gameplays\\u003cbr\\u003e- Collect and match, unravel the mysteries of the void\\u003cbr\\u003e- Strengthen your power, and form alliances with others to receive the greatest support!\"],\"Glaciers Game\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/GMu3Xd0ey5lbVYOm7Sn8EUVzX_Y5S3nbK4VJy7jcCbP-gjrMwjynpW1ghloOCIiV836P7frpq8zzvEQ2Gz1G\"],null,[151,212,91,255]],null,[\"ประเภท 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"การซื้อในเกม (รวมถึงรายการสุ่ม)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.xman.sea.gp\\u0026rdid\\u003dcom.xman.sea.gp\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,n