sercontent.com/j4GrueiL-ve6DaULQHkhD_DBKAVucrJuUEnunQG5ZAgOGrv6tDRxo61Epv1atdAaGbm3FJ2uk4-SDoxX-sWC\"]],[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/e_kVgOzGQe0in6A5_ce7TxrfPJkIzW2sm5A1AB_KFapH-9BXpebu4lPGtsQLh8GUakWPfYXrkMxQvW4ySGVYug\"]],[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/r5h6it7EdbkZChRYatZMP48SFcTkbnEjPigtGTfMeCjMMu-5-S8MwhEd3X9gmUoBrQ0FPGG5iY70tnFPsP87\"]],[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/xVq7ZIwP5dW930qN01kwZZcd5QwRzDpalli3K3WRGdsfXGF5YH-iODinuoTFZQFeBg9ibpAM2klji_WTU16A\"]],[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/AEXaGZ2HfgVcbmfNTM_2C_U5x-U2d0KtNbpess44ou8S_TB8W32xv7xAoG6F7B_Xjsd0xtPbZG56cVpI8zF6Zw\"]],[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/4pJ54_D_4JHwT878rxhbd7rFfR1wFqhZWcz88QE_HSQLYirg_6vzJGanJ5R05QEivdx-0t2pNOluYo0bKKY6Mg\"]]],\"Paper Doll Diary: Dress Up DIY\",[\"4.0\",4.04],\"เล่นฆ่าเวลา\",null,null,[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.paperdoll.diary.dressup.game\\u0026rdid\\u003dcom.paperdoll.diary.dressup.game\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.paperdoll.diary.dressup.game\"]],[\"qgJtGmsITUoTCMOWlLDHkJcDFZ3ncwEd2QAY9PoBDAoKCAASBgoCdGgQAboCQgomCiBjb20ucGFwZXJkb2xsLmRpYXJ5LmRyZXNzdXAuZ2FtZRABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"🌈 Welcome to Doll Diary:  Dress Up, where the timeless charm of dolls meets the exhilarating world of fashion dress up! Step into a realm of creativity and style where you become the master stylist of your enchanting doll dress up. With an expansive wardrobe featuring over 1000 fashion items, including the latest in trendy attire, distinctive accessories, diverse hairstyles, and soothing ASMR makeup touches, your creative potential is limitless. \\u003cbr\\u003e\\u003cbr\\u003e🎀 Doll Diary: Dress Up is more than a mere dress up game; it\\u0026#39;s an adventure that unfolds with every outfit and accessory you choose. Not only do you get to design and style your doll, but you also craft her story. From diary entries that capture the essence of your fashion journey to photo shoots that showcase your styling prowess in various scenes, immerse yourself in a narrative of your own making. Navigate through captivating plotlines, face makeover challenges, and let your style decisions shape the destiny of your doll. \\u003cbr\\u003e\\u003cbr\\u003e🎀 Unleash your inner fashionista and transform your doll into a beacon of style. Whether you\\u0026#39;re assembling chic outfits or selecting the perfect accessories, each decision propels your doll into the spotlight, making her a true fashion icon. Your styling choices not only reflect your unique taste but also guide your doll\\u0026#39;s journey through thrilling adventures and challenges. \\u003cbr\\u003e\\u003cbr\\u003e👗 Key Features You\\u0026#39;ll Adore: \\u003cbr\\u003e- A wardrobe brimming with over 1000 fashion pieces, ensuring your doll is always at the forefront of style. \\u003cbr\\u003e- Frequent updates that add even more glamorous and fashionable items to your collection. \\u003cbr\\u003e- An array of personalization options, allowing you to tailor your doll\\u0026#39;s appearance, from clothing and skin tone to eye color, hairstyles, and makeup.\\u003cbr\\u003e- Captivating storylines that evolve with your fashion choices, complete with diary entries and memorable photo ops. \\u003cbr\\u003e- Additional unique gameplay elements that enrich your experience with your adorable doll.\\u003cbr\\u003e\\u003cbr\\u003e💖 Create the ultimate sanctuary for your DIY doll, excel in style challenges, and customize every aspect of her world in this extraordinary dress up game. Doll Diary: Dress Up transcends the typical princess game, inviting you into a universe where fashion, creativity, and storytelling intertwine to offer an immersive and magical experience for all doll enthusiasts. Download Doll Diary: Dress Up now and start the journey toward making your doll a legend in style and grace!\"],\"Brave Labs\",\"50,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/-cGYEIJZxBCAGFLAJErWDhHObjSg1W5dreWI0Vx_jfqGaRgh9KSInx42osauGd_h_b63C9oyCpKPBSvKtwhX\"],null,[255,207,222,255]],null,[\"ประเภท 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eดูข้อมูลเพิ่มเติม\\u003c/a\\u003e\"],true,[null,\"เหมาะสมสำหรับทุกกลุ่มอายุ มีความรุนแรงได้เล็กน้อยในบริบทที่ตลกขบขันหรือแฟนตาซี ห้ามไม่ให้มีภาษาที่หยาบคาย\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"THB\",\"\"]],null,[null,\"ซื้อ\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.paperdoll.diary.dressup.game\\u0026rdid\\u003dcom.paperdoll.diary.dressup.game\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"ติดตั้ง\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"฿72.00 ต่อรายการ\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"เล่นฆ่าเวลา\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.tapblaze.pizzabusiness\