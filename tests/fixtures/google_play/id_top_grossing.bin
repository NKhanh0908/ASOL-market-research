tent.com/SeTto3soqBHyooztWxgmiWenb2GeDjaXwqGTg9uUZF8d0IUkcb6dHt7iTyTT99gjcQojpxQFVWzEc6EgCeLv\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/qV9NgKRBdYd2qy_FUY6DPt-ZAogz2vXX7Te_AEOD9g8tKJn7WP3CSrIwwtw_4aqhwmLw_SFjwZ9F4CxcaZ54\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/gBmTnfDMtKyu05OKjrHhl07-zAzyOX2Yjtgt94FiMlrjgO9fetqSiZWch53kKr3qts6fYRtCvJlu2ezMOpoG\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/emAQsckti6VNV-F4_VAlo-Q8AiNtoo1axlFS5_fuOVSrsLJGaTh4TIisT0q4Gxw-sH8AXKoHE-HydgQlzCrK\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/jbKY1WqAVj0R2DPDSz8-U4qGFYmkohqlnyRoelc3qYLMxqbsHrYvbOeTaI9Uz-9WPnK5KUq3wq1OWEVW_3alejk\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/2mQDpkmQq9cQQPPAbcfRwtxoKmG8F3sxX3FZTmPsi0lYfYIxFXyrrJLvXIugMddRdZhks7RCjbz-SJnqrlQQeQ\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/PYHMCOrn3_u3ooAh_-QCSKSoMvRm3Jo0Mp-Cp7SMY_JCgF_0hPpJNy3FfhF5tARTQ8KWg6QjKZqIttP3wwvVlw\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/et_4G2OmY1ZhqbhJCmibZAJKEIWCDxVJON4t68H6_6XNShsvcCJ4Q9xXoyX7ZS_wAbLH_C2v3awsmEaUOZWliQ\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/SeTto3soqBHyooztWxgmiWenb2GeDjaXwqGTg9uUZF8d0IUkcb6dHt7iTyTT99gjcQojpxQFVWzEc6EgCeLv\"]]],\"Gear Defenders\",[\"4,8\",4.8334737],\"Kasual\",null,null,[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.iogame.gearworld\\u0026rdid\\u003dcom.iogame.gearworld\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.iogame.gearworld\"]],[\"qgJhGl8IS0oTCK/Y2rDHkJcDFSKzrAIdF40jpfoBDAoKCAASBgoCaWQQAboCNgoaChRjb20uaW9nYW1lLmdlYXJ3b3JsZBABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,null,[null,null,\"https://www.youtube.com/watch?v\\u003dS-EyqmFMw_0\"]],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/S-EyqmFMw_0/hqdefault.jpg\"]]]],[null,\"Gear Defenders – A Revolutionary Placement-Adventure Game: Build Your Tactical Fortress, One Gear at a Time\\u003cbr\\u003eTired of strategy games that demand endless grind? Meet Gear Defenders – a fresh blend of \\u0026quot;idle collection\\u0026quot; and \\u0026quot;strategic adventure\\u0026quot; that lets you effortlessly generate powerful troops with simple taps, assembling your very own war machine block by block.\\u003cbr\\u003e【Craft Your War Engine Like a Puzzle】\\u003cbr\\u003ePlace soldiers around the Power Core, and watch them work like magic to continuously spawn combat units. From basic infantry to elite knights, every troop is a \\u0026quot;gear\\u0026quot; in your fortress – drag, drop, and strategize to build the ultimate defense line！\\u003cbr\\u003e【Unlock 10+ Troop Types】\\u003cbr\\u003eOn your adventure, you’ll unlock over 10 unique soldier types: resilient infantry, long-range archers, shield bearers, and even legendary magic knights… Each troop boasts distinct skills and upgrade paths. Level up, enhance, evolve – transform ordinary squads into elite forces, and watch your fortress’s power soar to take on tougher foes.\\u003cbr\\u003e【100+ Challenging Levels】\\u003cbr\\u003eOver 100 meticulously designed levels pit you against tricky enemies: goblins with cunning traps, mummies cursed with dark magic, yetis raging with brute strength… Each enemy faction wields unique attack patterns, while battlefields range from narrow canyons to sprawling plains.Every troop combination could be your winning move.\\u003cbr\\u003eWhether you’re a casual player craving relaxed placement or a hardcore strategist obsessed with tactical depth, Gear Defenders has something for you. Build your war machine with a flick of your finger, witness the growth of your forces from tiny to formidable, and embark on your gear-driven adventure today – download now!\"],\"MOBIBRAIN TECHNOLOGY PTE. LTD.\",\"5.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/rAbNYte2ei9jCyoQln6xVcgdJ3mYln-9UeTJkel2paUCdBoaUzmOtNKMqUEqOOYOhyU4b8DXnvcv9_5xIOKS\"],null,[63,153,229,255]],null,[\"Rating 7+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/1SrNtAwg9PFOhgMJPXehacRTeQNhHhG12Pj1zACHNVmfRfEZA3_oOEmLvRNsmYGeGHpas7sCwyR3y8OT\"]],[null,\"Kekerasan Ringan\"],[null,\"Pembelian dalam Game (Termasuk Item Acak)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003ePelajari lebih lanjut\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/JTT-ImEkrbWzIL7w0fP8fQhVmpexdfh7u0P59PJtyJywmQBVolJjunMal6B5dUM6uiFiKnmtHtBbVvcWBMU\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.iogame.gearworld\\u0026rdid\\u003dcom.iogame.gearworld\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Instal\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"Rp 16.000 - Rp 1.490.000 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Kasual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.crowdstar.covetfashion\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/i2D9lPSfMUtwe_LSsevBpelo0twtty5ihw9KNUIDSKEkKyB1i7zgbLQpD3Rd4c4T5z5CrdpSYx_IQtR309tM0A\"],null,[119,77,57,255],null,null,null,2],[[null,2,[1920,1080],[null,null,\"https://play-