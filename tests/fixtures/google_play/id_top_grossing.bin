,[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/Vwnk46ItfFv_OomjWHjIHzylVr_itxotk5etTDatqGBOz322pFwdd1LZqH0RFCid-Vf6XJe8_DbaPutHtrCUUA\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/h5mV-nhJMgEOSU9rq_ObJSmgOplcRlwmbDdinV-Hx94FhY56TotSNlQu5K8xsY-YyUlrgrJNpgPnf8L6kExGvg\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/1RApha2Z9fncqizIkp7qobVLccFWhNW1Gi9FONvp3eG3bBjjkR_v98_9nTSNmg7wIcmTuOZijCO3-Hte5uSYyAs\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/3TKkd_WH2u-9JPLEpLQW5vMUQ54hFH-8nWf7Dzw3vN_gxsSayfqrFmw4fWu-6QPa6AVolJcqf7LGhceB2wBDig\"]],[null,2,[1200,1920],[null,null,\"https://play-lh.googleusercontent.com/yiwMa3ApCRkjgo4Wp_uX2F2N0MMMTfIrtKuQfT9eOjaD1acsx2Rv83IDmmXCS7-308dvMZj402jNbRzIKP0HHw\"]],[null,2,[1200,1920],[null,null,\"https://play-lh.googleusercontent.com/gmitUFfMCe6MisfwQVxfsrs0AF4kRxcHOIWGLoVfEjsNBA7Tu8RaRImPUCs7kuR3XhPztz9mZ7N27SeL85FNWh4\"]],[null,2,[1200,1920],[null,null,\"https://play-lh.googleusercontent.com/6g-nQkWsdMszfMZAppnCMy-iuivyqP-mqy2uu4_199BrgX3eCKY8kxUwhJe8voXDgs0WjMmKnutIeS50mhLAxxg\"]],[null,2,[1200,1920],[null,null,\"https://play-lh.googleusercontent.com/8ha99GfaW6XhKOFzxwx30dcZw_2YYmnBqKKUXuEBUiMgqnFtWnvBDQtZeemhg5JXEYd4JMvns0jmhbdkv6NtAA\"]]],\"Mobile Armor:Storm\",[\"4,7\",4.688073],\"Kasual\",null,null,[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.salahuna.timeline\\u0026rdid\\u003dcom.salahuna.timeline\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.salahuna.timeline\"]],[\"qgJiGmAIN0oTCK/Y2rDHkJcDFSKzrAIdF40jpfoBDAoKCAASBgoCaWQQAboCNwobChVjb20uc2FsYWh1bmEudGltZWxpbmUQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],null,[null,\"This isn’t just a game—it’s a redefining of the aesthetics of war. As an elite commander on a future battlefield teetering on the brink of collapse, you’ll use a fleet of legendary mechs to turn the tide of humanity’s fate.\\u003cbr\\u003e\\u003cbr\\u003eVisual Dimension: A Symphony of Particles and Steel\\u003cbr\\u003eFully 3D-modeled mechs bring every turn and every shot to life with physically realistic metal textures and dynamic lighting effects. When ultimate abilities are activated, the screen ceases to be an interface and becomes a window onto a battlefield swept by energy storms. Experience the immersive impact of hyper-saturated particle effects and dynamic camera work.\\u003cbr\\u003e\\u003cbr\\u003eThe Path to Growth: Clear, Swift, and Never Stagnant\\u003cbr\\u003eYour journey to power is always marked by defining moments. Victory in battles yields immediate, generous rewards. We ensure that every minute you invest translates into visible combat power gains, equipping you with the strength to dominate even the most perilous battlefields.\\u003cbr\\u003e\\u003cbr\\u003eBeyond Single-Player: Prove Your Absolute Dominance in PvP\\u003cbr\\u003eReal-time Ranked Battles: Engage in the ultimate showdown of wits and card decks against the world’s top commanders. Every victory propels your name higher on the leaderboards.\\u003cbr\\u003e\\u003cbr\\u003eCommander, the final order is clear:\\u003cbr\\u003eThis is not just another mundane adventure, but a universe waiting for you to forge your own legend. Your mech arsenal is ready, and your opponents are gathering online. It is time to answer this call from the stars.\"],\"Salahuna Inc\",\"100.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/JESUngiXXlc7njMl6iUUANY-dw0NdZK_ohwGKPmRCyulxgb7jGgJWwn9qQvJgHjL4Vt9mQcn04HCxiY3QWJ7wg\"],null,[12,24,45,255]],null,[\"Rating 12+\",[null,2,[366,512],[null,null,\"https://play-lh.googleusercontent.com/yQChfa9XKlaXMIYTk8w8QwChjT8_SH-_2d2SS-kesw0TLQK1nxtw54bDcoZ09freZJgKrtg4f__is-31Vg\"]],[null