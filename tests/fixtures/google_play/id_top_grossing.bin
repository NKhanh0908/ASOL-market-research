ull,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.core.biggame.marble.android\\u0026rdid\\u003dcom.core.biggame.marble.android\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.core.biggame.marble.android\"]],[\"qgJsGmoISkoTCK/Y2rDHkJcDFSKzrAIdF40jpfoBDAoKCAASBgoCaWQQAboCQQolCh9jb20uY29yZS5iaWdnYW1lLm1hcmJsZS5hbmRyb2lkEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"Marble Match Origin is an exciting shooting game where you can experience unique challenges and surprises.\\u003cbr\\u003e\\u003cbr\\u003eThe game features multiple difficulty levels , and players need to master the direction and speed of shooting  balls to complete level objectives. \\u003cbr\\u003eAs the game progresses, you will face more and more challenges and difficulties, and you need to constantly improve your skills and reaction speed to complete each level.\\u003cbr\\u003e Download Marble Match Origin now and start your adventure!\\u003cbr\\u003e\\u003cbr\\u003eFeatures:\\u003cbr\\u003e• Game with different difficulty levels and levels！\\u003cbr\\u003e• Gorgeous graphics and animation effects！\\u003cbr\\u003e• Various props and rewards！\\u003cbr\\u003e• Various achievements and leaderboards！\\u003cbr\\u003e• Unique challenges and surprises！\\u003cbr\\u003e• Support offline games！\\u003cbr\\u003e\\u003cbr\\u003eMarble Match Origin is a free game, but certain in-game items may require payment to purchase.\"],\"LeisureLab Studios\",\"10.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/pG051vSyr8FpW2OdPo4cbWcNucz4Zm-QtJ7JgFkAHYLOP3C843ozG2HmuwZlY2az05minKH_1_1Pri5RX2gzyCM\"],null,[183,149,96,255]],null,[\"Rating 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[