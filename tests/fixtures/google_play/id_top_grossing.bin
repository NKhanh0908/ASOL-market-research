"https://play-lh.googleusercontent.com/35B0ljIOTAB3oBRgQYMwhlBp4MBR1T2YsIzxdXWIZVCOQv5OyQkQFxDJGK9wVOabMG9bL8SDMt4iCFvLk4iQGnY\"]],[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/uHoccSaatOMEv2DhLPnu1uEUd44BmZrsffPt-On_rCxb5kF8sulFv76jdD29AzByYaKPMnqqQprzDgvMIb1m0A\"]],[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/OePdUeeTsnqOncqmG6TIwY3BuuadQR09AzlKyYIPeZk6StZfpyu2zhJ27KKbxrBXAHyc-2IwQ98M3eNZ8KpDkw\"]],[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/PAa2PgN2HdEQbE4yNlH-fkRe1h39TvQ-XuX9yp5vAm1N0PEjgEtDw-pzVzU-zLz36UXYDldrh1bK-FTtZzJW\"]],[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/7VBsg5yhnZQSjf0PSAMXK2pL3r_DrmoSJaWac_tPts5iypKB51kzdV7iPpkX7sMY00xKdfeIxUl4_SkzbDn1vg\"]],[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/lkc_q0GVNNeUQNRyIA8bAWkp1YzD2iJd-hEy_hpg5gfuL3K342lrNW2garDygb605b12jiol9SzaVgIXrZS3\"]],[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/j0KCwYbeRLv9I9gNBR2PutWTRiFJbfYkXwrksiR1YhM3EE9rUY2_qRqNIEZR65vdBdd-fh6ISJDcGCwqN_bMo-s\"]],[null,2,[2560,1440],[null,null,\"https://play-lh.googleusercontent.com/5L3YRGTAW_k7_GWSpjyifeSdvGsi2nt0LTUX35YYQ7eoxXOCeIp33ds3eRgD3YNIOvNEI7dLWBoGPlaHcvQt\"]]],\"Gardenscapes\",[\"4,7\",4.7374477],\"Kasual\",null,null,[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.playrix.gardenscapes\\u0026rdid\\u003dcom.playrix.gardenscapes\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.playrix.gardenscapes\"]],[\"qgJlGmMIAUoTCK/Y2rDHkJcDFSKzrAIdF40jpfoBDAoKCAASBgoCaWQQALoCOgoeChhjb20ucGxheXJpeC5nYXJkZW5zY2FwZXMQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],null,[null,\"Welcome to Gardenscapes, the first game from the Playrix Scapes™ series! Make match-3 combinations and bring coziness and beauty to every corner of your garden.\\u003cbr\\u003e\\u003cbr\\u003eSolve fun puzzles, restore and explore new areas of the garden, and meet new friends in every chapter of the exciting storyline. Austin the butler is ready to welcome you to a world of incredible adventures!\\u003cbr\\u003e\\u003cbr\\u003eGame Features:\\u003cbr\\u003e● Gameplay loved by millions of players! Make match-3 combinations and decorate your garden while enjoying an entertaining story!\\u003cbr\\u003e● Over 16,000 captivating levels with explosive power-ups, useful boosters, and cool elements.\\u003cbr\\u003e● Exciting events! Embark on fascinating Expeditions, compete against other players in different challenges, and win awesome prizes!\\u003cbr\\u003e● One-of-a-kind garden areas with unique layouts, from fountain ensembles to island landscapes.\\u003cbr\\u003e● Loads of fun characters: meet Austin\\u0026#39;s friends and neighbors!\\u003cbr\\u003e● Adorable pets that will become your faithful companions!\\u003cbr\\u003e\\u003cbr\\u003ePlay with your Facebook friends, or make new friends in the game community!\\u003cbr\\u003e\\u003cbr\\u003eGardenscapes is free to play, but some in-game elements (including randomized items) can be purchased for real money.\\u003cbr\\u003e\\u003cbr\\u003eA Wi-Fi or internet connection is not required to play.\\u003cbr\\u003e *An internet connection is required to access competitions and additional features.\\u003cbr\\u003e\\u003cbr\\u003eDo you like Gardenscapes? Follow us!\\u003cbr\\u003eFacebook: https://www.facebook.com/Gardenscapes\\u003cbr\\u003eInstagram: https://www.instagram.com/gardenscapes_mobile/\\u003cbr\\u003e\\u003cbr\\u003eNeed to report an issue or ask a question? Contact Player Support through the game by going to Settings \\u0026gt; Help and Support. If you can\\u0026#39;t access the game, use the web chat by clicking the chat icon in the lower right corner of our website: https://playrix.helpshift.com/hc/en/5-gardenscapes/\\u003cbr\\u003e\\u003cbr\\u003eTerms of Use: https://playrix.com/terms/index_en.html\\u003cbr\\u003e\\u003cbr\\u003ePrivacy Policy: https://playrix.com/privacy/index_en.html\"],\"Playrix\",\"500.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/vhzn30WB2luFqRVePBU9JxlY9Li8Fo71Zis_vwf3MhQY-be6gSSTO_ILkBWcOselrX-9E8WXuRjm0h9zvV76\"],null,[107,132,67,255]],null,[\"Rating 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Interaksi Pengguna, Pembelian dalam Game (Termasuk Item Acak)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003ePelajari lebih lanjut\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.playrix.gardenscapes\\u0026rdid\\u003dcom.playrix.gardenscapes\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Instal\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"Rp 7.500 - Rp 1.599.000 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Kasual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.fatmerge.global\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/zGhriW_zOEdt1u68eybR53bC9kgIHNnsCPSrcf1e8eASpSLPXB9XrRqU25851GV6KmbwOHvVdMMJTE1h5EjD\"],