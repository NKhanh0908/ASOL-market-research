jefiu3d2JJIfKz85yrmMkKQxD8Dty_2XiOCNqw6YWqtG4RuZt5w-NrleaH4DCivtZwY\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/jJQphppssVB1lOQa94cCiUgrehxvbj1pXTDfhxHF0HXxeZ1aO-z9cRTYQgPL2jV7w0iFVK7QOJ4m-GMwLPv-Ow\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/NopL55pnY3IxQqWTAqVu1_efE1H4Tuxf6Vp3vq15VKZBMY1kVtV-zD5g_kOMJmXgV6DfjmLF0zWjyPJTjQ5dVw\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/zW90pIa1KgweOUG5U4t3uFUfw7lCzoIVbWedYyR6dOxkABQlETsjoWtjMB1WV3fsS-QcIsex-Od4ZzkTyOcI\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/hhgrERBPPYqj3x30PiUBietWPuXAFtikqefkwSAeyQZPvHkyySXwO4F1nd0n9BrEXlj8tV3R4_9eASY9dcUZP8g\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/yA-wuJ4R_rpGxHiytHne4T09IZITesfrWGaWQwVCuBlBWHk5MOImrE1wSiko26wLuWg1iqzpDdNh-Lt7ZjFuUg\"]]],\"My Talking Tom 2\",[\"4,3\",4.34942],\"Kasual\",null,null,[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.outfit7.mytalkingtom2\\u0026rdid\\u003dcom.outfit7.mytalkingtom2\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.outfit7.mytalkingtom2\"]],[\"qgJmGmQIQEoTCK/Y2rDHkJcDFSKzrAIdF40jpfoBDAoKCAASBgoCaWQQALoCOwofChljb20ub3V0Zml0Ny5teXRhbGtpbmd0b20yEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],[[[null,null,\"hKMuTQyhehI\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:hKMuTQyhehI?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:hKMuTQyhehI\",null,null,null,null,\"AXH1ezmOlyD1n31AFNXvTYZvYpIRoh-fms6tibvCoEK0-5EzejOzLGzpYp49o7cEgIBNoZYFns8s3RmNIQ_Bf8Iwi1v3sUDLke2wO_u0hGshvsB-6dXqfOyAPG0UsQPv9MWuZfOdVil0WjdOjO1Ip4bMmXd8W2wcbHI4j2zXOPHLvIGCXrZUQrglnnEptupqW5XcLZZT3WVB2jsRpLyLA8QMlmW_Pac4UmI8JxGPytzCQIA7-hTdyPSP4W97mHMXmr9jyLOGssqzq90Quyqwvd5fNLGhlVm501Y1yUzobZqngobRdA\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/hKMuTQyhehI/hqdefault.jpg\"]]]],[null,\"Kucing virtual superpopuler ini berangkat dalam perjalanan peliharaan paling hebat. Bersama kamu, pasti perjalanannya akan makin seru! Teman favoritmu yang lucu ini siap membuatmu terpukau dengan macam-macam pakaian baru, kemampuan keren, dan fitur spesial.\\u003cbr\\u003e\\u003cbr\\u003eDi Sini Kamu Bisa:\\u003cbr\\u003e\\u003cbr\\u003e- Belajar Berbagai Kemampuan : Ajari Tom kemampuan dan trik keren, seperti bermain drum, bola basket, dan tinju. Dia akan jadi kucing paling berbakat!\\u003cbr\\u003e\\u003cbr\\u003e- Mencicipi Snack Terbaru: Temukan dan suapi Tom berbagai snack yang lucu dan lezat. Mulai dari es krim hingga sushi, Tom suka semuanya! Kira-kira dia suka cabai pedas tidak, ya?\\u003cbr\\u003e\\u003cbr\\u003e- Menjaga Kebersihan: Bantu Tom tetap bersih dan wangi dengan macam-macam aktivitas seru, seperti mandi dan menggosok gigi. Jaga Tom tetap bersih, ya!\\u003cbr\\u003e\\u003cbr\\u003e- Pergi ke Toilet: Ya, bahkan Tom perlu ke kamar mandi dan dia sangat lucu saat buang air! Bantu Tom dan pastikan dia nyaman, ya.\\u003cbr\\u003e\\u003cbr\\u003e- Menjelajahi Dunia Baru: Jalan-jalan bersama Tom ke tempat baru yang seru dan temukan kejutan tersembunyi. Terbang ke berbagai pulau dengan token terbang spesial!\\u003cbr\\u003e\\u003cbr\\u003e- Mengumpulkan Pakaian, Furnitur, dan Memori Spesial: Dandani penampilan Tom dengan pakaian heboh dan hias rumahnya dengan furnitur keren.\\u003cbr\\u003e\\u003cbr\\u003e- Item Gacha: Buka hadiah dan kejutan menarik dengan melakukan berbagai aktivitas. Dapatkan pakaian keren, snack lezat, dan banyak lagi!\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003eAktivitas Ekstra Seru:\\u003cbr\\u003e\\u003cbr\\u003e- Bermain di Trampolin dan Ayunan Raksasa: Biarkan Tom berayun tinggi dan bermain sambil tertawa.\\u003cbr\\u003e\\u003cbr\\u003e- Membuat Smoothie: Buat smoothie unik yang lezat untuk dinikmati Tom.\\u003cbr\\u003e\\u003cbr\\u003e- Menyembuhkan Luka: Rawat Tom saat dia terluka dan pastikan Tom lekas sembuh dan kembali ceria.\\u003cbr\\u003e\\u003cbr\\u003e- Mini Game dan Puzzle: Tantang dirimu dengan mini game dan puzzle menghibur yang akan membuatmu ketagihan bermain selama berjam-jam.\\u003cbr\\u003e\\u003cbr\\u003e- Terus Bermain: Lihat halaman belakang Talking Tom berubah menjadi Kerajaan Permen, Pulau Bajak Laut, Rumah Dalam Air, dan dunia ajaib lainnya yang bisa kamu selami untuk menikmati keseruan tak terbatas bersama Tom dan kawan-kawannya.\\u003cbr\\u003e\\u003cbr\\u003eGame peliharaan virtual ini penuh petualangan, tawa, dan momen tak terlupakan! Pastikan untuk mengabadikan semuanya!\\u003cbr\\u003e\\u003cbr\\u003eDari Outfit7, kreator game populer My Talking Tom, My Talking Angela 2, dan My Talking Tom Friends.\\u003cbr\\u003e\\u003cbr\\u003eAplikasi ini berisi:\\u003cbr\\u003e- Promosi produk dan iklan Outfit7;\\u003cbr\\u003e- Tautan yang mengarahkan pelanggan ke situs web Outfit7 dan aplikasi lainnya;\\u003cbr\\u003e- Konten yang dipersonalisasi untuk mengajak pengguna kembali memainkan aplikasi;\\u003cbr\\u003e- Opsi untuk melakukan pembelian dalam aplikasi;\\u003cbr\\u003e- Item yang bisa dibeli (tersedia dalam harga yang bervariasi) menggunakan mata uang virtual, menyesuaikan progres pemain;\\u003cbr\\u003e- Opsi alternatif untuk mengakses semua fungsi dalam aplikasi tanpa melakukan pembelian dalam aplikasi menggunakan uang asli.\\u003cbr\\u003e- Harga dan ketersediaan sejumlah fitur mungkin berbeda.\\u003cbr\\u003eKetentuan penggunaan: https://talkingtomandfriends.com/eula/en/\\u003cbr\\u003eKebijakan privasi untuk game: https://talkingtomandfriends.com/privacy-policy-games/en\\u003cbr\\u003eDukungan pelanggan: support@outfit7.com\"],\"Outfit7 Limited\",\"1.000.000.000+\",null,null,null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/EGCs1XkXjbuib_Yv2XhwjoMcABHIcT6BS1eQw5Xt2392X5pAQWrUvrpRG6EUEWRGR-LjlNf5f5r