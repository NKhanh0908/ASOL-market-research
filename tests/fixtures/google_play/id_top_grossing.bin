V7cVj6PWPQUmYMJIvbvR0Yb4MrTCU-EToRVrRUOme0li3mbri9w0Lfig\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/5yPo7WXzT47_NmWVTV6b5tT7oihNlQeXeFzSy421v1MlK7pzblmjnzc2BA7Q_Gel_luvGlgum99rgqix0mf2\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/XVcPu26itfUPhp5y_2wl-Bk9wEWrLlzSabkMWcM9wZa_o0FlwnajoM_aVLNAcWTqtSsgJNuDOHRIFNmR_e-n1mo\"]]],\"Haunted Room: Sleep Survivor\",[\"4,0\",4.0459557],\"Kasual\",null,null,[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.ygjszsea.google\\u0026rdid\\u003dcom.ygjszsea.google\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.ygjszsea.google\"]],[\"qgJgGl4IOEoTCK/Y2rDHkJcDFSKzrAIdF40jpfoBDAoKCAASBgoCaWQQALoCNQoZChNjb20ueWdqc3pzZWEuZ29vZ2xlEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"\\u003cb\\u003e\\u003cfont color\\u003d\\\"red\\\"\\u003e[Hadiah Spesial] 500 Draw, Fashion Tengkorak, Hero Oranye acak, dan Dekorasi terbatas!\\u003c/font\\u003e\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003eSaat kota yang dikenal berubah menjadi arena berburu monster... Tok tok tok, suara ketukan pintu misterius terdengar...\\u003cbr\\u003e\\u003cbr\\u003e\\u0026quot;Sstt, jangan bersuara, jangan buka pintu.\\u0026quot;\\u003cbr\\u003e\\u003cbr\\u003eSemua monster dalam legenda menembus dimensi, dan akan masuk ke dalam. Dan Anda harus menutup pintu kamar dengan rapat, buka sebuah pertempuran menjaga \\u0026quot;Pintu\\u0026quot; yang tidak mengerikan namun membuat jantung Anda berdebar kencang bersama dengan para Hero Anda!\\u003cbr\\u003e\\u003cbr\\u003eSekolah, rumah sakit, hotel, jalan, kantor, setiap arena sehari-hari akan menjadi stage menjaga menara yang menarik, gunakan 5 menit untuk menikmati keasyikan visual dan operasi!\\u003cbr\\u003e\\u003cbr\\u003e[Lima Fitur Inti, Mendefinisikan Pertahanan Menara Micro-Fear yang Inovatif]\\u200b\\u003cbr\\u003e※ Pilih kamar, tutup pintu, tiduran, upgrade!\\u003cbr\\u003eMonster datang, bagaimana ini? Tidak bisa lari, kalau begitu tiduran?\\u003cbr\\u003ePilih \\u0026quot;kamar\\u0026quot; Anda, tutup \\u0026quot;pintu\\u0026quot; Anda, tidur dan upgrade dalam mimpi, juga dapat summon Hero untuk membangun garis pertahanan! Dapat menahan monster yang mengetuk pintu di malam hari atau tidak, semua tergantung tatanan Anda.\\u003cbr\\u003e\\u003cbr\\u003e※ Perputaran strategi, pertempuran psikologis\\u200b\\u200b\\u003cbr\\u003eTidak perlu \\u0026quot;mempertaruhkan hidup\\u0026quot;, ini bukan hanya tentang bersembunyi! Tempat tidur bisa diupgrade, pintu bisa diupgrade, dan Hero juga bisa diupgrade, kamar adalah garis pertahanan Anda. Kumpulkan tim dan strategi yang tepat untuk mengatasi berbagai tantangan dan peristiwa, dan setiap pertahanan yang berhasil akan memberi Anda rasa pencapaian yang luar biasa.\\u003cbr\\u003e\\u003cbr\\u003e※ Pengalaman visual yang imersif\\u003cbr\\u003eGaya seni chibi gothic yang unik memberikan suasana yang mendalam dan sedikit menakutkan. Apakah cangkir vampir itu berisi darah atau anggur merah? Mengapa si pembunuh membawa gergaji mesin sambil mengenakan topeng kelinci yang imut? Ratusan desain Hero dan monster yang unik, sedikit menakutkan dan sedikit imut.\\u003cbr\\u003e\\u003cbr\\u003e※ Karakter utama yang selalu berubah, menghadapi tantangan dungeon yang selalu berubah.\\u003cbr\\u003eBerubah menjadi \\u0026quot;Daredevil\\u0026quot; dan jelajahi berbagai lokasi menyeramkan, mulai dari kereta berhantu hingga asrama yang dipenuhi lagu tengah malam hingga gua bawah tanah yang misterius. Pemain dapat dengan bebas berubah menjadi berbagai karakter. Wajah mana yang akan saya pilih untuk berpartisipasi dalam permainan bertahan hidup ini hari ini?\\u003cbr\\u003e\\u003cbr\\u003e※ Pertempuran level pertahanan menara yang ringan dan seru\\u003cbr\\u003eSatu permainan hanya berlangsung 5 menit, tanpa tekanan! Mainkan game ini di waktu luang Anda dan nikmati keseruan pertahanan menara berkualitas tinggi dengan cara yang sederhana di waktu senggang Anda.\"],\"Joy Nice Games\",\"1.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/zVFf-0rDzagvnkfK364f5ElJohdtAwo6-GEiKTBD6ynmo0kVqzeuLCGsWy1KWkkkR7A2HJntTQMh-1oonMn7xg\"],null,[5,27,46,255]],null,[\"Rating 7+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/1SrNtAwg9PFOhgMJPXehacRTeQNhHhG12Pj1zACHNVmfRfEZA3_oOEmLvRNsmYGeGHpas7sCwyR3y8OT\"]],[null,\"Kekerasan Ringan, Ketakutan\"],[null,\"Interaksi Pengguna, Pembelian dalam Game (Termasuk Item Acak)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003ePelajari lebih lanjut\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/JTT-ImEkrbWzIL7w0fP8fQhVmpexdfh7u0P59PJtyJywmQBVolJjunMal6B5dUM6uiFiKnmtHtBbVvcWBMU\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.ygjszsea.google\\u0026rdid\\u003dcom.ygjszsea.google\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Instal\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"Rp 5.500 - Rp 5.599.000 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Kasual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.sts.vision\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/GMMJjQm9R16WF0AvifVAFfhFCpv_QTxavwguEwL1SQSstf9zdha2Gg6J