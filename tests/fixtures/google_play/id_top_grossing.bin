content.com/mVod0OUN3jwITtbXRqTO75keoRdCCoXbrzsGQEzoAo01OgX1Xkp8p_oYr_NqMs4OPqnrrZFb68DUsthA318cGA\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/oXE2PcliYB5hSpnzMjyfesfAWTJtR6Jei6oWbxysx6gxhEDRe48VKWhKSGOSRYR2-WMhsJGKpYn4yTycv0xWQw\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/V_iFiQMGtUf-WhL6xXW1RTGoVjQgnFKPjE6_f7ctOE7ia7aAoaskgMwnfFVvDOgyRorJQoTmemQzthqIiKLMR_g\"]]],\"Family Go! - Simulasi Hidup\",[\"3,5\",3.52809],\"Kasual\",null,null,[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.familygo.simgame\\u0026rdid\\u003dcom.familygo.simgame\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.familygo.simgame\"]],[\"qgJhGl8IIkoTCK/Y2rDHkJcDFSKzrAIdF40jpfoBDAoKCAASBgoCaWQQALoCNgoaChRjb20uZmFtaWx5Z28uc2ltZ2FtZRABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,\"OIzlGpNhBH8\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:OIzlGpNhBH8?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:OIzlGpNhBH8\",null,null,null,null,\"AXH1ezk5hraYhu7eKTH51DMcCB33VA48lH-PQ29xUSlLj2yXDJiWbJp_Nzem9n9btd97YutUYvWR0bEF6LL38B-lXtSlLC38eAAKGZKxxn_cSOACHPl9ahJNdi6SmvXd6ZcN6ipwdZmZrh1_BJbxLd-2E0R3uNc1dgjr_HM9HKyffwcV9dy2pwTHJdH6Jf32JqNIDXg4wwXnEMUCB99mFtFmf-J68Snk16NKbVA-NcdwU24Y2r_IjxWw37J7mhgYhPbqblNPFtFGwRAyGjFi73eLQqV_st0cIprGwIfKX88u_yjzCA\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/OIzlGpNhBH8/hqdefault.jpg\"]]]],[null,\"📖 Bangun warisan keluargamu dari generasi ke generasi!\\u003cbr\\u003eSelamat datang di Family Go!, petualangan simulasi kehidupan terbaik di mana setiap pilihan yang kamu buat membentuk masa depan keluargamu. Kembangkan silsilah keluargamu, saksikan generasi baru tumbuh dan berkembang, lalu bangun kota makmur yang akan terus berkembang dari generasi ke generasi!\\u003cbr\\u003eDi Family Go!, kamu memulai permainan dengan satu karakter dan membuat berbagai keputusan penting yang akan memengaruhi perjalanan keluargamu. Apakah kamu akan memilih cinta, kekayaan, ketenaran, atau kehidupan yang damai di pedesaan? Seiring keluargamu berkembang, setiap generasi baru menghadirkan peluang, tantangan, dan kejutan baru.\\u003cbr\\u003e🏡 Petualangan Simulasi KeluargaNikmati seluruh perjalanan hidup: menikah, memiliki anak, membangun karier, pensiun, dan masih banyak lagi. Bangun rumah, besarkan anak-anakmu, dan wariskan nilai-nilai keluarga kepada generasi berikutnya. Saksikan keluargamu berkembang menjadi warisan yang terus hidup sepanjang waktu!\\u003cbr\\u003e🌳 Kembangkan Silsilah KeluargamuPerluas keluargamu selama puluhan tahun! Ikuti perkembangan setiap generasi dan lihat bagaimana pilihan hidupmu memengaruhi keturunanmu. Setiap anggota keluarga baru memiliki sifat, bakat, dan impian yang unik, sehingga setiap warisan keluarga akan selalu berbeda.\\u003cbr\\u003e🏙️ Bangun Kota dan KerajaanmuUbah desa sederhana menjadi kota yang ramai dan makmur! Berinvestasilah dalam berbagai bisnis, tingkatkan rumahmu, buka toko baru, dan bangun jalan-jalan yang dipenuhi kehidupan. Kotamu akan berkembang seiring dengan kisah keluargamu.\\u003cbr\\u003e💬 Setiap Pilihan Hidup BerartiSetiap keputusan membuka jalan baru. Siapa yang akan kamu nikahi? Bagaimana kamu akan mendidik anak-anakmu? Apakah kamu akan berinvestasi demi masa depan kotamu, membangun pertanian yang damai, atau mengejar ketenaran dan kekayaan? Buat pilihan yang tepat dan tinggalkan kisah yang layak dikenang!\\u003cbr\\u003e🧬 Simulasi DNA dan Pewarisan SifatRasakan simulasi keluarga yang nyata dengan mewariskan sifat, bakat, dan penampilan dari generasi ke generasi. Saksikan anak-anakmu mewarisi kemampuan, penampilan, dan ciri khas unik, menciptakan silsilah keluarga yang kaya dan terus berkembang sesuai dengan keputusanmu.\\u003cbr\\u003e🏆 Pencapaian, Event, dan KejutanHidup penuh dengan momen tak terduga! Rayakan pernikahan dan masa pensiun, buka bakat rahasia, serta atasi tantangan melalui berbagai event dinamis dan pencapaian.\\u003cbr\\u003e🎯 Fitur Utama:★ Bangun dan kembangkan warisan keluarga lintas generasi★ Buat pilihan hidup yang memengaruhi generasi mendatang★ Rancang dan perluas rumah, bisnis, dan seluruh kota★ Besarkan anak-anakmu dan tuntun mereka menuju masa depan yang unik★ Rasakan pewarisan DNA dan perubahan sifat keluarga★ Ikuti event seru dan buka hadiah langka★ Nikmati pengalaman simulasi yang nyaman dan menghangatkan hati★ Ciptakan kisahmu sendiri yang berlangsung seumur hidup dan seterusnya\\u003cbr\\u003eBaik kamu bermimpi membesarkan keluarga legendaris, membangun kota yang makmur, atau sekadar menikmati perjalanan hidup, Family Go! memberimu kesempatan untuk menciptakan warisan unik yang dipenuhi cinta, impian, dan petualangan.\\u003cbr\\u003e🚀 Unduh Family Go! sekarang — perjalanan keluargamu dimulai hari ini!\"],\"KIKO FUN INTERACTIVE ENTERTAINMENT CO., LIMITED\",\"1.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/MlfQB-16S5kTj6Xjb1Oi_KOl2laHz0idYt6e8TElNHZ6iCPE3RAWJnavmakenrk0IoulE5mkByySn8x2M43sPfA\"],null,[221,224,255,255]],null,[\"Rating 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Pembelian Dalam Game\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003ePelajari lebih lanjut\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null