g\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/6qeaoMTqX4UClvXBPN1MqIf57ZtbP6NRTxGUrl8l6r-o-ffww4EFdF-vDD2o4sOxKqyygLhUWszkaEsAiwi3Nw\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/KqDcZE9vwjkonTXrcStt_ldZ9COGFNUFeJ1CNz41s_ssmZSyDd1YDc9QwzVgU2h7oRZ9ULQKfo20qNXYuKPq_g\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/R8_iIPglWokq5HgKgB30L93Kx2vvWUtq58vZo0Yf6Rmd3Q1mSSKrNlRYF4Mna5dKQXQjH89Ea9rbq56SO64Nsw\"]]],\"Screw Project: ASMR Home\",[\"4,5\",4.5263157],\"Kasual\",null,null,[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.casualjoygames.screwproject\\u0026rdid\\u003dcom.casualjoygames.screwproject\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.casualjoygames.screwproject\"]],[\"qgJsGmoIMkoTCK/Y2rDHkJcDFSKzrAIdF40jpfoBDAoKCAASBgoCaWQQALoCQQolCh9jb20uY2FzdWFsam95Z2FtZXMuc2NyZXdwcm9qZWN0EAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"Screw Project adalah gim teka-teki yang menantang. Nikmati keseruan bermain gim sekrup dan tantang level-level yang mengagumkan di Screw Project.\\u003cbr\\u003e\\u003cbr\\u003eBagaimana cara memainkan gim ini?\\u003cbr\\u003ePertama, jelaskan tujuan level. Amati warna kotak di atas dan klik sekrup dengan warna yang sesuai hingga semua sekrup terlepas dan terkumpul di dalam kotak;\\u003cbr\\u003eKedua, gim ini membutuhkan strategi tertentu dan reaksi cepat. Saat membuka sekrup pada kaca, terkadang sekrup akan terhalang oleh kaca. Kaca akan otomatis jatuh karena gaya gravitasi. Anda perlu memprediksi lintasan jatuhnya kaca terlebih dahulu dan segera klik sekrup yang terhalang, untuk mencegah kaca jatuh sepenuhnya dan kembali menghalangi sekrup;\\u003cbr\\u003eSelain itu, ada banyak jenis sekrup dalam gim ini, termasuk sekrup berbentuk bintang dan sekrup yang dihubungkan dengan tali. Klik salah satunya untuk memasukkannya ke dalam lubang. Jika sekrup menggantung di seluruh lubang, levelnya gagal! Beberapa level mungkin memiliki sekrup kipas, perhatikan dengan saksama!\\u003cbr\\u003eJangan khawatir, level ini tidak memiliki batas waktu, dan alat peraga didukung untuk membantu memenangkan level. Beranilah dan berpartisipasilah!\\u003cbr\\u003e\\u003cbr\\u003eDalam permainan sekrup yang adiktif ini, Anda akan menemukan fitur-fitur menyenangkan berikut:\\u003cbr\\u003e- Booster luar biasa untuk membantu Anda di sepanjang jalan;\\u003cbr\\u003e- Level yang dirancang dengan indah;\\u003cbr\\u003e- Aktivitas yang kaya dan menarik;\\u003cbr\\u003e- Permainan sekrup yang sederhana dan menenangkan.\\u003cbr\\u003e\\u003cbr\\u003eScrew Project memiliki gameplay yang unik, setiap level dirancang dengan cermat, memberikan pengalaman bermain yang mengasyikkan, mulailah perjalanan permainan!\"],\"Casual Joy Games\",\"1.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/E1q2qDCX_naksXgQA4m2pME5-xNJturwzR-SwDejRMbuxRj1yfdGAmzBakJ8cRVUgmzfOOvlUqF4gJDh08A3oA\"],null,[242,101,220,255]],null,[\"Rating 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003ePelajari lebih lanjut\\u003c/a\\u003e\"],true,[null,\"Cocok untuk semua kelompok usia. Beberapa kekerasan dalam konteks komikal atau fantasi dapat diterima. Bahasa kasar tidak diizinkan.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.casualjoygames.screwproject\\u0026rdid\\u003dcom.casualjoygames.screwproject\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Instal\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"Rp 17.000 - Rp 1.790.000 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Kasual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"bus.sand.fall.jam.loop.traffic.flow\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/-TcLefDSecp5lo9jZbNF1LcnFVef7kv0pUNUGEBoX-Q22Ipc8wSWk8Z9cv-dHE4s7c4_hy8j4x8h1H_IFzO-kH0\"],null,[42,176,248,255],null,null,null,2],[[null,2,[2450,1080],[null,null,\"https://play-lh.googleusercontent.com/ySlhs5k7eGnLsQ7el-aNZbf813Q5JHAJnIGgclYfwE8xLuMjVrChpvvF34qKERQTSor1soxee80dwvhyTLeSeQ8\"]],[null,2,[2450,1080],[null,null,\"https://play-lh.googleusercontent.com/NGMrXO2-QgCuSw7yVM9zUWL0C2MYDOJsPnOZ4_7fHaZ5XqzpipxvoCyLfC8KM3_xLKyWk_ddxnWc7IxJLhixZQ\"]],[null,2,[2450,1080],[null,null,\"https://play-lh.googleusercontent.com/m9cYdb_iKFZQKb-5AWOEXXKwohrtcaEl7Z0nFC31bsyQdVBo2gGrbgNNb3uto_ftCp_qgIkyUrc1PChYwQ75DQ\"]],[null,2,[2450,1080],[null,null,\"https://play-lh.googleusercontent.com/iqtW_S36gKUb4kaavFnzHWEwAtpU-2pn8_xW9CGDfoGEngSRodgkf2Y2KSMZk09AeShJ7LeY9MPrD_kucjdO\"]],[null,2,[2450,1080],[null,null,\"https://play-lh.googleusercontent.com/pbzdMukfEOIJ9Dckm4uaTyzp4NGWqvtav0qlshcF-jMAS-O_XJMKwQzqHfvc4g4BTQlf001-i1RXPCe9DqOX\"]]],\"Jam Bus:Sandfall\",[\"5,0\",4.9694657],\"Kasual\",null,null,[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dbus.sand.fall.jam.loop.traffic.flow\\u0026rdid\\u003dbus.sand.fall.jam.loop.traffic.flow\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dbus.sand.fall.jam.loop.traffic.flow\"]],[\"qgJwGm4IM0oTCK/Y2rDHkJcDFSKzrAIdF40jpfoBDAoKCAASBgoCaWQQAboCRQopCiNidXMuc2FuZC5mYWxsLmphbS5sb29wLnRyYWZmaWMuZmxvdxABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"Jam Bus: Sandfall brings a fresh twist to bus jam, color puzzle, and traffic escape gameplay.\\u003cbr\\u003eColorful sand is stacked in layers, and every bus has its own color and direction. Tap the right bus, collect the matching sand, and clear the board step by step. Sounds simple at first, but every move can change the whole puzzle.\\u003cbr\\u003ePlan carefully before you tap. Some buses may block each other. Some paths may cross. Some sand colors can only be cleared after the lower layers are gone. To win, you need to observe the board, choose the right order, and keep every bus moving without a crash.\\u003cbr\\u003eHow to play\\u003cbr\\u003e• Tap a bus to move it along its route\\u003cbr\\u003e • Match each bus with the same color sand\\u003cbr\\u003e • Clear lower sand layers to unlock the ones above\\u003cbr\\u003e • Avoid traffic crashes when paths cross\\u003cbr\\u003e • Solve each level with smart sequencing\\u003cbr\\u003eWhy you’ll enjoy Jam Bus: Sandfall\\u003cbr\\u003e• Easy tap controls\\u003cbr\\u003e • Relaxing color-matching gameplay\\u003cbr\\u003e • Clever bus parking jam puzzles\\u003cbr\\u003e • Satisfying sand-clearing effects\\u003cbr\\u003e • Increasingly tricky routes and layers\\u003cbr\\u003e • Clean visuals and smooth puzzle flow\\u003cbr\\u003e • Great for quick breaks and brain training\\u003cbr\\u003eEvery level is a small logic challenge. A bus may look ready to move, but its route might block another vehicle. A color may be visible, but the sand below it must be cleared first. Think ahead, follow the arrows, and find the perfect order to clear the whole sandfall.\\u003cbr\\u003eIf you enjoy bus games, parking jam puzzles, color sort games, traffic escape challenges, or relaxing logic games, Jam Bus: Sandfall gives you a colorful new puzzle to solve.\\u003cbr\\u003eStart with one bus, clear one color, and let the sand fall into place.\"],\"Nova Games Technology Limited\",\"1.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/Xxtz7lOU2yqCxGMmNiyNb3e-OEhEoW_TeIylWnJOAaXHSDGGAQhJSs12d5B4L6TFUPOV3-3f00S0dPXRunndNQ\"],null,[117,111,117,255]],null,[\"Rating 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Interaksi Pengguna\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003ePelajari lebih lanjut\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dbus.sand.fall.jam.loop.traffic.flow\\u0026rdid\\u003dbus.sand.fall.jam.loop.traffic.flow\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Instal\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"Rp 18.000 - Rp 1.790.000 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Kasual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.best