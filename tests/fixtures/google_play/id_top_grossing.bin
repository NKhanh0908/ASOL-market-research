08,1242],[null,null,\"https://play-lh.googleusercontent.com/fR3GQDYAT0NUYUgcgPiV0-Zqinpjwvlugzrt-Smi7_E8Op40o1_10o164SkvOzjK71XNNZHK2O35JZx1p-wozJg\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/aUcPdos5cACptAZLoIppJ9GxEC2lziZzrtSwUgg-wA4Rapk7nAIIVWZRIrl-_axwL_w0BA613Q72MWcF9LywUzM\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/Jz3XLC4hRrSoSqCOwNZTBoo9m8BkoKx-QUBcFPdqSZOyA9KQZioAKdVxPD5J_EUCDSfm1ljnuwvsOxgVYNlZBg\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/8KrvcClWN6t0fsG7_Qe9Z2OPmkxZelsgOkf3gCKFh4CZr3k9eERvCQa642NzAZ6O9nU4l0p7OWRcTizuQW-NMw\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/GZpLQhT-AbLrZIVtImMFFVk_-XJecGE4pSZtTgDPqxDt-j0mq96gXVy9tOVpCYoB540zRHNazzheVFpW3nkqPyw\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/glAQYjA20KvdJPFBUcBQ_YeuKuRU7Hz4MRaN7lhhpzcfZ8XpcWFMwaMmRQZ2l7Z_B5iO2GK0Gf7bt6-ZeLoKslQ\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/rKsIKDr1vEft14-v0LXUQpBMeJLW4LteK6eJHi89MDBLv99OdG1XbFI38RmR3LW5eQVmWFjQ1f8AqLoc2GEYDw\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/fQaPa7e1G0PHMRKw_6hA6eNexDttIbJcLSqEodRGjBFGHviiA-nmj4cpa4wKZVhbLggGTKHAkZaC0QBQPXF0XQ\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/8MSr5L8hzQvY8lSpQ1-zG6BVXDsxQ45JDolm3kFBVn-9c1_sh1TOgX1RyF6ejVkACr7NyA4l-wCwawUsd5Gie2U\"]]],\"Tasty Travels: Merge Game\",[\"4,6\",4.593264],\"Kasual\",null,null,[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.fatmerge.global\\u0026rdid\\u003dcom.fatmerge.global\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.fatmerge.global\"]],[\"qgJgGl4IAkoTCK/Y2rDHkJcDFSKzrAIdF40jpfoBDAoKCAASBgoCaWQQALoCNQoZChNjb20uZmF0bWVyZ2UuZ2xvYmFsEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"\\u0026quot;Mulai perjalanan kuliner di Tasty Travels: Merge Game. Di sini, hasratmu untuk memasak akan bertemu dengan kegembiraan bereksplorasi! Gabungkan bahan-bahan untuk membuat hidangan lezat saat kamu berkeliling dunia!\\u003cbr\\u003e\\u003cbr\\u003eBuka rahasia masakan dunia, kuasai masakan khas daerah, dan bagikan kisah gastronomimu dengan teman di mana pun!\\u003cbr\\u003e\\u003cbr\\u003eTetap terhubung dengan Food and Travel: Merger Game di Facebook untuk mendapatkan penawaran dan update eksklusif!\\u003cbr\\u003eFacebook: https://www.facebook.com/profile.php?id\\u003d61551040873010\\u003cbr\\u003e\\u003cbr\\u003e🍲 Gabungkan Bahan Makanan 🍲\\u003cbr\\u003e• Temukan dan gabungkan lebih dari 500 bahan unik di berbagai level!\\u003cbr\\u003e• Seret dan gabungkan bahan-bahan di dapur rumahmu untuk menyiapkan hidangan baru yang luar biasa!\\u003cbr\\u003e• Selesaikan misi bagi wisatawan untuk membuka resep dan destinasi baru, mulai dari pusat kuliner terkenal hingga alun-alun kota kuno!\\u003cbr\\u003e\\u003cbr\\u003e🌍 Interaksi Sosial 🌍\\u003cbr\\u003e• Terhubung dengan teman-teman di seluruh dunia, bagikan petualangan kulinermu, dan dapatkan kekaguman mereka!\\u003cbr\\u003e• Bagikan resep untuk menyempurnakan petualangan kulinermu dan mengadakan pesta memasak virtual yang menyenangkan!\\u003cbr\\u003e\\u003cbr\\u003e✈️ Buka Destinasi Perjalanan ✈️\\u003cbr\\u003e• Kumpulkan koin untuk membuka destinasi wisata baru yang menarik, mulai dari pasar kota yang ramai hingga taman yang tenang!\\u003cbr\\u003e• Kunjungi dan nikmati suasana kota kuliner paling terkenal di dunia, masing-masing kota penuh dengan cita rasa dan tradisi unik!\\u003cbr\\u003e• Selami tantangan mendalam yang tersebar di setiap destinasi baru, pecahkan teka-teki bertema kuliner untuk maju!\\u003cbr\\u003e• Temukan permata tersembunyi di kota-kota menawan, tempat koki lokal menantangmu dengan resep utama mereka.\\u003cbr\\u003e\\u003cbr\\u003e📖 Cerita Menarik 📖\\u003cbr\\u003e• Mulailah kisah menawan yang membawamu melewati berbagai kota, masing-masing dengan misteri dan resep uniknya sendiri untuk diungkap!\\u003cbr\\u003e• Bantu seorang gadis muda mewujudkan mimpinya menjadi seorang vlogger, menjelajahi rahasia keluarganya saat dia berkeliling dunia bersama teman-temannya.\\u0026quot;\"],\"Century Games PTE. LTD.\",\"10.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/W6HK6kBNU5u3L-SCl64Zmnt2jM3Dd-_95DtfhSc0eMN8o-r54ZzVXzm6t8LRLXbjm5JXhr3vxRYTkmvdLYQmdRI\"],null,[61,131,97,255]],null,[\"Rating 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Pembelian dalam Game (Termasuk Item Acak)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003ePelajari lebih lanjut\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.fatmerge.global\\u0026rdid\\u003dcom.fatmerge.global\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Instal\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"Rp 17.000 - Rp 1.999.000 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Kasual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com