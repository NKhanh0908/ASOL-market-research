[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/JS3UmV9xxRoy7QMxajhSCifewj5m67ER1VuC46UO4F2fhqN9zPS0ZbP-a-mXIP_y0phDDMqAufdsUU3b4UUVLzQ\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/rh50mllproaDqA7IXec8VG700-_TNEL1b7FfUJ1iKUqhB7jUO0uyuM4EbndHjtF5y75sHbzpoM1sbM200POu4Oc\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/NnkC23fDIJUMEKs18r4FZHS0gfInkzEekDNj4SmH1MrafJUlA_ele2jnBSeCzMu6elXcAddyLE1lDT9sIRaP\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/noD-tmn27NQjoQD4MYqHEr02h4noQERBtrqpYLdcNjjOG91dCONicJOP5aICA7iERxvWQNQh2browj1G43CKUg\"]],[null,2,[1600,2560],[null,null,\"https://play-lh.googleusercontent.com/S8fC-VYJyeQLx491U4ZYI0HngweaIvu6JXjE7kazKbK_ozQ3hqwB8O3CDiFuxoICG3kwZN2N7QnXh52QFSO9hg\"]],[null,2,[1600,2560],[null,null,\"https://play-lh.googleusercontent.com/WRK2VSomb_Ck9DrgC1mbs-bM7jmndWYuZYspA5XF_YCqrqqKk1wOGfRrVDax4ahx1cZ_KG0B4lGiDEdDEo9ThA\"]],[null,2,[1600,2560],[null,null,\"https://play-lh.googleusercontent.com/hAKcL1wh7W0mu-wCWRi8y6MzeO_fN3a5FYTIIgj9HIA65sjbhoawsIu2CdPyIrVhdhvP1oY_-nzYJmTlvuH3\"]]],\"Color Block: Jam Puzzle 3D\",[\"4,5\",4.53211],\"Kasual\",null,null,[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.fs.block\\u0026rdid\\u003dcom.fs.block\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.fs.block\"]],[\"qgJZGlcIO0oTCK/Y2rDHkJcDFSKzrAIdF40jpfoBDAoKCAASBgoCaWQQAboCLgoSCgxjb20uZnMuYmxvY2sQARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],null,[null,\"Color Block! is a casual block puzzle and brain teaser game built for quick fun and smart thinking. Each level is a compact logic puzzle: slide blocks across the board, sort colors, and find the clean path that clears the space. One bad move can block your progress, so you must plan ahead and use strategy.\\u003cbr\\u003e\\u003cbr\\u003eThe rules are simple. The puzzles are not. Move blocks in tight areas, line up colors, and create openings to finish the level with the best solution. Some stages feel calm and satisfying. Others are real brain teasers that test your focus, timing, and problem solving. If you enjoy puzzles that reward careful planning, you will feel at home here.\\u003cbr\\u003e\\u003cbr\\u003eIn every puzzle, you will:\\u003cbr\\u003e· Slide blocks to new positions and open routes on the board.\\u003cbr\\u003e· Match blocks of the same color to remove them and make room.\\u003cbr\\u003e· Think in steps, not in taps. Set up moves before you commit.\\u003cbr\\u003e· Beat obstacles like locked tiles, barriers, and limited space.\\u003cbr\\u003e· Clear the board to unlock the next level and new mechanics.\\u003cbr\\u003e\\u003cbr\\u003eAs you advance, the game adds fresh challenges and clever twists. You will face tighter layouts, tricky blockers, and patterns that require logic and critical thinking. The difficulty grows in a fair way, so you can improve your skills level by level. This is a block puzzle that feels smooth and satisfying, but still makes you think like a puzzle solver.\\u003cbr\\u003e\\u003cbr\\u003eEvery level is designed as a small brain-training exercise. You analyze the board, test a plan, and adjust when the layout changes. The best solutions often come from seeing the puzzle in reverse: where the last match should happen, which block must move first, and how to avoid trapping colors behind barriers. That is the fun of a good brainteaser.\\u003cbr\\u003e\\u003cbr\\u003ePlayers come back because you get:\\u003cbr\\u003e· A true puzzles \\u0026amp; brainteasers experience with short, rewarding levels.\\u003cbr\\u003e· Easy controls and smooth sliding that make every move feel clean.\\u003cbr\\u003e· A mix of color matching puzzles, sorting puzzles, and sliding puzzles.\\u003cbr\\u003e· Rewards and achievements for beating hard stages and smart solutions.\\u003cbr\\u003e· Lots of levels to solve, from simple starters to advanced strategy puzzles.\\u003cbr\\u003e· Offline play, so you can enjoy the puzzle game anytime, anywhere.\\u003cbr\\u003e· Bright, clear visuals that help you read the board and plan faster.\\u003cbr\\u003e\\u003cbr\\u003eIf you like logic games, match puzzles, and classic block puzzles, Color Block! gives you a steady stream of challenges. Slide, match, and solve your way through colorful levels, unlock new stages, and see how far your strategy can take you.\\u003cbr\\u003eStart solving today.\"],\"Flare Star LLC\",\"500.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/szguExpJwFU-2bsWYNuJzAFhQxsdk58dPFy9dfi-xqWF7lvLGyY2acZ51aS077bvQqxDh8WfOa9uy9f6mmeUSg\"],null,[33,109,255,255]],null,[\"Rating 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003ePelajari lebih lanjut\\u003c/a\\u003e\"],true,[null,\"Cocok untuk semua kelompok usia. Beberapa kekerasan dalam konteks komikal atau fantasi dapat diterima. Bahasa kasar tidak diizinkan.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.fs.block\\u0026rdid\\u003dcom.fs.block\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Instal\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"Rp 30.000 - Rp 1.490.000 pe