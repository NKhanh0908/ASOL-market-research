"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/9UaMUaC5bUkFSe8CUJ5cwlwMNvpXXQXLL1c63tQdctWBlY3Pnbi79StM4b7GeeKy9ZFgKD6rOFENuEcE-vjf6A\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/abffEd4ZHbXmbOL4-8kCA2m9j3enKwnDJRVFtAL-D2emQzcBHnnHFjAmbFrFT6MSgS7BvFoNaYl88UryaRPSzCU\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/QVL4rRcN7jfeHGK_hxYXA3ZWpEXFl3laI7UQHftp5eHD-UPSP5lWUqTbtq3ySVy_9ehHTnv8fNASe1lia1GfHQ\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/AWUbHX7vY2qwhthrEL1-Hke7edr7-Zu2X2r6ttaCR-LS7AHXu9-NqhraMRCNl6VihBBRie9gwf4uCHAeR6a9\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/zbwy_N03IZ4RRqAc2_SjbrRzQBLC45AlPAU5ZlndHMz9erKj3fLumb306oYQGdCWkNOd6S9JmtrotK6sun7f\"]]],\"Merge Valley - Game Offline\",[\"4,8\",4.811881],\"Kasual\",null,null,[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.bigcool.puzzle.merge.valley\\u0026rdid\\u003dcom.bigcool.puzzle.merge.valley\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.bigcool.puzzle.merge.valley\"]],[\"qgJsGmoIWEoTCK/Y2rDHkJcDFSKzrAIdF40jpfoBDAoKCAASBgoCaWQQALoCQQolCh9jb20uYmlnY29vbC5wdXp6bGUubWVyZ2UudmFsbGV5EAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"\\u003cb\\u003eSelamat datang di Merge Valley - Game Offline — permainan seru gabung dan desain rumah yang bisa dimainkan tanpa internet!\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003eMulailah perjalanan ke kota misterius, gabungkan item, dan bangun kota impian Anda!\\u003cbr\\u003e\\u003cbr\\u003eMerge Valley menggabungkan kepuasan game teka-teki gabung (merge) dengan dekorasi rumah yang indah. Bantu penduduk merenovasi kota mereka yang rusak dan ubah menjadi tujuan wisata yang menakjubkan. Ini adalah pilihan tepat untuk bersantai, melatih otak, dan menikmati permainan offline seru.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003e✨ FITUR YANG AKAN ANDA SUKAI\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003e🔨 Game Teka-Teki Gabung yang Adiktif\\u003c/b\\u003e\\u003cbr\\u003e• Temukan versi baru dari game merge klasik.\\u003cbr\\u003e• Geser, cocokkan, dan gabungkan item untuk membuat alat yang lebih baik.\\u003cbr\\u003e• Temukan ratusan item unik dalam game teka-teki yang santai ini.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003e🏠 Renovasi \\u0026amp; Desain Kota\\u003c/b\\u003e\\u003cbr\\u003e• Dapatkan uang virtual dari puzzle untuk merenovasi rumah dan gedung.\\u003cbr\\u003e• Hidupkan kembali lembah tua dengan gaya pribadi Anda.\\u003cbr\\u003e• Desain, dekorasi, dan bangun kota impian Anda dari nol.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003e🗺️ Petualangan, Cerita \\u0026amp; Rahasia\\u003c/b\\u003e\\u003cbr\\u003e• Ikuti kisah seru saat Anda bepergian melalui berbagai area.\\u003cbr\\u003e• Temukan rahasia tersembunyi dan pecahkan misteri sejarah kota.\\u003cbr\\u003e• Temui karakter menarik dan buka bab cerita baru dalam Bahasa Indonesia.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003e🧘 Santai \\u0026amp; Melatih Otak\\u003c/b\\u003e\\u003cbr\\u003e• Ideal untuk menghilangkan stres dengan sesi permainan singkat setiap hari.\\u003cbr\\u003e• Cara terbaik untuk bersantai dengan permainan seru yang mengasah otak.\\u003cbr\\u003e• Mudah dipelajari, sulit dikuasai: pengalaman game santai terbaik.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003e📶 Game Offline \\u0026amp; Hemat Kuota\\u003c/b\\u003e\\u003cbr\\u003e• Mainkan di mana saja dan kapan saja: tanpa wifi diperlukan.\\u003cbr\\u003e• Baik saat bepergian atau di rumah, cerita merge Anda berlanjut offline.\\u003cbr\\u003e• Keseruan tidak pernah berhenti, bahkan dalam game tanpa internet.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003e🎮 CARA BERMAIN\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003e• \\u003cb\\u003eGabung:\\u003c/b\\u003e Geser dan gabungkan dua item identik untuk membuat yang baru.\\u003cbr\\u003e• \\u003cb\\u003ePesanan:\\u003c/b\\u003e Selesaikan permintaan penduduk untuk mendapatkan hadiah.\\u003cbr\\u003e• \\u003cb\\u003eDesain:\\u003c/b\\u003e Gunakan uang virtual untuk merenovasi, mendekorasi, dan memperluas kota Anda.\\u003cbr\\u003e• \\u003cb\\u003eJelajah:\\u003c/b\\u003e Buka area baru dan ungkap ceritanya!\\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eKeseruan, fokus, dan relaksasi, semua jadi satu!\\u003c/b\\u003e\\u003cbr\\u003e\\u003cbr\\u003eUnduh \\u003cb\\u003eMerge Valley - Game Offline\\u003c/b\\u003e sekarang! Nikmati puzzle gabung yang memuaskan, renovasi kreatif, dan relaksasi sejati. Salah satu game offline perempuan terbaik menunggu Anda! Mulai perjalanan Anda hari ini!\"],\"Bigcool Games\",\"100.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/tu-c0xAypNfNdy3R3P1qxS6AZ2ztpZDyUogn8NRrihECnGvr5hLCX5aeR4xb8yaXg1I10QeCcFbr6Rz24He88k0\"],null,[181,194,222,255]],null,[\"Rating 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Pembelian dalam Game (Termasuk Item Acak)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003ePelajari lebih lanjut\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"IDR\",\"\"]],null,[null,\"Beli\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.bigcool.puzzle.merge.valley\\u0026rdid\\u003dcom.bigcool.puzzle.merge.valley\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\