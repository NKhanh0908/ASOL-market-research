ll,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.sts.vision\"]],[\"qgJbGlkIOUoTCK/Y2rDHkJcDFSKzrAIdF40jpfoBDAoKCAASBgoCaWQQAboCMAoUCg5jb20uc3RzLnZpc2lvbhABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"Welcome to Golden Heights, a once-glamorous community in desperate need of your help!\\u003cbr\\u003e\\u003cbr\\u003eTake up the role of designer as you aid bubbly Community Manager Paige in making over the city and its wacky residents. Save businesses, create beautiful community spaces, better the lives of the citizens, and maybe even help Paige find love!\\u003cbr\\u003e\\u003cbr\\u003eRevitalize this modern community and restore Golden Heights to its former glory!\\u003cbr\\u003e\\u003cbr\\u003eMeet eccentric residents and find drama around every corner!\\u003cbr\\u003eHost inspiring community events and help the city thrive!\\u003cbr\\u003eMake over new friends and change lives!\\u003cbr\\u003eLove is in the air! Who will Paige choose?\\u003cbr\\u003eBlast your way through exciting match-3 levels and minigames!\\u003cbr\\u003e\\u003cbr\\u003eGolden Heights needs you, and the residents can’t wait to meet you. Welcome home!\\u003cbr\\u003eSupport: moderncommunity@magictavern.com\"],\"Magic Tavern, Inc.\",\"10.000.000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/IpuQ6TRZsERP6gQ3AyW_pv-48LgC8oh0mYePsPdYPSO_HuM1q3ydS8ApqL4ChumOEaivmGX221s6tfUE4i_skA\"],null,[21,190,233,255]],null,[\"Rating 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Pembelian Dalam Game\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003ePelajari lebih lanjut\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcA