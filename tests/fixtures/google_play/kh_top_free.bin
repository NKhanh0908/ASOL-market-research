iZ4y4vSguXTc2OsSG6-4ZVN9A4EssMpmwKkAbLGj4NfV6ZPaHWOcJJaO69G-_i2TCh1Eb39me5SVLHgCaxBX0\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/hpHqmKnZm0BV5Z89_JOimxC-AB01oiOQNIozq7etgeS2tiMObJiQSzsq_zO-CypC5w2_gBpPz7FJP4WM8KQspw\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/YUumuj5ugmQj2FlUfQ0hQp5d67_siBaSJvoeOZnk0C2EbLr91AVBRyT3EX_d9ifGfApwhStXDHI5X9QUvLv8ezk\"]]],\"Climb Jump Obby Tower Offline\",[\"3.7\",3.7272727],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.finik.ClimbJump\\u0026rdid\\u003dcom.finik.ClimbJump\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.finik.ClimbJump\"]],[\"qgJjGmEIGUoTCMjrorLHkJcDFX24rAId8gQ7O/oBDwoNCAASCQoFZW4tVVMQALoCNQoZChNjb20uZmluaWsuQ2xpbWJKdW1wEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"Climb and Jump – Obby Tower Offline: an exciting game in a recognizable style!\\u003cbr\\u003e\\u003cbr\\u003eEmbark on an adventure that takes you higher and higher up the tower. Once you reach the top, take a thrilling leap down to collect tons of coins! The higher you climb, the greater your reward!\\u003cbr\\u003e\\u003cbr\\u003eIncrease your climbing speed by getting wings that help you move faster than others. Earn solid rewards for your efforts!\\u003cbr\\u003e\\u003cbr\\u003eCollect pets that will help you climb even higher and earn more coins. Find epic and legendary pets, upgrade them, and become the ultimate tower champion!\\u003cbr\\u003e\\u003cbr\\u003eWhile playing, you’ll see other players around you, adding life to the atmosphere and making every climb even more exciting!\\u003cbr\\u003e\\u003cbr\\u003eIn this thrilling game, you and your friends will tackle dizzying heights, conquering famous landmarks like the Eiffel Tower, Statue of Liberty, Leaning Tower of Pisa, and the Pyramids.\\u003cbr\\u003e\\u003cbr\\u003eWhat can you find in this game?\\u003cbr\\u003e\\u003cbr\\u003e- Fun and colorful gameplay, perfect for kids.\\u003cbr\\u003e- Pets, upgrades, coins, and achievements.\\u003cbr\\u003e- Regular updates and exciting new content.\\u003cbr\\u003e\\u003cbr\\u003eClimb and Jump – Obby Tower Offline is a great choice for everyone who loves platformers, obby maps, jumping, and challenges. The game is perfect for quick gaming sessions on the go or for real marathons—the higher you go, the harder it gets!\\u003cbr\\u003e\\u003cbr\\u003eStart your thrilling journey now and see if you can reach the top and become the best!\"],\"Kids Games LLC\",\"5,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/oQd1WuAJfgtshM8URlPJ7tlaGnhZhLcwcow7TrMpAPgoOgx86ubp2udvIObFN2GnDz-25Q5oxLBgYjrjTEUQ\"],null,[63,205,20,255]],null,[\"Rated for 7+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/1SrNtAwg9PFOhgMJPXehacRTeQNhHhG12Pj1zACHNVmfRfEZA3_oOEmLvRNsmYGeGHpas7sCwyR3y8OT\"]],[null,\"Fear\"],null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/JTT-ImEkrbWzIL7w0fP8fQhVmpexdfh7u0P59PJtyJywmQBVolJjunMal6B5dUM6uiFiKnmtHtBbVvcWBMU\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.finik.ClimbJump\\u0026rdid\\u003dcom.finik.ClimbJump\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $7.99 per item\",[false]]],[[[[[[[]]]],null,null,null,