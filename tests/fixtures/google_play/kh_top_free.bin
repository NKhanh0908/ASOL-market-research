kXhkaDHh9Gy266fp3P8Qo1YPkb7qiYR_68u1r417nUO_1qH-6_IMdY3LXPT_aCqu1g\"]],[null,2,[2048,2732],[null,null,\"https://play-lh.googleusercontent.com/fqnsYcpIGPWqqR1jS7fSFyN5GHTJH_JePHtqAiaUdOUuyRArXB5mpt94RU-t_1hrXzq76IoCnwkl-tpKvvzV6g\"]],[null,2,[2048,2732],[null,null,\"https://play-lh.googleusercontent.com/xvxXv1l8-KzYSkUvZi9K-WivTaUW8SkLQJHZYZcvp9DKngDmwDNIFGenW1fJtFeTR46yEqDg4r1Lf3IR5MH4\"]]],\"Stickman Demon Fight Warrior\",[\"4.4\",4.4058824],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.mana.stickdemon.slayerfight\\u0026rdid\\u003dcom.mana.stickdemon.slayerfight\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.mana.stickdemon.slayerfight\"]],[\"qgJvGm0IFkoTCMjrorLHkJcDFX24rAId8gQ7O/oBDwoNCAASCQoFZW4tVVMQALoCQQolCh9jb20ubWFuYS5zdGlja2RlbW9uLnNsYXllcmZpZ2h0EAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"Every battle must come to an end, and the last fights are always the fiercest. Are you ready for an epic 3v3 stickman fighting game?\\u003cbr\\u003e\\u003cbr\\u003eIn Stickman Demon Fight Warrior, you will face dark forces threatening humanity: shadow lords, cursed warriors, undead stickmen, and monstrous creatures. Each battle is packed with nonstop action, powerful skills, and thrilling combat that will test your limits.\\u003cbr\\u003e\\u003cbr\\u003eChoose your stick heroes, upgrade their abilities, and become a legendary shadow hunter. Fight to protect humanity and prove yourself against warriors from other realms.\\u003cbr\\u003e\\u003cbr\\u003eHow to Play\\u003cbr\\u003eDodge, jump, and unleash your power to crush enemies. With simple yet responsive controls, anyone can dive into the action and master devastating skills to defeat the shadows.\\u003cbr\\u003e\\u003cbr\\u003eGame Features\\u003cbr\\u003e\\u003cbr\\u003e* Multiple modes: Classic battles, team fights, and exciting tournaments with great rewards.\\u003cbr\\u003e* PvP fights: Challenge friends or players worldwide to see who is the strongest stickman warrior.\\u003cbr\\u003e* Story mode: Immerse yourself in a gripping storyline filled with surprises and character growth.\\u003cbr\\u003e* Tournament mode: Compete in the ultimate showdown for glory and a place on the arena’s gold board.\\u003cbr\\u003e\\u003cbr\\u003eAre you strong enough to become the ultimate stickman shadow hunter? Download now and join the battle!\"],\"Mana Games Studio\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/5Ty-6blRTHViLV5IYwg_Ra4RTNTicqejp3idWJJwfO34mcXDq5UzU5XNeg1tL8et2zd87LucMTEkS2KVdlxU\"],null,[161,156,156,255]],null,[\"Rated for 7+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/1SrNtAwg9PFOhgMJPXehacRTeQNhHhG12Pj1zACHNVmfRfEZA3_oOEmLvRNsmYGeGHpas7sCwyR3y8OT\"]],[null,\"Mild Violence, Fear\"],[null,\"In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/JTT-ImEkrbWzIL7w0fP8fQhVmpexdfh7u0P59PJtyJywmQBVolJjunMal6B5dUM6uiFiKnmtHtBbVvcWBMU\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.mana.stickdemon.slayerfight\\u0026rdid\\u003dcom.mana.stickdemon.slayerfight\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$1.99 - $99.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,n