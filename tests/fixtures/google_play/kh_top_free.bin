[null,null,\"https://play-lh.googleusercontent.com/tUa-R-LfejVy1U0EOSbb9ECDeEeDb4RRYEV9ZlRz1J_sedgwDhZlYQ624tr0IH6wshRYKDme0UNwBBrNHpaW\"]],[null,2,[1800,3200],[null,null,\"https://play-lh.googleusercontent.com/6NcObxufQ9slzE68Sa6oFr6gQdVK_ovaiddOQ0LhzOHiyxJWzLN508S3pes8r3ivDigMivyGGYlbbUAfvz6Xf98\"]],[null,2,[1800,3200],[null,null,\"https://play-lh.googleusercontent.com/4uODsSA5s60p05yLDGlo6NoRG4rWE8ESQb_6q7C50M-lIml4tVahvvkmPqHfPhmg6c4PHUxcpKwPERnpzx1OWwA\"]],[null,2,[1800,3200],[null,null,\"https://play-lh.googleusercontent.com/awSo7nO6lWIxb3iql15MG0eHyksD_U9Xt1XjU-Pq1IbzuoZeg0FsxDYb8Kq5Ov_FH1xZmPCfBDEG1zhr23KM-g\"]]],\"Offline Games - No Wifi Games\",[\"4.4\",4.39],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.JindoBlu.OfflineGames\\u0026rdid\\u003dcom.JindoBlu.OfflineGames\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.JindoBlu.OfflineGames\"]],[\"qgJpGmcIQUoTCMjrorLHkJcDFX24rAId8gQ7O/oBDwoNCAASCQoFZW4tVVMQALoCOwofChljb20uSmluZG9CbHUuT2ZmbGluZUdhbWVzEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],[[[null,null,\"EhGvXNV5rZ4\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:EhGvXNV5rZ4?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:EhGvXNV5rZ4\",null,[1920,1080],null,null,\"AXH1ezmPZogQEWAxv2lbsgC1JU7FoIJcnjWwJPyobPvlu6WuAz07qy-eTFh921_7ytqN_UsbDEPbMu3CHmnG0hjlcg3PRwRskGRwRosOEH8tebthrDkzpfov6xXkVspDfvvaJRqOYRckWui8fw7peIuisojmqcBpCuY5AAHmd1WHkgwXbDq1e0W81V58uHjXzzmJJ4B91vYweHZNLgHzvY5aehLNh0u5NmdSPnLttzw4bbfjrX302VQx8fnYw_S-FLvd2OlnrXwp3SW1RggIXqnAQdxfKoXOfsZKCV1DeWu7iuBzyg\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/EhGvXNV5rZ4/hqdefault.jpg\"]]]],[null,\"Get ready for \\u0026#39;Offline Games\\u0026#39;: fun for all ages, and a mental workout too! This offline game collection is like an overflowing toy box packed with more than 20 unique minigames. It\\u0026#39;s designed for classic game enthusiasts, puzzle lovers, and challenge seekers. And the best part? You don\\u0026#39;t need an internet connection to enjoy it!\\u003cbr\\u003e\\u003cbr\\u003eOur array of Number Games like 2048 and 2248 will get your neurons firing. Engage in these numeric challenges and strive to hit the highest scores. They\\u0026#39;re perfect for keeping your mind sharp, and they\\u0026#39;re addictive, too! You\\u0026#39;ll find yourself coming back to beat your own scores time and again.\\u003cbr\\u003eWord Games are a great way to expand your vocabulary and language skills. With word guess and word finder, you\\u0026#39;ll embark on an adventure through a maze of letters, uncovering hidden words, and building your own word lists. It\\u0026#39;s a fun way to learn new words, and the challenge will keep you hooked for hours.\\u003cbr\\u003e\\u003cbr\\u003eFeel the adrenaline rush with our Thrilling Challenges. Step into the mind-bending world of Minesweeper, where every click could be your last. Or play Hangman, where you\\u0026#39;ll rack your brains to guess the right letters before time runs out.\\u003cbr\\u003e\\u003cbr\\u003eWe\\u0026#39;ve brought back some of your favorite Classic Memory Games. Engage your brain in our sound memory game, a modern twist on the classic \\u0026#39;Simon Says\\u0026#39;. For a bit of nostalgia, we\\u0026#39;ve also included the much-loved game of Snake.\\u003cbr\\u003e\\u003cbr\\u003eFor the serious strategists and thinkers out there, our Mind Benders section is perfect. Chess and Chess puzzles will provide a mental workout and fun brain training. Hone your strategic skills, and take on the challenge to become the grandmaster.\\u003cbr\\u003e\\u003cbr\\u003eOur Two-Player Games offer the perfect opportunity for a friendly showdown. Go head-to-head with AI in games like Checkers, Pool, or Tic Tac Toe, even when you\\u0026#39;re in airplane mode. It\\u0026#39;s fun gaming action whenever you want, wherever you are! See if your friends can do better!\\u003cbr\\u003e\\u003cbr\\u003eOur collection includes brain-stimulating games like Tap Match, Solitaire, Sudoku, Wood Blocks, 4 in a row, and the Sliding Puzzle in our Keep Them Thinking section. These games are designed to keep your mind sharp and focused, and they\\u0026#39;re also a lot of fun.\\u003cbr\\u003e\\u003cbr\\u003eEver wanted to try your hand at an exotic game? Now you can, right from your device, with Mancala in our Exotic Games section.\\u003cbr\\u003e\\u003cbr\\u003e\\u0026#39;Offline Games\\u0026#39; is a fantastic app for all ages - kids, teens, adults, and even seniors. It offers a fun, engaging, and stimulating gaming experience without the need for an internet connection. Whether you\\u0026#39;re on a long journey, stuck at home, or in the middle of a flight, you\\u0026#39;re never far from the action with \\u0026#39;Offline Games\\u0026#39;. It\\u0026#39;s the perfect app to challenge yourself, pass the time, and have loads of fun.\\u003cbr\\u003e\\u003cbr\\u003eRemember, with \\u0026#39;Offline Games\\u0026#39;, you don\\u0026#39;t need an internet connection to play. You can enjoy your favorite games anytime, anywhere. Say goodbye to those dull moments and welcome endless entertainment with \\u0026#39;Offline Games\\u0026#39;. Who knew having fun could be this easy? Jump in and start playing today!\"],\"JindoBlu\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/tYXyPMBNNp7BkIyXGVLJr-dsbg16XQstKGBrZqhREe1tNu155Nmh_dUjMJSqg3UeuR5xOXDzKCAy-CkF42-W\"],null,[55,37,67,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/