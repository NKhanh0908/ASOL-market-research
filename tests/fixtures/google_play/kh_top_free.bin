,[null,null,\"https://play-lh.googleusercontent.com/7ecOodbv7UFhw6pRl2BFBg8Ds5DpoEKprWECFCKiIM7PysQjFl7nWQzga_7-fVefrD1POaJeo2WKnD15rZru\"]]],\"Football Master: Mini Games\",[],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.abyudev.football.master.mini.games\\u0026rdid\\u003dcom.abyudev.football.master.mini.games\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.abyudev.football.master.mini.games\"]],[\"qgJwGm4ILUoTCMjrorLHkJcDFX24rAId8gQ7O/oBDwoNCAASCQoFZW4tVVMQALoCQgosCiZjb20uYWJ5dWRldi5mb290YmFsbC5tYXN0ZXIubWluaS5nYW1lcxABGAMSEgoECAEQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"Football Master: Mini Games brings together a dynamic collection of entertaining football mini-games — all packed into one application! Challenge your knowledge, test your reflexes, and prove your football expertise across diverse gameplay modes.\\u003cbr\\u003e\\u003cbr\\u003eFEATURED MINI-GAMES\\u003cbr\\u003e\\u003cbr\\u003eFootball IQ Quiz\\u003cbr\\u003eTest your soccer knowledge with challenging trivia questions. Identify real players, famous moments, and football facts. How much do you really know about the beautiful game?\\u003cbr\\u003e\\u003cbr\\u003eSave the Goat\\u003cbr\\u003eTap quickly to save your favorite player from danger! Execute rapid tapping to rescue characters in thrilling time-based challenges. Test your reaction speed and precision.\\u003cbr\\u003e\\u003cbr\\u003eReal or Fake\\u003cbr\\u003eDistinguish authentic football moments from imposters. Study images, player poses, and iconic moments to identify what\\u0026#39;s genuine.\\u003cbr\\u003e\\u003cbr\\u003eThumb Dance Challenge\\u003cbr\\u003eMatch the rhythm and execute quick reflexes through interactive dancing challenges. Perfect your timing and coordination.\\u003cbr\\u003e\\u003cbr\\u003eWho is the GOAT?\\u003cbr\\u003eIdentify football\\u0026#39;s greatest players. Match descriptions and achievements to the correct athletes competing for GOAT status.\\u003cbr\\u003e\\u003cbr\\u003eTap to Avoid Spike\\u003cbr\\u003eNavigate through obstacles with precision tapping. Complete challenges within time limits while avoiding dangerous hazards.\\u003cbr\\u003e\\u003cbr\\u003eGAME FEATURES\\u003cbr\\u003e\\u003cbr\\u003eMultiple Challenge Types\\u003cbr\\u003eExperience varied gameplay including quizzes, reflex tests, tapping games, and football knowledge challenges.\\u003cbr\\u003e\\u003cbr\\u003eProgressive Difficulty Levels\\u003cbr\\u003eStart with easy questions and gradually advance to expert-level football challenges requiring deep sport knowledge.\\u003cbr\\u003e\\u003cbr\\u003eIntuitive Mobile Controls\\u003cbr\\u003eSimple tap mechanics make gameplay accessible to all players while maintaining engaging challenge depth.\\u003cbr\\u003e\\u003cbr\\u003eCurrency \\u0026amp; Reward System\\u003cbr\\u003eEarn coins completing challenges. Accumulate rewards unlocking new content and special features.\\u003cbr\\u003e\\u003cbr\\u003eCompetitive Scoring\\u003cbr\\u003eTrack high scores and compete with players worldwide. Climb leaderboards through consistent performance.\\u003cbr\\u003e\\u003cbr\\u003eRegular Content Updates\\u003cbr\\u003eNew mini-games and challenges launch regularly preventing gameplay stagnation and maintaining engagement.\\u003cbr\\u003e\\u003cbr\\u003eWHY CHOOSE FOOTBALL MASTER?\\u003cbr\\u003e\\u003cbr\\u003eComprehensive Football Entertainment — diverse mini-games covering knowledge, reflexes, and tapping challenges.\\u003cbr\\u003e\\u003cbr\\u003eEngaging Quiz Mechanics — test football expertise across authentic sport trivia and knowledge challenges.\\u003cbr\\u003e\\u003cbr\\u003eAccessible Yet Challenging — easy entry point with genuine difficulty progression for dedicated players.\\u003cbr\\u003e\\u003cbr\\u003eOne-App Convenience — eliminate app switching with complete football gaming package.\\u003cbr\\u003e\\u003cbr\\u003eActive Development — continuous new content additions ensure perpetual fresh entertainment.\\u003cbr\\u003e\\u003cbr\\u003eUniversal Appeal — suitable for casual fans and hardcore football enthusiasts alike.\\u003cbr\\u003e\\u003cbr\\u003eFootball Master: Mini Games combines football knowledge with engaging mini-game mechanics for comprehensive sports entertainment.\\u003cbr\\u003e\\u003cbr\\u003eDownload Football Master: Mini Games and become a football legend!\"],\"Abyu dev\",\"100,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/LbfyjHzaWOp0QYPcyFZp_J9OMOFxB1JZImA2ASnC-ag6QoyzlExlJXzA7zoqPYth0UtbmN3CXkjXpeRS6BNYew\"],null,[229,29,32,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,[null,\"Suitable for all age groups. Some violence in a comical or fantasy context is acceptable. Bad language is not permitted.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.abyudev.football.master.mini.games\\u0026rdid\\u003dcom.abyudev.football.master.mini.games\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,nul