By1FhVyKIuQVqyRbIhvcLx_WoetjF0H1KjkqxzSxSYsLZFksWVYFwZ2YZbVof-HQki6fVL5Tm6JLcYI8BPVg\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/TSasX3QOijApPVIGcs7kXfXgdrCHFSPVDz-68wvCGVSn0RxjUnzgqcNVRA_I2NZI5qCh_BTd9JVzjwJeHVbC3i8\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/81zSz70ioRLIx_jK5VW3f1C-i-W5eH174ylRX8vqsfGbPVTVYS_MAMY8k4etWuUEp0v__kO1lAs2TjEM7s2_gQ\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/eKlDsNUjkxmxLfCRNR0TLdkiSWOo6VmVtKFmOWt_va1HFeVfDbDZlbCLQQpCLKSgJJq3O5DIGFqdkuu9SRE6Uw\"]]],\"Fashion Stylist: Dress Up Game\",[],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.simulation.fashion.dressup.stylist\\u0026rdid\\u003dcom.simulation.fashion.dressup.stylist\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.simulation.fashion.dressup.stylist\"]],[\"qgJwGm4IXkoTCMjrorLHkJcDFX24rAId8gQ7O/oBDwoNCAASCQoFZW4tVVMQALoCQgosCiZjb20uc2ltdWxhdGlvbi5mYXNoaW9uLmRyZXNzdXAuc3R5bGlzdBABGAMSEgoECAEQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"Welcome to Fashion Stylist: Dress Up Game – the ultimate interactive journey where your choices dictate the drama, the romance, and your ultimate rise to stardom! 👑\\u003cbr\\u003eAfter a heartbreaking betrayal that left your life in ruins, it’s time to pick up the pieces, reclaim your confidence, and show the world what you are truly capable of. Will you let the drama hold you back, or will you command the runway and write your own success story? 🌟\\u003cbr\\u003e🎬 DIVE DEEP INTO THE DRAMA Navigate a gripping narrative filled with sudden twists, hidden romance, and cutthroat rivalries. Every decision you make shapes your destiny. Will you confront your rivals head-on, or let your incredible styling skills do the talking? The choice is entirely yours! 💔➡️💖\\u003cbr\\u003e💃 DESIGN YOUR ULTIMATE LOOK Express your unique style with thousands of glamorous outfits, chic accessories, and breathtaking makeup options. From red carpet galas to trendy everyday transformations, your closet is your kingdom. Step into the shoes of a top fashion stylist and turn ordinary looks into extraordinary masterpieces. 💄✨\\u003cbr\\u003e🔥 EXCITING FEATURES:\\u003cbr\\u003e📖 Gripping Narrative: Experience a mature, choice-driven storyline full of revenge, romance, and ambition.\\u003cbr\\u003e👗 Massive Wardrobe: Collect thousands of stunning dresses, shoes, and jewelry pieces to perfect your style.\\u003cbr\\u003e💄 Creative Makeovers: Experiment with unique cosmetics, hairstyles, and facial features to match the mood of every scene.\\u003cbr\\u003e🏆 Runway Battles: Showcase your designs, compete against other players, and claim your crown as the style icon.\\u003cbr\\u003eCan you survive the cutthroat industry and build your empire from the ground up? Your journey from a betrayed assistant to an industry legend begins right now. 🚀\\u003cbr\\u003eDownload this dress up game today, start your journey to master every style challenge, and take control of your dazzling new life! 🎉\"],\"Nirvana Studios\",\"500,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/EUUfN1d7B011an233ThNkr6fGIlNG4ANtzC3x3wSBP5XPaib4xKXblXzxLcGguGZwBXjUbgP4K5EBkxH5-IijLg\"],null,[245,179,239,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz