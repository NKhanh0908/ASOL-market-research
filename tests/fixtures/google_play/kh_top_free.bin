M-bS8g0JPN7EyocSV_Irfd2k_AAvyEGdf8hOXwlcjiQ\"]],[null,2,[1200,1920],[null,null,\"https://play-lh.googleusercontent.com/5N_2kwA7oEEmOG9tENSU8tWxCMjavbhgQeXDnMq293W7qKYUzZShqLCIBHoVjlH3Qg8sEhZgZS4v744woBaCQc4\"]],[null,2,[1200,1920],[null,null,\"https://play-lh.googleusercontent.com/TRxSSnpnzsKnptwBmG1JhvvteFCvYxqi8TPQa5plHZrRkKkREPirSVvWYgUFP1mGXR2cu_55-vCHAijbqxvc\"]]],\"Bouncing Hop\",[\"3.3\",3.2631578],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.rhythm.hop.tiles.ball.music.game\\u0026rdid\\u003dcom.rhythm.hop.tiles.ball.music.game\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.rhythm.hop.tiles.ball.music.game\"]],[\"qgJ8GnoIGkoTCMjrorLHkJcDFX24rAId8gQ7O/oBFwoVCPvNsp2//6iJQxIJCgVlbi1VUxAAugJGCioKJGNvbS5yaHl0aG0uaG9wLnRpbGVzLmJhbGwubXVzaWMuZ2FtZRABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"Bouncing Hop: Music Rhythm Game is inviting you to join in! \\u003cbr\\u003eAre you a fan of music games that challenge your limits with thousands of songs? Look no further than Bouncing Hop - the ultimate music game that blends song games and ball games! Classic gameplay mechanics combined with meticulously designed 3D game scenes bring you an extraordinary experience like a live concert. It\\u0026#39;s simple and fun: just drag your ball to jump left or right, and make sure to hop on the next music tile and avoid falling. Download this game now and show us how far you can jump!\\u003cbr\\u003e\\u003cbr\\u003e【Easy Control with Finger】\\u003cbr\\u003e1. Tiles will appear with music.\\u003cbr\\u003e2. Hold and drag the ball to jump left or right on the next tile.\\u003cbr\\u003e3. Hop on the center of the tiles for higher scores.\\u003cbr\\u003e4. Try not to miss any tiles to keep the game going.\\u003cbr\\u003e5. Stay vigilant and watch out for traps!\\u003cbr\\u003e6. Collect as many coins as you can to unlock new songs and characters.\\u003cbr\\u003eMost importantly, enjoy the addictive challenges and beats designed for each song.\\u003cbr\\u003e\\u003cbr\\u003e【Standout Features of Game】\\u003cbr\\u003e- One-touch control, relaxing and casual game\\u003cbr\\u003e- Various music styles, including but not limited to EDM, hip-hop, rock, R\\u0026amp;B, country, and folk\\u003cbr\\u003e- Worldwide hot songs, e.g.., TikTok hit songs for your choice\\u003cbr\\u003e- Bright colors and stunning 3D visual effect\\u003cbr\\u003e- Perfect test of reflexes and coordination\\u003cbr\\u003e- Fabulous choice to kill time anytime, anywhere\\u003cbr\\u003eMore characters are being continuously updated...\\u003cbr\\u003e\\u003cbr\\u003eIf any producer or label has an issue with any of the music used in the game, please send an email to publish@humshan.com, and it will be deleted immediately if necessary (this includes the images used).\\u003cbr\\u003e\\u003cbr\\u003eSprunki Sprunki Sprunki~\\u003cbr\\u003eSay hello to the ever-calm Dandy,\\u003cbr\\u003ewho brings music to everyone.\\u003cbr\\u003eMake a beat and sing along\\u003cbr\\u003eGet funky funky funky~\\u003cbr\\u003eBIG NEWS: Super cool remix songs from incredible sprunki music box have been uploaded! Download/update now to challenge yourself with spooky, horror-themed tunes!\"],\"HUMSHAN LIMITED\",\"5,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/cil3jiJzYCunlR3RjAvvsT6Qx7RWehqvwkMaoBqQmerrmff86Ys7wRfKZwMXnb6Fput9nIYe-Au_xntb54hM\"],null,[63,25,98,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,[null,\"Suitable for all age groups. Some violence in a comical or fantasy context is acceptable. Bad language is not permitted.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.rhythm.hop.tiles.ball.music.game\\u0026rdid\\u003dcom.rhythm.hop.tiles.ball.music.game\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$5.99 - $39.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.muscle.morph.lean.run\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/OGRv5I-zrta-x_0LdhVncrOZa4Y0ekxjeLnEdiWHBjpjqjefMOIlo77tCAjQ5_r6dOV0Nr7W0xZzKcOLci4eGw\"],null,[255,203,75,255],null,null,null,2],[[null,2,[1004,565],[null,null,\"https://play-lh.googleusercontent.com/FRyVs4ZdbQfyYzoEZJwc-7ex4SSArxc8pfVMmu8H3q29cjBBBGrf3KVHqoOd-nlVJ6K8TFowaAecFw51v3SQ\"]],[null,2,[1008,567],[null,null,\"https://play-lh.googleusercontent.com/Rpuk-QZxnzR_x24Ffl8FdViwzidY0RfIbQMhaXY34NwFzTRsEpRugIcCQlPzwdVVJq3-sSMm6wfq72jPs6rw5Yc\"]],[null,2,[1008,567],[null,null,\"https://play-lh.googleusercontent.com/X6j5MjgeZ_PQwZJqOMJ2Z0-1yHPqcPsHo1AxZtiQQ8XS9noHLibrahIDiQK2WSBMSX2tvLMyWdYcJE8SwYdB\"]],[null,2,[1007,566],[null,null,\"https://play-lh.googleusercontent.com/kgjr3J2pe6mFmd1Ix3btlSid6inh1GJ_OPUMGjkls_uS4D5ma-rCZDMT9N7z64VY3mF8t0CRzh6JvQAuAM_lTw\"]]],\"Muscle Morph\",[\"3.6\",3.6363637],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.muscle.morph.lean.run\\u0026rdid\\u003dcom.muscle.morph.lean.run\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.muscle.morph.lean.run\"]],[\"qgJpGmcIG0oTCMjrorLHkJcDFX24rAId8gQ7O/oBDwoNCAASCQoFZW4tR0IQALoCOwofChljb20ubXVzY2xlLm1vcnBoLmxlYW4ucnVuEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"Welcome to Muscle Morph, the craziest and most action-packed muscle race ever! 🏃\\u200d♂️💨 Are you ready to pump some iron, bulk up, and smash your way to victory?\\u003cbr\\u003e\\u003cbr\\u003eIn this thrilling running game, your goal is simple: collect, grow, smash, and win! Start as a skinny runner and collect barbells of your matching color to build massive muscles. 🏋️\\u200d♂️💪 The more you gather, the bigger and stronger you become!\\u003cbr\\u003e\\u003cbr\\u003eBut the path to the finish line isn\\u0026#39;t easy. You will face epic obstacles that require pure brute strength! Push massive walls 🧱, swim through wild waters 🏊\\u200d♂️, pull out giant radishes 🥕, and smash heavy barriers to pieces! Every obstacle you tackle will burn your energy and make you shrink, so you must keep collecting barbells to stay huge and powerful. 🔋\\u003cbr\\u003e\\u003cbr\\u003eWatch out for your rivals! In Muscle Morph, size matters. 🥊 If you are bigger and stronger than your opponents, bump into them to knock them down! They will be stunned for a few seconds and drop special Black Barbells 🖤. These rare black barbells can be collected by ANYONE for a massive power boost. Crush your enemies and steal their gains!\\u003cbr\\u003e\\u003cbr\\u003e🌟 GAME FEATURES 🌟\\u003cbr\\u003e🏋️\\u200d♂️ Collect \\u0026amp; Morph: Gather matching barbells to transform your character from skinny to a giant bodybuilder!\\u003cbr\\u003e🧱 Epic Obstacles: Push, smash, swim, and pull! Test your muscles against wildly fun challenges.\\u003cbr\\u003e🥊 Knock Down Rivals: Be the biggest! Bump into smaller players to knock them out and loot their dropped Black Barbells.\\u003cbr\\u003e🏁 Fierce Racing: Balance your muscle-building strategy and speed to be the first to cross the finish line!\\u003cbr\\u003e🎮 Addictive Gameplay: Simple swipe controls with deeply satisfying mechanics and visual feedback.\\u003cbr\\u003e\\u003cbr\\u003eDo you have what it takes to be the biggest, strongest, and fastest runner on the track? 🏆\\u003cbr\\u003e\\u003cbr\\u003eDownload Muscle Morph now, start your ultimate fitness race, and show them who is the boss! 💥🚀\"],\"AbbaYosua.Design\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/m_6hqdtumCJgSHOEZm4_90kMFP6njKFGP8WK3cx3rBG8VNEg9LNrEiEL-4zOOyXtMqyMNs79C8z9YkwxU0dM\"],null,[103,205,252,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,[null,\"Suitable for all age groups. Some violence in a comical or fantasy context is acceptable. Bad language is not permitted.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.muscle.morph.lean.run\\u0026rdid\\u003dcom.muscle.morph.lean.run\\u0026featu