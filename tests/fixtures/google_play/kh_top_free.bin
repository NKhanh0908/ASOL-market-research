ll,[null,null,\"https://i.ytimg.com/vi/auIcFku2NMc/hqdefault.jpg\"]]]],[null,\"Are you ready to turn your dream restaurant into reality?\\u003cbr\\u003e\\u003cbr\\u003eMy Little Restaurant is a simulation game where you take on the role of a manager of your newly opened restaurant in the town. With idle mechanics and simple handtaps, you can enjoy the entertainment the game bringing back while building a large-scale restaurant. This restaurant has a wide variety of decorations, 5-star rated appetizing dishes, and lovely characters.\\u003cbr\\u003e\\u003cbr\\u003eThe customers are upset? The staff is slacking off? Is the restaurant too small? The food bad?\\u003cbr\\u003e\\u003cbr\\u003eAs the manager, it’s your job to turn things around! You’ll need to upgrade your dishes, purchase items for the restaurant, and train your staffs to deliver exceptional service. Keep an eye on customer feedback and make adjustments to your menu to satisfy their cravings. Expand your restaurant’s space by unlocking new areas and enhancing the decorations to create a welcoming atmosphere. \\u003cbr\\u003e\\u003cbr\\u003eCan you transform your little restaurant into a kingdom and earn the acclaim it deserves? Dive into the fun and see if you have what it takes to become the ultimate restaurant tycoon! With requirements you face for each level, you\\u0026#39;ll gather valuable resources that can be used to improve your business.\\u003cbr\\u003e\\u003cbr\\u003eGame Features :\\u003cbr\\u003e🎮 Idle Mechanics easy to play.\\u003cbr\\u003e🍝 Increase menu options and enhance quality through Match-3 games. \\u003cbr\\u003e✨ Unlock new areas and add more facilities.  \\u003cbr\\u003e👨\\u200d🍳 Hire and train your staffs to ensure excellent service and keep customers satisfied.\\u003cbr\\u003e📤 Participate in daily challenges to earn rewards and exclusive items.\\u003cbr\\u003e\\u003cbr\\u003eStay tuned for updates as we regularly enhance the game and introduce new features!\\u003cbr\\u003eDownload My Little Restaurant for free now and embark on a delightful journey of running the restaurant!\"],\"ABI GAMES PTE. LTD.\",\"5,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/anGIvM8F7B-5hs5CDmp-NuVgNKc0qFLn2MizmLwTI2APd_s6eIh4du7Q3S-oCeV99Lih0LAQl5Fu6PfHCQxw4A\"],null,[126,202,176,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,[null,\"Suitable for all age groups. Some violence in a comical or fantasy context is acceptable. Bad language is not permitted.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.gege.mylittlerestaurant\\u0026rdid\\u003dcom.gege.mylittlerestaurant\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $19.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.sh.mini.antistress.relaxing.games\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/lf9H9LovkvO71MIfXAfpmQOd2ZqlhoKLs59jRCI1w0Maz9qZ-ltx3l1IW1K3bzWJ61LdaZEzu6Yd_EnwTLVQ4e0\"