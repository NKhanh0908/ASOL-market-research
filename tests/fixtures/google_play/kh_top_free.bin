ull,\"https://play-lh.googleusercontent.com/NuKjFKYaOYLr0guZ_yD8JwRN2K6y0AISj46jBdMffakZlJrnn_b_q8t-cvSO3a8TliQ-6DAMaeyIYSrHj7XX\"]],[null,2,[1200,2760],[null,null,\"https://play-lh.googleusercontent.com/cDuCI5c6_IxpYF3XFkEmRyzM7WTGxw9I03eA0LIMUsfShnEKHM_ClBK-kuf0IX6y5e19E7dWmLIst_n4rA5ncg\"]],[null,2,[1200,2760],[null,null,\"https://play-lh.googleusercontent.com/gocSy91k-kGzo9x7TMoS3iiWY1ioM9acIKdK6fuxKEemVdwVWv4qy6_zBumUGeH8IT-z-30eeP_5k5On7_91-SE\"]],[null,2,[1200,2760],[null,null,\"https://play-lh.googleusercontent.com/ENHeIZWmiPUOG3MHY-pbH8Tw12rH0HzMIZbIJZSUKQXjWLJrOtPOGjdshhA6n5xXYXeYzNEfjB4ZVb9AxoJgXQ\"]],[null,2,[1200,2760],[null,null,\"https://play-lh.googleusercontent.com/eETO61C4DjuD0kSyznPONc26zWtlC_35411D5n4LNzVT65XfYIL1JVecmyZopTpD98Y9AXYZ5rStd6OgbCpJ\"]],[null,2,[1200,2760],[null,null,\"https://play-lh.googleusercontent.com/4YvEkhqOSinBIk1AvDRzX-jC-zwFhRq9oEDf3kfPurkEEfAGI3dPo3yoWnNRHrskZb4gEco3s4OPipL_oy7k\"]]],\"The Battle Cats\",[\"4.4\",4.44],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003djp.co.ponos.battlecatsen\\u0026rdid\\u003djp.co.ponos.battlecatsen\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003djp.co.ponos.battlecatsen\"]],[\"qgJoGmYIV0oTCMjrorLHkJcDFX24rAId8gQ7O/oBDwoNCAASCQoFZW4tVVMQALoCOgoeChhqcC5jby5wb25vcy5iYXR0bGVjYXRzZW4QARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],null,[null,\"★★★ Weirdly Cute Cats rampage across the world! ★★★\\u003cbr\\u003eCommand your Cats with simple controls in a battle through space and time! No need to register to develop your own Cat Army! BATTLE WITH ALL THE CATS!!\\u003cbr\\u003e\\u003cbr\\u003e\\u003dSuper Simple Battle System\\u003d\\u003cbr\\u003eJust tap on the Cat you want to fight for you! \\u003cbr\\u003eFire the Cat Cannon to blast baddies getting too close to your base! Overcome weird enemies with the right Cat squad and take down the enemy base!\\u003cbr\\u003e\\u003cbr\\u003e\\u003dSuper Simple Leveling System\\u003d\\u003cbr\\u003eClear stages to get XP and items to level up the Cats! What will they evolve to at level 10? Can you unlock their True Form?\\u003cbr\\u003e\\u003cbr\\u003e\\u003dSuper Simple Fun!\\u003d\\u003cbr\\u003eCollect glorious treasures while you take over the world! \\u003cbr\\u003eRecruit dozens of rare and exotic Cats(?) and create the ultimate feline army!!\\u003cbr\\u003eHundreds of stages across three Story Mode adventures and the Legend challenges.\\u003cbr\\u003e\\u003cbr\\u003ePerfect for Casual Play! Fun for all ages, anyone (and their cat too!) can enjoy the \\u0026quot;Battle Cats\\u0026quot;!\\u003cbr\\u003e\\u003cbr\\u003eWhat type of Cats will YOU battle with today? Bring on the weirdly cute Battle Cat army!\\u003cbr\\u003e\\u003cbr\\u003e****************************\\u003cbr\\u003e* \\u0026quot;The Battle Cats\\u0026quot; requires a network connection for reliable access to gameplay features.\\u003cbr\\u003e* Downloading or updating \\u0026quot;The Battle Cats\\u0026quot; requires a stable network connection to prevent errors.\\u003cbr\\u003eA notification of a large download will appear before installation.\\u003cbr\\u003eIf you are not in a location with strong Wi-Fi, please uncheck the \\u0026quot;Update over Wi-Fi only (Android)\\u0026quot; option or turn “Use Cellular Data\\u0026quot; on before you begin downloading. \\u003cbr\\u003eAn unstable connection environment during download and/or updates may result in installation issues. \\u003cbr\\u003e* There will be regular updates for \\u0026quot;The Battle Cats\\u0026quot; with new and improved features. However, some older devices may not be able to support these changes.\\u003cbr\\u003ePlease be aware of this before you update. If there are any problems, please feel free to contact our tech support at support_en@bc01.ponos.net\\u003cbr\\u003e\\u003cbr\\u003e****************************\\u003cbr\\u003eBefore you start playing, please read the \\u0026quot;Terms of Use\\u0026quot; carefully. \\u003cbr\\u003eBy downloading and playing \\u0026quot;The Battle Cats\\u0026quot;, you agree to these Terms.\\u003cbr\\u003e\\u003cbr\\u003eTerms of Use\\u003cbr\\u003ehttps://ponosgames.com/reg/en/agreement/index.html\\u003cbr\\u003e\\u003cbr\\u003ePrivacy Policy\\u003cbr\\u003ehttps://ponosgames.com/reg/en/policy/index.html\\u003cbr\\u003e\\u003cbr\\u003ePresented by PONOS\"],\"PONOS Corporation\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/t6c24tXah9pBj-an9ht3X4s8Mf8xm8UZyo63CYLLXfOK3Gv7i90zqTbfQXP7qOP8ZgjOZhqSnXhuc40_1yGTlfo\"],null,[243,246,246,255]],null,[\"Rated for 12+\",[null,2,[366,512],[null,null,\"https://play-lh.googleusercontent.com/yQChfa9XKlaXMIYTk8w8QwChjT8_SH-_2d2SS-kesw0TLQK1nxtw54bDcoZ09freZJgKrtg4f__is-31Vg\"]],[null,\"Sexual Innuendo\"],[null,\"Digital Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/YrkR-GP7OKghBTATCoO_jJrchSVrh-NSUBb5DnbRZC1DbLK_cgV9FC2e_iI4GzLsKXuZjuFZajnGCiA8qA\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003djp.co.ponos.battlecatsen\\u0026rdid\\u003djp.co.ponos.battlecatsen\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.59 - $166.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[n