ull,null,\"https://play-lh.googleusercontent.com/-jh2jOsgOLRrqYdhuszuGM-hJHw-flRitjj0HChKDNg_N-D7-cVN9-8y9cUk0PFaU-z52b_xHxOOfSR3CKqsBw\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/uBQeVq5-xSeZvjo0CBwjrqn51GaGH02Cn3_vyhkuIclqMPkVrrUNXC-H-BSfluSz-4mLGP4A8zSd1uBBNImX6g\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/HNWmH9rfSfOQFpq6UWNQulYO8tjU8cmnhodiI6fC2hSRjk5aNz3jPvOfZFbaRE7A_8-WluQgGMjQiFDYFCPiXg\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/RfTNE6k-CXeH1TXhP7Joz3ssL6Zlr6S21tiCjBQbh83y5qADymFxnZ5yhBRES0dpOnjK3KXhGKDB8pyg9p3-vDQ\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/3TWNnePK_9PCLIdECmE_2ilTmXPpEXZUf42QldW1BZ0yAP0k3u5TdnrAavyxnkYA_l00mMGdYJ9HmuayLN3C\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/zRyNVmXUsl2P9VLxl3gYfwBdnjiz8tzLJjFhAiM13p-u8GbtxeSioRvXcoLCPDeJvaCjFPTjEZKKxqZLDCQz\"]]],\"Hair Salon Makeover Studio\",[],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.mrxvip.hair.salon\\u0026rdid\\u003dcom.mrxvip.hair.salon\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.mrxvip.hair.salon\"]],[\"qgJfGl0IJ0oTCMjrorLHkJcDFX24rAId8gQ7O/oBDwoNCAASCQoFZW4tVVMQALoCMQobChVjb20ubXJ4dmlwLmhhaXIuc2Fsb24QARgDEhIKBAgBEAEKBAgEEAEKBAgLEAE\\u003d\"],null,[null,\"Step into a creative beauty studio and design stunning new looks from start to finish.\\u003cbr\\u003eIn Hair Salon Makeover Studio, you can wash, cut, curl, straighten, dry, and color hair using a full set of salon tools. Try bold colors, soft tones, trendy shapes, and polished styles as you transform each model into a fresh fashion icon.\\u003cbr\\u003eComplete every makeover with makeup, outfits, and accessories. Mix different styles, experiment with color combinations, and capture the final look in your personal photo album.\\u003cbr\\u003eFeatures:\\u003cbr\\u003e- Creative hair salon gameplay\\u003cbr\\u003e- Wash, cut, curl, straighten, dry, and color hair\\u003cbr\\u003e- Many hairstyles, shades, and styling options\\u003cbr\\u003e- Makeup, outfits, and fashion accessories\\u003cbr\\u003e- Photo album for finished looks\\u003cbr\\u003e- Relaxing offline gameplay\\u003cbr\\u003e-  Easy controls and smooth salon interactions\\u003cbr\\u003eBuild your own beauty routine, create unique makeovers, and show your styling talent in Hair Salon Makeover Studio.\"],\"MR. PROXY CORE\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/a6PWjLZ-TL07r6CDKkNVJaCwuyyT8VJBR-074vu15I5rqxDbKIaeK8z1fi6NZQbsJfIYVQdGfUmuk32rDNAFaQ\"],null,[243,184,227,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,[null,\"Suitable for all age groups. Some violence in a comical or fantasy context is acceptable. Bad language is not permitted.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.mrxvip.hair.salon\\u0026rdid\\u003dcom.mrxvip.hair.salon\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]