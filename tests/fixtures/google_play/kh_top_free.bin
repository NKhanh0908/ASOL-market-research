ll,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.outfit7.mytalkingangelafree\"]],[\"qgJvGm0IFUoTCMjrorLHkJcDFX24rAId8gQ7O/oBDwoNCAASCQoFZW4tVVMQALoCQQolCh9jb20ub3V0Zml0Ny5teXRhbGtpbmdhbmdlbGFmcmVlEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"Talking Angela is the super fun virtual star who can’t wait to dance and sing her way to the top.\\u003cbr\\u003e\\u003cbr\\u003ePlayers help her stay happy and busy with day-to-day activities in her 3D world:\\u003cbr\\u003e- Stylish makeup looks\\u003cbr\\u003e- Wonderful wardrobe choices\\u003cbr\\u003e- Super sweet activities\\u003cbr\\u003e- Special sticker albums\\u003cbr\\u003e\\u003cbr\\u003eShe’s interactive. She’s customizable. She’s fun. And she’s always ready to make new friends.\\u003cbr\\u003e\\u003cbr\\u003eFrom the creators of My Talking Tom, My Talking Tom 2 and My Talking Tom Friends comes the pet who’s a star in the making.\\u003cbr\\u003e\\u003cbr\\u003eThis app contains:\\u003cbr\\u003e- Promotion of Outfit7\\u0026#39;s products and advertising;\\u003cbr\\u003e- Links that direct customers to Outfit7’s websites and other apps;\\u003cbr\\u003e- Personalization of content to encourage users to play the app again;\\u003cbr\\u003e- YouTube integration to allow users to watch videos of Outfit7\\u0026#39;s animated characters;\\u003cbr\\u003e- The option to make in-app purchases;\\u003cbr\\u003e- Subscriptions which automatically renew at the end of a subscription period unless cancelled. You can manage and cancel your subscription any time via Settings in your Google Play account;\\u003cbr\\u003e- Items to purchase (available in different prices) using virtual currency, depending on the player’s progress;\\u003cbr\\u003e- Alternative options to access all functionalities of the app without making any in-app purchases using real money.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003eTerms of use: https://talkingtomandfriends.com/eula/en/\\u003cbr\\u003ePrivacy policy for games: https://talkingtomandfriends.com/privacy-policy-games/en\\u003cbr\\u003eCustomer support: support@outfit7.com\"],\"Outfit7 Limited\",\"1,000,000,000+\",null,null,null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/bdNHZ9qChYI2QTcgjepYZLMYx378R1xC8uAO2GiTyB7pbyICtgcmUb2feO4ItlYKDssLjpHbbIz0AG5uWX1IqA\"],null,[88,33,80,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.outfit7.mytalkingangelafree\\u0026rdid\\u003dcom.outfit7.mytalkingangelafree\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $99.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.mana.stickdemon.slayerfight\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/-0lXatGPURN781CYC0f4Yp4TNiB3vgq-Fy5E8ohqWha1VSE02CPAkbzPR4BOVsJRliUCtJg9pP1veVEh5HLVtUM\"],null,[38,18,50,255],null,null,null,2],[[null,2,[1242,2208],[null,nul