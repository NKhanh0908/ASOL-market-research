,[1200,1920],[null,null,\"https://play-lh.googleusercontent.com/cVvT5D740WOJnzqeRQEnzXgMT-eYh12nyXWcol-UyxOsz73N_eUO7g-tMsuONB5U3UkkZGGoXPzT6bPIZ5dqNgk\"]],[null,2,[1200,1920],[null,null,\"https://play-lh.googleusercontent.com/35nf5Z5x8Ol-SpJ7FO8FKF7sUkfny_kAvcTFSg-seeTqoQFkK_CgG7AqR-NcSvUv13UDMmRJebhMF78LYKryKA\"]],[null,2,[1200,1920],[null,null,\"https://play-lh.googleusercontent.com/aKuFfsiR1kHwjb6VEyIeQhO3nrX1a4amOfaDY5zwpSOGe3tBJJkgfPs8bmi2pGuKlZOS0C2US70k8zkBKXsj8Q\"]],[null,2,[1600,2500],[null,null,\"https://play-lh.googleusercontent.com/CHTH1EtxAQnkbUiB7NU8QgeppkYO8aKUI1SY9qvCuCIRvkrK0d4I54YNpXqMb3VrG3f75jnW8XhR1R8a8BG2rw\"]],[null,2,[1600,2560],[null,null,\"https://play-lh.googleusercontent.com/BxRNtbDTUTJj2F_fNHTo6GIePcYEa6tE2xuPwZwMnovg1jsdEAm12TSF7la_029t1zClSQK38eG1n_D3_F_PWg\"]],[null,2,[1600,2560],[null,null,\"https://play-lh.googleusercontent.com/vqaw3ScHKEnPn2MEbbLSqoGFlg1BCjfSKld4HigJwHFrgbQUNGWF7lHba5okTchCHhcVBVa0i3V0dl6iWVc4uw\"]],[null,2,[1600,2560],[null,null,\"https://play-lh.googleusercontent.com/UHJAxeS2MCFy7iG2TF7MD4d7phQMB7VZ9GIcyrptx4pVUdvohW-PkDU4_H2rhMbOLDpU1ySJDOskrXJrpf-0AJI\"]],[null,2,[1600,2560],[null,null,\"https://play-lh.googleusercontent.com/jQ_HdPFiLvVvDRqWZQSJ5xFntwIpaYA8EodgP6tX1V8fHaZyIgafpeKr3r69ZrKCVvw862duUquIvZ0t657YhA\"]]],\"FarmVille 2: Country Escape\",[\"4.6\",4.5720134],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.zynga.FarmVille2CountryEscape\\u0026rdid\\u003dcom.zynga.FarmVille2CountryEscape\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.zynga.FarmVille2CountryEscape\"]],[\"qgJzGnEIIUoTCLXM77LHkJcDFSS6rAIdLhkZOPoBFwoVCOGk7e/gwcOLQxIJCgVlbi1VUxAAugI9CicKIWNvbS56eW5nYS5GYXJtVmlsbGUyQ291bnRyeUVzY2FwZRABGAMSEgoECAEQAQoECAMQAQoECAQQAQ\\u003d\\u003d\"],[[[null,null,\"56SFtYKnU5g\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:56SFtYKnU5g?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:56SFtYKnU5g\",null,null,null,null,\"AXH1ezmraEbUYaAuTy411FYKdcFmDr1mleUVMzSHEK9WnQRZFmm2__eBikLGB6y5oN5cvfXE4BbXeBWLGMVVOWDrUT9bhz7L1ImmoEnmD1MKPtON1BCZ0Ff9KiYbRSOPJuVbdVq-V2iijScNXXHKA6BL1xfrPvuxfmudhPvx5NQ2W95wlngmXMQmu_6EiaEg_ZOGyJ0t8--ObPCILiIeKZTLlO266ITrSoN4k8oT-BP224wF4AXhqcMftZbnIJhTc8ZfxwptRHCLELHEX5v6qpAM8RAHxcL4lHt43dhRcsgl_xvEHA\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/56SFtYKnU5g/hqdefault.jpg\"]]]],[null,\"Escape to the countryside where your farm awaits! Clear land to grow crops and trees, then use the harvest to make goods to sell. Nurture adorable animals on your farm; feed them to produce milk, eggs, cheese and so much more! Use workshops like Dairy, Pastry Ovens, Stovetops, Dinner Ovens to make classic recipes that you can sell on orderboards and marketplaces \\u0026amp; earn coins and experience points to level up. \\u003cbr\\u003eGather these crafts and a few rare ingredients to make classic recipes and sturdy crafts at quaint workshops like Craft Workstations, Loom, Winery, Beachfront grill, Doll Making tables and more. Use these crafts to navigate your way through different kinds of events on the farm. \\u003cbr\\u003eExplore the glade, pond, mine, \\u0026amp; other secret places hidden in the underbrush to gather rare ingredients. Your Farmhand friends will help you gather these secret ingredients which you can use to trade on marketplaces or for crafting interesting recipes.\\u003cbr\\u003eJoin or form a farm Co-Op, and help, trade, compete, or just chat with friends. Level up your farming experience by exchanging tips and tricks with fellow Co-Op members \\u0026amp; neighbors. \\u003cbr\\u003eCustomize your farm and make it your own! Decorate your farm with flowers, birdhouses, antique fountains, swings \\u0026amp; more! Enhance your farm with scarecrows to cater to the needs of your crops. Differentiate your farm from your neighbors’ by putting up fences \\u0026amp; stone paths \\u0026amp; make your farm beautiful! The opportunities are endless to build your dream farm!\\u003cbr\\u003eOther Country Escape adventures involve:\\u003cbr\\u003e●        Rescuing exotic creatures at the Animal Park\\u003cbr\\u003e●        Pairing wine and cheese at the Tasting Table\\u003cbr\\u003e●        Racing with fellow farmers at the Boat Club\\u003cbr\\u003e●        Visiting the County Fair with your best bakes\\u003cbr\\u003e●        Uncovering a new ecosystem of aquatic animals and crops\\u003cbr\\u003e●        Mastering your farm\\u0026#39;s finest goods to earn worldwide prestige\\u003cbr\\u003e●        Collecting daily prizes at the Prospector\\u0026#39;s Corner and Prize Wheel\\u003cbr\\u003e●        And so much more!\\u003cbr\\u003eFeatures of Country Escape:\\u003cbr\\u003eBuild your dream Farm:\\u003cbr\\u003e●        Plant new crops, water them \\u0026amp; harvest them to grow your farm\\u003cbr\\u003e●        Utilize workshops like Windmill, Pastry Oven, Dairy, Stovetop to enhance your farm\\u003cbr\\u003e●        Use crops \\u0026amp; workshops to make items like Country Biscuits, Cheese, Yogurt and so much more!\\u003cbr\\u003eNurture Farm Animals:\\u003cbr\\u003e●        What is a farm without animals!\\u003cbr\\u003e●        Cows, Chickens, Goats, Horses \\u0026amp; more animals are ready to join your farm\\u003cbr\\u003e●        Special pets like Rescue Tabby waiting to join you \\u0026amp; help you gather exotic ingredients to cook up interesting items on the farm\\u003cbr\\u003eGo on Farm Adventures:\\u003cbr\\u003e●        Pappy’s Pond: Use your Farmhands at Pappy\\u0026#39;s Pond to find Trout, Bass, \\u0026amp; Mint!\\u003cbr\\u003e●        Sophia’s Tasting Table: Sophia will buy fine wine, cheeses, \\u0026amp; other high-end goods from your farm\\u003cbr\\u003e●        Merryweather Mine: Excavate the mine and get exotic minerals  like quartz, copper \\u0026amp; tin!\\u003cbr\\u003eFarm and Play with Friends:\\u003cbr\\u003e●        Join coops \\u0026amp; invite friends to play together\\u003cbr\\u003e●        Help others by trading items from your barn\\u003cbr\\u003e●        Compete with friends and neighbors in friendly races to win rewards\\u003cbr\\u003eIt\\u0026#39;s country life at its most charming. Welcome home to FarmVille!\\u003cbr\\u003e\\u003cbr\\u003eAdditional information:\\u003cbr\\u003e• The game is FREE to download \\u0026amp; includes optional in-game purchases (including random items). Information about drop rates for random item purchases can be found in-game. If you wish to disable in-game purchases, please turn off the in-app purchases in your phone or tablet’s Settings.\\u003cbr\\u003e• Use of this application is governed by Zynga’s Terms of Service, found at https://www.take2games.com/legal.\\u003cbr\\u003e• For information about how Zynga uses personal data, please read our privacy policy at https://www.take2games.com/privacy.\"],\"Zynga\",\"50,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/8UxLIijkWMRPm8Oy-tI7Ajd3Tgg0egOj6d2GIEpKaF3DIEiIEq6tCFyxMurtxKwgPxHNM1j9hx80FpF5-D3yeQ\"],null,[126,192,253,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,[null,\"Users Interact, In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],nul