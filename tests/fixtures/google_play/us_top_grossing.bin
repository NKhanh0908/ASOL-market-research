[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.jewel.sort.coloring.loop.match.paint.jigsaw\"]],[\"qgJ5GncIU0oTCLXM77LHkJcDFSS6rAIdLhkZOPoBDwoNCAASCQoFZW4tVVMQALoCSwo1Ci9jb20uamV3ZWwuc29ydC5jb2xvcmluZy5sb29wLm1hdGNoLnBhaW50LmppZ3NhdxABGAMSEgoECAEQAQoECAMQAQoECAQQAQ\\u003d\\u003d\"],[[[null,null,\"AJ2Qn9uJmuY\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:AJ2Qn9uJmuY?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:AJ2Qn9uJmuY\",null,null,null,null,\"AXH1ezkwLEOGxHDflpijDmqVL6w_f8gj9v8qUbox_LW1drjOOW5Gat2xtDuZOiudokvGd1a_QiLk_mQVYnTUQbUo7vuXz9xBS-i0HzWdhdkmOkWjAadid1Kg-95j60bo0cEbG4_iNt44i94x4L9RVh9GfSF5rNBstbphTF6npiHJ2IjnXcv668EI-N_zywYXoBIuASTH31jWo_YLnd8ixzUMUrhN7dvZ-kjNAWupifxqD7xby_hKbZ1pUZgUeeTWUI7Yi8864Dv_3yuCvJbAEPXlHcQOen8CRJ8xYkYmqejlvvKY6g\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/AJ2Qn9uJmuY/hqdefault.jpg\"]]]],[null,\"Jewel Loop - Coloring Sort blends jewel sorting with pixel art into a calming puzzle journey. Tap connected jewels of the same color and watch them glide onto a rotating loop, where they drift in circles before precisely filling the pixel canvas above. No countdowns, no rush—just a peaceful rhythm of planning and placement. As levels progress, patterns grow more intricate and colors multiply, offering an easy start with deeper layers of thoughtful strategy. The ASMR feedback of each jewel clicking into place hits right at the heart, turning every perfect match into a moment of quiet satisfaction.\\u003cbr\\u003eKey Features\\u003cbr\\u003e- Dual Healing: Jewel Sorting Meets Pixel Art: Every puzzle is also a creative process. From clean geometric patterns to richly detailed illustrations, each level holds a unique jewel artwork waiting to be completed.\\u003cbr\\u003e- Collection Album: Every finished pixel artwork is automatically saved to your personal gallery. Browse through your creations anytime and revisit each calming puzzle moment.\\u003cbr\\u003e- Daily Challenges: Fresh exclusive pattern levels arrive every day, unlocking new color palettes and jewel sets. The surprises never run out.\\u003cbr\\u003e- Immersive ASMR Experience: Every step—jewels gliding, colors filling, artwork completing—is paired with smooth animations and delicate sound effects, turning each successful match into a truly satisfying reward.\\u003cbr\\u003eWhy You\\u0026#39;ll Love It\\u003cbr\\u003e- Blends sorting strategy with pixel art creation—both thoughtful and creative.\\u003cbr\\u003e- No timers—play at your own pace, but keep an eye on loop capacity.\\u003cbr\\u003e- Every level is a complete pixel artwork you create.\\u003cbr\\u003e- Perfect for quick sessions or longer, immersive play—find your rhythm anytime.\\u003cbr\\u003eReady to Sort \\u0026amp; Color?\\u003cbr\\u003eDownload Jewel Loop - Coloring Sort. Send jewels onto the loop, fill the canvas, and complete your pixel art—one jewel at a time.\"],\"TaTa Game Technology Limited\",\"500,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/haPYltqmzacUbCLAiKgfuuStq2O3qwb1rhIyufsAyVtkBp0CC9TGNMmrfFHmDtTErUeRdjM-A33TyxKJWQUg8w\"],null,[32,124,243,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,[null,\"Content is generally suitable for all ages. May contain minimal cartoon, fantasy or mild violence and/or infrequent use of mild language.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[