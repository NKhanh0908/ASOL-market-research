0],[null,null,\"https://play-lh.googleusercontent.com/ovMVNtNVmHofD-jx9PHJpchsacH-N24WF0dRn5eTxEd9nsJStR71DBo-wzg-feJ5vBgp2Y-ASQiQeIKTN1delok\"]],[null,2,[1440,2560],[null,null,\"https://play-lh.googleusercontent.com/I1fa7CVuQxjhBlUbrFTgeWezYGubsgwX1BCSEv6Z_KkKPa14d9WxbB32p5CLUOUg1P-3QhKzAgE__pzvQpLi6Q\"]],[null,2,[1440,2560],[null,null,\"https://play-lh.googleusercontent.com/MEKb5bygu95UnUUspBLeOxNCSdEND4Sm0Qf-Gd7JeYkaqt4Tp1HBwYSJMGjAI-6Wh7U5E42qeGvRSMRRK7o\"]],[null,2,[1440,2560],[null,null,\"https://play-lh.googleusercontent.com/w0qky3mOgtx904yyb_vnKiVvNmoLbMxl_zyYF3SQeux8qnEkKORg1Gp5gZF1JAfqJpl3uzQ0Z2N_b03K9_WUyYc\"]],[null,2,[1440,2560],[null,null,\"https://play-lh.googleusercontent.com/D2a4dQylCNf1-u1USSLwWtiHKjIQ6evZ8iQQnwfgcLOe7GN9OsA_2JxiH2qupjawHNXHeZLxyjSPNpj1j4cJ\"]],[null,2,[1440,2560],[null,null,\"https://play-lh.googleusercontent.com/Hq4gg_lqgUO-NZLGHdis-olfGBeRWT0sMWit95bOGt3h44xUXDdiFDFyJHd0TfB_r1H0K3fXYAJYYmMKQuh5\"]]],\"Township\",[\"4.7\",4.688615],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.playrix.township\\u0026rdid\\u003dcom.playrix.township\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.playrix.township\"]],[\"qgJeGlwIAUoTCLXM77LHkJcDFSS6rAIdLhkZOPoBDwoNCAASCQoFZW4tVVMQALoCMAoaChRjb20ucGxheXJpeC50b3duc2hpcBABGAMSEgoECAEQAQoECAMQAQoECAQQAQ\\u003d\\u003d\"],[[[null,null,\"L46PkGz3SqI\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:L46PkGz3SqI?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:L46PkGz3SqI\",null,null,null,null,\"AXH1ezmZvF7A6ULsWYDMtGk4-J8GAX5ezgCx6CPDZ73qNrMWIDcrTTZki-E22YnGzarU4j_QbdOwOm-Xu1xHrE_E-NNAtzqm3B1iMnQcqBQP0-rnsN798h7CMb8UDnpLO2kRWhhmm8dqg7stGa9BzKdC4wQPUhQFwwhg1nLq34O-nUV2FXjkyuEfz59mKotbymKFBzkf1a4PAnAWCauvL52UUvKtPfX5ifutUndHDN6kUWDfMbWtCvETf3DrbunCyB8Qm8jqN9PCenTCPcgY4HFxEbSheXkOUx8kb-bceAQThCRYdQ\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/L46PkGz3SqI/hqdefault.jpg\"]]]],[null,\"BUILD YOUR DREAM TOWN!\\u003cbr\\u003e\\u003cbr\\u003eWelcome to Township, a thrilling city-building and farming game where you become the mayor of your own town!\\u003cbr\\u003eBuild houses, factories, and community buildings, grow crops on your farm, and decorate your town just the way you like. Take part in limited-time events, compete in exciting regattas, and earn exclusive prizes!\\u003cbr\\u003e\\u003cbr\\u003eNeed a break from city planning? Jump into relaxing match-3 puzzles to earn rewards, speed up your progress, and unlock even more fun — all available offline!\\u003cbr\\u003eTownship — the perfect blend of city-building, farming, and match-3 gameplay!\\u003cbr\\u003e\\u003cbr\\u003eGAME FEATURES:\\u003cbr\\u003e● Unlimited creativity: Design and build the metropolis of your dreams!\\u003cbr\\u003e● Engaging match-3 puzzles: Complete fun levels to earn rewards and boost your progress!\\u003cbr\\u003e● Exciting competitions: Test your skills against players from around the world in regular competitions — win prizes and make unforgettable memories!\\u003cbr\\u003e● Exclusive collections: Gather valuable artifacts, rare antiquities, and colorful profile pictures to showcase your achievements!\\u003cbr\\u003e● Offline play: Enjoy Township anytime, anywhere — even without an internet connection!\\u003cbr\\u003e● Vibrant community: Meet friendly characters with unique personalities!\\u003cbr\\u003e● Social connections: Play with your Facebook friends or make new friends in the Township community!\\u003cbr\\u003e\\u003cbr\\u003eWhy You\\u0026#39;ll Love Township:\\u003cbr\\u003e● A unique mix of city-building, farming, and match-3 gameplay!\\u003cbr\\u003e● Stunning graphics and charming animations\\u003cbr\\u003e● Regular updates with fresh content and special events\\u003cbr\\u003e● Personalize your town with a wide variety of decorations\\u003cbr\\u003e\\u003cbr\\u003eTownship is free to play, but some in-game elements (including randomized items) can be purchased for real money.\\u003cbr\\u003e\\u003cbr\\u003eA Wi-Fi or internet connection is not required to play.\\u003cbr\\u003e *An internet connection is required to access competitions and additional features.\\u003cbr\\u003e\\u003cbr\\u003eDo you like Township? Follow us!\\u003cbr\\u003eFacebook: facebook.com/TownshipMobile\\u003cbr\\u003eInstagram: instagram.com/township_mobile/\\u003cbr\\u003e\\u003cbr\\u003eNeed to report an issue or ask a question? Contact Player Support through the game by going to Settings \\u0026gt; Help and Support. If you can\\u0026#39;t access the game, use the web chat by clicking the chat icon in the lower right corner of our website: https://playrix.helpshift.com/hc/en/3-township/\\u003cbr\\u003e\\u003cbr\\u003ePrivacy Policy:\\u003cbr\\u003ehttps://playrix.com/privacy/index.html\\u003cbr\\u003eTerms of Use:\\u003cbr\\u003ehttps://playrix.com/terms/index.html\"],\"Playrix\",\"500,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/qhA5Hm8hYwTcQx0Rk6cmbpwUUsku51_tSzWfhCKIpUr-X2IXPSpIgrse-DfUaUgvbJB5i1Xz8TjnGxCT4NH8Sw\"],null,[224,246,168,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,[null,\"Users Interact, In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\