ITcQslG8vndYBSYYA2DChtwIwiWNHY6iPPXWm6cY6l0ZkKdCnwa84NBrT8sd-F21rR0k\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/-mb5IuGFGo_Gqq4C9d991HQZkYCasDVMNDLTRuADCl0X7pfgTeSGoVvqvSAicIuvCuHABo6utgaQV_po3VuVRw\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/wdjauiSQhPF3Cf_1xSlklZnUsypumbqemvpU_uvUGupSSY2nMoGWVWxILJRizWZvRp6fVvgVIc14m0pVboEPqg\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/Zl9SemIPC0S7J5POFQOoxhr-ksQeQLTE4NhCYwVf0HKelzTYkXD7daqE1UC-BLSFbNIAZpywK-SnHFFK7s66\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/UmCFi1yRjEtDVQbGx-pE5679wd_SksVQviVWnckyF04xd410as6KS_JBOSXVjGVGXcaW3T5hYP1WodYguKlG4Q\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/LvcDaNvHEBind3S4GqYBP18n_ENiungU4nAW5eDMOe5_amOiRW6tXUewpH4hTi9Qwu6Y3IMmN2crbGm9HUcu0A\"]]],\"Plants vs. Zombies™ 2\",[\"3.7\",3.7137797],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.ea.game.pvz2_na\\u0026rdid\\u003dcom.ea.game.pvz2_na\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.ea.game.pvz2_na\"]],[\"qgJdGlsITUoTCLXM77LHkJcDFSS6rAIdLhkZOPoBDwoNCAASCQoFZW4tVVMQALoCLwoZChNjb20uZWEuZ2FtZS5wdnoyX25hEAEYAxISCgQIARABCgQIAxABCgQIBBAB\"],[[[null,null,\"0c_iMGs3ehY\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:0c_iMGs3ehY?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:0c_iMGs3ehY\",null,null,null,null,\"AXH1ezm7jBK757zmydPiG8yCPfjIIdL9s1jRFnPVG-G51HgqPBgXyDSj12ubp_wio5v0qQlITHsH5q916HXSjpqzeThW-ibAU2gmQU0pdt9VVoRRoquQSuEr0RqZA6p2mVcZqq8IgmmmDIyzbsMRnlW9w9UtOZtLaNnyhBSKEjsZLbSXZU1ma-6o6SOmgZ6slhcB41XIq3OykJMYZ8n78BYpBrkcX4sUFri9hZYPw_ZkO-yWNza83D1Zrrh4XQVAmiTPxh1TQxjqXnS0EqpWTyhlJ1hhqpLuaRdF9xAeGHqLznhtjw\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/0c_iMGs3ehY/hqdefault.jpg\"]]]],[null,\"This game includes optional in-game purchases of virtual currency that can be used to acquire virtual in-game items, including a random selection of virtual in-game items.\\u003cbr\\u003e\\u003cbr\\u003ePlay the hit action-strategy adventure where you meet, greet, and defeat legions of hilarious zombies from the dawn of time, to the end of days. Amass an army of amazing plants, supercharge them with Plant Food, and devise the ultimate plan to protect your brain.\\u003cbr\\u003e\\u003cbr\\u003eDISCOVER HUNDREDS OF PLANTS AND ZOMBIES\\u003cbr\\u003eCollect your favorite lawn legends, like Sunflower and Peashooter, along with hundreds of other horticultural hotshots, including creative bloomers like Lava Guava and Laser Bean. Go toe-to-missing-toe with a massive array of zombies at every turn, like Jetpack Zombie and Mermaid Imp – you’ll even have to protect your brain from rampant Zombie Chickens!\\u003cbr\\u003e\\u003cbr\\u003eGROW POWERFUL PLANTS\\u003cbr\\u003eEarn Seed Packets as you play and use them to fuel your potent plants. Power up attacks, double-down defenses, speed up planting time, and even gain entirely new abilities. Boost your plants to ensure those zombies are lawn-gone!\\u003cbr\\u003e\\u003cbr\\u003eCOMPETE AGAINST OTHERS IN ARENA \\u003cbr\\u003eThink your zombie-bashing strategy is the best? Put your planting skills to the test when you face other players in Arena. Enter Arena and compete against other players to get the highest score on unique levels. Earn coins, piñatas, and more to top the leaderboards, level up through Leagues, and become the ultimate garden guardian.\\u003cbr\\u003e\\u003cbr\\u003eJOURNEY THROUGH SPACE AND TIME\\u003cbr\\u003eBattle across 11 crazy worlds, from Ancient Egypt to the Far Future, and beyond. With more than 300 levels, ultra-challenging endless zones, fun mini-games, and daily Piñata Party events, there’s always a new challenge to complete. Plus, ready your best defenses – Dr. Zomboss is waiting to take you on at the end of every world!\\u003cbr\\u003e\\u003cbr\\u003eRequires acceptance of EA’s Privacy \\u0026amp; Cookie Policy and User Agreement.\\u003cbr\\u003eUser Agreement: https://tos.ea.com/legalapp/WEBTERMS/US/en/PC/\\u003cbr\\u003ePrivacy and Cookie Policy: https://tos.ea.com/legalapp/WEBPRIVACY/US/en/PC/\\u003cbr\\u003eVisit https://help.ea.com/en/ for assistance or inquiries.\"],\"ELECTRONIC ARTS\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/h8NrASM1x9bfxsCAg0gxg-XasvOR5kbjc2WkrWA7cEfVYHz-dvietszAFNtLGeNHPiSU7aJRK5YfsXz4RZs_RA\"],null,[243,241,241,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],[null,\"Mild Fantasy Violence, Crude Humor\"],[null,\"In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.ea.game.pvz2_na\\u0026rdid\\u003dcom.ea.game.pvz2_na\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $99.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,