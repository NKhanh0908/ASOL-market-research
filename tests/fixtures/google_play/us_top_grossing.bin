null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.dcjnmed.jifqq\\u0026rdid\\u003dcom.dcjnmed.jifqq\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.dcjnmed.jifqq\"]],[\"qgJbGlkIUkoTCLXM77LHkJcDFSS6rAIdLhkZOPoBDwoNCAASCQoFZW4tVVMQALoCLQoXChFjb20uZGNqbm1lZC5qaWZxcRABGAMSEgoECAEQAQoECAMQAQoECAQQAQ\\u003d\\u003d\"],[[[null,null,\"3A0JyzyxW-0\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:3A0JyzyxW-0?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:3A0JyzyxW-0\",null,null,null,null,\"AXH1ezlyRmtsdFyfX3CyxH79X96WFP3lnC8WTe472Z4c-W_vJtZp8OAP-ofZ33tYHzjmI9WG09lkx5QBsqCSArexQCdw1QekjTkJOg7bmbMOOF2WC3RMeN3lbxvxIlwMpDuPO0hjRmnQ17EpbxZNOhA_1GfIR-EV0cl3kZXUs5LYp8xD15I_JUjY4Tky_AQVYeJ8s_zLQ0Z5YNJImutqOgd56aaBKwf22Y4Bsw2dVOSkvbIaJCrEFzwliMA4KzE5JDWe0_45-vvvCD_uZDoJW8L9B03oRADw4Czi9pdNoCtlxp6Jaw\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/3A0JyzyxW-0/hqdefault.jpg\"]]]],[null,\"🔧 Unleash Your Inner Engineer with Screw Guru: Pin Puzzle! 🧠\\u003cbr\\u003e\\u003cbr\\u003eReady to twist your mind and test your spatial skills? Dive into the captivating world of Screw Guru, where physics-based puzzles meet addictive gameplay! 🌟\\u003cbr\\u003e\\u003cbr\\u003e🔩 Why You\\u0026#39;ll Love Screw Guru:\\u003cbr\\u003e• Intuitive Controls: Simply drag and rotate to solve puzzles\\u003cbr\\u003e• Brain-Teasing Challenges: Over 1000 levels to keep you engaged\\u003cbr\\u003e• Stunning 3D Graphics: Immerse yourself in a visually appealing world\\u003cbr\\u003e• Relaxing Soundtrack: Unwind as you play with soothing background music\\u003cbr\\u003e• Regular Updates: New levels and features added frequently\\u003cbr\\u003e\\u003cbr\\u003e🏆 Featured as \\u0026quot;Game of the Day\\u0026quot; in 150+ countries!\\u003cbr\\u003e\\u003cbr\\u003eScrew Guru isn\\u0026#39;t just a game; it\\u0026#39;s a journey of discovery and problem-solving. Each level presents a unique challenge, requiring you to think creatively and use your spatial reasoning skills to succeed. As you progress, you\\u0026#39;ll unlock new tools and face increasingly complex puzzles that will put your engineering prowess to the test.\\u003cbr\\u003e\\u003cbr\\u003ePerfect for players of all ages, Screw Guru offers:\\u003cbr\\u003e• A stress-free gaming experience with no time limits\\u003cbr\\u003e• Gradual difficulty progression to keep you challenged\\u003cbr\\u003e• Achievements to unlock and leaderboards to climb\\u003cbr\\u003e• Offline play for entertainment anytime, anywhere\\u003cbr\\u003e\\u003cbr\\u003e🌈 Colorful Customization: Express your style by unlocking a variety of vibrant skins for your tools and puzzle pieces. Make the game truly yours!\\u003cbr\\u003e\\u003cbr\\u003e👨\\u200d👩\\u200d👧\\u200d👦 Family-Friendly Fun: Screw Guru is the perfect game for family game nights or to keep kids entertained while exercising their minds.\\u003cbr\\u003e\\u003cbr\\u003e🚀 Constant Innovation: Our dedicated team of developers is always working on new levels, features, and improvements. Your feedback shapes the future of Screw Guru!\\u003cbr\\u003e\\u003cbr\\u003e\\u0026quot;Screw Guru is the perfect blend of challenge and relaxation. It\\u0026#39;s my go-to game for unwinding after a long day!\\u0026quot; - Happy Player\\u003cbr\\u003e\\u003cbr\\u003eDon\\u0026#39;t let this opportunity slip through your fingers! Download Screw Guru: Pin Puzzle now and start your puzzling adventure. Can you become the ultimate Screw Guru? There\\u0026#39;s only one way to find out! 🔧🧩\"],\"Supersonic Studios LTD\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/aR6Hv8a3LcjWOyILpoAQmzyP9xakQ1S5bPtBs8LcNHby49UldkYQe3CvjQTXX8ePGGQk5iqfCHgBz0C8TQux4_o\"],null,[46,21