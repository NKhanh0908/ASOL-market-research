,null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.arkgame.ft\\u0026rdid\\u003dcom.arkgame.ft\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.arkgame.ft\"]],[\"qgJYGlYINEoTCLXM77LHkJcDFSS6rAIdLhkZOPoBDwoNCAASCQoFZW4tVVMQALoCKgoUCg5jb20uYXJrZ2FtZS5mdBABGAMSEgoECAEQAQoECAMQAQoECAQQAQ\\u003d\\u003d\"],[[[null,null,\"Q2tI-wc_BbU\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:Q2tI-wc_BbU?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:Q2tI-wc_BbU\",null,null,null,null,\"AXH1ezn2Ablas8KIVamRopshwvFybnuiZWdgnEjwFzGDPmk1aE9rAD0hCD8HVEd37RYRcRZZMYNnAFUb9j-TRdY2VOBdtKh9ssHehT1-gtLLCCVkGcfBaWF61p5lGdda32KgNhvOt-wny5P4UdjpBelsT13nNqyI5aEOVZl8JcZJpV0UdvGITQ0TzE9iVL7_ccFBQ8GQ47m7N--8Bf7IXLvo12UTDuGYSx0PfxeQcS5hgQvSDa7Q2_KHj-aB_FD3ADHOD0a-96Fz0iRGEmZco_ORwrufsejPf7BVEIIa1S4u408nEQ\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/Q2tI-wc_BbU/hqdefault.jpg\"]]]],[null,\"Fishing Travel is a relaxing and exploratory fishing game where you can freely choose from a wide variety of settings—lakes, rivers, and even the vast open ocean. Each location hosts its own unique species, demanding both skill and knowledge to land your catch.\\u003cbr\\u003e\\u003cbr\\u003eCast your line and set sail for an unforgettable angling adventure!\\u003cbr\\u003e\\u003cbr\\u003e***Explore \\u0026amp; Enjoy***\\u003cbr\\u003eFishing Travel offers a rich selection of scenic spots to discover. From tranquil lakes to bustling cities, every player can soak in breathtaking views while pursuing fish found nowhere else in the world.\\u003cbr\\u003e\\u003cbr\\u003e***Strategic Fishing Plan***\\u003cbr\\u003eThe greater the challenge, the bigger the reward—but landing those trophies becomes tougher too! Learn to combine and upgrade your own rods and tackle so your gear perfectly matches each fishing spot, then compete with anglers from around the globe to claim amazing prizes.\\u003cbr\\u003e\\u003cbr\\u003e***Building \\u0026amp; Fun***\\u003cbr\\u003eAs you progress, spend the prizes and bonuses you earn to create a personal haven of your own—starting with small decorations and expanding all the way to grand mansions. Step by step, savor the serenity and escape the daily grind. On top of that, a host of exciting events awaits you, delivering a fresh take on fishing-game fun.\\u003cbr\\u003e\\u003cbr\\u003eWhat are you waiting for? Cast your line and start your fishing adventure today!\"],\"ARK GAME LIMITED\",\"5,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/pcI0s2KXK2lYngHYwVSTSnGoe3ZD9nZPgYq-q040wlbFcMCpRkTOAzqu8JP90J7JxNjvkPSFK-OlvWjK2s6d4VE\"],null,[33,90,106,255]],null,[\"Teen\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/mw_NfsvKM8m6RPv8Fz2GQawCOsqWv010saMnc7zbWalMxuaA9IY8h7E0VMieLxSxAFB98NFeYqbFrXXq\"]],[null,\"Mild Violence\"],[null,\"Users Interact\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/xl04GurQer374yogi24hRkvUcXtMStMOcOo86Sprmrid9j6wQHF0d9xMh73CwUEg57lbsGIwpOXgrJ927Q\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.arkgame.ft\\u0026rdid\\u003dcom.arkgame.ft\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $99.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]