uPliRA9Lw46fO3NtgYPogFvN0UlpMjzXQX5sCGY-Kg3PYZiuQgDtA\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/C9m455PxqSkwjJTYCsUe9tlKCPosjjCltryg8Wy5gsuCF4NEsOKJr1daFYs94WiFMo5xEeJDOfHeWvi9oVuzOQ\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/DRThgThIKtX0zhZ54VI7Y2FAuJSzTDIzBOSmNOM99zVPjZdEpYSg-BfSIwj_AtskfikleIAwHu4ad2BQR54Nbw\"]]],\"Covet Fashion: Dress Up Game\",[\"3.8\",3.8049273],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.crowdstar.covetfashion\\u0026rdid\\u003dcom.crowdstar.covetfashion\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.crowdstar.covetfashion\"]],[\"qgJkGmIIMEoTCLXM77LHkJcDFSS6rAIdLhkZOPoBDwoNCAASCQoFZW4tVVMQALoCNgogChpjb20uY3Jvd2RzdGFyLmNvdmV0ZmFzaGlvbhABGAMSEgoECAEQAQoECAMQAQoECAQQAQ\\u003d\\u003d\"],[[[null,null,\"YuuDZcaqz98\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:YuuDZcaqz98?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:YuuDZcaqz98\",null,null,null,null,\"AXH1ezmyUCRlhxmDeJqbvmlXl0Ly8K3HyS1HAasvCpmnalytSYHhj5EP0Qya5ITzIpdZYVhjPsab2mp4GEI07niL7ZoroRTGevpJpE5z85FmFOgq08dxVsk0pDLqz-csOsOfaWvcOO4anUYKgGj0t3-BXH9c5SqHt4zLrwuj_priUxZu38B4cSo_vXsY5tTC-50Csy0M0DYTnSi_pbaNSvTKRDMDFxpYjP1DDnT-TcL1T1JDtow3MTujksjKt8vl2Hxkxvnd8UmvCzCL-ZSSdbuBoLhKteRLKPG0ruSBZ8JSNRICiQ\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/YuuDZcaqz98/hqdefault.jpg\"]]]],[null,\"This game includes optional in-game purchases of virtual currency that can be used to acquire virtual in-game items, including a random selection of virtual in-game items.\\u003cbr\\u003e\\u003cbr\\u003eMakeover your virtual life in Covet Fashion, the ultimate fashion design game! Dress up your model, build your digital dream closet, and explore all the hottest styles in the fashion world right from your phone! Discover designer clothing and brands you love, plus get recognized for your style with fashion face-offs for in-game rewards! Fashion design games come to life like never before on Covet Fashion.\\u003cbr\\u003e\\u003cbr\\u003eDress up and makeover your virtual model with fabulous items from real-world fashion brands and hundreds of unique hair and makeup styles. Style and design clothes to earn amazing in-game rewards in Style Challenges and become the #1 designer. Vote on looks from millions of other fashion lovers!\\u003cbr\\u003e\\u003cbr\\u003eFashion week or everyday style - become the top fashionista in Covet Fashion. Create your own fashion story today!\\u003cbr\\u003e\\u003cbr\\u003eCOVET FASHION FEATURES\\u003cbr\\u003e\\u003cbr\\u003eSHOP THE BEST STYLES\\u003cbr\\u003e- Designer clothing from over 150 brands - you’re sure to discover styles you love.\\u003cbr\\u003e- Fashion shopping meets the real world - explore collections from our coveted partners including Ashley Lauren, Badgley Mishka, and Camilla.\\u003cbr\\u003e- Discover your next favorite fashion designer right on Covet Fashion!\\u003cbr\\u003e\\u003cbr\\u003eFASHION DESIGN – STYLE THE PERFECT OUTFIT\\u003cbr\\u003e- Dress up your model with thousands of glamorous clothing and accessory items to choose from!\\u003cbr\\u003e- Hair and makeup styles complete the look - choose from chic hairstyles and makeup looks on our new diverse array of models.\\u003cbr\\u003e- Become the top stylist! Makeover your virtual model for various styling challenges such as photo shoots, cocktails and red carpet fittings.\\u003cbr\\u003e\\u003cbr\\u003eVOTE ON WHO WORE IT BEST\\u003cbr\\u003e- Submit your designs and become the top ranking fashionista in Style Challenges!\\u003cbr\\u003e- Fashion week is every week on Covet Fashion - Cast your vote and decide what’s hot!\\u003cbr\\u003e- Over hundreds of thousands of entries per styling challenge!\\u003cbr\\u003e- Outfit designer or judge – Join the competition and decide who looks 5-star worthy and who missed the mark.\\u003cbr\\u003e\\u003cbr\\u003ePLAY WITH FRIENDS\\u003cbr\\u003e- Want to get advice on your outfits or celebrate your wins? Connect with other fashion lovers!\\u003cbr\\u003e- Join a Fashion House to make friends or connect to Facebook and chat about any and all things Covet Fashion.\\u003cbr\\u003e\\u003cbr\\u003eSHOP COVET FASHION ITEMS\\u003cbr\\u003e- Clothing games go beyond the screen with real world shopping! Shop your favorite Covet Fashion items in real life.\\u003cbr\\u003e- All of the clothing and accessory items featured in the game link to places where you can buy them for your real-life closet.\\u003cbr\\u003e- Makeover both your virtual model and real world self with Covet Fashion. Discover new brands and trends and own them, too!\\u003cbr\\u003e\\u003cbr\\u003eClothing design games, reimagined for true fashion lovers! Download Covet Fashion today!\\u003cbr\\u003e\\u003cbr\\u003eFOLLOW US\\u003cbr\\u003eInstagram: instagram.com/covetfashion\\u003cbr\\u003eFacebook: https://m.facebook.com/covetfashion\\u003cbr\\u003e\\u003cbr\\u003eContact Support:\\u003cbr\\u003esupport@glu.com\\u003cbr\\u003e\\u003cbr\\u003eThis game includes optional in-game subscriptions. Subscriptions will automatically renew unless cancelled at least 24 hours before the end of the current period. You can manage and cancel subscriptions anytime in the Google Play Subscription Center.\\u003cbr\\u003e\\u003cbr\\u003eThis app: Requires acceptance of EA’s Privacy \\u0026amp; Cookie Policy and User Agreement. Requires an Internet connection (network fees may apply). Includes in-game advertising. Collects data through third-party ad-serving and analytics technology (See Privacy \\u0026amp; Cookie Policy for details). Allows players to communicate. Contains direct links to the Internet and social networking sites intended for an audience over 13.\\u003cbr\\u003e\\u0