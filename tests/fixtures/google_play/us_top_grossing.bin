Xpj4-E4ISoEzPBEjZPUrPJEnPEfjE-45yzj65FGt6eOHzoXQ8\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/XivQZriEJ-ubfevOuddTaLQZ-CFCMtkLKODgLm1BROX59EF_ZVonZC_uXqFRYBl2XZ6F6qWyJDu1pzi9MjOn\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/O_UTbYtqb0GQabWRzX5-rBWIauz86kuPWpzgh2ALm8aqhvgD93Ak_R1PPj5Z_FVFlci2ZCRS7beNxSPbvYWGcg\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/B7neKbP3xH_0aNaW0KrYTRHj9X02iZMEI_vrhD1RE-fVEJblB7lQ9xjbBdVYQenVSyXnxjv6jUXSaXEzU1H4kw\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/Pj8kDa_h-L4PCu_mX5WhLeDF5DIYzYEBYMfb55huVDIbdbLcCUHOkWBB5IUA5yTbBelva5N5CVhUCo3PVlRT\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/wpftBcV1VRfGFZYzoexVPkZbcnDRpzbINk4nXvGJ-ZFXYoC2TfgDbJTF58Pbe9A1aTWevVu2gYgiUtWLbz26Fg\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/bQIoHw10JOqxq8nYl2GUvahZm4o9Qe_O2DHXpj4-E4ISoEzPBEjZPUrPJEnPEfjE-45yzj65FGt6eOHzoXQ8\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/XivQZriEJ-ubfevOuddTaLQZ-CFCMtkLKODgLm1BROX59EF_ZVonZC_uXqFRYBl2XZ6F6qWyJDu1pzi9MjOn\"]]],\"Pocket Styler: Dress Up Game\",[\"3.8\",3.7924929],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.nordcurrent.fashion\\u0026rdid\\u003dcom.nordcurrent.fashion\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.nordcurrent.fashion\"]],[\"qgJpGmcIS0oTCLXM77LHkJcDFSS6rAIdLhkZOPoBFwoVCIP77urOl/eOQxIJCgVlbi1VUxAAugIzCh0KF2NvbS5ub3JkY3VycmVudC5mYXNoaW9uEAEYAxISCgQIARABCgQIAxABCgQIBBAB\"],null,[null,\"Hey fashionista! Ready to become a fashion stylist \\u0026amp; trendsetter in the modern world of fabulous influencers and fashion glow? 👑 Dress to impress other players across the globe and show them your taste in this glamorous dress up game! 👗\\u003cbr\\u003e \\u003cbr\\u003e✨ Do you like stylish clothing and dream of being the ultimate fashion stylist? 👠\\u003cbr\\u003e✨ Do you get excited about extravagant fashion accessories or stunningly beautiful makeup and hair combinations? 💄\\u003cbr\\u003e \\u003cbr\\u003eThen you\\u0026#39;re in for a fashionable treat! Go on a shopping spree, and renew your outfit with exquisite clothing and luxurious bags, hats, shoes, and jewelry. Get that fashion glow in a few minutes after your fashion makeover! 🛍️ Choose the hairstyle and makeup, mix and match from millions of different clothing combinations, dress to impress the fashion world with your unique fashion idol style! 💃\\u003cbr\\u003e \\u003cbr\\u003eDress up to style a unique look for glam events and fashion battle against other fashionistas in thrilling competitions. ⭐ Vote for their looks, climb the leaderboard and your socialite ladder, and become a trendsetting glow fashion idol It\\u0026#39;s time to take the fashion games world by storm and join the fashion nation of style enthusiasts in these fun games for girls! 😎\\u003cbr\\u003e \\u003cbr\\u003eThis dress up game \\u0026amp; fashion stylist game features:\\u003cbr\\u003e \\u003cbr\\u003e👗 An ever-expanding collection of beautiful outfits and stylish accessories\\u003cbr\\u003e💄 A vast selection of makeup and hairstyles\\u003cbr\\u003e⭐ Numerous fashion events to participate in, where You can win exclusive rewards\\u003cbr\\u003e😍 Roasting or praising other players\\u0026#39; looks and engaging in fashion battles to prove your style supremacy\\u003cbr\\u003e👑 The chance to dress to impress others and set the new rules of the fashion game\\u003cbr\\u003e🎨 A unique opportunity to explore your creativity and design outfits that will leave everyone in awe\\u003cbr\\u003e👠 Participate in the fashion show and showcase your talents as a glow fashion model and stylist\\u003cbr\\u003e \\u003cbr\\u003eStart your exciting dress up game adventure and join the glamorous world of fashion! Compete in voting rounds where your looks can win you fames and admiration. Prove your worth in the fashion battles and climb your way to the top as a modeling super stylist! Show other models that you can glow. Fashion games were waiting with ages for a fashionable diva like you!\\u003cbr\\u003e \\u003cbr\\u003eIn this fashion nation, your design skills will be put to the test as you create stunning outfits that will impress the toughest critics. Showcase your super stylist and modeling skills in various events, and make sure to participate in voting sessions to help decide the next big fashion trend in the dress up \\u0026amp; fashion games!\\u003cbr\\u003e \\u003cbr\\u003eWhether you love to dress up or experiment with makeup, this is the perfect game for any aspiring fashion idol stylist. The fashion world is waiting for your creativity—dress up your avatar, apply the perfect makeup, and let your inner super stylist shine \\u0026amp; glow!\\u003cbr\\u003e \\u003cbr\\u003eFollow us for new updates, contests, and more!\\u003cbr\\u003e👍 On Facebook\\u003cbr\\u003ehttps://www.facebook.com/PocketStylerGame\\u003cbr\\u003e📸 On Instagram\\u003cbr\\u003ehttps://www.instagram.com/pocketstylergame/\\u003cbr\\u003e \\u003cbr\\u003eGot some trouble with the game, questions or ideas? 🤔\\u003cbr\\u003e💌 Contact us here!\\u003cbr\\u003ehttps://www.nordcurrent.com/support/?gameid\\u003d17\\u003cbr\\u003e📒 Privacy / Terms \\u0026amp; Conditions\\u003cbr\\u003ehttps://www.nordcurrent.com/privacy/\"],\"Nordcurrent Games\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/pFhcIMLNekNsRzSggj6I7N4ZKKLnq28IHhV66hMAmm4mDnnteBx_wvNo3tig1YgKm2iVx5neT8epXEit92mVBA\"],null,[120,155,253,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4