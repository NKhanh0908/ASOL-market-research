ndiqYrcXqV3_1GVLYeO7U9RTn-jX_7015AWGqQw\"]],[null,2,[1536,2048],[null,null,\"https://play-lh.googleusercontent.com/aatLRlRiL6ZcCkcrS5ylgFyDPAfu401YjRgzSgPAoyeTShat1DVu3PKbu-9RVLeU2iOCBqHtYHDc6qIaeXOXHgw\"]],[null,2,[1536,2048],[null,null,\"https://play-lh.googleusercontent.com/CU7s9dl7kIT7bkxk_w6ugyrK6injSE9_tUC5wg5NsIoD_kibIRR_sSRKHKQ4J2k59RvmQfJtEyTYtPGaljog\"]],[null,2,[1536,2048],[null,null,\"https://play-lh.googleusercontent.com/WcCCR16PFKHYn8oY5IVcC7nds4p86Q0ITqGi2VSQuYImvAS0VXoBCdtIhNwr4p2lOQwx-roZTsWbWmfaZwyLxg\"]]],\"My Little Pony: Magic Princess\",[\"3.8\",3.822442],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.gameloft.android.ANMP.GloftPOHM\\u0026rdid\\u003dcom.gameloft.android.ANMP.GloftPOHM\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.gameloft.android.ANMP.GloftPOHM\"]],[\"qgJ/Gn0IVUoTCLXM77LHkJcDFSS6rAIdLhkZOPoBFwoVCNLD14SX8ceKQxIJCgVlbi1VUxAAiAIDugI/CikKI2NvbS5nYW1lbG9mdC5hbmRyb2lkLkFOTVAuR2xvZnRQT0hNEAEYAxISCgQIARABCgQIAxABCgQIBBABygIECAMQAQ\\u003d\\u003d\"],[[[null,null,\"p8MnZUQ5zXE\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:p8MnZUQ5zXE?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:p8MnZUQ5zXE\",null,null,null,null,\"AXH1ezlM4WQZHvE5uCCt07MjlvkXRi1JxVnMnSu3RMexsQd2YO9rTmf_LqqBnJ84EcZU8rg0PMri5umlvHY6dJ9uY9sI25BodAIK0HEiVpxXdbHbqOA59f_AWurgDH2cq3X_RIlvsuXMbcz_uZTQe--VUpkDBGmwxNGzY7346RjaD_NoXxgTtP3ckjorE7zr0nhW_z1zwTeELeMs0O0Qd967lQFTIju1P1pR8BFqQoaolOsV2IOVri_1NIHqCuTfC4BWKHxmOppYnOO7MbdAdlc5rpwgTvwCCOG-AcOaXJ9EODCLZQ\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/p8MnZUQ5zXE/hqdefault.jpg\"]]]],[null,\"Saddle up for fun, friendship and adventure with all of the most popular ponies in Equestria in the free official game based on the phenomenal MLP TV show.\\u003cbr\\u003e\\u003cbr\\u003eOnly Twilight Sparkle -- the student of Princess Celestia -- and her friends Rainbow Dash, Fluttershy and the rest can save the day for every horse in the city as they farm resources, meet cute friends and reach for their dreams.\\u003cbr\\u003e\\u003cbr\\u003e· Over 300 characters: Meet a royal prince or princess one day, a cute adventure-seeking horse the next day and who knows what the next. Give them places to stay, nibble on hay and hear what they have to say.\\u003cbr\\u003eExplore the Crystal Empire, Canterlot, Sweet Apple Acres farm and more.\\u003cbr\\u003e\\u003cbr\\u003e· Make a pretty pony home: Beautify your MLP town and make it better than in any other city builders out there with cute houses, adorable decorations and enough magic for everypony that gallops by.\\u003cbr\\u003e\\u003cbr\\u003e· Fantastic quests: Go on adventures based on your favorite stories from the TV show, and confront villains such as Tirek, King Sombra, Nightmare Moon, the Changelings and more.\\u003cbr\\u003e\\u003cbr\\u003e· Mini-games: Play Ball Bounce with Twilight Sparkle, Magic Wings with Rainbow Dash, and get down with every horse in town in the Equestria Girls Dance games.\\u003cbr\\u003e\\u003cbr\\u003e· Custom fashion: Give cute makeovers to turn any pony into a prince or princess pony with royal dresses and beautiful hairstyles featuring a rainbow of colors.\\u003cbr\\u003e\\u003cbr\\u003e· Friendship is magic: Interact with friends and compete in hoof-pounding events.\\u003cbr\\u003e\\u003cbr\\u003e· Real pony voices: Enjoy the official voice talent from the show.\\u003cbr\\u003ePerfect for fans of city builders, free games or anyone who dreams of lounging on a pile of hay on the farm, surrounded by cute MLP horse friends such as Twilight Sparkle and Rainbow Dash, and becoming a royal prince or princess.\\u003cbr\\u003e_____\\u003cbr\\u003eYou can download and play this game for free. Please be informed that it also allows you to play using virtual currency, which can be acquired as you progress through the game, or by deciding to watch certain advertisements, or by paying with real money. Purchases of virtual currency using real money are performed using a credit card, or other form of payment associated with your account, and are activated when you input your Google Play account password, without the need to re-enter your credit card number or PIN.\\u003cbr\\u003eIn-app purchases can be restricted by adjusting the authentication settings within your Play Store settings (Google Play Store Home \\u0026gt; Settings \\u0026gt; Require authentication for purchases) and setting up a password for each purchase / Every 30 minutes or Never.\\u003cbr\\u003eDisabling password protection may result in unauthorized purchases. We strongly encourage you to keep password protection turned on if you have children or if others could have access to your device.\\u003cbr\\u003eThis game contains advertising for Gameloft’s products or some third parties which will redirect you to a third-party site. You can disable your device’s ad identifier being used for interest-based advertising in the settings menu of your device. This option can be found in the Settings app \\u0026gt; Accounts (Personal) \\u0026gt; Google \\u0026gt; Ads (Settings and Privacy) \\u0026gt; Opt out of interest-based ads.\\u003cbr\\u003eCertain aspects of this game will require the player to connect to the Internet.\\u003cbr\\u003e_____\\u003cbr\\u003e\\u003cbr\\u003ePlease note that this game contains in-app purchases, including paid random items.\\u003cbr\\u003e\\u003cbr\\u003eTerms of Use: http://www.gameloft.com/en/conditions-of-use\\u003cbr\\u003ePrivacy Policy: http://www.gameloft.com/en/privacy-notice\\u003cbr\\u003eEnd-User License Agreement: http://www.gameloft.com/en/eula\"],\"Gameloft SE\",\"100,000,000+\",null,\"All ages\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/2q4N6QUvto4uF4PNUYcG5Aps-pkpd9ciInM19zhZIXzZV6hs2TuWPYU7r0dSU30cbVr-_Xk806xzA_qDRQKp\"],null,[213,196,133,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,[null,\"In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.gameloft.android.ANMP.GloftPOHM\\u0026rdid\\u003dcom.gameloft.android.ANMP.GloftPOHM\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.49 - $119.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.drg.woolpuzzle3d\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/RAfleP77cpj0P86YHiV_9yqeezwnl1yOlL2NefSbFz1W3wIn7__F9jGqeVmI6bOFQMfMPwnvtMY-pKVdoN9L1zg\"],null,[135,254,135,255],null,null,null,2],[[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/L-VBj76JG6BzIjg_ZxJXssM6gbkE0y3JYVkPAlhAf41RhoeTs1cjDZkZk5QFff1zKe_C2Cf9hCTYlBMy6gWALw\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/vWryjtI6V8CmpA1Jk_v7aRRTmbAEg8_IFi54rsK1tgSlNItwXaMGmlaGvIaiUT0hRdJr8cpMbM-sEJx295ly\"]],[null,2,[1920,1080],[null,null,\"https: