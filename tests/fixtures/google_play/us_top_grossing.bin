leusercontent.com/a2eW6cXLPixihNvFr7HmmksKwmhNPwa7hugRJ4PkgTQny7iTMPW0DvzpO61Tpmtp_IIjg0ZdzmcQ_1cRE4cv\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/82sbN4As4aPBceMxKHv3QVS5L80EedOgC39mHkEx4c4heDasZSqntxab8-1gvFgXgGWI4dI5jASBMD0Z5GyhteA\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/ues7p4VG3IzRbxru7JQ22bVUq1aJgrwInx_fql9_Zdu4TyvLdT3pEHjHVfG0OdY7DnBQZp76e-NFuQ3J1ewP\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/-HnBl3Y0sli7bEt_N2QiQEe6Dslr3qS7u1PImTHbdRciD81y1K_qa-LA_Mn09dmiatfBXECygFQQVZPAJMo_LQ\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/KELK19WnJL_z8KtScl6hW_lXaXtHJuYFbL9QQLh5PM4DfJ974CuYLjvOSxs5BEExdt03_i7HdGXeC9HWloY1vrg\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/7yRhUiwO0a_n_N0QnFvLSIFg5B0B-VX7nLjHM9AYx9J2B_0XLchJ7eEM9XJJVDtJSiu06fVa4TNrCuhxIa3YJw\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/aXwHUFuWKBdvkTQjRaaHoZwxKrShzDV-t5kppWClrITzK4RhmqlOMyqK6Nta9uj7rj9gzqhIGEb-OHgKZowqeQ\"]]],\"Suck it Up ™ - Hole Them All\",[\"4.3\",4.3353295],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003ddk.tactile.holegame\\u0026rdid\\u003ddk.tactile.holegame\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003ddk.tactile.holegame\"]],[\"qgJdGlsIHEoTCLXM77LHkJcDFSS6rAIdLhkZOPoBDwoNCAASCQoFZW4tVVMQALoCLwoZChNkay50YWN0aWxlLmhvbGVnYW1lEAEYAxISCgQIARABCgQIAxABCgQIBBAB\"],null,[null,\"Suck It Up is the oddly satisfying black hole puzzle where you guide your hungry hole to swallow everything in sight! Explore levels across grass, ice, sand, and water as cute animals scatter around your ever-growing hole. Relax, solve clever puzzles, have holesome fun, and become a master of the hole!\\u003cbr\\u003e\\u003cbr\\u003eWhy you’ll love it: \\u003cbr\\u003e-Satisfying gameplay — drag, slide, and suck it up as your hole grows with every swallow.\\u003cbr\\u003e-Variety of locations — swallow your way across the world! Parks, sandy beaches, lakes — there’s no place that the hole wouldn’t reach!\\u003cbr\\u003e-Solve puzzles — sort and swallow only what’s required, and find ways to collect the biggest objects.\\u003cbr\\u003e-Animal antics — cute pets react as your black hole swallows them.\\u003cbr\\u003e-Relax or compete — zen out at your own pace or speed through for a perfect score.\\u003cbr\\u003e-Boost your hole — use handy boosters to slow down time or suck things up faster.\\u003cbr\\u003e\\u003cbr\\u003ePro tips to play:\\u003cbr\\u003e-Drag to move your black hole across the board.\\u003cbr\\u003e-Don’t bite off more than your hole can chew! Start with small items to grow larger.\\u003cbr\\u003e-Devour everything to finish the level.\\u003cbr\\u003e\\u003cbr\\u003eCan you master every level and become the ultimate hole hero?\"],\"Tactile Games\",\"500,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/nr0Ll5HGZFSUNJwPatMpsPmb9EmjEKZxA_lQ5Epj0eq_jizlvzjPDT4rqZI2zttLlZPyib6jeVkbIn2EqLKHIm0\"],null,[40,181,229,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,n