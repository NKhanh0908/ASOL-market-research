null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.supercell.hayday\\u0026rdid\\u003dcom.supercell.hayday\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.supercell.hayday\"]],[\"qgJmGmQICkoTCLXM77LHkJcDFSS6rAIdLhkZOPoBFwoVCJjCtOOU7fWNQxIJCgVlbi1VUxAAugIwChoKFGNvbS5zdXBlcmNlbGwuaGF5ZGF5EAEYAxISCgQIARABCgQIAxABCgQIBBAB\"],[[[null,null,\"ieGBgaDAbYM\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:ieGBgaDAbYM?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:ieGBgaDAbYM\",null,null,null,null,\"AXH1ezl2bD39EowwJCUtzjyAbvZhOkEFVtAKR7e-ZKfmed2oBfxkb-S0UmKU-e08Az9GZhHDqoVjGGIkqYMfEegU4COg1pgt398DLZtEVqBhXmfdbrkqEj3z9k53RSWkeNLbN65WFAW3pQYJUHm6ovwrXfaBw2XeKh9Obh8W9NPTsCkgbfkfDqKE8YLDGhgdU88SkXmP4zRH4mxOO4t98dhCY75gukAOCrA3NK4sPfzMkGFR_oF58g3HvEvXUhmjMO8CCIW6Uqnbp7BHoC58NAyAi3GUtLdZ9wZTYKEHmaCWRT63rA\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/ieGBgaDAbYM/hqdefault.jpg\"]]]],[null,\"Welcome to Hay Day, the fun farm simulator game! Build a farm, go fishing, raise animals, and explore the Valley. Farm with friends and decorate your own slice of country paradise.\\u003cbr\\u003e\\u003cbr\\u003eFarming has never been easier! Grow crops like wheat and corn in this farm simulator, and even though it never rains, they never die. Harvest and replant seeds to multiply crops, then make goods to sell. Feed your animals to produce eggs, bacon, dairy, and more to trade with neighbors or fill truck orders for coins. This farming simulator is perfect for players who love animals, farming, and trade!\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003eGrow your farm simulator empire like a true tycoon. Expand with a Bakery, BBQ Grill or Sugar Mill to sell more goods. Build a Sewing Machine and Loom to create cute outfits or a Cake Oven to bake delicious cakes. \\u003cbr\\u003e\\u003cbr\\u003eCustomize your farm and decorate with a wide variety of items. Build your dream farm step by step, raising animals, farming crops, and designing your land.\\u003cbr\\u003e\\u003cbr\\u003eTrade and sell items by truck or steamboat. Trade crops, fish, and fresh goods from your animals, and share resources to gain experience and coins. Become a successful farming tycoon with your own Roadside Shop. \\u003cbr\\u003e\\u003cbr\\u003eExpand your farming simulator experience and play with friends. Join a neighborhood, or create your own with up to 30 players. Exchange tips and help each other create amazing farms! Play with friends in this farming simulator to build, trade, and fish together.\\u003cbr\\u003e\\u003cbr\\u003eHay Day is free to download and play, however, some game items can also be purchased for real money (including random items). If you don\\u0026#39;t want to purchase game items for real money, please disable in-app purchases in your device\\u0026#39;s settings. A network connection is also required.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003eHay Day Features:\\u003cbr\\u003e\\u003cbr\\u003ePeaceful farm simulator\\u003cbr\\u003e- Farming is easy on this ranch simulator – get plots, grow crops, harvest, repeat!\\u003cbr\\u003e- Customize your family farm \\u0026amp; make your own slice of paradise\\u003cbr\\u003e- Trade and sell – become a farm tycoon!\\u003cbr\\u003e\\u003cbr\\u003eCrops to grow \\u0026amp; harvest:\\u003cbr\\u003e- Crops like wheat and corn never die in this farm simulator\\u003cbr\\u003e- Harvest and replant, or use crops like wheat to make bread\\u003cbr\\u003e- Trade and sell your crops to be a farming legend!\\u003cbr\\u003e\\u003cbr\\u003eRaise animals in-game:\\u003cbr\\u003e- Meet quirky animals!\\u003cbr\\u003e- Rear chickens, horses, cows, and more\\u003cbr\\u003e- Pets like puppies, kittens, and bunnies can be added to your farm\\u003cbr\\u003e\\u003cbr\\u003ePlaces to visit:\\u003cbr\\u003e- Fishing Lake: Repair your dock and cast your lure to fish\\u003cbr\\u003e- Town: Repair the train station and fulfill visitor orders\\u003cbr\\u003e- Valley: Play with friends in different seasons and events\\u003cbr\\u003e- Fishing is key to your farming adventure – fish, farming, and trade all in one game.\\u003cbr\\u003e\\u003cbr\\u003ePlay with Friends \\u0026amp; Neighbors:\\u003cbr\\u003e- Trade crops and fresh goods\\u003cbr\\u003e- Share tips with friends and help them complete trades\\u003cbr\\u003e- Compete in weekly neighborhood derby events to win rewards!\\u003cbr\\u003e\\u003cbr\\u003eDownload now and build your dream farm in the most fun farming simulator!\\u003cbr\\u003e\\u003cbr\\u003eNeighbor, are you having problems? \\u003cbr\\u003eVisit https://supercell.helpshift.com/a/hay-day/?l\\u003den or contact us in-game by going to Settings \\u0026gt; Help and Support. \\u003cbr\\u003e\\u003cbr\\u003eNotice of Access Permission:\\u003cbr\\u003e[Optional permission]\\u003cbr\\u003eHay Day may request permission via in-game pop ups to access your camera and send you notifications.\\u003cbr\\u003eCamera: For in-game scanning of QR codes\\u003cbr\\u003eNotifications: For sending notifications related to the game\\u003cbr\\u003eConsent is optional and you can use the app and play the game regardless of whether or not you consent. You may refuse to give consent within the game. However, certain app features may not work properly if you refuse optional access permissions.\\u003cbr\\u003eThe IGRS Rating for this game is 13+.\\u003cbr\\u003e\\u003cbr\\u003ePrivacy Policy:\\u003cbr\\u003ehttp://www.supercell.net/privacy-policy/ \\u003cbr\\u003e\\u003cbr\\u003eTerms of Service: \\u003cbr\\u003ehttp://www.supercell.net/terms-of-service/ \\u003cbr\\u003e\\u003cbr\\u003eParent\\u0026#39;s Guide: \\u003cbr\\u003ehttp://www.supercell.net/parents/\"],\"Supercell\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/fTLqW6lHE8JVOr9MSldgEbYqEx0zw3fK-PcsU7vSlXil3gpVevVVMPdeb7-Ag8wmCrw0kIRQNZ3CmVP0XsxM\"],null,[234,238,240,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,[null,\"Users Interact, In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.supercell.hayday\\u0026rdid\\u003dcom.supercell.hayday\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.29 - $239.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.farlightgames.pgame.gp\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/nIjO9pFz1R7G_wct00QMBKVqAmLHs2TqiaCmSUJfnKPw7yG_VzSmp26TRGCmm98v-Mye0MtsW_xz8CHNdIFD1A\"],null,[146,43,245,255],null,null,null,2],[[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/XTUeb2SWoDd4wQ869k1WfmMqves_svKHMmyN2O5628mRpeVm6T2wxhev09nySoHXnj1yUYHX8uUhC92gt6pT\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/FNKII39HqVM_acYL8_dzuG_Y51MQ2mXG_NQBiC7jaZMmd7qL5wm0oVcJhtwLxInEGk9TA-7v6QJfKiW