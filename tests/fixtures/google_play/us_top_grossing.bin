dcom.fliqlab.haven\\u0026rdid\\u003dcom.fliqlab.haven\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.fliqlab.haven\"]],[\"qgJbGlkIUEoTCLXM77LHkJcDFSS6rAIdLhkZOPoBDwoNCAASCQoFZW4tVVMQALoCLQoXChFjb20uZmxpcWxhYi5oYXZlbhABGAMSEgoECAEQAQoECAMQAQoECAQQAQ\\u003d\\u003d\"],null,[null,\"Welcome to Aesthetic — the interior design game where your taste is put to the test.\\u003cbr\\u003e\\u003cbr\\u003eTake on design challenges, style beautiful rooms, and compete head-to-head with players around the world. Do you have what it takes to be the top designer?\\u003cbr\\u003e\\u003cbr\\u003eHOW IT WORKS\\u003cbr\\u003eEvery challenge starts with a client brief — a room, a style, a vision. Browse a curated collection of materials for walls, floors, furniture, and fixtures to bring the design to life. Submit your creation and see how it stacks up against the competition.\\u003cbr\\u003e\\u003cbr\\u003eCOMPETE \\u0026amp; VOTE\\u003cbr\\u003eYour designs are ranked against other players. Vote on head-to-head matchups to earn rewards and help decide who takes the crown. The better you design and vote, the faster you rise.\\u003cbr\\u003e\\u003cbr\\u003ePROGRESS \\u0026amp; UNLOCK\\u003cbr\\u003eWork your way through chapters filled with unique design challenges. Earn stars, unlock new levels, and expand your material collection with designer and luxury options as you advance.\\u003cbr\\u003e\\u003cbr\\u003eKEY FEATURES\\u003cbr\\u003e• Style rooms with hundreds of materials across walls, floors, furniture, and more\\u003cbr\\u003e• Compete in ranked design challenges against real players\\u003cbr\\u003e• Vote on head-to-head design matchups to earn coins\\u003cbr\\u003e• Progress through chapters and unlock new challenges\\u003cbr\\u003e• Collect designer and luxury materials to elevate your designs\\u003cbr\\u003e• Track your stats on the leaderboard — rankings, stars, and earnings\\u003cbr\\u003e• Shop for material bundles and currency packs to get ahead\\u003cbr\\u003e\\u003cbr\\u003eWhether you\\u0026#39;re a design fanatic or just love a good competition, Aesthetic gives you a place to flex your creative eye. Download now and start designing.\"],\"Fliq Lab\",\"10,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/Iv7LznNfnlXDUO0Drj68-zkvkem0Ey-vG-UVDfo3v0CZvStWFQmUE3OZsAN0iN2T9vDDsjZJ6VHsTmtW1ur4Mxs\"],null,[195,195,192,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,[null,\"Content is generally suitable for all ages. May contain minimal cartoon, fantasy or mild violence and/or infrequent use of mild language.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.fliqlab.haven\\u0026rdid\\u003dcom.fliqlab.haven\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$1.99 - $199.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.mergegames.petsharbor\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com