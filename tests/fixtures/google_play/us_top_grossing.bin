[[[null,null,\"5kWuJIRc6xU\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:5kWuJIRc6xU?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:5kWuJIRc6xU\",null,null,null,null,\"AXH1ezl6y5BXccV_4j0ru33b0aqcNgE44-FlrDI-fMvfNTGSEiNhT1FZsV0ECG3l5alMYY6mJzFYLEgWAWsWpS2kUldiQVGGsmFq6V-jFWO3n_PSsKpCVQhC1enPrLWUsTJ40m2XxCLW8kYjwSDhShSLrxTHRlqOVGpU-pm-kJ4FmQdpF8pBRJWLkPOQzZ3P8UfLqrI8xvx3QlJQxZb-ONK4c6sBznefqSQutvcGNDDA76MJz5_WqW7fC5zg1LTu9MPzNB6CJKnuTp11ePGaahbkQz706YmcCgG0jnFCZH15Vn_3jQ\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/5kWuJIRc6xU/hqdefault.jpg\"]]]],[null,\"\\u0026quot;Welcome to Merge Fashion🎉\\u003cbr\\u003eAfter being cruelly betrayed by her boyfriend, Alice makes a firm decision to transform herself. Following her transformation, a mysterious CEO chooses to marry her in a whirlwind romance. But is this new chapter truly the fresh start she hopes for, or does it conceal even more secrets? Experience the twists and turns of this dramatic love story while enjoying one of the most captivating merge games. Merge fashion, transform Alice, and watch the mystery unfold in this exciting love merge makeover journey.\\u003cbr\\u003e\\u003cbr\\u003eMerge Fashion💍\\u003cbr\\u003eThe more you merge, the more fashion items you’ll find to add to your collection! Whether it\\u0026#39;s elegant accessories or trendy outfits, every merge contributes to Alice’s makeover and takes you closer to solving her mysteries. If you\\u0026#39;re a fan of merge makeover or fashion games, this is the perfect game for you.\\u003cbr\\u003e\\u003cbr\\u003eReveal Romance Story📖\\u003cbr\\u003eAn ever-evolving love story, dive into passionate conflicts and hidden desires, as you uncover thrilling chapters of romance. Progress through the story, unveil new secrets, heart-wrenching twists, and clues to help you unravel Alice\\u0026#39;s love merge story. From unexpected betrayals to whirlwind romances, this puzzle game keeps you hooked as you piece together the story.\\u003cbr\\u003e\\u003cbr\\u003eMakeup and Dress-up👗\\u003cbr\\u003e\\u003cbr\\u003eTry out various fashion styles and accessories, from elegant jewelry to designer handbags, and create the dream outfits of every fashionista.\\u003cbr\\u003eEveryone has a unique taste when it comes to dressing up. Transform appearances and outfits, stay on top of the latest fashion trends, and create the character image you desire.\\u003cbr\\u003eExplore styles that include elegant evening gowns, casual chic outfits, and more. Mix and match dresses, skirts, and tops in this fashion dress-up game to craft stunning looks for any occasion.\\u003cbr\\u003eUnleash your creativity and create the perfect makeover for Alice, whether it\\u0026#39;s for a fashion show, a romantic date, or an elegant event.\\u003cbr\\u003eIf you enjoy makeup games, dress-up games, or makeover games, this game combines all your favorites into one immersive experience. Compete in fashion dress-up games competition and show off your skills in creating the ultimate looks.\\u003cbr\\u003e\\u003cbr\\u003eWhy Play Merge Fashion?\\u003cbr\\u003e\\u003cbr\\u003eCombine the excitement of merge games with the creativity of fashion games.\\u003cbr\\u003eProgress through an engaging love story filled with mysteries and drama.\\u003cbr\\u003eExperience a unique blend of puzzle games, makeover games, and fashion dress-up games.\\u003cbr\\u003eWhether you love the thrill of merge makeovers, enjoy crafting stunning outfits, or solving puzzles, Merge Fashion has something for everyone. Transform Alice, merge your way to success, and immerse yourself in a world of fashion, love, and secrets.\\u003cbr\\u003e\\u003cbr\\u003eNeed help? Contact us by sending an email to feedback@infiniplay-game.com\\u003cbr\\u003eWe\\u0026#39;re here to help you! \\u003cbr\\u003e\\u003cbr\\u003ePrivacy Policy:\\u003cbr\\u003ehttps://infiniplay-game.com/policy.html\\u003cbr\\u003e\\u003cbr\\u003eTerms of Service:\\u003cbr\\u003ehttps://infiniplay-game.com/service.html\\u0026quot;\"],\"Infiniplay-Game\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/DJMQF1xCXfV3yeVkJH-aXYRMO9k0TrwUzOoJJGTykes8oAPikpteMJg3rP7bHPosJEtwnRyccExvuzNq4TpA\"],null,[240,227,202,255]],null,[\"Teen\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/mw_NfsvKM8m6RPv8Fz2GQawCOsqWv010saMnc7zbWalMxuaA9IY8h7E0VMieLxSxAFB98NFeYqbFrXXq\"]],[null,\"Suggestive Themes\"],null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/xl04GurQer374yogi24hRkvUcXtMStMOcOo86Sprmrid9j6wQHF0d9xMh73CwUEg57lbsGIwpOXgrJ927Q\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.infiniplay.merge.fashion.romance.story\\u0026rdid\\u003dcom.infiniplay.merge.fashion.romance.story\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.29 - $129.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.king.farmheroessupersaga\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/nDNWfn_xZbQcMjCAokiWVyRADy7k6r0DKfkFo1kcucEZJ1ZKAXq1TtX1pQnc8cU6RZyxyr5Pf8rPKNNcN2Fs8A\"],null,[59,171,228,255],null,null,null,2],[[null,2,[1280,768],[null,null,\"https://play-lh.googleusercontent.com/YTIO5Q4OIMUTj3hVjTvDamoJnwlaee6ONqnD1G9ly6svzZmC4hwlaFpmChPkOrSfsPYqlCmcx7ISxi5hMsa7dgE\"]],[nul