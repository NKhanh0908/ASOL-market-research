-lh.googleusercontent.com/S3mDHqDMUQ0YMhmO79rN9rmphkkddC02NVLNM_4ebY5SXRlvO0D5m3FwyGA0HxtDH188RemVpuLDjYC6WCktZA\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/lHjM61BF1ulLvAePIdRmtcAC6fn5oQ8iUtAbE4TVHaVoBIYppLUYYyZeCjzYvcucribNcQdrJez4i_Zvxc4phKY\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/30kRvRBZ32xKUIWUFZ1WFPyegqhgE0dvG3ckEqjCed_NW74xW1gtCthc6RhPRMvjBqHPKWXumfbi_tWcvMwraQ\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/UeAmxgy2UukXM4WTy34mWyGLHNmF88bRD1cy1S77YMCKlAKDf7g9nFtP-vUPEy8qyoiuSYCyDp7XKHvWUvYJgA\"]]],\"Match Masters\",[\"4.7\",4.7415457],\"Casual\",null,null,[null,[[0,\"SGD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.funtomic.matchmasters\\u0026rdid\\u003dcom.funtomic.matchmasters\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.funtomic.matchmasters\"]],[\"qgJjGmEIFEoTCOab4LHHkJcDFYmz2AUd5DsHbvoBDwoNCAASCQoFZW4tVVMQALoCNQofChljb20uZnVudG9taWMubWF0Y2htYXN0ZXJzEAEYAxISCgQIARABCgQIAxABCgQIBBAB\"],[[[null,null,\"C5XwvkHHhY4\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:C5XwvkHHhY4?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:C5XwvkHHhY4\",null,null,null,null,\"AXH1ezmba5HQbZWyYZaLYmmg4LGv-1yjXDHm5jgYofNr0JpDYJdx3T_gluCA1NF1qMbdsyXVpU0keCdrpsVbTi8ZAa2iKYV9Toco7Ge-iM9MLW25FOy_kxD3zlkjpifT7El-cU90pF3hxJg382Xzj8ZWmPfTcarPusT2L6ShTpXGQ4hi5yaTUMeWVFzP80-8hLi_FZqRJmu5na9ECWucWKh5HErjV46j5XrBT69_rimzcSGtjXLi9iWEaDAsmqaYJtBpO5LVlS_n6IdNyTnqyEAAonepR-tEaPJQVgXZetNuRdKrfw\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/C5XwvkHHhY4/hqdefault.jpg\"]]]],[null,\"Match 3 puzzle game - reinvented! Now stepping into the world of pvp multiplayer games!\\u003cbr\\u003e\\u003cbr\\u003e🌟 \\u003cb\\u003eA NEW WAY TO PLAY\\u003c/b\\u003e 🌟 Play LIVE with friends OR against opponents from all over the world in a fun online match 3 game competition! Match Masters is free and has tons of new exciting ways to play matching games!\\u003cbr\\u003e\\u003cbr\\u003e🎮 \\u003cb\\u003ePVP MULTIPLAYER ACTION\\u003c/b\\u003e 🎮 If you love pvp multiplayer games, Match Masters brings an incredible twist. Players take turns playing against each other on the same match 3 game board, so they must take into account not only the score they will get from their moves, but also the opportunities they could create for their opponent! Experience one of the best pvp multiplayer games out there!\\u003cbr\\u003e\\u003cbr\\u003e🚀 \\u003cb\\u003eAWESOME POWERUPS\\u003c/b\\u003e 🚀 Every blue star you match charges your Booster, while your opponent collects red circles. Use your booster to boost your score, tip the game in your favor, make satisfying comebacks, and score huge combos! Play with one of 20+ available boosters, and master their strategies and effects.\\u003cbr\\u003e\\u003cbr\\u003e🏆 \\u003cb\\u003eTOURNAMENTS, COMPETITIONS \\u0026amp; EVENTS\\u003c/b\\u003e 🏆 Play Match Masters LIVE against friends or random opponents in knock-out tournaments and earn trophies to unlock new studios and compete against the best players on the leaderboards! Reach the top in our changing events and win AMAZING rewards! Become the master of all matching games and the ultimate puzzle game champion!\\u003cbr\\u003e\\u003cbr\\u003e👫 \\u003cb\\u003eCOMPETE WITH YOUR FRIENDS\\u003c/b\\u003e 👫 Looking for the perfect games to play with friends? Match Masters is even more fun when you play with friends 😊. It stands out among games to play with friends because you can connect with Facebook to challenge your buddies and find out who the real Match Master is! When it comes to games to play with friends, this one takes the crown.\\u003cbr\\u003e\\u003cbr\\u003e👜 \\u003cb\\u003eSTICKER ALBUMS\\u003c/b\\u003e 👜 Collect stickers and complete amazing sticker albums to receive HUGE prizes, trendy outfits, and unique style packs that will dazzle your opponents!\\u003cbr\\u003e\\u003cbr\\u003e👤 \\u003cb\\u003eJOIN THE COMMUNITY\\u003c/b\\u003e 👤 Join our Official Group to meet, chat, and share your game achievements with other Match Masters around the world! Don’t miss out on your chance to win FREE prizes: \\u003cbr\\u003e\\u003cbr\\u003ehttps://www.facebook.com/matchmastersgame \\u003cbr\\u003ehttps://www.instagram.com/matchmastersofficial \\u003cbr\\u003ehttps://twitter.com/match_masters \\u003cbr\\u003ehttps://youtube.com/c/matchmasters \\u003cbr\\u003ehttps://www.tiktok.com/@matchmasters_official \\u003cbr\\u003ehttps://discord.gg/matchmasters\\u003cbr\\u003e\\u003cbr\\u003ePlayed thousands of levels in other tile matching games? It\\u0026#39;s time to Meet Your Match! Are you ready to try a revolutionary match 3 game? Play this brilliant puzzle game like never before!\"],\"Candivore\",\"50,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/qmFzrEK-qhHaFfZq_J-yGZ_LJL5tI_z_JUVRDbjrxqdgcHQPvEd5klFL6njPYbuL_FbNVMWfs1ToXBjXyvrQJw\"],null,[6,74,198,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Users Interact, In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"SGD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom