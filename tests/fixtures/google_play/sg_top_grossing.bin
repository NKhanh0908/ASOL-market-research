8],[null,null,\"https://play-lh.googleusercontent.com/VLuetp6lak5O8mLoIzDof-iKb22fO2hHvqLUtyZAP0KbZ5ngO89pVWmTPrF6jqLfDgT0M_kMceRksFj_Z9220Nw\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/xbBfPfnanWMPfnGvJi0aZTCfRloHoM5yn5ToR-vlST-l2y45iqoilOphQRyOJYgqVHROokgckWdCIxqQEVGvDQ\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/JnRE2no9GkPzdKFTtNGa63cZkBa9-tj5FEkHE7ACp24SESSFxTdJYZWP9ivBjPFsruya4WCzbnFK2JqSgTF6\"]]],\"Hotel Legacy: Merge Game\",[\"4.7\",4.6904764],\"Casual\",null,null,[null,[[0,\"SGD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.fatr.global\\u0026rdid\\u003dcom.fatr.global\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.fatr.global\"]],[\"qgJZGlcIE0oTCOab4LHHkJcDFYmz2AUd5DsHbvoBDwoNCAASCQoFZW4tVVMQALoCKwoVCg9jb20uZmF0ci5nbG9iYWwQARgDEhIKBAgBEAEKBAgDEAEKBAgEEAE\\u003d\"],null,[null,\"Alyssa suddenly inherited a mysterious legacy from her grandmother—a Hotel Manor! She teams up with some interesting friends and desires to build her Hotel Empire! Join us as we merge and discover how she achieves her goals!\\u003cbr\\u003e\\u003cbr\\u003eMerge Fancy Items\\u003cbr\\u003eServe guests with cozy service, fine cuisines, amazing drinks, and colorful souvenirs. The more you play, the more items you will be able to create! Let\\u0026#39;s merge together and become top-class hotel managers!\\u003cbr\\u003e\\u003cbr\\u003eRenovate Theme Hotels \\u003cbr\\u003eBuy new land, renovate old buildings, and turn them into wonderful hotels. Experience a totally different hotel style all over the world and throughout the ages!\\u003cbr\\u003e\\u003cbr\\u003eBuild Relationships\\u003cbr\\u003eMeet guests from around the world. Listen to their stories and exchange fun life experiences. Guess who might find their true love during the journey?\\u003cbr\\u003e\\u003cbr\\u003eThere are hidden surprises waiting for you to discover! Join us on the journey of expanding Hotel Empires!\"],\"Century Games Innovation Pte. Ltd.\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/KDL2eRDsgjpaZP8B0DfHudGf6zWE_4rz8jMk924St4qSZHhULB-RIGixLGGmtc-t_pcgHMSRtetE1VEESDrs\"],null,[163,38,35,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,[null,\"Suitable for all age groups. Some violence in a comical or fantasy context is acceptable. Bad language is not permitted.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"SGD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.fatr.global\\u0026rdid\\u003dcom.fatr.global\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$1.48 - $148.98 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.funtomic.matchmasters\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/UZhXVbf8ViUq04c7ncQuR3CPf7GC4Y6c6gBU0OuepjrK_QUDlY-oIL03nEBCQdEm_EbaDx8cL4xDxRqWR70rgA\"],null,[203,249,246,255],null,nu