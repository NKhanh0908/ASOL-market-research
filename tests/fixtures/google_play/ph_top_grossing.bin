l,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.zykj.princessknight\"]],[\"qgJnGmUIOkoTCJy9srHHkJcDFQicrAIdD7EeP/oBDwoNCAASCQoFZW4tVVMQALoCOQodChdjb20uenlrai5wcmluY2Vzc2tuaWdodBABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,\"5mCTHw_2aDw\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:5mCTHw_2aDw?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:5mCTHw_2aDw\",null,null,null,null,\"AXH1eznxswk6DA4-lHmlrLAQFIxL6JRVWimAzJarPl-yff4cfdrGye9GrGtXL7nAgOu2TTR6ClSCYiCklnQ5XEPW29rfVhZESPzl97mtClicr2xeUVkRsGcRrT5BmgmDJdx0EpHcmlnBfiqLeGVMAeJmGr_3cVJzLje2hv_DFIfUCDCgWXko45QZ21HOnIc8xiVavhMlFyMSgmplVaaxvU5IIqQ2CTQ1U7hlJjUAHX7kjz7bActni1LS5r9Q5j2A9zKnmAMwIHC9X-ieSjuuTz1cEe-ytCEkmeXS2uhw--IzBBUgYg\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/5mCTHw_2aDw/hqdefault.jpg\"]]]],[null,\"Are you ready for the challenge, Knight Survivor?\\u003cbr\\u003eThe fate of the princess rests in your hands, but a fire-breathing dragon stands in your way! All-new roguelite skill experience\\u003cbr\\u003e\\u003cbr\\u003e🎮 Core gameplay: slay dragons with masterful strategy\\u003cbr\\u003eIn Knight Survivor, every fight is a high-stakes chess match against unpredictable and powerful dragons. These aren\\u0026#39;t mindless beasts; they\\u0026#39;re cunning bosses with unique weaknesses and complex attack patterns.\\u003cbr\\u003e\\u003cbr\\u003e🌟 Features:\\u003cbr\\u003e1. Dynamic dragon bosses: Every boss in Knight Survivor is meticulously designed with unique behaviors and fatal flaws. Mastering their patterns and exploiting their weaknesses is the only path to victory.\\u003cbr\\u003e\\u003cbr\\u003e2. Endless roguelike builds: Fusing the best of roguelike design, the game offers a massive pool of skills to discover. All-new roguelite skill experience with unlimited combinations\\u003cbr\\u003e\\u003cbr\\u003e3. Strategic level diversity: Each new level demands a different tactical approach. Experiment with powerful skill combinations to carve a path through a perilous world and prove your strategic mastery.\\u003cbr\\u003e\\u003cbr\\u003e🔥 Answer the call, Knight Survivor!\\u003cbr\\u003e\\u003cbr\\u003eHone your skills, forge your path, and save the princess. Survive the fun!\\u003cbr\\u003eYour epic journey begins now. Are you ready?\"],\"MOBIBRAIN TECHNOLOGY PTE. LTD.\",\"500,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/O5liCc6YKJemqyI1qFrSRECc1sKw3wDx2wmrpISvNSw-6woOQliXk1-s3sqXtka0egW69-TrITBiAOtUHsmE8Q\"],null,[117,205,253,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,[null,\"Suitable for all age groups. Some violence in a comical or fantasy context is acceptable. Bad language is not permitted.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"PHP\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.zykj.princessknight\\u0026rdid\\u003dcom.zykj.princessknight\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"₱33.00 - ₱7,050.00 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,nul