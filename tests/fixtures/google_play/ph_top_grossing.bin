,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/g2t1lhHWelqHqS1t_heRfJyEAhibVGVf7o_XkCsTuAhS6KcCuqskC1_7IPAG601oeWbdrnIa-z1kkr6cmbRW\"]]],\"Legend of Mushroom: Rush - SEA\",[\"4.5\",4.5316057],\"Casual\",null,null,[null,[[0,\"PHP\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.mxdzz.sea\\u0026rdid\\u003dcom.mxdzz.sea\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.mxdzz.sea\"]],[\"qgJdGlsIHUoTCJy9srHHkJcDFQicrAIdD7EeP/oBDwoNCAASCQoFZW4tR0IQALoCLwoTCg1jb20ubXhkenouc2VhEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"Hey there, the last warrior on Shroom Island! The mission of reviving your home has begun. Thanks to the Lamp Goddess, she has blessed you with a magic lamp that dishes out fantastic gear! Pick up your weapon, gather allies, and tackle those challenging Bosses together to protect the island! \\u003cbr\\u003e\\u003cbr\\u003e [Explore and Progress, Loot Opening]\\u003cbr\\u003e Tap into the magic lamp and reveal epic gear! Battle monsters, endlessly unlock loot. Enhance your lamp level to boost the chances of rare weapon drops. A single tap brings divine gear and top-tier stats your way. Don\\u0026#39;t forget to revel in the auto-progress feature. No need to constantly monitor the game! \\u003cbr\\u003e\\u003cbr\\u003e [Recruit Companions, Adventure Together]\\u003cbr\\u003e Defending our homeland isn\\u0026#39;t a solo mission! Recruit pets as companions, build a strong adventure team. They\\u0026#39;ll stand by you, facing unknown challenges, and fighting for Shroom Island! \\u003cbr\\u003e\\u003cbr\\u003e [Freedom to Change, Super Evolution]\\u003cbr\\u003e Tailor your gaming strategy! Switch between warriors, archers, and mages as battles demand. Train talents, enhance skills, and unlock the potential for a super-evolution! \\u003cbr\\u003e\\u003cbr\\u003e [Socialize Effortlessly, Conquer Bosses Together]\\u003cbr\\u003e Forge new friendships in-game! Exchange adventure tips and tricks. Become part of the shroom family, team up against challenging Bosses with fellow members, and explore entertaining features like the Manor and Parking Lot. Dive into a world filled with enriching and joyful experiences!\\u003cbr\\u003e\\u003cbr\\u003eGooGhywoiu9839t543j0s7543uw1 - pls add {4399haifa@gmail.com} to GA account {294609776} with ‘Administrator’ permissions - date {2024/12/26}.\"],\"SPARKGAME LIMITED\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/Jc-G4yN9rGxyNMq_38wZB-Tc3_gmFqY238EQVJFDrZKql7UmQyUBMfZ5RV_3n2qesSUG3jS_q5N77LgqG1EE5Q\"],null,[151,210,234,255]],null,[\"Rated for 12+\",[null,2,[366,512],[null,null,\"https://play-lh.googleusercontent.com/yQChfa9XKlaXMIYTk8w8QwChjT8_SH-_2d2SS-kesw0TLQK1nxtw54bDcoZ09freZJgKrtg4f__is-31Vg\"]],[null,\"Moderate Violence\"],[null,\"Users Interact, In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/YrkR-GP7OKghBTATCoO_jJrchSVrh-NSUBb5DnbRZC1DbLK_cgV9FC2e_iI4GzLsKXuZjuFZajnGCiA8qA\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"PHP\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.mxdzz.sea\\u0026rdid\\u003dcom.mxdzz.sea\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"₱19.00 - ₱18,490.00 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,nu