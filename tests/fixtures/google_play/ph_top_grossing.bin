,[null,null,\"/store/apps/details?id\\u003dcom.playrix.homescapes\"]],[\"qgJmGmQIB0oTCJy9srHHkJcDFQicrAIdD7EeP/oBDwoNCAASCQoFZW4tVVMQALoCOAocChZjb20ucGxheXJpeC5ob21lc2NhcGVzEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],[[[null,null,\"DsW6r-_gRdY\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:DsW6r-_gRdY?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:DsW6r-_gRdY\",null,null,null,null,\"AXH1ezmFNlxo2PRu_GaGWPCtBtW8DgCR5Kk7fXLAcRwefn-HBQhaPqJ3x54FiIawZVO2d7C2AMKW8G0C5CzXfjJAWrkbJf-0asWx8JlJEtr4lF-jQw7II5hUD2pCGp2sY47EfuCvO1mfehQedt80JPDJpxnAvQDwsdWeIWxyemL-mff96e-JTew9Or6dD4bqOjlOUtzBuIu-KUAMzryd0Uk8XVnB5Po9JWNKCcbdcKHInvbUPpzlzeKyIxx-njVIff_9iHF0wA8XfpHpjEilZS8wq6wbBhORO-A1cIcJ45U9j7WHqQ\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/DsW6r-_gRdY/hqdefault.jpg\"]]]],[null,\"Welcome to Homescapes, a warm and cozy game from the famous Playrix Scapes™ series! Make match-3 combinations and turn every corner of your home into an inviting place to relax and have fun.\\u003cbr\\u003e\\u003cbr\\u003eSolve puzzles, restore the interior room by room, and meet new friends in every chapter of the exciting storyline. Austin the butler is ready to welcome you to a world of incredible adventures!\\u003cbr\\u003e\\u003cbr\\u003eGame features:\\u003cbr\\u003e● Original gameplay: make match-3 combinations and decorate your house while enjoying an exciting story!\\u003cbr\\u003e● Thousands of captivating levels with explosive power-ups, useful boosters, and cool elements.\\u003cbr\\u003e● Exciting events: embark on fascinating expeditions, compete against other players in different challenges, and win awesome prizes!\\u003cbr\\u003e● Unique rooms with original designs: from Austin\\u0026#39;s bedroom to a greenhouse.\\u003cbr\\u003e● Loads of fun characters: meet Austin\\u0026#39;s friends and your neighbors!\\u003cbr\\u003e● Adorable pets that will become your faithful companions!\\u003cbr\\u003e\\u003cbr\\u003ePlay with your Facebook friends, or make new friends in the game community!\\u003cbr\\u003e\\u003cbr\\u003eHomescapes is free to play, but some in-game elements (including randomized items) can be purchased for real money.\\u003cbr\\u003e\\u003cbr\\u003eA Wi-Fi or internet connection is not required to play.\\u003cbr\\u003e *An internet connection is required to access competitions and additional features.\\u003cbr\\u003e\\u003cbr\\u003eDo you like Homescapes? Follow us on social media!\\u003cbr\\u003ehttps://www.facebook.com/homescapes\\u003cbr\\u003ehttps://www.instagram.com/homescapes_mobile/\\u003cbr\\u003e\\u003cbr\\u003eNeed to report an issue or ask a question? Contact Player Support through the game by going to Settings \\u0026gt; Help and Support. If you can\\u0026#39;t access the game, use the web chat by clicking the chat icon in the lower right corner of our website: https://playrix.helpshift.com/hc/en/14-homescapes/\\u003cbr\\u003e\\u003cbr\\u003ePrivacy Policy: https://playrix.com/privacy/index.html\\u003cbr\\u003eTerms of Use: https://playrix.com/terms/index.html\"],\"Playrix\",\"500,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/U7-71AFKFm6f4Ak4Z0NxLZwebL-K2ZEvCn7mlgFn6LDP-yZe48jYk0hqnwNkoPQFLrpjfIRkkNrZmeocvVpI\"],null,[148,112,154,255]],null,[\"Rated for 7+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/1SrNtAwg9PFOhgMJPXehacRTeQNhHhG12Pj1zACHNVmfRfEZA3_oOEmLvRNsmYGeGHpas7sCwyR3y8OT\"]],[null,\"Fear\"],[null,\"Users Interact, In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/JTT-ImEkrbWzIL7w0fP8fQhVmpexdfh7u0P59PJtyJywmQBVolJjunMal6B5dUM6uiFiKnmtHtBbVvcWBMU\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[