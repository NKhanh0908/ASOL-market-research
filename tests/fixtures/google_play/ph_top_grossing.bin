LcJ-Ww32TKv0ZCvuO3WgJLEiJib_B9qDmdb56HZqdRUthrPM\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/9B3i3vmhUlnphYYPCv2KDwFLKPvUioEB_X5hDunVZskAOc8kvUGygN-A24OKFBEsrSmHrTKawwY30eCarWmYJA\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/CmU97rJ2n7burjH5F_KN_fuZUQ8amCJCatQ2VsitUnVVmSkTCanb7Z1CK6G_NohZYFHv9-GQ8qEFbrt_ZfwPjg\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/1Qjf9qiqT0epybNOGeZcl0_FfsEv7dfJBHNIohzfvi5HH5cYHWcVNc20oynVLNFm41CyQyBsymnUOKHxX3FF\"]]],\"Party in my Dorm: Campus Life\",[\"3.1\",3.1050506],\"Casual\",null,null,[null,[[0,\"PHP\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003data.squid.pimd\\u0026rdid\\u003data.squid.pimd\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003data.squid.pimd\"]],[\"qgJeGlwIKEoTCJy9srHHkJcDFQicrAIdD7EeP/oBDwoNCAASCQoFZW4tVVMQALoCMAoUCg5hdGEuc3F1aWQucGltZBABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"Virtually connect with your crew in an exciting student simulator! Throw a house party, collect exclusive swag, style your look, or just chill with your besties. Next, change up your aesthetic with different clothing styles and apartment decorations. You can even send fun digital gifts, adopt a cute pet, and build an unforgettable squad of friends!\\u003cbr\\u003e\\u003cbr\\u003eEnjoy social avatar games with unique looks? Choose from a massive variety of popular styles to discover your exact vibe!\\u003cbr\\u003e\\u003cbr\\u003e★ DESIGNER DORM ROOMS\\u003cbr\\u003eCustomize your dream home. From chic VIP lounges and lux beach escapes to retro anime arcades, create your space then enter dorm design challenges for rewards!\\u003cbr\\u003e\\u003cbr\\u003e★ GROW YOUR DORM TOWER\\u003cbr\\u003eRent out rooms and hire dormmates to level up your campus status! Upgrade their skills and challenge other squads to a dance fight.\\u003cbr\\u003e\\u003cbr\\u003e★ 1000+ AVATARS TO CHOOSE\\u003cbr\\u003eLive your best avatar life: match your outfit to your room and style your look as a punk pop star, high fashion icon, whimsical princess, elite athlete, and more!\\u003cbr\\u003e\\u003cbr\\u003e★ ZODIAC STYLES\\u003cbr\\u003eElevate your aesthetic with fantasy inspired trends and furniture themed around your zodiac sign. Showcase a rare collection and outshine the competition!\\u003cbr\\u003e\\u003cbr\\u003e★ GROUP CHAT \\u0026amp; TEXT GAMES\\u003cbr\\u003eMake real-time community messaging safe and easy. Send emote stickers, play fun text mini-games, share your latest makeover designs, and stay connected with your Club.\\u003cbr\\u003e\\u003cbr\\u003e★ CHARACTERS AND STORIES\\u003cbr\\u003eEncounter comedic classmates, mysterious personalities, and entertaining rivalries to interact with as you rise to the top of the leaderboards.\\u003cbr\\u003e\\u003cbr\\u003e★ ADOPT A VIRTUAL PET\\u003cbr\\u003eBring home a cute pug, a sleek Sphynx cat, or a magical unicorn! Dress them in adorable outfits to perfectly match your avatar\\u0026#39;s style and show them off to your squad.\\u003cbr\\u003e\\u003cbr\\u003eSchool is in session. Virtually meet your crew and make online memories together!\\u003cbr\\u003e\\u003cbr\\u003ePLEASE NOTE:\\u003cbr\\u003eThis is an ONLINE casual MMO game. An active network or Wi-Fi connection is required in order to play.\"],\"A Thinking Ape Entertainment Ltd.\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/oxm5msXbt20vTrG2BnVn828p_sR6TUB2VlLLmgYC4HhAtEy3sh52iuOFwslEB_IXH7qzYGAmA5vItQS3ssq3gA\"],null,[195,122,246,255]],null,[\"Rated for 12+\",[null,2,[366,512],[null,null,\"https://play-lh.googleusercontent.com/yQChfa9XKlaXMIYTk8w8QwChjT8_SH-_2d2SS-kesw0TLQK1nxtw54bDcoZ09freZJgKrtg4f__is-31Vg\"]],[null,\"Sexual Innuendo, Horror\"],[null,\"Users Interact, In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/YrkR-GP7OKghBTATCoO_jJrchSVrh-NSUBb5DnbRZC1DbLK_cgV9FC2e_iI4GzLsKXuZjuFZajnGCiA8qA\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"PHP\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003data.squid.pimd\\u0026rdid\\u003data.squid.pimd\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"₱49.00 - ₱14,990.00 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"bus.sand.fall.jam.loop.traffic.flow\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/-TcLefDSecp5lo9jZbNF1LcnFVef7kv0pUNUGEBoX-Q22Ipc8wSWk8Z9cv-dHE4s7c4_hy8j4x8h1H_IFzO-kH0\"],null,[42,176,248,255],null,null,null,2],[[null,2,[2450,1080],[null,null,\"https://play-lh.googleusercontent.com/ySlhs5k7eGnLsQ7el-aNZbf813Q5JHAJnIGgclYfwE8xLuMjVrChpvvF34qKERQTSor1soxee80dwvhyTLeSeQ8\"]],[null,2,[2450,1080],[null,null,\"https://play-lh.googleusercontent.com/NGMrXO2-QgCuSw7yVM9zUWL0C2MYDOJsPnOZ4_7fHaZ5XqzpipxvoCyLfC8KM3_xLKyWk_ddxnWc7IxJLhixZQ\"]],[null,2,[2450,1080],[null,null,\"https://play-lh.googleusercontent.com/m9cYdb_iKFZQKb-5AWOEXXKwohrtcaEl7Z0nFC31bsyQdVBo2gGrbgNNb3uto_ftCp_qgIkyUrc1PChYwQ75DQ\"]],[null,2,[2450,1080],[null,null,\"https://play-lh.googleusercontent.com/iqtW_S36gKUb4kaavFnzHWEwAtpU-2pn8_xW9CGDfoGEngSRodgkf2Y2KSMZk09AeShJ7LeY9MPrD_kucjdO\"]],[null,2,[2450,1080],[null,null,\"https://play-lh.googleusercontent.com/pbzdMukfEOIJ9Dckm4uaTyzp4NGWqvtav0qlshcF-jMAS-O_XJMKwQzqHfvc4g4BTQlf001-i1RXPCe9DqOX\"]]],\"Jam Bus:Sandfall\",[\"4.9\",4.9051094],\"Casual\",null,null,[null,[[0,\"PHP\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dbus.sand.fall.jam.loop.traffic.flow\\u0026rdid\\u003dbus.sand.fall.jam.loop.traffic.flow\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dbus.sand.fall.jam.loop.traffic.flow\"]],[\"qgJzGnEIKUoTCJy9srHHkJcDFQicrAIdD7EeP/oBDwoNCAASCQoFZW4tVVMQALoCRQopCiNidXMuc2FuZC5mYWxsLmphbS5sb29wLnRyYWZmaWMuZmxvdxABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"Jam Bus: Sandfall brings a fresh twist to bus jam, color puzzle, and traffic escape gameplay.\\u003cbr\\u003eColorful sand is stacked in layers, and every bus has its own color and direction. Tap the right bus, collect the matching sand, and clear the board step by step. Sounds simple at first, but every move can change the whole puzzle.\\u003cbr\\u003ePlan carefully before you tap. Some buses may block each other. Some paths may cross. Some sand colors can only be cleared after the lower layers are gone. To win, you need to observe the board, choose the right order, and keep every bus moving without a crash.\\u003cbr\\u003eHow to play\\u003cbr\\u003e• Tap a bus to move it along its route\\u003cbr\\u003e • Match each bus with the same color sand\\u003cbr\\u003e • Clear lower sand layers to unlock the ones above\\u003cbr\\u003e • Avoid traffic crashes when paths cross\\u003cbr\\u003e • Solve each level with smart sequencing\\u003cbr\\u003eWhy you’ll enjoy Jam Bus: Sandfall\\u003cbr\\u003e• Easy tap controls\\u003cbr\\u003e • Relaxing color-matching gameplay\\u003cbr\\u003e • Clever bus parking jam puzzles\\u003cbr\\u003e • Satisfying sand-clearing effects\\u003cbr\\u003e • Increasingly tricky routes and layers\\u003cbr\\u003e • Clean visuals and smooth puzzle flow\\u003cbr\\u003e • Great for quick breaks and brain training\\u003cbr\\u003eEvery level is a small logic challenge. A bus may look ready to move, but its route might block another vehicle. A color may be visible, but the sand below it must be cleared first. Think ahead, follow the arrows, and find the perfect order to clear the whole sandfall.\\u003cbr\\u003eIf you enjoy bus games, parking jam puzzles, color sort games, traffic escape challenges, or relaxing logic games, Jam Bus: Sandfall gives you a colorful new puzzle to solve.\\u003cbr\\u003eStart with one bus, clear one color, and let the sand fall into place.\"],\"Nova Games Technology Limited\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/Xxtz7lOU2yqCxGMmNiyNb3e-OEhEoW_TeIylWnJOAaXHSDGGAQhJSs12d5B4L6TFUPOV3-3f00S0dPXRunndNQ\"],null,[117,111,117,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Users Interact\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"PHP\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dbus.sand.fall.jam.loop.traffic.flow\\u0026rdid\\u003dbus.sand.fall.jam.loop.traffic.flow\\u0026feature\\u003dmd\\u0026offerId\"]],null