null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.zynga.FarmVille2CountryEscape\"]],[\"qgJ5GncIGkoTCJy9srHHkJcDFQicrAIdD7EeP/oBFwoVCMOErtbq6tSIQxIJCgVlbi1VUxAAugJDCicKIWNvbS56eW5nYS5GYXJtVmlsbGUyQ291bnRyeUVzY2FwZRABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,\"56SFtYKnU5g\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:56SFtYKnU5g?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:56SFtYKnU5g\",null,null,null,null,\"AXH1ezl0URfguUm4Ep8yl_pV4qm-1WsHFDwwxANdUyiA_bnaZRX42Jx7GhsUa4HCBq1uNQcdyIYQ-VDw-z2Fyc4YVQUhyIUo1QRfU4LS0Avg1XXhvKrLi_iHL8-J78460RS5i2bh3bPje7-JXcA2gcP7ONyTVxiKpahnKwdsSs26kXqmtErm8j-OViFAER1uI1f4cJaWSOvxfhOkrQQsCLkpTLwjyOxPM7I_i6qRCA153oFoyYhhqnVVtx4gHs6lnyJKqUKZngBq-E6VO6_IvjpG02Kom96WY2gwEoPmdc0qUL6AMw\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/56SFtYKnU5g/hqdefault.jpg\"]]]],[null,\"Return to your roots with the ultimate farming game adventure: FarmVille 2: Country Escape! This is the coziest, most engaging farm simulation on mobile.\\u003cbr\\u003e\\u003cbr\\u003eTake a charming escape to the countryside farm where you can build your own dream farm and town right by the seaside. In this relaxing farm simulator you’ll enjoy the warm comfort of a simpler life, explore hidden groves, and nurture your very own unique coastal farm. It’s the perfect farming escape.\\u003cbr\\u003e\\u003cbr\\u003eKey Game Features:\\u003cbr\\u003e\\u003cbr\\u003eGROW \\u0026amp; HARVEST: Get back to the land! Plant, grow, and harvest your favorite seasonal crops. Experience the joy of running a bustling farming game—a true-to-life simulator that rewards your hard work.\\u003cbr\\u003e\\u003cbr\\u003eBUILD YOUR TOWN: Master the art of town building! Farm, craft, bake, and trade delicious goods to help your coastal village flourish. Your community is counting on you, the best town builder and farmer in this farming escape game!\\u003cbr\\u003e\\u003cbr\\u003eRAISE ANIMALS: As a dedicated farmer in this farm simulation game, you\\u0026#39;ll feed and care for a variety of adorable farm animals. Gather fresh resources like milk, eggs, and wool to use in your daily crafts.\\u003cbr\\u003e\\u003cbr\\u003eOFFLINE GAMES \\u0026amp; COMFORT: Looking for high-quality offline games? You can play this cozy farm simulation anytime, anywhere! It offers a perfect, stress-free simulation and a complete escape from everyday life.\\u003cbr\\u003e\\u003cbr\\u003eADVENTURE AWAITS: This is more than just a typical farming simulator. Explore the hidden pathways of your Country Escape farm and surrounding areas for rare goods, valuable adventures, and competitive trading opportunities.\\u003cbr\\u003e\\u003cbr\\u003eJoin millions of players in the #1 farm simulation experience! Download FarmVille 2: Country Escape now to begin your grand FARMING adventure and your great ESCAPE to a peaceful farmer life today!\\u003cbr\\u003e\\u003cbr\\u003eAdditional information:\\u003cbr\\u003e• The game is FREE to download \\u0026amp; includes optional in-game purchases (including random items). Information about drop rates for random item purchases can be found in-game. If you wish to disable in-game purchases, please turn off the in-app purchases in your phone or tablet’s Settings.\\u003cbr\\u003e• Use of this application is governed by Zynga’s Terms of Service, found at https://www.take2games.com/legal.\\u003cbr\\u003e• For information about how Zynga uses personal data, please read our privacy policy at https://www.take2games.com/privacy.\"],\"Zynga\",\"50,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/8UxLIijkWMRPm8Oy-tI7Ajd3Tgg0egOj6d2GIEpKaF3DIEiIEq6tCFyxMurtxKwgPxHNM1j9hx80FpF5-D3yeQ\"],null,[126,192,253,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH