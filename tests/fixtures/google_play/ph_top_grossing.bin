google.com/store/apps/details?id\\u003dcom.bailing.lark.roll.dev\\u0026rdid\\u003dcom.bailing.lark.roll.dev\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.bailing.lark.roll.dev\"]],[\"qgJpGmcIJ0oTCJy9srHHkJcDFQicrAIdD7EeP/oBDwoNCAASCQoFZW4tVVMQALoCOwofChljb20uYmFpbGluZy5sYXJrLnJvbGwuZGV2EAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],[[[null,null,\"M-Y61tf6shA\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:M-Y61tf6shA?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:M-Y61tf6shA\",null,null,null,null,\"AXH1ezlXPv32aSxFuBfRHZCzU0bODpvd-nPWEvl9Ska65TwGVgoU6xk04rx9oU9gBXbALclqZDCmsw0G1uvXWuSUg6Pw2TjMxF5TWaE6V1Ig7TtCcGirt7pbGIGLmzDu93mu9RBscp44XzgdVDxsh1ff8x2l5semv_DO_6U_kdykzKMd7cE-aV_pPvmXQpdiH1Lt0z_c1bJhqbyT5gqEt4keY4lNhYHoYx0iONYkK5Xo-4xS_RcRGKpXk9nYMw9SkgiHqb2ho3xtq7S8oeES_6jAfpspAQldxb3s1qGdSBBGaOA_1Q\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/M-Y61tf6shA/hqdefault.jpg\"]]]],[null,\"Roll. Build. Conquer!\\u003cbr\\u003eWelcome to Dicero, a fast-paced Casual Roguelite adventure where every battle starts with a roll. It’s time to stop thinking and start rolling!\\u003cbr\\u003e\\u003cbr\\u003eGame Features\\u003cbr\\u003e· Roll \\u0026amp; Conquer – Roll your dice to unleash powerful skills. Simple strategy, total domination!\\u003cbr\\u003e· Build Your Hero – Unlock hundreds of unique skills and gear. Create your own builds to crush enemies.\\u003cbr\\u003e· Endless Action – No two runs are the same. Explore infinite skill combos in every challenge.\\u003cbr\\u003e· Epic Pixel Combat – Bold effects, clean visuals, and big impact.\\u003cbr\\u003e\\u003cbr\\u003eWhy You\\u0026#39;ll Love Dicero\\u003cbr\\u003e· Easy to Learn – Jump into the action instantly. No complicated tutorials!\\u003cbr\\u003e· Instant Power – Upgrade skills and gear to see your hero grow stronger by the second.\\u003cbr\\u003e· Quick Fun – An addictive strategy experience perfect for short sessions.\\u003cbr\\u003e\\u003cbr\\u003eDownload Now! Start your epic Dice journey today!\\u003cbr\\u003e\\u003cbr\\u003eFaceBook:@Dicero\\u003cbr\\u003eContact Us: dicero-feedback@habbymail.com\"],\"Habby\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/SxSruJUOFRSicAGdUL8iGwrD5-DLhJI0aq0_8thnaZ1XJ0a7r5vjcp_P5KTXocD7U3b8nO94VrL_l6YnhrzXFLg\"],null,[77,122,177,255]],null,[\"Rated for 7+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/1SrNtAwg9PFOhgMJPXehacRTeQNhHhG12Pj1zACHNVmfRfEZA3_oOEmLvRNsmYGeGHpas7sCwyR3y8OT\"]],[null,\"Mild Violence\"],[null,\"In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/JTT-ImEkrbWzIL7w0fP8fQhVmpexdfh7u0P59PJtyJywmQBVolJjunMal6B5dUM6uiFiKnmtHtBbVvcWBMU\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"PHP\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.bailing.lark.roll.dev\\u0026rdid\\u003dcom.bailing.lark.roll.dev\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"₱64.00 - ₱6,450.00 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"ata.squid.pimd\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/ir_b1KvUy5wAI