odasaga\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.king.candycrushsodasaga\"]],[\"qgJzGnEIIUoTCNqzm7HHkJcDFYw8gwMdnLojJPoBFwoVCJikvuzG7KKKQxIJCgVlbi1VUxAAugI9CiEKG2NvbS5raW5nLmNhbmR5Y3J1c2hzb2Rhc2FnYRABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,\"d6LyO7n8qco\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:d6LyO7n8qco?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:d6LyO7n8qco\",null,null,null,null,\"AXH1ezm0wC7osbU77M3onxk8sKaPEVR98k3hEMHpmuN5kHlXBJGtXOZrNmpdHKEtubPjxsrOkftwLg_REK90YePqoPfeSfD80_pgOUSdNV1nhcIkae-SqcdJLrjphMOz2-4SlcPUN0n3qZRbHjM7azV41lmeQocytes8PnqcClNDluJzJcp6TIZKp0dubieL63xa4Fog4SaorLHRLEeyBl7ZB9yewjqz_5kdEXJZ5p1JmQ5SsDQ2-CCe_jur8Ug5Xi8JYGkAIaNEZum9B8L5xADQ1MwEVxLpQQJrQgzhqNI1lZKbAQ\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/d6LyO7n8qco/hqdefault.jpg\"]]]],[null,\"Candy Crush Soda Saga is a bright and cheerful puzzle game full of fizzy fun, sweet candy, and satisfying match 3 moments. Whether you want a quick break or a proper pastime, this sweet game is easy to enjoy anytime.\\u003cbr\\u003e\\u003cbr\\u003e🍭 Why it stands out?\\u003cbr\\u003eCandy Crush Soda Saga adds a bubbly twist to classic matching games with creative level goals, lively visuals, and fun modes like Bubblegum Pop and Gummy Dragons. Each board feels fresh, light, and rewarding.\\u003cbr\\u003e\\u003cbr\\u003e💥 Match, blast, and keep the fun going!\\u003cbr\\u003ePlay through thousands of matching levels packed with sweet surprises\\u003cbr\\u003eEnjoy match 3 puzzles with playful twists and soda-filled challenges\\u003cbr\\u003eUse boosters to blast blockers and clear tricky boards\\u003cbr\\u003eDiscover Bubblegum Pop, soda-filled boards, and sticky jelly levels that change how you play.\\u003cbr\\u003e\\u003cbr\\u003e✈️ Play your way!\\u003cbr\\u003eEnjoy a relaxing session offline or go online for events, rewards, and games with friends. Whether you are on the go or taking a break at home, this offline game fits right into your day. It is a cheerful puzzle game that turns any moment into a fun pastime.\\u003cbr\\u003e\\u003cbr\\u003e🍬 Sweet features in every level!\\u003cbr\\u003eBig cascades, bright effects, and clever obstacles make every pop soda moment satisfying. Match candies, clear the board, and enjoy fresh twists that keep the action lively. Fans of matching games will love the mix of fun challenges, colorful worlds, and easy pick-up-and-play excitement.\\u003cbr\\u003e\\u003cbr\\u003e🍩 Daily rewards and more to explore!\\u003cbr\\u003eThere is always something new waiting. Collect daily rewards, join special events, and take on extra challenges with players\\u0026#39; competition. Play offline for a quick session or stay longer for more match 3 action.\\u003cbr\\u003e\\u003cbr\\u003e🎯 Frequently asked questions\\u003cbr\\u003eWhat is Candy Crush Soda Saga?\\u003cbr\\u003eCandy Crush Soda Saga is a casual puzzle game packed with colorful match 3 challenges, sweet boosters, and unique game modes.\\u003cbr\\u003e\\u003cbr\\u003eCan I play without wifi?\\u003cbr\\u003eYes. You can enjoy many levels offline, making it a great offline game for travel, breaks, or everyday play.\\u003cbr\\u003e\\u003cbr\\u003eWhat makes it different?\\u003cbr\\u003eCreative level types, cookie blockers, soda-filled boards, and playful matching fun make every level feel fresh.\\u003cbr\\u003eStart matching, enjoy the fizz, and dive into a world of candy-filled fun.\\u003cbr\\u003e\\u003cbr\\u003eCandy Crush Soda Saga is free to play but optional in-game items such as extra moves or lives require payment. You can turn off the payment feature by disabling in-app purchases in your device’s settings.\\u003cbr\\u003e\\u003cbr\\u003eBy downloading Candy Crush Soda Saga you agree to our terms of service which can be found at https://king.com/termsAndConditions\\u003cbr\\u003e\\u003cbr\\u003eDo not sell my data: King shares your personal information with advertising partners to personalize ads. Learn more at https://king.com/privacyPolicy. If you wish to exercise your Do Not Sell My Data rights, you can do so by contacting us via the in-game help center or by going to https://soporto.king.com/contact\"],\"King\",\"500,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/P5NA4lAVj-AlDV7K_07VbqDYXVjwa174tdDMPPoqbFWF3726ETv-FmVZNGUMOUSDEBWRGpJgdQFgJxW-Tqv1RA\"],null,[43,48,104,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Users Interact, Shares Location, In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"PHP\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.king.candycrushsodasaga\\u0026rdid\\u003dcom.king.candycrushsodasaga\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"₱6.00 - ₱1,600.00 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.tapblaze.pizzabus