\",[\"4.2\",4.191781],\"Casual\",null,null,[null,[[0,\"PHP\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.gps.draw.flag.coloring.games\\u0026rdid\\u003dcom.gps.draw.flag.coloring.games\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.gps.draw.flag.coloring.games\"]],[\"qgJwGm4INUoTCNqzm7HHkJcDFYw8gwMdnLojJPoBDwoNCAASCQoFZW4tVVMQALoCQgomCiBjb20uZ3BzLmRyYXcuZmxhZy5jb2xvcmluZy5nYW1lcxABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"Introducing a new world of coloring ASMR, a relaxing and fun place where you can enjoy coloring. If you\\u0026#39;re looking for satisfying games, where every stroke makes your drawing pretty, then this ASMR coloring game is the complete coloring experience to relax and unwind while having fun. Each stroke slowly turns your sketch into a masterpiece.\\u003cbr\\u003e\\u003cbr\\u003eEvery pencil color gives you the thrill of coloring fun, where relaxation meets creativity. Enjoy peaceful ASMR sounds and soothing visuals while you\\u0026#39;re coloring. Show your creativity on a simple page and draw fun, colorful things, and enjoy the art of coloring.\\u003cbr\\u003e\\u003cbr\\u003eUnlock VIP levels, explore unique drawings, and color with your marker. Play surprise levels to make your creative journey more stylish. In some levels, an erase tool is available that will help you while drawing. Enhance your artwork with spray to create a neater, more stylish drawing.\\u003cbr\\u003e\\u003cbr\\u003eSatisfying Coloring Quality Features:\\u003cbr\\u003e\\u003cbr\\u003eSmooth and easy controls, just tap to fill.\\u003cbr\\u003eRelaxing ASMR sounds with every stroke.\\u003cbr\\u003eMultiple coloring pages to show your creativity.\\u003cbr\\u003eJust tap, color, and relax, no extra skills needed.\"],\"Mad1 Games\",\"50,000,000+\