leusercontent.com/jpGTgaDrj1WV7LaGdKzqUMylkU4u5qxWKKkmj61LePKR_5lm2N6_Q_fJRbIsbYLaCYsTBAIxu2SrqvdEdaB4ulU\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/2eLxnwxd8o3mYKHhrm99jefiu3d2JJIfKz85yrmMkKQxD8Dty_2XiOCNqw6YWqtG4RuZt5w-NrleaH4DCivtZwY\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/jJQphppssVB1lOQa94cCiUgrehxvbj1pXTDfhxHF0HXxeZ1aO-z9cRTYQgPL2jV7w0iFVK7QOJ4m-GMwLPv-Ow\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/NopL55pnY3IxQqWTAqVu1_efE1H4Tuxf6Vp3vq15VKZBMY1kVtV-zD5g_kOMJmXgV6DfjmLF0zWjyPJTjQ5dVw\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/zW90pIa1KgweOUG5U4t3uFUfw7lCzoIVbWedYyR6dOxkABQlETsjoWtjMB1WV3fsS-QcIsex-Od4ZzkTyOcI\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/hhgrERBPPYqj3x30PiUBietWPuXAFtikqefkwSAeyQZPvHkyySXwO4F1nd0n9BrEXlj8tV3R4_9eASY9dcUZP8g\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/yA-wuJ4R_rpGxHiytHne4T09IZITesfrWGaWQwVCuBlBWHk5MOImrE1wSiko26wLuWg1iqzpDdNh-Lt7ZjFuUg\"]]],\"My Talking Tom 2: Pet Game\",[\"4.3\",4.2683344],\"Casual\",null,null,[null,[[0,\"PHP\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.outfit7.mytalkingtom2\\u0026rdid\\u003dcom.outfit7.mytalkingtom2\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.outfit7.mytalkingtom2\"]],[\"qgJpGmcICkoTCNqzm7HHkJcDFYw8gwMdnLojJPoBDwoNCAASCQoFZW4tVVMQALoCOwofChljb20ub3V0Zml0Ny5teXRhbGtpbmd0b20yEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],[[[null,null,\"hKMuTQyhehI\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:hKMuTQyhehI?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:hKMuTQyhehI\",null,null,null,null,\"AXH1ezkFWocj-uOUfqp_cxEU-7KDHjIMyEsbmWrK9oSIk68jPwC0YlTRbEZUvVFTjweMcHby18awdYLV1ttDUhU7ALJ4ndkfYOiSyOpfWLnkltCXM68AnTBn2ZBxFyRoryk8RAN4bB-YWtGlFefg_jKYfmvpDIBmTkSkOP7jzsmQp6Y13sSZuy2n9A20O16u6ZkFB7oNywGmrhdAiVzbGzlj_PEs4HrtU85j-nFoCDNIIsXH6noTErZQ4bUv2PNjHgCfdtC6ANCU3rysjoujZ4O1nClYoMM9RGibBZGyhY4enQFFFw\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/hKMuTQyhehI/hqdefault.jpg\"]]]],[null,\"My Talking Tom 2 is a \\u003cb\\u003evirtual pet game\\u003c/b\\u003e where you care for Tom, play offline mini-games, and explore fun worlds. Feed him, customise his look, collect pets, and enjoy his iconic talk-back reactions.\\u003cbr\\u003e\\u003cbr\\u003e\\u003ch3\\u003e🛁 Virtual Pet Care\\u003c/h3\\u003e \\u003cbr\\u003eLook after Tom by feeding him, making sure he gets enough sleep, and keeping him happy. Watch him react to what you do — he’ll repeat what you say in his funny voice, laugh at your jokes, and show expressive emotions. \\u003cbr\\u003e\\u003cbr\\u003eHelp with daily routines like brushing teeth, bathing, and bathroom visits, then jump back into play whenever you like.\\u003cbr\\u003e\\u003cbr\\u003e\\u003ch3\\u003e✈️ Explore Worlds by Plane\\u003c/h3\\u003e \\u003cbr\\u003eFly Tom’s plane to visit colourful destinations, each with surprises and collectibles: \\u003cbr\\u003e✓ Candy Kingdom\\u003cbr\\u003e✓ Pirate Island\\u003cbr\\u003e✓ Underwater Home\\u003cbr\\u003e✓ Adventure Beach\\u003cbr\\u003e✓ Magic Forest\\u003cbr\\u003e✓ Cyber City\\u003cbr\\u003e✓ Dragon Kingdom\\u003cbr\\u003e✓ Alien Planet\\u003cbr\\u003e\\u003cbr\\u003e\\u003ch3\\u003e 🎮 Offline Mini-Games\\u003c/h3\\u003e \\u003cbr\\u003ePlay offline mini-games to earn coins and unlock rewards: \\u003cbr\\u003e✓ Space Trails\\u003cbr\\u003e✓ Sky Race\\u003cbr\\u003e✓ Dunk-a-Pet\\u003cbr\\u003e✓ Build Your Plane\\u003cbr\\u003e\\u003cbr\\u003e\\u003ch3\\u003e🎨 Customisation and Home Decoration\\u003c/h3\\u003e \\u003cbr\\u003eChoose from hundreds of outfits and fun styles, change Tom’s look, and decorate his home with items you unlock as you play. \\u003cbr\\u003e\\u003cbr\\u003e\\u003ch3\\u003e🐾 Pets and Skills\\u003c/h3\\u003e \\u003cbr\\u003eTom has pet companions that join your adventures. Care for them, play together, and watch their interactions.\\u003cbr\\u003eTeach Tom new skills like playing drums, shooting hoops, and boxing to unlock fresh animations and moments. \\u003cbr\\u003e\\u003cbr\\u003e\\u003ch3\\u003e💬 Talk-Back Reactions\\u003c/h3\\u003e \\u003cbr\\u003eTom’s iconic feature returns — he repeats what you say and reacts when you poke or chat to him, keeping every visit lively. \\u003cbr\\u003e\\u003cbr\\u003e\\u003ch3\\u003e✅ Play Anywhere\\u003c/h3\\u003e \\u003cbr\\u003eNo Wi-Fi? No problem. Play offline after installation — great for travel and on-the-go sessions. \\u003cbr\\u003e\\u003cbr\\u003e\\u003ch3\\u003eTechnical Information\\u003c/h3\\u003e \\u003cbr\\u003eFree to download with optional in-app purchases. Progress saves automatically. Regular updates add seasonal content, outfits, and events. Supports multiple languages, including English, Spanish, Portuguese, French, German, Russian, Turkish, and Arabic. \\u003cbr\\u003e\\u003cbr\\u003e\\u003cb\\u003eThis app contains:\\u003c/b\\u003e\\u003cbr\\u003e- Promotion of Outfit7\\u0026#39;s products and advertising;\\u003cbr\\u003e- Links that direct customers to Outfit7’s websites and other apps;\\u003cbr\\u003e- Personalisation of content to encourage users to play the app again;\\u003cbr\\u003e- The option to make in-app purchases;\\u003cbr\\u003e- Items to purchase (available at different prices) using virtual currency, depending on the player’s progress;\\u003cbr\\u003e- Alternative options to access all functionalities of the app without making any in-app purchases using real money.\\u003cbr\\u003e- Some features may be subject to different pricing and availability.\\u003cbr\\u003eTerms of use: https://talkingtomandfriends.com/eula/en/\\u003cbr\\u003ePrivacy policy for games: https://talkingtomandfriends.com/privacy-policy-games/en\\u003cbr\\u003eCustomer support: support@outfit7.com\\u003cbr\\u003e\\u003cbr\\u003e\\u003ch3\\u003eFrom Outfit7\\u003c/h3\\u003e \\u003cbr\\u003eFrom the creators of My Talking Angela 2, My Talking Tom Friends, and Talking Tom Gold Run.\"],\"Outfit7 Limited\",\"1,000,000,000+\",null,null,null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/EGCs1XkXjbuib_Yv2XhwjoMcABHIcT6BS1eQw5Xt2392X5pAQWrUvrpRG6EUEWRGR-LjlNf5f5rneIIBF9kauA\"],null,[74,214,233,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"PHP\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.outfit7.mytalkingtom2\\u0026rdid\\u003dcom.outfit7.mytalkingtom2\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"₱47.89 - ₱12,957.49 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.outfit7.mytalkingangela2\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/DIaHzWvj4UvW-zb7S9TtGQZv4GpxPo2XHFYTtEdDCOyt_31nAu3vQ7wXt1Yd