awgbWjZllnlEyLdh1NwNIomqfZICIgLyzTGG75aWUjmgj49y1oylw\"]],[null,2,[995,560],[null,null,\"https://play-lh.googleusercontent.com/xCJK4D2pSyXeH6c83dzoWluxyR9-n_njYlQgp6ALuTgaeuFsJZJx3ygE93g33RWcfWzeMv7pXEx0V8Yk-1CC38g\"]],[null,2,[995,559],[null,null,\"https://play-lh.googleusercontent.com/PZhgwM6RajmRKy9GJ81sLHDMbKYGvWEFkfpYnfeqqUTGvCPCI6QRLEspDzLj6LG1CPx1tpR-ttYzQUs0TgFQzg\"]],[null,2,[995,560],[null,null,\"https://play-lh.googleusercontent.com/063u84cLPCPjH2XvzZ12PzUOho143s6XY1FboQuTxzmSgIxjBMGpHxr8KlnKt2O2ziQfQRpxf8Rcm0CbAl3p\"]]],\"Plug Runner\",[\"3.3\",3.3166666],\"Casual\",null,null,[null,[[0,\"PHP\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.plug.runner.battery.mates\\u0026rdid\\u003dcom.plug.runner.battery.mates\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.plug.runner.battery.mates\"]],[\"qgJtGmsINkoTCNqzm7HHkJcDFYw8gwMdnLojJPoBDwoNCAASCQoFZW4tR0IQALoCPwojCh1jb20ucGx1Zy5ydW5uZXIuYmF0dGVyeS5tYXRlcxABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"⚡ Get ready for the most electrifying race of your life! ⚡\\u003cbr\\u003eWelcome to Plug Runner, the ultimate racing game where energy is everything! Take control of your plug character, charge up, and dash your way to victory in this highly addictive and fun competition! 🏃\\u200d♂️💨\\u003cbr\\u003e\\u003cbr\\u003e🔋 COLLECT \\u0026amp; GROW HUGE!\\u003cbr\\u003eRun across the track and collect batteries that match your color. The more you collect, the bigger and stronger you become! \\u003cbr\\u003e\\u003cbr\\u003e🚤 POWER UP VEHICLES \\u0026amp; OVERCOME OBSTACLES!\\u003cbr\\u003eYou\\u0026#39;re not just running—you are the power source! Use your energy to plug into awesome vehicles like cars, speedboats, and motorcycles, or use your raw power to smash through massive brick walls! 🧱🏍️\\u003cbr\\u003eCareful though! Powering these obstacles drains your energy and makes you shrink. You\\u0026#39;ll need to keep collecting batteries to stay in the race!\\u003cbr\\u003e\\u003cbr\\u003e💥 SMASH YOUR RIVALS!\\u003cbr\\u003eSize matters in Plug Runner! If you are bigger and stronger than your opponents, bump into them to knock them down! 🥊 They will stay on the ground for a few seconds and drop special Black Batteries that anyone can collect for a massive power boost. Show no mercy!\\u003cbr\\u003e\\u003cbr\\u003e🏁 BE THE FIRST TO FINISH!\\u003cbr\\u003eIt’s a thrilling dash to the end. Power through the obstacles, manage your energy wisely, outsmart your rivals, and be the first to cross the finish line to claim the crown! 👑\\u003cbr\\u003e\\u003cbr\\u003e✨ GAME FEATURES:\\u003cbr\\u003e🎮 Simple \\u0026amp; Addictive: Easy one-finger swipe controls, perfect for everyone!\\u003cbr\\u003e🎨 Vibrant 3D Graphics: Colorful paths, satisfying animations, and dynamic gameplay.\\u003cbr\\u003e🚗 Epic Power-Ups: Steer boats, ride bikes, and break walls!\\u003cbr\\u003e🥊 Fun Combat Mechanic: Knock down smaller players and steal their energy.\\u003cbr\\u003e🏆 Endless Racing Fun: Multiple levels with different challenges to test your skills!\\u003cbr\\u003e\\u003cbr\\u003eAre you fully charged and ready to run? ⚡ Download Plug Runner NOW and electrify the competition! 🔌🏁\"],\"AbbaYosua.Design\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/8Mp8IMSw2z47-vf8UwqDBzzbgRXX5TzEg_hLcrjnioOWWAn83F73IYhhldW_VO8PfKlvM2-pHrOlnZm7UWRX\"],null,[222,200,87,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,[null,\"Suitable for all age groups. Some violence in a comical or fantasy context is acceptable. Bad language is not permitted.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"PHP\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.plug.runner.battery.mates\\u0026rdid\\u003dcom.plug.runner.battery.mates\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.pronetis.ironball2\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/a8zcuqCydhNbHi-lsqas4V3G93TRcglFCFmS65IH7bUcaPx_o8bpTfDX0jTjFiVDS2Jhsd9VKJr85FQiEG-gumk\"],null,[47,219,255,255],null,null,null,2],[[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/acdsh0eJUQaIs0Se9Ai-7ZbL8WLoG287qX1n_gLAQSZWQgYlgtOvniDzjeF3qAB-BK3uJu1xEc0EZs5fSg0L\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/ZmHS8kj8z-33amNNB8gdhgYoRBPhHA6J5wlnJI6vc7HRRus_34BK3MtQYWfes7Vac9Swjq55zWN2tJ9xWhcZb30\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/VcB5ensrrxjxzDsiS_THAAE0Njm9lWDE_EVkjV4r-YrIl70dI8jOikBOeUB67iiiWVQ2-d6mQL4LEA1jrfNu0Q8\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/D84zaV3Eyt-Kfq4JQMVltROQj7QRoPGDzKOr0dtkALUuSTxchrg6n6fYKxAgm0gmMdR7U09GO4k63njy3M49djs\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/gyJL-BbK2JqM7zewOqbpbRpwBVPPZuf79GEBvUmE7aYqZktgYBFpDDKpCCaM2JpBaTHVzUY-y7CbopJji74t7w\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/7SLQoOAwY-xwMf90ROh2-EoVnpAJBye01NUCVihhVSSiBT1k-VoErN0ReNcUkFLFCyn3aH60Bn6iSa5jrwPacA\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/AfMZ5H14FFn5nftGvuXuJwomfeZQ6J4Q6Qe87DDIdcedh2dlVECvsuRJhxabMCwixt_7yGmQdzNUTHL5GQgnJ7Y\"]]],\"Going Balls\",[\"4.1\",4.094818],\"Casual\",null,null,[null,[[0,\"PHP\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.pronetis.ironball2\\u0026rdid\\u003dcom.pronetis.ironball2\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.pronetis.ironball2\"]],[\"qgJmGmQIN0oTCNqzm7HHkJcDFYw8gwMdnLojJPoBDwoNCAASCQoFZW4tVVMQALoCOAocChZjb20ucHJvbmV0aXMuaXJvbmJhbGwyEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"Going Balls: The Ultimate Speed and Balance Challenge! 🚀\\u003cbr\\u003e\\u003cbr\\u003eAre you ready for a high-speed runner game that tests your reflexes and mastery of physics? Download Going Balls today and experience the most thrilling arcade adventure on mobile! Join millions of players worldwide in this addictive hyper-casual hit.\\u003cbr\\u003e\\u003cbr\\u003eWhat is Going Balls? ⚽️🏃\\u200d♂️\\u003cbr\\u003e\\u003cbr\\u003eGoing Balls is an exhilarating, fast-paced ball game where your main goal is to control a rolling ball and guide it safely to the finish line on increasingly difficult tracks. It’s the perfect blend of a precision puzzle game and a heart-pounding speed challenge.\\u003cbr\\u003e\\u003cbr\\u003eHow to Play:\\u003cbr\\u003eSwipe your screen to control the speed and direction of your ball. Master the art of balance as you navigate narrow paths, dodge unexpected obstacles (challenge!), and collect coins 💰 to unlock new balls and environments. \\u003cbr\\u003eThe simple controls hide a deep, skill-based arcade experience!\\u003cbr\\u003e\\u003cbr\\u003eKey Features: The Ultimate Rolling Adventure! 🚧\\u003cbr\\u003e\\u003cbr\\u003e* Dozens of Challenging Levels: Race through diverse worlds, from sky-high platforms to treacherous industrial zones. Each level offers a unique challenge that will keep you coming back for more!\\u003cbr\\u003e* Realistic Physics Engine: Feel the thrill of true physics-based gameplay. Every roll, jump, and acceleration feels incredibly smooth and responsive. Balance is key to surviving!\\u003cbr\\u003e* Customize Your Ball: Collect thousands of coins and unlock a massive collection of cool, colorful, and unique balls. Personalize your runner experience! 🎨\\u003cbr\\u003e* Intuitive One-Finger Control: The ultimate pick-up-and-play hyper-casual design. Simple to learn, but incredibly hard to master - perfect for quick bursts of fun or long endless sessions.\\u003cbr\\u003e* Tons of Obstacles: Avoid swinging hammers, tricky ramps, massive wrecking balls, and unexpected gaps. Your speed and precision are your only allies!\\u003cbr\\u003e\\u003cbr\\u003eWhy You\\u0026#39;ll Love Going Balls! 🎉\\u003cbr\\u003e\\u003cbr\\u003eGoing Balls is more than just a runner - it\\u0026#39;s an immensely satisfying experience. The rush of barely making a jump, the joy of collecting a huge stack of coins, and the feeling of accomplishment after conquering a nearly impossible challenge makes this game highly addictive.\\u003cbr\\u003e\\u003cbr\\u003eWe’ve optimized the gameplay for pure fun!\\u003cbr\\u003e* Instant Thrills: Short, intense levels make it ideal for quick breaks.\\u003cbr\\u003eSkill Progression: You can feel yourself getting better at speed and balance with every attempt.\\u003cbr\\u003e* High Replayability: The pursuit of the perfect, flawless run is endless!\\u003cbr\\u003e\\u003cbr\\u003eDownload Now - Totally FREE! 💯\\u003cbr\\u003e\\u003cbr\\u003eReady to roll? Get the full arcade experience without spending a dime! \\u003cbr\\u003eGoing Balls is totally free to download and play. Experience the ultimate physics-based challenge today!\\u003cbr\\u003e\\u003cbr\\u003eDownload Going Balls and start your speed adventure now! ⬇️\"],\"Supersonic Studios LTD\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/hLdbXJX2Ve8w6pvnmCd1KwgBQtyTDiAgSgzygdixQZHdPFen4zSa681b9dbjTRIwJEWMGd5vcX0PWH9g2YT3_w\"],null,[190,199,216,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"PHP\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.pronetis.ironball2\\u0026rdid\\u003dcom.pronetis.ironball2\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"₱47.00 - ₱2,000.00 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.tt.mini.girly.games\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/1fhLJ8m3YfcWK2-Yy1AaJIx9Z37jiS-b3vbI