[[0,\"PHP\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dgridplus.busjam.carpuzzle\\u0026rdid\\u003dgridplus.busjam.carpuzzle\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dgridplus.busjam.carpuzzle\"]],[\"qgJpGmcIBUoTCNqzm7HHkJcDFYw8gwMdnLojJPoBDwoNCAASCQoFZW4tVVMQALoCOwofChlncmlkcGx1cy5idXNqYW0uY2FycHV6emxlEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"Bus Fever Party – The ultimate bus traffic escape challenge! 🚌🅿️\\u003cbr\\u003e\\u003cbr\\u003eThe parking lot is gridlocked! A massive parking jam has blocked the exits, and the traffic fever is heating up. Can you organize the chaos? If you are looking for free bus games to test your brain, you are in the right place. Experience the thrill of solving a complex parking puzzle, help the passengers, and guide every car to safety! 🧩\\u003cbr\\u003e\\u003cbr\\u003e🎮 Master the Bus Parking Jams\\u003cbr\\u003eYour mission is to beat the traffic fever and get every bus out.\\u003cbr\\u003e🚦 Tap to Move: Strategically shift vehicles in the crowded area to create a clear path.\\u003cbr\\u003e🚌 Match \\u0026amp; Sort: Get the bus out of the jam and perfectly match waiting passengers to the bus of the exact same color.\\u003cbr\\u003e🔄 Solve the Puzzle: Navigate through tight spaces and tricky obstacles to clear the parking lot jam. 🧠\\u003cbr\\u003e\\u003cbr\\u003e🌟 Why Play Bus Fever Party?\\u003cbr\\u003e🅿️ Addictive Car Parking Action: Cure your traffic fever with intense, brain-training puzzle levels.\\u003cbr\\u003e🚗 Thrilling Simulator Vibe: Enjoy the strategic mechanics of a fun bus and car simulator wrapped into one free bus game!\\u003cbr\\u003e🏆 Become the Parking Jam Master: Strategically clear the lot, express crowds, and prove you are the true parking jam master!\\u003cbr\\u003e🚀 Powerful Boosters: Stuck in a heavy car jam? Use helpful power-ups to clear the way and win this free bus game! ⚡\\u003cbr\\u003e\\u003cbr\\u003e🏁 Conquer the Traffic Fever!\\u003cbr\\u003eWhether you love the realistic feel of a car simulator, or just want to relax with free bus games, you\\u0026#39;ll find endless fun here. Get the bus out, solve the traffic fever, and claim your victory!\\u003cbr\\u003e\\u003cbr\\u003eDownload Bus Fever Party now, solve the parking puzzles, and become the shinning parking jam master! 🚌🧩\\u003cbr\\u003e\\u003cbr\\u003eCONTACT\\u003cbr\\u003e📧 lumigamesteam@outlook.com\\u003cbr\\u003e📞 +447871573653\\u003cbr\\u003ePrivacy Policy: https://sites.google.com/view/pp-of-lumi-games/home\\u003cbr\\u003eEULA: https://sites.google.com/view/eula-of-lumi-games/home\"],\"Lumi Games\",\"5,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/No9bLxZkFM_V3zOjgBH_WfmYBfydxQtdpEzBAlMWmJxrEOo_y9G-6Jw1GpRvKW6Cedrc64NgFC_Fe8N658HH\"],null,[111,202,254,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,[null,\"Suitable for all age groups. Some violence in a comical or fantasy context is acceptable. Bad language is not permitted.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"PHP\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dgridplus.busjam.carpuzzle\\u0026rdid\\u003dgridplus.busjam.carpuzzle\\u0026feature\\u003dmd\\u0026offerId\"]