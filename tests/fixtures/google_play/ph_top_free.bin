\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/zmRqT1JmfFFMRVzjHC65AdbJ27TXEpdlyqPVktT1w-F9kSSYUusIbI9owYZgmd8-5eIwtIhtvyFu7S3qEE2v\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/tsXkJ0bhTZBMwQMfl_eUHdIPDZyQERnqi_F8I_445uBQB_t4PZkQP4gs9bIa2Cghy-eXhcRRtnZeBlD9mBwoUTY\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/lxin4k6rqvPKE8g_3ApmtdRwcKSVaMlc96NNTNFWfpVw-NSb1iOZvI7cP8l2gTRhwmIRov4ZPItyvNHJ5lOsxA\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/8MSr5L8hzQvY8lSpQ1-zG6BVXDsxQ45JDolm3kFBVn-9c1_sh1TOgX1RyF6ejVkACr7NyA4l-wCwawUsd5Gie2U\"]]],\"Tasty Travels: Merge Game\",[\"4.6\",4.6263347],\"Casual\",null,null,[null,[[0,\"PHP\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.fatmerge.global\\u0026rdid\\u003dcom.fatmerge.global\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.fatmerge.global\"]],[\"qgJjGmEIE0oTCNqzm7HHkJcDFYw8gwMdnLojJPoBDwoNCAASCQoFZW4tVVMQALoCNQoZChNjb20uZmF0bWVyZ2UuZ2xvYmFsEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"Tasty Travels\\u003cbr\\u003e\\u003cbr\\u003e\\u0026quot;Open your phone and join us on a journey around the culinary world!\\u0026quot;\\u003cbr\\u003eIn \\u0026quot;Tasty Travels\\u0026quot;, you get to travel the world while experiencing local cuisines, learning to make various specialty dishes, and sharing with friends from all corners of the globe! The most exciting part? You can combine two identical ingredients to create new exquisite dishes, reveling in the joy of cooking!\\u003cbr\\u003e\\u003cbr\\u003eUnique Gameplay: Merge and Explore\\u003cbr\\u003eInnovative Merging: Discover and merge identical ingredients during your journey, exploring new culinary secrets and enjoying the unique fun of merging!\\u003cbr\\u003eCulinary Map: Experience over 500 types of local cuisines, each with its unique method of preparation and story!\\u003cbr\\u003eQuest Challenges: Assist other tourists with their food requests to unlock more recipes and travel destinations!\\u003cbr\\u003e\\u003cbr\\u003eSocial Interaction and Sharing\\u003cbr\\u003eGlobal Food Community: Meet friends from around the world in \\u0026quot;Tasty Travels\\u0026quot;, share your culinary adventures, and earn their admiration!\\u003cbr\\u003eRecipe Sharing: Exchange recipes, jointly appreciate the beauty of food, making your travel more colorful and diverse!\\u003cbr\\u003e\\u003cbr\\u003eTravel Destinations\\u003cbr\\u003eUnlock New Locations: Collect coins to unlock new travel destinations!\\u003cbr\\u003eWorld\\u0026#39;s Famous Culinary Cities: Explore and experience dozens of the world\\u0026#39;s famous culinary cities, each with its unique flavor and culture!\"],\"Century Games PTE. LTD.\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/W6HK6kBNU5u3L-SCl64Zmnt2jM3Dd-_95DtfhSc0eMN8o-r54ZzVXzm6t8LRLXbjm5JXhr3vxRYTkmvdLYQmdRI\"],null,[61,131,97,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"PHP\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.fatmerge.glo