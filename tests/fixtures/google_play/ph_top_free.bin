3d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.Garawell.BridgeRace\"]],[\"qgJnGmUISUoTCNqzm7HHkJcDFYw8gwMdnLojJPoBDwoNCAASCQoFZW4tVVMQALoCOQodChdjb20uR2FyYXdlbGwuQnJpZGdlUmFjZRABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,\"7L0riMWzEKg\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:7L0riMWzEKg?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:7L0riMWzEKg\",null,null,null,null,\"AXH1ezmZvZT_ty3lgmKrGuVaGt3v27-deiJ4bCAqq1o9BIl2CnqgyUIy37Fl9pTRzOax941K3EeWaf8jkIspf5OOh13iuX5mifzXpVx88VednJoZMl4zbkTl0UhjJ3d82-Pi4_AjT3fR6OO21eW0_CibXEBnQHSLeTFbydHwa0sQEmw32-M5YPpT3wfJkXL5iQ-OH-EwFH4Jj2KOEE_-fCITdlWbH6fm-Y3C_R79U3dRKFfCK0Z3YyLGoSAZV6ux7Uk35oUhrEe4Z_VVTpz8pNoajU4g9A7gtHEfySjsOzbQBcLGZg\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/7L0riMWzEKg/hqdefault.jpg\"]]]],[null,\"Bridge Race is a fun and colorful racing game where you collect blocks, build bridges, and compete against rivals to reach the finish first.\\u003cbr\\u003e\\u003cbr\\u003eRun through each level, pick up blocks of your own color, and use them to build bridges across platforms, gaps, and obstacles. Choose the best path, build smart shortcuts, and stay ahead of the competition.\\u003cbr\\u003e\\u003cbr\\u003eWatch out for other racers! Rivals can steal your blocks, slow you down, and turn the race around in seconds. Keep your stack safe, cross bridges faster, and push toward the final stage.\\u003cbr\\u003e\\u003cbr\\u003eExplore colorful levels filled with fun mechanics like sliders, trampolines, zip-lines, ladders, elevators, and more. Each race brings a new challenge as you stack blocks, cross bridges, and race for victory.\\u003cbr\\u003e\\u003cbr\\u003eIf you enjoy runner games, racing games, stacking games, and bridge-building challenges, Bridge Race is easy to play and hard to stop.\\u003cbr\\u003e\\u003cbr\\u003eCollect, build, race, and win!\"],\"Supersonic Studios LTD\",\"500,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/UzdbzpkI4eaRzg6gF_jKZu95zR5JEeSapVDg76AggG6DtzbBfbZLRarjgMQen9SmeOs5lKCESPbdE4goGNjn8Ts\"],null,[41,213,255,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"PHP\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.Garawell.BridgeRace\\u0026rdid\\u003dcom.Garawell.BridgeRace\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"₱58.00 - ₱6,850.00 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"ae.goragaming.playoff.blocks.game.make.earn.money.rewarded\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/1c3qLSG7RCYDwMMGW2RIaGVQiVrfNmvjWqjW2ldw9Z8sFa08UvstMK0DBX7g4ohgB1ixo7zQHu4jQmQGeEr_6A\"],null,[221,15,15,255],null,null,null,2],[[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/Wc3hYZ3X0BeJNX70XX1kIgnT2X2lnQ0pz3JjX2BfoihATWIoL1RDceoWnbfeSMYh3QggjrT4iuqeBn