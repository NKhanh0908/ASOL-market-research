,2,[2048,1280],[null,null,\"https://play-lh.googleusercontent.com/Vb2heLeYl_vd-Cu5NeIEl6zgf9huKpxm8nhSZZdomcZjv_uozv77e0jbgXJfNyCoYBG3ogIzk_CFxHJTQIdq8Sk\"]],[null,2,[2028,1280],[null,null,\"https://play-lh.googleusercontent.com/hFTwETm_2OLR-XyWgGeD390Wsf8IG49zfZ6zNrj8yaUHUWYroPPNobAxcJPAAnFDz_y3cuazi6JjppDR0pgA3Gs\"]],[null,2,[2028,1280],[null,null,\"https://play-lh.googleusercontent.com/yTWaLuVgHiXrwlQwVTm7tmSAoE7D1SlN_PrU_OD6eCgy-T2DtYjBcqzCPtKHq7FNtV5VsQRe7UXrSIDU3a8urW4\"]],[null,2,[2028,1280],[null,null,\"https://play-lh.googleusercontent.com/3AiUE7X64QX10VFpeGxbfrXQ4oaTD65jS_RRTj-ezzrx8L7hzhS6h8-upM2aNX9vMuVttFSLbEBJJR59wdZTaA\"]],[null,2,[2028,1280],[null,null,\"https://play-lh.googleusercontent.com/Utfwb6TG4L27cOZOptOcmI-0VoZ7o4h-P4C9MIaDFncarQT2jpGM9b5MgDevTXQ_a0QweYX9q488I1yY9PsGmw\"]]],\"Farm Heroes Saga\",[\"4.8\",4.7622795],\"Casual\",null,null,[null,[[0,\"PHP\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.king.farmheroessaga\\u0026rdid\\u003dcom.king.farmheroessaga\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.king.farmheroessaga\"]],[\"qgJnGmUIRkoTCNqzm7HHkJcDFYw8gwMdnLojJPoBDwoNCAASCQoFZW4tVVMQALoCOQodChdjb20ua2luZy5mYXJtaGVyb2Vzc2FnYRABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,\"3YEUylysADQ\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:3YEUylysADQ?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:3YEUylysADQ\",null,null,null,null,\"AXH1ezkD-CHIr3xYJnvqoc7K-Y-yWgiARfviGvos6VXLDfe6YnJ1sjw1GHlnfa8Zr0BnPctfqRB0CNCk8mkUGBRjGJsFy28bYZi5HgxVjG6InlQHtSIUPGMKOhK8h2D85PG5zzc4IOfhEvsTQCXThwGpiZo-3Ram14W9Bwo5iQn1-ldIGKQt26vLI0tD9N8FsQMR4XT9hC_UHzywg76hCloTTvsLxXISWxUC-2aQSAzb_5bMAErknjvIXVIz5djmpUojvX0yo1SHqqkRdVL_ifVbB-UzZayLq10Ez-LYeLy-VUL_tg\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/3YEUylysADQ/hqdefault.jpg\"]]]],[null,\"Farm Heroes Saga, from the makers of Candy Crush Saga, Pet Rescue Saga, and Bubble Witch 3 Saga!\\u003cbr\\u003e\\u003cbr\\u003eFarming has never been so fun! Jump into a farmtastic adventure: match and collect the cute Cropsies across the farm to solve the match 3 puzzles! Go from puzzle to puzzle, matching fruit and plants, and level up to save the farm from Rancid the Raccoon. Join forces with the Farm Heroes to swap, match, and collect Cropsies. Ready to defend the Farm Lands?\\u003cbr\\u003e\\u003cbr\\u003eEnjoy the amazing farm and match 3 puzzle game from King! Match 3 or more Cropsies in a variety of game modes and puzzles. Unlock animals and blast boosters as you solve the different match 3 puzzles.\\u003cbr\\u003e\\u003cbr\\u003eExplore 1000’s of Levels\\u003cbr\\u003eAcres of luscious levels and puzzles await you! Every two weeks, discover new puzzles, for a match 3 game in constant evolution!\\u003cbr\\u003e\\u003cbr\\u003eHero Mode\\u003cbr\\u003eTime for a blast! Match as many Cropsies as you can before running out of moves. The higher the score, the more Magic Beans you gain to help you win the puzzle game.\\u003cbr\\u003e\\u003cbr\\u003eRancid Boss Battles\\u003cbr\\u003eDefend your farm! Solve challenging matching puzzles and, with the help of the farm animals, keep the thief away from your fruit and plants. \\u003cbr\\u003e\\u003cbr\\u003eJoin the Farm Club\\u003cbr\\u003eRecruit cute animals to help you solve puzzles! When matching is not enough anymore, call your animal friends to the rescue and blast powerful boosters to win the game.\\u003cbr\\u003e\\u003cbr\\u003ePlay with friends…\\u003cbr\\u003eTeam up with your friends to enhance your farming experience: chat, play with them and participate in events unique to Farm Teams. Who said the farming adventure had to be lonely?\\u003cbr\\u003e\\u003cbr\\u003e…or compete with friends!\\u003cbr\\u003eYou think your farm is the best? The game is on! Compete in the leaderboard or in the Tractor Dash event to prove you’re the best at match 3 puzzle games.\\u003cbr\\u003e\\u003cbr\\u003eStart matching and farming Cropsies today! But most importantly, have fun playing Farm Heroes Saga!\\u003cbr\\u003e\\u003cbr\\u003eVisit https://community.king.com/en or contact us in game by going to Settings \\u0026gt; Customer Care if you need help!\\u003cbr\\u003e\\u003cbr\\u003eFarm Heroes Saga is free to play but optional in-game items such as extra moves or lives require payment. You can turn off the payment feature by disabling in-app purchases in your device’s settings.\\u003cbr\\u003e\\u003cbr\\u003eBy downloading Farm Heroes Saga you agree to our terms of service which can be found at https://king.com/termsAndConditions\\u003cbr\\u003e\\u003cbr\\u003eDo not sell my data: King shares your personal information with advertising partners to personalize ads. Learn more at https://king.com/privacyPolicy. If you wish to exercise your Do Not Sell My Data rights, you can do so by contacting us via the in-game help center or by going to https://soporto.king.com/contact\"],\"King\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/j3czn91O4kwAk1Kto5AR3DhiwaZxEDhta3AeTz212FR44sBGFl57zYIoA2x-TVMLueE8mISALGq__AZ7EzyGQM0\"],null,[180,238,233,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Users Interact, Shares Info, Digital Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"PHP\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.king.farmheroessaga\\u0026rdid\\u003dcom.king.farmheroessaga\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"₱49.00 - ₱13,250.00 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.rc18.ragdoll.shinsonic.monster.playground.sandbox\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/mmEb7dCRBazlHhbs9jK4URNBkBOd9x97OUN_I3_H4QBnIvQ82I5funA6YQMdHTgkiBTDOqF0L-xdcNDrbP-l\"],null,[26,26,26,255],null,null,null,2],[[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/L-fHxv8dsvkdWXdlxke21tgt-oVTHLSE5pC_m6WrrtqiMy5LHv_spV5dJgBvLLiW5PoFAsPemopsme8c1T6yTw\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/GIsmidDa2BJmdX7ZOvKOjPuxx9zDSU8Tx3Y9kdIDMSFNycXLFZ67R6zS-Jc7Np3oOHhh1AXDl32Mn3tYLqebUA\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/yMBZPNgC9EsI9E0-IW7vR5MKF9kjfiYZBjVnK6K5rXbaiSjli50Bx3ajM_P7_1tw9c2YhUnSE0Y2q8ZOIDQV\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/UHK-vub-gxlO98Qh7SZ46XH8FV7-n5jCAXeZgSf1bwncUSoHRULEopoXrzd1bbWWWNKYhQgOjNIg8bxAreYg\"]]],\"Brainrot Playground\",[\"3.2\",3.23],\"Casual\",null,null,[null,[[0,\"PHP\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.rc18.ragdoll.shinsonic.monster.playground.sandbox\\u0026rdid\\u003dcom.rc18.ragdoll.shinsonic.monster.playground.sandbox\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.rc18.ragdoll.shinsonic.monster.playground.sandbox\"]],[\"qgKGARqDAQhHShMI2rObsceQlwMVjDyDAx2cuiMk+gEPCg0IABIJCgVlbi1VUxAAugJXCjsKNWNvbS5yYzE4LnJhZ2RvbGwuc2hpbnNvbmljLm1vbnN0ZXIucGxheWdyb3VuZC5zYW5kYm94EAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"Brainrot Playground takes ragdoll physics to the next level, delivering an exciting sandbox experience where players can unleash their creativity (or chaos). Step into a dynamic playground where you experiment with Ragdoll characters using a wide array of tools, traps, and monstrous creations. \\u003cbr\\u003e\\u003cbr\\u003eThe game features an expanded arsenal of interactive elements, from spike pits and flame throwers to advanced mechanisms. Design intricate setups, build destructive chain reactions, or just revel in the hilarity of ragdoll antics. With an enhanced physics engine, every action leads to satisfyingly unpredictable results, keeping you entertained for hours.\\u003cbr\\u003e\\u003cbr\\u003eBrainrot Playground offers endless possibilities for both casual fun and complex creations. Whether you\\u0026#39;re here for stress relief, creativity, or sheer chaos, this game promises an engaging and lighthearted experience for fans of sandbox and physics-based gameplay.\"],\"Tappy Game\",\"5,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/W87HXaYsH62NujMeHSl0xgirBXFx8k4ggUYmgUxNiOaDlqfhrc0gDFS0nB9609ZpmP8vvluTfj5MqrO7CM9_Dw\"],null,[37,204,217,255]],null,[\"Rated for 7+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/1SrNtAwg9PFOhgMJPXehacRTeQNhHhG12Pj1zACHNVmfRfEZA3_oOEmLvRNsmYGeGHpas7sCwyR3y8OT\"]],[null,\"Implied Violence\"],null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[