oogleusercontent.com/3VyyvrqnRFOOg2OjoyKlmUhAJkr34eqWZqqwbNuSpBn_T-wiCgNZfXSDEPAy0QhBhlvlKMzmO7qMnC7jUDXH\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/dqBmC3bs-gtG1X_uIPFjPAjhl-bkYYyGiS84hk5DqUAHYAhNP8Bvk2uh-k0J0zFix5mFQOHKChbIYEE6TVrV\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/O292qS8n-KSuESSOxWLlwnuQG9AQC05IdcMe8lCOp7Iwey_VapiVh2MPn15pyo89NnI8u8aMrR04s0uMUu-S\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/esdkuZdPW1PMTXMfMdT7G2Iz57icIBnQvzeNa58SHYcNvYhI-a03qBv74lgJu8Oi0OgyU_-EUxRUeqYcDuBHQg\"]]],\"Supermarket Game\",[\"4.1\",4.0885715],\"Casual\",null,null,[null,[[0,\"PHP\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.bubadu.supermarket\\u0026rdid\\u003dcom.bubadu.supermarket\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.bubadu.supermarket\"]],[\"qgJ2GnQIMEoTCNqzm7HHkJcDFYw8gwMdnLojJPoBDwoNCAASCQoFZW4tVVMQAIgCAboCPgocChZjb20uYnViYWR1LnN1cGVybWFya2V0EAEYAxIeCgQIARABCgQIAxABCgQIBBABCgQIBhABCgQICxABygIECAEQAQ\\u003d\\u003d\"],[[[null,null,\"eFV9A9lsT6I\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:eFV9A9lsT6I?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:eFV9A9lsT6I\",null,null,null,null,\"AXH1ezlc2BVTPbxQFswEdz1QwZpFEQZTa4K-nzmUn8aBMNHPEK20bI7uwOh7k5lkzcSzMo8e6Cm3Y1Dvr3qjynmVgaQMq080HQOZuqmSuDX63Ct5D2HiDLPQrWeI3ZjPCkLRn_ARqmu42IinNSSVUKFWNZzTvstrIqFv_hoSR4Cy_zdS2FX01a-mWFOuug3e6FBirF8WbwZ1W8xi2-eyLQX6V-0x683zdSYvTf3B3i8Gg-DzV1ieglFepr7z8RyfG570np42chaDlkLrqYFfPIivWsqwOM9fx1LHBnTDvbD6hkumQQ\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/eFV9A9lsT6I/hqdefault.jpg\"]]]],[null,\"Welcome to the shopping paradise! Explore the supermarket world with many popular mini-games. Help your customers shop and get ready for some fun!\\u003cbr\\u003e \\u003cbr\\u003eThis supermarket has a lot of sections: a cash register, departments for grocery, cheese and salami, fruits and vegetables, sweets, and toys, a recycling area and other. Do all the necessary tasks and provide superb shopping services to meet your customers’ needs.\\u003cbr\\u003e \\u003cbr\\u003e• Cash register: Have fun scanning items and issuing invoices. Learn about numbers and make sure to get the right amount of money, just like a real cashier.\\u003cbr\\u003e• Grocery: Keep your eyes peeled in a fun game with hidden objects where you must find foods and drinks like a cake, lollipop, chocolate, juice, spaghetti and many more. Help your customers find what they need.\\u003cbr\\u003e• Cheese and salami: Sort different types of salami and cheese from the conveyor belt. Drag every item to its box and be the fastest sorter in your shop.\\u003cbr\\u003e• Fruits and vegetables: Pick up fresh fruits and vegetables and avoid the rotten ones. Collect bananas, strawberries, tomatoes, carrots and other healthy foods.\\u003cbr\\u003e• Candies: Candy section is always the sweetest part of the supermarket. Be accurate and fill the passing cups with a variety of candies.\\u003cbr\\u003e• Weigh-in: Pack fruits and vegetables in bags, put the right quantity on the scale and weigh it. Watch the screen on the scale and avoid red numbers.\\u003cbr\\u003e• Recycling: Save the world from being polluted by learning how to recycle and sort your waste. Place the items correctly in different recycling bins: paper, plastic, glass, battery and organic.\\u003cbr\\u003e• Toy catcher: Use navigation buttons to move the claw and hit the red button to scoop it up. Enjoy grabbing toys in a toy catcher machine.\\u003cbr\\u003e• Delivery: Drive a delivery truck on the five-lane road and deliver packages. Test your driving skills and rush through the crazy traffic as fast as possible.\\u003cbr\\u003e• Catch a thief: Become a superhero and catch a thief in the supermarket. You have to be quick!\\u003cbr\\u003e \\u003cbr\\u003eKeep your supermarket under control and become the best storekeeper in this shopping game!\\u003cbr\\u003e \\u003cbr\\u003eFeatures:\\u003cbr\\u003e• fun and easy to play\\u003cbr\\u003e• beautiful graphics and friendly UI\\u003cbr\\u003e• attractive animations and sound effects\\u003cbr\\u003e• 10 popular mini-games and shopping areas\\u003cbr\\u003e• challenging achievements with bronze, silver and gold medals\\u003cbr\\u003e\\u003cbr\\u003eThis game is free to play but certain in-game items and features, also some of those mentioned in game description, may require payment via in-app purchases which cost real money. Please check your device settings for more detailed options regarding in-app purchases.\\u003cbr\\u003eThe game contains advertising for Bubadu’s products or some third parties which will redirect users to our or third-party site or app.\\u003cbr\\u003e\\u003cbr\\u003eThis game is certified compliant with the Children’s Online Privacy Protection Act (COPPA) by FTC approved COPPA safe harbor PRIVO. If you would like to know more about the measures we have in place for protecting child privacy please see our policies here: https://bubadu.com/privacy-policy.shtml .\\u003cbr\\u003e\\u003cbr\\u003eTerms of service: https://bubadu.com/tos.shtml\"],\"FM by Bubadu\",\"100,000,000+\",null,\"Ages 6-8\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/gOQfeKslOJyvPBUtIcbPVfjLe89wHtjFiZVGXx4OpttRpifWll0LR9pkfjOFNpxUlr1qsHqEEzSddZZ8iDWSLkk\"],null,[240,131,5,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"PHP\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.bubadu.supermarket\\u0026rdid\\u003dcom.bubadu.supermarket\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"₱63.00 - ₱255.00 per item\",[false]],null,null,null,[[[[\"playpass_family\",39]]],[null,null,null,null,[null,null,\"/store/pass\"]]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]],[null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.RC56.crafty.blox.world\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/7tviKTCxykQjI4K30BLJeaEsdQoyJZV8XEgFjmvWrLcvF_5sONxpZfQ4cSZSpQ4msH2ZIU4H3obaW-u_hRJzMg\"],null,[126,120,114,255],null,null,null,2],[[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/O1d6gOZYkseGcfqiIVqmiQQKwOwzIdHIlXLuJSxdDftMjkppVJ7lcAEZgGq4j63y0-FjBGfviCfWWtH6kClq7CU\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/LYwFu8VszHFWm7fN_27UV9ITK64y7bZO6UkFtkpF7JogO-O7vAbuDKImqIPlMMOOyYB7zdlRSDu-L-AJqEBsyA\"]],[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/Sdffq6BB6KMFwPD86e_mEio1NDCi6ARRgsMna0XXpc6hzQ7HEgGhQhpAxcvmG0EtIzG5UMkmi_-0uIpcoUqddmE\"]]],\"Crafty Blox World\",[\"3.3\",3.34],\"Casual\",null,null,[null,[[0,\"PHP\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.RC56.crafty.blox.world\\u0026rdid\\u003dcom.RC56.crafty.blox.world\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.RC56.crafty.blox.world\"]],[\"qgJqGmgIMUoTCNqzm7HHkJcDFYw8gwMdnLojJPoBDwoNCAASCQoFZW4tVVMQALoCPAogChpjb20uUkM1Ni5jcmFmdHkuYmxveC53b3JsZBABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"Welcome to Crafty Blox World – The Ultimate Voxel Building \\u0026amp; Action Adventure!\\u003cbr\\u003e\\u003cbr\\u003eStep into a limitless pixelated universe where your creativity meets intense action! Crafty Blox World is an open-world sandbox simulator that combines the freedom of building with thrilling combat and survival elements. Whether you want to design massive structures or gear up to fight dangerous monsters, this blocky world has it all!\\u003cbr\\u003e\\u003cbr\\u003eBUILD YOUR DREAM WORLD\\u003cbr\\u003eUnleash your imagination with an extensive crafting and building system. Gather resources, mine materials, and place blocks to create anything from simple pixel shelters to majestic blocky castles. Shape the terrain and design your unique base down to the very last block.\\u003cbr\\u003e\\u003cbr\\u003eACTION, WEAPONS \\u0026amp; COMBAT\\u003cbr\\u003eThis isn\\u0026#39;t just a peaceful building simulator—prepare for a challenge! Arm yourself with an arsenal of powerful weapons, from sharp melee swords to explosive firearms and bombs. Defend your territory against waves of fearsome monsters and hostile creatures that roam the land.\\u003cbr\\u003e\\u003cbr\\u003eEXPLORE \\u0026amp; SURVIVE\\u003cbr\\u003eVenture into diverse voxel landscapes filled with secrets, hidden materials, and unique biomes. Meet friendly villagers, tame mounts to travel faster, and discover mysterious ecosystems. Adapt, craft better gear, and conquer the ultimate survival test!\\u003cbr\\u003e\\u003cbr\\u003eKEY FEATURES:\\u003cbr\\u003e\\u003cbr\\u003eMassive Sandbox Freedom: Craft, build, and destroy in a fully interactive 3D voxel world.\\u003cbr\\u003e\\u003cbr\\u003eDynamic Action Combat: Fight monsters using unique weapons, guns, and explosives.\\u003cbr\\u003e\\u003cbr\\u003eRich Ecosystem: Encounter various friendly creatures, unique animals, and dangerous enemies.\\u003cbr\\u003e\\u003cbr\\u003eCharacter Customization: Personalize your character with cool skins and unique accessories.\\u003cbr\\u003e\\u003cbr\\u003eSmooth Mobile Optimization: Enjoy colorful blocky graphics and intuitive controls tailored for your device. \\u003cbr\\u003e\\u003cbr\\u003eThe horizon is waiting for you. Download Crafty Blox World now, grab your weapons, and start building your legacy today!\"],\"Tappy Game\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/FrQjnN3VxnoxnRrm39kUtMi7cnkbUoIj99oxOyjfj2jatlzRll3tf1NWs_X0xC95IztyMGL0fQuorzktlBzU\"],null,[132,206,37,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,[null,\"Suitable for all age groups. Some violence in a comical or fantasy context is acceptable. Bad language is not permitted.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"PHP\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.RC56.crafty.blox.world\\u0026rdid\\u003dcom.RC56.crafty.blox.world\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,nu