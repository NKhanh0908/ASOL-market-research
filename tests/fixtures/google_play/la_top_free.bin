asual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.outfit7.talkingtom\\u0026rdid\\u003dcom.outfit7.talkingtom\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.outfit7.talkingtom\"]],[\"qgJmGmQIO0oTCP7B8LHHkJcDFTKdbAkdeKQUbPoBDwoNCAASCQoFZW4tVVMQALoCOAocChZjb20ub3V0Zml0Ny50YWxraW5ndG9tEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],[[[null,null,\"D-uUVUtiNbQ\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:D-uUVUtiNbQ?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:D-uUVUtiNbQ\",null,null,null,null,\"AXH1ezmn-A39kNcZUMYbCu1f7UK7bf9x-FmGlYhKSIEGWkEsJTprMCT9vrqNxyhlKcc4QezYKpSNRxFYAthbG2vB6Z8RQtuKdPWQtG9hL7g6bk-1xYLw2WjIXqKdwNCEDag_5vk9IPS-bAFXbVnSIXCyVhIOVpLtwh2JeOI1uEKr7ed2rGSLmfO035m_YQvvjvlsrundgAt6xRtmEj011qQj5bsLEbNVHDwXZ7WsxXZME7E6kMjce3GEVYyuUWW6m8ekLntiMy2lhU8mguxOY3ddOmyvXebMJDIAF1d0gmzFml_6Ig\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/D-uUVUtiNbQ/hqdefault.jpg\"]]]],[null,\"Download the legendary game that started it all—Talking Tom Cat!\\u003cbr\\u003e\\u003cbr\\u003eTHE ORIGINAL TALKING VIRTUAL PET\\u003cbr\\u003eTalking Tom is the talking cat that took the world by storm. He repeats what you say in his hilarious voice, and reacts in surprising (and sometimes strange) ways. Whether you\\u0026#39;re a longtime fan or new to the chaos, this virtual pet game hits different.\\u003cbr\\u003e\\u003cbr\\u003ePOKE TOM\\u003cbr\\u003eCan’t stop poking Tom? You’re not alone. Tom might just be the most pokeable animal in the universe.\\u003cbr\\u003e- Poke Tom’s face and see what happens (spoiler: may become unhinged)\\u003cbr\\u003e- Tap his belly, his feet, or even pull his tail\\u003cbr\\u003e- Keep poking and discover hidden reactions\\u003cbr\\u003e\\u003cbr\\u003eTALK TO THE LEGEND\\u003cbr\\u003eTom’s talkback feature made him famous—and it still holds up.\\u003cbr\\u003e- Talk to Tom and hear him repeat everything you say\\u003cbr\\u003e- LOL at his NEW voice filters\\u003cbr\\u003e- Share funny moments with your friends\\u003cbr\\u003e\\u003cbr\\u003eFEED TOM\\u003cbr\\u003eThis talking cat has a big appetite. And dramatic reactions.\\u003cbr\\u003e- Feed him spicy chillies and watch him fart fire\\u003cbr\\u003e- Toss him a watermelon (his favorite!)\\u003cbr\\u003e\\u003cbr\\u003eSO MANY WAYS TO PLAY\\u003cbr\\u003e- Pet Tom and hear him purr\\u003cbr\\u003e- Try poking him 100 times. We dare you\\u003cbr\\u003e- Make him fart and blame someone else\\u003cbr\\u003e- Don\\u0026#39;t talk to him and see what happens\\u003cbr\\u003e\\u003cbr\\u003eJoin a global community of fans creating memes, videos, and challenges with Talking Tom, the cat who talks back, makes you laugh, and somehow always feels like more than a virtual animal. He’s your chaotic little buddy.\\u003cbr\\u003e\\u003cbr\\u003eTom is brought to you by Outfit7, the makers of My Talking Tom, Talking Tom Gold Run and My Talking Angela.\\u003cbr\\u003eThis app contains:\\u003cbr\\u003eThe option to make in-app purchases\\u003cbr\\u003e\\u003cbr\\u003eTerms of use: https://talkingtomandfriends.com/eula/en/\\u003cbr\\u003ePrivacy policy: https://talkingtomandfriends.com/privacy-policy-games/en\\u003cbr\\u003eCustomer support: support@outfit7.com\"],\"Outfit7 Limited\",\"500,000,000+\",null,null,null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/ke5gWE30b8FzkrPqHG9puuGJIvS15MANxGr_LfN8IOf7Rw9K5WxhyCTfhlFZUI4PM7xQbBueAqnDeXtLRbU6WA\"],null,[154,108,32,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"Users Interact, In-App Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.outfit7.talkingtom\\u0026rdid\\u003dcom.outfit7.talkingtom\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.ycgame.makeup\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/SJtdIqU6qKFSNsT5vdmq7wYdkeJ80doQVkIQPPZV_qjbO8vb9-Lyu5spvXVCqJN3QN5bF3hNbJkVBlMSWxlrPg\"],null,[32,24,159,255],null,null,null,2],[[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/W_MjviV2sXdsrhJSOzTw1DjQX2eWdnsJq5hGMFkgjcnkEiYyah2MFCjpnxttXnNBrZM__nogaAdSQdySjRsIzmk\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/S65683bPEf3GgLmyOFTkhtWAIAcCo4Cqci5EopIxiavwfkuMhh_WcRDuEzXRdlX_aU8PJqnzROmKUdFGP6oR-Q\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/GfUrcrM6it8ZNSWLUOxVgA385XOj4hpZa57m204NFUqqptGRox3umjub4sZwduvwJrYneEFSaYbLkWtglOnJLA\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/nboTUKeiqH59-ogOcj71PgmFTjfiCA5yfd1gDI3cIDewxvgc3Cfo8GYfdi3wEmf7aO7AuCCmx2yHic777HPWwg\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/V_-1r8fXMVBPnbqtzYJWVslLjObbgZomR