,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/61wChok-LIwOW77is9-8TPuU92yCFvB4JHAp8ZGv3jJvlXqjZqM3XJj8hQUDaBULC3ufeEv955nH481Acp-U7g\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/Ll7behhGYdrRuQpa5JmoUJoW65mtjIbIY2CpF12vYDiPdm4im9Xodlt5y-sKaZ-o2q7xLxWbhGBlFrNhMozYj8c\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/kUnEPgOEFIxtZJ8njV9RuoBCEWWjP9HKbCKTgbO4S9feEkkv0kZDQXFrVcU4dHtFraCDkzRCLdJfuIjQ6DT9\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/sGzNUycZfbCEQx3fl6Z6W4Rzd9vUu7O2QW1Ba82Jkgd9R3I7RhJo1ex-L29fjsqtdUeu08RZg3HfkAafSmZ8c-Y\"]]],\"Mukbang Star: ASMR Live Collab\",[],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.auragames.mukbang.asmr.live\\u0026rdid\\u003dcom.auragames.mukbang.asmr.live\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.auragames.mukbang.asmr.live\"]],[\"qgJpGmcITEoTCP7B8LHHkJcDFTKdbAkdeKQUbPoBDwoNCAASCQoFZW4tVVMQALoCOwolCh9jb20uYXVyYWdhbWVzLm11a2JhbmcuYXNtci5saXZlEAEYAxISCgQIARABCgQIBBABCgQICxAB\"],null,[null,\"Ready for the ultimate crunch? 🍭 Step into the delicious, satisfying world of Mukbang ASMR \\u0026amp; DIY cooking experience!\\u003cbr\\u003e\\u003cbr\\u003eDo you love watching viral ASMR videos? Now you can be the star! Dive into a world of crunchy sounds, wiggly jellies, and creative cooking. From crafting the perfect Tanghulu to hosting a Live Stream with millions of fans, your journey to becoming a Mukbang Legend starts here!\\u003cbr\\u003e\\u003cbr\\u003e🌈 EXPLORE THE TASTIEST MINI-GAMES\\u003cbr\\u003eUnlock your inner chef and master different food trends:\\u003cbr\\u003e\\u003cbr\\u003eDIY Tanghulu: Skewer your favourite fruits, coat them in sweet sugar, and hear that famous crunch!\\u003cbr\\u003e\\u003cbr\\u003eRainbow Jelly Maker: Choose heart, bear, or flower molds! Add glitter, boba pearls, and delicious syrups to create the world\\u0026#39;s wiggliest treats.\\u003cbr\\u003e\\u003cbr\\u003eSchool Lunch Master: Pack the ultimate lunchbox with nuggets, watermelon, and octopus sausages!\\u003cbr\\u003e\\u003cbr\\u003eRamen \\u0026amp; Burger Bar: Boil the perfect noodles or stack a massive burger with avocado, bacon, and spicy mayo.\\u003cbr\\u003e\\u003cbr\\u003eLive Ice Cream: Mix and roll ice cream on a freezing plate for the most satisfying dessert ever!\\u003cbr\\u003e\\u003cbr\\u003e🎥 GO VIRAL \\u0026amp; BECOME A STAR\\u003cbr\\u003eIt’s not just about cooking—it’s about the fans!\\u003cbr\\u003e\\u003cbr\\u003eLive Stream Mode: Start your broadcast and watch the hearts fly! Earn coins and tips from your viewers.\\u003cbr\\u003e\\u003cbr\\u003eCollab with Stars: Matchmake with guest streamers and host a \\u0026quot;Collab Mukbang\\u0026quot; to double your views.\\u003cbr\\u003e\\u003cbr\\u003eRank Up: Move from a \\u0026quot;Newbie Nibbler\\u0026quot; all the way to a \\u0026quot;Mukbang Legend.\\u0026quot; Can you reach 50 million followers?\\u003cbr\\u003e\\u003cbr\\u003e🐾 ADORABLE COMPANIONS\\u003cbr\\u003eYou don’t have to eat alone!\\u003cbr\\u003e\\u003cbr\\u003eAdopt cute pets like the Shiba Inu, Red Panda, or the chill Capybara to sit by your side while you stream.\\u003cbr\\u003e\\u003cbr\\u003e🎧 WHY YOU’LL LOVE IT\\u003cbr\\u003eUltra-Satisfying ASMR: High-quality sounds for eating, boiling, and crunching.\\u003cbr\\u003e\\u003cbr\\u003eCreative Freedom: Thousands of combinations for sauces, toppings, and decorations.\\u003cbr\\u003e\\u003cbr\\u003eStress Relief: The perfect game to relax and unwind with \\u0026quot;oddly satisfying\\u0026quot; gameplay.\\u003cbr\\u003e\\u003cbr\\u003eFree Rewards: Spin the wheel and complete part-time jobs to unlock exclusive ingredients and secret recipes!\\u003cbr\\u003e\\u003cbr\\u003eDownload Mukbang Star now and start your crunchy, wiggly, delicious ASMR adventure today! ✨\"],\"AuraEffects\",\"500,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/bGPn1nP2rmpTB5NE8eU_-gMrM5xPJdLsoztGjLyby_A7kGYFfVjWU44FarBdVbogoqvsHFYrQWjHj28klbSN\"],null,[195,236,234,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.auragames.mukbang.asmr.live\\u0026rdid\\u003dcom.auragames.mukbang.asmr.live\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.fcg.bakery.stack.maker.game\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/EytOnagAIGHm3invorv5MPpjwhwKVPr7Yj-pQf6zX2tL7xf6TKSQRurlhGkiZGNmZKG8sQ7t0udPoYtJhrtNlg\"],null,[242,240,241,255],null,null,null,2],[[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/y8U5sHIJCSa5FZ-kYGxtsF8q3X-0X-Ej6bjlTxY2X5LQrRJWd_eSuE90uqKd-