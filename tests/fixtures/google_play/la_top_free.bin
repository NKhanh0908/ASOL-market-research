qXlqSSoBRs7NlT6Hi1l_Jsst7lSdSJEETN1Vu9y71Pb3rmGVI05qw\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/810vvGpg-B_jYqRt3Ui2Gdmt-urc0AXQgqPOkRTfFImfJ1G9BTwtnYbIHX0mHiEVkGGdNNplF7X5ZQMVMx5EhWY\"]]],\"Mini Relaxing Game- pop it\",[\"3.5\",3.482353],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.sh.fidget.toys.mini.relaxing.antistress.games\\u0026rdid\\u003dcom.sh.fidget.toys.mini.relaxing.antistress.games\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.sh.fidget.toys.mini.relaxing.antistress.games\"]],[\"qgKBARp/CAVKEwj+wfCxx5CXAxUynWwJHXikFGz6AQ8KDQgAEgkKBWVuLVVTEAC6AlMKNwoxY29tLnNoLmZpZGdldC50b3lzLm1pbmkucmVsYXhpbmcuYW50aXN0cmVzcy5nYW1lcxABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"Need to unwind after a long day? Step into a world of calm with antistress relaxing fidget toys. This popit game is designed to help you relax, focus, and find peace. Explore an array of soothing pop it toys and stress-relief games that stimulate the satisfying experience of puppet games and mindful exercises. Engage with various relaxation toys, each with unique interactions and calming sounds.\\u003cbr\\u003e\\u003cbr\\u003eThe ultimate ASMR fidget games are designed to relieve stress and soothe your mind. Explore a diverse collection of anti-stress toys, including stress balls, pop it toys, fidget spinners, and more. Each toy offers a unique sensory experience to help you relax and destress.\\u003cbr\\u003e\\u003cbr\\u003eWe\\u0026#39;ve compiled a list of over 50+ sensory fidget toys.\\u003cbr\\u003e\\u003cbr\\u003eSome Features of Our Game:\\u003cbr\\u003ePop it fidget toy\\u003cbr\\u003eFidget spinner\\u003cbr\\u003eBalloons popping\\u003cbr\\u003eCradle balance balls\\u003cbr\\u003ePetals plucking\\u003cbr\\u003eASMR cutting\\u003cbr\\u003ePottery - Play with the clay\\u003cbr\\u003eSlime games\\u003cbr\\u003eDalgona cookie cutting\\u003cbr\\u003eHydraulic press\\u003cbr\\u003eRelaxing fireworks\\u003cbr\\u003eMoney gun\\u003cbr\\u003eIron balls\\u003cbr\\u003eand many more...\\u003cbr\\u003e\\u003cbr\\u003eMini Relaxing Game is the perfect escape from the hustle and bustle of daily life.\\u003cbr\\u003e\\u003cbr\\u003eGet rid of stress!\"],\"Game District LLC\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/4xYlPEQUb41N8kLfVsy94g-BlBZLJeUcTfG-XeRAlWtpTefvR0HyN-g-9c82pNCS-6rQzexjf019r9vASFFiEUg\"],null,[88,43,8,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.sh.fidget.toys.mini.relaxing.antistress.games\\u0026rdid\\u003dcom.sh.fidget.toys.mini.relaxing.antistress.games\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.plug.runner.battery.mates\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/ST_8FIgzNFD6O4iz5aZ9oVDXMGJxJQHsGHjQj4tktTpxhZR5BR94sO37iATgnPYxxOQdS7OYNNevvy-lUS9Fww\"],null,[6,121,241,255],null,null,null,2],[[null,2,[998,561],[null,null,\"https://play-lh.googleusercontent.com/T9OEGRr-VB0htVfcZ5ifjtz3O97HoIwVlawgbWjZllnlEyLdh1NwNIomqfZICIgLyzTGG75aWUjmgj49y1oylw\"]],[null,2,[995,560],[null,null,\"https://play-lh.googleusercontent.com/xCJK4D2pSyXeH6c83dzoWluxyR9-n_njYlQgp6ALuTgaeuFsJZJx3ygE93g33RWcfWzeMv7pXEx0V8Yk-1CC38g\"]],[null,2,[995,559],[null,null,\"https://play-lh.googleusercontent.com/PZhgwM6RajmRKy9GJ81sLHDMbKYGvWEFkfpYnfeqqUTGvCPCI6QRLEspDzLj6LG1CPx1tpR-ttYzQUs0TgFQzg\"]],[null,2,[995,560],[null,null,\"https://play-lh.googleusercontent.com/063u84cLPCPjH2XvzZ12PzUOho143s6XY1FboQuTxzmSgIxjBMGpHxr8KlnKt2O2ziQfQRpxf8Rcm0CbAl3p\"]]],\"Plug Runner\",[\"4.0\",4],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.plug.runner.battery.mates\\u0026rdid\\u003dcom.plug.runner.battery.mates\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.plug.runner.battery.mates\"]],[\"qgJtGmsIBkoTCP7B8LHHkJcDFTKdbAkdeKQUbPoBDwoNCAASCQoFZW4tR0IQALoCPwojCh1jb20ucGx1Zy5ydW5uZXIuYmF0dGVyeS5tYXRlcxABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"⚡ Get ready for the most electrifying race of your life! ⚡\\u003cbr\\u003eWelcome to Plug Runner, the ultimate racing game where energy is everything! Take control of your plug character, charge up, and dash your way to victory in this highly addictive and fun competition! 🏃\\u200d♂️💨\\u003cbr\\u003e\\u003cbr\\u003e🔋 COLLECT \\u0026amp; GROW HUGE!\\u003cbr\\u003eRun across the track and collect batteries that match your color. The more you collect, the bigger and stronger you become! \\u003cbr\\u003e\\u003cbr\\u003e🚤 POWER UP VEHICLES \\u0026amp; OVERCOME OBSTACLES!\\u003cbr\\u003eYou\\u0026#39;re not just running—you are the power source! Use your energy to plug into awesome vehicles like cars, speedboats, and motorcycles, or use your raw power to smash through massive brick walls! 🧱🏍️\\u003cbr\\u003eCareful though! Powering these obstacles drains your energy and makes you shrink. You\\u0026#39;ll need to keep collecting batteries to stay in the race!\\u003cbr\\u003e\\u003cbr\\u003e💥 SMASH YOUR RIVALS!\\u003cbr\\u003eSize matters in Plug Runner! If you are bigger and stronger than your opponents, bump into them to knock them down! 🥊 They will stay on the ground for a few seconds and drop special Black Batteries that anyone can collect for a massive power boost. Show no mercy!\\u003cbr\\u003e\\u003cbr\\u003e🏁 BE THE FIRST TO FINISH!\\u003cbr\\u003eIt’s a thrilling dash to the end. Power through the obstacles, manage your energy wisely, outsmart your rivals, and be the first to cross the finish line to claim the crown! 👑\\u003cbr\\u003e\\u003cbr\\u003e✨ GAME FEATURES:\\u003cbr\\u003e🎮 Simple \\u0026amp; Addictive: Easy one-finger swipe controls, perfect for everyone!\\u003cbr\\u003e🎨 Vibrant 3D Graphics: Colorful paths, satisfying animations, and dynamic gameplay.\\u003cbr\\u003e🚗 Epic Power-Ups: Steer boats, ride bikes, and break walls!\\u003cbr\\u003e🥊 Fun Combat Mechanic: Knock down smaller players and steal their energy.\\u003cbr\\u003e🏆 Endless Racing Fun: Multiple levels with different challenges to test your skills!\\u003cbr\\u003e\\u003cbr\\u003eAre you fully charged and ready to run? ⚡ Download Plug Runner NOW and electrify the competition! 🔌🏁\"],\"AbbaYosua.Design\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/8Mp8IMSw2z47-vf8UwqDBzzbgRXX5TzEg_hLcrjnioOWWAn83F73IYhhldW_VO8PfKlvM2-pHrOlnZm7UWRX\