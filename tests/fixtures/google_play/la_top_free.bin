l,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/S65683bPEf3GgLmyOFTkhtWAIAcCo4Cqci5EopIxiavwfkuMhh_WcRDuEzXRdlX_aU8PJqnzROmKUdFGP6oR-Q\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/GfUrcrM6it8ZNSWLUOxVgA385XOj4hpZa57m204NFUqqptGRox3umjub4sZwduvwJrYneEFSaYbLkWtglOnJLA\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/nboTUKeiqH59-ogOcj71PgmFTjfiCA5yfd1gDI3cIDewxvgc3Cfo8GYfdi3wEmf7aO7AuCCmx2yHic777HPWwg\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/V_-1r8fXMVBPnbqtzYJWVslLjObbgZomRCAbWSJLY2P58KyixfNZ1VBI2xk6adWWUuYHL8LVShwxY_Ku26tPvw\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/9WiES9pkMSFvn1j9FsaR-4RQqMlOdle4nxA0uuawOScNDjabgZif-REhsCk2pJd8brwer6-Qr-nvoPXzjIGf\"]]],\"Makeup Carnival:Dress Up\",[\"5.0\",5],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.ycgame.makeup\\u0026rdid\\u003dcom.ycgame.makeup\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.ycgame.makeup\"]],[\"qgJhGl8IPEoTCP7B8LHHkJcDFTKdbAkdeKQUbPoBDwoNCAASCQoFZW4tVVMQALoCMwoXChFjb20ueWNnYW1lLm1ha2V1cBABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],[[[null,null,\"f52b_SOGVh4\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:f52b_SOGVh4?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:f52b_SOGVh4\",null,null,null,null,\"AXH1ezlSTfgheSaUFzZmEajvZDQ98JRyaQBlc4IPQyVxx10OdRBkKlZ8umaJUwORkSqJ8qN7BirpIYQIuwRRAAf9Urj-ZbSuMkc1ATfetHON-Ocd3BO_hr3aPyfZI2fbmuddb1D6pLtugCKlNMgqjlefhNL01DwsL1MG044nK1PL1H6bpjo3fa9hKYT3uqqWoil_8bL1zg_mlOLzv8z41tlG5sSquwB4mep-pRvcm6HU-HBsjyl3adHIow1R6wXT7W7Ioc-QhOZ_EGYnzx0U1Zeu0Fsa1lIszNiohPVBTj8_OpxIzA\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/f52b_SOGVh4/hqdefault.jpg\"]]]],[null,\"Step into the World of Makeup Carnival: Dress Up! 🎭✨\\u003cbr\\u003eWelcome to the ultimate beauty celebration! Makeup Carnival: Dress Up is not just a game; it’s an all-in-one fashion festival where creativity meets relaxation. Whether you are a fan of satisfying ASMR cleaning, a master of organization, or a fashionista ready for a runway showdown, this carnival has a tent just for you!\\u003cbr\\u003eExperience a collection of addictive mini-games designed to let you explore every side of the beauty world.\\u003cbr\\u003e### 🎡 Explore the Carnival Attractions\\u003cbr\\u003e🧹 Satisfying Deep Clean \\u0026amp; Skincare Start your transformation with a relaxing spa day! Use specialized tools to wash away dirt, clear skin, and perform deep-cleaning treatments. There is nothing more satisfying than watching a messy look turn into a fresh, glowing canvas. It’s the ultimate stress-relief experience!\\u003cbr\\u003e💄 The Ultimate Makeup \\u0026amp; Dress-Up Studio From understated natural looks to bold, dazzling masterpieces, the choice is yours!\\u003cbr\\u003eCreate the Base: Use foundation, contouring, and blush for a flawless finish.\\u003cbr\\u003eDefine the Eyes: Add vibrant eyeshadows, sharp eyeliner, and long lashes.\\u003cbr\\u003eThe Final Touch: Choose from a wide range of lip glosses and lipsticks. Match your look with an endless collection of outfits—from casual streetwear to glamorous evening gowns and seasonal favorites.\\u003cbr\\u003e📦 Restock \\u0026amp; Organize: The Beauty Closet Is your makeup bag a mess? Dive into our organizing mini-games! Sort your lipsticks by color, arrange your eyeshadow palettes by size, and declutter your vanity. It’s the perfect game for anyone who loves the \\u0026quot;restock\\u0026quot; aesthetic and the peace of a tidy space.\\u003cbr\\u003e🏆 High-Stakes Fashion Battles Ready to show off your style? Enter the Dress Up Challenge! Follow specific themes—like \\u0026quot;Neon Party,\\u0026quot; \\u0026quot;Vintage Romance,\\u0026quot; or \\u0026quot;Office Chic\\u0026quot;—and compete against others. Win the favor of the judges and climb the leaderboard to become the Carnival Queen!\\u003cbr\\u003e### ✨ Why You’ll Love Makeup Carnival\\u003cbr\\u003eAll-In-One Collection: Enjoy cleaning, dressing, and organizing in a single app.\\u003cbr\\u003eCreative DIY Spirit: Design unique looks and experiment with bold fashion ideas.\\u003cbr\\u003eASMR \\u0026amp; Relaxation: Designed to be a calming outlet with intuitive controls and satisfying sounds.\\u003cbr\\u003eThemed Rewards: Unlock new makeup kits, sticker packs, and rare accessories as you play.\\u003cbr\\u003eFor Everyone: From novices to expert stylists, everyone can find their rhythm in the carnival.\\u003cbr\\u003eMakeup Carnival: Dress Up is your new go-to destination for all things beauty and fashion. Whether you\\u0026#39;re here to relax with a cleaning session or to dominate the runway, the carnival is always open!\"],\"JoyPop Games\",\"1,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/W_MjviV2sXdsrhJSOzTw1DjQX2eWdnsJq5hGMFkgjcnkEiYyah2MFCjpnxttXnNBrZM__nogaAdSQdySjRsIzmk\"],null,[23,20,76,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,[null,\"Suitable for all age groups. Some violence in a comical or fantasy context is acceptable. Bad language is not permitted.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],n