ull,null,\"AXH1ezl6Y7X6wlT7A0xuJSNjIMpugmz-4h5G0N-Ae-cpu6X8RGNElCYrC7CBJnwtbQtyug9oO1YYf1VgmkenTwhYCqaK1OQ4tKv43BrWTht0MSK3SPX8s51D2FjBvtyBkVRTK-iuUtcpeD3thLp9Q89mXPqx1b_WP5g4wLE25LQ1HGugi5XvpBJHiRuU-3so6DWTktJixU0pnavWtjOwquUSkv8DpnaTx6RD1XxHpNIy8r5GC_45c3Tp1cXiJJyec5YdPoA7T2CCUqH_YrkHw8Tn7zMTsGzuRyOmgx34KEpoVymWCg\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/KQWnLcGjPBM/hqdefault.jpg\"]]]],[null,\"Experience the thrill of jailbreak escape, find a way out to freedom in our adventure filled jailbreak games! In this exciting jailbreak escape journey, you’ll take on the role of a prisoner trapped behind jail bars, where every level presents unique challenges and exciting mini games, leading to the final goal of prison escape. \\u003cbr\\u003e\\u003cbr\\u003eYour goal in this prison games ? Outsmart the system 👮, solve clever puzzles, and find a way out in this immersive prison games escape adventure. \\u003cbr\\u003e\\u003cbr\\u003eIf you\\u0026#39;re a fan of prison games and adventures, then this prison games escape adventure is for you. Can you outsmart the tricky system in this world of prison games and find a way out to your freedom?\\u003cbr\\u003e\\u003cbr\\u003ePacked with brain-teasing challenging tasks, this exciting world of prison games and jailbreak games offers endless excitement for you. Each level of this prison games adventure tests your wit and creativity as you navigate tricky scenarios for prison escape. From unlocking doors to dodging guards, every action you take brings you closer to freedom in this action-packed prison games.\\u003cbr\\u003e\\u003cbr\\u003eWhether you’re picking locks in this jail games, cracking codes, or performing daring stunts, the prison games escape adventure ensures a mix of strategy and fun. Dive into thrilling prison games filled with mystery and suspense, as you plan your ultimate jailbreak escape.\\u003cbr\\u003e\\u003cbr\\u003eDo you have what it takes to escape in this jail games ? \\u003cbr\\u003eWith every success leading to a prison escape, you’ll unlock new levels filled with even more challenging mini games and intricate problem solving games, fulfilling your jailbreak escape adventure.\"],\"GenI Games\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/KP-co2A6PKmUa65X3jTsLqiaSlF6Z5fB4GlxFwcJrxZFst6NnmrntiYucFJXuOFNtjL5gNN7Uk8ND4cCWVCu5Q\"],null,[102,120,141,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,[null,\"Suitable for all age groups. Some violence in a comical or fantasy context is acceptable. Bad language is not permitted.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.genigames.prison.escape.jailbreak.adventure\\u0026rdid\\u003dcom.genigames.prison.escape.jailbreak.adventure\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.supercell.hayday\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com