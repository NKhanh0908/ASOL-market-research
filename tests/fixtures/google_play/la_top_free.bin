.\\u003cbr\\u003eBeautiful graphics that bring the kingdom to life.\\u003cbr\\u003e\\u003cbr\\u003e💎 Your Royal Adventure Awaits!\\u003cbr\\u003eCan you restore the kingdom to its former glory? Solve puzzles, collect treasures, and become the hero your people need.\\u003cbr\\u003e\\u003cbr\\u003eDownload Kingdom Match: Royal Adventure now and start building your dream kingdom today!\"],\"Gamee Global\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/tJeTgTuvmEa9mWrFSilq_tNMGLybvJA1XYjWtHMy_nciD8bykh8KcB6znDJcjbonl7fV8VANyZiD_uP6prvZ\"],null,[93,82,86,255]],null,[\"Rated for 7+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/1SrNtAwg9PFOhgMJPXehacRTeQNhHhG12Pj1zACHNVmfRfEZA3_oOEmLvRNsmYGeGHpas7sCwyR3y8OT\"]],[null,\"Mild Violence, Implied Violence\"],null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/JTT-ImEkrbWzIL7w0fP8fQhVmpexdfh7u0P59PJtyJywmQBVolJjunMal6B5dUM6uiFiKnmtHtBbVvcWBMU\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.gamee.kingdom.royale.match3.blast.escape\\u0026rdid\\u003dcom.gamee.kingdom.royale.match3.blast.escape\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.auragames.mukba