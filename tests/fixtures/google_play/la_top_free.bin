gleusercontent.com/VTWnWjxs-bnL-9NQAyFUSCNHssnGTKhCnxlWjiFn68arroRq_yPIihQdGHwDp5oYDjaGBJZMetuphs4-AzZz\"]]],\"Hole.io\",[\"3.7\",3.66],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dio.voodoo.holeio\\u0026rdid\\u003dio.voodoo.holeio\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dio.voodoo.holeio\"]],[\"qgJgGl4IAkoTCP7B8LHHkJcDFTKdbAkdeKQUbPoBDwoNCAASCQoFZW4tVVMQALoCMgoWChBpby52b29kb28uaG9sZWlvEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],[[[null,null,\"3pu8nD2q5IE\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:3pu8nD2q5IE?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:3pu8nD2q5IE\",null,null,null,null,\"AXH1ezkY7cLN8IP7nk7XMzAX0SH3FJ6FZUH5ylqTDoHQpZsANdkQv4-f1s5_Uwl5cQSVBDMvZOSWjnk67f4Fdm5Wl5Y4W1507jm7ihcOIe__tAbWd8KyeyFg77GFHicaQJKSnEuNpjhQiq3HNBtJPoyyzkZT75rLSGY7ddHG0PdhfDubP4vhOpuXknhAozZli_YoRHQW2mQ8delgPhiqGKtK2dT7PSHf9jI6SWAtYbRelwGwcJ57lbjUspkmChbVkCGkGrvJnZm-s6iuEEf6kSIUMO5rt54hq4E0tMDoRn2dyaAo5g\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/3pu8nD2q5IE/hqdefault.jpg\"]]]],[null,\"Welcome to Hole.io, the wildly satisfying eat-the-world game played by millions! Drop into busy New York, a creaky pirate cove, or a glowing sci-fi metropolis - and swallow it whole. Cars, lampposts, hot dogs and even giant skyscrapers! 🏙️🏴\\u200d☠️🚀\\u003cbr\\u003e\\u003cbr\\u003eWhether you\\u0026#39;ve got five minutes while watching your favorite show or an hour to unwind before bed, just tap, glide, and watch the city crumble into a black hole. No pressure, no stress - just the pure, oddly relaxing joy of eating everything in sight. 😌\\u003cbr\\u003e\\u003cbr\\u003e🍔 EAT EVERYTHING\\u003cbr\\u003eStart tiny, barely big enough to swallow a trash can. Grow huge, big enough to gulp down skyscrapers in one bite. The bigger you get, the louder the crunch. Pure satisfaction. 🌆\\u003cbr\\u003e\\u003cbr\\u003e😌 THE PERFECT BREAK \\u003cbr\\u003eEasy to learn, instantly satisfying. Play in short bursts: morning coffee ☕, lunch break 🥪, evening unwind🌙. A relaxing, oddly soothing game for casual players.\\u003cbr\\u003e\\u003cbr\\u003e✨ WHY YOU\\u0026#39;LL LOVE IT \\u003cbr\\u003e- Wonderfully simple controls - just swipe and glide.\\u003cbr\\u003e- Insanely satisfying gameplay - swallow, smash, and clear the map.\\u003cbr\\u003e- Beautiful, vibrant 3D worlds packed with detail.\\u003cbr\\u003e- Free to play, easy to love.\\u003cbr\\u003e\\u003cbr\\u003e🕳️ Ready to swallow the world? Download Hole.io now and find out why millions of players can\\u0026#39;t put it down. Time to feed the black hole. 😋\"],\"VOODOO\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/cGXxPboiwvp6F7LPPGQxDyUbrUL2_PbSAZnj3erVs9QpdRCpqWYz-LZBbBoBb2Tbg8Yh0R6Z7Ujr84BaJXHC\"],null,[239,182,132,255]],null,[\"Rated for 7+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/1SrNtAwg9PFOhgMJPXehacRTeQNhHhG12Pj1zACHNVmfRfEZA3_oOEmLvRNsmYGeGHpas7sCwyR3y8OT\"]],[null,\"Implied Violence\"],[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/JTT-ImEkrbWzIL7w0fP8fQhVmpexdfh7u0P59PJtyJywmQBVolJjunMal6B5dUM6uiFiKnmtHtBbVvcWBMU\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dio.voodoo.holeio\\u0026rdid\\u003dio.voodoo.holeio\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,nul