ull,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.outfit7.mytalkingangela2\"]],[\"qgJsGmoICkoTCP7B8LHHkJcDFTKdbAkdeKQUbPoBDwoNCAASCQoFZW4tVVMQALoCPgoiChxjb20ub3V0Zml0Ny5teXRhbGtpbmdhbmdlbGEyEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"My Talking Angela 2 is the ultimate virtual pet game that brings fun, fashion, and creativity to your everyday life. Step into the big city with the stylish Angela and embark on a journey filled with exciting activities and endless entertainment in the Talking Tom \\u0026amp; Friends universe!\\u003cbr\\u003e\\u003cbr\\u003eKey Features:\\u003cbr\\u003e\\u003cbr\\u003e- Stylish Hair, Makeup, and Fashion Choices: Transform Angela with various hairstyles, makeup options, and fashionable outfits. Dress her up for fashion shows and personalize her look to make her shine like a star.\\u003cbr\\u003e\\u003cbr\\u003e- Exciting Activities: Engage in a variety of fun activities, including dancing, baking, martial arts, trampoline jumping, jewelry making, and planting flowers on the balcony.\\u003cbr\\u003e\\u003cbr\\u003e- Delicious Food and Snacks: Bake and cook delicious treats for Angela. From cakes to cookies, satisfy her sweet tooth with your culinary skills.\\u003cbr\\u003e\\u003cbr\\u003e- Travel Adventures: Take Angela on jet-setting travel adventures to explore new destinations and cultures. And to shop until she drops!\\u003cbr\\u003e\\u003cbr\\u003e- Mini-Games and Puzzles: Challenge your skills with fun mini-games and puzzles that test your reflexes and strategic thinking.\\u003cbr\\u003e\\u003cbr\\u003e- Sticker Collections: Collect and complete sticker albums to unlock special rewards and new content. \\u003cbr\\u003e\\u003cbr\\u003eExpress Your Creativity: Angela inspires you to be creative, bold, and expressive. Design her outfits, experiment with makeup, and decorate her home to reflect your unique style.\\u003cbr\\u003e\\u003cbr\\u003eFrom Outfit7, creators of the hit games My Talking Tom, My Talking Tom 2 and My Talking Tom Friends.\\u003cbr\\u003e\\u003cbr\\u003eThis app contains:\\u003cbr\\u003e- Promotion of Outfit7\\u0026#39;s products and advertising;\\u003cbr\\u003e- Links that direct customers to Outfit7’s websites and other apps;\\u003cbr\\u003e- Personalization of content to encourage users to play the app again;\\u003cbr\\u003e- The option to make in-app purchases;\\u003cbr\\u003e- Subscriptions, which are auto-renewable, unless cancelled before the end of the current subscription period. You can manage and cancel a subscription in your Google Play Account settings after purchase.\\u003cbr\\u003e- Some features may be subject to different pricing and availability.\\u003cbr\\u003e- Items to purchase (available in different prices) using virtual currency, depending on the player’s progress;\\u003cbr\\u003e- Alternative options to access all functionalities of the app without making any in-app purchases using real money.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003eTerms of use: https://talkingtomandfriends.com/eula/en/\\u003cbr\\u003eCustomer support: support@outfit7.com\\u003cbr\\u003ePrivacy policy: https://talkingtomandfriends.com/privacy-policy-games/en\"],\"Outfit7 Limited\",\"500,000,000+\",null,null,null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/uRSAhuxCcQyMRnbbYAUyApTUKAw-E793Nt65rhsxxykaK2xMMTSlK0ta4umPik-8RDqojHmZmh97G0hU1OBTUQ\"],null,[149,99,180,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz