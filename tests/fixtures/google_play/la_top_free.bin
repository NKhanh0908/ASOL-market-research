l,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/_Qj91TsTbNTDc53ETUGb00Bxp_fgjW_KT65vC8Yx1rAEEeg1Ykl_O49CIE0Rnki8jFed5yil-OeWUmBNIrgV3CU\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/GNWdmjlZ8bRaN1Op_3pKzJnVBKYBWsNEK4zcPAc6s1eZGjYKv3PeFHA25raXH9wCifDQWPA623EgW2j2fcNA\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/u9asalZUUMvPU9f5BaPZJ0nCo81q479L2r00YpHjvoKUe0DzWLDCqmXmFkWMZHKpCB9mNgxmHuyZg32xMIb9hLI\"]]],\"Mini Games: Run And Win\",[],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.ps.running.mini.games.challenge\\u0026rdid\\u003dcom.ps.running.mini.games.challenge\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.ps.running.mini.games.challenge\"]],[\"qgJtGmsIRkoTCP7B8LHHkJcDFTKdbAkdeKQUbPoBDwoNCAASCQoFZW4tVVMQALoCPwopCiNjb20ucHMucnVubmluZy5taW5pLmdhbWVzLmNoYWxsZW5nZRABGAMSEgoECAEQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"Welcome to the Mini running games the ultimate fun for all ages, you just pick the challenge and try to win in that to become winner in this mini games.\\u003cbr\\u003eIf you are bored by earlier games then jump into this all in one running game challenge where you have to play our giant man race, jerk race and so on on the base of our player interest we add in the nest updates as well.\\u003cbr\\u003eInfinite Adventures – Never the Same Twice\\u003cbr\\u003e\\u003cbr\\u003eStep into a new running games universe every time you join! you find the epic running challenges With constantly changing challenges, no two runs ever feel alike.\\u003cbr\\u003e\\u003cbr\\u003eSimple to Start, Tough to Master\\u003cbr\\u003eGetting started is effortless – learn the controls in seconds and jump straight into the action.\\u003cbr\\u003eBut true mastery? That’s where the fun begins. Every level is packed with clever twists and hidden strategies that will push your skills to the limit.\\u003cbr\\u003eYou’ll never run out of things to try – existing levels get frequent updates, and brand-new indie mini games drop in regularly to keep the adventure alive.\\u003cbr\\u003e\\u003cbr\\u003eWhether you’ve got two minutes or two hours, there’s always a challenge waiting. Play casually to unwind or push yourself to beat your own records – the choice is yours.\"],\"Play Stove\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/_OmQcxjT8uwrC-qIrEy_oC6Tm73V5EheziFf2v1IK3szTPfnCN6THeHy9RQSNwDGauGjbPQliiOhtawTx2zU\"],null,[238,238,234,255]],null,[\"Rated for 12+\",[null,2,[366,512],[null,null,\"https://play-lh.googleusercontent.com/yQChfa9XKlaXMIYTk8w8QwChjT8_SH-_2d2SS-kesw0TLQK1nxtw54bDcoZ09freZJgKrtg4f__is-31Vg\"]],[null,\"Sexual Innuendo\"],[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/YrkR-GP7OKghBTATCoO_jJrchSVrh-NSUBb5DnbRZC1DbLK_cgV9FC2e_iI4GzLsKXuZjuFZajnGCiA8qA\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.ps.running.mini.games.challenge\\u0026rdid\\u003dcom.ps.running.mini.games.challenge\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,null,null,null,null,null,null,null,null,null,null