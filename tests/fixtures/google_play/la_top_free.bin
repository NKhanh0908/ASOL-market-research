ercontent.com/6fizSxUc1tkxiKgXIjjNGMTAd3EcFpyUjWd0Eq2p_svMIp1n8t7IPWh-9w9nhY_eOZJb9BBAbYkCSgVluo9D0w\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/o9JynpkJjpo36Go3gM6DLMMz9Z2Q0G2CdS04zSOvU1Z6PxlmkmqR8fy3cS8RxLa5nf6tHFpTdxYSRyE8wBNUhg\"]]],\"ASMR Girl: Livestream Mukbang\",[\"4.4\",4.36],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcasual.girl.asmr.livestream.mukbang\\u0026rdid\\u003dcasual.girl.asmr.livestream.mukbang\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcasual.girl.asmr.livestream.mukbang\"]],[\"qgJzGnEITkoTCP7B8LHHkJcDFTKdbAkdeKQUbPoBDwoNCAASCQoFZW4tVVMQALoCRQopCiNjYXN1YWwuZ2lybC5hc21yLmxpdmVzdHJlYW0ubXVrYmFuZxABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"Step into the world of ASMR Girl: Livestream Mukbang, where you take on the role of an adorable mukbang streamer! Get ready to indulge in delicious food, satisfy your cravings, and share the experience with your viewers in a cozy, interactive livestream. The more you eat and engage, the more you earn!\\u003cbr\\u003e\\u003cbr\\u003e🍽️ Shop, Cook, and Enjoy Delicious Foods\\u003cbr\\u003eStart by shopping for ingredients, then move on to cooking mouth-watering dishes! From spicy noodles to delicious seafood and even sweet treats, the possibilities are endless. Prepare a meal that will make your audience hungry for more!\\u003cbr\\u003e\\u003cbr\\u003e🎥 Live Stream Your Mukbang Adventures\\u003cbr\\u003eOnce your food is ready, it’s time to go live! Eat, chat, and interact with your viewers as you enjoy the food. Your realistic ASMR sounds will make the experience feel so satisfying that your viewers won’t want to miss a moment. Engage with fans and watch your audience grow!\\u003cbr\\u003e\\u003cbr\\u003e💰 Earn Money, Upgrade Your Girl, and Buy More Food\\u003cbr\\u003eThe more successful your streams, the more money you make. Use your earnings to upgrade your girl’s outfits, giving her a stylish and trendy appearance. You can also buy even more delicious food to satisfy your growing audience and keep the mukbang going!\\u003cbr\\u003e\\u003cbr\\u003e🎉 Fun \\u0026amp; Satisfying Gameplay\\u003cbr\\u003eRelaxing, fun, and super engaging, ASMR Girl: Livestream Mukbang lets you enjoy cooking, eating, and styling in a way that’s not only entertaining but also rewarding. Keep streaming, earning, and upgrading to become the most popular mukbang star!\\u003cbr\\u003e\\u003cbr\\u003e📲 Download ASMR Girl: Livestream Mukbang now and start your ASMR streaming journey!\"],\"Brave Labs\",\"5,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/xzaWloGLCmVmkUF789ouuIyfLyzt6PyUpfEpMv9Wf9owXfSPFLbyWdGxaB4zlEXb-IIyKZ2iXcvBc1Zi_Q8BcQU\"],null,[230,215,250,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,[null,\"Suitable for all age groups. Some violence in a comical or fantasy context is acceptable. Bad language is not permitted.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcasual.girl.asmr.livestream.mukbang\\u0026rdid\\u003dcasual.girl.asmr.livestream.mukbang\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.RC09B.ragdollbreak.fun.game\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/CrLjRm3nDmXM-rcnFCc1fmR2KawMk8WSFaEG5_krp1jGjjX9JAS9JBVhJrBrH3LAbvxt0lojRPHsarDYbGz6YA\"],null,[180,227,252,255],null,null,null,2],[[null,2,[2400,1080],[null,null,\"https://play-lh.googleusercontent.com/DyLxBXhjOSR16yJNqFGMBxPM0gMNdX_MNfYWeXFVjq5ZVR1XMF9wrL0TM3zh5VeJxnGGSGBjnX8nOo6qwUMv3Q\"]],[null,2,[2400,1080],[null,null,\"https://play-lh.googleusercontent.com/dEiU28d-_FWp_OaWQPLCtD0tbSkZY41kQxBhtlDJKsqGCmo2tVg1SM7zxr8Cg1RQ85v2EA4eCSuAkC7X5mKayg\"]],[null,2,[2400,1080],[null,null,\"https://play-lh.googleusercontent.com/wlOlUwziQw0uElpy0j78OkwCZgtn6NjN7o1MG2S_KwwNwOwDZ5xoYI0GLvmaeDP1ZGg678cKozCiV-h4CRqqWQ\"]]],\"Ragdoll Break - Fun Game\",[],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.RC09B.ragdollbreak.fun.game\\u0026rdid\\u003dcom.RC09B.ragdollbreak.fun.game\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.RC09B.ragdollbreak.fun.game\"]],[\"qgJpGmcIT0oTCP7B8LHHkJcDFTKdbAkdeKQUbPoBDwoNCAASCQoFZW4tVVMQALoCOwolCh9jb20uUkMwOUIucmFnZG9sbGJyZWFrLmZ1bi5nYW1lEAEYAxISCgQIARABCgQIBBABCgQICxAB\"],null,[null,\"🦴 LOOKING FOR A FUN WAY TO RELIEVE STRESS AND HAVE A BLAST?\\u003cbr\\u003e\\u003cbr\\u003eWelcome to Ragdoll Break - Fun Game, the ultimate 2D physics simulation game designed for pure relaxation and endless entertainment! Toss, push, and smash your custom dummy off high platforms, through crazy obstacles, and down deadly traps to break as many bones as possible.\\u003cbr\\u003e\\u003cbr\\u003eWith intuitive tap-and-drag controls, hilariously unpredictable physics, and satisfying sound effects, Ragdoll Break - Fun Game is your perfect pocket companion for instant stress relief!\\u003cbr\\u003e\\u003cbr\\u003e🔥 KEY GAME FEATURES\\u003cbr\\u003e\\u003cbr\\u003eCrazy 2D Ragdoll Physics: Experience funny, smooth, and realistic physics as your ragdoll tumbles, bounces, and crashes.\\u003cbr\\u003e\\u003cbr\\u003eSatisfying Bone Breaking: Trigger epic collisions! Watch bones fracture with crisp, satisfying visual and sound feedback.\\u003cbr\\u003e\\u003cbr\\u003eChallenging Obstacle Levels: Push your dummy through gears, buzzsaws, trampolines, spikes, and giant hammers.\\u003cbr\\u003e\\u003cbr\\u003eFun \\u0026amp; Creative Levels: Explore dozens of unique 2D stages filled with clever physics puzzles and hilarious traps.\\u003cbr\\u003e\\u003cbr\\u003eUnlockable Skins \\u0026amp; Customization: Collect coins to unlock vibrant costumes and unique skins for your ragdoll runner.\\u003cbr\\u003e\\u003cbr\\u003eInstant Antistress Gameplay: No rush, no timers, no pressure—just pure, satisfying casual destruction anytime you need a break!\\u003cbr\\u003e\\u003cbr\\u003ePlay Offline Anywhere: Enjoy full ragdoll destruction fun without requiring an active internet connection.\\u003cbr\\u003e\\u003cbr\\u003e🎮 HOW TO PLAY\\u003cbr\\u003e\\u003cbr\\u003eAim \\u0026amp; Push: Drag your finger to set the angle and force, then release to launch your ragdoll.\\u003cbr\\u003e\\u003cbr\\u003eHit the Traps: Guide the dummy into obstacles, walls, and deadly hazards.\\u003cbr\\u003e\\u003cbr\\u003eBreak \\u0026amp; Score: Break as many bones as you can in a single fall to score maximum points and pass the level!\\u003cbr\\u003e\\u003cbr\\u003eAre you ready to test your physics skills and break all the bones?\\u003cbr\\u003e\\u003cbr\\u003e👉 Download Ragdoll Break - Fun Game now and start your ultimate stress-relief journey today!\"],\"Isandares\",\"1,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/k82dhRzG3L4E7-RQ90VZxDar8Vz_3-K_B834Fcx6Ll2GPfp93F7J6El_gh7YumOZP3UrrvG6J5PUg33CNYzu8A\"],null,[10,10,62,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,[null,\"Suitable for all age groups. Some violence in a comical or fantasy context is acceptable. Bad language is not permitted.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.RC09B.ragdollbreak.fun.game\\u0026rdid\\u003dcom.RC09B.ragdollbreak.fun.game\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.king.farmheroessaga\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/elgPfboPUOX-pohBYpNvtwjKGJfQy5KvB43Euin2PyYC95qPMoc-KiRSmGlN37Di7y4QDgVqcAasNMxhJaH3Mg\"],null,[41,173,231,255],null,