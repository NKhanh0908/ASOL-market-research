0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.funspace.juicerun\"]],[\"qgJlGmMIN0oTCP7B8LHHkJcDFTKdbAkdeKQUbPoBDwoNCAASCQoFZW4tVVMQALoCNwobChVjb20uZnVuc3BhY2UuanVpY2VydW4QARgDEhgKBAgBEAEKBAgDEAEKBAgEEAEKBAgLEAE\\u003d\"],[[[null,null,\"7DmISE7UB2g\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:7DmISE7UB2g?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:7DmISE7UB2g\",null,null,null,null,\"AXH1ezmxomeX4UcFlsNau9EdOlpSwpkFWja_OxBvC7yzDbKVZn3ToOVXqNkdsTdfOWn4nnW_Y7xgkL8ragzunyntzg_1r_oNfTFljaLbAUouD9JB-Bvnn-LJYnztUsJDBmUfI9LlynChq-wTsslxjB-WxpdfOABa2N-iAflwjuuNZZALM4e2Qd1HQFswGbxu2H-eibcfgL5fAIdat_PZfp4ks_3yN4KC9FWRDhGupoydvdcVuZkeAXf1MrWQKL1deHOKT6eTGNSIMSE4OhrmFCTrMc5GUxVSZ8BSop0wgyHauO5AYw\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/7DmISE7UB2g/hqdefault.jpg\"]]]],[null,\"Juice Run is a game that uses juice to parkour. You need to manipulate a juice of one color, eat the juice of the same color to increase yourself, and at the same time avoid other colors of juice. If you encounter other colors of juice, you will become smaller. When you reach the end, the bigger your juice, the more diamonds you will get. Parkour adventure that will keep you on your toes till the very end! Race, Clash, and Win!\\u003cbr\\u003e\\u003cbr\\u003eHow to play:\\u003cbr\\u003e1. Move left and right\\u003cbr\\u003e2. Avoid different color juices\\u003cbr\\u003e3. Touch the juice of the same color\\u003cbr\\u003e4. Change colors\\u003cbr\\u003e5. Reach the end, victory \\u003cbr\\u003e\\u003cbr\\u003eGame features:\\u003cbr\\u003e1. The gameplay is simple to get started and can\\u0026#39;t stop at all;\\u003cbr\\u003e2. Drink juice, of course, collect the largest glass of juice to drink;\\u003cbr\\u003e3. The view of the beach makes it easy for you to decompress.\\u003cbr\\u003e4. Lots of unique levels\\u003cbr\\u003e5. Crisp bright graphics\\u003cbr\\u003e6. Super smooth swipe control\\u003cbr\\u003e7. Rewards and gifts\\u003cbr\\u003e8. Free games\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003eWe are looking forward to getting feedback from all of you! Please leave your reviews, so we can keep making the game even better.\"],\"FunSpace\",\"5,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/9tcjretZY28KLDHvd23pjC7MFLgeJR37jqMtylB6Ck5AYOpl7Ru0XahFjPHkJORo_k6xbfLkTNs87YmdBDZ-uQo\"],null,[55,196,254,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,[null,\"Suitable for all age groups. Some violence in a comical or fantasy context is acceptable. Bad language is not permitted.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.funspace.juicerun\\u0026rdid\\u003dcom.funspace.juicerun\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]],[null,null,null,null,null,null,null,null,null,null,null,null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.frojo.moy7\",7],[null,2,[512,512],[