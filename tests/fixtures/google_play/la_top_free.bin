,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.left.right.girl.dressup.game\"]],[\"qgJwGm4INkoTCP7B8LHHkJcDFTKdbAkdeKQUbPoBDwoNCAASCQoFZW4tVVMQALoCQgomCiBjb20ubGVmdC5yaWdodC5naXJsLmRyZXNzdXAuZ2FtZRABGAMSGAoECAEQAQoECAMQAQoECAQQAQoECAsQAQ\\u003d\\u003d\"],null,[null,\"🛍️ Style Star: Left Right Fashion is the ultimate left or right dress up game where every choice leads to a surprising outcome! Dive into the world of fashion and make decisions that will shape your model\\u0026#39;s final look. Will you choose left or right fashion options? You won\\u0026#39;t know the result until the end, making every decision thrilling! ✨\\u003cbr\\u003e\\u003cbr\\u003e👗 How It Works:\\u003cbr\\u003eIn this left or right game, each stage presents two fashion choices—left or right. Your selections will create the final outfit, so choose wisely! The excitement builds as you mix and match pieces, revealing the final look only after all steps are completed.\\u003cbr\\u003e\\u003cbr\\u003e🎉 Key Features:\\u003cbr\\u003e\\u003cbr\\u003eChoose between a maid or two men in maid outfits to help with your style.\\u003cbr\\u003eEnjoy the unique left right games experience where every choice matters.\\u003cbr\\u003eEndless surprises with unexpected fashion twists and fun challenges.\\u003cbr\\u003eGet ready to be amazed by your own creations! Download Style Star: Left Right Fashion now and see where your left or right fashion stylist decisions take you!\"],\"kiwilab\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/TsmuWRmdocnWmsCyAocJ_4E-5Sz7Lw_k7XsSuWaBxWTtAhUPX6rfqpEddm69ISlgd8ToiTUNeup8nxfUophfcuk\"],null,[147,136,241,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u