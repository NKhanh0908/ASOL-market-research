eMCBKgjANDb3jfVVbi5UOw2k4qSAgMNvw\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/Pzo7knDrdVlD80zgjcW-daMBYFjthYQCYbIKDG5Av3_70dkK2UM86QegF0ZK8i0DRlh7ddBLTP2-ad5BsxdUPiE\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/yA9wIbAfQ0tU-oJw_Tp-sYM85Yk3buBDhWy2B-dSiKQt2DatKyI26TQenXOtlfNnLh566xf721KKiES5IYTOCg\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/uCrzFUQ-ROrCCZEfXOzarWFVLTR-3GpAu0hz0s6PRZsM4mDpVD3e80Z_cf9NXu9eJfS4-cr2aXDVUR2DQVNX7Gs\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/HpXUIoL522cuKvT4MkNQzW6HUVmooCe0E2Gdb3chAQrjZwBkYWpYzbn7ZjQPgF55uNErSNQmglgl9VufSMJ5cg\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/ec_uI0Z34tse0Yz_jj5FwSu2wOQeUsJCYyMcQdtj4pWS8VjkM3MLDjhbowjfNmJ-ntI8B4GcUrP81liyaScl5g\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/3hYFbeSXnp_PDQWtSSbjNvIZ-GqHzbQz5zrn9gJ-tcyX5lPAGDYb1Qnas4u9GGL3VsRP70Hw6aVUnSagx753bi0\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/jvJQZyYy2bLRPKH_tgYJNtuB3KmRZhzBHOMyIFuZ3EO3XImCu0G7FMAr9M5esMxW9WbPO4GksFOyx4F-SI-tjQ\"]],[null,2,[1242,2208],[null,null,\"https://play-lh.googleusercontent.com/5p5qmKKB_q4czZ8iAekNcAnBH8nKTdhRovx0ACDmwPN8rccnTAH2gWeMCBKgjANDb3jfVVbi5UOw2k4qSAgMNvw\"]]],\"My Talking Tom Friends\",[\"4.1\",4.1308413],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.outfit7.mytalkingtomfriends\\u0026rdid\\u003dcom.outfit7.mytalkingtomfriends\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.outfit7.mytalkingtomfriends\"]],[\"qgJvGm0IBEoTCP7B8LHHkJcDFTKdbAkdeKQUbPoBDwoNCAASCQoFZW4tVVMQALoCQQolCh9jb20ub3V0Zml0Ny5teXRhbGtpbmd0b21mcmllbmRzEAEYAxIYCgQIARABCgQIAxABCgQIBBABCgQICxAB\"],null,[null,\"Join Talking Tom, Angela, Hank, Ginger, Ben, and Becca in the most exciting virtual pet adventure! Dive into a world of cool animals and endless fun! Visit their house and see why they are the ultimate pet friends!\\u003cbr\\u003e\\u003cbr\\u003eHere\\u0026#39;s why you\\u0026#39;ll love playing with them:\\u003cbr\\u003e\\u003cbr\\u003e- Take Care of All Six Friends: Interact with your favorite characters in one house! Feed, bathe, dress, and put them to sleep. Talk, play, and engage with Tom, Angela, Hank, Ginger, Ben, and Becca. Each character has their unique personality and needs.\\u003cbr\\u003e\\u003cbr\\u003e- Design and Create Stories: Bring all your characters together to create and share fun stories. Your imagination is the limit!\\u003cbr\\u003e\\u003cbr\\u003e- Creative and Sporty Activities: From gardening to chilling in the pool and playing musical instruments, there\\u0026#39;s always something fun to do.\\u003cbr\\u003e\\u003cbr\\u003e- Closet Full of Fun Fashions: Dress up your friends in the latest styles. Unlock new outfits daily and show off your fashion sense!\\u003cbr\\u003e\\u003cbr\\u003e- House Customization: Decorate and upgrade their house to make it the coolest home in town. Collect tokens and rewards to enhance your living space.\\u003cbr\\u003e\\u003cbr\\u003e- Mini Games: Enjoy a variety of mini-games, from puzzles to action-packed challenges. There\\u0026#39;s something for everyone!\\u003cbr\\u003e\\u003cbr\\u003e- Collect Stickers and Rewards: Complete your sticker album to earn special rewards and unlock whacky food items. Feed your virtual friends and watch their hilarious reactions.\\u003cbr\\u003e\\u003cbr\\u003e- Daily Trips to Town: Travel to different locations to shop for exciting new items and bring back surprises.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003eFrom Outfit7, creators of My Talking Tom, My Talking Tom 2 and My Talking Angela 2.\\u003cbr\\u003e\\u003cbr\\u003eThis app contains:\\u003cbr\\u003e- Promotion of Outfit7\\u0026#39;s products and advertising;\\u003cbr\\u003e- Links that direct customers to Outfit7’s websites and other apps;\\u003cbr\\u003e- Personalization of content to encourage users to play the app again;\\u003cbr\\u003e- YouTube integration to allow users to watch videos of Outfit7\\u0026#39;s animated characters;\\u003cbr\\u003e- The option to make in-app purchases;\\u003cbr\\u003e- Subscriptions which automatically renew at the end of a subscription period unless cancelled. You can manage and cancel your subscription any time via Settings in your Google Play account;\\u003cbr\\u003e- Items to purchase (available in different prices) using virtual currency, depending on the player’s progress;\\u003cbr\\u003e- Alternative options to access all functionalities of the app without making any in-app purchases using real money.\\u003cbr\\u003e\\u003cbr\\u003e\\u003cbr\\u003eTerms of use: https://talkingtomandfriends.com/eula/en/\\u003cbr\\u003ePrivacy policy for games: https://talkingtomandfriends.com/privacy-policy-games/en\\u003cbr\\u003eCustomer support: support@outfit7.com\"],\"Outfit7 Limited\",\"500,000,000+\",null,null,null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/Lno1-AvKmhMbYT1t-mmo0zUs_rVAC79YEQRQrptWdSiabjzRb0BD8vPZmPzMn-XfKQ89shlz1SrOcV8Ff87f\"],null,[55,161,252,255]],null,[\"Rated for 3+\",[null,2,[487,512],[null,null,\"https://play-lh.googleusercontent.com/EbEX3AN4FC4pu3lsElAHCiksluOVU8OgkgtWC43-wmm_aHVq2D65FmEM97bPexilUAvlAY5_4ARH8Tb3RxQ\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],true,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/_re6mcALPaqotePA0WkgYeOQ6TighHRUS62FRmREPEhyZPdGM3QmRjcSpiMt6Pz1O-WZyvEIy4mtGHj9zw\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",