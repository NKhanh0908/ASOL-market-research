UQ1JHk7Ni2j5HfcXW3xuR7bjNEp9b_sK3WC5sh6k\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/rmRkY61CXqyPH5ANte-fcBtKnnLwm9UVRps1y01jjTaD7b-WPCc1STybrFZCW--S3s1ZXF-J3AfCWjxqcXkHzp8\"]],[null,2,[2732,2048],[null,null,\"https://play-lh.googleusercontent.com/6wyWpCnUbgfu9wsWGeXXmgEpHF9cLT93ZKPnvsaXvREHpXC-Be8t8lXrFoAHVraP1bopyampU2TqyBKPHdUFjNE\"]]],\"Angry Smash\",[\"4.9\",4.9435534],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.tripledot.angrysmash\\u0026rdid\\u003dcom.tripledot.angrysmash\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.tripledot.angrysmash\"]],[\"qgJiGmAIC0oTCOji0LLHkJcDFfP2PAId7Fkoq/oBDwoNCAASCQoFZW4tVVMQALoCNAoeChhjb20udHJpcGxlZG90LmFuZ3J5c21hc2gQARgDEhIKBAgBEAEKBAgDEAEKBAgEEAE\\u003d\"],null,[null,\"Ahoy, adventurer! Get ready to blast your way through a colourful world of tropical islands, pirate hideouts and treasure-filled shores! Can you save the one you love from captivity?\\u003cbr\\u003e\\u003cbr\\u003eTake control of a powerful cannon and smash every object standing in your path. Aim carefully, choose the perfect angle and fire your cannonball to shatter crates, barrels, stone structures and other island obstacles. Use your brain and instincts to overcome the obstacles!\\u003cbr\\u003e\\u003cbr\\u003eEvery level brings a new smashing challenge. Use precision, timing and strategy to clear all the targets in front of you and continue your journey across the islands. Watch structures collapse, trigger satisfying chain reactions and discover the best way to destroy everything with as few shots as possible.\\u003cbr\\u003e\\u003cbr\\u003eEASY TO PLAY, SATISFYING TO MASTER\\u003cbr\\u003eAim your cannon, release to fire and enjoy the destruction. The controls are simple, but finding the perfect shot takes skill.\\u003cbr\\u003e\\u003cbr\\u003eEXPLORE A PIRATE ISLAND WORLD\\u003cbr\\u003eTravel through tropical beaches, mysterious ruins and dangerous pirate territories as you complete increasingly challenging levels.\\u003cbr\\u003e\\u003cbr\\u003eSMASH EVERYTHING IN YOUR PATH\\u003cbr\\u003eBreak barrels, destroy crates, crack stone defences and bring entire structures crashing down with powerful cannon shots.\\u003cbr\\u003e\\u003cbr\\u003ePLAN THE PERFECT SHOT\\u003cbr\\u003eAdjust your aim and use the environment to create spectacular chain reactions. One well-placed cannonball could clear the entire level!\\u003cbr\\u003e\\u003cbr\\u003eSATISFYING DESTRUCTION\\u003cbr\\u003eEnjoy explosive impacts, collapsing structures and rewarding smash effects with every successful shot.\\u003cbr\\u003e\\u003cbr\\u003eLoad the cannon, take aim and begin your island-smashing adventure. Can you destroy every target and conquer all the islands?\"],\"Tripledot Studios Limited\",\"500,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/Mbk-YJcjN8NFt8CZeyyo5MLTiKEEtdELJhQyBjJwf6TKSfVDkn4Os2mRCnEa5sEbZV5J2ahs6LX12-xdavng368\"],null,[84,204,248,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,[null,\"Content is generally suitable for all ages. May contain minimal cartoon, fantasy or mild violence and/or infrequent use of mild language.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.tripledot.angrysmash\\u0026rdid\\u003dcom.tripledot.angrysmash\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $99.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.gimica.treasuremaster\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/_lYcwhk15kEQDqliKxajVrdi9tsEDrS-ipQdIONx8wGW5OBbi0gReAukFre-7YQ5cfiD3WRi1c2P9SOe1HYcJ5g\"],null,[59,124,181,255],null,null,null,2],[[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/6DjBVPuBgLoAmZtNMGRt0qS9VA6D8wOwgonqZrKDA5YhOHHZNBCKq5UsvHVU-GzqE9bQD81BUXPdUJoO88E-VQY\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/1OxqMxGCkA9WRQLBRNMi8N2Ut4tqeE-42zeRfdVUSaylNQsFVtzJI-nkyqvmtzXNeH1XXRhfSi4JEeeJ5bPg\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/BTm8sXjaiWiyEr2f2bEXtQ1yQ_oJSfXcS3sBWxvUkQT7xWSSlonyoUZ70LzBXw2YZJD0fRWf0-ReNprGGN8Ga20\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/jaCyCs9qvMthWM6T-0eZAmZBzUSjhTKdktIg6YmDrE0WNcL3A2OXQa0WI214cXMsEwWben6nTWPcWJ0punGvYQ\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/clUFLdHSkXoDO9d_f9_QdAH4HMOA73LgEwzBDmuWRUQP48LruPViMmI021JoXD3NKgGucee-1O0cPI6SMU4_1TI\"]]],\"Treasure Master\",[\"4.5\",4.4880733],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.gimica.treasuremaster\\u0026rdid\\u003dcom.gimica.treasuremaster\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.gimica.treasuremaster\"]],[\"qgJjGmEIDEoTCOji0LLHkJcDFfP2PAId7Fkoq/oBDwoNCAASCQoFZW4tVVMQALoCNQofChljb20uZ2ltaWNhLnRyZWFzdXJlbWFzdGVyEAEYAxISCgQIARABCgQIAxABCgQIBBAB\"],null,[null,\"Enter an endless monster hunt in Treasure Master! This arcade blade-thrower game tests your aim, timing, and nerves as you hurl knives at greedy monsters and towering bosses.\\u003cbr\\u003e\\u003cbr\\u003eYOU THROW THE WEAPONS\\u003cbr\\u003eForget wooden logs and static targets. In Treasure Master, you attack fierce enemies, fling knives, swords, darts, and spears straight into the monster until it surrenders all its treasures to you. Land clean hits, watch the creature react, and keep your streak alive.\\u003cbr\\u003e\\u003cbr\\u003eAIM, TIME, SURVIVE\\u003cbr\\u003eEnemies spin and change rhythm, so every throw is a small decision. Wait too long and you’ll lose your chance; throw too early and you may miss. Keep a cool head, learn the patterns, and turn tight moments into perfect hits.\\u003cbr\\u003e\\u003cbr\\u003eMONSTERS \\u0026amp; BOSS BATTLES\\u003cbr\\u003eEach stage brings new opponents and tougher patterns. Survive the waves, then face a boss that demands true precision. Read the motion, pick your moment, and strike!\\u003cbr\\u003e\\u003cbr\\u003eBUILD YOUR ARSENAL\\u003cbr\\u003eUnlock a growing collection of weapons and enjoy the feel of each one. Swap between quick knives, heavy swords, pinpoint darts, and sharp spears to match your style. The more you play, the more skins you’ll have to tackle epic monsters.\\u003cbr\\u003e\\u003cbr\\u003eCOLLECT \\u0026amp; PROGRESS\\u003cbr\\u003eEarn gems as you play and push further to unlock more stages and stronger runs. Chase your best performance, rack up clean streaks, and climb through level after level as the difficulty ramps up. The deeper you go, the faster the action gets - and the more satisfying your victories feel.\\u003cbr\\u003e\\u003cbr\\u003eEASY TO PLAY, HARD TO MASTER\\u003cbr\\u003e- Simple controls: tap/aim and throw\\u003cbr\\u003e- Different weapon skins for your excitement\\u003cbr\\u003e- Quick sessions for breaks, long sessions for high-score chasing\\u003cbr\\u003e- Endless challenge that keeps getting harder\\u003cbr\\u003e\\u003cbr\\u003eReady to prove your skill as a Treasure Master and become the ultimate monster-slaying knife-thrower?\"],\"Gimica GmbH\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/hM4DSkKCVRQFfPzIyxisBwMjxtDE1igHRgIcgTi2u4e7G3d3Jc3xu3cZJTYT1MoypjnaBLkE1os_3RAI2ram\"],null,[33,21,51,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],[null,\"Mild Fantasy Violence\"],[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.gimica.treasuremaster\\u0026rdid\\u003dcom.gimica.treasuremaster\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $15.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.media720.games2020