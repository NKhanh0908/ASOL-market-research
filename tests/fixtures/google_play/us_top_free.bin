ay-lh.googleusercontent.com/VcB5ensrrxjxzDsiS_THAAE0Njm9lWDE_EVkjV4r-YrIl70dI8jOikBOeUB67iiiWVQ2-d6mQL4LEA1jrfNu0Q8\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/D84zaV3Eyt-Kfq4JQMVltROQj7QRoPGDzKOr0dtkALUuSTxchrg6n6fYKxAgm0gmMdR7U09GO4k63njy3M49djs\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/gyJL-BbK2JqM7zewOqbpbRpwBVPPZuf79GEBvUmE7aYqZktgYBFpDDKpCCaM2JpBaTHVzUY-y7CbopJji74t7w\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/7SLQoOAwY-xwMf90ROh2-EoVnpAJBye01NUCVihhVSSiBT1k-VoErN0ReNcUkFLFCyn3aH60Bn6iSa5jrwPacA\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/AfMZ5H14FFn5nftGvuXuJwomfeZQ6J4Q6Qe87DDIdcedh2dlVECvsuRJhxabMCwixt_7yGmQdzNUTHL5GQgnJ7Y\"]]],\"Going Balls\",[\"4.2\",4.2183175],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.pronetis.ironball2\\u0026rdid\\u003dcom.pronetis.ironball2\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.pronetis.ironball2\"]],[\"qgJgGl4IL0oTCOji0LLHkJcDFfP2PAId7Fkoq/oBDwoNCAASCQoFZW4tVVMQALoCMgocChZjb20ucHJvbmV0aXMuaXJvbmJhbGwyEAEYAxISCgQIARABCgQIAxABCgQIBBAB\"],null,[null,\"Going Balls: The Ultimate Speed and Balance Challenge! 🚀\\u003cbr\\u003e\\u003cbr\\u003eAre you ready for a high-speed runner game that tests your reflexes and mastery of physics? Download Going Balls today and experience the most thrilling arcade adventure on mobile! Join millions of players worldwide in this addictive hyper-casual hit.\\u003cbr\\u003e\\u003cbr\\u003eWhat is Going Balls? ⚽️🏃\\u200d♂️\\u003cbr\\u003e\\u003cbr\\u003eGoing Balls is an exhilarating, fast-paced ball game where your main goal is to control a rolling ball and guide it safely to the finish line on increasingly difficult tracks. It’s the perfect blend of a precision puzzle game and a heart-pounding speed challenge.\\u003cbr\\u003e\\u003cbr\\u003eHow to Play:\\u003cbr\\u003eSwipe your screen to control the speed and direction of your ball. Master the art of balance as you navigate narrow paths, dodge unexpected obstacles (challenge!), and collect coins 💰 to unlock new balls and environments. \\u003cbr\\u003eThe simple controls hide a deep, skill-based arcade experience!\\u003cbr\\u003e\\u003cbr\\u003eKey Features: The Ultimate Rolling Adventure! 🚧\\u003cbr\\u003e\\u003cbr\\u003e* Dozens of Challenging Levels: Race through diverse worlds, from sky-high platforms to treacherous industrial zones. Each level offers a unique challenge that will keep you coming back for more!\\u003cbr\\u003e* Realistic Physics Engine: Feel the thrill of true physics-based gameplay. Every roll, jump, and acceleration feels incredibly smooth and responsive. Balance is key to surviving!\\u003cbr\\u003e* Customize Your Ball: Collect thousands of coins and unlock a massive collection of cool, colorful, and unique balls. Personalize your runner experience! 🎨\\u003cbr\\u003e* Intuitive One-Finger Control: The ultimate pick-up-and-play hyper-casual design. Simple to learn, but incredibly hard to master - perfect for quick bursts of fun or long endless sessions.\\u003cbr\\u003e* Tons of Obstacles: Avoid swinging hammers, tricky ramps, massive wrecking balls, and unexpected gaps. Your speed and precision are your only allies!\\u003cbr\\u003e\\u003cbr\\u003eWhy You\\u0026#39;ll Love Going Balls! 🎉\\u003cbr\\u003e\\u003cbr\\u003eGoing Balls is more than just a runner - it\\u0026#39;s an immensely satisfying experience. The rush of barely making a jump, the joy of collecting a huge stack of coins, and the feeling of accomplishment after conquering a nearly impossible challenge makes this game highly addictive.\\u003cbr\\u003e\\u003cbr\\u003eWe’ve optimized the gameplay for pure fun!\\u003cbr\\u003e* Instant Thrills: Short, intense levels make it ideal for quick breaks.\\u003cbr\\u003eSkill Progression: You can feel yourself getting better at speed and balance with every attempt.\\u003cbr\\u003e* High Replayability: The pursuit of the perfect, flawless run is endless!\\u003cbr\\u003e\\u003cbr\\u003eDownload Now - Totally FREE! 💯\\u003cbr\\u003e\\u003cbr\\u003eReady to roll? Get the full arcade experience without spending a dime! \\u003cbr\\u003eGoing Balls is totally free to download and play. Experience the ultimate physics-based challenge today!\\u003cbr\\u003e\\u003cbr\\u003eDownload Going Balls and start your speed adventure now! ⬇️\"],\"Supersonic Studios LTD\",\"100,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/hLdbXJX2Ve8w6pvnmCd1KwgBQtyTDiAgSgzygdixQZHdPFen4zSa681b9dbjTRIwJEWMGd5vcX0PWH9g2YT3_w\"],null,[190,199,216,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.pronetis.ironball2\\u0026rdid\\u003dcom.pronetis.ironball2\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $29.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],n