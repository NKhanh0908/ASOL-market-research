dSi-nPurP665mBygjI0kkpgxmuiLtSWX1YO3kgbkiEjx1hWnY3ocGk2qA\"]],[null,2,[3840,2160],[null,null,\"https://play-lh.googleusercontent.com/JKa_P_LQnYXo3tiGeHvlPYpVw0UpeFPgVZWNZ0DPAh9VECfOlcxVT5Sr2Jptl-EDsFC0-Bu5yEWVkjWnNGmW\"]],[null,2,[3840,2160],[null,null,\"https://play-lh.googleusercontent.com/4A3Nn08iW9UKvPAKoEbhVIWrfzyMCkyspvct-h63tY-fYH-LQwy02hjO7sBhJoRGEaNh8bSK0KVYxEJGvvn9JhE\"]],[null,2,[3840,2160],[null,null,\"https://play-lh.googleusercontent.com/uCdT5ZL1J_58VLu47RIOz5MCPIbxUzYd-cma9D_-uEDj1EdKlEvZ5WHv6CO3c_BxtsnqA5WlBgiitMo_ufNBSg\"]]],\"Hollywood Merge\",[\"4.6\",4.649472],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.hollywood.merge\\u0026rdid\\u003dcom.hollywood.merge\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.hollywood.merge\"]],[\"qgJdGlsIGUoTCOji0LLHkJcDFfP2PAId7Fkoq/oBDwoNCAASCQoFZW4tVVMQALoCLwoZChNjb20uaG9sbHl3b29kLm1lcmdlEAEYAxISCgQIARABCgQIAxABCgQIBBAB\"],null,[null,\"Merge! Fashion! Drama! \\u003cbr\\u003eFrom girl next door to Hollywood sensation, experience the celebrity life now!\\u003cbr\\u003e\\u003cbr\\u003eLife in LA is tough and running back and forth from your part-time job to acting auditions to be an extra isn\\u0026#39;t all that glamorous either. However, by some miracle, you find out you\\u0026#39;re actually the long-lost daughter of Hollywood actor Peter Dake.\\u003cbr\\u003e\\u003cbr\\u003eWhen you learn about your family history, your whole world is turned upside down. Well, what you thought would be a life of ease, turns out to be anything but. It turns out your half-sister Rose detests you, your caring boyfriend is hiding something from you, and the media is relentless.\\u003cbr\\u003e\\u003cbr\\u003eThe challenges just keep coming. It\\u0026#39;s time to use your unique style and charisma to show the world what you\\u0026#39;re made of!\\u003cbr\\u003e\\u003cbr\\u003e - Easy merge gameplay. Merge simple clothes to create elegant fashion items! Unlock rare designs and create one-of-a-kind outfits.\\u003cbr\\u003e - Over 1,000 style options to dress for the red carpet, parties, auditions, and other events.\\u003cbr\\u003e - A plot full of twists and turns. How will your story end?\\u003cbr\\u003e - Develop friendships and romantic relationships with different characters in the storyline!\\u003cbr\\u003e\\u003cbr\\u003eAre you ready to start your journey from unnamed extra to Hollywood icon?\"],\"VoyagerOne IE\",\"5,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/nXa_U1uG1moEFWRt-YeQC0VBShF_731o2jWYQV3jNKiLJcXAF6gQ-NWcHyPg-P709yETfUU9xPFrQpJqU4AIGQ\"],null,[240,235,230,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,[null,\"Users Interact, In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.hollywood.merge\\u0026rdid\\u003dcom.hollywood.merge\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $99.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,