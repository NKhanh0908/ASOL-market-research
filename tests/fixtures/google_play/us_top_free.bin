y.google.com/video/lava/web/player/yt:movie:VRK-MSlHTFo?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:VRK-MSlHTFo\",null,null,null,null,\"AXH1ezmPBqP-wZ7Z40wM_8N_YK1CYVE0mnXh3N1s5KcSI-pnLIgDqwQl7R7BayAmkk6KhaxmRk0yrXPr5eus0pA8yZ2Q7gQSYOwzYHlOlQ3zQH5eR-lGrctHz1VVXuVhLV5BQRmB8BlorBBsWnh4JUKUDIecNHVx9J0wshxYHIV0h6j6x4Wt136LOevghtGQ5ENrQZmfzX9ijjjntmzOm3dmFD2J28XY1u9sCYABg0TG7D5HgLK3oX-K5BGzDTM-n9Oios04PkBLY8kqVnM3K8IX7rrqs5g-Vywh7WLnKXbhc5S1HQ\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/VRK-MSlHTFo/hqdefault.jpg\"]]]],[null,\"Summer is here! Time to break out the beach chairs, the sunscreen, and... Block Crusher: Bucket Teardown!\\u003cbr\\u003e\\u003cbr\\u003eThis addictive new game is the perfect way to cool off and relieve stress on a hot summer day. Just use your bucket to smash and destroy all the blocks you can! The more blocks you break, the higher your score will be.\\u003cbr\\u003e\\u003cbr\\u003eBut be careful! The blocks are getting harder and harder to break as you progress through the levels. So you\\u0026#39;ll need to use all your skills and reflexes to stay ahead of the game.\\u003cbr\\u003e\\u003cbr\\u003eCan you become the ultimate block crusher? Find out today!\\u003cbr\\u003e\\u003cbr\\u003eBlock Crusher: Bucket Teardown features:\\u003cbr\\u003e\\u003cbr\\u003e* Simple and addictive gameplay - Just tap the screen to drop your bucket and smash the blocks!\\u003cbr\\u003e* Challenging levels - The blocks get harder and harder to break as you progress through the game.\\u003cbr\\u003e* Multiple worlds to explore - Travel to different summer destinations and smash blocks in the beach, the mountains, and even outer space!\\u003cbr\\u003e* Power-ups to help you crush more blocks - Use power-ups like the dynamite and the wrecking ball to clear out even the toughest blocks.\\u003cbr\\u003e* Leaderboards - Compete with your friends and family to see who can get the highest score!\\u003cbr\\u003e\\u003cbr\\u003eSo what are you waiting for? Download Block Crusher: Bucket Teardown today and start crushing some blocks!\\u003cbr\\u003e\\u003cbr\\u003eHappy summer!\"],\"Monster Game Studio - OneSoft\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/_cheGMopVLbI1Yb-f19lRYEr9V2J3_wOGj2mk_Z5rAZjdwqSxw4GZ6_nEPR9Jv0i-lrFyti8BSlZpgrrRWsFnQ\"],null,[255,217,72,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,[null,\"Content is generally suitable for all ages. May contain minimal cartoon, fantasy or mild violence and/or infrequent use of mild language.\"],[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.monster.blockcrusher\\u0026rdid\\u003dcom.monster.blockcrusher\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$2.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.mini.football.filter.games\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/ZKkAEbg8AqslKv7szgokbi3Pt8gzh_QP9pRlGr5N7-XpsAqGmnYgKb1qZwFGDlQU1_61p74vVsnjKmTaYJTr\"],null,[203,199,196,255],nu