,[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/DRL6nuK0Wjo_8bQxZev_DSlBoc4vnQ2zEcfEuIOprrG2KVl_IzLL8EjY-8dYuqzaxjSZ6L-0e4cl_RTlwPmc\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/G_a884ycKtZSWWIudDtz2D1nDhTEzYh59LeNC7RffM4E2VIhUDlX8vVcbG8HwhwpELSbioIq47IYfVfIPWqS\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/0muEN4aIogn_ViH6hAxi0KulxISUnOohd2BHWQ0HWT834j4f3XU-DDHDE2Riw02AqposRjcgmOIjHW3zkPuhUw\"]],[null,2,[1920,1080],[null,null,\"https://play-lh.googleusercontent.com/_QC335Vv_Yq3X1qTI8E8c89xy1UJ_xSpDvlW7J_18_Iv0sfW4FU4yQRAWhe5DurlTwhBQdLVBhPIpX-JPgAQvQ\"]]],\"Beauty Blast: Makeover \\u0026 Story\",[\"4.9\",4.912316],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.beauty.blast.makeover.story.puzzle.match\\u0026rdid\\u003dcom.beauty.blast.makeover.story.puzzle.match\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003dcom.beauty.blast.makeover.story.puzzle.match\"]],[\"qgJ2GnQIRUoTCOji0LLHkJcDFfP2PAId7Fkoq/oBDwoNCAASCQoFZW4tVVMQALoCSAoyCixjb20uYmVhdXR5LmJsYXN0Lm1ha2VvdmVyLnN0b3J5LnB1enpsZS5tYXRjaBABGAMSEgoECAEQAQoECAMQAQoECAQQAQ\\u003d\\u003d\"],null,[null,\"Help Fiona Rebuild Her Life in Beauty Blast: Makeover \\u0026amp; Story – The Drama-Filled Casual Puzzle Adventure!🔥\\u003cbr\\u003e📚💗Dive into a gripping story where Fiona, a once-devoted mom, faces betrayal and heartbreak after her husband leaves her and their two daughters, Mia \\u0026amp; Ava, stranded and alone. Just when hope fades, a mysterious wheelchair-bound stranger offers a lifeline—but can Fiona rebuild her world, one blast at a time?\\u003cbr\\u003e🌟 Why You’ll Love Playing?\\u003cbr\\u003e🎬  SOAP OPERA LEVELS: Match cubes to survive eviction, expose secrets, and rewrite Fiona’s fate! Will she find love, revenge, or redemption?\\u003cbr\\u003e👗 INFINITE MAKEOVERS: Dress Fiona and her girls in thousands of fashion combos—because even heartbreakers deserve a glam comeback!\\u003cbr\\u003e🎯 PUZZLE TWISTS: Crush color cubes, dodge mind-bending obstacles and blast through levels with whacky boosters.\\u003cbr\\u003eReady to Blast Your Way to a Fresh Start?\\u003cbr\\u003eDownload NOW—just addictive puzzles and a tearjerker storyline that’ll have you swiping “just one more level” until dawn!\\u003cbr\\u003eBeauty Blast: When your life’s a mess, match your way to magic! 💄🎮\"],\"Pexix Inc.\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/-FK1ZbTb1ky18qLpULlm4wx1eK_3bPT6Eurt49ZXEcd8PQQLD_H8q7Ndvn5YbtvZtL5cKon4MYBCFD9wKmm5nO0\"],null,[245,233,203,255]],null,[\"Teen\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/mw_NfsvKM8m6RPv8Fz2GQawCOsqWv010saMnc7zbWalMxuaA9IY8h7E0VMieLxSxAFB98NFeYqbFrXXq\"]],[null,\"Mild Violence, Suggestive Themes, Mild Language\"],[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/xl04GurQer374yogi24hRkvUcXtMStMOcOo86Sprmrid9j6wQHF0d9xMh73CwUEg57lbsGIwpOXgrJ927Q\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.beauty.blast.makeover.story.puzzle.match\\u0026rdid\\u003dcom.beauty.blast.makeover.story.puzzle.match\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $99.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null