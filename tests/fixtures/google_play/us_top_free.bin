u003eHouse Makeover: ASMR Cleaning Quality Features:\\u003cbr\\u003e\\u003cbr\\u003eUse different tools to scrub, wipe, and wash various objects.\\u003cbr\\u003eUnlock new rooms and make a dirty home into a clean one.\\u003cbr\\u003eEnjoy relaxing ASMR sounds while you clean messy rooms and fix dirty furniture.\"],\"Mad1 Games\",\"10,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/SIp7r5EMizNwE1SYOSS6MP7Ayj9HQkaet0_6V5WlT-7I-CoIVVjuwawHujmxAurnYAZFD9QSyajKy6TM22DDzkk\"],null,[46,96,83,255]],null,[\"Teen\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/mw_NfsvKM8m6RPv8Fz2GQawCOsqWv010saMnc7zbWalMxuaA9IY8h7E0VMieLxSxAFB98NFeYqbFrXXq\"]],[null,\"Violence, Blood\"],null,[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/xl04GurQer374yogi24hRkvUcXtMStMOcOo86Sprmrid9j6wQHF0d9xMh73CwUEg57lbsGIwpOXgrJ927Q\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003dcom.gps.housemakeover.satisfying.clean\\u0026rdid\\u003dcom.gps.housemakeover.satisfying.clean\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.99 - $4.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.outfit7.mytalkingangelafree\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/y-rPtQnej2b1qvJTob4mUlje5KfPxb8OTlX3STNobBo6uCGAvHOU36