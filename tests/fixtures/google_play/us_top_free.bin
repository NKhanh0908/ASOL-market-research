le Them All\",[\"4.3\",4.3353295],\"Casual\",null,null,[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003ddk.tactile.holegame\\u0026rdid\\u003ddk.tactile.holegame\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]],[],[null,null,null,null,[null,null,\"/store/apps/details?id\\u003ddk.tactile.holegame\"]],[\"qgJdGlsIHEoTCOji0LLHkJcDFfP2PAId7Fkoq/oBDwoNCAASCQoFZW4tVVMQALoCLwoZChNkay50YWN0aWxlLmhvbGVnYW1lEAEYAxISCgQIARABCgQIAxABCgQIBBAB\"],null,[null,\"Suck It Up is the oddly satisfying black hole puzzle where you guide your hungry hole to swallow everything in sight! Explore levels across grass, ice, sand, and water as cute animals scatter around your ever-growing hole. Relax, solve clever puzzles, have holesome fun, and become a master of the hole!\\u003cbr\\u003e\\u003cbr\\u003eWhy you’ll love it: \\u003cbr\\u003e-Satisfying gameplay — drag, slide, and suck it up as your hole grows with every swallow.\\u003cbr\\u003e-Variety of locations — swallow your way across the world! Parks, sandy beaches, lakes — there’s no place that the hole wouldn’t reach!\\u003cbr\\u003e-Solve puzzles — sort and swallow only what’s required, and find ways to collect the biggest objects.\\u003cbr\\u003e-Animal antics — cute pets react as your black hole swallows them.\\u003cbr\\u003e-Relax or compete — zen out at your own pace or speed through for a perfect score.\\u003cbr\\u003e-Boost your hole — use handy boosters to slow down time or suck things up faster.\\u003cbr\\u003e\\u003cbr\\u003ePro tips to play:\\u003cbr\\u003e-Drag to move your black hole across the board.\\u003cbr\\u003e-Don’t bite off more than your hole can chew! Start with small items to grow larger.\\u003cbr\\u003e-Devour everything to finish the level.\\u003cbr\\u003e\\u003cbr\\u003eCan you master every level and become the ultimate hole hero?\"],\"Tactile Games\",\"500,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/nr0Ll5HGZFSUNJwPatMpsPmb9EmjEKZxA_lQ5Epj0eq_jizlvzjPDT4rqZI2zttLlZPyib6jeVkbIn2EqLKHIm0\"],null,[40,181,229,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,[null,\"In-Game Purchases\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null,[[0,\"USD\",\"\"]],null,[null,\"Buy\"],null,1,[null,null,null,null,null,[null,null,\"https://play.google.com/store/apps/details?id\\u003ddk.tactile.holegame\\u0026rdid\\u003ddk.tactile.holegame\\u0026feature\\u003dmd\\u0026offerId\"]],null,[\"CAE\\u003d\"],null,null,null,null,null,null,null,[]]],[\"Install\"],null,[\"CgYKBENBRT0\\u003d\"]]]],[2],null,[1,true,false],[\"$0.49 - $99.99 per item\",[false]]],[[[[[[[]]]],null,null,null,null,null,null,null,[]],[[[[null,null,null,[\"Casual\"]]]],null,null,null,[],null,null,null,[]],[[[[null,null,[]]]],[[[null,null,null,null,null,[]]]],null,[],null,null,null,null,[]]]],0],[[[\"com.tvf.anti.stress.relaxing.mini.games\",7],[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/4KWBPssWM4-LSzSPcF04LMho2fPCQY1Z20Wzvmi6jF9JlApKfw8Td1GNUdaEax8wEP8sTI0WvcsnxGVBK9Xhuw\"],null,[159,103,61,255],null,null,null,2],[[null,2,[1080,1920],[null,null,\"https://play-lh.googleusercontent.com/sBKL14ZgAx6L3JGgnYbFlmeUJCwsfa0-QC8vDWjMoVPSpDugAv3T5lhnhQwXA2dFFTndgJtVXHP-H-Ry8Ex0\"]],[null,2,[2208,1242],[null,null,\"https://play-lh.googleusercontent.com/PErU4hfiflYiuFm89_eD3vKLM8g_m6rL2GZcpi7V3fWPnzCrF94Mx65VIDsIL1HyC