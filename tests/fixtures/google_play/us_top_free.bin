"]],[\"qgJiGmAIH0oTCOji0LLHkJcDFfP2PAId7Fkoq/oBDwoNCAASCQoFZW4tVVMQALoCNAoeChhjb20uU2VyaW91c2x5LkJlc3RGaWVuZHMQARgDEhIKBAgBEAEKBAgDEAEKBAgEEAE\\u003d\"],[[[null,null,\"8QB0mJqyEgM\",[null,null,\"https://play.google.com/video/lava/web/player/yt:movie:8QB0mJqyEgM?autoplay\\u003d1\\u0026embed\\u003dplay\"],\"yt:movie:8QB0mJqyEgM\",null,null,null,null,\"AXH1ezkkAJurSvjblWo7KOd6Fz4SkIdXmVo6lw8U9i-L0cF6U7TwLRoe2AFqgXyrWiJEqX6tRhd1afxLGX2dkjMaGbYhPABdsWtTvkpF4MqlD2_e3yxxZ533kmU_4eQghqFhyqoGsYG8RDNHkX_AsogGyGfyOtfEb3AcKA9SBBIaq-mUMH8PVu4N5Q9iMoSH7dYXPHqRSiyPbhxlHB5odKlu4-TQVnWLk3YsTQuGR7EN5XnFEzH7bSMbcZuRHsvqc6kZjYJjRBckD4oGIKE0GDPytdz5ViFXU1echBQOv7ZyjuEVuw\\u003d\\u003d\"],null,1,[null,null,null,[null,null,\"https://i.ytimg.com/vi/8QB0mJqyEgM/hqdefault.jpg\"]]]],[null,\"Best Fiends game does not require payment to download and play, but it also allows you to purchase virtual items with real money inside the game, including random items.\\u003cbr\\u003e\\u003cbr\\u003eLeap into the magical world of Minutia for an exciting and fiendishly fun adventure, the likes of which you\\u0026#39;ve never experienced before! \\u003cbr\\u003e\\u003cbr\\u003eEmbark on a quest to Mount Boom to stop King Slug and his army from overrunning and destroying Minutia! Along the way, rescue and utilize over \\u003cb\\u003e50 unique and powerful Fiends\\u003c/b\\u003e to fight against the Slugs! Each Fiend has a special ability that\\u0026#39;ll be critical to mastering if you want to put an end to the slimy threat. \\u003cbr\\u003e \\u003cbr\\u003eChallenge yourself with over \\u003cb\\u003e11,000 captivating and action-packed levels!\\u003c/b\\u003e The adventure may be simple in the beginning, but soon, you\\u0026#39;ll be up against complex and innovative matching puzzles that\\u0026#39;ll have you strategizing and cheering for more.\\u003cbr\\u003e \\u003cbr\\u003eNo other matching and linking game has the fun, exploration, or scale of Best Fiends. The only way to figure out why is to jump in and see for yourself!\\u003cbr\\u003e \\u003cbr\\u003e\\u003cb\\u003eSTORY:\\u003c/b\\u003e\\u003cbr\\u003eAll was well and good in the land of Minutia until a meteor crashed into Mount Boom, triggering a temper tantrum that resulted in waves of evil Slugs being released upon the world! From eating plants to destroying entire cities, Minutia is now under siege by the Slugs, and the only chance it has of surviving is with the help of you and the Best Fiends!\\u003cbr\\u003e  \\u003cbr\\u003e\\u003cb\\u003eFIENDISH FEATURES:\\u003c/b\\u003e\\u003cbr\\u003e \\u003cbr\\u003eA one-of-a-kind puzzle adventure:\\u003cbr\\u003e- Experience an engaging story where puzzles meet adventure!\\u003cbr\\u003e- Enjoy a unique match-3 environment that allows you to link icons for devastating and powerful combo attacks!\\u003cbr\\u003e- Have fun solving over 11,000 puzzles, with new levels added every week!\\u003cbr\\u003e \\u003cbr\\u003eBuild your unique team of Fiends:\\u003cbr\\u003e- Collect over 50 Fiends across Minutia and create a group of unbeatable heroes\\u003cbr\\u003e- Level up, strengthen, and evolve each character to make a formidable team of Fiends!\\u003cbr\\u003e- Create unique team combinations to conquer challenging levels and obstacles!\\u003cbr\\u003e \\u003cbr\\u003eEnjoy weekly and monthly events:\\u003cbr\\u003e- Collect rewards every time you open the game with Kwincy\\u0026#39;s Goodies!\\u003cbr\\u003e- Compete against your Facebook friends to earn massive rewards or send them daily gifts to help them get on their way!\\u003cbr\\u003e- New levels, characters, surprises, and MORE are added every week!\\u003cbr\\u003e  \\u003cbr\\u003e--\\u003cbr\\u003ePLEASE NOTE! Best Fiends offers in-app purchases. You can disable this by turning off the in-app purchases in your device\\u0026#39;s settings.\\u003cbr\\u003e \\u003cbr\\u003eBest Fiends is intended for those 18 and older. You can disable in-app purchases in your device\\u0026#39;s settings. Best Fiends may also contain advertising. You may require an internet connection to play Best Fiends and access its social features. You can also find more information about the functionality, compatibility, and interoperability of Best Fiends in the above description, as well as additional app store information.\\u003cbr\\u003e \\u003cbr\\u003eBy downloading this game, you agree to future game updates as released on your app store or social network. You may choose to update this game, but if you do not update, your game experience and functionalities may be reduced.\\u003cbr\\u003e \\u003cbr\\u003eTerms of Service https://www.playtika.com/terms-service/\\u003cbr\\u003ePrivacy Notice https://www.playtika.com/privacy-notice/\\u003cbr\\u003e \\u003cbr\\u003eJoin our social ecosystem:\\u003cbr\\u003eFacebook http://www.facebook.com/bestfiends\\u003cbr\\u003eX http://www.twitter.com/bestfiends\\u003cbr\\u003eYoutube http://www.youtube.com/bestfiends\\u003cbr\\u003eInstagram http://www.instagram.com/bestfiends\\u003cbr\\u003eWebsite http://www.bestfiends.com/\\u003cbr\\u003eTiktok https://vm.tiktok.com/ZMRD8NdQR/\"],\"Playtika\",\"50,000,000+\",null,\"\",null,null,null,null,[null,2,[500,1024],[null,null,\"https://play-lh.googleusercontent.com/o_9UunMTgJLjw5SMWmjsi_G2ybP2l0an3EyIRs2R1fcA9Jspfa5sUjPZ2OaMFFAcnjY50nn_XkqEFwK4o1_4\"],null,[113,244,253,255]],null,[\"Everyone\",[null,2,[512,512],[null,null,\"https://play-lh.googleusercontent.com/IciOnDFecb5Xt50Q2jlcNC0LPI7LEGxNojroo-s3AozcyS-vDCwtq4fn7u3wZmRna8OewG9PBrWC-i7i\"]],null,[null,\"In-Game Purchases (Includes Random Items)\"],[null,\"\\u003ca href\\u003d\\\"https://support.google.com/googleplay?p\\u003dappgame_ratings\\\"\\u003eLearn more\\u003c/a\\u003e\"],false,null,[null,2,[272,272],[null,null,\"https://play-lh.googleusercontent.com/OBVqgRK7eerY0GPfK8AOzitu5oE9ecC6kG4kURTCb1K41gpqVsN0WjmJwJh-wX8vILzpcc1kYHt56aLN2g\"]],[null,null,null,null,null,[null,null,\"https://support.google.com/googleplay?p\\u003dappgame_ratings\"]]],[[[[[null